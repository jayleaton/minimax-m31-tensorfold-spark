index 0000000000000000000000000000000000000000..6bc340f1e6f03f8a93612560a23117e6d0c6f9dc
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_dspark_topc.cu
@@ -0,0 +1,146 @@
+// MiniMax-M3.1-Flash dspark top-C in two steps: slices of a row keep their c best, one CTA a row merges (same words).
+#include <cuda_runtime.h>
+#include <math.h>
+#include <stdint.h>
+
+namespace {
+
+constexpr int THREADS = 256;
+constexpr int MERGE_MAX = 2048; // slices x c a merge sorts at most (a power of two)
+
+// An order key: bigger is better; -0 equals +0; every NaN is the smallest key (0).
+__device__ __forceinline__ unsigned order_key(float v) {
+    if (v != v) return 0u;
+    unsigned u = __float_as_uint(v);
+    if (u == 0x80000000u) u = 0u;
+    return (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+}
+
+__device__ __forceinline__ unsigned long long entry(unsigned key, int i) {
+    return ((unsigned long long)key << 32) | (0xffffffffu - (unsigned)i);
+}
+
+} // namespace
+
+// A slice [s * per, (s + 1) * per) of a row: its best min(c, length) as (key << 32 | ~index), unordered, then zeros.
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_ds_topc_part(const float* __restrict__ logits, long long ld,
+                                                                         int n, int per, int c,
+                                                                         unsigned long long* __restrict__ out) {
+    __shared__ unsigned hist[256];
+    __shared__ unsigned s_prefix, s_rem, s_need_eq;
+    __shared__ unsigned gt_off[THREADS + 1], eq_off[THREADS + 1];
+    const int t = threadIdx.x;
+    const int a0 = blockIdx.y * per;
+    const int len = max(0, min(n, a0 + per) - a0);
+    const float* row = logits + (long long)blockIdx.x * ld + a0;
+    unsigned long long* o = out + ((long long)blockIdx.x * gridDim.y + blockIdx.y) * c;
+    const int want = min(c, len);
+    for (int i = t; i < c; i += THREADS) o[i] = 0ull;
+    if (want == 0) return;
+    if (t == 0) {
+        s_prefix = 0;
+        s_rem = (unsigned)want;
+    }
+    __syncthreads();
+    for (int pass = 0; pass < 4; ++pass) { // the want-th key, a byte at a time from the top
+        const int shift = 24 - 8 * pass;
+        hist[t] = 0;
+        __syncthreads();
+        const unsigned prefix = s_prefix;
+        const unsigned mask = pass == 0 ? 0u : (0xffffffffu << (32 - 8 * pass));
+        for (int i = t; i < len; i += THREADS) {
+            const unsigned k = order_key(__ldg(row + i));
+            if ((k & mask) == prefix) atomicAdd(&hist[(k >> shift) & 255], 1u);
+        }
+        __syncthreads();
+        if (t == 0) {
+            unsigned rem = s_rem, acc = 0;
+            int b = 255;
+            for (; b > 0; --b) {
+                if (acc + hist[b] >= rem) break;
+                acc += hist[b];
+            }
+            s_prefix = prefix | ((unsigned)b << shift);
+            s_rem = rem - acc;
+        }
+        __syncthreads();
+    }
+    const unsigned T = s_prefix;
+    const int span = (len + THREADS - 1) / THREADS;
+    const int a = min(len, t * span), z = min(len, a + span);
+    unsigned ng = 0, ne = 0;
+    for (int i = a; i < z; ++i) {
+        const unsigned k = order_key(__ldg(row + i));
+        ng += k > T;
+        ne += k == T;
+    }
+    gt_off[t] = ng;
+    eq_off[t] = ne;
+    __syncthreads();
+    if (t == 0) {
+        unsigned sg = 0, se = 0;
+        for (int i = 0; i < THREADS; ++i) {
+            const unsigned x = gt_off[i], y = eq_off[i];
+            gt_off[i] = sg;
+            eq_off[i] = se;
+            sg += x;
+            se += y;
+        }
+        s_need_eq = (unsigned)want - sg;
+    }
+    __syncthreads();
+    unsigned pg = gt_off[t], pe = eq_off[t];
+    for (int i = a; i < z; ++i) { // above the key, then the first equal ones by index
+        const unsigned k = order_key(__ldg(row + i));
+        if (k > T) {
+            o[pg++] = entry(k, a0 + i);
+        } else if (k == T) {
+            if (pe < s_need_eq) o[(want - s_need_eq) + pe] = entry(k, a0 + i);
+            ++pe;
+        }
+    }
+}
+
+// Sorted by key, then index (tf_mm3_ds_topc's order): out [rows][c] pairs {f32 logit, i32 id0 + index}.
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_ds_topc_merge(const unsigned long long* __restrict__ part,
+                                                                          const float* __restrict__ logits, long long ld,
+                                                                          int n, int slices, int id0, int c,
+                                                                          unsigned* __restrict__ out) {
+    __shared__ unsigned long long e[MERGE_MAX];
+    const int t = threadIdx.x;
+    const int total = slices * c;
+    int np = 1;
+    while (np < total) np <<= 1;
+    const unsigned long long* src = part + (long long)blockIdx.x * total;
+    for (int i = t; i < np; i += THREADS) e[i] = i < total ? src[i] : 0ull;
+    __syncthreads();
+    for (int kk = 2; kk <= np; kk <<= 1) { // bitonic, descending overall
+        for (int j = kk >> 1; j > 0; j >>= 1) {
+            for (int i = t; i < np; i += THREADS) {
+                const int ix = i ^ j;
+                if (ix > i) {
+                    const bool up = (i & kk) == 0;
+                    const unsigned long long x = e[i], y = e[ix];
+                    if (up ? x < y : x > y) {
+                        e[i] = y;
+                        e[ix] = x;
+                    }
+                }
+            }
+            __syncthreads();
+        }
+    }
+    const float* row = logits + (long long)blockIdx.x * ld;
+    unsigned* o = out + (long long)blockIdx.x * c * 2;
+    const int want = min(c, n);
+    for (int i = t; i < c; i += THREADS) {
+        if (i < want) {
+            const int k = (int)(0xffffffffu - (unsigned)(e[i] & 0xffffffffu));
+            o[2 * i] = __float_as_uint(__ldg(row + k));
+            o[2 * i + 1] = (unsigned)(id0 + k);
+        } else {
+            o[2 * i] = __float_as_uint(-INFINITY);
+            o[2 * i + 1] = 0xffffffffu;
+        }
+    }
+}
