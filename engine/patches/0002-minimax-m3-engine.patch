new file mode 100644
index 0000000000000000000000000000000000000000..a6e13fc277b2b09db9932c80d47df6b52f8aae58
--- /dev/null
+++ b/zig/src/families/minimax_m3/native_tier.zig
@@ -0,0 +1,60 @@
+//! The MiniMax-M3.1 admission with the KV tier on (native.zig re-exports it): the slice cache from the room.
+const std = @import("std");
+const native = @import("native.zig");
+const iface = @import("iface.zig");
+const budget = @import("budget.zig");
+const pool = @import("pool.zig");
+const tier_settings = @import("tier_settings.zig");
+
+/// The tier's budget: every live page's summaries and every stream's horizon first, the slice cache the room's rest.
+pub fn tierAdmission(a: native.Admission, dims: pool.Dims, cost: tier_settings.Cost, m: u32, in: budget.Input, context: usize) native.Admission {
+    var out = a;
+    const first = budget.check(dims.withTier(cost), in, context);
+    const cap = switch (first) {
+        .ok => |k| k,
+        .refused => {
+            out.verdict = first;
+            return out;
+        },
+    };
+    const max_pages = iface.maxPages(native.capacity(context));
+    const live = @as(u64, cap.lanes) * max_pages;
+    const spent = live * cost.pageBytes() + @as(u64, cap.lanes) * (pool.Dims.tableBytes(max_pages) + cost.streamBytes());
+    const left = cap.room -| spent;
+    const least = cost.cacheMin(cap.lanes, max_pages, m, dims.layerToken() * pool.page_tokens);
+    if (left < least) {
+        const words = std.fmt.bufPrint(&native.detail_buf, "minimax KV tier: {d} streams of {d} tokens leave {d:.2} GiB of the {d:.2} GiB room for the slice cache past {d:.2} GiB of summaries and horizons; it needs {d:.2} GiB (lower TF_MM3_KV_HORIZON, CONTEXT or PARALLEL)", .{ cap.lanes, context, gibs(left), gibs(cap.room), gibs(spent), gibs(least) }) catch native.detail_buf[0..0];
+        native.detail_len = words.len;
+        var r = budget.check(dims, in, context);
+        if (r == .ok) r = .{ .refused = .{ .reason = .does_not_fit, .requested = context, .largest = 0, .largest_pool_tokens = 0, .need_bytes = spent + least, .room_bytes = cap.room, .weights = in.weights, .available = in.available, .max_positions = in.max_positions, .token_bytes = dims.withTier(cost).tokenBytes(), .lanes = cap.lanes } };
+        out.verdict = r;
+        return out;
+    }
+    // slack for the plan's snapshot slots and a smaller host room, then shrink until the check takes its own answer
+    var full = cost;
+    var cache = (left - least) -| @max(64 << 20, cap.room / 64) + least;
+    var tries: u32 = 0;
+    while (true) : (tries += 1) {
+        full.cache_stream = cache / cap.lanes;
+        const v = budget.check(dims.withTier(full), in, context);
+        switch (v) {
+            .ok => {
+                out.tier_cache = full.cache_stream;
+                out.verdict = v;
+                return out;
+            },
+            .refused => |r| {
+                const short = (r.need_bytes -| r.room_bytes) + cost.pageBytes() * cap.lanes + (1 << 20);
+                if (tries == 8 or cache < least + short) {
+                    out.verdict = v;
+                    return out;
+                }
+                cache -= short;
+            },
+        }
+    }
+}
+
+fn gibs(bytes: u64) f64 {
+    return @as(f64, @floatFromInt(bytes)) / (1 << 30);
+}
