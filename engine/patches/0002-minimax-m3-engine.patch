diff --git a/zig/src/families/minimax_m3/vision/config.zig b/zig/src/families/minimax_m3/vision/config.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e3574230e259e5900f09e39d5683efeb603a2221
--- /dev/null
+++ b/zig/src/families/minimax_m3/vision/config.zig
@@ -0,0 +1,190 @@
+//! MiniMax-M3.1-Flash's image settings: config.json's vision_config and marker ids, preprocessor_config.json's bounds.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const Value = std.json.Value;
+
+pub const Error = error{ OutOfMemory, VisionConfig };
+
+/// The one tower and image processor this family serves; `parse` refuses a checkpoint that differs.
+pub const Config = struct {
+    hidden: u32 = 1280,
+    heads: u32 = 16,
+    layers: u32 = 32,
+    ffn: u32 = 5120,
+    eps: f32 = 1e-5,
+    patch: u32 = 14,
+    temporal: u32 = 2,
+    merge: u32 = 2,
+    rope_theta: f32 = 10000,
+    projector_hidden: u32 = 6144,
+    text_hidden: u32 = 6144,
+    image_token: u32 = 200025,
+    video_token: u32 = 200026,
+    image_start: u32 = 200029, // ]<]start of image[>[
+    image_end: u32 = 200030, // ]<]end of image[>[
+    mean: [3]f32 = .{ 0.48145466, 0.4578275, 0.40821073 },
+    std: [3]f32 = .{ 0.26862954, 0.26130258, 0.27577711 },
+    rescale: f64 = 1.0 / 255.0,
+    min_pixels: u64 = 4 * 28 * 28,
+    max_pixels: u64 = 451584,
+
+    /// A patch's values: channel by frame by row by column.
+    pub fn patchWidth(c: Config) u32 {
+        return 3 * c.temporal * c.patch * c.patch;
+    }
+
+    /// Image sides are multiples of this many pixels.
+    pub fn factor(c: Config) u32 {
+        return c.patch * c.merge;
+    }
+
+    /// The most patches one image can have: the processor's pixel bound over a patch's pixels.
+    pub fn maxPatches(c: Config) u32 {
+        return @intCast(c.max_pixels / (@as(u64, c.patch) * c.patch));
+    }
+
+    pub fn headDim(c: Config) u32 {
+        return c.hidden / c.heads;
+    }
+};
+
+/// config.json and preprocessor_config.json text; null without a vision_config; error.VisionConfig past `Config`.
+pub fn parse(a: Allocator, config_json: []const u8, preprocessor_json: ?[]const u8) Error!?Config {
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const doc = try object(std.json.parseFromSliceLeaky(Value, arena, config_json, .{}) catch return error.VisionConfig);
+    const vc = doc.get("vision_config") orelse return null;
+    if (vc == .null) return null;
+    const v = try object(vc);
+    var c: Config = .{};
+    inline for (.{ .{ "hidden_size", c.hidden }, .{ "num_attention_heads", c.heads }, .{ "num_hidden_layers", c.layers }, .{ "intermediate_size", c.ffn }, .{ "patch_size", c.patch } }) |kv| {
+        if (try int(v.get(kv[0])) != kv[1]) return error.VisionConfig;
+    }
+    inline for (.{ .{ "num_channels", 3 }, .{ "projection_dim", c.projector_hidden } }) |kv| if (v.get(kv[0])) |x| {
+        if (try int(x) != kv[1]) return error.VisionConfig;
+    };
+    if (try number(v.get("layer_norm_eps")) != c.eps or try number(v.get("rope_theta")) != c.rope_theta) return error.VisionConfig;
+    inline for (.{ .{ "rope_mode", "3d" }, .{ "position_embedding_type", "rope" }, .{ "hidden_act", "gelu" } }) |kv| {
+        try text(v.get(kv[0]), kv[1]);
+    }
+    const top = doc.get("img_token_compression_config");
+    const inner = v.get("img_token_compression_config");
+    if (top == null and inner == null) return error.VisionConfig;
+    for ([_]?Value{ top, inner }) |x| if (x) |cc| try compression(c, cc);
+    if (try int(doc.get("image_token_index")) != c.image_token or try int(doc.get("video_token_index")) != c.video_token) return error.VisionConfig;
+    if (doc.get("projector_hidden_size")) |x| if (try int(x) != c.projector_hidden) return error.VisionConfig;
+    if (doc.get("projector_hidden_act")) |x| try text(x, "gelu");
+    if (doc.get("process_image_mode")) |x| try text(x, "dynamic_res");
+    if (doc.get("text_config")) |t| if ((try object(t)).get("hidden_size")) |x| if (try int(x) != c.text_hidden) return error.VisionConfig;
+    if (preprocessor_json) |p| try processor(&c, try object(std.json.parseFromSliceLeaky(Value, arena, p, .{}) catch return error.VisionConfig));
+    return c;
+}
+
+/// preprocessor_config.json over the defaults: its patch geometry must be the tower's, its steps all on.
+fn processor(c: *Config, o: std.json.ObjectMap) Error!void {
+    inline for (.{ .{ "patch_size", c.patch }, .{ "merge_size", c.merge }, .{ "temporal_patch_size", c.temporal }, .{ "resample", 3 } }) |kv| {
+        if (o.get(kv[0])) |x| if (try int(x) != kv[1]) return error.VisionConfig;
+    }
+    inline for (.{ "do_resize", "do_rescale", "do_normalize", "do_convert_rgb" }) |key| if (o.get(key)) |x| {
+        if (x != .bool or !x.bool) return error.VisionConfig;
+    };
+    if (o.get("img_token_compression_config")) |cc| try compression(c.*, cc);
+    if (o.get("process_image_mode")) |x| try text(x, "dynamic_res");
+    if (o.get("min_pixels")) |x| c.min_pixels = try int(x);
+    if (o.get("max_pixels")) |x| c.max_pixels = try int(x);
+    if (o.get("rescale_factor")) |x| c.rescale = try number(x);
+    inline for (.{ "image_mean", "image_std" }, .{ &c.mean, &c.std }) |key, dst| if (o.get(key)) |x| {
+        if (x != .array or x.array.items.len != 3) return error.VisionConfig;
+        for (x.array.items, dst) |item, *d| d.* = @floatCast(try number(item));
+    };
+    for (c.std) |s| if (!(s > 0)) return error.VisionConfig;
+    if (c.min_pixels > c.max_pixels or !(c.rescale > 0)) return error.VisionConfig;
+}
+
+/// patch_merge of 2 x 2 patches over 2 frames: the only token compression the tower serves.
+fn compression(c: Config, cc: Value) Error!void {
+    const o = try object(cc);
+    try text(o.get("image_token_compression_method"), "patch_merge");
+    if (try int(o.get("spatial_merge_size")) != c.merge or try int(o.get("temporal_patch_size")) != c.temporal) return error.VisionConfig;
+}
+
+fn object(v: Value) Error!std.json.ObjectMap {
+    return if (v == .object) v.object else error.VisionConfig;
+}
+
+fn int(v: ?Value) Error!u32 {
+    const x = v orelse return error.VisionConfig;
+    if (x != .integer or x.integer <= 0 or x.integer > std.math.maxInt(u32)) return error.VisionConfig;
+    return @intCast(x.integer);
+}
+
+fn number(v: ?Value) Error!f32 {
+    return switch (v orelse return error.VisionConfig) {
+        .float => |f| @floatCast(f),
+        .integer => |i| @floatFromInt(i),
+        else => error.VisionConfig,
+    };
+}
+
+fn text(v: ?Value, want: []const u8) Error!void {
+    const x = v orelse return error.VisionConfig;
+    if (x != .string or !std.mem.eql(u8, x.string, want)) return error.VisionConfig;
+}
+
+/// The pack's config.json without text_config and quantization, and its preprocessor_config.json, trimmed.
+pub const sample_config =
+    \\{"model_type": "minimax_m3_vl", "image_token_index": 200025, "video_token_index": 200026,
+    \\ "process_image_mode": "dynamic_res", "projector_hidden_act": "gelu", "projector_hidden_size": 6144,
+    \\ "img_token_compression_config": {"image_token_compression_method": "patch_merge", "spatial_merge_size": 2,
+    \\  "temporal_patch_size": 2},
+    \\ "vision_config": {"hidden_size": 1280, "num_attention_heads": 16, "num_hidden_layers": 32,
+    \\  "intermediate_size": 5120, "patch_size": 14, "image_size": 672, "projection_dim": 6144,
+    \\  "position_embedding_type": "rope", "rope_mode": "3d", "rope_theta": 10000.0, "hidden_act": "gelu",
+    \\  "layer_norm_eps": 1e-05, "num_channels": 3, "img_token_compression_config": {
+    \\   "image_token_compression_method": "patch_merge", "spatial_merge_size": 2, "temporal_patch_size": 2}}}
+;
+pub const sample_preprocessor =
+    \\{"processor_class": "MiniMaxVLProcessor", "process_image_mode": "dynamic_res",
+    \\ "image_mean": [0.48145466, 0.4578275, 0.40821073], "image_std": [0.26862954, 0.26130258, 0.27577711],
+    \\ "size": [672, 672], "patch_size": 14, "img_token_compression_config": {"image_token_compression_threshold": 1.1,
+    \\  "image_token_compression_method": "patch_merge", "max_image_resolution": 1008, "spatial_merge_size": 2,
+    \\  "temporal_patch_size": 2}, "add_start_end_special_tokens": true}
+;
+
+test "the pack's files parse to the served tower, markers and pixel bounds" {
+    const a = std.testing.allocator;
+    const c = (try parse(a, sample_config, sample_preprocessor)).?;
+    try std.testing.expectEqual(Config{}, c);
+    try std.testing.expectEqual([4]u32{ 1176, 28, 2304, 80 }, [4]u32{ c.patchWidth(), c.factor(), c.maxPatches(), c.headDim() });
+    try std.testing.expectEqual(@as(u64, 3136), c.min_pixels);
+    try std.testing.expect((try parse(a, "{\"model_type\": \"minimax_m3_vl\"}", null)) == null);
+    const capped = (try parse(a, sample_config, "{\"max_pixels\": 200704, \"min_pixels\": 6272}")).?;
+    try std.testing.expectEqual([2]u64{ 6272, 200704 }, [2]u64{ capped.min_pixels, capped.max_pixels });
+    try std.testing.expectEqual(@as(u32, 256), capped.maxPatches() / 4);
+}
+
+test "a tower or processor this family does not serve is refused" {
+    const a = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    const swaps = [_][2][]const u8{
+        .{ "\"hidden_size\": 1280", "\"hidden_size\": 1024" },
+        .{ "\"patch_size\": 14", "\"patch_size\": 16" },
+        .{ "\"rope_mode\": \"3d\"", "\"rope_mode\": \"2d\"" },
+        .{ "\"spatial_merge_size\": 2,\n  \"temporal", "\"spatial_merge_size\": 4,\n  \"temporal" },
+        .{ "\"patch_merge\", \"spatial_merge_size\": 2, \"temporal_patch_size\": 2}}}", "\"pixel_shuffle\", \"spatial_merge_size\": 2, \"temporal_patch_size\": 2}}}" },
+        .{ "\"image_token_index\": 200025", "\"image_token_index\": 200064" },
+        .{ "\"hidden_act\": \"gelu\"", "\"hidden_act\": \"quick_gelu\"" },
+        .{ "\"layer_norm_eps\": 1e-05", "\"layer_norm_eps\": 1e-06" },
+        .{ "\"dynamic_res\"", "\"anyres\"" },
+    };
+    for (swaps) |s| {
+        const changed = try std.mem.replaceOwned(u8, arena.allocator(), sample_config, s[0], s[1]);
+        try std.testing.expect(!std.mem.eql(u8, changed, sample_config));
+        try std.testing.expectError(error.VisionConfig, parse(a, changed, sample_preprocessor));
+    }
+    for ([_][]const u8{ "{\"patch_size\": 16}", "{\"temporal_patch_size\": 1}", "{\"do_normalize\": false}", "{\"image_std\": [1, 0, 1]}", "{\"min_pixels\": 9000, \"max_pixels\": 3136}", "[]" }) |p| {
+        try std.testing.expectError(error.VisionConfig, parse(a, sample_config, p));
+    }
+}
