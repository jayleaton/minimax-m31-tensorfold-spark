diff --git a/zig/src/server/template_reference_test.zig b/zig/src/server/template_reference_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..3e302a6430bc9db8a5431195447b7f1eafeb87ce
--- /dev/null
+++ b/zig/src/server/template_reference_test.zig
@@ -0,0 +1,98 @@
+//! MiniMax-M3.1 serving goldens: each fixture request through the server's message and template path, byte for byte.
+const std = @import("std");
+const json = @import("json");
+const template = @import("template");
+const errors = @import("errors.zig");
+const messages_mod = @import("messages.zig");
+const prompt = @import("prompt.zig");
+const HfText = @import("hf_text.zig").HfText;
+const fixtures = @import("mm3_serve_fixtures");
+
+test {
+    _ = messages_mod; // the serving rules' own tests run in this step too
+}
+
+/// A chat template behind hf_text's render (its globals, thinking_mode word and context), without a tokenizer.
+const Text = struct {
+    hf: HfText,
+
+    fn init(gpa: std.mem.Allocator, source: []const u8) !Text {
+        var t: Text = .{ .hf = .{ .gpa = gpa, .arena = .init(gpa), .tok = undefined, .source = source } };
+        t.hf.compiled = try template.compile(gpa, source, null);
+        return t;
+    }
+
+    fn deinit(t: *Text) void {
+        t.hf.compiled.?.deinit();
+        t.hf.arena.deinit();
+    }
+};
+
+/// `prompt.renderIds`' text for a fixture request: `forTemplate` with MiniMax's late-system role, then the template.
+fn renderText(cx: *errors.Cx, t: *Text, c: json.Value, problem: *[]const u8) !?[]const u8 {
+    const tools: []const json.Value = if (c.get("tools").? == .array) c.get("tools").?.array else &.{};
+    const effort: ?[]const u8 = if (c.get("effort").? == .string) c.get("effort").?.string else null;
+    const options = prompt.renderOptions(tools, c.get("thinking").?.bool, effort, c.get("generation").?.bool);
+    const messages = messages_mod.forTemplate(cx, c.get("messages"), "system", false, .{}) catch |e| switch (e) {
+        error.OutOfMemory => return e,
+        error.Refused => {
+            problem.* = cx.message;
+            return null;
+        },
+    };
+    const r = t.hf.text().render(cx.a, messages, options, problem) catch |e| switch (e) {
+        error.OutOfMemory => return e,
+        error.Template => return null,
+    };
+    return r.text;
+}
+
+test "MiniMax-M3.1 serving: every reference request renders as the template renders it after the serving rules" {
+    const gpa = std.testing.allocator;
+    var m31 = try Text.init(gpa, fixtures.m31);
+    defer m31.deinit();
+    var mia = try Text.init(gpa, fixtures.mia);
+    defer mia.deinit();
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    var cases: usize = 0;
+    var bad: usize = 0;
+    var refused: usize = 0;
+    var skipped: usize = 0;
+    var ruled: usize = 0;
+    var it = std.mem.splitScalar(u8, fixtures.reference, '\n');
+    while (it.next()) |line| {
+        if (line.len == 0) continue;
+        _ = arena.reset(.retain_capacity);
+        const a = arena.allocator();
+        const c = (try json.parseText(a, line)).ok;
+        if (c.get("skip") != null) { // a request the server refuses on purpose (the line says why)
+            skipped += 1;
+            continue;
+        }
+        cases += 1;
+        const t = if (std.mem.eql(u8, c.get("template").?.string, "mia")) &mia else &m31;
+        var cx: errors.Cx = .{ .a = a };
+        var problem: []const u8 = "";
+        const got = try renderText(&cx, t, c, &problem);
+        const want = c.get("expected").?;
+        const ok = if (want == .string) (got != null and std.mem.eql(u8, got.?, want.string)) else (got == null and std.mem.indexOf(u8, problem, c.get("error").?.string) != null);
+        if (want != .string) refused += 1;
+        if (c.get("rules").?.array.len > 0) ruled += 1;
+        if (ok) continue;
+        bad += 1;
+        if (bad > 4) continue;
+        std.debug.print("reference case {s} ({s}) differs\n", .{ c.get("name").?.string, c.get("template").?.string });
+        if (got == null) {
+            std.debug.print("  refused: {s}\n", .{problem});
+        } else if (want == .string) {
+            const g = got.?;
+            const k = std.mem.indexOfDiff(u8, g, want.string) orelse g.len;
+            const from = k -| 40;
+            std.debug.print("  at byte {d}:\n  want {f}\n  got  {f}\n", .{ k, std.json.fmt(want.string[from..@min(want.string.len, k + 120)], .{}), std.json.fmt(g[from..@min(g.len, k + 120)], .{}) });
+        } else std.debug.print("  want refusal {s}, got text\n", .{c.get("error").?.string});
+    }
+    std.debug.print("minimax serve reference: {d}/{d} equal to Python Jinja2 ({d} refused as it refuses, {d} through a serving rule), {d} skipped\n", .{ cases - bad, cases, refused, ruled, skipped });
+    try std.testing.expect(cases >= 60);
+    try std.testing.expectEqual(@as(usize, 0), bad);
+}
diff --git a/zig/src/server/text_scan.zig b/zig/src/server/text_scan.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c12dc921e9fbc59b7a0ff32134d62e6f21a744f7
--- /dev/null
+++ b/zig/src/server/text_scan.zig
@@ -0,0 +1,103 @@
+//! Where a tag first lies in a reply's growing text, each search resumed past the bytes already searched.
+const std = @import("std");
+
+/// ``text.find(tag, from)`` led by a vector scan for the tag's first byte: markup is rare in prose, so it is fast.
+pub fn findTag(text: []const u8, from: usize, tag: []const u8) ?usize {
+    if (tag.len == 0) return if (from <= text.len) from else null;
+    var at = from;
+    while (at < text.len) {
+        const i = std.mem.indexOfScalarPos(u8, text, at, tag[0]) orelse return null;
+        if (std.mem.startsWith(u8, text[i..], tag)) return i;
+        at = i + 1;
+    }
+    return null;
+}
+
+/// A ``findTag`` the reply-text parsers call: plain, or a ``Scan``'s.
+pub const Finder = struct {
+    ctx: ?*anyopaque = null,
+    call: *const fn (ctx: ?*anyopaque, text: []const u8, from: usize, tag: []const u8) ?usize = plain,
+
+    pub fn find(f: Finder, text: []const u8, from: usize, tag: []const u8) ?usize {
+        return f.call(f.ctx, text, from, tag);
+    }
+
+    fn plain(_: ?*anyopaque, text: []const u8, from: usize, tag: []const u8) ?usize {
+        return findTag(text, from, tag);
+    }
+};
+
+/// Remembered searches over ``base``, a reply's text that only grows: a text that is a slice of it resumes each search.
+pub const Scan = struct {
+    base: []const u8 = "",
+    entries: [32]Entry = undefined,
+    used: usize = 0,
+    next: usize = 0, // the slot the next new search takes once all are used
+
+    /// ``tag`` from ``start`` in the reply: ``found`` its first place, else none lies whole before ``searched``.
+    const Entry = struct { start: usize, tag: []const u8, searched: usize, found: ?usize };
+
+    pub fn finder(s: *Scan) Finder {
+        return .{ .ctx = s, .call = call };
+    }
+
+    fn call(ctx: ?*anyopaque, text: []const u8, from: usize, tag: []const u8) ?usize {
+        const s: *Scan = @ptrCast(@alignCast(ctx.?));
+        return s.find(text, from, tag);
+    }
+
+    /// ``findTag(text, from, tag)``; ``text`` outside ``base`` (a copy) is searched whole.
+    pub fn find(s: *Scan, text: []const u8, from: usize, tag: []const u8) ?usize {
+        const lo = @intFromPtr(s.base.ptr);
+        const at = @intFromPtr(text.ptr);
+        if (tag.len == 0 or from > text.len or at < lo or at + text.len > lo + s.base.len) return findTag(text, from, tag);
+        const off = at - lo;
+        const start = off + from;
+        const end = off + text.len;
+        const e = s.entry(start, tag);
+        if (e.found) |f| return if (f + tag.len <= end) f - off else null;
+        if (end <= e.searched) return null;
+        const resume_at = @max(start, e.searched -| (tag.len - 1));
+        const hit = findTag(s.base[0..end], resume_at, tag);
+        e.searched = end;
+        e.found = hit;
+        return if (hit) |h| h - off else null;
+    }
+
+    fn entry(s: *Scan, start: usize, tag: []const u8) *Entry {
+        for (s.entries[0..s.used]) |*e| if (e.start == start and std.mem.eql(u8, e.tag, tag)) return e;
+        const slot = if (s.used < s.entries.len) blk: {
+            s.used += 1;
+            break :blk s.used - 1;
+        } else blk: {
+            s.next = (s.next + 1) % s.entries.len;
+            break :blk s.next;
+        };
+        s.entries[slot] = .{ .start = start, .tag = tag, .searched = start, .found = null };
+        return &s.entries[slot];
+    }
+};
+
+test "a scan answers as findTag does while its text grows, shrinks back and moves" {
+    const gpa = std.testing.allocator;
+    const reply = "ab<tool_call>x</tool_call> <|channel|>z </mm:think>\n\nok <tool_call";
+    const tags = [_][]const u8{ "<tool_call>", "</tool_call>", "<|channel|>", "</mm:think>", "<", "zz" };
+    var buf: std.ArrayList(u8) = .empty;
+    defer buf.deinit(gpa);
+    var scan: Scan = .{};
+    for (reply) |ch| {
+        try buf.append(gpa, ch);
+        try buf.ensureTotalCapacityPrecise(gpa, buf.capacity + 1); // the buffer moves: offsets still hold
+        scan.base = buf.items;
+        const f = scan.finder();
+        for (0..buf.items.len + 1) |cut| for (tags) |tag| for ([_]usize{ 0, 1, 3 }) |off| {
+            if (off > cut) continue;
+            const text = buf.items[off..cut];
+            try std.testing.expectEqual(findTag(text, 0, tag), f.find(text, 0, tag));
+            if (text.len > 2) try std.testing.expectEqual(findTag(text, 2, tag), f.find(text, 2, tag));
+        };
+        const copy = try gpa.dupe(u8, buf.items);
+        defer gpa.free(copy);
+        try std.testing.expectEqual(findTag(copy, 0, "<"), f.find(copy, 0, "<"));
+    }
+}
diff --git a/zig/src/server/think_plan.zig b/zig/src/server/think_plan.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5df1f918b920751aaf835b1553be507c1624c24b
--- /dev/null
+++ b/zig/src/server/think_plan.zig
@@ -0,0 +1,105 @@
+//! A reply's think plan: budget close, answer reserve, and a think close forced first where Info.first_mask is false.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json");
+const errors = @import("errors.zig");
+const grammar = @import("grammar.zig");
+const Server = @import("server.zig").Server;
+const Value = json.Value;
+const Cx = errors.Cx;
+
+pub const no_first_mask = "this engine cannot constrain a reply's first token, and the prompt does not end in the think close it could force instead: send the request with thinking on";
+
+/// A grammar's or budget's prompt tail: the think close cut to force first (returned), or an adaptive block opened.
+pub fn cutFirst(srv: *Server, cx: *Cx, f: Value, has_tools: bool, thinking: bool, ids: *[]const u32) errors.Refused!?u32 {
+    const calls = has_tools and (flagged(f, "tool_call_required") or flagged(f, "tool_call_strict"));
+    const constrained = srv.info.structures and (calls or try grammar.spec(cx, f) != null);
+    if (thinking) return if (constrained or budgetOf(srv, f) > 0) try openThink(srv, cx, ids) else null;
+    if (!constrained or srv.info.first_mask) return null;
+    return try cut(cx, srv.text.tokenId(srv.markers.close), ids);
+}
+
+fn flagged(f: Value, key: []const u8) bool {
+    return if (f.get(key)) |v| v.truthy() else false;
+}
+
+/// The request's thinking budget, else the server's (0: none).
+fn budgetOf(srv: *const Server, f: Value) i64 {
+    const field = f.get("thinking_budget");
+    return if (field != null and field.?.truthy()) field.?.int64() orelse 0 else srv.config.thinking_budget;
+}
+
+/// MiniMax's adaptive prompt that left the think block to the reply: no block is open for a loop guard to close.
+fn unopened(srv: *const Server, prompt: []const u32) bool {
+    const m = srv.mm_think orelse return false;
+    return prompt.len > 0 and prompt[prompt.len - 1] != m.open;
+}
+
+/// MiniMax's adaptive prompt opened, so the close its grammar starts after is sure to come (or the budget forces it).
+fn openThink(srv: *Server, cx: *Cx, ids: *[]const u32) errors.Refused!?u32 {
+    const m = srv.mm_think orelse return null;
+    const p = ids.*;
+    if (p.len == 0 or p[p.len - 1] == m.open or p[p.len - 1] == m.close) return null;
+    ids.* = try std.mem.concat(cx.a, u32, &.{ p, &.{m.open} });
+    return null;
+}
+
+fn cut(cx: *Cx, close: ?u32, ids: *[]const u32) errors.Refused!u32 {
+    const p = ids.*;
+    const end = close orelse return cx.refuse(no_first_mask);
+    if (p.len < 2 or p[p.len - 1] != end) return cx.refuse(no_first_mask);
+    ids.* = p[0 .. p.len - 1];
+    return end;
+}
+
+/// The budget, loop guard and answer reserve of a thinking request, or the forced first token of a cut one.
+pub fn apply(srv: *Server, cx: *Cx, f: Value, thinking: bool, forced: ?u32, room: i64, request: *api.Request) errors.Refused!void {
+    if (forced) |t| return force(cx, request, t);
+    if (!thinking) return;
+    const budget = budgetOf(srv, f);
+    if (budget > 0 and !srv.info.thinking_budget)
+        return cx.refuse("thinking_budget is not supported by this native engine");
+    if (srv.think_close.len > 0 and !unopened(srv, request.prompt)) request.loop_guard = srv.config.loop_guard;
+    if ((budget > 0 or request.loop_guard) and srv.think_close.len > 0) {
+        if (budget > 0) request.think_budget = @intCast(@min(budget, std.math.maxInt(u32)));
+        request.think_close = srv.think_close;
+        request.think_end = srv.think_close_end;
+    }
+    // The answer quota is separate only on engines that enforce it.
+    if (srv.info.answer_limit) @import("thinking_reserve.zig").apply(request, srv.config.thinking_reserve, room, srv.think_close_end);
+}
+
+/// The grammar starts after `token`, the reply's first token, forced as a one-token budget's close.
+fn force(cx: *Cx, request: *api.Request, token: u32) errors.Refused!void {
+    if (request.structure) |*s| s.after = token;
+    request.think_close = try cx.a.dupe(u32, &.{token});
+    request.think_end = token;
+    request.think_budget = 1;
+}
+
+test "a thinking-off prompt's think close is cut and forced first, so its grammar starts after it" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    var ids: []const u32 = &.{ 1, 2, 3, 9 };
+    try std.testing.expectEqual(@as(u32, 9), try cut(&cx, 9, &ids));
+    try std.testing.expectEqualSlices(u32, &.{ 1, 2, 3 }, ids);
+    var request: api.Request = .{ .prompt = ids, .max_tokens = 8, .structure = .{ .kind = .json, .text = "" } };
+    try force(&cx, &request, 9);
+    try std.testing.expectEqual(@as(?u32, 9), request.structure.?.after);
+    try std.testing.expectEqualSlices(u32, &.{9}, request.think_close);
+    try std.testing.expectEqual(@as(u32, 1), request.think_budget);
+    try std.testing.expectEqual(@as(?u32, 9), request.think_end);
+}
+
+test "a prompt that does not end in the think close is refused, not served with an unmasked first token" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    var ids: []const u32 = &.{ 1, 2, 3 };
+    try std.testing.expectError(error.Refused, cut(&cx, 9, &ids));
+    try std.testing.expectError(error.Refused, cut(&cx, null, &ids));
+    var one: []const u32 = &.{9};
+    try std.testing.expectError(error.Refused, cut(&cx, 9, &one));
+    try std.testing.expectEqualStrings(no_first_mask, cx.message);
+}
