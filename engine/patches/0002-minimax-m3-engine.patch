+test "a folder's config picks its kind; both kinds tap, draft seven a pass and price a ring a stream" {
+    const gpa = std.testing.allocator;
+    const a = try Spec.parse(gpa, dc.fixture);
+    const b = try Spec.parse(gpa, d2.incoai_fixture);
+    const c = try Spec.parse(gpa, d2.mm_class_fixture);
+    try std.testing.expectEqual(Kind.dspark, std.meta.activeTag(a));
+    try std.testing.expectEqual(Kind.dflash2, std.meta.activeTag(b));
+    try std.testing.expect(c.refusal(&target.flash, .{ .world = 2, .window_rows = 16 }) != null); // causal block rows
+    for ([_]Spec{ a, b, c }) |s| {
+        try std.testing.expectEqual(@as(u32, 7), s.depth());
+        try std.testing.expectEqual(@as(usize, s.depth()), s.prior().len);
+        const cst = try s.cost(&target.flash, 0, 2, 16, 2048, 8);
+        try std.testing.expect(cst.weights > 1 << 30 and cst.per_lane > 20 << 20);
+    }
+    try std.testing.expect(b.refusal(&target.flash, .{ .world = 2, .window_rows = 16 }) == null);
+    try std.testing.expectEqualSlices(u32, &.{ 5, 16, 26, 37, 47, 58 }, b.tapIds());
+    try std.testing.expectEqual(@as(u32, 6 * 6144 * 2), b.featureBytes());
+    for (dflash2_prior[1..], dflash2_prior[0 .. dflash2_prior.len - 1]) |x, y| try std.testing.expect(x < y);
+}
+
+test "the dspark prior has one conditional rate a drafted level, each a probability" {
+    try std.testing.expectEqual(@as(usize, dc.flash.block), dspark_prior.len);
+    for (dspark_prior) |p| try std.testing.expect(p > 0 and p < 1);
+}
+
+test "TF_MM3_DRAFT_DEPTH offers fewer of a DFlash2 block's proposals; a dspark pass keeps its block" {
+    var s = try Spec.parse(std.testing.allocator, d2.incoai_fixture);
+    try s.limit(5);
+    try std.testing.expectEqual(@as(u32, 5), s.depth());
+    try std.testing.expectEqual(@as(usize, 5), s.prior().len);
+    try std.testing.expectEqual(@as(u32, 8), s.dflash2.block); // the pass still runs every trained row
+    try std.testing.expectError(error.BadDepth, s.limit(8));
+    var p = try Spec.parse(std.testing.allocator, dc.fixture);
+    try p.limit(5); // the dspark drafter caps the round (dspark_drafter.depthCap), its pass and prior keep the block
+    try std.testing.expectEqual(@as(u32, 7), p.depth());
+    try std.testing.expectEqual(@as(usize, 7), p.prior().len);
+}
+
+test "a thin model refuses the draft's own deep taps until TF_MM3_DRAFT_TAPS moves them inside the cut" {
+    var s = try Spec.parse(std.testing.allocator, d2.incoai_fixture);
+    const here: dc.Place = .{ .world = 1, .window_rows = 16 };
+    try std.testing.expect(s.refusal(&cut(&target.flash, 20), here) != null);
+    try s.retap(&.{ 1, 4, 8, 12, 16, 19 });
+    try std.testing.expect(s.refusal(&cut(&target.flash, 20), here) == null);
+    try std.testing.expectError(error.TapCount, s.retap(&.{ 1, 2 }));
+    try std.testing.expectEqual(target.flash.layers, cut(&target.flash, 0).layers);
+    try std.testing.expectEqual(@as(u32, 20), tapped(&s, &target.flash, 20).layers);
+    const p = try Spec.parse(std.testing.allocator, dc.fixture);
+    try std.testing.expectEqual(target.flash.layers, tapped(&p, &target.flash, 20).layers); // its taps past the cut stay zero
+}
