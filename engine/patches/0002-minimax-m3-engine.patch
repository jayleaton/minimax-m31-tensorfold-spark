@@ -0,0 +1,97 @@
+//! MiniMax-M3.1 image prompts through the server's template and image path equal the HF processor's ids, id for id.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json");
+const options = @import("mm3_options");
+const goldens = @import("mm3_vision_fixtures");
+const errors = @import("errors.zig");
+const messages_mod = @import("messages.zig");
+const prompt = @import("prompt.zig");
+const images = @import("images.zig");
+const HfText = @import("hf_text.zig").HfText;
+
+/// MiniMax-M3.1's image ids (config.json image_token_index, added_tokens.json) as vision/vision.zig offers them.
+const image = 200025;
+const start = 200029;
+const end = 200030;
+const video = 200026;
+
+/// Each golden picture's patch grid, keyed by its bytes: the processor's own grids.
+const Grids = struct {
+    cases: []const json.Value,
+
+    fn prepare(ctx: *anyopaque, a: std.mem.Allocator, bytes: []const u8, _: u32) anyerror!api.PreparedImage {
+        const g: *Grids = @ptrCast(@alignCast(ctx));
+        const name = goldens.nameOf(bytes) orelse return error.UnknownPicture;
+        for (g.cases) |c| if (std.mem.eql(u8, c.get("name").?.string, name)) {
+            const gh = try int(c.get("gh").?);
+            const gw = try int(c.get("gw").?);
+            return .{ .pixels = try a.alloc(f32, 0), .gh = gh, .gw = gw, .tokens = gh * gw / 4, .hash = std.hash.Wyhash.hash(0, bytes) };
+        };
+        return error.UnknownPicture;
+    }
+};
+
+/// The golden's `data:,<file>` URLs as base64 data URLs of the files' bytes, in place.
+fn embedPictures(a: std.mem.Allocator, messages: json.Value) !void {
+    for (messages.array) |m| {
+        const content = m.get("content") orelse continue;
+        if (content != .array) continue;
+        for (content.array) |p| if (p.get("image_url")) |iu| {
+            const url = iu.get("url").?.string;
+            const bytes = goldens.picture(url["data:,".len..]) orelse return error.UnknownPicture;
+            const enc = std.base64.standard.Encoder;
+            const out = try a.alloc(u8, "data:image/png;base64,".len + enc.calcSize(bytes.len));
+            @memcpy(out[0.."data:image/png;base64,".len], "data:image/png;base64,");
+            _ = enc.encode(out["data:image/png;base64,".len..], bytes);
+            try iu.object.put(a, "url", .{ .string = out });
+        };
+    }
+}
+
+fn int(v: json.Value) !u32 {
+    return std.fmt.parseInt(u32, v.int, 10);
+}
+
+test "MiniMax-M3.1 image prompts: the server's ids are the processor's, one image, two, and one in a tool result" {
+    const gpa = std.testing.allocator;
+    const dir = std.fs.path.dirname(options.tokenizer_path) orelse return error.SkipZigTest;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var problem: []const u8 = "";
+    const text = HfText.load(gpa, std.testing.io, dir, null, a, &problem) catch |err| {
+        std.debug.print("skipped: {s} ({s}); pass -Dmm3-tokenizer=<checkpoint>/tokenizer.json\n", .{ problem, @errorName(err) });
+        return error.SkipZigTest;
+    };
+    defer text.deinit();
+    const golden = (try json.parseText(a, goldens.golden)).ok;
+    var grids: Grids = .{ .cases = golden.get("cases").?.array };
+    const markers = [_]u32{ start, image, end, video };
+    const vision: api.Vision = .{ .ctx = &grids, .prepare = Grids.prepare, .image_token = image, .markers = &markers, .wrap = .{ start, end }, .part_type = "image", .image_tokens = 4096, .max_images = 4 };
+    const cases = golden.get("prompts").?.array;
+    try std.testing.expectEqual(@as(usize, 3), cases.len);
+    for (cases) |c| {
+        try embedPictures(a, c.get("messages").?);
+        var cx: errors.Cx = .{ .a = a };
+        errdefer std.debug.print("prompt {d}: {s} {s}\n", .{ c.get("images").?.array.len, cx.message, problem });
+        const normalized = try messages_mod.forTemplate(&cx, c.get("messages"), "system", false, .of(vision));
+        var rendered = try text.text().render(a, normalized, prompt.renderOptions(&.{}, true, null, true), &problem);
+        const ids = try rendered.encode(text.text(), a, &problem);
+        const got = (try images.expand(vision, null, text.text(), &cx, normalized, ids, 0)).?;
+        const want = c.get("input_ids").?.array;
+        try std.testing.expectEqual(want.len, got.ids.len);
+        for (want, got.ids, 0..) |w, g, i| if (try int(w) != g) {
+            std.debug.print("prompt {d}: id {d} is {d}, the processor's {s}\n", .{ c.get("images").?.array.len, i, g, w.int });
+            return error.TestUnexpectedResult;
+        };
+        // each image's rows start right after its start id, in prompt order
+        var k: usize = 0;
+        for (got.ids, 0..) |t, i| if (t == start) {
+            try std.testing.expectEqual(@as(u32, @intCast(i + 1)), got.images[k].at);
+            try std.testing.expectEqual(end, got.ids[i + 1 + got.images[k].tokens]);
+            k += 1;
+        };
+        try std.testing.expectEqual(got.images.len, k);
+    }
+}
diff --git a/zig/src/server/minimax_serve_test.zig b/zig/src/server/minimax_serve_test.zig
