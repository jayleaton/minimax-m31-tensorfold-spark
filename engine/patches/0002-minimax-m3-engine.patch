diff --git a/zig/src/cuda/minimax_m3_dspark_topc.zig b/zig/src/cuda/minimax_m3_dspark_topc.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d9a7f4959c0146c1e27e3e64547f93eda477fdb7
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_dspark_topc.zig
@@ -0,0 +1,79 @@
+//! The dspark top-C in two steps (minimax_m3_dspark_topc.cu): slices of a row keep their c best, one CTA merges them.
+const std = @import("std");
+const kernels = @import("kernels.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+
+const Driver = @import("driver.zig").Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = @import("stream.zig").Stream;
+
+pub const threads = 256;
+pub const max_c = 64;
+pub const merge_max = 2048; // slices x c one merge sorts
+pub const per_slice = 8192; // logits a slice scans at least
+
+/// Slices a row of n logits takes: about per_slice each, as many as one merge holds.
+pub fn slices(n: usize, c: usize) u32 {
+    const most = merge_max / @max(c, 1);
+    return @intCast(std.math.clamp((n + per_slice - 1) / per_slice, 1, most));
+}
+
+/// Scratch bytes of the slices' candidates.
+pub fn partBytes(rows: usize, n: usize, c: usize) usize {
+    return rows * @as(usize, slices(n, c)) * c * 8;
+}
+
+pub const TopC = struct {
+    mod: Module,
+    part_fn: Function,
+    merge_fn: Function,
+
+    pub fn load(d: *const Driver) !TopC {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var m = try Module.load(d, kernels.minimax_m3_dspark_topc);
+        errdefer m.unload();
+        return .{ .mod = m, .part_fn = try m.function("tf_mm3_ds_topc_part"), .merge_fn = try m.function("tf_mm3_ds_topc_merge") };
+    }
+
+    pub fn unload(t: *TopC) void {
+        t.mod.unload();
+    }
+
+    /// tf_mm3_ds_topc's output, word for word: out [rows][c] of {f32 logit, i32 id0 + index}; `part` holds partBytes.
+    pub fn run(t: *const TopC, st: Stream, logits: u64, ld: usize, n: u32, id0: u32, rows: u32, c: u32, out: u64, part: u64) !void {
+        if (rows == 0 or n == 0 or c == 0) return error.Empty;
+        if (rows > 65535) return error.TooManyRows;
+        if (c > max_c or ld < n or n > std.math.maxInt(i32) or @as(u64, id0) + n > std.math.maxInt(i32)) return error.BadShape;
