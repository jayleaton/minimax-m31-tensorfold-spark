diff --git a/zig/src/families/minimax_m3/vision/image.zig b/zig/src/families/minimax_m3/vision/image.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d458013e3f5bbdc945f87ad789a8c8f658290931
--- /dev/null
+++ b/zig/src/families/minimax_m3/vision/image.zig
@@ -0,0 +1,142 @@
+//! MiniMax-M3.1-Flash's image processor (image_processor.py, torchvision fast): bytes to patches in merge order.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const core = @import("core");
+const picture = core.picture;
+const geometry = core.qwen_vl.geometry;
+pub const config = @import("config.zig");
+pub const Config = config.Config;
+pub const parse = config.parse;
+
+/// The decoder's refusals, a budget too small for an image, and a side past 200 times the other.
+pub const Error = geometry.Error;
+
+/// Patches f32 [gh * gw, 1176] in merge order, the patch grid, the image's token count and its cache identity.
+pub const Prepared = geometry.Prepared;
+
+/// This family's tag in each image identity ("mm31"): its prepared patches are not another family's.
+pub const tag: u64 = 0x6d6d3331;
+
+/// The words for a refusal only the image path knows: the decoder's libraries, and a side past 200 times the other.
+pub fn problem(err: anyerror) ?[]const u8 {
+    return geometry.problem(err);
+}
+
+/// Bytes to patches as the processor makes them from `Image.open(bytes).convert("RGB")`; `max_tokens` cuts the bound.
+pub fn prepare(io: std.Io, a: Allocator, bytes: []const u8, c: Config, max_tokens: u32) Error!Prepared {
+    var img = try decode(io, a, bytes);
+    defer img.deinit(a);
+    return prepareRgb(a, img, picture.identity.ofBytes(tag, bytes), c, max_tokens);
+}
+
+/// PNG, JPEG or WebP as Pillow opens them and convert("RGB") keeps them: alpha dropped, EXIF orientation not applied.
+pub fn decode(io: std.Io, a: Allocator, bytes: []const u8) picture.Error!picture.Rgb {
+    var s = switch (picture.sniff(bytes)) {
+        .png => try picture.png.decode(a, bytes),
+        .jpeg => try picture.jpeg.decode(io, a, bytes),
+        .webp => try picture.webp.decode(io, a, bytes),
+        .unknown => return error.Invalid,
+    };
+    defer a.free(s.data);
+    if (s.channels == 4) {
+        var i: usize = 3;
+        while (i < s.data.len) : (i += 4) s.data[i] = 255;
+    }
+    s.orientation = 1;
+    return picture.finish(a, s);
+}
+
+/// RGB to patches: smart_resize inside the budget's bounds, torch's uint8 antialiased bicubic, the fused normalize.
+pub fn prepareRgb(a: Allocator, img: picture.Rgb, bytes_hash: u64, c: Config, max_tokens: u32) Error!Prepared {
+    if (max_tokens == 0) return error.ImageTooSmall;
+    const q = qwen(c);
+    const b = geometry.bounds(q, max_tokens);
+    const size = try smartResize(@intCast(img.height), @intCast(img.width), c.factor(), b[0], b[1]);
+    const grid = [2]u32{ size.h / c.patch, size.w / c.patch };
+    const tokens = grid[0] * grid[1] / (c.merge * c.merge);
+    if (tokens > max_tokens) return error.ImageTooSmall; // the processor's floor rounds past a tight budget
+    const resized = try picture.resample.resize(a, .torch, .of(img.pixels, img.width, img.height), size.w, size.h);
+    defer a.free(resized);
+    const pixels = try geometry.patchify(a, .{ .width = size.w, .height = size.h, .pixels = resized }, q);
+    return .{ .pixels = pixels, .gh = grid[0], .gw = grid[1], .tokens = tokens, .hash = picture.identity.withGrid(bytes_hash, grid) };
+}
+
+/// image_processor.py's smart_resize: Qwen's, but a side rounding to nothing starts at one factor (max(factor, ...)).
+pub fn smartResize(height: u32, width: u32, factor: u32, min_pixels: u64, max_pixels: u64) error{AspectRatio}!geometry.Size {
+    const h: f64 = @floatFromInt(height);
+    const w: f64 = @floatFromInt(width);
+    if (@max(h, w) / @min(h, w) > 200) return error.AspectRatio;
+    const f: f64 = @floatFromInt(factor);
+    var hb = @max(f, roundEven(h / f) * f);
+    var wb = @max(f, roundEven(w / f) * f);
+    const most: f64 = @floatFromInt(max_pixels);
+    const least: f64 = @floatFromInt(min_pixels);
+    if (hb * wb > most) {
+        const beta = @sqrt(h * w / most);
+        // the processor has no floor of one factor here; under its own bounds a side never falls below one
+        hb = @max(f, @floor(h / beta / f) * f);
+        wb = @max(f, @floor(w / beta / f) * f);
+    } else if (hb * wb < least) {
+        const beta = @sqrt(least / (h * w));
+        hb = @ceil(h * beta / f) * f;
+        wb = @ceil(w * beta / f) * f;
+    }
+    return .{ .h = @intFromFloat(hb), .w = @intFromFloat(wb) };
+}
+
+/// Python's round: a half goes to the even neighbour.
+fn roundEven(x: f64) f64 {
+    const r = @round(x);
+    return if (@abs(x - @trunc(x)) == 0.5 and @mod(r, 2) != 0) r - std.math.sign(x) else r;
+}
+
+/// The shared patch cutter's settings: rescale folded in, (x - 255 m) / (255 s) in f32 as the fast processor fuses it.
+fn qwen(c: Config) core.qwen_vl.Config {
+    const scale: f32 = @floatCast(1.0 / c.rescale);
+    var q: core.qwen_vl.Config = .{ .depth = c.layers, .hidden = c.hidden, .heads = c.heads, .intermediate = c.ffn, .out_hidden = c.text_hidden, .patch = c.patch, .temporal = c.temporal, .merge = c.merge, .positions = 0, .image_token = c.image_token, .vision_start = c.image_start, .vision_end = c.image_end, .video_token = c.video_token, .min_pixels = c.min_pixels, .max_pixels = c.max_pixels, .rescale = 1, .mean = c.mean, .std = c.std };
+    for (&q.mean, &q.std) |*m, *s| {
+        m.* *= scale;
+        s.* *= scale;
+    }
+    return q;
+}
+
+test "smart_resize as image_processor.py rounds, grows, shrinks and refuses" {
+    const c: Config = .{};
+    const cases = [_][2][2]u32{
+        .{ .{ 70, 98 }, .{ 56, 112 } }, // 2.5 rounds to 2, 3.5 to 4
+        .{ .{ 20, 30 }, .{ 56, 84 } }, // under min_pixels: grown
+        .{ .{ 600, 760 }, .{ 588, 756 } }, // past max_pixels: shrunk
+        .{ .{ 672, 672 }, .{ 672, 672 } },
+        .{ .{ 10, 1900 }, .{ 28, 1904 } }, // a side rounding to 0 starts at 28 (Qwen's rule would grow it to 28 x 784)
+        .{ .{ 30, 900 }, .{ 28, 896 } },
+    };
+    for (cases) |k| {
+        const got = try smartResize(k[0][0], k[0][1], c.factor(), c.min_pixels, c.max_pixels);
+        try std.testing.expectEqual(geometry.Size{ .h = k[1][0], .w = k[1][1] }, got);
+    }
+    try std.testing.expectError(error.AspectRatio, smartResize(2, 402, 28, c.min_pixels, c.max_pixels));
+    try std.testing.expectEqualStrings("its longer side is more than 200 times its shorter side", problem(error.AspectRatio).?);
+}
+
+test "the token budget cuts the bound, normalization is the fused (x - 255 m) / (255 s), and the hash names the grid" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const c: Config = .{};
+    const photo: picture.Rgb = .{ .width = 800, .height = 600, .pixels = try a.alloc(u8, 800 * 600 * 3) };
+    @memset(photo.pixels, 200);
+    const whole = try prepareRgb(a, photo, 7, c, 100000);
+    try std.testing.expectEqual([3]u32{ 40, 54, 540 }, [3]u32{ whole.gh, whole.gw, whole.tokens });
+    try std.testing.expectEqual(@as(usize, 40 * 54 * 1176), whole.pixels.len);
+    const cut = try prepareRgb(a, photo, 7, c, 64);
+    try std.testing.expectEqual([3]u32{ 12, 18, 54 }, [3]u32{ cut.gh, cut.gw, cut.tokens }); // 168 x 252, as smart_resize at 64 x 784
+    try std.testing.expect(cut.hash != whole.hash);
+    const red: f32 = (200 - @as(f32, 0.48145466) * 255) / (@as(f32, 0.26862954) * 255);
+    try std.testing.expectEqual(red, whole.pixels[0]);
+    try std.testing.expectEqual(red, whole.pixels[196]); // the second frame repeats the first
+    try std.testing.expectError(error.ImageTooSmall, prepareRgb(a, photo, 7, c, 0));
+    const strip: picture.Rgb = .{ .width = 2, .height = 380, .pixels = try a.alloc(u8, 380 * 2 * 3) };
+    @memset(strip.pixels, 1);
+    try std.testing.expectError(error.ImageTooSmall, prepareRgb(a, strip, 7, c, 1)); // a 2-pixel side keeps 13 tokens
+}
diff --git a/zig/src/families/minimax_m3/vision/image_golden_test.zig b/zig/src/families/minimax_m3/vision/image_golden_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..645481f5848487cbbeead0321495fa2df74f6207
--- /dev/null
+++ b/zig/src/families/minimax_m3/vision/image_golden_test.zig
@@ -0,0 +1,135 @@
+//! image.zig against the checkpoint's processor (tools/zig/mm3_vision/gen_preprocess_golden.py): grids, pixels, ids.
+const std = @import("std");
+const core = @import("core");
+const picture = core.picture;
+const image = @import("image.zig");
+
+const fixtures = "zig/src/families/minimax_m3/vision/fixtures";
+
+const Case = struct {
+    name: []const u8,
+    width: usize,
+    height: usize,
+    rgb: []const u8,
+    problem: ?[]const u8 = null,
+    gh: u32 = 0,
+    gw: u32 = 0,
+    tokens: u32 = 0,
+    resized: []const u8 = "",
+    pixels: []const u8 = "",
+    stride: usize = 1,
+    samples: []const f32 = &.{},
+};
+
+const Prompt = struct { images: []const []const u8, input_ids: []const u32 };
+
+const Golden = struct { max_pixels: u64, cases: []const Case, prompts: []const Prompt = &.{} };
+
+fn sha256(bytes: []const u8) [64]u8 {
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &digest, .{});
+    return std.fmt.bytesToHex(digest, .lower);
+}
+
+/// A pinned decoder library: required when its variable names a file, else its pictures are skipped.
+fn ready(comptime lib: type) !bool {
+    if (lib.available(std.testing.io, std.testing.allocator)) return true;
+    if (std.c.getenv(lib.env) != null) return error.PinnedLibraryDidNotLoad;
+    std.debug.print("{s} {s} not found: its pictures skipped\n", .{ lib.env, lib.pinned });
+    return false;
+}
+
+fn load(arena: std.mem.Allocator, dir: []const u8) !Golden {
+    const path = try std.fs.path.join(arena, &.{ dir, "golden.json" });
+    const text = try std.Io.Dir.cwd().readFileAlloc(std.testing.io, path, arena, .limited(1 << 24));
+    return std.json.parseFromSliceLeaky(Golden, arena, text, .{ .ignore_unknown_fields = true });
+}
+
+/// Every case in `dir` decoded and prepared: grid, tokens and the resized and normalized bytes equal the processor's.
+fn check(arena: std.mem.Allocator, dir: []const u8, golden: Golden) !usize {
+    const a = std.testing.allocator;
+    const libs = .{ .jpeg = try ready(picture.jpeg), .webp = try ready(picture.webp) };
+    const c: image.Config = .{ .max_pixels = golden.max_pixels };
+    var checked: usize = 0;
+    for (golden.cases) |k| {
+        errdefer std.debug.print("case {s}\n", .{k.name});
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(std.testing.io, try std.fs.path.join(arena, &.{ dir, k.name }), arena, .limited(64 << 20));
+        switch (picture.sniff(bytes)) {
+            .jpeg => if (!libs.jpeg) continue,
+            .webp => if (!libs.webp) continue,
+            else => {},
+        }
+        var rgb = try image.decode(std.testing.io, a, bytes);
+        defer rgb.deinit(a);
+        try std.testing.expectEqual([2]usize{ k.width, k.height }, [2]usize{ rgb.width, rgb.height });
+        try std.testing.expectEqualStrings(k.rgb, &sha256(rgb.pixels));
+        if (k.problem != null) {
+            try std.testing.expectError(error.AspectRatio, image.prepare(std.testing.io, a, bytes, c, std.math.maxInt(u32)));
+            checked += 1;
+            continue;
+        }
+        const p = try image.prepare(std.testing.io, a, bytes, c, std.math.maxInt(u32));
+        defer a.free(p.pixels);
+        try std.testing.expectEqual([3]u32{ k.gh, k.gw, k.tokens }, [3]u32{ p.gh, p.gw, p.tokens });
+        const resized = try picture.resample.resize(a, .torch, .of(rgb.pixels, rgb.width, rgb.height), k.gw * c.patch, k.gh * c.patch);
+        defer a.free(resized);
+        try std.testing.expectEqualStrings(k.resized, &sha256(resized));
+        var worst: f32 = 0;
+        for (k.samples, 0..) |want, i| worst = @max(worst, @abs(want - p.pixels[i * k.stride]));
+        std.debug.print("{s}: {d}x{d} -> grid {d}x{d}, {d} tokens, sampled max |diff| {e}\n", .{ k.name, k.width, k.height, p.gh, p.gw, p.tokens, worst });
+        try std.testing.expectEqual(@as(usize, p.gh) * p.gw * c.patchWidth(), p.pixels.len);
+        try std.testing.expectEqualStrings(k.pixels, &sha256(std.mem.sliceAsBytes(p.pixels)));
+        checked += 1;
+    }
+    return checked;
+}
+
+test "each fixture prepares to the processor's grid, tokens and exact float32 patches" {
+    var arena_state = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const golden = try load(arena, fixtures);
+    const checked = try check(arena, fixtures, golden);
+    const all = picture.jpeg.available(std.testing.io, std.testing.allocator) and picture.webp.available(std.testing.io, std.testing.allocator);
+    try std.testing.expect(checked >= @as(usize, if (all) golden.cases.len else 4)); // the PNG cases need no library
+}
+
+test "the processor's expanded prompts hold start, one id a token, end, for each picture in order" {
+    var arena_state = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const golden = try load(arena, fixtures);
+    const c: image.Config = .{};
+    try std.testing.expectEqual(@as(usize, 3), golden.prompts.len); // one picture, two, and one in a tool result
+    for (golden.prompts) |pr| {
+        var at: usize = 0;
+        var images: usize = 0;
+        for (pr.input_ids, 0..) |id, i| {
+            if (i < at) continue;
+            try std.testing.expect(id != c.image_token and id != c.image_end and id != c.video_token);
+            if (id != c.image_start) continue;
+            const want = for (golden.cases) |k| {
+                if (std.mem.eql(u8, k.name, pr.images[images])) break k.tokens;
+            } else unreachable;
+            for (pr.input_ids[i + 1 ..][0..want]) |t| try std.testing.expectEqual(c.image_token, t);
+            try std.testing.expectEqual(c.image_end, pr.input_ids[i + 1 + want]);
+            at = i + 2 + want;
+            images += 1;
+        }
+        try std.testing.expectEqual(pr.images.len, images);
+    }
+}
+
+test "pictures in $MM3_VISION_EXTRA (a gen_preprocess_golden.py --photos directory), when it is set" {
+    const dir = std.mem.span(std.c.getenv("MM3_VISION_EXTRA") orelse return);
+    var arena_state = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const golden = try load(arena, dir);
+    try std.testing.expectEqual(golden.cases.len, try check(arena, dir, golden));
+}
+
+test {
+    _ = image;
+    _ = image.config;
+}
diff --git a/zig/src/families/minimax_m3/vision/passes.zig b/zig/src/families/minimax_m3/vision/passes.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4ed98de18e0618059eab041960935698390eba6e
--- /dev/null
+++ b/zig/src/families/minimax_m3/vision/passes.zig
@@ -0,0 +1,181 @@
+//! Each slot's prompt pass of image rows: the spans it reads, one device buffer of their rows, the splice after embed.
+const std = @import("std");
+const cuda = @import("cuda");
+const Image = @import("lanes").stream.Image;
+const Allocator = std.mem.Allocator;
+
+/// An image's placeholder rows [at, at + n) of the prompt, its rows from `row` of the slot's buffer.
+pub const Span = struct { at: u32, n: u32, row: u32 };
+
+/// Words a span takes on the follower link.
+pub const span_words = 3;
+
+/// The images a pass from `from` reads, in prompt order, rows back to back; `index[i]` is span i's image.
+pub fn plan(a: Allocator, images: []const Image, from: u32, index: []u32) ![]Span {
+    if (index.len < images.len) return error.ImageSpans;
+    var out: std.ArrayList(Span) = .empty;
+    errdefer out.deinit(a);
+    var row: u32 = 0;
+    var end: u32 = 0;
+    for (images, 0..) |img, i| {
+        if (img.at < end or img.tokens == 0) return error.ImageSpans; // in order, apart, each with rows
+        end = std.math.add(u32, img.at, img.tokens) catch return error.ImageSpans;
+        if (end <= from) continue; // a resumed prefix holds these rows' states already
+        index[out.items.len] = @intCast(i);
+        try out.append(a, .{ .at = img.at, .n = img.tokens, .row = row });
+        row = std.math.add(u32, row, img.tokens) catch return error.ImageSpans;
+    }
+    return out.toOwnedSlice(a);
+}
+
+pub fn total(spans: []const Span) u32 {
+    var n: u32 = 0;
+    for (spans) |s| n += s.n;
+    return n;
+}
+
+/// The spans as the link's words (`span_words` each).
+pub fn encode(spans: []const Span, out: []u32) ![]const u32 {
+    if (out.len < spans.len * span_words) return error.ImageSpans;
+    for (spans, 0..) |s, i| out[i * span_words ..][0..span_words].* = .{ s.at, s.n, s.row };
+    return out[0 .. spans.len * span_words];
+}
+
+/// `encode`'s words back to spans, checked: in order, apart, rows back to back from 0.
+pub fn decode(a: Allocator, words: []const u32) ![]Span {
+    if (words.len == 0 or words.len % span_words != 0) return error.ImageSpans;
+    const out = try a.alloc(Span, words.len / span_words);
+    errdefer a.free(out);
+    var end: u64 = 0;
+    var row: u32 = 0;
+    for (out, 0..) |*s, i| {
+        const w = words[i * span_words ..][0..span_words];
+        s.* = .{ .at = w[0], .n = w[1], .row = w[2] };
+        if (s.n == 0 or s.at < end or s.row != row) return error.ImageSpans;
+        end = @as(u64, s.at) + s.n;
+        row = std.math.add(u32, row, s.n) catch return error.ImageSpans;
+    }
+    return out;
+}
+
+/// The part of `sp` prompt rows [lo, hi) cross: its first prompt row, its first buffer row, its rows; null for none.
+pub fn cut(sp: Span, lo: u64, hi: u64) ?[3]u64 {
+    const from = @max(lo, sp.at);
+    const to = @min(hi, @as(u64, sp.at) + sp.n);
+    return if (from < to) .{ from, sp.row + (from - sp.at), to - from } else null;
+}
+
+/// One slot's pass: its spans and their bf16 rows [total, hidden] on the device.
+pub const Pass = struct {
+    spans: []Span,
+    buf: cuda.DeviceBuffer,
+
+    /// Where span `s`'s rows start.
+    pub fn at(p: *const Pass, s: Span, hidden: usize) u64 {
+        return p.buf.ptr + @as(u64, s.row) * hidden * 2;
+    }
+
+    pub fn bytes(p: *const Pass, hidden: usize) usize {
+        return @as(usize, total(p.spans)) * hidden * 2;
+    }
+};
+
+/// Every slot's pass; a slot holds at most one, made when its pass begins and gone when it ends.
+pub const Passes = struct {
+    gpa: Allocator,
+    d: *const cuda.Driver,
+    hidden: usize,
+    limit: u32, // image rows one request holds at most
+    held: std.AutoHashMapUnmanaged(u32, Pass) = .empty,
+
+    pub fn deinit(p: *Passes) void {
+        var it = p.held.valueIterator();
+        while (it.next()) |x| free(p.gpa, x);
+        p.held.deinit(p.gpa);
+    }
+
+    /// Slot `slot`'s new pass over `spans` (taken, gpa-owned), its rows allocated; an older pass of the slot goes.
+    pub fn open(p: *Passes, slot: u32, spans: []Span) !*Pass {
+        errdefer p.gpa.free(spans);
+        p.drop(slot);
+        const n = total(spans);
+        if (n == 0 or n > p.limit) return error.ImageRows;
+        const buf = try cuda.DeviceBuffer.alloc(p.d, @as(usize, n) * p.hidden * 2);
+        errdefer {
+            var b = buf;
+            b.free();
+        }
+        try p.held.put(p.gpa, slot, .{ .spans = spans, .buf = buf });
+        return p.held.getPtr(slot).?;
+    }
+
+    /// The slot's pass ends; its rows go (the caller has waited for every forward that reads them).
+    pub fn drop(p: *Passes, slot: u32) void {
+        if (p.held.fetchRemove(slot)) |kv| {
+            var x = kv.value;
+            free(p.gpa, &x);
+        }
+    }
+
+    pub fn holds(p: *const Passes, slot: u32) bool {
+        return p.held.contains(slot);
+    }
+
+    /// Prompt rows [lo, hi) of `slot` embedded at `emb` (row lo first) take the image rows they cross.
+    pub fn splice(p: *const Passes, s: cuda.Stream, slot: u32, lo: u64, hi: u64, emb: u64) !void {
+        const pass = p.held.getPtr(slot) orelse return;
+        const w = p.hidden * 2;
+        for (pass.spans) |sp| {
+            const from, const row, const n = cut(sp, lo, hi) orelse continue;
+            try p.d.check(p.d.api.cuMemcpyDtoDAsync_v2(emb + (from - lo) * w, pass.buf.ptr + row * w, n * w, s.handle), "cuMemcpyDtoDAsync");
+        }
+    }
+
+    fn free(gpa: Allocator, x: *Pass) void {
+        x.buf.free();
+        gpa.free(x.spans);
+    }
+};
+
+test "a pass from a resumed point plans the images that end past it, rows back to back" {
+    const a = std.testing.allocator;
+    const imgs = [_]Image{
+        .{ .pixels = &.{}, .gh = 32, .gw = 32, .at = 5, .tokens = 256 },
+        .{ .pixels = &.{}, .gh = 40, .gw = 30, .at = 300, .tokens = 300 },
+        .{ .pixels = &.{}, .gh = 32, .gw = 32, .at = 700, .tokens = 256 },
+    };
+    var index: [3]u32 = undefined;
+    const all = try plan(a, &imgs, 0, &index);
+    defer a.free(all);
+    try std.testing.expectEqualSlices(Span, &.{ .{ .at = 5, .n = 256, .row = 0 }, .{ .at = 300, .n = 300, .row = 256 }, .{ .at = 700, .n = 256, .row = 556 } }, all);
+    const later = try plan(a, &imgs, 400, &index);
+    defer a.free(later);
+    try std.testing.expectEqualSlices(Span, &.{ .{ .at = 300, .n = 300, .row = 0 }, .{ .at = 700, .n = 256, .row = 300 } }, later);
+    try std.testing.expectEqualSlices(u32, &.{ 1, 2 }, index[0..2]);
+    try std.testing.expectEqual(@as(u32, 556), total(later));
+    const overlapping = [_]Image{ imgs[1], imgs[0] };
+    try std.testing.expectError(error.ImageSpans, plan(a, &overlapping, 0, &index));
+}
+
+test "spans cross the link and back; a broken word list is refused" {
+    const a = std.testing.allocator;
+    const spans = [_]Span{ .{ .at = 3, .n = 4, .row = 0 }, .{ .at = 20, .n = 9, .row = 4 } };
+    var words: [6]u32 = undefined;
+    const w = try encode(&spans, &words);
+    const back = try decode(a, w);
+    defer a.free(back);
+    try std.testing.expectEqualSlices(Span, &spans, back);
+    try std.testing.expectError(error.ImageSpans, decode(a, w[0..5]));
+    try std.testing.expectError(error.ImageSpans, decode(a, &.{ 3, 4, 1 })); // rows must start at 0
+    try std.testing.expectError(error.ImageSpans, decode(a, &.{ 3, 4, 0, 5, 1, 4 })); // the second overlaps the first
+    try std.testing.expectError(error.ImageSpans, encode(&spans, words[0..5]));
+}
+
+test "a chunk takes the rows it crosses: a span cut at both ends, and none past it" {
+    const first: Span = .{ .at = 5, .n = 256, .row = 0 };
+    const second: Span = .{ .at = 300, .n = 300, .row = 256 };
+    try std.testing.expectEqual([3]u64{ 200, 195, 61 }, cut(first, 200, 400).?);
+    try std.testing.expectEqual([3]u64{ 300, 256, 100 }, cut(second, 200, 400).?);
+    try std.testing.expectEqual([3]u64{ 5, 0, 256 }, cut(first, 0, 1000).?);
+    try std.testing.expect(cut(first, 261, 300) == null and cut(second, 600, 700) == null);
+}
diff --git a/zig/src/families/minimax_m3/vision/rope.zig b/zig/src/families/minimax_m3/vision/rope.zig
new file mode 100644
index 0000000000000000000000000000000000000000..3fbf3de1ae801a9e9adb24e05b5b62fda18c2129
--- /dev/null
+++ b/zig/src/families/minimax_m3/vision/rope.zig
@@ -0,0 +1,104 @@
+//! The tower's 3D partial rotary on the host: each patch's bf16 cos and sin rows (tf_vit_rope's table) and its twin.
+const std = @import("std");
+
+/// Frequencies an axis: spatial_dim / 2 = (2 * ((80 / 3) / 2)) / 2 = 13 at head dim 80.
+pub fn freqs(dim: usize) usize {
+    return (dim / 3) / 2;
+}
+
+/// A row's rotated half: t, h and w frequencies side by side (39 at head dim 80; rotate_half spans twice that).
+pub fn half(dim: usize) usize {
+    return 3 * freqs(dim);
+}
+
+/// cvt.rn.bf16.f32 of a finite value.
+fn bf16(x: f32) u16 {
+    const u: u32 = @bitCast(x);
+    return @truncate((u + 0x7fff + ((u >> 16) & 1)) >> 16);
+}
+
+fn widen(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+/// out [gh * gw, 2 half] bf16: each patch's cos, then sin, in merge order (2 x 2 blocks row by row), t = 0.
+pub fn table(out: []u16, gh: usize, gw: usize, dim: usize, theta: f32) void {
+    const nf = freqs(dim);
+    const hf = half(dim);
+    std.debug.assert(out.len == gh * gw * 2 * hf and gh % 2 == 0 and gw % 2 == 0 and nf <= 32);
+    var inv: [32]f32 = undefined;
+    // torch: 1 / theta ** (arange(0, spatial, 2) / spatial) in f32
+    for (inv[0..nf], 0..) |*f, i| {
+        const e: f32 = @as(f32, @floatFromInt(2 * i)) / @as(f32, @floatFromInt(2 * nf));
+        const p: f32 = @floatCast(std.math.pow(f64, theta, e));
+        f.* = 1.0 / p;
+    }
+    var r: usize = 0;
+    for (0..gh / 2) |by| for (0..gw / 2) |bx| for (0..2) |my| for (0..2) |mx| {
+        const pos = [3]f32{ 0, @floatFromInt(2 * by + my), @floatFromInt(2 * bx + mx) };
+        const row = out[r * 2 * hf ..][0 .. 2 * hf];
+        for (pos, 0..) |p, axis| for (inv[0..nf], 0..) |f, i| {
+            const a: f64 = p * f; // the f32 product, then cos and sin rounded once to f32 and again to bf16
+            row[axis * nf + i] = bf16(@floatCast(@cos(a)));
+            row[hf + axis * nf + i] = bf16(@floatCast(@sin(a)));
+        };
+        r += 1;
+    };
+}
+
+/// tf_vit_rope's twin: qkv [rows, 3 heads dim] bf16 rotated in place by cs [rows, 2 half].
+pub fn apply(qkv: []u16, cs: []const u16, rows: usize, heads: usize, dim: usize, hf: usize) void {
+    for (0..rows) |r| for (0..2 * heads) |head| {
+        const x = qkv[r * 3 * heads * dim + head * dim ..][0..dim];
+        const t = cs[r * 2 * hf ..][0 .. 2 * hf];
+        for (0..hf) |j| {
+            const x1 = widen(x[j]);
+            const x2 = widen(x[j + hf]);
+            const c = widen(t[j]);
+            const s = widen(t[hf + j]);
+            x[j] = bf16(widen(bf16(x1 * c)) + widen(bf16(-x2 * s)));
+            x[j + hf] = bf16(widen(bf16(x2 * c)) + widen(bf16(x1 * s)));
+        }
+    };
+}
+
+test "head dim 80 rotates 78 dims in 13 frequencies an axis" {
+    try std.testing.expectEqual(@as(usize, 13), freqs(80));
+    try std.testing.expectEqual(@as(usize, 39), half(80));
+}
+
+test "the table follows merge order with t = 0" {
+    var out: [8 * 2 * 39]u16 = undefined;
+    table(&out, 2, 4, 80, 10000);
+    // row 0 is (0, 0): cos 1 and sin 0 everywhere
+    for (out[0..39]) |v| try std.testing.expectEqual(bf16(1), v);
+    for (out[39..78]) |v| try std.testing.expectEqual(@as(u16, 0), v);
+    // row 5 is block (0, 1), my 0, mx 1: h 0, w 3; w's first frequency is 1, so cos(3) and sin(3)
+    const r5 = out[5 * 78 ..][0..78];
+    try std.testing.expectEqual(bf16(1), r5[13]);
+    try std.testing.expectEqual(bf16(@floatCast(@cos(@as(f64, 3)))), r5[26]);
+    try std.testing.expectEqual(bf16(@floatCast(@sin(@as(f64, 3)))), r5[39 + 26]);
+    // row 2 is (1, 0): h's first frequency at 1, t's columns still cos 1
+    try std.testing.expectEqual(bf16(@floatCast(@cos(@as(f64, 1)))), out[2 * 78 + 13]);
+    try std.testing.expectEqual(bf16(1), out[2 * 78]);
+}
+
+test "the twin rotates pairs (j, j + half) and leaves the last dims" {
+    const heads = 1;
+    const dim = 80;
+    const hf = half(dim);
+    var qkv: [3 * dim]u16 = undefined;
+    for (&qkv, 0..) |*v, i| v.* = bf16(@as(f32, @floatFromInt(i % 7)) - 3);
+    const before = qkv;
+    var cs: [2 * 39]u16 = undefined;
+    for (cs[0..hf]) |*v| v.* = bf16(0);
+    for (cs[hf..]) |*v| v.* = bf16(1);
+    apply(&qkv, &cs, 1, heads, dim, hf);
+    // cos 0, sin 1: (x1, x2) -> (-x2, x1)
+    for (0..hf) |j| {
+        try std.testing.expectEqual(widen(before[j + hf]), -widen(qkv[j]));
+        try std.testing.expectEqual(before[j], qkv[j + hf]);
+    }
+    try std.testing.expectEqual(before[78], qkv[78]);
+    try std.testing.expectEqualSlices(u16, before[2 * dim ..], qkv[2 * dim ..]);
+}
diff --git a/zig/src/families/minimax_m3/vision/tower.zig b/zig/src/families/minimax_m3/vision/tower.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a6f59bceab5e968a14f882849d621b08f890d436
--- /dev/null
+++ b/zig/src/families/minimax_m3/vision/tower.zig
@@ -0,0 +1,176 @@
+//! MiniMax-M3.1-Flash's vision tower and projector on CUDA: one image's patches to its rows in the text width.
+const std = @import("std");
+const cuda = @import("cuda");
+const Image = @import("lanes").stream.Image;
+const Config = @import("config.zig").Config;
+const Weights = @import("weights.zig").Weights;
+const rope = @import("rope.zig");
+const Allocator = std.mem.Allocator;
+const vit = cuda.vit;
+/// For a tool rooted here (the GPU parity check): the settings and the rotary's host twin.
+pub const config = @import("config.zig");
+pub const rotary = rope;
+pub const passes = @import("passes.zig");
+
+/// What the tower's first image adds beyond its planned bytes (cuBLASLt plans, lazily loaded kernels): `warm` takes it.
+pub const first_call_bytes: u64 = 512 << 20;
+
+pub const Tower = struct {
+    gpa: Allocator,
+    c: Config,
+    w: Weights,
+    k: vit.Kernels,
+    at: vit.Attention,
+    g: vit.Gemms,
+    scratch: cuda.DeviceBuffer,
+    b: Buffers,
+    bytes: u64, // device bytes: weights, scratch and the Linears' workspace
+
+    const Buffers = struct { px: u64, h: u64, x: u64, wide: u64, a: u64, p: u64, acc: u64, cs: u64 };
+
+    /// Scratch for `n` patches: bf16 patches, residual, Linear outputs, wide, attention, projector rows; f32; rotary.
+    fn sizes(c: Config, n: usize) [8]usize {
+        const hd: usize = c.hidden;
+        const wide = @max(3 * hd, c.ffn, c.projector_hidden);
+        const f32s = @max(wide, c.text_hidden, c.patchWidth());
+        return .{ 2 * n * c.patchWidth(), 2 * n * hd, 2 * n * hd, 2 * n * wide, 2 * n * hd, 2 * n * c.text_hidden, 4 * n * f32s, 2 * n * 2 * rope.half(c.headDim()) };
+    }
+
+    fn scratchBytes(c: Config) usize {
+        var total: usize = 0;
+        for (sizes(c, c.maxPatches())) |sz| total += std.mem.alignForward(usize, sz, 256);
+        return total;
+    }
+
+    /// Device bytes for the weights, the largest image's scratch and the workspace, before loading (admission).
+    pub fn plannedBytes(c: Config) u64 {
+        return Weights.plannedBytes(c) + scratchBytes(c) + vit.workspace_bytes;
+    }
+
+    /// The tower from `dir` and scratch for `c.maxPatches()` patches.
+    pub fn init(gpa: Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, c: Config) !Tower {
+        if (c.hidden > vit.norm_most or c.headDim() * c.heads != c.hidden or c.headDim() != 80) return error.VisionShape;
+        if (c.merge != 2 or c.temporal != 2 or c.text_hidden % 8 != 0) return error.VisionShape;
+        var w = try Weights.load(gpa, io, d, dir, &c);
+        errdefer w.deinit(gpa);
+        var k = try vit.Kernels.load(d);
+        errdefer k.unload();
+        var at = try vit.Attention.load(d);
+        errdefer at.unload();
+        var g = try vit.Gemms.init(gpa, d);
+        errdefer g.deinit();
+        const sz = sizes(c, c.maxPatches());
+        const total = scratchBytes(c);
+        var scratch = try cuda.DeviceBuffer.alloc(d, total);
+        errdefer scratch.free();
+        var ptrs: [sz.len]u64 = undefined;
+        var off: usize = 0;
+        for (sz, &ptrs) |n, *p| {
+            p.* = try scratch.at(off);
+            off += std.mem.alignForward(usize, n, 256);
+        }
+        return .{
+            .gpa = gpa,
+            .c = c,
+            .w = w,
+            .k = k,
+            .at = at,
+            .g = g,
+            .scratch = scratch,
+            .b = .{ .px = ptrs[0], .h = ptrs[1], .x = ptrs[2], .wide = ptrs[3], .a = ptrs[4], .p = ptrs[5], .acc = ptrs[6], .cs = ptrs[7] },
+            .bytes = w.bytes + total + g.workspace.len,
+        };
+    }
+
+    pub fn deinit(t: *Tower) void {
+        t.scratch.free();
+        t.g.deinit();
+        t.at.unload();
+        t.k.unload();
+        t.w.deinit(t.gpa);
+    }
+
+    /// One largest image through the tower before serving: its first call's memory goes before the KV pool is sized.
+    pub fn warm(t: *Tower, d: *const cuda.Driver, s: cuda.Stream) !void {
+        const c = t.c;
+        const side = std.math.sqrt(c.maxPatches()) / c.merge * c.merge;
+        const pixels = try t.gpa.alloc(f32, @as(usize, side) * side * c.patchWidth());
+        defer t.gpa.free(pixels);
+        @memset(pixels, 0);
+        var out = try cuda.DeviceBuffer.alloc(d, @as(usize, side) * side / 4 * c.text_hidden * 2);
+        defer out.free();
+        errdefer s.synchronize() catch {};
+        try t.picture(s, .{ .pixels = pixels, .gh = side, .gw = side, .at = 0, .tokens = side * side / 4 }, out.ptr);
+        try s.synchronize();
+    }
+
+    /// One image's patches (f32 [gh * gw, patchWidth], merge order) to bf16 rows [gh * gw / 4, text_hidden] at `out`.
+    pub fn picture(t: *Tower, s: cuda.Stream, img: Image, out: u64) !void {
+        try t.project(s, try t.features(s, img), @as(usize, img.gh) * img.gw, out);
+    }
+
+    /// The tower's last hidden state, bf16 [gh * gw, hidden] in scratch until the next call (no post-layernorm).
+    pub fn features(t: *Tower, s: cuda.Stream, img: Image) !u64 {
+        const c = t.c;
+        const b = t.b;
+        const k = &t.k;
+        const g = &t.g;
+        const n = @as(usize, img.gh) * img.gw;
+        const pw: usize = c.patchWidth();
+        if (n == 0 or n > c.maxPatches() or img.gh % 2 != 0 or img.gw % 2 != 0 or n / 4 != img.tokens) return error.ImageShape;
+        if (img.pixels.len != n * pw) return error.ImageShape;
+        const hd: usize = c.hidden;
+        const dim: usize = c.headDim();
+        const half = rope.half(dim);
+        const cs = try t.gpa.alloc(u16, n * 2 * half);
+        defer t.gpa.free(cs);
+        rope.table(cs, img.gh, img.gw, dim, c.rope_theta);
+        // uploads stage through pinned copies, so the host rows may go when this returns
+        try t.scratch.uploadAsync(b.cs - t.scratch.ptr, std.mem.sliceAsBytes(cs), s.handle);
+        try t.scratch.uploadAsync(b.acc - t.scratch.ptr, std.mem.sliceAsBytes(img.pixels), s.handle);
+        // torch: the f32 pixels cast to the Conv3d's bf16, f32 sums rounded once to bf16
+        try k.cast(s, b.acc, b.px, n * pw);
+        try g.run(s, b.px, t.w.patch, b.x, n, hd, pw, .bf16);
+        try k.layerNorm(s, b.x, t.w.pre, t.w.pre_bias, b.h, n, hd, c.eps);
+        const scale: f32 = @floatCast(1.0 / @sqrt(@as(f64, @floatFromInt(dim))));
+        for (t.w.layers) |l| {
+            try k.layerNorm(s, b.h, l.norm1, l.norm1_bias, b.x, n, hd, c.eps);
+            try vit.linear(g, k, s, b.acc, b.x, l.qkv, l.qkv_bias, b.wide, n, 3 * hd, hd);
+            try k.rope(s, b.wide, b.cs, n, c.heads, dim, half);
+            try t.at.full(s, b.wide, b.a, n, c.heads, dim, scale);
+            try vit.linear(g, k, s, b.acc, b.a, l.out, l.out_bias, b.x, n, hd, hd);
+            try k.pointwise(s, b.x, b.h, b.h, n * hd, .none);
+            try k.layerNorm(s, b.h, l.norm2, l.norm2_bias, b.x, n, hd, c.eps);
+            try vit.linear(g, k, s, b.acc, b.x, l.fc1, l.fc1_bias, b.wide, n, c.ffn, hd);
+            try k.pointwise(s, b.wide, null, b.wide, n * c.ffn, .gelu);
+            try vit.linear(g, k, s, b.acc, b.wide, l.fc2, l.fc2_bias, b.x, n, hd, c.ffn);
+            try k.pointwise(s, b.x, b.h, b.h, n * hd, .none);
+        }
+        return b.h;
+    }
+
+    /// The projector's GELU MLP a patch, then patch_merge_mlp's over each 4 rows side by side into `out` [n / 4, text].
+    pub fn project(t: *Tower, s: cuda.Stream, feats: u64, n: usize, out: u64) !void {
+        const c = t.c;
+        const b = t.b;
+        const k = &t.k;
+        const g = &t.g;
+        const w = &t.w;
+        const ph: usize = c.projector_hidden;
+        const th: usize = c.text_hidden;
+        const m = c.merge * c.merge;
+        if (n % m != 0 or n > c.maxPatches()) return error.ImageShape;
+        try vit.linear(g, k, s, b.acc, feats, w.lin1, w.lin1_bias, b.wide, n, ph, c.hidden);
+        try k.pointwise(s, b.wide, null, b.wide, n * ph, .gelu);
+        try vit.linear(g, k, s, b.acc, b.wide, w.lin2, w.lin2_bias, b.p, n, th, ph);
+        // [n, th] row-major is [n / 4, 4 th]: torch's reshape is free
+        try vit.linear(g, k, s, b.acc, b.p, w.merge1, w.merge1_bias, b.wide, n / m, ph, m * th);
+        try k.pointwise(s, b.wide, null, b.wide, n / m * ph, .gelu);
+        try vit.linear(g, k, s, b.acc, b.wide, w.merge2, w.merge2_bias, out, n / m, th, ph);
+    }
+};
+
+test {
+    _ = rope;
+    _ = @import("weights.zig");
+}
diff --git a/zig/src/families/minimax_m3/vision/vision.zig b/zig/src/families/minimax_m3/vision/vision.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4c5d2708457ff669b263bfa654f67551df7e0963
--- /dev/null
+++ b/zig/src/families/minimax_m3/vision/vision.zig
@@ -0,0 +1,155 @@
+//! MiniMax-M3.1-Flash image input on CUDA: the processor, the tower on rank 0, every rank's prompt-pass image rows.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("../engine_ops.zig");
+pub const config = @import("config.zig");
+pub const image = @import("image.zig");
+pub const passes = @import("passes.zig");
+pub const tower = @import("tower.zig");
+pub const Config = config.Config;
+const Allocator = std.mem.Allocator;
+
+/// --vision's limits: image tokens one request holds in all, and images.
+pub const Limits = struct { image_tokens: u32, max_images: u32 };
+
+/// Where rows cross between ranks: the group and the engine's stream, which every forward and step runs on.
+pub const Link = struct { group: *const cuda.tp_group.Group, stream: cuda.Stream, rank: usize, world: usize };
+
+/// `dir`'s image settings; null with `problem` when config.json names no vision tower.
+pub fn settings(a: Allocator, io: std.Io, dir: []const u8, problem: *[]const u8) !?Config {
+    const text = try read(a, io, dir, "config.json", 1 << 24) orelse return error.NoConfig;
+    defer a.free(text);
+    const pre = try read(a, io, dir, "preprocessor_config.json", 1 << 20);
+    defer if (pre) |p| a.free(p);
+    const c = config.parse(a, text, pre) catch |err| {
+        problem.* = "--vision: this checkpoint's vision_config or image processor is not the MiniMax-M3.1 tower this engine runs";
+        return err;
+    };
+    if (c == null) problem.* = "--vision: this checkpoint has no vision tower (config.json names no vision_config); serve it without --vision";
+    return c;
+}
+
+/// Device bytes --vision takes on a rank: rank 0's tower, scratch and first call, every rank's rows for `lanes` passes.
+pub fn bytes(c: Config, limits: Limits, lanes: u32, rank: usize) u64 {
+    const rows = @as(u64, @max(lanes, 1)) * limits.image_tokens * c.text_hidden * 2;
+    return rows + if (rank == 0) towerBytes(c) else 0;
+}
+
+/// Rank 0's tower: its weights, scratch and workspace, and its first call.
+pub fn towerBytes(c: Config) u64 {
+    return tower.Tower.plannedBytes(c) + tower.first_call_bytes;
+}
+
+pub const Vision = struct {
+    /// The template's content part for an image (`{"type": "image"}`), as the server renders it.
+    pub const part_type = "image";
+    gpa: Allocator,
+    io: std.Io,
+    cfg: Config,
+    tower: ?tower.Tower, // rank 0's; the other ranks receive its rows
+    held: passes.Passes,
+    link: Link,
+    limits: Limits,
+    marks: struct { open: u32, image: u32, close: u32 },
+    mark_ids: [4]u32, // the image's wrapper, the image token and the video token: text that spells one stays text
+
+    pub fn init(gpa: Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, c: Config, limits: Limits, link: Link) !*Vision {
+        if (limits.image_tokens == 0 or limits.max_images == 0) return error.BadImageLimits;
+        const v = try gpa.create(Vision);
+        errdefer gpa.destroy(v);
+        var t: ?tower.Tower = if (link.rank == 0) try tower.Tower.init(gpa, io, d, dir, c) else null;
+        errdefer if (t) |*x| x.deinit();
+        if (t) |*x| try x.warm(d, link.stream);
+        v.* = .{
+            .gpa = gpa,
+            .io = io,
+            .cfg = c,
+            .tower = t,
+            .held = .{ .gpa = gpa, .d = d, .hidden = c.text_hidden, .limit = limits.image_tokens },
+            .link = link,
+            .limits = limits,
+            .marks = .{ .open = c.image_start, .image = c.image_token, .close = c.image_end },
+            .mark_ids = .{ c.image_start, c.image_token, c.image_end, c.video_token },
+        };
+        return v;
+    }
+
+    pub fn deinit(v: *Vision) void {
+        v.held.deinit();
+        if (v.tower) |*t| t.deinit();
+        v.gpa.destroy(v);
+    }
+
+    /// An image's bytes to the tower's patches, at most `max_tokens` (the server's share), on the HTTP thread.
+    pub fn prepare(v: *Vision, a: Allocator, data: []const u8, max_tokens: u32) !image.Prepared {
+        return image.prepare(v.io, a, data, v.cfg, @min(max_tokens, v.limits.image_tokens));
+    }
+
+    /// The words for a refusal the server cannot word: the decoder's, or an image this tower cannot take.
+    pub fn explain(err: anyerror) ?[]const u8 {
+        return switch (err) {
+            error.ImageRows, error.ImageSpans => "the request's images do not match their placeholders or exceed --vision-image-tokens",
+            error.ImageShape => "the image's patch grid is not one this tower takes",
+            else => image.problem(err),
+        };
+    }
+
+    /// The engine's per-slot rows (engine_ops.Images).
+    pub fn images(v: *Vision) ops.Images {
+        return .{ .ptr = v, .vtable = &.{ .hold = hold, .drop = drop, .holds = holds } };
+    }
+
+    /// The forward's hook after each prompt embed (engine_ops.Splice).
+    pub fn splice(v: *Vision) ops.Splice {
+        return .{ .ctx = v, .call = spliceFn };
+    }
+
+    fn of(p: *anyopaque) *Vision {
+        return @ptrCast(@alignCast(p));
+    }
+
+    /// Rank 0 encodes each span's image into the slot's rows and sends them on; the others receive them from rank 0.
+    fn hold(p: *anyopaque, slot: u32, words: []const u32, imgs: []const ops.Image, index: []const u32) anyerror!void {
+        const v = of(p);
+        const spans = try passes.decode(v.gpa, words);
+        const pass = try v.held.open(slot, spans);
+        errdefer v.held.drop(slot);
+        const l = v.link;
+        const n = pass.bytes(v.cfg.text_hidden);
+        if (l.rank != 0) return l.group.recv(l.stream, pass.buf.ptr, n, 0);
+        const t = if (v.tower) |*x| x else return error.NoVisionTower;
+        if (index.len != pass.spans.len) return error.ImageSpans;
+        for (pass.spans, index) |sp, i| {
+            if (i >= imgs.len or imgs[i].tokens != sp.n) return error.ImageSpans;
+            try t.picture(l.stream, imgs[i], pass.at(sp, v.cfg.text_hidden));
+        }
+        for (1..l.world) |peer| try l.group.send(l.stream, pass.buf.ptr, n, peer);
+    }
+
+    fn drop(p: *anyopaque, slot: u32) void {
+        of(p).held.drop(slot);
+    }
+
+    fn holds(p: *anyopaque, slot: u32) bool {
+        return of(p).held.holds(slot);
+    }
+
+    fn spliceFn(ctx: *anyopaque, s: cuda.Stream, slot: u32, lo: u64, hi: u64, emb: u64) anyerror!void {
+        return of(ctx).held.splice(s, slot, lo, hi, emb);
+    }
+};
+
+fn read(a: Allocator, io: std.Io, dir: []const u8, name: []const u8, most: usize) !?[]u8 {
+    const path = try std.fs.path.join(a, &.{ dir, name });
+    defer a.free(path);
+    return std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(most)) catch |e| switch (e) {
+        error.FileNotFound => null,
+        else => e,
+    };
+}
+
+test {
+    _ = passes;
+    _ = config;
+    _ = image;
+}
diff --git a/zig/src/families/minimax_m3/vision/weights.zig b/zig/src/families/minimax_m3/vision/weights.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b9645d54a11e1c36366a8f8d65839b7851b2da11
--- /dev/null
+++ b/zig/src/families/minimax_m3/vision/weights.zig
@@ -0,0 +1,277 @@
+//! MiniMax-M3.1-Flash's vision tower and projector tensors in one device allocation, bf16 (the f32 Conv3d rounded).
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const Config = @import("config.zig").Config;
+const Allocator = std.mem.Allocator;
+const st = core.safetensors;
+
+const tower = "vision_tower.vision_model.";
+/// Every name the image side owns; each one under these prefixes must be placed.
+const prefixes = [_][]const u8{ "vision_tower.", "multi_modal_projector.", "patch_merge_mlp." };
+
+pub const Layer = struct {
+    norm1: u64,
+    norm1_bias: u64,
+    qkv: u64, // [3 hidden, hidden]: q_proj's rows, then k_proj's, then v_proj's
+    qkv_bias: u64,
+    out: u64,
+    out_bias: u64,
+    norm2: u64,
+    norm2_bias: u64,
+    fc1: u64,
+    fc1_bias: u64,
+    fc2: u64,
+    fc2_bias: u64,
+};
+
+pub const Weights = struct {
+    memory: cuda.DeviceBuffer,
+    patch: u64, // the Conv3d [hidden, 3 * temporal * patch^2] (C, T, y, x), rounded to bf16 as torch's .to() does
+    pre: u64, // pre_layrnorm
+    pre_bias: u64,
+    lin1: u64, // multi_modal_projector.linear_1 [projector_hidden, hidden]
+    lin1_bias: u64,
+    lin2: u64, // multi_modal_projector.linear_2 [text_hidden, projector_hidden]
+    lin2_bias: u64,
+    merge1: u64, // patch_merge_mlp.linear_1 [projector_hidden, merge^2 text_hidden]
+    merge1_bias: u64,
+    merge2: u64, // patch_merge_mlp.linear_2 [text_hidden, projector_hidden]
+    merge2_bias: u64,
+    layers: []Layer,
+    bytes: u64,
+
+    /// Device bytes `load` allocates for `c`, without opening a file.
+    pub fn plannedBytes(c: Config) u64 {
+        var layers: [64]Layer = undefined;
+        var p: Planner = .{ .gpa = undefined, .files = null, .c = &c };
+        var w: Weights = undefined;
+        w.layers = layers[0..@min(c.layers, layers.len)];
+        p.plan(&w) catch return std.math.maxInt(u64);
+        return p.bytes;
+    }
+
+    /// `dir`'s image tensors on the device (the shards the index names for them), checked against `c`.
+    pub fn load(gpa: Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, c: *const Config) !Weights {
+        if (c.layers > 64) return error.VisionShape;
+        var files = try open(gpa, io, dir);
+        defer {
+            for (files.items) |*f| {
+                f.release();
+                f.close(io);
+            }
+            files.deinit(gpa);
+        }
+        var p: Planner = .{ .gpa = gpa, .files = files.items, .c = c };
+        defer p.pieces.deinit(gpa);
+        var w: Weights = undefined;
+        w.layers = try gpa.alloc(Layer, c.layers);
+        errdefer gpa.free(w.layers);
+        try p.plan(&w);
+        try p.unread();
+        w.memory = try cuda.DeviceBuffer.alloc(d, p.bytes);
+        w.bytes = p.bytes;
+        for (p.pieces.items) |piece| upload(gpa, w.memory, piece) catch |err| {
+            // a copy still in flight keeps its destination: free only once the device is idle
+            w.memory.d.synchronize() catch return error.LoadRetained;
+            w.memory.free();
+            return err;
+        };
+        shift(&w, w.memory.ptr);
+        for (w.layers) |*l| shift(l, w.memory.ptr);
+        return w;
+    }
+
+    pub fn deinit(w: *Weights, gpa: Allocator) void {
+        w.memory.free();
+        gpa.free(w.layers);
+        w.* = undefined;
+    }
+};
+
+/// One tensor (its name as the file keys it) and where it goes; `narrow` rounds its f32 values to bf16 on the way.
+const Piece = struct { name: []const u8, bytes: []const u8, dst: u64, narrow: bool };
+
+const Planner = struct {
+    gpa: Allocator,
+    files: ?[]const st.File, // null: sizes only (plannedBytes)
+    c: *const Config,
+    pieces: std.ArrayList(Piece) = .empty,
+    bytes: u64 = 0,
+
+    /// Places `name` (an offset from the allocation's start) as bf16; the file holds it as `stored`.
+    fn take(p: *Planner, name: []const u8, shape: []const usize, stored: st.DType) !u64 {
+        var count: u64 = 1;
+        for (shape) |n| count *= n;
+        const at = std.mem.alignForward(u64, p.bytes, 256);
+        p.bytes = at + 2 * count;
+        const files = p.files orelse return at;
+        for (files) |*f| if (f.get(name)) |t| {
+            if (!t.is(stored, shape)) {
+                std.log.err("{s}: {t} {any}, expected {t} {any}", .{ name, t.dtype, t.shape[0..t.rank], stored, shape });
+                return error.UnexpectedTensor;
+            }
+            try p.pieces.append(p.gpa, .{ .name = f.names.getKey(name).?, .bytes = t.bytes, .dst = at, .narrow = stored == .f32 });
+            return at;
+        };
+        std.log.err("checkpoint has no tensor {s}", .{name});
+        return error.MissingTensor;
+    }
+
+    /// q, k and v [n, h] (and their biases) back to back as one [3 n, h] tensor.
+    fn three(p: *Planner, names: [3][]const u8, shape: []const usize) !u64 {
+        const q = try p.take(names[0], shape, .bf16);
+        const k = try p.take(names[1], shape, .bf16);
+        const v = try p.take(names[2], shape, .bf16);
+        const size = k - q;
+        if (v - k != size or p.bytes - v != size) return error.VisionShape;
+        return q;
+    }
+
+    fn plan(p: *Planner, w: *Weights) !void {
+        const c = p.c;
+        const h: usize = c.hidden;
+        const ph: usize = c.projector_hidden;
+        const th: usize = c.text_hidden;
+        var nb: [3][160]u8 = undefined;
+        w.patch = try p.take(tower ++ "embeddings.patch_embedding.weight", &.{ h, 3, c.temporal, c.patch, c.patch }, .f32);
+        w.pre = try p.take(tower ++ "pre_layrnorm.weight", &.{h}, .bf16);
+        w.pre_bias = try p.take(tower ++ "pre_layrnorm.bias", &.{h}, .bf16);
+        for (w.layers, 0..) |*l, i| {
+            const n = struct {
+                fn of(b: *[160]u8, li: usize, s: []const u8) []const u8 {
+                    return std.fmt.bufPrint(b, tower ++ "encoder.layers.{d}.{s}", .{ li, s }) catch unreachable;
+                }
+            }.of;
+            l.norm1 = try p.take(n(&nb[0], i, "layer_norm1.weight"), &.{h}, .bf16);
+            l.norm1_bias = try p.take(n(&nb[0], i, "layer_norm1.bias"), &.{h}, .bf16);
+            const w3: [3][]const u8 = .{ n(&nb[0], i, "self_attn.q_proj.weight"), n(&nb[1], i, "self_attn.k_proj.weight"), n(&nb[2], i, "self_attn.v_proj.weight") };
+            l.qkv = try p.three(w3, &.{ h, h });
+            const b3: [3][]const u8 = .{ n(&nb[0], i, "self_attn.q_proj.bias"), n(&nb[1], i, "self_attn.k_proj.bias"), n(&nb[2], i, "self_attn.v_proj.bias") };
+            l.qkv_bias = try p.three(b3, &.{h});
+            l.out = try p.take(n(&nb[0], i, "self_attn.out_proj.weight"), &.{ h, h }, .bf16);
+            l.out_bias = try p.take(n(&nb[0], i, "self_attn.out_proj.bias"), &.{h}, .bf16);
+            l.norm2 = try p.take(n(&nb[0], i, "layer_norm2.weight"), &.{h}, .bf16);
+            l.norm2_bias = try p.take(n(&nb[0], i, "layer_norm2.bias"), &.{h}, .bf16);
+            l.fc1 = try p.take(n(&nb[0], i, "mlp.fc1.weight"), &.{ c.ffn, h }, .bf16);
+            l.fc1_bias = try p.take(n(&nb[0], i, "mlp.fc1.bias"), &.{c.ffn}, .bf16);
+            l.fc2 = try p.take(n(&nb[0], i, "mlp.fc2.weight"), &.{ h, c.ffn }, .bf16);
+            l.fc2_bias = try p.take(n(&nb[0], i, "mlp.fc2.bias"), &.{h}, .bf16);
+        }
+        w.lin1 = try p.take("multi_modal_projector.linear_1.weight", &.{ ph, h }, .bf16);
+        w.lin1_bias = try p.take("multi_modal_projector.linear_1.bias", &.{ph}, .bf16);
+        w.lin2 = try p.take("multi_modal_projector.linear_2.weight", &.{ th, ph }, .bf16);
+        w.lin2_bias = try p.take("multi_modal_projector.linear_2.bias", &.{th}, .bf16);
+        w.merge1 = try p.take("patch_merge_mlp.linear_1.weight", &.{ ph, c.merge * c.merge * th }, .bf16);
+        w.merge1_bias = try p.take("patch_merge_mlp.linear_1.bias", &.{ph}, .bf16);
+        w.merge2 = try p.take("patch_merge_mlp.linear_2.weight", &.{ th, ph }, .bf16);
+        w.merge2_bias = try p.take("patch_merge_mlp.linear_2.bias", &.{th}, .bf16);
+    }
+
+    /// Refuses an image tensor `plan` did not place (a post-layernorm, a layer scale): these kernels would skip it.
+    fn unread(p: *Planner) !void {
+        var placed: std.StringHashMapUnmanaged(void) = .empty;
+        defer placed.deinit(p.gpa);
+        for (p.pieces.items) |piece| try placed.put(p.gpa, piece.name, {});
+        for (p.files.?) |*f| for (f.names.keys()) |k| if (ours(k) and !placed.contains(k)) {
+            std.log.err("the vision side has a tensor these kernels do not read: {s}", .{k});
+            return error.UnreadTensor;
+        };
+    }
+};
+
+/// Every u64 offset of `s` (not its byte count) moved by `base`.
+fn shift(s: anytype, base: u64) void {
+    const info = @typeInfo(@TypeOf(s.*)).@"struct";
+    inline for (info.field_names, info.field_types) |name, T| if (T == u64 and comptime !std.mem.eql(u8, name, "bytes")) {
+        @field(s, name) += base;
+    };
+}
+
+/// cvt.rn.bf16.f32 of a finite value.
+fn bf16(x: f32) u16 {
+    const u: u32 = @bitCast(x);
+    return @truncate((u + 0x7fff + ((u >> 16) & 1)) >> 16);
+}
+
+/// A piece to the device, rounded from f32 to bf16 first when it asks.
+fn upload(gpa: Allocator, memory: cuda.DeviceBuffer, piece: Piece) !void {
+    if (!piece.narrow) return memory.upload(piece.dst, piece.bytes);
+    const out = try gpa.alloc(u16, piece.bytes.len / 4);
+    defer gpa.free(out);
+    for (out, 0..) |*o, i| o.* = bf16(@bitCast(std.mem.readInt(u32, piece.bytes[4 * i ..][0..4], .little)));
+    try memory.upload(piece.dst, std.mem.sliceAsBytes(out));
+}
+
+fn ours(name: []const u8) bool {
+    for (prefixes) |p| if (std.mem.startsWith(u8, name, p)) return true;
+    return false;
+}
+
+/// The shards holding the image tensors: those the index names for them, else every shard that has one.
+fn open(gpa: Allocator, io: std.Io, dir: []const u8) !std.ArrayList(st.File) {
+    var out: std.ArrayList(st.File) = .empty;
+    errdefer {
+        for (out.items) |*f| f.close(io);
+        out.deinit(gpa);
+    }
+    const paths = try core.checkpoint.shardFiles(gpa, io, dir);
+    defer core.checkpoint.freeShardFiles(gpa, paths);
+    var named = try indexed(gpa, io, dir);
+    defer if (named) |*n| freeNames(gpa, n);
+    for (paths) |path| {
+        if (named) |n| if (!n.contains(std.fs.path.basename(path))) continue;
+        var f = try st.File.open(gpa, io, path);
+        const has = for (f.names.keys()) |k| {
+            if (ours(k)) break true;
+        } else false;
+        if (!has) {
+            f.close(io);
+            continue;
+        }
+        try out.append(gpa, f);
+    }
+    if (out.items.len == 0) return error.NoVisionTower;
+    return out;
+}
+
+/// The shard names model.safetensors.index.json gives the image tensors; null without an index.
+fn indexed(gpa: Allocator, io: std.Io, dir: []const u8) !?std.StringHashMapUnmanaged(void) {
+    const path = try std.fs.path.join(gpa, &.{ dir, "model.safetensors.index.json" });
+    defer gpa.free(path);
+    const text = std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 27)) catch |err| {
+        if (err == error.FileNotFound) return null;
+        return err;
+    };
+    defer gpa.free(text);
+    const parsed = try std.json.parseFromSlice(std.json.Value, gpa, text, .{});
+    defer parsed.deinit();
+    var out: std.StringHashMapUnmanaged(void) = .empty;
+    errdefer freeNames(gpa, &out);
+    var it = (try st.index.weightMap(parsed.value)).iterator();
+    while (it.next()) |e| if (ours(e.key_ptr.*) and !out.contains(e.value_ptr.string)) {
+        try out.put(gpa, try gpa.dupe(u8, e.value_ptr.string), {});
+    };
+    return out;
+}
+
+fn freeNames(gpa: Allocator, names: *std.StringHashMapUnmanaged(void)) void {
+    var it = names.keyIterator();
+    while (it.next()) |k| gpa.free(k.*);
+    names.deinit(gpa);
+}
+
+test "the planned bytes hold every tensor in bf16 at 256-byte steps" {
+    const c: Config = .{};
+    const b = Weights.plannedBytes(c);
+    // 32 layers of 4 h^2 + 2 h ffn weights, the projector's four matrices and the patch Conv3d, plus small vectors
+    const h: u64 = 1280;
+    const big = 2 * (32 * (4 * h * h + 2 * h * 5120) + 6144 * h + 6144 * 6144 + 6144 * 4 * 6144 + 6144 * 6144 + h * 1176);
+    try std.testing.expect(b >= big and b < big + (2 << 20));
+}
+
+test "image names are ours; the language model's are not" {
+    try std.testing.expect(ours("patch_merge_mlp.linear_1.weight"));
+    try std.testing.expect(ours(tower ++ "encoder.layers.0.mlp.fc1.bias"));
+    try std.testing.expect(!ours("language_model.model.embed_tokens.weight"));
+}
diff --git a/zig/src/families/minimax_m3/weights.zig b/zig/src/families/minimax_m3/weights.zig
index 84cbfe4386baa6ad02099c736ca9225a1f58b31b..a48759eb872fd14498a51509c63c2b1170eec67a 100644
--- a/zig/src/families/minimax_m3/weights.zig
+++ b/zig/src/families/minimax_m3/weights.zig
@@ -14,10 +14,11 @@ pub const Error = error{ MissingTensor, BadDtype, BadShape, BadLayer, OutOfMemor
 pub const Dense = struct { gate: exl3.Weight, up: exl3.Weight, down: exl3.Weight };
 
 pub const Moe = struct {
-    router: u64, // fp32 [experts, hidden], as stored
-    bias: u64, // fp32 [experts], e_score_correction_bias
+    router: u64, // fp32 [experts, hidden] (an f16 or bf16 checkpoint's widened by the loader)
+    bias: u64, // fp32 [experts], e_score_correction_bias (widened like the router)
     experts: cuda.exl3_experts.Layer,
     shared: Dense,
+    prompt: ?cuda.exl3_gm.Widths = null, // the prompt experts' widths (promptWidths), null: the decode kernel
 };
 
 pub const Ffn = union(enum) { dense: Dense, moe: Moe };
@@ -100,6 +101,29 @@ pub fn uniformK2(m: *const load.MoeLayer) u32 {
     return width orelse 0;
 }
 
+/// x3gm's widths: a projection's shared K2, else 0 (each expert's own); null for gate != up or an unbuilt width.
+pub fn promptWidths(m: *const load.MoeLayer) ?cuda.exl3_gm.Widths {
+    for (m.w1.halves, m.w3.halves, m.w2.halves) |g, u, d| {
+        if (g != u) return null;
+        for ([_]i32{ g, d }) |k2| if (k2 < 0 or std.mem.indexOfScalar(u32, &cuda.exl3_gm.k2s, @intCast(k2)) == null) return null;
+    }
+    const gu = soleK2(&m.w1.histogram);
+    const down = soleK2(&m.w2.histogram);
+    if (gu == 0 or down == 0) return .{};
+    return .{ .gu = gu, .down = down };
+}
+
+/// The one K2 a histogram holds, else 0.
+fn soleK2(h: *const [17]u32) u32 {
+    var seen: u32 = 0;
+    for (h, 0..) |count, k2| {
+        if (count == 0) continue;
+        if (seen != 0) return 0;
+        seen = @intCast(k2);
+    }
+    return seen;
+}
+
