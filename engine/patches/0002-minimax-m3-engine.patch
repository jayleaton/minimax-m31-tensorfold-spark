@@ -0,0 +1,256 @@
+#!/usr/bin/env python3
+"""DFlash2 draft parity for MiniMax-M3.1-Flash: EXL3 target taps, the reference draft pass, and the comparison."""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import dflash2_reference as d2  # noqa: E402
+from mm3_layer_ref import bf16, stats  # noqa: E402
+
+USAGE = """
+  mm3_dflash2_ref.py taps    --pack PACK --exllamav3 SRC --ids REF/ids.npy --draft DRAFT --out REF
+  mm3_dflash2_ref.py draft   --pack PACK --exllamav3 SRC --draft DRAFT --ref REF [--block-attention MODE]
+  mm3_dflash2_ref.py compare --ref REF --tf TF [--draft DRAFT] --out report.json
+
+taps writes REF/taps.npy (<u2 bf16 bits [n][n_taps*hidden], each tap the output of its target layer, in the draft's
+target_layer_ids order), REF/anchor.json (the target's greedy token after the prompt, at position P = n) and
+REF/emb_block.npy (f32 [block][hidden], the pack's embedding of [anchor, mask * (block - 1)]).
+draft writes REF/ref_post.npy (f32 [block][hidden], every block row after the final norm), REF/ref_sel_h.npy
+(f32 [block][rank]), REF/ref_cand.npy and REF/ref_cand_logits.npy ([block - 1][top_k] through the pack's own head,
+ordered by logit desc, id asc) and REF/ref_drafts.json (the float64 selector's chain over them).
+compare reads TF/{post,cand_ids,cand_logits,sel_h}.npy and TF/drafts.json from tf-cuda-test mm3-dflash2-parity.
+"""
+
+
+def target(a, rows):
+    """An ExLlamaV3 model over the pack and `run(idx, x, body, params)`: one module loaded, applied, unloaded."""
+    sys.path.insert(0, a.exllamav3)
+    import torch
+    from exllamav3 import Config, Model
+    from exllamav3.util.memory import free_mem
+    c = Config.from_directory(a.pack)
+    c.override_dynamic_seq_len(max(2048, rows))
+    m = Model.from_config(c)
+    dev = torch.device(a.device)
+
+    def run(idx, x, body, params):
+        c.stc.begin_deferred_load()
+        mod = m.modules[idx]
+        mod.load(dev)
+        c.stc.end_deferred_load()
+        p = dict(params)
+        y = body(mod, mod.prepare_for_device(x, p), p)
+        mod.unload()
+        c.stc.close()
+        c.stc.release_arena()
+        free_mem()
+        return y
+    return m, run
+
+
+def head(m, run, x, torch):
+    """Float32 logits of rows x [rows, hidden] through the pack's EXL3 head (half input, as its final norm gives)."""
+    body = lambda mod, v, p: mod.forward(v, p, out_dtype=torch.float).float()  # noqa: E731
+    return run(m.logit_layer_idx, x.half().contiguous(), body, {})
+
+
+def bits(t, torch):
+    """A bf16 tensor's `<u2` bits as a NumPy array."""
+    return t.to(torch.bfloat16).contiguous().view(torch.int16).cpu().numpy().view(np.uint16)
+
+
+def cmd_taps(a):
+    import torch
+    cfg = d2.load_config(a.draft)
+    out = Path(a.out)
+    out.mkdir(parents=True, exist_ok=True)
+    ids = torch.from_numpy(np.load(a.ids).astype(np.int64)).view(1, -1)
+    n = ids.shape[1]
+    m, run = target(a, n)
+    blocks = list(range(m.first_block_idx, m.logit_layer_idx - 1))
+    if max(cfg.taps) >= len(blocks):
+        raise SystemExit(f"tap {max(cfg.taps)} past the pack's {len(blocks)} layers")
+    fwd = lambda mod, v, p: mod.forward(v, p).float()  # noqa: E731
+    params = {}
+    taps = {}
+    with torch.inference_mode():
+        x = run(0, m.prepare_inputs(ids, params), fwd, params)
+        for layer, idx in enumerate(blocks):
+            x = run(idx, x, fwd, params)
+            if layer in cfg.taps:
+                taps[layer] = x[0].to(torch.bfloat16).cpu()
+                print(f" -- layer {layer}: tap {cfg.taps.index(layer)} rms {x[0].float().pow(2).mean().sqrt():.4f}",
+                      flush=True)
+            elif layer % 10 == 0:
+                print(f" -- layer {layer}", flush=True)
+        norm = run(m.logit_layer_idx - 1, x[:, -1:, :].contiguous(), lambda mod, v, p: mod.forward(v, p), params)
+        logits = head(m, run, norm.view(1, -1), torch)[0, : cfg.vocab].double().cpu()
+        top = torch.topk(logits, 5)
+        anchor = int(top.indices[0])
+        block_ids = torch.tensor([[anchor] + [cfg.mask_token] * (cfg.block - 1)], dtype=torch.int64)
+        bp = {}
+        emb = run(0, m.prepare_inputs(block_ids, bp), fwd, bp)[0]
+    np.save(out / "taps.npy", bits(torch.cat([taps[t] for t in cfg.taps], -1), torch))
+    np.save(out / "emb_block.npy", emb.float().cpu().numpy())
+    info = {"anchor": anchor, "pos": n, "n": n, "taps": cfg.taps, "block": cfg.block, "mask_token": cfg.mask_token,
+            "anchor_top5": [[int(i), float(v)] for i, v in zip(top.indices, top.values)],
+            "anchor_margin": float(top.values[0] - top.values[1])}
+    (out / "anchor.json").write_text(json.dumps(info, indent=1))
+    print(f" -- {n} rows, taps {cfg.taps} -> {out / 'taps.npy'}; anchor {anchor} at P = {n} "
+          f"(margin {info['anchor_margin']:.4f})")
+
+
+def cmd_draft(a):
+    import torch
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    ref = Path(a.ref)
+    cfg, w = d2.load_draft(a.draft)
+    mode = a.block_attention or ("causal" if cfg.causal(0) else "bidirectional")
+    info = json.loads((ref / "anchor.json").read_text())
+    anchor, pos = int(info["anchor"]), int(info["pos"])
+    raw = np.load(ref / "taps.npy")
+    if raw.dtype != np.uint16 or raw.shape[1] != len(cfg.taps) * cfg.hidden:
+        raise SystemExit(f"taps.npy: {raw.dtype} {raw.shape}, expected <u2 [n, {len(cfg.taps) * cfg.hidden}]")
+    taps = torch.from_numpy(raw.view(np.int16).copy()).view(torch.bfloat16)
+    n = taps.shape[0]
+    if n > pos:
+        raise SystemExit(f"{n} context rows do not precede the anchor at {pos}")
+    emb = torch.from_numpy(np.load(ref / "emb_block.npy")).float()
+    if tuple(emb.shape) != (cfg.block, cfg.hidden):
+        raise SystemExit(f"emb_block.npy {tuple(emb.shape)}, expected ({cfg.block}, {cfg.hidden})")
+    model = d2.DFlash2(cfg, w, a.device, mode)
+    pos_ctx = torch.arange(pos - n, pos, dtype=torch.int64)
+    final = model.forward(taps, pos_ctx, emb, pos)
+    sel_h = model.selector_hidden(final).cpu().numpy().astype(np.float32)
+    final_cpu = final.cpu()
+    del model
+    torch.cuda.empty_cache()
+    m, run = target(a, 2048)
+    with torch.inference_mode():
+        logits = head(m, run, final_cpu[1:].to(a.device), torch)[:, : cfg.vocab]
+    logits = d2.finish_logits(cfg, logits)
+    k = cfg.top_k
+    ids, vals = d2.top_k(logits, k)
+    walk = d2.select(ids[:, :k], vals[:, :k], sel_h[1:], w[d2.CODEBOOKS[0]], w[d2.CODEBOOKS[1]], anchor)
+    np.save(ref / "ref_post.npy", final_cpu.numpy().astype(np.float32))
+    np.save(ref / "ref_sel_h.npy", sel_h)
+    np.save(ref / "ref_cand.npy", ids[:, :k].astype(np.int32))
+    np.save(ref / "ref_cand_logits.npy", vals[:, :k])
+    out = {"anchor": anchor, "pos": pos, "context_rows": n, "block_attention": mode, "top_k": k,
+           "draft": str(Path(a.draft).resolve()), "tokens": [r["token"] for r in walk], "selector": walk,
+           "top1_margin": [float(v[0] - v[1]) for v in vals], "boundary_gap": [float(v[k - 1] - v[k]) for v in vals]}
+    (ref / "ref_drafts.json").write_text(json.dumps(out, indent=1))
+    print(f" -- {n} context rows, block {cfg.block} ({mode}), anchor {anchor} at {pos}")
+    print(f" -- drafts {out['tokens']}; first candidates {ids[:, 0].tolist()}")
+
+
+def overlap(tf_ids, ref_ids, tf_lg, ref_lg):
+    """Set overlap, positional rank agreement and the worst logit difference over the shared ids of one row."""
+    common = set(tf_ids.tolist()) & set(ref_ids.tolist())
+    lt, lr = dict(zip(tf_ids.tolist(), tf_lg.tolist())), dict(zip(ref_ids.tolist(), ref_lg.tolist()))
+    return {"topk_overlap": len(common) / len(ref_ids), "rank_agree": float(np.mean(tf_ids == ref_ids)),
+            "first_agree": bool(tf_ids[0] == ref_ids[0]), "tf_first": int(tf_ids[0]), "ref_first": int(ref_ids[0]),
+            "logit_max_abs_shared": max((abs(lt[i] - lr[i]) for i in common), default=0.0)}
+
+
+def selector_check(tf, td, books, tie):
+    """TF's drafts against the float64 selector rerun on TF's own candidates and sel_h (walked and teacher-forced)."""
+    ids, lg, h = tf["cand_ids"][1:], tf["cand_logits"][1:], tf["sel_h"][1:]
+    tokens = [int(t) for t in td["tokens"]]
+    walk = d2.select(ids, lg, h, books[0], books[1], td["anchor"])
+    forced = d2.select(ids, lg, h, books[0], books[1], td["anchor"], forced=tokens)
+    rows = [{"row": t + 1, "tf": tokens[t], "f64": walk[t]["token"], "f64_forced": forced[t]["token"],
+             "margin": walk[t]["margin"], "forced_margin": forced[t]["margin"], "runner_up": forced[t]["runner_up"]}
+            for t in range(len(tokens))]
+    exact = [r["f64"] for r in rows] == tokens
+    return {"exact": exact, "forced_exact": all(r["f64_forced"] == r["tf"] for r in rows),
+            "first_mismatch": next((r["row"] for r in rows if r["f64"] != r["tf"]), None),
+            "near_ties": [r for r in rows if min(r["margin"], r["forced_margin"]) < tie], "rows": rows}
+
+
+def cmd_compare(a):
+    ref, tfd = Path(a.ref), Path(a.tf)
+    rd = json.loads((ref / "ref_drafts.json").read_text())
+    td = json.loads((tfd / "drafts.json").read_text())
+    tf = {n: np.load(tfd / f"{n}.npy") for n in ("post", "cand_ids", "cand_logits", "sel_h")}
+    post_ref, h_ref = np.load(ref / "ref_post.npy"), np.load(ref / "ref_sel_h.npy")
+    cand_ref, lg_ref = np.load(ref / "ref_cand.npy"), np.load(ref / "ref_cand_logits.npy")
+    k = cand_ref.shape[1]
+    post_tf = bf16(tf["post"])
+    if post_tf.shape != post_ref.shape or tf["cand_ids"].shape[1] != k:
+        raise SystemExit(f"shapes: TF post {post_tf.shape} cand {tf['cand_ids'].shape}, ref {post_ref.shape} k {k}")
+    if int(td["anchor"]) != int(rd["anchor"]) or int(td["pos"]) != int(rd["pos"]):
+        raise SystemExit(f"TF ran anchor {td['anchor']} at {td['pos']}, the reference {rd['anchor']} at {rd['pos']}")
+    rows = []
+    for t in range(1, post_ref.shape[0]):
+        p = stats(post_tf[t: t + 1], post_ref[t: t + 1])
+        s = stats(tf["sel_h"][t: t + 1], h_ref[t: t + 1])
+        r = {"row": t, "post_cos": p["cos"], "post_max_abs": p["max_abs"], "post_rel_l2": p["rel_l2"],
+             "sel_h_cos": s["cos"], "sel_h_max_abs": s["max_abs"], "ref_top1_margin": rd["top1_margin"][t - 1],
+             "ref_boundary_gap": rd["boundary_gap"][t - 1]}
+        r.update(overlap(tf["cand_ids"][t], cand_ref[t - 1], tf["cand_logits"][t], lg_ref[t - 1]))
+        rows.append(r)
+    tf_tok, ref_tok = [int(x) for x in td["tokens"]], [int(x) for x in rd["tokens"]]
+    same = [x == y for x, y in zip(tf_tok, ref_tok)]
+    prefix = next((i for i, s in enumerate(same) if not s), len(same))
+    _, w = d2.load_draft(a.draft or rd["draft"], only=d2.CODEBOOKS)
+    sel = selector_check(tf, td, (w[d2.CODEBOOKS[0]], w[d2.CODEBOOKS[1]]), a.tie)
+    report = {"anchor": rd["anchor"], "pos": rd["pos"], "block_attention": rd["block_attention"], "top_k": k,
+              "post_row0": stats(post_tf[:1], post_ref[:1]), "post_rows": stats(post_tf[1:], post_ref[1:]),
+              "rows": rows, "drafts": {"tf": tf_tok, "ref": ref_tok, "same": same, "same_prefix": prefix},
+              "selector_f64": sel, "tf_conf": td.get("conf")}
+    if a.out:
+        Path(a.out).write_text(json.dumps(report, indent=1))
+    print(f"anchor {rd['anchor']} at {rd['pos']}, block {rd['block_attention']}, top_k {k}")
+    print("row  post-cos   max-abs    sel_h-cos  top-k  rank   1st  tf-draft  ref-draft  f64-sel  margin")
+    for r, sr in zip(rows, sel["rows"]):
+        t = r["row"]
+        print(f"{t:3d}  {r['post_cos']:.6f}  {r['post_max_abs']:.3e}  {r['sel_h_cos']:.6f}  {r['topk_overlap']:.3f}  "
+              f"{r['rank_agree']:.3f}  {'yes' if r['first_agree'] else 'NO ':3s}  {tf_tok[t - 1]:8d}  "
+              f"{ref_tok[t - 1]:9d}  {sr['f64']:7d}  {sr['margin']:.3e}")
+    print(f"drafts equal {sum(same)}/{len(same)}, same prefix {prefix}")
+    for nt in sel["near_ties"]:
+        print(f"  near tie row {nt['row']}: margin {nt['margin']:.3e} (forced {nt['forced_margin']:.3e}), "
+              f"tf {nt['tf']} runner-up {nt['runner_up']}")
+    verdict = "PASS" if sel["exact"] else "FAIL"
+    print(f"{verdict} selector: TF's drafts {'equal' if sel['exact'] else 'differ from'} the float64 rerun on its own "
+          f"candidates (first mismatch {sel['first_mismatch']}, teacher-forced exact {sel['forced_exact']})")
+    return 0 if sel["exact"] else 1
+
+
+def main():
+    fmt = argparse.RawDescriptionHelpFormatter
+    ap = argparse.ArgumentParser(description=__doc__, epilog=USAGE, formatter_class=fmt)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    p = sub.add_parser("taps")
+    p.add_argument("--pack", required=True)
+    p.add_argument("--exllamav3", required=True)
+    p.add_argument("--ids", required=True)
+    p.add_argument("--draft", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--device", default="cuda:0")
+    p = sub.add_parser("draft")
+    p.add_argument("--pack", required=True)
+    p.add_argument("--exllamav3", required=True)
+    p.add_argument("--draft", required=True)
+    p.add_argument("--ref", required=True)
+    p.add_argument("--block-attention", choices=["bidirectional", "causal"],
+                   help="default: the config's is_causal, else causal (every layer is sliding_attention)")
+    p.add_argument("--device", default="cuda:0")
+    p = sub.add_parser("compare")
+    p.add_argument("--ref", required=True)
+    p.add_argument("--tf", required=True)
+    p.add_argument("--draft", help="the codebooks' checkpoint (default: the one ref_drafts.json names)")
+    p.add_argument("--tie", type=float, default=1e-3, help="selector margins below this are reported as near ties")
+    p.add_argument("--out")
+    a = ap.parse_args()
+    sys.exit({"taps": cmd_taps, "draft": cmd_draft, "compare": cmd_compare}[a.cmd](a) or 0)
+
+
+if __name__ == "__main__":
+    main()
