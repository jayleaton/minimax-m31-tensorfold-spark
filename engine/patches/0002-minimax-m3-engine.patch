+//! A DFlash2 draft for MiniMax-M3.1-Flash: its config (both class layouts), its rank split, refusals and memory.
+const std = @import("std");
+const target = @import("config.zig");
+const dc = @import("dspark_config.zig");
+
+pub const max_taps = dc.max_taps;
+/// The classes: DFlash2DraftModel (incoai's, a Qwen3 backbone), MiniMaxDFlash2DraftModel (MiniMax norms and rotary).
+pub const architectures = [_][]const u8{ "DFlash2DraftModel", "MiniMaxDFlash2DraftModel" };
+
+pub const Error = error{
+    BadConfig, // a key is missing, has the wrong type, or two copies of one setting disagree
+    NotDflash2, // not one of `architectures`
+    Unsupported, // a draft feature this family does not implement
+    BadShape, // a width or head count the kernels or the cuts cannot take
+};
+
+/// The MLP's activation: silu(g) * u, or MiniMax's clamped swigluoai (minimax_m3_act.Params).
+pub const Act = enum { silu, swigluoai };
+
+pub const Config = struct {
+    layers: u32,
+    hidden: u32,
+    heads: u32,
+    kv_heads: u32,
+    head_dim: u32,
+    rotary_dim: u32, // the rotated leading dims of each head (rotate-half over them)
+    vocab: u32,
+    eps: f32,
+    rope_theta: f64,
+    ffn: u32, // intermediate_size
+    window: u32, // sliding_window: every layer is sliding_attention
+    block: u32, // rows of one pass: the anchor, then block - 1 mask rows
+    proposals: u32, // of those rows' drafts, how many a pass offers (block - 1; TF_MM3_DRAFT_DEPTH lowers it)
+    mask_token: u32,
+    group: u32, // conv_group_size: channels sharing one dynamic conv coefficient
+    rank: u32, // selector_rank
+    top_k: u32, // selector_top_k: candidates a proposal row offers the selector
+    act: Act,
+    swiglu_alpha: f32,
+    swiglu_limit: f32,
+    gemma_norm: bool, // every RMSNorm scales by (1 + w), else by w
+    causal: bool, // block rows see only earlier block rows: is_causal, else the reference's rule (sliding layers are)
+    taps: [max_taps]u32,
+    n_taps: u32,
+
+    pub fn tapIds(c: *const Config) []const u32 {
+        return c.taps[0..c.n_taps];
+    }
+    pub fn qWidth(c: *const Config) u32 {
+        return c.heads * c.head_dim;
+    }
+    pub fn kvWidth(c: *const Config) u32 {
+        return c.kv_heads * c.head_dim;
+    }
+    /// fc's input width: the taps' hidden states side by side.
+    pub fn fcIn(c: *const Config) u32 {
+        return c.n_taps * c.hidden;
+    }
+    pub fn groups(c: *const Config) u32 {
+        return c.hidden / c.group;
+    }
+    /// kernel_projection's rows: two branches (before attention or MLP, after) times two lags, a coefficient a group.
+    pub fn dynWidth(c: *const Config) u32 {
+        return 4 * c.groups();
+    }
+    /// Proposals one pass offers: the first `proposals` rows after the anchor.
+    pub fn depth(c: *const Config) u32 {
+        return c.proposals;
+    }
+};
+
+/// incoai/MiniMax-M3.1-Flash-DFlash2 @ ac07a7c1 (Apache-2.0).
+pub const incoai: Config = .{
+    .layers = 5,
+    .hidden = 6144,
+    .heads = 64,
+    .kv_heads = 8,
+    .head_dim = 128,
+    .rotary_dim = 128,
+    .vocab = 200064,
+    .eps = 1e-6,
+    .rope_theta = 5e6,
+    .ffn = 12288,
+    .window = 2048,
+    .block = 8,
+    .proposals = 7,
+    .mask_token = 200061,
+    .group = 16,
+    .rank = 256,
+    .top_k = 32,
+    .act = .silu,
+    .swiglu_alpha = 1.0,
+    .swiglu_limit = 0,
+    .gemma_norm = false,
+    .causal = false,
+    .taps = .{ 5, 16, 26, 37, 47, 58, 0, 0 },
+    .n_taps = 6,
+};
+
+/// Synthetic test layout (no published draft's): the MiniMax class, dspark_config.flash's numbers, a 16-wide selector.
+pub const mm_class: Config = .{
+    .layers = 5,
+    .hidden = 6144,
+    .heads = 64,
+    .kv_heads = 4,
+    .head_dim = 128,
+    .rotary_dim = 64,
+    .vocab = 200064,
+    .eps = 1e-6,
+    .rope_theta = 1e7,
+    .ffn = 12288,
+    .window = 4096,
+    .block = 8,
+    .proposals = 7,
+    .mask_token = 200058,
+    .group = 16,
+    .rank = 256,
+    .top_k = 16,
+    .act = .swigluoai,
+    .swiglu_alpha = 1.702,
+    .swiglu_limit = 7.0,
+    .gemma_norm = true,
+    .causal = true,
+    .taps = .{ 3, 17, 31, 45, 59, 0, 0, 0 },
+    .n_taps = 5,
