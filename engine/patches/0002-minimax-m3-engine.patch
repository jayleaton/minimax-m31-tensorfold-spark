index 0000000000000000000000000000000000000000..14baed54e1a13acf2357733c1ee2ec7c367a9f8c
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_dflash2.cu
@@ -0,0 +1,152 @@
+// MiniMax-M3.1-Flash DFlash2 draft kernels (ours, after z-lab/dflash, MIT): the two-tap dynamic conv and the selector.
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+#include <math.h>
+#include <stdint.h>
+
+namespace {
+
+typedef __nv_bfloat16 bf16;
+
+constexpr int WARPS = 8;
+constexpr int THREADS = WARPS * 32;
+constexpr int SEL_MAX_CAND = 128;  // world * top_k
+constexpr int SEL_MAX_TOPK = 64;
+constexpr int SEL_MAX_RANK = 1024;
+
+__device__ __forceinline__ float bits(unsigned short x) { return __uint_as_float((unsigned)x << 16); }
+
+__device__ __forceinline__ float tree32(float a) {
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) a = __fadd_rn(a, __shfl_xor_sync(0xffffffffu, a, o));
+    return a;
+}
+
+// True when (bv, bi) beats (av, ai): larger value wins, ties to the lower id, NaN last (dspark's total order).
+__device__ __forceinline__ bool beats(float bv, int bi, float av, int ai) {
+    const bool an = av != av, bn = bv != bv;
+    if (an && bn) return bi < ai;
+    if (bn) return false;
+    if (an) return true;
+    return bv > av || (bv == av && bi < ai);
+}
+
+}  // namespace
+
+// ---- the dynamic conv
+
+// y[t][c] = sum_l (base[w][l][c] + dyn[t][w][l][c/g]) z[t-l][c], z[-1] = 0; z bf16 or f32; out bf16 or added to f32.
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_d2_conv(const void* __restrict__ z, int z_f32,
+                                                                     const unsigned short* __restrict__ dyn, int ld_dyn,
+                                                                     int which, const unsigned short* __restrict__ base,
+                                                                     void* out, int add, int hidden, int group) {
+    const int t = blockIdx.x;
+    const int groups = hidden / group;
+    const unsigned short* dr = dyn + (long long)t * ld_dyn + which * 2 * groups;
+    const unsigned short* b0 = base + (long long)which * 2 * hidden;
+    const unsigned short* b1 = b0 + hidden;
+    const int end = min(hidden, (int)(blockIdx.y + 1) * 1024);
+    for (int c = blockIdx.y * 1024 + threadIdx.x; c < end; c += THREADS) {
+        const int g = c / group;
+        float zt, zp = 0.f;
+        if (z_f32) {
+            const float* zf = reinterpret_cast<const float*>(z);
+            zt = __ldg(zf + (long long)t * hidden + c);
+            if (t > 0) zp = __ldg(zf + (long long)(t - 1) * hidden + c);
+        } else {
+            const unsigned short* zb = reinterpret_cast<const unsigned short*>(z);
+            zt = bits(__ldg(zb + (long long)t * hidden + c));
+            if (t > 0) zp = bits(__ldg(zb + (long long)(t - 1) * hidden + c));
+        }
+        const float k0 = __fadd_rn(bits(__ldg(b0 + c)), bits(__ldg(dr + g)));
+        // row 0's lag 1 multiplies z[-1] = 0 as the reference does, so a non-finite coefficient there gives NaN
+        const float y = __fmaf_rn(__fadd_rn(bits(__ldg(b1 + c)), bits(__ldg(dr + groups + g))), zp, __fmul_rn(k0, zt));
+        if (add) {
+            float* o = reinterpret_cast<float*>(out) + (long long)t * hidden + c;
+            *o = __fadd_rn(*o, y);
+        } else {
+            reinterpret_cast<bf16*>(out)[(long long)t * hidden + c] = __float2bfloat16_rn(y);
+        }
+    }
+}
+
+// ---- the selector
+
+// Rows t >= 1 in turn: the k best gathered candidates, scored logit + <pred[prev] h[t], succ[id]>; first best wins.
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_d2_select(
+    const unsigned* __restrict__ cands, const float* __restrict__ h, const unsigned short* __restrict__ pred,
+    const unsigned short* __restrict__ succ, unsigned* __restrict__ out, int rank, int k, int world, int rows, unsigned anchor,
+    float temp) {
+    __shared__ float gp[SEL_MAX_RANK];
+    __shared__ float zs[SEL_MAX_CAND];
+    __shared__ int ids[SEL_MAX_CAND];
+    __shared__ float tv[SEL_MAX_TOPK];
+    __shared__ int ti[SEL_MAX_TOPK];
+    __shared__ int s_tok;
+    __shared__ float s_share;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int n = world * k;
+    const int per_lane = rank / 32;
+    unsigned prev = anchor;
+    for (int t = 1; t < rows; ++t) {
+        for (int i = threadIdx.x; i < n; i += THREADS) {
+            const int wr = i / k, j = i % k;
+            const unsigned* e = cands + (((long long)wr * rows + t) * k + j) * 2;
+            zs[i] = __uint_as_float(e[0]);
+            ids[i] = (int)e[1];
+        }
+        for (int i = threadIdx.x; i < rank; i += THREADS)
+            gp[i] = __fmul_rn(bits(__ldg(pred + (long long)prev * rank + i)), __ldg(h + (long long)t * rank + i));
+        __syncthreads();
+        // the k best of the gathered n: a rank by counting (a total order, so every candidate has a distinct rank)
+        for (int i = threadIdx.x; i < n; i += THREADS) {
+            const float v = zs[i];
+            const int id = ids[i];
+            int above = 0;
+            for (int j = 0; j < n; ++j) above += (j != i && ids[j] >= 0 && beats(zs[j], ids[j], v, id)) ? 1 : 0;
+            if (id >= 0 && above < k) {
+                ti[above] = id;
+                tv[above] = v;
+            }
+        }
+        __syncthreads();
+        int valid = 0;
+        for (int i = 0; i < n; ++i) valid += ids[i] >= 0 ? 1 : 0;
+        const int m = min(k, valid);
+        // the scores: warps take candidates in turn, lane l owns rank dims l * per_lane ...
+        for (int i = warp; i < m; i += WARPS) {
+            const unsigned short* sr = succ + (long long)ti[i] * rank + lane * per_lane;
+            float a = 0.f;
+            for (int d = 0; d < per_lane; ++d) a = __fmaf_rn(bits(__ldg(sr + d)), gp[lane * per_lane + d], a);
+            a = tree32(a);
+            if (lane == 0) zs[i] = __fadd_rn(tv[i], a);
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) {  // the reference's argmax: the first NaN if any, else the first maximum in logit order
+            int b = -1;
+            float bv = 0.f;
+            for (int i = 0; i < m; ++i) {
+                if (zs[i] != zs[i]) {
+                    b = i;
+                    bv = zs[i];
+                    break;
+                }
+                if (b < 0 || zs[i] > bv) {
+                    b = i;
+                    bv = zs[i];
+                }
+            }
+            float z = 0.f;
+            for (int i = 0; i < m; ++i) z = __fadd_rn(z, expf(__fdiv_rn(__fsub_rn(zs[i], bv), temp)));
+            s_tok = b < 0 ? -1 : ti[b];
+            s_share = b < 0 ? 0.f : __fdiv_rn(1.f, z);
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            out[2 * (t - 1)] = (unsigned)s_tok;
+            out[2 * (t - 1) + 1] = __float_as_uint(s_share);
+        }
+        prev = s_tok < 0 ? anchor : (unsigned)s_tok;
+        __syncthreads();
+    }
+}
