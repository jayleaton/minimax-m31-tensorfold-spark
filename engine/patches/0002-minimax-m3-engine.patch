index 0000000000000000000000000000000000000000..486095e09e81b977fd1ca5be96c044d1e3f68da5
--- /dev/null
+++ b/zig/src/families/minimax_m3/draw_test.zig
@@ -0,0 +1,214 @@
+//! The sampled draw against the rule's distribution (chi-square on many keyed draws), its keys and a two-rank union.
+const std = @import("std");
+const draw = @import("draw.zig");
+const ops = @import("engine_ops.zig");
+const shard = @import("shard.zig");
+const gpu_rule = @import("lanes").gpu_rule;
+
+const vocab = 2500;
+const draws = 5000;
+
+/// The rule's distribution in f64 by definition: softmax(l / T) over the kept set (1024 best, top_k, top_p, min_p).
+fn reference(gpa: std.mem.Allocator, row: []const f32, s: ops.Sampling, temp_scale: f64) ![]f64 {
+    const p = try gpa.alloc(f64, row.len);
+    errdefer gpa.free(p);
+    @memset(p, 0.0);
+    const order = try gpa.alloc(u32, row.len);
+    defer gpa.free(order);
+    for (order, 0..) |*o, i| o.* = @intCast(i);
+    const By = struct {
+        row: []const f32,
+        fn lt(c: @This(), a: u32, b: u32) bool {
+            return c.row[a] > c.row[b] or (c.row[a] == c.row[b] and a < b);
+        }
+    };
+    std.mem.sort(u32, order, By{ .row = row }, By.lt);
+    const t = s.temperature * temp_scale;
+    const m = @as(f64, row[order[0]]) / t;
+    var allowed: usize = 0;
+    var z_all: f64 = 0.0;
+    for (row) |l| {
+        if (l == -std.math.inf(f32)) continue;
+        allowed += 1;
+        z_all += @exp(@as(f64, l) / t - m);
+    }
+    const cap: usize = if (s.top_k == 0 or s.top_k > gpu_rule.candidates) gpu_rule.candidates else s.top_k;
+    const cand = order[0..@min(cap, allowed)];
+    var z = z_all;
+    if (s.top_k != 0) {
+        z = 0.0;
+        for (cand) |i| z += @exp(@as(f64, row[i]) / t - m);
+    }
+    var keep = cand.len;
+    if (s.top_p > 0.0 and s.top_p < 1.0) {
+        var cum: f64 = 0.0;
+        for (cand, 0..) |i, j| {
+            const next = cum + @exp(@as(f64, row[i]) / t - m) / z;
+            if (next >= s.top_p) {
+                if (temp_scale == 1.0 and (next - s.top_p < 1e-4 or s.top_p - cum < 1e-4)) return error.CutoffTooClose;
+                keep = j + 1;
+                break;
+            }
+            cum = next;
+        }
+    }
+    var kept: f64 = 0.0;
+    for (cand[0..keep]) |i| {
+        if (@as(f64, row[i]) / t - m < s.minLog()) break;
+        p[i] = @exp(@as(f64, row[i]) / t - m);
+        kept += p[i];
+    }
+    for (p) |*q| q.* /= kept;
+    return p;
+}
+
+/// A head's shape: 60 strong tokens hold most mass over a broad tail, `scale` times; masked keeps every third.
+fn headRow(r: std.Random, row: []f32, scale: f32, masked: bool) void {
+    for (row) |*v| v.* = (r.floatNorm(f32) - 1.0) * scale;
+    for (0..60) |j| row[r.uintLessThan(usize, row.len)] = (8.0 - 0.05 * @as(f32, @floatFromInt(j)) + 0.1 * r.floatNorm(f32)) * scale;
+    if (masked) for (row, 0..) |*v, i| {
+        if (i % 3 != 0) v.* = -std.math.inf(f32);
+    };
+}
+
+/// Pearson's statistic of `counts` against `p` (bins under 5 expected pooled) and its 1e-5 critical value.
+fn chiSquare(counts: []const u32, p: []const f64, n: f64) [2]f64 {
+    var stat: f64 = 0.0;
+    var df: f64 = -1.0;
+    var pool_e: f64 = 0.0;
+    var pool_o: f64 = 0.0;
+    for (counts, p) |c, q| {
+        const e = q * n;
+        const o: f64 = @floatFromInt(c);
+        if (e >= 5.0) {
+            stat += (o - e) * (o - e) / e;
+            df += 1.0;
+        } else {
+            pool_e += e;
+            pool_o += o;
+        }
+    }
+    if (pool_e > 0.0) {
+        stat += (pool_o - pool_e) * (pool_o - pool_e) / @max(pool_e, 1e-9);
+        df += 1.0;
+    }
+    const h = 2.0 / (9.0 * df); // Wilson-Hilferty with z = 4.265
+    return .{ stat, df * std.math.pow(f64, 1.0 - h + 4.265 * @sqrt(h), 3.0) };
+}
+
+test "keyed draws follow the rule's distribution (chi-square), and a temperature 30% off is caught" {
+    const gpa = std.testing.allocator;
+    var s = try draw.Scratch.init(gpa, vocab);
+    defer s.deinit(gpa);
+    const row = try gpa.alloc(f32, vocab);
+    defer gpa.free(row);
+    const counts = try gpa.alloc(u32, vocab);
+    defer gpa.free(counts);
+    const Case = struct { rule: ops.Sampling, scale: f32, masked: bool };
+    const cases = [_]Case{
+        .{ .rule = .{ .seed = 1, .temperature = 1.0, .top_k = 0, .top_p = 0.95 }, .scale = 1.0, .masked = false },
+        .{ .rule = .{ .seed = 2, .temperature = 0.7, .top_k = 40, .top_p = 1.0 }, .scale = 1.0, .masked = false },
+        .{ .rule = .{ .seed = 3, .temperature = 1.3, .top_k = 0, .top_p = 0.9, .min_p = 0.01 }, .scale = 1.2, .masked = false },
+        .{ .rule = .{ .seed = 4, .temperature = 1.0, .top_k = 0, .top_p = 0.95 }, .scale = 1.0, .masked = true },
+    };
+    for (cases, 0..) |c, k| {
+        // the first row whose cutoff is clear of the f32 sums' rounding (a row is a pure function of its seed)
+        const p = for (0..16) |j| {
+            var prng = std.Random.DefaultPrng.init(100 + 16 * k + j);
+            headRow(prng.random(), row, c.scale, c.masked);
+            break reference(gpa, row, c.rule, 1.0) catch |e| if (e == error.CutoffTooClose) continue else return e;
+        } else return error.NoClearRow;
+        defer gpa.free(p);
+        @memset(counts, 0);
+        for (0..draws) |pos| {
+            const t = try draw.sample(&s, row, c.rule, @intCast(pos));
+            try std.testing.expect(p[t] > 0.0); // never outside the kept set
+            counts[t] += 1;
+        }
+        const x = chiSquare(counts, p, draws);
+        try std.testing.expect(x[0] < x[1]);
+        const wrong = try reference(gpa, row, c.rule, 1.3);
+        defer gpa.free(wrong);
+        const y = chiSquare(counts, wrong, draws);
+        try std.testing.expect(y[0] > y[1]);
+    }
+}
+
+test "a draw is a function of (seed, position, row): repeated, reordered, fresh scratch and another seed" {
+    const gpa = std.testing.allocator;
+    var a = try draw.Scratch.init(gpa, vocab);
+    defer a.deinit(gpa);
+    var b = try draw.Scratch.init(gpa, vocab);
+    defer b.deinit(gpa);
+    const row = try gpa.alloc(f32, vocab);
+    defer gpa.free(row);
+    const other = try gpa.alloc(f32, vocab);
+    defer gpa.free(other);
+    var prng = std.Random.DefaultPrng.init(5);
+    for (row, other) |*v, *w| {
+        v.* = prng.random().floatNorm(f32) * 2.0;
+        w.* = prng.random().floatNorm(f32);
+    }
+    const rule: ops.Sampling = .{ .seed = 1 << 63 | 77, .temperature = 1.0, .top_k = 0, .top_p = 0.95 };
+    var first: [300]u32 = undefined;
+    for (&first, 0..) |*t, pos| t.* = try draw.sample(&a, row, rule, @intCast(pos));
+    var differs: usize = 0;
+    var pos: usize = first.len;
+    while (pos > 0) {
+        pos -= 1;
+        _ = try draw.sample(&a, other, rule, @intCast(pos)); // another row between draws leaves no state behind
+        try std.testing.expectEqual(first[pos], try draw.sample(&a, row, rule, @intCast(pos)));
+        try std.testing.expectEqual(first[pos], try draw.sample(&b, row, rule, @intCast(pos)));
+        var reseeded = rule;
