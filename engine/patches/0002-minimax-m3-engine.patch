index 0000000000000000000000000000000000000000..084eea1a40c436d9c47b15e2bb0e33f991358fa9
--- /dev/null
+++ b/zig/src/families/minimax_m3/prof_env.zig
@@ -0,0 +1,90 @@
+//! TF_MM3_PROF's switches, read with the other forward settings (ranks.zig); prof.zig and prof_dev.zig act on them.
+const std = @import("std");
+
+pub const Error = error{BadSetting};
+
+/// The widest window a profile times (iface.shared_rows; prof.zig checks they agree).
+pub const max_rows: u32 = 64;
+
+/// An environment lookup (ranks.Get's type).
+pub const Get = *const fn ([:0]const u8) ?[]const u8;
+
+pub const Settings = struct {
+    on: bool = false, // TF_MM3_PROF=1: time every op of the decode calls of `rows` rows
+    rows: u32 = 1, // TF_MM3_PROF_ROWS: the window width timed (1: single-stream decode)
+    every: u32 = 4, // TF_MM3_PROF_EVERY: one call in this many is read and saved
+    out: []const u8 = "mm3-prof", // TF_MM3_PROF_OUT: the report goes to <out>.r<rank>.json
+    prompt: u32 = 0, // TF_MM3_PROF_PROMPT: time the prompt chunks ending at this many tokens instead (0: decode)
+
+    pub fn read(get: Get, problem: *[]const u8) Error!Settings {
+        var s: Settings = .{};
+        if (get("TF_MM3_PROF")) |v| {
+            if (std.mem.eql(u8, v, "1")) s.on = true else if (!std.mem.eql(u8, v, "0") and v.len > 0) {
+                problem.* = "TF_MM3_PROF: 1 to time every op of the decode steps, 0 or unset for none";
+                return error.BadSetting;
+            }
+        }
+        if (get("TF_MM3_PROF_ROWS")) |v| {
+            s.rows = std.fmt.parseInt(u32, v, 10) catch 0;
+            if (s.rows == 0 or s.rows > max_rows) {
+                problem.* = "TF_MM3_PROF_ROWS: the timed window's rows, 1 through the engine's window rows";
+                return error.BadSetting;
+            }
+        }
+        if (get("TF_MM3_PROF_EVERY")) |v| {
+            s.every = std.fmt.parseInt(u32, v, 10) catch 0;
+            if (s.every == 0) {
+                problem.* = "TF_MM3_PROF_EVERY: read one decode call in this many, 1 or more";
+                return error.BadSetting;
+            }
+        }
+        if (get("TF_MM3_PROF_PROMPT")) |v| {
+            s.prompt = std.fmt.parseInt(u32, v, 10) catch 0;
+            if (s.prompt == 0) {
+                problem.* = "TF_MM3_PROF_PROMPT: the token count a timed prompt chunk ends at, 1 or more";
+                return error.BadSetting;
+            }
+        }
+        if (get("TF_MM3_PROF_OUT")) |v| {
+            if (v.len == 0 or v.len > 200) {
+                problem.* = "TF_MM3_PROF_OUT: a path prefix of 1 to 200 bytes (<out>.r<rank>.json is written)";
+                return error.BadSetting;
+            }
+            s.out = v;
+        }
+        return s;
+    }
+};
+
+// ---------------------------------------------------------------- tests
+
+const testing = std.testing;
+
+fn env(comptime pairs: []const [2][]const u8) Get {
+    return struct {
+        fn get(name: [:0]const u8) ?[]const u8 {
+            inline for (pairs) |p| if (std.mem.eql(u8, name, p[0])) return p[1];
+            return null;
+        }
+    }.get;
+}
+
+test "prof settings: off by default, every knob read, bad values refused with a reason" {
+    var why: []const u8 = "";
+    const off = try Settings.read(env(&.{}), &why);
+    try testing.expect(!off.on);
+    try testing.expectEqual(@as(u32, 1), off.rows);
+    const on = try Settings.read(env(&.{ .{ "TF_MM3_PROF", "1" }, .{ "TF_MM3_PROF_ROWS", "4" }, .{ "TF_MM3_PROF_EVERY", "2" }, .{ "TF_MM3_PROF_OUT", "/cache/p" } }), &why);
+    try testing.expect(on.on and on.rows == 4 and on.every == 2);
+    try testing.expectEqualStrings("/cache/p", on.out);
+    try testing.expect(!(try Settings.read(env(&.{.{ "TF_MM3_PROF", "0" }}), &why)).on);
+    try testing.expectEqual(@as(u32, 0), off.prompt);
+    try testing.expectEqual(@as(u32, 32768), (try Settings.read(env(&.{.{ "TF_MM3_PROF_PROMPT", "32768" }}), &why)).prompt);
+    try testing.expectError(error.BadSetting, Settings.read(env(&.{.{ "TF_MM3_PROF_PROMPT", "0" }}), &why));
+    try testing.expectError(error.BadSetting, Settings.read(env(&.{.{ "TF_MM3_PROF", "yes" }}), &why));
+    try testing.expect(std.mem.startsWith(u8, why, "TF_MM3_PROF:"));
+    try testing.expectError(error.BadSetting, Settings.read(env(&.{.{ "TF_MM3_PROF_ROWS", "65" }}), &why));
+    try testing.expectError(error.BadSetting, Settings.read(env(&.{.{ "TF_MM3_PROF_ROWS", "0" }}), &why));
+    try testing.expectError(error.BadSetting, Settings.read(env(&.{.{ "TF_MM3_PROF_EVERY", "0" }}), &why));
+    try testing.expectError(error.BadSetting, Settings.read(env(&.{.{ "TF_MM3_PROF_OUT", "" }}), &why));
+}
