diff --git a/zig/src/core/template/generation.zig b/zig/src/core/template/generation.zig
new file mode 100644
index 0000000000000000000000000000000000000000..920514329a88f0d7ac1b90be39394d1345b4161b
--- /dev/null
+++ b/zig/src/core/template/generation.zig
@@ -0,0 +1,84 @@
+//! Where a template's generation prompt starts: a last top-level `if add_generation_prompt` nothing else reads.
+const std = @import("std");
+const ast = @import("ast.zig");
+
+const flag = "add_generation_prompt";
+
+/// The top-level statement that alone writes the generation prompt, or null when other output may depend on the flag.
+pub fn tail(body: []const ast.Stmt) ?usize {
+    var k = body.len;
+    while (k > 0 and blank(body[k - 1])) k -= 1;
+    if (k == 0 or body[k - 1] != .if_) return null;
+    const last = body[k - 1].if_;
+    if (last.elifs.len > 0 or last.else_body.len > 0) return null;
+    if (last.test_expr.* != .name or !std.mem.eql(u8, last.test_expr.name.id, flag)) return null;
+    var seen = false;
+    stmts(body[0 .. k - 1], &seen);
+    stmts(last.body, &seen);
+    return if (seen) null else k - 1;
+}
+
+fn blank(st: ast.Stmt) bool {
+    if (st != .output) return false;
+    for (st.output) |p| if (p != .text or p.text.len > 0) return false;
+    return true;
+}
+
+fn name(n: *const ast.Name, seen: *bool) void {
+    if (std.mem.eql(u8, n.id, flag)) seen.* = true;
+}
+
+fn target(t: ast.Target, seen: *bool) void {
+    switch (t) {
+        .name => |n| name(n, seen),
+        .tuple => |items| for (items) |x| target(x, seen),
+        .ns => |ns| name(ns.name, seen),
+    }
+}
+
+fn expr(e: *const ast.Expr, seen: *bool) void {
+    if (e.* == .name) name(e.name, seen);
+    ast.eachChild(error{}, e, seen, child) catch |err| switch (err) {};
+}
+
+fn child(seen: *bool, e: *ast.Expr) error{}!void {
+    expr(e, seen);
+}
+
+fn ifs(n: *const ast.If, seen: *bool) void {
+    expr(n.test_expr, seen);
+    stmts(n.body, seen);
+    for (n.elifs) |e| ifs(e, seen);
+    stmts(n.else_body, seen);
+}
+
+fn stmts(body: []const ast.Stmt, seen: *bool) void {
+    for (body) |st| switch (st) {
+        .output => |pieces| for (pieces) |p| if (p == .expr) expr(p.expr, seen),
+        .for_ => |f| {
+            target(f.target, seen);
+            expr(f.iter, seen);
+            if (f.filter) |x| expr(x, seen);
+            stmts(f.body, seen);
+            stmts(f.else_body, seen);
+        },
+        .if_ => |n| ifs(n, seen),
+        .assign => |a| {
+            target(a.target, seen);
+            expr(a.value, seen);
+        },
+        .block_set => |b| {
+            target(b.target, seen);
+            if (b.filter) |x| expr(x, seen);
+            stmts(b.body, seen);
+        },
+        .macro => |m| {
+            name(m.name, seen);
+            for (m.params) |p| name(p, seen);
+            for (m.defaults) |d| expr(d, seen);
+            stmts(m.body, seen);
+        },
+        .scoped => |s| stmts(s.body, seen),
+        .break_, .continue_ => {},
+    };
+}
