+//! The server's ``TF_SERVE_*`` switches, read once when it starts.
+const std = @import("std");
+const platform = @import("sys");
+
+pub const Toggles = struct {
+    /// TF_SERVE_STAGES=1: each reply's stage times in its done line and its ``tensorfold.stages``.
+    stages: bool = false,
+    /// TF_SERVE_INCREMENTAL (on unless 0): stream tag searches resume where they stopped; call arguments grow in place.
+    incremental: bool = true,
+    /// TF_SERVE_REASONING_STRIP=1: streamed reasoning stripped as the whole reply's is (the goldens stream its edges).
+    reasoning_strip: bool = false,
+
+    pub fn fromEnv() Toggles {
+        return .{ .stages = on("TF_SERVE_STAGES", false), .incremental = on("TF_SERVE_INCREMENTAL", true), .reasoning_strip = on("TF_SERVE_REASONING_STRIP", false) };
+    }
+};
+
+fn on(name: [*:0]const u8, default: bool) bool {
+    const v = platform.getenv(name) orelse return default;
+    if (v.len == 0) return default;
+    return !(std.mem.eql(u8, v, "0") or std.ascii.eqlIgnoreCase(v, "false") or std.ascii.eqlIgnoreCase(v, "off"));
+}
