diff --git a/zig/src/cuda/minimax_m3_tier.zig b/zig/src/cuda/minimax_m3_tier.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b27fb288dc43a7d44e9ea7130002d1eb8759939b
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_tier.zig
@@ -0,0 +1,189 @@
+//! MiniMax-M3.1-Flash KV tier launches: horizon-exact and summary-bound scores, candidates, rerank, summaries.
+const std = @import("std");
+const kernels = @import("kernels.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+const sparse = @import("minimax_m3_sparse.zig");
+const geom = sparse.geom;
+
+const Driver = @import("driver.zig").Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = stream_.Stream;
+
+/// Bytes one block-layer summary takes: bf16 per-dimension min then max of its index keys.
+pub const summ_bytes: usize = 2 * geom.d * geom.bf16_bytes;
+/// Bytes one IK arena slice takes: a block's 128 index keys of one layer.
+pub const ik_bytes: usize = geom.block * geom.d * geom.bf16_bytes;
+
+/// The tier's device state one layer's launches read: slices, the IK arena, summaries and the three tables.
+pub const Tables = struct {
+    /// Virtual page ids by block (the engine's block table), the layer's slice slots and IK arena slices by block.
+    vtab: u64,
+    kvtab: u64,
+    iktab: u64,
+    /// int32 [rows] offsets into each table, or 0 for one stream whose table pointers are its row.
+    row_tab: u64 = 0,
+    slices: u64,
+    slice_bytes: u64,
+    ik_arena: u64,
+    summ: u64,
+    layers: u32,
+    layer: u32,
+    kvh: u32,
+    kv8: bool,
+    /// Blocks before the row's own scored exactly (own block included: at least 1).
+    horizon: u32,
+    /// Cold candidates a (row, kv head) reranks.
+    m: u32,
+};
+
+pub const Tier = struct {
+    mod: Module,
+    index_fn: Function,
+    cand_fn: Function,
+    rerank_fn: Function,
+    summ_fn: Function,
+    ikcopy_fn: Function,
+    patch_fn: Function,
+
+    pub fn load(d: *const Driver) !Tier {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var m = try Module.load(d, kernels.minimax_m3_tier);
+        errdefer m.unload();
+        return .{
+            .mod = m,
+            .index_fn = try m.function("tf_mm3_tier_index"),
+            .cand_fn = try m.function("tf_mm3_tier_cand"),
+            .rerank_fn = try m.function("tf_mm3_tier_rerank"),
+            .summ_fn = try m.function("tf_mm3_tier_summ"),
+            .ikcopy_fn = try m.function("tf_mm3_tier_ikcopy"),
+            .patch_fn = try m.function("tf_mm3_tier_patch"),
+        };
+    }
+
+    pub fn unload(t: *Tier) void {
+        t.mod.unload();
+    }
+
+    fn grid(x: usize, y: usize, z: usize, threads: u32) launch_.Config {
+        return .{ .grid = .{ .x = @intCast(x), .y = @intCast(y), .z = @intCast(z) }, .block = .{ .x = threads } };
+    }
+
+    /// Block maxima to `sc.bmax`: exact inside each row's horizon, the summary bound past it.
+    pub fn index(t: *const Tier, st: Stream, iq: u64, rows: sparse.Rows, tb: Tables, sc: sparse.Scratch, max_pos: usize, scale: f32) !void {
+        try geom.check(rows.n, tb.kvh);
+        if (geom.blocks(max_pos) > sc.bm_stride) return error.TableTooShort;
+        var a: launch_.Args = .{};
+        a.add(iq);
+        a.add(rows.pos);
+        a.add(rows.pos0);
+        a.add(tb.row_tab);
+        a.add(tb.vtab);
+        a.add(tb.kvtab);
+        a.add(tb.iktab);
+        a.add(tb.slices);
+        a.add(@as(i64, @intCast(tb.slice_bytes)));
+        a.add(tb.ik_arena);
+        a.add(tb.summ);
+        a.add(@as(i32, @intCast(tb.layers)));
+        a.add(@as(i32, @intCast(tb.layer)));
+        a.add(@as(i32, @intCast(tb.horizon)));
+        a.add(@as(i32, @intCast(tb.kvh)));
+        a.add(sc.bmax);
+        a.add(@as(i32, @intCast(sc.bm_stride)));
+        a.add(scale);
+        a.add(@as(i32, @intFromBool(tb.kv8)));
+        try launch_.launch(t.index_fn, grid(geom.blocks(max_pos), tb.kvh, rows.n, geom.index_threads), st, &a);
+    }
+
+    /// Candidates to `cand` [rows, kvh, 16 + m]: the horizon's top 16 under `rules`, then the top m cold by bound.
+    pub fn candidates(t: *const Tier, st: Stream, rows: sparse.Rows, tb: Tables, sc: sparse.Scratch, cand: u64, rules: geom.Rules) !void {
+        try geom.check(rows.n, tb.kvh);
+        var a: launch_.Args = .{};
+        a.add(sc.bmax);
+        a.add(rows.pos);
+        a.add(rows.pos0);
+        a.add(cand);
+        a.add(@as(i32, @intCast(tb.kvh)));
+        a.add(@as(i32, @intCast(sc.bm_stride)));
+        a.add(@as(i32, @intCast(tb.horizon)));
+        a.add(@as(i32, @intCast(tb.m)));
+        addRules(&a, rules, true);
+        try launch_.launch(t.cand_fn, grid(tb.kvh, rows.n, 1, geom.select_threads), st, &a);
+    }
+
+    /// Cold candidates' exact maxima from their slices' IK into `sc.bmax`; other cold blocks to -inf.
+    pub fn rerank(t: *const Tier, st: Stream, iq: u64, rows: sparse.Rows, tb: Tables, sc: sparse.Scratch, cand: u64, max_pos: usize, scale: f32, rules: geom.Rules) !void {
+        var a: launch_.Args = .{};
+        a.add(iq);
+        a.add(rows.pos);
+        a.add(rows.pos0);
+        a.add(tb.row_tab);
+        a.add(tb.kvtab);
+        a.add(tb.slices);
+        a.add(@as(i64, @intCast(tb.slice_bytes)));
+        a.add(cand);
+        a.add(@as(i32, @intCast(tb.m)));
+        a.add(@as(i32, @intCast(tb.horizon)));
+        a.add(@as(i32, @intCast(tb.kvh)));
+        a.add(sc.bmax);
+        a.add(@as(i32, @intCast(sc.bm_stride)));
+        a.add(scale);
+        a.add(@as(i32, @intFromBool(tb.kv8)));
+        addRules(&a, rules, false);
+        try launch_.launch(t.rerank_fn, grid(geom.blocks(max_pos), tb.kvh, rows.n, geom.index_threads), st, &a);
+    }
+
+    fn addRules(a: *launch_.Args, r: geom.Rules, tie: bool) void {
+        a.add(r.init_n);
+        a.add(@as(i32, @intFromBool(r.init_inclusive)));
+        a.add(r.local_n);
+        a.add(@as(i32, @intFromBool(r.local_trailing)));
+        if (tie) a.add(@as(i32, @intFromBool(r.higher_tie)));
+    }
+
+    /// `n` finished slices (int4 jobs: slot, virtual page, layer, IK arena slice or -1): summaries and IK copies.
+    pub fn summarize(t: *const Tier, st: Stream, jobs: u64, n: usize, tb: Tables) !void {
+        if (n == 0) return;
+        var a: launch_.Args = .{};
+        a.add(jobs);
+        a.add(tb.slices);
+        a.add(@as(i64, @intCast(tb.slice_bytes)));
+        a.add(@as(i32, @intCast(tb.kvh)));
+        a.add(@as(i32, @intFromBool(tb.kv8)));
+        a.add(tb.summ);
+        a.add(@as(i32, @intCast(tb.layers)));
+        a.add(tb.ik_arena);
+        try launch_.launch(t.summ_fn, grid(n, 1, 1, geom.index_threads), st, &a);
+    }
+
+    /// `n` (slice slot, IK arena slice) int2 jobs: the slices' IK to the arena.
+    pub fn ikCopy(t: *const Tier, st: Stream, jobs: u64, n: usize, tb: Tables) !void {
+        if (n == 0) return;
+        var a: launch_.Args = .{};
+        a.add(jobs);
+        a.add(tb.slices);
+        a.add(@as(i64, @intCast(tb.slice_bytes)));
+        a.add(@as(i32, @intCast(tb.kvh)));
+        a.add(@as(i32, @intFromBool(tb.kv8)));
+        a.add(tb.ik_arena);
+        try launch_.launch(t.ikcopy_fn, grid(n, 1, 1, geom.index_threads), st, &a);
+    }
+
+    /// `n` (entry, value) int2 patches into the int32 tables at `tabs`.
+    pub fn patch(t: *const Tier, st: Stream, tabs: u64, patches: u64, n: usize) !void {
+        if (n == 0) return;
+        var a: launch_.Args = .{};
+        a.add(tabs);
+        a.add(patches);
+        a.add(@as(i32, @intCast(n)));
+        try launch_.launch(t.patch_fn, grid((n + 255) / 256, 1, 1, 256), st, &a);
+    }
+};
+
+test "tier sizes: a summary is 512 bytes and an IK slice 32 KiB" {
+    try std.testing.expectEqual(@as(usize, 512), summ_bytes);
+    try std.testing.expectEqual(@as(usize, 32768), ik_bytes);
+}
