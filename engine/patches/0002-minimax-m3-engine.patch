+        m.add(logits);
+        m.add(@as(i64, @intCast(ld)));
+        m.add(@as(i32, @intCast(n)));
+        m.add(@as(i32, @intCast(sl)));
+        m.add(@as(i32, @intCast(id0)));
+        m.add(@as(i32, @intCast(c)));
+        m.add(out);
+        try launch_.launch(t.merge_fn, .{ .grid = .{ .x = rows, .y = 1, .z = 1 }, .block = .{ .x = threads } }, st, &m);
+    }
+};
+
+test "slices: about 8192 logits each, never more than one merge sorts" {
+    try std.testing.expectEqual(@as(u32, 25), slices(200064, 64));
+    try std.testing.expectEqual(@as(u32, 13), slices(100032, 64));
+    try std.testing.expectEqual(@as(u32, 1), slices(100, 64));
+    try std.testing.expectEqual(@as(u32, 32), slices(1 << 24, 64));
+    try std.testing.expectEqual(@as(usize, 7 * 25 * 64 * 8), partBytes(7, 200064, 64));
+}
