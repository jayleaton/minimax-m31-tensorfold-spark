diff --git a/zig/tests/cuda/mm3_dflash2_parity.zig b/zig/tests/cuda/mm3_dflash2_parity.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b21431a53853334fe0805880d4017a3e9e932eaa
--- /dev/null
+++ b/zig/tests/cuda/mm3_dflash2_parity.zig
@@ -0,0 +1,191 @@
+//! tf-cuda-test mm3-dflash2-parity: the DFlash2 draft over reference taps on one GPU (world 1), its rows as .npy.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const lp = @import("mm3_layer_parity.zig");
+
+const d2 = mm.dflash2_config;
+const dd = mm.dflash2_device;
+const fw = mm.forward;
+
+pub const usage = "  mm3-dflash2-parity PACK DRAFT REF_DIR OUT_DIR  the DFlash2 draft's absorb and pass over REF_DIR/taps.npy\n";
+
+/// Passes timed after the first; each must leave the first's drafts.
+const repeats = 3;
+
+/// REF_DIR/anchor.json: the target's greedy token after the prompt and its position (the prompt's length).
+const Anchor = struct { anchor: u32, pos: u32 };
+
+/// What OUT_DIR/drafts.json records besides the .npy rows.
+const Report = struct {
+    anchor: u32,
+    pos: u32,
+    context_rows: u32,
+    absorb_chunks: u32,
+    tokens: []const i32,
+    conf: []const f32,
+    absorb_ms: f64,
+    pass_ms: f64,
+    pass_ms_repeat: f64,
+    draft_bytes: u64,
+    weight_bytes: u64,
+    scratch_bytes: u64,
+    ring_bytes: u64,
+};
+
+fn readIn(a: std.mem.Allocator, io: std.Io, dir: []const u8, name: []const u8) ![]u8 {
+    return std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ dir, name }), a, .limited(1 << 24));
+}
+
+fn gib(n: u64) f64 {
+    return @as(f64, @floatFromInt(n)) / (1 << 30);
+}
+
+fn msSince(io: std.Io, t0: i96) f64 {
+    return @as(f64, @floatFromInt(check.now(io) - t0)) / 1e6;
+}
+
+/// `len` bytes of the draft's scratch at device address `addr`, on the host.
+fn fetch(gpu: check.Gpu, a: std.mem.Allocator, addr: u64, len: usize) ![]u8 {
+    const host = try a.alloc(u8, len);
+    const view: cuda.DeviceBuffer = .{ .d = gpu.d, .ptr = addr, .len = len, .borrowed = true };
+    try view.download(0, host);
+    return host;
+}
+
+/// The pass's drafts, waited for.
+fn passOnce(draft: mm.engine_ops.Draft, an: Anchor) !mm.engine_ops.DraftResult {
+    var res: mm.engine_ops.DraftResult = .{};
+    try draft.pass(.{ .slot = 0, .anchor = an.anchor, .pos = an.pos });
+    try draft.result(0, &res);
+    return res;
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len < 4) {
+        std.debug.print("{s}", .{usage});
+        return error.MissingArgument;
+    }
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const io = gpu.io;
+    const pack = rest[0];
+    const draft_dir = rest[1];
+    const ref = rest[2];
+    const out = rest[3];
+    const c = try mm.config.parse(a, try readIn(a, io, pack, "config.json"));
+    const cfg = try d2.parse(a, try readIn(a, io, draft_dir, "config.json"));
+    if (d2.admit(&cfg, &c, .{ .world = 1, .window_rows = mm.iface.window_rows })) |r| {
+        if (r != .causal_block) {
+            std.debug.print("FAIL {s}\n", .{r.text()});
+            return error.DraftRefused;
+        }
+        std.debug.print("INFO {s}; the device's block attention is bidirectional: compare with --block-attention bidirectional\n", .{r.text()});
+    }
+    const x = try lp.readRows(a, io, try std.fs.path.join(a, &.{ ref, "taps.npy" }), "<u2", cfg.fcIn());
+    const n: u32 = @intCast(x.shape[0]);
+    const an = try std.json.parseFromSliceLeaky(Anchor, a, try readIn(a, io, ref, "anchor.json"), .{ .ignore_unknown_fields = true });
+    if (an.pos != n) {
+        std.debug.print("FAIL {s}/anchor.json: the anchor at {d}, the taps cover positions 0 .. {d}\n", .{ ref, an.pos, n - 1 });
+        return error.BadInput;
+    }
+
+    // ---- the target's part (layer 0 with the embedding, final norm and head), kernels, a geometry, the draft
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    const share = try mm.shard.Share.of(&c, 0, 1);
+    var t0 = check.now(io);
+    var loaded = try mm.weights_device.loadLayers(gpu.gpa, io, gpu.d, stream, pack, &c, share, &.{0});
+    defer loaded.deinit();
+    std.debug.print("INFO target layer 0, embedding and head: {d} MiB in {d:.1} s\n", .{ loaded.bytes >> 20, msSince(io, t0) / 1e3 });
+    var modules = try fw.Modules.load(gpu.d);
+    defer modules.deinit();
+    const geometry = try fw.Geometry.of(&c, share, 1, mm.iface.prefill_rows);
+    const free0 = (try gpu.ctx.memInfo()).free;
+    t0 = check.now(io);
+    const dev = try dd.Device.open(gpu.gpa, io, gpu.d, gpu.ctx, stream, draft_dir, cfg, &modules, &loaded.weights, &geometry, null);
+    const draft = dev.interface();
+    defer draft.vtable.deinit(draft.ptr);
+    std.debug.print("INFO draft open: {d:.1} s\n", .{msSince(io, t0) / 1e3});
+    try draft.attach(1);
+    const free1 = (try gpu.ctx.memInfo()).free;
+
+    // ---- memory: what the device holds against the budget's estimate
+    const fields = d2.scratchBytes(&cfg, dev.split, mm.iface.prefill_rows, geometry.slot, 1);
+    const est = try d2.cost(&cfg, 0, 1, mm.iface.window_rows, mm.iface.prefill_rows, dd.max_snaps);
+    const fell = (@as(f64, @floatFromInt(free0)) - @as(f64, @floatFromInt(free1))) / (1 << 30);
+    std.debug.print("INFO draft bytes(): {d:.3} GiB = weights {d:.3} + scratch {d:.3} (fields {d:.3}, split-K partials and alignment {d:.3})\n", .{ gib(dev.bytes()), gib(dev.model.bytes), gib(dev.sc.buf.len), gib(fields), gib(dev.sc.buf.len - fields) });
+    std.debug.print("INFO rings: {d:.3} GiB a stream ({d} rows), {d} snapshots {d:.3} GiB; device free fell {d:.3} GiB over open and attach(1)\n", .{ gib(dev.ring_bytes), dev.ring_rows, dd.max_snaps, gib(@as(u64, dd.max_snaps) * dev.ring_bytes), fell });
+    std.debug.print("INFO budget (d2.cost): weights {d:.3} GiB, runtime {d:.3} GiB, per lane {d:.3} GiB\n", .{ gib(est.weights), gib(est.runtime), gib(est.per_lane) });
+
+    // ---- the taps of positions 0 .. n - 1, absorbed a prompt chunk at a time, then one pass at the anchor
+    var taps = try cuda.DeviceBuffer.fromHost(gpu.d, x.data);
+    defer taps.free();
+    t0 = check.now(io);
+    var row: u32 = 0;
+    var chunks: u32 = 0;
+    while (row < n) : (chunks += 1) {
+        const rows = @min(mm.iface.prefill_rows, n - row);
+        try draft.absorb(0, row, rows, taps.ptr, row);
+        row += rows;
+    }
+    try stream.synchronize();
+    const absorb_ms = msSince(io, t0);
+    t0 = check.now(io);
+    const res = try passOnce(draft, an);
+    const pass_ms = msSince(io, t0);
+    t0 = check.now(io);
+    for (0..repeats) |_| {
+        const again = try passOnce(draft, an);
+        try check.expect(std.mem.eql(i32, again.tokens[0..again.n], res.tokens[0..res.n]), "mm3-dflash2-parity: a repeated pass drafted {any}, the first {any}", .{ again.tokens[0..again.n], res.tokens[0..res.n] });
+    }
+    const repeat_ms = msSince(io, t0) / repeats;
+    std.debug.print("INFO absorb {d} rows in {d} chunks: {d:.1} ms; pass: {d:.2} ms first, {d:.2} ms repeated\n", .{ n, chunks, absorb_ms, pass_ms, repeat_ms });
+
+    // ---- the pass's rows: post bf16 [block][hidden], candidates [block][top_k], sel_h f32 [block][rank]
+    const block: usize = cfg.block;
+    const k: usize = cfg.top_k;
+    const post = try fetch(gpu, a, dev.sc.post, block * cfg.hidden * 2);
+    const pairs = try fetch(gpu, a, dev.sc.cand_l, block * k * 8);
+    const sel_h = try fetch(gpu, a, dev.sc.sel_h, block * cfg.rank * 4);
+    const ids = try a.alloc(u8, block * k * 4);
+    const logits = try a.alloc(u8, block * k * 4);
+    for (0..block * k) |i| {
+        @memcpy(logits[4 * i ..][0..4], pairs[8 * i ..][0..4]);
+        @memcpy(ids[4 * i ..][0..4], pairs[8 * i + 4 ..][0..4]);
+    }
+    try std.Io.Dir.cwd().createDirPath(io, out);
+    try lp.writeNpy(a, io, out, "post", "<u2", block, post);
+    try lp.writeNpy(a, io, out, "cand_ids", "<i4", block, ids);
+    try lp.writeNpy(a, io, out, "cand_logits", "<f4", block, logits);
+    try lp.writeNpy(a, io, out, "sel_h", "<f4", block, sel_h);
+    const report: Report = .{
+        .anchor = an.anchor,
+        .pos = an.pos,
+        .context_rows = n,
+        .absorb_chunks = chunks,
+        .tokens = res.tokens[0..res.n],
+        .conf = res.conf[0..res.n],
+        .absorb_ms = absorb_ms,
+        .pass_ms = pass_ms,
+        .pass_ms_repeat = repeat_ms,
+        .draft_bytes = dev.bytes(),
+        .weight_bytes = dev.model.bytes,
+        .scratch_bytes = dev.sc.buf.len,
+        .ring_bytes = dev.ring_bytes,
+    };
+    const drafts_path = try std.fs.path.join(a, &.{ out, "drafts.json" });
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = drafts_path, .data = try std.json.Stringify.valueAlloc(a, report, .{}) });
+    std.debug.print("  wrote {s}: drafts {any}\n", .{ drafts_path, res.tokens[0..res.n] });
+
+    // ---- each draft is one of its row's candidates (row t + 1 proposes draft t)
+    try check.expect(res.n == cfg.depth(), "mm3-dflash2-parity: {d} drafts, the block proposes {d}", .{ res.n, cfg.depth() });
+    for (res.tokens[0..res.n], 1..) |tok, t| {
+        var found = false;
+        for (0..k) |j| found = found or std.mem.readInt(i32, ids[4 * (t * k + j) ..][0..4], .little) == tok;
+        try check.expect(tok >= 0 and found, "mm3-dflash2-parity: draft {d} ({d}) is not among row {d}'s candidates", .{ t - 1, tok, t });
+    }
+    check.pass("mm3-dflash2-parity: {d} context rows, anchor {d} at {d}, drafts {any}, pass {d:.2} ms", .{ n, an.anchor, an.pos, res.tokens[0..res.n], repeat_ms });
+}
diff --git a/zig/tests/cuda/mm3_dspark_real.zig b/zig/tests/cuda/mm3_dspark_real.zig
new file mode 100644
index 0000000000000000000000000000000000000000..3bfe0c6517b629679e1e210d021aa8d624b1e088
--- /dev/null
+++ b/zig/tests/cuda/mm3_dspark_real.zig
@@ -0,0 +1,146 @@
+//! tf-cuda-test mm3-dspark-real: the real dspark draft on one GPU over captured target taps, drafts and rows as .npy.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+
+const dc = mm.dspark_config;
+const dd = mm.dspark_device;
+
+pub const usage = "  mm3-dspark-real PACK DSPARK ROW_DIR [SAVE]  the draft over ROW_DIR/out.npy at anchors.npy; tf_*.npy out\n";
+
+pub fn readNpy(a: std.mem.Allocator, io: std.Io, dir: []const u8, name: []const u8, descr: []const u8) !core.npy.Array {
+    const path = try std.fs.path.join(a, &.{ dir, name });
+    const x = try core.npy.parse(try std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(1 << 31)));
+    if (!std.mem.eql(u8, x.descr, descr)) {
+        std.debug.print("FAIL {s}: dtype {s}, expected {s}\n", .{ path, x.descr, descr });
+        return error.BadInput;
+    }
+    return x;
+}
+
+/// `data` as `<dir>/<name>.npy` with dtype `descr` and the given shape.
+fn writeNpy(a: std.mem.Allocator, io: std.Io, dir: []const u8, name: []const u8, descr: []const u8, shape: []const usize, data: []const u8) !void {
+    var sb: [96]u8 = undefined;
+    var w: std.Io.Writer = .fixed(&sb);
+    for (shape) |d| try w.print("{d}, ", .{d});
+    var dict_buf: [192]u8 = undefined;
+    const dict = try std.fmt.bufPrint(&dict_buf, "{{'descr': '{s}', 'fortran_order': False, 'shape': ({s}), }}", .{ descr, w.buffered() });
+    const pad = 64 - (10 + dict.len + 1) % 64;
+    const head = 10 + dict.len + pad + 1;
+    const file = try a.alloc(u8, head + data.len);
+    @memcpy(file[0..8], "\x93NUMPY\x01\x00");
+    std.mem.writeInt(u16, file[8..10], @intCast(dict.len + pad + 1), .little);
+    @memcpy(file[10..][0..dict.len], dict);
+    @memset(file[10 + dict.len ..][0..pad], ' ');
+    file[head - 1] = '\n';
+    @memcpy(file[head..], data);
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = try std.fs.path.join(a, &.{ dir, name }), .data = file });
+}
+
+fn gib(b: u64) f64 {
+    return @as(f64, @floatFromInt(b)) / (1 << 30);
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len < 3) {
+        std.debug.print("{s}", .{usage});
+        return error.MissingArgument;
+    }
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const io = gpu.io;
+    const pack, const draft_dir, const row_dir = .{ rest[0], rest[1], rest[2] };
+    const save: usize = if (rest.len > 3) try std.fmt.parseInt(usize, rest[3], 10) else 0;
+    const c = try mm.config.parse(a, try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ pack, "config.json" }), a, .limited(1 << 24)));
+    const cfg = try dc.parse(a, try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ draft_dir, "config.json" }), a, .limited(1 << 24)));
+    if (dc.admit(&cfg, &c, .{ .world = 1, .window_rows = mm.iface.window_rows })) |why| {
+        std.debug.print("FAIL the draft is refused: {s}\n", .{why.text()});
+        return error.DrafterRefused;
+    }
+    const taps = try readNpy(a, io, row_dir, "out.npy", "<u2");
+    const ids = try readNpy(a, io, row_dir, "ids.npy", "<i4");
+    const anchors = try readNpy(a, io, row_dir, "anchors.npy", "<i4");
+    const n: u32 = @intCast(taps.shape[0]);
+    if (taps.rank != 3 or taps.shape[1] != cfg.n_taps or taps.shape[2] != cfg.hidden) return error.BadInput;
+    const ids_v = std.mem.bytesAsSlice(i32, ids.data);
+    const anc = std.mem.bytesAsSlice(i32, anchors.data);
+    const n_anc = anc.len;
+
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var modules = try mm.forward.Modules.load(gpu.d);
+    defer modules.deinit();
+
+    // ---- the draft's device memory on each rank of world 2 (the first open is a warm-up the driver's reserve hides)
+    for ([_][2]u32{ .{ 0, 2 }, .{ 0, 2 }, .{ 1, 2 } }, 0..) |rw, pass_i| {
+        const share2 = try mm.shard.Share.of(&c, rw[0], rw[1]);
+        const g2 = try mm.forward.Geometry.of(&c, share2, c.layers, mm.iface.max_rows);
+        const tw0: mm.weights.Weights = .{ .embed = 0, .final_norm = 0, .head = std.mem.zeroes(cuda.exl3.Weight), .layers = &.{} };
+        const before = (try gpu.ctx.memInfo()).free;
+        const dv2 = try dd.Device.open(gpu.gpa, io, gpu.d, gpu.ctx, stream, draft_dir, cfg, share2, &modules, &tw0, &g2, null);
+        var if2 = dv2.interface();
+        try if2.attach(1);
+        const after = (try gpu.ctx.memInfo()).free;
+        const cost = dc.cost(&cfg, share2, mm.iface.window_rows, mm.iface.prefill_rows, false);
+        if (pass_i > 0) std.debug.print("INFO rank {d} of {d}: draft device {d:.3} GiB measured (weights {d:.3}, scratch {d:.3}, ring a stream {d:.1} MiB, 8 snapshots {d:.3} GiB); plan weights {d:.3} + runtime {d:.3} + {d:.1} MiB a stream\n", .{
+            rw[0],                                               rw[1],                   gib(before - after), gib(dv2.model.bytes), gib(dv2.sc.buf.len),
+            @as(f64, @floatFromInt(dv2.ring_bytes)) / (1 << 20), gib(8 * dv2.ring_bytes), gib(cost.weights),   gib(cost.runtime),    @as(f64, @floatFromInt(cost.per_lane)) / (1 << 20),
+        });
+        if2.vtable.deinit(dv2);
+    }
+
+    // ---- world 1: the target's embedding and head (layer 0 rides along), the whole draft
+    const share = try mm.shard.Share.of(&c, 0, 1);
+    var loaded = try mm.weights_device.loadLayers(gpu.gpa, io, gpu.d, stream, pack, &c, share, &.{0});
+    defer loaded.deinit();
+    const g = try mm.forward.Geometry.of(&c, share, 1, mm.iface.max_rows);
+    const dev = try dd.Device.open(gpu.gpa, io, gpu.d, gpu.ctx, stream, draft_dir, cfg, share, &modules, &loaded.weights, &g, null);
+    var ifc = dev.interface();
+    defer ifc.vtable.deinit(dev);
+    try ifc.attach(1);
+    var taps_dev = try cuda.DeviceBuffer.fromHost(gpu.d, taps.data);
+    defer taps_dev.free();
+
+    const drafts = try a.alloc(i32, n_anc * cfg.block);
+    const conf = try a.alloc(f32, n_anc * cfg.block);
+    const n_save = @min(save, n_anc);
+    const post_row = @as(usize, cfg.block) * cfg.hidden * 2;
+    const posts = try a.alloc(u8, n_save * post_row);
+    var next: u32 = 0;
+    var pass_ns: u64 = 0;
+    var absorb_ns: u64 = 0;
+    for (anc, 0..) |p_i, j| {
+        const p: u32 = @intCast(p_i);
+        if (p < next or p >= n) return error.AnchorsNotAscending;
+        const t0 = check.now(io);
+        while (next < p) { // the ring must end exactly at the pending position
+            const rows = @min(p - next, mm.iface.prefill_rows);
+            try ifc.absorb(0, next, rows, taps_dev.ptr, next);
+            next += rows;
+        }
+        try stream.synchronize();
+        const t1 = check.now(io);
+        try ifc.pass(.{ .slot = 0, .anchor = @intCast(ids_v[p]), .pos = p });
+        var r: mm.engine_ops.DraftResult = .{};
+        try ifc.result(0, &r);
+        pass_ns += @intCast(check.now(io) - t1);
+        absorb_ns += @intCast(t1 - t0);
+        for (0..cfg.block) |i| {
+            drafts[j * cfg.block + i] = r.tokens[i];
+            conf[j * cfg.block + i] = r.conf[i];
+        }
+        if (j < n_save) {
+            const post_buf: cuda.DeviceBuffer = .{ .d = gpu.d, .ptr = dev.sc.post, .len = post_row };
+            try post_buf.download(0, posts[j * post_row ..][0..post_row]);
+        }
+    }
+    try writeNpy(a, io, row_dir, "tf_drafts.npy", "<i4", &.{ n_anc, cfg.block }, std.mem.sliceAsBytes(drafts));
+    try writeNpy(a, io, row_dir, "tf_conf.npy", "<f4", &.{ n_anc, cfg.block }, std.mem.sliceAsBytes(conf));
+    if (n_save > 0) try writeNpy(a, io, row_dir, "tf_post.npy", "<u2", &.{ n_save, cfg.block, cfg.hidden }, posts);
+    check.pass("mm3-dspark-real: {d} anchors over {d} positions; pass + result {d:.2} ms, absorbs {d:.1} ms in all", .{
+        n_anc, n, @as(f64, @floatFromInt(pass_ns)) / 1e6 / @as(f64, @floatFromInt(n_anc)), @as(f64, @floatFromInt(absorb_ns)) / 1e6,
+    });
+}
diff --git a/zig/tests/cuda/mm3_dspark_speed.zig b/zig/tests/cuda/mm3_dspark_speed.zig
new file mode 100644
index 0000000000000000000000000000000000000000..41d1c977d7a04b38467a07f189a32afbb546ebdb
--- /dev/null
+++ b/zig/tests/cuda/mm3_dspark_speed.zig
@@ -0,0 +1,122 @@
+//! tf-cuda-test mm3-dspark-speed: the real dspark pass with each speed switch against the plain pass, per stream.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const real = @import("mm3_dspark_real.zig");
+
+const dc = mm.dspark_config;
+const dd = mm.dspark_device;
+const batch = dd.batch;
+const ops = mm.engine_ops;
+
+pub const usage = "  mm3-dspark-speed PACK DSPARK OFFSET ROUNDS ROW_DIR...  plain vs batched / top-C slices / attention split\n";
+
+/// One stream: its captured taps on the device, its tokens and anchors, how far its ring has absorbed.
+const Stream = struct { taps: cuda.DeviceBuffer, n: u32, ids: []align(1) const i32, anchors: []align(1) const i32, next: u32 = 0 };
+
+/// A variant of the pass: switches and whether the streams go as one batch.
+const Variant = struct { name: []const u8, batch: bool, topc: bool, attn: bool };
+
+const variants = [_]Variant{
+    .{ .name = "plain", .batch = false, .topc = false, .attn = false },
+    .{ .name = "topc", .batch = false, .topc = true, .attn = false },
+    .{ .name = "attn", .batch = false, .topc = false, .attn = true },
+    .{ .name = "single+all", .batch = false, .topc = true, .attn = true },
+    .{ .name = "batch", .batch = true, .topc = false, .attn = false },
+    .{ .name = "batch+all", .batch = true, .topc = true, .attn = true },
+};
+
+/// Positions the stream's ring must hold before round j: its anchor plus OFFSET; tap rows repeat past the capture.
+fn absorbTo(ifc: ops.Draft, slot: u32, s: *Stream, p: u32) !void {
+    while (s.next < p) {
+        const row = s.next % s.n;
+        const rows = @min(p - s.next, mm.iface.prefill_rows, s.n - row);
+        try ifc.absorb(slot, s.next, rows, s.taps.ptr, row);
+        s.next += rows;
+    }
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len < 5) {
+        std.debug.print("{s}", .{usage});
+        return error.Usage;
+    }
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const io = gpu.io;
+    const pack, const draft_dir = .{ rest[0], rest[1] };
+    const offset = try std.fmt.parseInt(u32, rest[2], 10);
+    const rounds_max = try std.fmt.parseInt(usize, rest[3], 10);
+    const dirs = rest[4..];
+    if (dirs.len > batch.max_streams) return error.TooManyStreams;
+    const c = try mm.config.parse(a, try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ pack, "config.json" }), a, .limited(1 << 24)));
+    const cfg = try dc.parse(a, try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ draft_dir, "config.json" }), a, .limited(1 << 24)));
+
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var modules = try mm.forward.Modules.load(gpu.d);
+    defer modules.deinit();
+    const share = try mm.shard.Share.of(&c, 0, 1);
+    var loaded = try mm.weights_device.loadLayers(gpu.gpa, io, gpu.d, stream, pack, &c, share, &.{0});
+    defer loaded.deinit();
+    const g = try mm.forward.Geometry.of(&c, share, 1, mm.iface.max_rows);
+    const dev = try dd.Device.open(gpu.gpa, io, gpu.d, gpu.ctx, stream, draft_dir, cfg, share, &modules, &loaded.weights, &g, null);
+    var ifc = dev.interface();
+    defer ifc.vtable.deinit(dev);
+    const ns: u32 = @intCast(dirs.len);
+    try ifc.attach(ns);
+    try dev.reserve(ns * dd.max_block);
+    if (dev.topc == null) dev.topc = try cuda.minimax_m3_dspark_topc.TopC.load(gpu.d);
+
+    const streams = try a.alloc(Stream, ns);
+    var rounds = rounds_max;
+    for (streams, dirs) |*s, dir| {
+        const taps = try real.readNpy(a, io, dir, "out.npy", "<u2");
+        const ids = try real.readNpy(a, io, dir, "ids.npy", "<i4");
+        const anchors = try real.readNpy(a, io, dir, "anchors.npy", "<i4");
+        s.* = .{ .taps = try cuda.DeviceBuffer.fromHost(gpu.d, taps.data), .n = @intCast(taps.shape[0]), .ids = std.mem.bytesAsSlice(i32, ids.data), .anchors = std.mem.bytesAsSlice(i32, anchors.data) };
+        rounds = @min(rounds, s.anchors.len);
+    }
+    defer for (streams) |*s| s.taps.free();
+
+    var ns_total: [variants.len]u64 = @splat(0);
+    var differ: [variants.len]usize = @splat(0);
+    var want: [batch.max_streams]ops.DraftResult = undefined;
+    var reqs: [batch.max_streams]ops.DraftPass = undefined;
+    for (0..rounds) |j| {
+        for (streams, 0..) |*s, i| {
+            const anchor: u32 = @intCast(s.anchors[j]);
+            const p = anchor + offset;
+            if (p < s.next) return error.AnchorsNotAscending;
+            try absorbTo(ifc, @intCast(i), s, p);
+            reqs[i] = .{ .slot = @intCast(i), .anchor = @intCast(s.ids[anchor]), .pos = p };
+        }
+        try stream.synchronize();
+        for (variants, 0..) |v, vi| {
+            dev.knobs = .{ .batch = v.batch, .topc = v.topc, .attn = v.attn };
+            const saved = dev.topc;
+            if (!v.topc) dev.topc = null;
+            defer dev.topc = saved;
+            const t0 = check.now(io);
+            if (v.batch) try ifc.passMany(reqs[0..ns]) else for (reqs[0..ns]) |r| try ifc.pass(r);
+            var got: [batch.max_streams]ops.DraftResult = undefined;
+            for (0..ns) |i| try ifc.result(@intCast(i), &got[i]);
+            ns_total[vi] += @intCast(check.now(io) - t0);
+            for (0..ns) |i| {
+                if (vi == 0) want[i] = got[i] else if (!std.mem.eql(u8, std.mem.asBytes(&want[i]), std.mem.asBytes(&got[i]))) differ[vi] += 1;
+            }
+        }
+    }
+    const per = @as(f64, @floatFromInt(rounds));
+    const base = @as(f64, @floatFromInt(ns_total[0])) / 1e6 / per;
+    var bad: usize = 0;
+    for (variants, ns_total, differ) |v, t, d| {
+        const ms = @as(f64, @floatFromInt(t)) / 1e6 / per;
+        std.debug.print("SPEED {s}: {d} streams, offset {d}: {d:.3} ms a round ({d:.3} a stream), {d:.1}% of plain; {d} of {d} stream results differ\n", .{ v.name, ns, offset, ms, ms / @as(f64, @floatFromInt(ns)), 100 * ms / base, d, rounds * ns });
+        bad += d;
+    }
+    if (bad != 0) return error.DraftsDiffer;
+    check.pass("mm3-dspark-speed: {d} streams x {d} rounds at offset {d}: every variant's drafts and confidences equal the plain pass", .{ ns, rounds, offset });
+}
diff --git a/zig/tests/cuda/mm3_exchange_bench.zig b/zig/tests/cuda/mm3_exchange_bench.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4184a4d2f33e6cab937394679e3f405a6752375a
--- /dev/null
+++ b/zig/tests/cuda/mm3_exchange_bench.zig
@@ -0,0 +1,182 @@
+//! tf-cuda-test mm3-exchange: MiniMax's TP2 layer sums (exchange.Sum) bit-equal to the host's rank-order sum, timed.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const Gpu = check.Gpu;
+
+const xc = mm.exchange;
+const width = 6144;
+const max_rows = 2048;
+const window = 128; // tp.formFor: gather_sum up to here, the share form past it
+const rows_cases = [_]usize{ 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2047, 2048 };
+
+/// One way a sum crosses: the toggles and whether RoCE may carry it (false: NCCL alone, as TF_ROCE=0).
+const Variant = struct { name: []const u8, t: xc.Toggles, roce: bool };
+const variants = [_]Variant{
+    .{ .name = "nccl", .t = .{ .fused = false, .inplace = false }, .roce = false },
+    .{ .name = "roce", .t = .{ .fused = false, .inplace = false }, .roce = true },
+    .{ .name = "fused", .t = .{ .fused = true, .inplace = false }, .roce = true },
+    .{ .name = "inplace", .t = .{ .fused = false, .inplace = true }, .roce = true },
+    .{ .name = "nccl-inplace", .t = .{ .fused = false, .inplace = true }, .roce = false },
+};
+
+/// Rank `rank`'s partial for a case: magnitudes from 1e-3 to 1e6, so the order of an add shows in the bits.
+fn partial(out: []f32, seed: u64, rank: usize) void {
+    var rng = std.Random.DefaultPrng.init(seed *% 1000003 +% rank *% 7919 +% out.len);
+    const r = rng.random();
+    for (out) |*x| x.* = r.floatNorm(f32) * std.math.pow(f32, 10, @floatFromInt(r.intRangeAtMost(i32, -3, 6)));
+}
+
+const Bench = struct {
+    gpu: Gpu,
+    g: *cuda.tp_group.Group,
+    k: cuda.rank_scatter.RankScatter,
+    s: cuda.Stream,
+    rank: usize,
+    src: cuda.DeviceBuffer,
+    dst: cuda.DeviceBuffer,
+    sc: [4]cuda.DeviceBuffer,
+    fast: ?*cuda.roce.Gather,
+
+    fn sum(b: *Bench, v: Variant, rows: usize) !void {
+        b.g.fast = if (v.roce) b.fast else null; // both ranks run the same variant, so both take the same path
+        defer b.g.fast = b.fast;
+        const x: xc.Sum = .{
+            .d = b.gpu.d,
+            .st = b.s,
+            .link = .{ .group = b.g, .lib = &b.g.lib, .comm = b.g.comm },
+            .k = &b.k,
+            .world = 2,
+            .rank = b.rank,
+            .width = width,
+            .sc = .{ .gathered = b.sc[0].ptr, .scatter = b.sc[1].ptr, .share = b.sc[2].ptr, .shares = b.sc[3].ptr },
+            .t = v.t,
+        };
+        try x.run(if (rows <= window) .gather_sum else .scatter_gather, b.src.ptr, b.dst.ptr, rows);
+    }
+};
+
+pub fn run(gpu: Gpu, rest: []const []const u8) !void {
+    const a = gpu.gpa;
+    try check.expect(rest.len >= 1, "mm3-exchange: <rank> [REPS]", .{});
+    const rank = try std.fmt.parseInt(usize, rest[0], 10);
+    const reps: usize = if (rest.len > 1) try std.fmt.parseInt(usize, rest[1], 10) else 400;
+    try check.expect(std.c.getenv("NCCL_COMM_ID") != null, "mm3-exchange: NCCL_COMM_ID names rank 0's address", .{});
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var g = try cuda.tp_group.Group.open(rank, 2);
+    defer g.close();
+    const cap_kb: usize = if (std.c.getenv("TF_ROCE_MAX_KB")) |v| try std.fmt.parseInt(usize, std.mem.span(v), 10) else 4096;
+    try g.openRoce(a, gpu.io, gpu.d, s, cap_kb << 10);
+    try check.expect(g.fast != null, "mm3-exchange: the RoCE path did not come up on both ranks", .{});
+    var b: Bench = .{ .gpu = gpu, .g = &g, .k = try cuda.rank_scatter.RankScatter.load(gpu.d), .s = s, .rank = rank, .src = undefined, .dst = undefined, .sc = undefined, .fast = g.fast };
+    defer b.k.unload();
+    const row_bytes = width * 4;
+    const share_rows = xc.shareRows(max_rows, 2);
+    b.src = try cuda.DeviceBuffer.alloc(gpu.d, max_rows * row_bytes);
+    defer b.src.free();
+    b.dst = try cuda.DeviceBuffer.alloc(gpu.d, max_rows * row_bytes);
+    defer b.dst.free();
+    const scratch = [4]usize{ 2 * window * row_bytes, 2 * share_rows * row_bytes, share_rows * row_bytes, 2 * share_rows * row_bytes };
+    for (&b.sc, scratch) |*x, n| x.* = try cuda.DeviceBuffer.alloc(gpu.d, n);
+    defer for (&b.sc) |*x| x.free();
+    std.debug.print("mm3-exchange rank {d}: cap {d} KiB, lean doorbell {}, NCCL_MIN_NCHANNELS={s} NCCL_MAX_NCHANNELS={s}\n", .{ rank, cap_kb, g.fast.?.fast, env("NCCL_MIN_NCHANNELS"), env("NCCL_MAX_NCHANNELS") });
+
+    try equal(&b, a);
+    try replays(&b, a);
+    try timing(&b, reps);
+}
+
+fn env(name: [*:0]const u8) []const u8 {
+    return if (std.c.getenv(name)) |v| std.mem.span(v) else "-";
+}
+
+/// Every variant's sum, at every row count, equals the host's (rank 0's term + rank 1's) bit for bit.
+fn equal(b: *Bench, a: std.mem.Allocator) !void {
+    const n = max_rows * width;
+    const mine = try a.alloc(f32, n);
+    defer a.free(mine);
+    const peer = try a.alloc(f32, n);
+    defer a.free(peer);
+    const want = try a.alloc(f32, n);
+    defer a.free(want);
+    const got = try a.alloc(f32, n);
+    defer a.free(got);
+    for (rows_cases) |rows| for ([_]u64{ 1, 2 }) |seed| {
+        const m = rows * width;
+        partial(mine[0..m], seed, b.rank);
+        partial(peer[0..m], seed, 1 - b.rank);
+        for (want[0..m], mine[0..m], peer[0..m]) |*w, x, y| w.* = if (b.rank == 0) x + y else y + x;
+        try b.src.upload(0, std.mem.sliceAsBytes(mine[0..m]));
+        for (variants) |v| {
+            try b.dst.upload(0, std.mem.sliceAsBytes(peer[0..m])); // stale bytes a skipped row would leave
+            try b.sum(v, rows);
+            try b.s.synchronize();
+            try b.g.check();
+            try b.dst.download(0, std.mem.sliceAsBytes(got[0..m]));
+            try check.sameBytes(v.name, std.mem.sliceAsBytes(got[0..m]), std.mem.sliceAsBytes(want[0..m]));
+        }
+    };
+    check.pass("mm3-exchange rank {d}: {d} variants x rows {any} x 2 seeds equal the host's rank-order sum, bit for bit", .{ b.rank, variants.len, rows_cases });
+}
+
+/// A captured graph of fused sums (a decode step's form) replayed with new partials: each replay's sums are its own.
+fn replays(b: *Bench, a: std.mem.Allocator) !void {
+    const rows = 4;
+    const sums = 4;
+    const m = rows * width;
+    const v = variants[2];
+    b.g.fast = b.fast;
+    try cuda.graph.beginCapture(b.s, .thread_local);
+    const x: xc.Sum = .{ .d = b.gpu.d, .st = b.s, .link = .{ .group = b.g, .lib = &b.g.lib, .comm = b.g.comm }, .k = &b.k, .world = 2, .rank = b.rank, .width = width, .sc = .{ .gathered = b.sc[0].ptr, .scatter = b.sc[1].ptr, .share = b.sc[2].ptr, .shares = b.sc[3].ptr }, .t = v.t };
+    for (0..sums) |i| try x.run(.gather_sum, b.src.ptr + i * m * 4, b.dst.ptr + i * m * 4, rows);
+    var captured = try cuda.graph.endCapture(b.s);
+    defer captured.deinit();
+    var exec = try captured.instantiate();
+    defer exec.deinit();
+    const mine = try a.alloc(f32, sums * m);
+    defer a.free(mine);
+    const peer = try a.alloc(f32, sums * m);
+    defer a.free(peer);
+    const want = try a.alloc(f32, sums * m);
+    defer a.free(want);
+    const got = try a.alloc(f32, sums * m);
+    defer a.free(got);
+    for (0..32) |r| {
+        partial(mine, 100 + r, b.rank);
+        partial(peer, 100 + r, 1 - b.rank);
+        for (want, mine, peer) |*w, p, q| w.* = if (b.rank == 0) p + q else q + p;
+        try b.src.upload(0, std.mem.sliceAsBytes(mine));
+        try exec.launchOn(b.s);
+        try b.s.synchronize();
+        try b.g.check();
+        try b.dst.download(0, std.mem.sliceAsBytes(got));
+        try check.sameBytes("a replayed graph's fused sums", std.mem.sliceAsBytes(got), std.mem.sliceAsBytes(want));
+    }
+    check.pass("mm3-exchange rank {d}: a graph of {d} fused {d}-row sums replayed 32 times, each replay's sums its own", .{ b.rank, sums, rows });
+}
+
+/// Median of 5 rounds of microseconds a sum, back to back, for each variant and row count.
+fn timing(b: *Bench, reps: usize) !void {
+    var t0 = try cuda.Event.init(b.gpu.d, true);
+    defer t0.deinit();
+    var t1 = try cuda.Event.init(b.gpu.d, true);
+    defer t1.deinit();
+    for (rows_cases) |rows| for (variants) |v| {
+        if (rows <= window and v.t.inplace) continue; // the share form's toggle: no change to a window's sum
+        if (rows > window and v.t.fused) continue;
+        const n = @max(4, if (rows <= window) reps else reps * 8 / rows);
+        var us: [6]f64 = undefined;
+        for (&us) |*u| {
+            try t0.record(b.s);
+            for (0..n) |_| try b.sum(v, rows);
+            try t1.record(b.s);
+            try t1.synchronize();
+            u.* = @as(f64, try cuda.Event.elapsedMs(t0, t1)) * 1000.0 / @as(f64, @floatFromInt(n));
+        }
+        try b.g.check();
+        const med = check.median(us[1..]); // the first round warms
+        std.debug.print("RESULT mm3-exchange rank={d} rows={d} variant={s} us={d:.2} calls={d}\n", .{ b.rank, rows, v.name, med, n });
+    };
+}
diff --git a/zig/tests/cuda/mm3_gemv_bench.zig b/zig/tests/cuda/mm3_gemv_bench.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ac9c7fb7a8989e9c591f3aaf778484296b4fd9de
--- /dev/null
+++ b/zig/tests/cuda/mm3_gemv_bench.zig
@@ -0,0 +1,371 @@
+//! tf-cuda-test mm3-gemv-bench: TP2 rank 0's decode ops on real pack layers, one launch a linear vs fused, timed.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+
+const fw = mm.forward;
+const plan = mm.forward_plan;
+const Op = plan.Op;
+const Buf = plan.Buf;
+const rk = cuda.minimax_m3_rows;
+const Device = @FieldType(fw.Forward, "dev");
+
+pub const usage = "  mm3-gemv-bench PACK [REPS] [LAYER...]  TP2 rank 0's decode ops on real layers: fused linears equal, timed\n";
+
+const max_ops = 160;
+const check_rows = [_]u32{ 1, 4, 16, 64 };
+const sweep_rows = [_]u32{ 1, 4, 16, 64, 128, 256, 512, 2048 };
+
+/// The ops of one layer's decode rows in launch order; `fused` takes q | k | v and gate | up as one op each.
+fn layerOps(g: *const plan.Geometry, l: u32, n: u32, fused: bool, out: *std.ArrayList(Op), a: std.mem.Allocator) !void {
+    const moe = g.isMoe(l);
+    const gate: plan.Lin = if (moe) .shared_gate else .dense_gate;
+    const up: plan.Lin = if (moe) .shared_up else .dense_up;
+    const down: plan.Lin = if (moe) .shared_down else .dense_down;
+    const ax: plan.Ref = .{ .buf = .a };
+    if (fused) {
+        try out.append(a, .{ .linears = .{ .ws = .{ .q, .k, .v }, .ys = .{ .q, .k, .v }, .n = 3, .layer = l, .rows = n } });
+    } else for ([_]plan.Lin{ .q, .k, .v }, [_]Buf{ .q, .k, .v }) |w, y| {
+        try out.append(a, .{ .linear = .{ .w = w, .layer = l, .x = ax, .y = .{ .buf = y }, .rows = n, .prompt = false } });
+    }
+    try out.append(a, .{ .index_proj = .{ .layer = l, .rows = n } });
+    try out.append(a, .{ .linear = .{ .w = .o, .layer = l, .x = .{ .buf = .attn }, .y = .{ .buf = .part }, .rows = n, .prompt = false } });
+    if (moe) {
+        try out.append(a, .{ .router = .{ .layer = l, .rows = n } });
+        try out.append(a, .{ .route = .{ .layer = l, .rows = n } });
+        try out.append(a, .{ .experts = .{ .layer = l, .row0 = 0, .rows = n } });
+    }
+    if (fused) {
+        try out.append(a, .{ .linears = .{ .ws = .{ gate, up, undefined }, .ys = .{ .gate, .up, undefined }, .n = 2, .layer = l, .rows = n } });
+    } else for ([_]plan.Lin{ gate, up }, [_]Buf{ .gate, .up }) |w, y| {
+        try out.append(a, .{ .linear = .{ .w = w, .layer = l, .x = ax, .y = .{ .buf = y }, .rows = n, .prompt = false } });
+    }
+    const width = if (moe) g.shared_w else g.dense_w;
+    if (fused) return out.append(a, .{ .down = .{ .layer = l, .shared = moe, .n = width, .rows = n, .y = .part, .add = if (moe) .routed else null } });
+    try out.append(a, .{ .swiglu = .{ .layer = l, .shared = moe, .n = width, .rows = n } });
+    try out.append(a, .{ .linear = .{ .w = down, .layer = l, .x = .{ .buf = .act }, .y = .{ .buf = if (moe) .shr else .part }, .rows = n, .prompt = false } });
+    if (moe) try out.append(a, .{ .add2 = .{ .a = .routed, .b = .shr, .out = .part, .rows = n } });
+}
+
+fn fillF32(a: std.mem.Allocator, f: *fw.Forward, buf: Buf, rows: usize, seed: u64) !void {
+    const host = try a.alloc(f32, f.dev.g.rowBytes(buf) * rows / 4);
+    var prng = std.Random.DefaultPrng.init(seed);
+    for (host) |*v| v.* = (prng.random().float(f32) - 0.5) * 8;
+    try f.dev.b.mem[@backingInt(buf)].upload(0, std.mem.sliceAsBytes(host));
+}
+
+/// Each down op (every glue switch) against the activation, down and add launched one by one: `part` byte for byte.
+fn glueEqual(a: std.mem.Allocator, f: *fw.Forward, layers: []const u16) !usize {
+    var compared: usize = 0;
+    for (check_rows) |n| for (layers) |l| {
+        const moe = f.dev.g.isMoe(l);
+        try fill(a, f, .gate, n, 0x676c75 + @as(u64, l) * 7 + n);
+        try fill(a, f, .up, n, 0x757070 + @as(u64, l) * 7 + n);
+        try fillF32(a, f, .routed, n, 0x726f75 + @as(u64, l) * 7 + n);
+        var old: std.ArrayList(Op) = .empty;
+        var new: std.ArrayList(Op) = .empty;
+        try layerOps(f.dev.g, l, n, false, &old, a);
+        try layerOps(f.dev.g, l, n, true, &new, a);
+        const tail: usize = if (moe) 3 else 2; // swiglu, down (, add2) close the old list; the down op the new one
+        try f.dev.b.mem[@backingInt(Buf.part)].fill8(0, null);
+        for (old.items[old.items.len - tail ..]) |op| try f.dev.emit(op);
+        const want = try download(a, f, .part, n);
+        for ([_][2]bool{ .{ true, true }, .{ true, false }, .{ false, true }, .{ false, false } }) |sw| {
+            f.dev.glue_act = sw[0];
+            f.dev.glue_add = sw[1];
+            try f.dev.b.mem[@backingInt(Buf.part)].fill8(0xa5, null);
+            try f.dev.emit(new.items[new.items.len - 1]);
+            const got = try download(a, f, .part, n);
+            const same = std.mem.eql(u8, want, got);
+            if (!same) std.debug.print("FAIL mm3-gemv-bench glue layer {d} rows {d} act={} add={}: down differs\n", .{ l, n, sw[0], sw[1] });
+            try check.expect(same, "mm3-gemv-bench: glue down bytes", .{});
+            compared += 1;
+        }
+    };
+    f.dev.glue_act = true;
+    f.dev.glue_add = true;
+    return compared;
+}
+
+/// Weight bytes an op reads (0: not a weight-bound op this bench rates).
+fn weightBytes(dv: *const Device, op: Op) usize {
+    const g = dv.g;
+    const one = struct {
+        fn of(w: cuda.exl3.Weight) usize {
+            return (w.k / 16) * (w.n / 16) * w.halves * 16 + 2 * (w.k + w.n);
+        }
+    };
+    const l = switch (op) {
+        inline .linear, .linears, .index_proj, .router => |o| o.layer,
+        else => return 0,
+    };
+    const ly = &dv.w.layers[l];
+    return switch (op) {
+        .linear => |o| one.of(lin(ly, o.w)),
+        .linears => |o| blk: {
+            var t: usize = 0;
+            for (o.ws[0..o.n]) |w| t += one.of(lin(ly, w));
+            break :blk t;
+        },
+        .index_proj => (g.iq_w + g.ik_w) * g.hidden * 2,
+        .router => g.experts * g.hidden * 4,
+        else => 0,
+    };
+}
+
+fn lin(ly: *const mm.weights.Layer, w: plan.Lin) cuda.exl3.Weight {
+    return switch (w) {
+        .q => ly.q,
+        .k => ly.k,
+        .v => ly.v,
+        .o => ly.o,
+        .dense_gate => ly.ffn.dense.gate,
+        .dense_up => ly.ffn.dense.up,
+        .dense_down => ly.ffn.dense.down,
+        .shared_gate => ly.ffn.moe.shared.gate,
+        .shared_up => ly.ffn.moe.shared.up,
+        .shared_down => ly.ffn.moe.shared.down,
+        .head => unreachable,
+    };
+}
+
+fn fill(a: std.mem.Allocator, f: *fw.Forward, buf: Buf, rows: usize, seed: u64) !void {
+    const bytes = f.dev.g.rowBytes(buf) * rows;
+    const host = try a.alloc(u16, bytes / 2);
+    var prng = std.Random.DefaultPrng.init(seed);
+    for (host) |*v| {
+        const x: f32 = (prng.random().float(f32) - 0.5) * 4;
+        v.* = @truncate(@as(u32, @bitCast(x)) >> 16);
+    }
+    try f.dev.b.mem[@backingInt(buf)].upload(0, std.mem.sliceAsBytes(host));
+}
+
+fn download(a: std.mem.Allocator, f: *fw.Forward, buf: Buf, rows: usize) ![]u8 {
+    try f.dev.st.synchronize();
+    const out = try a.alloc(u8, f.dev.g.rowBytes(buf) * rows);
+    try f.dev.b.mem[@backingInt(buf)].download(0, out);
+    return out;
+}
+
+/// Each fused op's outputs against its linears one launch each, byte for byte, at every decode width.
+fn equal(a: std.mem.Allocator, f: *fw.Forward, layers: []const u16) !usize {
+    var compared: usize = 0;
+    for (check_rows) |n| for (layers) |l| {
+        try fill(a, f, .a, n, 0x6d6d33 + @as(u64, l) * 131 + n);
+        const groups = [_][]const Buf{ &.{ .q, .k, .v }, &.{ .gate, .up } };
+        for (groups) |ys| {
+            var old: std.ArrayList(Op) = .empty;
+            var new: std.ArrayList(Op) = .empty;
+            try layerOps(f.dev.g, l, n, false, &old, a);
+            try layerOps(f.dev.g, l, n, true, &new, a);
+            var want: [3][]u8 = undefined;
+            for (ys) |y| try f.dev.b.mem[@backingInt(y)].fill8(0, null);
+            for (old.items) |op| if (writes(op, ys[0])) try f.dev.emit(op);
+            for (ys, 0..) |y, i| want[i] = try download(a, f, y, n);
+            for (ys) |y| try f.dev.b.mem[@backingInt(y)].fill8(0xa5, null);
+            for (new.items) |op| if (writes(op, ys[0])) try f.dev.emit(op);
+            for (ys, 0..) |y, i| {
+                const got = try download(a, f, y, n);
+                // the part's own rows (n columns a row); a wider buffer's tail is not the part's
+                const moe = f.dev.g.isMoe(l);
+                const w: plan.Lin = switch (y) {
+                    .q => .q,
+                    .k => .k,
+                    .v => .v,
+                    .gate => if (moe) .shared_gate else .dense_gate,
+                    else => if (moe) .shared_up else .dense_up,
+                };
+                const bytes = @as(usize, n) * lin(&f.dev.w.layers[l], w).n * 2;
+                const same = std.mem.eql(u8, want[i][0..bytes], got[0..bytes]);
+                if (!same) std.debug.print("FAIL mm3-gemv-bench layer {d} rows {d}: fused {t} differs from its own launch\n", .{ l, n, y });
+                try check.expect(same, "mm3-gemv-bench: fused {t} bytes", .{y});
+                compared += 1;
+            }
+        }
+    };
+    return compared;
+}
+
+/// Digests of the router's logits and the index projections on fixed rows: equal across builds means equal bits.
+fn digests(a: std.mem.Allocator, f: *fw.Forward, layers: []const u16) ![2]u64 {
+    var router = std.hash.Wyhash.init(0);
+    var index = std.hash.Wyhash.init(0);
+    for (check_rows) |n| for (layers) |l| {
+        try fill(a, f, .a, n, 0x646967 + @as(u64, l) * 131 + n);
+        try f.dev.emit(.{ .index_proj = .{ .layer = l, .rows = n } });
+        index.update(try download(a, f, .iq_raw, n));
+        index.update(try download(a, f, .ik_raw, n));
+        if (!f.dev.g.isMoe(l)) continue;
+        try f.dev.emit(.{ .router = .{ .layer = l, .rows = n } });
+        router.update(try download(a, f, .logits_r, n));
+    };
+    return .{ router.final(), index.final() };
+}
+
+/// The op is the group's linear(s): it writes `first` (q of q | k | v, gate of gate | up) or one of its partners.
+fn writes(op: Op, first: Buf) bool {
+    return switch (op) {
+        .linears => |o| o.ys[0] == first,
+        .linear => |o| switch (first) {
+            .q => o.y.buf == .q or o.y.buf == .k or o.y.buf == .v,
+            .gate => o.y.buf == .gate or o.y.buf == .up,
+            else => false,
+        },
+        else => false,
+    };
+}
+
+/// The router of one MoE layer at each row count, the batched (_b) kernels and the plain ones (L2-warm: one layer).
+fn sweep(a: std.mem.Allocator, f: *fw.Forward, l: u32, reps: usize) !void {
+    const kept = f.dev.m.rows.batch_rows;
+    f.dev.m.rows.batch_rows = .{ 0, std.math.maxInt(u32) }; // the _b kernels at every row count, to find the crossover
+    for (sweep_rows) |n| {
+        try fill(a, f, .a, n, 0x737765 + n);
+        const ops = [_]Op{.{ .router = .{ .layer = l, .rows = n } }};
+        var us: [2][1]f64 = undefined;
+        for ([_]bool{ false, true }, 0..) |on, v| {
+            f.dev.m.rows.batch = on;
+            try time(a, f, &ops, reps, &us[v]);
+        }
+        std.debug.print("RESULT mm3-gemv-bench sweep layer {d} rows {d}: router plain {d:.1} us batched {d:.1} us\n", .{ l, n, us[0][0], us[1][0] });
+    }
+    f.dev.m.rows.batch = true;
+    f.dev.m.rows.batch_rows = kept;
+}
+
+const Row = struct { stage: plan.Stage, moe: bool, us: f64 = 0, n: usize = 0, bytes: usize = 0 };
+
+/// Median microseconds of each op of `ops` over `reps` runs of the whole list (eager, one event between ops).
+fn time(a: std.mem.Allocator, f: *fw.Forward, ops: []const Op, reps: usize, out: []f64) !void {
+    const d = f.dev.d;
+    var ev: [max_ops + 1]cuda.Event = undefined;
+    for (ev[0 .. ops.len + 1]) |*e| e.* = try cuda.Event.init(d, true);
+    defer for (ev[0 .. ops.len + 1]) |*e| e.deinit();
+    const per = try a.alloc(f64, ops.len * reps);
+    for (0..reps + 3) |r| {
+        try ev[0].record(f.dev.st);
+        for (ops, 0..) |op, i| {
+            try f.dev.emit(op);
+            try ev[i + 1].record(f.dev.st);
+        }
+        try f.dev.st.synchronize();
+        if (r < 3) continue; // warm-up: scratch growth, first launches, clocks
+        for (0..ops.len) |i| per[i * reps + r - 3] = @as(f64, try ev[i].elapsedMs(ev[i + 1])) * 1000;
+    }
+    for (out[0..ops.len], 0..) |*o, i| o.* = check.median(per[i * reps ..][0..reps]);
+}
+
+fn report(a: std.mem.Allocator, f: *fw.Forward, label: []const u8, ops: []const Op, us: []const f64) !f64 {
+    var rows: std.ArrayList(Row) = .empty;
+    var total: f64 = 0;
+    for (ops, us) |op, t| {
+        const st = plan.stageOf(op);
+        const moe = switch (op) {
+            inline .linear, .linears, .index_proj, .router, .route, .experts, .swiglu, .down => |o| f.dev.g.isMoe(o.layer),
+            else => false,
+        };
+        total += t;
+        const at = for (rows.items, 0..) |r, i| {
+            if (r.stage == st and r.moe == moe) break i;
+        } else blk: {
+            try rows.append(a, .{ .stage = st, .moe = moe });
+            break :blk rows.items.len - 1;
+        };
+        rows.items[at].us += t;
+        rows.items[at].n += 1;
+        rows.items[at].bytes += weightBytes(&f.dev, op);
+    }
+    for (rows.items) |r| {
+        const per = r.us / @as(f64, @floatFromInt(r.n));
+        const mb = @as(f64, @floatFromInt(r.bytes / r.n)) / 1e6;
+        const gbs = if (r.bytes > 0) mb * 1e3 / per else 0;
+        std.debug.print("RESULT mm3-gemv-bench {s} {s} {t}: {d:.1} us, {d:.2} MB, {d:.0} GB/s ({d:.0}% of 230), {d} ops\n", .{ label, if (r.moe) "moe" else "dense", r.stage, per, mb, gbs, gbs / 2.3, r.n });
+    }
+    return total;
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len < 1) {
+        std.debug.print("{s}", .{usage});
+        return error.MissingArgument;
+    }
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const io = gpu.io;
+    const dir = rest[0];
+    const reps = if (rest.len > 1) try std.fmt.parseInt(usize, rest[1], 10) else 30;
+    var ids: std.ArrayList(u16) = .empty;
+    for (rest[@min(rest.len, 2)..]) |s| try ids.append(a, try std.fmt.parseInt(u16, s, 10));
+    if (ids.items.len == 0) try ids.appendSlice(a, &.{ 1, 10, 11, 12, 13 });
+    std.mem.sort(u16, ids.items, {}, std.sort.asc(u16));
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ dir, "config.json" }), a, .limited(1 << 24));
+    const c = try mm.config.parse(a, text);
+    const share = try mm.shard.Share.of(&c, 0, 2);
+
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    const t0 = check.now(io);
+    var loaded = try mm.weights_device.loadLayers(gpu.gpa, io, gpu.d, stream, dir, &c, share, ids.items);
+    defer loaded.deinit();
+    std.debug.print("  layers {any}: {d} MiB of rank 0 of 2 in {d:.1} s\n", .{ ids.items, loaded.bytes >> 20, @as(f64, @floatFromInt(check.now(io) - t0)) / 1e9 });
+
+    const max_rows = sweep_rows[sweep_rows.len - 1];
+    const g = try plan.Geometry.of(&c, share, ids.items[ids.items.len - 1] + 1, max_rows);
+    var m = try fw.Modules.load(gpu.d);
+    defer m.deinit();
+    const max_pages = mm.iface.maxPages(max_rows);
+    var b = try fw.Buffers.init(gpu.d, &g, mm.rows_plan.Plan.fixed(g.kvh, max_pages).scratch);
+    defer b.deinit();
+    const dims = try mm.pool.Dims.of(&c, share);
+    var pool = try cuda.DeviceBuffer.alloc(gpu.d, max_pages * dims.pageBytes());
+    defer pool.free();
+    var mirror = try rk.Mirror.init(gpu.d, 1, max_pages, mm.iface.shared_rows);
+    defer mirror.deinit();
+    const pages: fw.Pages = .{ .cache = .{ .pool = pool.ptr, .page_bytes = dims.pageBytes(), .layer_off = 0, .kvh = g.kvh }, .layer_bytes = dims.layerToken() * mm.pool.page_tokens, .mirror = &mirror };
+    var f = try fw.Forward.init(gpu.gpa, gpu.d, stream, &m, &loaded.weights, &g, &b, pages, null);
+    defer f.deinit(gpu.gpa);
+    try f.dev.emit(.{ .stage = .{ .rows = 1, .shared = false } });
+    for ([_]Buf{ .a, .attn, .act }) |buf| try fill(a, &f, buf, max_rows, @as(u64, @backingInt(buf)));
+
+    const compared = try equal(a, &f, ids.items);
+    std.debug.print("RESULT mm3-gemv-bench equal: {d} fused outputs byte-equal to one launch each (rows {any}, layers {any})\n", .{ compared, check_rows, ids.items });
+    const glued = try glueEqual(a, &f, ids.items);
+    std.debug.print("RESULT mm3-gemv-bench glue: {d} down outputs (act/add folded or not) byte-equal to the separate launches\n", .{glued});
+    const dg = try digests(a, &f, ids.items);
+    std.debug.print("RESULT mm3-gemv-bench digest: router {x:0>16}, index {x:0>16} (rows {any}, layers {any})\n", .{ dg[0], dg[1], check_rows, ids.items });
+
+    for (ids.items) |l| if (g.isMoe(l)) {
+        try sweep(a, &f, l, reps);
+        break;
+    };
+    // decode windows over cold weights (each layer once a pass): one launch a linear, fused, fused + batched loads
+    const Variant = struct { name: []const u8, fused: bool, batch: bool, glue: bool };
+    const variants = [_]Variant{
+        .{ .name = "old", .fused = false, .batch = false, .glue = false },
+        .{ .name = "gemv", .fused = true, .batch = true, .glue = false },
+        .{ .name = "gemv+glue", .fused = true, .batch = true, .glue = true },
+    };
+    for ([_]u32{ 1, 4, 16 }) |n| {
+        for ([_]Buf{ .a, .attn, .act }) |buf| try fill(a, &f, buf, n, @as(u64, @backingInt(buf)) + 7);
+        var totals: [variants.len]f64 = undefined;
+        for (variants, 0..) |vr, v| {
+            f.dev.m.rows.batch = vr.batch;
+            f.dev.glue_act = vr.glue;
+            f.dev.glue_add = vr.glue;
+            var ops: std.ArrayList(Op) = .empty;
+            for (ids.items) |l| try layerOps(&g, l, n, vr.fused, &ops, a);
+            if (ops.items.len > max_ops) return error.TooManyOps;
+            const us = try a.alloc(f64, ops.items.len);
+            try time(a, &f, ops.items, reps, us);
+            const label = try std.fmt.allocPrint(a, "{s} rows={d}", .{ vr.name, n });
+            totals[v] = try report(a, &f, label, ops.items, us) / @as(f64, @floatFromInt(ids.items.len));
+        }
+        std.debug.print("RESULT mm3-gemv-bench step rows {d}: a layer old {d:.1} us, gemv {d:.1} us, gemv+glue {d:.1} us (layers {any}, median of {d})\n", .{ n, totals[0], totals[1], totals[2], ids.items, reps });
+    }
+    f.dev.m.rows.batch = true;
+    f.dev.glue_act = true;
+    f.dev.glue_add = true;
+    check.pass("mm3-gemv-bench layers {d}", .{ids.items.len});
+}
diff --git a/zig/tests/cuda/mm3_kv_bench.zig b/zig/tests/cuda/mm3_kv_bench.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f7211137b99c5a48d2eaef002e95a9b39ffd4c15
--- /dev/null
+++ b/zig/tests/cuda/mm3_kv_bench.zig
@@ -0,0 +1,201 @@
+//! mm3-kv-tier bench: decode tok/s with a long context's pages on NVMe against the same pages all resident.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const kv = @import("mm3_kv_tier.zig");
+
+const tier = mm.tier;
+const iface = mm.iface;
+const linux = std.os.linux;
+
+/// One measured context: tok/s and milliseconds a step for each pool, the tier's work a step.
+const Row = struct { ctx: usize, tier_ms: f64 = 0, resident_ms: f64 = 0, restore_s: f64 = 0, tier_host_ms: f64 = 0, slices: f64 = 0, mib: f64 = 0, hit: f64 = 0, tops: usize = 0, steps: usize = 0 };
+
+fn envInt(name: []const u8, default: u64) u64 {
+    const v = std.c.getenv(@ptrCast(name.ptr)) orelse return default;
+    return std.fmt.parseInt(u64, std.mem.span(v), 10) catch default;
+}
+
+/// Pages past the real prompt's are copies of its pages, in order and repeating, each a distinct virtual page.
+const Tiler = struct {
+    r: *kv.Rig,
+    base: usize, // real pages
+    host: []align(4096) u8, // the real pages' file bytes, every layer of a page together
+    summ: []u8, // summaries of every virtual page, built on the host
+
+    fn init(r: *kv.Rig, t: *tier.Tier, base: usize) !Tiler {
+        const page = t.store.stride * t.c.layers;
+        const host = try std.heap.page_allocator.alignedAlloc(u8, .fromByteUnits(4096), base * page);
+        for (0..base) |b| try mm.tier_io.preadAll(t.store.fd, host[b * page ..][0..page], t.store.offset(@intCast(b), 0));
+        const sb = t.c.layers * cuda.minimax_m3_tier.summ_bytes;
+        const summ = try std.heap.page_allocator.alloc(u8, t.c.vpages * sb);
+        try t.st.synchronize();
+        try t.summ.download(0, summ[0 .. base * sb]);
+        return .{ .r = r, .base = base, .host = host, .summ = summ };
+    }
+
+    fn deinit(x: *Tiler) void {
+        std.heap.page_allocator.free(x.host);
+        std.heap.page_allocator.free(x.summ);
+    }
+
+    /// Stream `s`'s pages [from, to) as copies; returns the bytes written.
+    fn fill(x: *Tiler, t: *tier.Tier, s: u32, from: usize, to: usize) !u64 {
+        const page = t.store.stride * t.c.layers;
+        const sb = t.c.layers * cuda.minimax_m3_tier.summ_bytes;
+        var bytes: u64 = 0;
+        for (from..to) |b| {
+            const vp: u32 = @intCast(s * x.r.max_pages + b);
+            if (s == 0 and b < x.base) continue;
+            const src = b % x.base;
+            try mm.tier_io.pwriteAll(t.store.fd, x.host[src * page ..][0..page], t.store.offset(vp, 0));
+            @memcpy(x.summ[vp * sb ..][0..sb], x.summ[src * sb ..][0..sb]);
+            t.final.set(vp);
+            bytes += page;
+        }
+        return bytes;
+    }
+
+    fn upload(x: *Tiler, t: *tier.Tier) !void {
+        try t.summ.upload(0, x.summ[0..t.summ.len]);
+    }
+};
+
+/// The resident pool's pages [from, to) of stream `s` as copies of stream 0's real pages.
+fn tileArena(r: *kv.Rig, arena: cuda.DeviceBuffer, base: usize, s: u32, from: usize, to: usize) !void {
+    const pb = r.dims.pageBytes();
+    for (from..to) |b| {
+        if (s == 0 and b < base) continue;
+        const dst = arena.ptr + (s * r.max_pages + b) * pb;
+        try r.gpu.d.check(r.gpu.d.api.cuMemcpyDtoD_v2(dst, arena.ptr + (b % base) * pb, pb), "cuMemcpyDtoD");
+    }
+}
+
+/// `steps` decode steps of `streams` streams at `ctx`; milliseconds a step and every step's logits rows.
+fn decodeAt(rn: *kv.Run, ids: []const i32, ctx: usize, streams: u32, steps: usize, keep: [][]f32) !f64 {
+    var segs: [iface.max_shared]iface.Seg = undefined;
+    var pos: [iface.max_shared]i32 = undefined;
+    var tok: [iface.max_shared]i32 = undefined;
+    const io = rn.r.gpu.io;
+    const t0 = check.now(io);
+    for (0..steps) |k| {
+        for (0..streams) |s| {
+            segs[s] = .{ .slot = @intCast(s), .row0 = @intCast(s), .rows = 1 };
+            pos[s] = @intCast(ctx + k);
+            tok[s] = ids[(ctx + k + s * 977) % ids.len];
+        }
+        const out = if (streams == 1) try rn.decode(0, @intCast(ctx + k), tok[0]) else try rn.shared(segs[0..streams], tok[0..streams], pos[0..streams]);
+        if (keep[k].len > 0) rn.r.gpu.gpa.free(keep[k]);
+        keep[k] = out;
+    }
+    return kv.secs(io, t0) * 1e3 / @as(f64, @floatFromInt(steps));
+}
+
+pub fn run(gpu: check.Gpu, a: std.mem.Allocator, pack: []const u8, layers: u32, dir: []const u8, rest: []const [:0]const u8) !void {
+    const base_tokens = try std.fmt.parseInt(usize, rest[1], 10);
+    var ctxs: std.ArrayList(usize) = .empty;
+    var it = std.mem.splitScalar(u8, rest[2], ',');
+    while (it.next()) |c| try ctxs.append(a, try std.fmt.parseInt(usize, c, 10));
+    const streams = try std.fmt.parseInt(u32, rest[3], 10);
+    const steps = try std.fmt.parseInt(usize, rest[4], 10);
+    const top = std.mem.max(usize, ctxs.items);
+    if (base_tokens % 128 != 0 or streams == 0 or streams > iface.max_shared) return error.BadOptions;
+    for (ctxs.items) |c| if (c % 128 != 0 or c < base_tokens) return error.BadOptions;
+    var r: kv.Rig = undefined;
+    try r.init(gpu, a, pack, layers, rest[0], dir, top + steps + 256);
+    defer r.deinit();
+    const horizon: u32 = @intCast(envInt("TF_MM3_BENCH_HORIZON", 256));
+    const m: u32 = @intCast(envInt("TF_MM3_BENCH_M", 16));
+    const cfg0 = r.tierCfg(streams, horizon, m, 1, "");
+    const slices: u32 = @intCast((envInt("TF_MM3_BENCH_CACHE_MIB", 4096) << 20) / cfg0.sliceBytes());
+    const rows = try a.alloc(Row, ctxs.items.len);
+    const keep_t = try a.alloc([][]f32, ctxs.items.len);
+    for (rows, ctxs.items, keep_t) |*row, c, *k| {
+        row.* = .{ .ctx = c, .steps = steps };
+        k.* = try a.alloc([]f32, steps);
+        @memset(k.*, &.{});
+    }
+    std.debug.print("  tier: horizon {d} blocks, m {d}, {d} cache slices ({d} MiB), {d} streams\n", .{ horizon, m, slices, (@as(u64, slices) * cfg0.sliceBytes()) >> 20, streams });
+    {
+        const path = try std.fmt.allocPrintSentinel(a, "{s}/bench.pages", .{dir}, 0);
+        const t = try tier.Tier.init(gpu.gpa, gpu.d, r.st, r.tierCfg(streams, horizon, m, slices, path), 0);
+        defer t.deinit();
+        const run_ = try kv.Run.init(&r, streams, 0, t);
+        defer run_.deinit();
+        t.vtab = run_.mirror.tables.ptr;
+        for (0..streams) |s| try run_.table(@intCast(s), @intCast(s * r.max_pages));
+        const t0 = check.now(gpu.io);
+        gpu.gpa.free(try run_.prefill(0, r.ids[0..base_tokens]));
+        std.debug.print("  base: {d} real tokens prefilled through the tier in {d:.1} s\n", .{ base_tokens, kv.secs(gpu.io, t0) });
+        var tl = try Tiler.init(&r, t, base_tokens / 128);
+        defer tl.deinit();
+        var tiled: [iface.max_shared]usize = @splat(0);
+        tiled[0] = base_tokens / 128;
+        for (rows, keep_t) |*row, keep| {
+            const t1 = check.now(gpu.io);
+            var bytes: u64 = 0;
+            for (0..streams) |s| {
+                bytes += try tl.fill(t, @intCast(s), tiled[s], row.ctx / 128);
+                tiled[s] = row.ctx / 128;
+            }
+            try tl.upload(t);
+            std.debug.print("  ctx {d}: {d} MiB of copied pages written in {d:.1} s\n", .{ row.ctx, bytes >> 20, kv.secs(gpu.io, t1) });
+            for (0..streams) |s| try run_.table(@intCast(s), @intCast(s * r.max_pages));
+            const t2 = check.now(gpu.io);
+            _ = try decodeAt(run_, r.ids, row.ctx, streams, 1, keep[0..1]); // warm: the horizons' IK from NVMe
+            row.restore_s = kv.secs(gpu.io, t2);
+            const before = t.stats;
+            const io0 = t.store.stats;
+            const c0 = t.cache.stats;
+            row.tier_ms = try decodeAt(run_, r.ids, row.ctx + 1, streams, steps, keep);
+            const n: f64 = @floatFromInt(steps);
+            row.tier_host_ms = @as(f64, @floatFromInt((t.stats.cand_ns - before.cand_ns) + (t.stats.fetch_ns - before.fetch_ns))) / 1e6 / n;
+            row.slices = @as(f64, @floatFromInt(t.store.stats.reads - io0.reads)) / n;
+            row.mib = @as(f64, @floatFromInt(t.store.stats.read_bytes - io0.read_bytes)) / n / (1 << 20);
+            const hits = t.cache.stats.hits - c0.hits;
+            const miss = t.cache.stats.misses - c0.misses;
+            row.hit = @as(f64, @floatFromInt(hits)) / @as(f64, @floatFromInt(@max(1, hits + miss)));
+        }
+    }
+    try residentPass(&r, rows, keep_t, base_tokens, streams, steps);
+    defer for (keep_t) |k| for (k) |x| if (x.len > 0) gpu.gpa.free(x);
+    std.debug.print("\n  | ctx | streams | tier ms/step | tier tok/s | resident ms/step | resident tok/s | tier host ms | slices read/step | MiB/step | hit rate | horizon restore s | same argmax |\n", .{});
+    for (rows) |row| {
+        const tok = @as(f64, @floatFromInt(streams)) * 1e3;
+        std.debug.print("  | {d} | {d} | {d:.2} | {d:.2} | {d:.2} | {d:.2} | {d:.2} | {d:.0} | {d:.1} | {d:.3} | {d:.2} | {d}/{d} |\n", .{ row.ctx, streams, row.tier_ms, tok / row.tier_ms, row.resident_ms, if (row.resident_ms > 0) tok / row.resident_ms else 0, row.tier_host_ms, row.slices, row.mib, row.hit, row.restore_s, row.tops, row.steps * streams });
+    }
+    check.pass("mm3-kv-tier bench {d} layers {d} streams", .{ layers, streams });
+}
+
+/// The same pages all resident (when they fit): milliseconds a step and the argmax agreement with the tier's rows.
+fn residentPass(r: *kv.Rig, rows: []Row, keep_t: []const [][]f32, base_tokens: usize, streams: u32, steps: usize) !void {
+    const gpa = r.gpu.gpa;
+    const pb = r.dims.pageBytes();
+    var arena = cuda.DeviceBuffer.alloc(r.gpu.d, streams * r.max_pages * pb) catch {
+        std.debug.print("  resident: {d} MiB of pages do not fit; no resident row\n", .{(streams * r.max_pages * pb) >> 20});
+        return;
+    };
+    defer arena.free();
+    const run_ = try kv.Run.init(r, streams, arena.ptr, null);
+    defer run_.deinit();
+    for (0..streams) |s| try run_.table(@intCast(s), @intCast(s * r.max_pages));
+    gpa.free(try run_.prefill(0, r.ids[0..base_tokens]));
+    var tiled: [iface.max_shared]usize = @splat(0);
+    tiled[0] = base_tokens / 128;
+    const got = try r.a.alloc([]f32, steps);
+    @memset(got, &.{});
+    for (rows, keep_t) |*row, keep| {
+        for (0..streams) |s| {
+            try tileArena(r, arena, base_tokens / 128, @intCast(s), tiled[s], row.ctx / 128);
+            tiled[s] = row.ctx / 128;
+        }
+        _ = try decodeAt(run_, r.ids, row.ctx, streams, 1, got[0..1]);
+        row.resident_ms = try decodeAt(run_, r.ids, row.ctx + 1, streams, steps, got);
+        const v: usize = r.g.own_vocab;
+        for (got, keep) |x, y| for (0..streams) |s| {
+            row.tops += @intFromBool(kv.argmax(x[s * v ..][0..v]) == kv.argmax(y[s * v ..][0..v]));
+        };
+    }
+    for (got) |x| gpa.free(x);
+}
diff --git a/zig/tests/cuda/mm3_kv_quality.zig b/zig/tests/cuda/mm3_kv_quality.zig
new file mode 100644
index 0000000000000000000000000000000000000000..21a4a56d8c596517e0e64c5f1fba9af40e79b86f
--- /dev/null
+++ b/zig/tests/cuda/mm3_kv_quality.zig
@@ -0,0 +1,300 @@
+//! mm3-kv-tier quality: the tier's selections and logits against the exact resident pool's on the same real KV.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const kv = @import("mm3_kv_tier.zig");
+
+const tier = mm.tier;
+const geom = cuda.minimax_m3_sparse.geom;
+
+const Variant = struct { horizon: u32, m: u32 };
+
+/// Every decode step's selections [step][layer][kvh][16] and logits, from the tap and the head.
+const Record = struct {
+    gpa: std.mem.Allocator,
+    st: cuda.Stream,
+    layers: u32,
+    kvh: u32,
+    steps: usize,
+    sel: []i32,
+    step: usize = 0,
+    host: [64]i32 = undefined,
+
+    fn init(gpa: std.mem.Allocator, st: cuda.Stream, layers: u32, kvh: u32, steps: usize) !Record {
+        const sel = try gpa.alloc(i32, steps * layers * kvh * geom.topk);
+        @memset(sel, -1);
+        return .{ .gpa = gpa, .st = st, .layers = layers, .kvh = kvh, .steps = steps, .sel = sel };
+    }
+
+    fn deinit(r: *Record) void {
+        r.gpa.free(r.sel);
+    }
+
+    fn tap(r: *Record) mm.forward_exec.SelTap {
+        return .{ .ctx = r, .call = call };
+    }
+
+    fn call(ctx: *anyopaque, layer: u32, rows: u32, sel: u64) anyerror!void {
+        const r: *Record = @ptrCast(@alignCast(ctx));
+        if (rows != 1 or r.step >= r.steps) return;
+        const n = r.kvh * geom.topk;
+        try r.st.synchronize();
+        const src: cuda.DeviceBuffer = .{ .d = r.st.d, .ptr = sel, .len = n * 4, .borrowed = true };
+        const dst = r.sel[(r.step * r.layers + layer) * n ..][0..n];
+        try src.download(0, std.mem.sliceAsBytes(dst));
+    }
+};
+
+/// Per (step, layer, kv head): the share of the exact selection's blocks the tier selected too.
+fn recall(want: *const Record, got: *const Record) struct { mean: f64, min: f64, full: f64 } {
+    var sum: f64 = 0;
+    var least: f64 = 1;
+    var full: usize = 0;
+    var n: usize = 0;
+    const k = geom.topk;
+    var i: usize = 0;
+    while (i < want.sel.len) : (i += k) {
+        const w = want.sel[i..][0..k];
+        const g = got.sel[i..][0..k];
+        var have: usize = 0;
+        var hit: usize = 0;
+        for (w) |b| if (b >= 0) {
+            have += 1;
+            hit += @intFromBool(std.mem.indexOfScalar(i32, g, b) != null);
+        };
+        if (have == 0) continue;
+        const r = @as(f64, @floatFromInt(hit)) / @as(f64, @floatFromInt(have));
+        sum += r;
+        least = @min(least, r);
+        full += @intFromBool(hit == have);
+        n += 1;
+    }
+    const nf: f64 = @floatFromInt(@max(n, 1));
+    return .{ .mean = sum / nf, .min = least, .full = @as(f64, @floatFromInt(full)) / nf };
+}
+
+/// KL(p || q) of two logit rows, nats, in f64.
+fn kl(p: []const f32, q: []const f32) f64 {
+    const lp = logSoftmax(p);
+    const lq = logSoftmax(q);
+    var s: f64 = 0;
+    for (p, q) |a, b| {
+        const x = @as(f64, a) - lp;
+        s += @exp(x) * (x - (@as(f64, b) - lq));
+    }
+    return @max(s, 0);
+}
+
+fn logSoftmax(row: []const f32) f64 {
+    var m: f64 = -std.math.inf(f64);
+    for (row) |v| m = @max(m, v);
+    var s: f64 = 0;
+    for (row) |v| s += @exp(@as(f64, v) - m);
+    return m + @log(s);
+}
+
+/// The resident pool's first `pages` pages as the tier's file and summaries (host-computed IK min and max).
+fn export_(r: *kv.Rig, arena: cuda.DeviceBuffer, t: *tier.Tier, pages: usize, path: []const u8) !void {
+    const pb = r.dims.pageBytes();
+    const lb = r.dims.layerToken() * mm.pool.page_tokens;
+    const ik_off = (geom.Pool{ .kvh = r.g.kvh, .layers = 1, .kv8 = true }).ikInLayer();
+    const layers = r.dims.layers;
+    const page = try std.heap.page_allocator.alloc(u8, pb);
+    defer std.heap.page_allocator.free(page);
+    const slice = try std.heap.page_allocator.alignedAlloc(u8, .fromByteUnits(4096), t.store.stride);
+    defer std.heap.page_allocator.free(slice);
+    @memset(slice, 0);
+    const summ = try std.heap.page_allocator.alloc(u16, t.c.vpages * layers * 2 * geom.d);
+    defer std.heap.page_allocator.free(summ);
+    @memset(summ, 0);
+    try r.st.synchronize();
+    for (0..pages) |b| {
+        try arena.download(b * pb, page);
+        for (0..layers) |l| {
+            const src = page[l * lb ..][0..lb];
+            @memcpy(slice[0..lb], src);
+            try mm.tier_io.pwriteAll(t.store.fd, slice, t.store.offset(@intCast(b), @intCast(l)));
+            const ik = std.mem.bytesAsSlice(u16, src[ik_off..][0 .. geom.block * geom.d * 2]);
+            const out = summ[(b * layers + l) * 2 * geom.d ..][0 .. 2 * geom.d];
+            for (0..geom.d) |d| {
+                var lo: u16 = ik[d];
+                var hi: u16 = ik[d];
+                for (1..geom.block) |tk| {
+                    const v = ik[tk * geom.d + d];
+                    if (bf(v) < bf(lo)) lo = v;
+                    if (bf(v) > bf(hi)) hi = v;
+                }
+                out[d] = lo;
+                out[geom.d + d] = hi;
+            }
+        }
+        t.final.set(@intCast(b));
+    }
+    try t.summ.upload(0, std.mem.sliceAsBytes(summ));
+    try side(path, ".summ", std.mem.sliceAsBytes(summ[0 .. pages * layers * 2 * geom.d]), true);
+    try side(path, ".ok", "ok", true);
+}
+
+/// A saved prefill back: the file's slices into the resident pool's pages, its summaries into the tier.
+fn load(r: *kv.Rig, arena: cuda.DeviceBuffer, t: *tier.Tier, pages: usize, path: []const u8) !void {
+    const pb = r.dims.pageBytes();
+    const lb = r.dims.layerToken() * mm.pool.page_tokens;
+    const layers = r.dims.layers;
+    const page = try std.heap.page_allocator.alloc(u8, pb);
+    defer std.heap.page_allocator.free(page);
+    const slice = try std.heap.page_allocator.alignedAlloc(u8, .fromByteUnits(4096), t.store.stride);
+    defer std.heap.page_allocator.free(slice);
+    for (0..pages) |b| {
+        for (0..layers) |l| {
+            try mm.tier_io.preadAll(t.store.fd, slice, t.store.offset(@intCast(b), @intCast(l)));
+            @memcpy(page[l * lb ..][0..lb], slice[0..lb]);
+        }
+        try arena.upload(b * pb, page);
+        t.final.set(@intCast(b));
+    }
+    const summ = try std.heap.page_allocator.alloc(u8, pages * layers * 2 * geom.d * 2);
+    defer std.heap.page_allocator.free(summ);
+    try side(path, ".summ", summ, false);
+    try t.summ.upload(0, summ);
+}
+
+/// `path` + `ext` written whole from `data` (`write`) or read whole into it.
+fn side(path: []const u8, ext: []const u8, data: []const u8, write: bool) !void {
+    var buf: [std.fs.max_path_bytes]u8 = undefined;
+    const name = try std.fmt.bufPrintSentinel(&buf, "{s}{s}", .{ path, ext }, 0);
+    const linux = std.os.linux;
+    var flags: linux.O = .{ .ACCMODE = if (write) .WRONLY else .RDONLY, .CLOEXEC = true };
+    if (write) {
+        flags.CREAT = true;
+        flags.TRUNC = true;
+    }
+    const rc = linux.openat(linux.AT.FDCWD, name, flags, 0o644);
+    if (linux.errno(rc) != .SUCCESS) return error.SideFile;
+    const fd: linux.fd_t = @intCast(rc);
+    defer _ = linux.close(fd);
+    if (write) try mm.tier_io.pwriteAll(fd, data, 0) else try mm.tier_io.preadAll(fd, @constCast(data), 0);
+}
+
+fn exists(path: []const u8, ext: []const u8) bool {
+    var buf: [std.fs.max_path_bytes]u8 = undefined;
+    const name = std.fmt.bufPrintSentinel(&buf, "{s}{s}", .{ path, ext }, 0) catch return false;
+    return std.os.linux.errno(std.os.linux.faccessat(std.os.linux.AT.FDCWD, name, 0, 0)) == .SUCCESS;
+}
+
+fn bf(bits: u16) f32 {
+    return @bitCast(@as(u32, bits) << 16);
+}
+
+/// `steps` teacher-forced decode rows at ctx..: milliseconds a step after the first, the first's, the logits rows.
+fn decode(rn: *kv.Run, ids: []const i32, ctx: usize, steps: usize, rec: ?*Record, rows: [][]f32) !struct { ms: f64, first_ms: f64 } {
+    const io = rn.r.gpu.io;
+    rn.f.dev.sel_tap = if (rec) |x| x.tap() else null;
+    defer rn.f.dev.sel_tap = null;
+    var first: f64 = 0;
+    var t1: i96 = 0;
+    for (0..steps) |k| {
+        if (rec) |x| x.step = k;
+        const t0 = check.now(io);
+        const out = try rn.decode(0, @intCast(ctx + k), ids[ctx + k]);
+        if (k == 0) {
+            first = kv.secs(io, t0) * 1e3;
+            t1 = check.now(io);
+        }
+        if (rows[k].len > 0) rn.r.gpu.gpa.free(rows[k]);
+        rows[k] = out;
+    }
+    const rest: f64 = @floatFromInt(@max(steps, 2) - 1);
+    return .{ .ms = kv.secs(io, t1) * 1e3 / rest, .first_ms = first };
+}
+
+fn freeRows(gpa: std.mem.Allocator, rows: [][]f32) void {
+    for (rows) |*x| if (x.len > 0) {
+        gpa.free(x.*);
+        x.* = &.{};
+    };
+}
+
+/// quality IDS CTX STEPS H:M[,H:M..] [CACHE_MIB]: one exact prefill, its pages copied to NVMe, every variant's decode.
+pub fn run(gpu: check.Gpu, a: std.mem.Allocator, pack: []const u8, layers: u32, dir: []const u8, rest: []const [:0]const u8) !void {
+    const ctx = try std.fmt.parseInt(usize, rest[1], 10);
+    const steps = try std.fmt.parseInt(usize, rest[2], 10);
+    var variants: std.ArrayList(Variant) = .empty;
+    var it = std.mem.splitScalar(u8, rest[3], ',');
+    while (it.next()) |v| {
+        const c = std.mem.indexOfScalar(u8, v, ':') orelse return error.BadOptions;
+        try variants.append(a, .{ .horizon = try std.fmt.parseInt(u32, v[0..c], 10), .m = try std.fmt.parseInt(u32, v[c + 1 ..], 10) });
+    }
+    const cache_mib = if (rest.len > 4) try std.fmt.parseInt(u64, rest[4], 10) else 4096;
+    if (ctx % 128 != 0 or steps == 0) return error.BadOptions;
+    var r: kv.Rig = undefined;
+    try r.init(gpu, a, pack, layers, rest[0], dir, ctx + steps + 256);
+    defer r.deinit();
+    if (ctx + steps > r.ids.len) return error.ShortIds;
+    const gpa = gpu.gpa;
+    var arena = try cuda.DeviceBuffer.alloc(gpu.d, r.max_pages * r.dims.pageBytes());
+    defer arena.free();
+    try arena.fill8(0, null);
+    const want_rows = try a.alloc([]f32, steps);
+    @memset(want_rows, &.{});
+    defer freeRows(gpa, want_rows);
+    const got_rows = try a.alloc([]f32, steps);
+    @memset(got_rows, &.{});
+    defer freeRows(gpa, got_rows);
+    var want = try Record.init(gpa, r.st, layers, r.g.kvh, steps);
+    defer want.deinit();
+    const res = try kv.Run.init(&r, 1, arena.ptr, null);
+    defer res.deinit();
+    try res.table(0, 0);
+    const path = try std.fmt.allocPrintSentinel(a, "{s}/quality-{d}-{d}.pages", .{ dir, ctx, layers }, 0);
+    const saved = exists(path, ".ok");
+    const t0 = check.now(gpu.io);
+    if (!saved) {
+        gpa.free(try res.prefill(0, r.ids[0..ctx]));
+        std.debug.print("  resident: {d} real tokens prefilled in {d:.1} s\n", .{ ctx, kv.secs(gpu.io, t0) });
+    }
+    const cfg = r.tierCfg(1, 8, 16, 1, "");
+    const slices: u32 = @intCast((cache_mib << 20) / cfg.sliceBytes());
+    var max_h: u32 = 1;
+    var max_m: u32 = 0;
+    for (variants.items) |v| {
+        max_h = @max(max_h, v.horizon / 128);
+        max_m = @max(max_m, v.m);
+    }
+    const t = try tier.Tier.init(gpa, gpu.d, r.st, r.tierCfg(1, max_h, max_m, slices, path), 0);
+    defer t.deinit();
+    const t1 = check.now(gpu.io);
+    if (saved) try load(&r, arena, t, ctx / 128, path) else try export_(&r, arena, t, ctx / 128, path);
+    std.debug.print("  {d} pages {s} NVMe with their summaries in {d:.1} s; cache {d} slices ({d} MiB)\n", .{ ctx / 128, if (saved) "back from" else "to", kv.secs(gpu.io, t1), slices, cache_mib });
+    const base = try decode(res, r.ids, ctx, steps, &want, want_rows);
+    const base_t = try decode(res, r.ids, ctx, steps, null, want_rows);
+    std.debug.print("  resident decode: {d:.2} ms a step ({d:.2} with the selection tap)\n", .{ base_t.ms, base.ms });
+    const tr = try kv.Run.init(&r, 1, 0, t);
+    defer tr.deinit();
+    t.vtab = tr.mirror.tables.ptr;
+    std.debug.print("\n  | ctx | horizon | m | recall@16 mean | min | heads at 1.0 | KL mean | KL max | top-1 | tier ms/step | first step ms | resident ms/step | slices read/step |\n", .{});
+    for (variants.items) |v| {
+        t.c.horizon = v.horizon / 128;
+        t.c.m = v.m;
+        var got = try Record.init(gpa, r.st, layers, r.g.kvh, steps);
+        defer got.deinit();
+        try tr.table(0, 0);
+        _ = try decode(tr, r.ids, ctx, steps, &got, got_rows);
+        var ksum: f64 = 0;
+        var kmax: f64 = 0;
+        var tops: usize = 0;
+        for (want_rows, got_rows) |w, g| {
+            const d = kl(w, g);
+            ksum += d;
+            kmax = @max(kmax, d);
+            tops += @intFromBool(kv.argmax(w) == kv.argmax(g));
+        }
+        try tr.table(0, 0);
+        const r0 = t.store.stats.reads;
+        const tm = try decode(tr, r.ids, ctx, steps, null, got_rows);
+        const reads = @as(f64, @floatFromInt(t.store.stats.reads - r0)) / @as(f64, @floatFromInt(steps));
+        const rc = recall(&want, &got);
+        std.debug.print("  | {d} | {d} | {d} | {d:.4} | {d:.3} | {d:.4} | {e:.2} | {e:.2} | {d}/{d} | {d:.2} | {d:.1} | {d:.2} | {d:.0} |\n", .{ ctx, v.horizon, v.m, rc.mean, rc.min, rc.full, ksum / @as(f64, @floatFromInt(steps)), kmax, tops, steps, tm.ms, tm.first_ms, base_t.ms, reads });
+    }
+    check.pass("mm3-kv-tier quality ctx {d} layers {d}", .{ ctx, layers });
+}
diff --git a/zig/tests/cuda/mm3_kv_tier.zig b/zig/tests/cuda/mm3_kv_tier.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2d585b3ff97761236418fbebbb9a994e073bf844
--- /dev/null
+++ b/zig/tests/cuda/mm3_kv_tier.zig
@@ -0,0 +1,281 @@
+//! tf-cuda-test mm3-kv-tier: real-pack MiniMax-M3.1-Flash layers through the KV tier against the all-resident pool.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const bench = @import("mm3_kv_bench.zig");
+const quality = @import("mm3_kv_quality.zig");
+
+const fw = mm.forward;
+const plan = mm.forward_plan;
+const tier = mm.tier;
+const rk = cuda.minimax_m3_rows;
+const iface = mm.iface;
+
+pub const usage =
+    \\  mm3-kv-tier PACK LAYERS DIR eq IDS.npy CTX STEPS   tier logits equal the all-resident pool's (DIR: NVMe files)
+    \\  mm3-kv-tier PACK LAYERS DIR bench IDS.npy BASE CTX,.. STREAMS STEPS  decode tok/s with pages on NVMe
+    \\  mm3-kv-tier PACK LAYERS DIR quality IDS.npy CTX STEPS H:M,.. [CACHE_MIB]  recall@16, KL, top-1 vs the exact pool
+    \\
+;
+
+/// The weights, geometry and buffers both pools share, and the prompt's ids.
+pub const Rig = struct {
+    gpu: check.Gpu,
+    a: std.mem.Allocator,
+    c: mm.config.Config,
+    share: mm.shard.Share,
+    st: cuda.Stream,
+    loaded: mm.weights_device.Loaded,
+    g: plan.Geometry,
+    m: fw.Modules,
+    b: fw.Buffers,
+    rows: mm.rows_plan.Plan,
+    dims: mm.pool.Dims,
+    max_pages: usize,
+    ids: []const i32,
+    dir: []const u8,
+
+    /// In place: the geometry and the weights point at `r.c`.
+    pub fn init(r: *Rig, gpu: check.Gpu, a: std.mem.Allocator, pack: []const u8, layers: u32, ids_path: []const u8, dir: []const u8, capacity: usize) !void {
+        const text = try std.Io.Dir.cwd().readFileAlloc(gpu.io, try std.fs.path.join(a, &.{ pack, "config.json" }), a, .limited(1 << 24));
+        r.gpu = gpu;
+        r.a = a;
+        r.dir = dir;
+        r.c = try mm.config.parse(a, text);
+        r.share = try mm.shard.Share.of(&r.c, 0, 1);
+        r.st = try cuda.Stream.init(gpu.d, false);
+        const t0 = check.now(gpu.io);
+        r.loaded = try mm.weights_device.loadWeights(gpu.gpa, gpu.io, gpu.d, r.st, pack, &r.c, r.share, layers);
+        std.debug.print("  {d} layers and the head: {d} MiB of weights in {d:.1} s\n", .{ layers, r.loaded.bytes >> 20, secs(gpu.io, t0) });
+        r.g = try plan.Geometry.of(&r.c, r.share, layers, iface.max_rows);
+        r.m = try fw.Modules.load(gpu.d);
+        r.max_pages = iface.maxPages(capacity);
+        r.rows = mm.rows_plan.Plan.of(r.g.kvh, r.max_pages, 64);
+        r.b = try fw.Buffers.init(gpu.d, &r.g, r.rows.scratch);
+        r.dims = (try mm.pool.Dims.of(&r.c, r.share)).withKv8(true);
+        r.dims.layers = layers;
+        const raw = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, a, .limited(1 << 30));
+        const x = try core.npy.parse(raw);
+        if (!std.mem.eql(u8, x.descr, "<i4")) return error.BadIds;
+        r.ids = @alignCast(std.mem.bytesAsSlice(i32, x.data));
+    }
+
+    pub fn deinit(r: *Rig) void {
+        r.b.deinit();
+        r.m.deinit();
+        r.loaded.deinit();
+        r.st.deinit();
+    }
+
+    pub fn cache(r: *const Rig, arena: u64) rk.Cache {
+        return .{ .pool = arena, .page_bytes = r.dims.pageBytes(), .layer_off = 0, .kvh = r.g.kvh, .kv8 = true };
+    }
+
+    pub fn pagesOf(r: *const Rig, arena: u64, mirror: *rk.Mirror, t: ?*tier.Tier) fw.Pages {
+        return .{ .cache = r.cache(arena), .layer_bytes = r.dims.layerToken() * mm.pool.page_tokens, .mirror = mirror, .tier = t };
+    }
+
+    /// The tier's configuration over `slots` streams of the rig's pages: `horizon` blocks, `m` candidates, `slices`.
+    pub fn tierCfg(r: *const Rig, slots: u32, horizon: u32, m: u32, slices: u32, path: [:0]const u8) tier.Config {
+        return .{ .layers = r.dims.layers, .kvh = r.g.kvh, .kv8 = true, .streams = slots, .max_pages = @intCast(r.max_pages), .vpages = @intCast(slots * r.max_pages), .horizon = horizon, .m = m, .slices = slices, .max_rows = iface.max_rows, .path = path };
+    }
+};
+
+pub fn secs(io: std.Io, t0: i96) f64 {
+    return @as(f64, @floatFromInt(check.now(io) - t0)) / 1e9;
+}
+
+/// A forward over one pool: prefill and decode on its streams, the head's rows copied out.
+pub const Run = struct {
+    r: *Rig,
+    f: fw.Forward,
+    mirror: rk.Mirror,
+
+    pub fn init(r: *Rig, slots: u32, arena: u64, t: ?*tier.Tier) !*Run {
+        const rn = try r.gpu.gpa.create(Run);
+        errdefer r.gpu.gpa.destroy(rn);
+        rn.r = r;
+        rn.mirror = try rk.Mirror.init(r.gpu.d, slots, r.max_pages, iface.shared_rows);
+        errdefer rn.mirror.deinit();
+        const pages = r.pagesOf(arena, &rn.mirror, t);
+        rn.f = try fw.Forward.init(r.gpu.gpa, r.gpu.d, r.st, &r.m, &r.loaded.weights, &r.g, &r.b, pages, null);
+        return rn;
+    }
+
+    pub fn deinit(rn: *Run) void {
+        rn.f.deinit(rn.r.gpu.gpa);
+        rn.mirror.deinit();
+        rn.r.gpu.gpa.destroy(rn);
+    }
+
+    /// Slot `slot`'s table: block b is page `first + b` (the tier sees it too).
+    pub fn table(rn: *Run, slot: u32, first: u32) !void {
+        const row = try rn.r.a.alloc(i32, rn.r.max_pages);
+        for (row, 0..) |*e, b| e.* = @intCast(first + b);
+        try rn.mirror.put(slot, 0, row);
+        if (rn.f.dev.pages.tier) |t| {
+            t.closeStream(slot);
+            t.putLogical(slot, 0, row);
+        }
+    }
+
+    fn settle(rn: *Run) !void {
+        const s = try rn.f.dev.status();
+        try check.expect(s == 0, "mm3-kv-tier: page status 0x{x}", .{s});
+    }
+
+    /// `rows` head rows as own_vocab fp32 each (caller frees).
+    fn rowsOf(rn: *Run, out: fw.Out) ![]f32 {
+        const v: usize = rn.r.g.own_vocab;
+        const stride: usize = rn.r.g.slot;
+        const raw = try rn.r.gpu.gpa.alloc(f32, out.rows * stride);
+        defer rn.r.gpu.gpa.free(raw);
+        const src: cuda.DeviceBuffer = .{ .d = rn.r.gpu.d, .ptr = rn.f.address(out), .len = raw.len * 4, .borrowed = true };
+        try src.download(0, std.mem.sliceAsBytes(raw));
+        const rows = try rn.r.gpu.gpa.alloc(f32, out.rows * v);
+        for (0..out.rows) |i| @memcpy(rows[i * v ..][0..v], raw[i * stride ..][0..v]);
+        return rows;
+    }
+
+    /// `ids` from position 0 of `slot` in the plan's chunks; the last row's logits (caller frees).
+    pub fn prefill(rn: *Run, slot: u32, ids: []const i32) ![]f32 {
+        var at: usize = 0;
+        var last: []f32 = &.{};
+        while (at < ids.len) {
+            const end = rn.r.rows.chunkEnd(at, ids.len, null);
+            const tail = end == ids.len;
+            const out = try rn.f.run(.{ .ids = ids[at..end], .slot = slot, .pos0 = @intCast(at), .prompt = true, .head = if (tail) .last else .none });
+            try rn.settle();
+            if (tail) last = try rn.rowsOf(out);
+            at = end;
+        }
+        return last;
+    }
+
+    /// One row of `slot` at `pos`; its logits (caller frees).
+    pub fn decode(rn: *Run, slot: u32, pos: u32, id: i32) ![]f32 {
+        const out = try rn.f.run(.{ .ids = &.{id}, .slot = slot, .pos0 = pos, .head = .all });
+        try rn.settle();
+        return rn.rowsOf(out);
+    }
+
+    /// One row of each stream at its position, as one shared call; every row's logits (caller frees).
+    pub fn shared(rn: *Run, segs: []const iface.Seg, ids: []const i32, positions: []const i32) ![]f32 {
+        const out = try rn.f.run(.{ .ids = ids, .segs = segs, .positions = positions, .head = .all });
+        try rn.settle();
+        return rn.rowsOf(out);
+    }
+};
+
+/// How two logit rows compare: bit-equal, the largest absolute difference, the same argmax.
+pub const Diff = struct {
+    equal: bool,
+    max_abs: f32,
+    same_top: bool,
+
+    pub fn of(x: []const f32, y: []const f32) Diff {
+        var d: f32 = 0;
+        for (x, y) |p, q| d = @max(d, @abs(p - q));
+        return .{ .equal = std.mem.eql(u8, std.mem.sliceAsBytes(x), std.mem.sliceAsBytes(y)), .max_abs = d, .same_top = argmax(x) == argmax(y) };
+    }
+};
+
+pub fn argmax(row: []const f32) usize {
+    var best: usize = 0;
+    for (row, 0..) |v, i| if (v > row[best]) {
+        best = i;
+    };
+    return best;
+}
+
+const Variant = struct { name: []const u8, horizon: u32, m: u32, slices: u32, exact: bool };
+
+/// eq: the all-resident pool's prompt and decode logits, then each tier variant's, compared row by row.
+fn equality(r: *Rig, ctx: usize, steps: usize) !void {
+    if (ctx + steps + 1 > r.ids.len) return error.ShortIds;
+    const gpa = r.gpu.gpa;
+    var arena = try cuda.DeviceBuffer.alloc(r.gpu.d, r.max_pages * r.dims.pageBytes());
+    defer arena.free();
+    try arena.fill8(0, null);
+    const want = try gpa.alloc([]f32, steps + 1);
+    defer gpa.free(want);
+    {
+        const rn = try Run.init(r, 1, arena.ptr, null);
+        defer rn.deinit();
+        try rn.table(0, 0);
+        const t0 = check.now(r.gpu.io);
+        want[0] = try rn.prefill(0, r.ids[0..ctx]);
+        std.debug.print("  resident: {d} tokens prefilled in {d:.1} s\n", .{ ctx, secs(r.gpu.io, t0) });
+        for (1..steps + 1) |k| want[k] = try rn.decode(0, @intCast(ctx + k - 1), r.ids[ctx + k - 1]);
+    }
+    defer for (want) |w| gpa.free(w);
+    const blocks: u32 = @intCast(ctx / 128 + 2);
+    // the least cache: every open page on every layer and one layer's candidates; a context past it pages via NVMe
+    const least: u32 = tier.max_open * r.dims.layers + blocks + 8;
+    const variants = [_]Variant{
+        .{ .name = "horizon=all", .horizon = blocks + 1, .m = 16, .slices = least, .exact = true },
+        .{ .name = "horizon=8 m=all", .horizon = 8, .m = blocks, .slices = least, .exact = true },
+        .{ .name = "horizon=8 m=16", .horizon = 8, .m = 16, .slices = least, .exact = false },
+    };
+    var failed = false;
+    for (variants) |v| {
+        const path = try std.fmt.allocPrintSentinel(r.a, "{s}/eq.pages", .{r.dir}, 0);
+        const t = try tier.Tier.init(gpa, r.gpu.d, r.st, r.tierCfg(1, v.horizon, v.m, v.slices, path), 0);
+        defer t.deinit();
+        const rn = try Run.init(r, 1, arena.ptr, t);
+        defer rn.deinit();
+        t.vtab = rn.mirror.tables.ptr;
+        try rn.table(0, 0);
+        const t0 = check.now(r.gpu.io);
+        var equal: usize = 0;
+        var tops: usize = 0;
+        var worst: f32 = 0;
+        for (0..steps + 1) |k| {
+            const got = if (k == 0) try rn.prefill(0, r.ids[0..ctx]) else try rn.decode(0, @intCast(ctx + k - 1), r.ids[ctx + k - 1]);
+            defer gpa.free(got);
+            const d = Diff.of(got, want[k]);
+            equal += @intFromBool(d.equal);
+            tops += @intFromBool(d.same_top);
+            worst = @max(worst, d.max_abs);
+        }
+        const s = t.store.stats;
+        std.debug.print("  {s}: {d}/{d} rows bit-equal, {d}/{d} same argmax, max |d| {e}; {d} slices read ({d} MiB), {d} written, {d} evictions, {d:.1} s\n", .{ v.name, equal, steps + 1, tops, steps + 1, worst, s.reads, s.read_bytes >> 20, s.writes, t.cache.stats.evictions, secs(r.gpu.io, t0) });
+        if (v.exact and equal != steps + 1) failed = true;
+        if (blocks * r.dims.layers > v.slices) try check.expect(s.reads > 0, "mm3-kv-tier {s}: no page came back from NVMe", .{v.name});
+    }
+    try check.expect(!failed, "mm3-kv-tier: an exact variant's logits differ from the all-resident pool", .{});
+    check.pass("mm3-kv-tier eq ctx {d} steps {d}", .{ ctx, steps });
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len < 5) {
+        std.debug.print("{s}", .{usage});
+        return error.MissingArgument;
+    }
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const layers = try std.fmt.parseInt(u32, rest[1], 10);
+    const mode = rest[3];
+    if (std.mem.eql(u8, mode, "eq")) {
+        if (rest.len < 7) return error.MissingArgument;
+        const ctx = try std.fmt.parseInt(usize, rest[5], 10);
+        const steps = try std.fmt.parseInt(usize, rest[6], 10);
+        var r: Rig = undefined;
+        try r.init(gpu, a, rest[0], layers, rest[4], rest[2], ctx + steps + 128);
+        defer r.deinit();
+        return equality(&r, ctx, steps);
+    }
+    if (std.mem.eql(u8, mode, "quality")) {
+        if (rest.len < 8) return error.MissingArgument;
+        return quality.run(gpu, a, rest[0], layers, rest[2], rest[4..]);
+    }
+    if (std.mem.eql(u8, mode, "bench")) {
+        if (rest.len < 9) return error.MissingArgument;
+        return bench.run(gpu, a, rest[0], layers, rest[2], rest[4..]);
+    }
+    std.debug.print("{s}", .{usage});
+    return error.BadMode;
+}
diff --git a/zig/tests/cuda/mm3_kvfmt.zig b/zig/tests/cuda/mm3_kvfmt.zig
new file mode 100644
index 0000000000000000000000000000000000000000..59b0f739b10f7704b65a2d7b1d2cd7bfaeca0cea
--- /dev/null
+++ b/zig/tests/cuda/mm3_kvfmt.zig
@@ -0,0 +1,248 @@
+//! tf-cuda-test mm3-kvfmt-bench: MiniMax-M3.1-Flash index scoring and sparse attention per KV cell format, timed.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+
+const sp = cuda.minimax_m3_sparse;
+const geom = sp.geom;
+const mr = core.minimax_ref;
+const c = core.contract.spec;
+
+pub const usage = "  mm3-kvfmt-bench [CTX,..] [ROWS,..] [REPS]  MiniMax-M3.1-Flash index and attention microseconds per KV cell format\n";
+
+/// A TP2 rank's local kv heads, the shipped model's layers (for the token bytes), distinct page images cycled.
+const kvh = 2;
+const model_layers = 60;
+const templates = 16;
+
+/// One cell-format arm: the pool's K/V and index-key formats.
+pub const Arm = struct {
+    name: []const u8,
+    kv8: bool = false,
+    kv4: geom.Kv4 = .off,
+    ik8: geom.Ik8 = .off,
+
+    pub fn pool(a: Arm, layers: usize) geom.Pool {
+        return .{ .kvh = kvh, .layers = layers, .kv8 = a.kv8, .kv4 = a.kv4, .ik8 = a.ik8 };
+    }
+};
+
+/// Every arm by name; `bench_arms` are the first seven (the index-key-only arms are for the quality run).
+pub const named = [_]Arm{
+    .{ .name = "bf16" },
+    .{ .name = "fp8", .kv8 = true },
+    .{ .name = "fp8ik", .kv8 = true, .ik8 = .fp8 },
+    .{ .name = "fp8s8", .kv8 = true, .ik8 = .int8 },
+    .{ .name = "fp8s16", .kv8 = true, .ik8 = .int8g16 },
+    .{ .name = "q4ik", .kv4 = .kv, .ik8 = .fp8 },
+    .{ .name = "q4vik", .kv8 = true, .kv4 = .v, .ik8 = .fp8 },
+    .{ .name = "ik8", .ik8 = .fp8 },
+    .{ .name = "s8", .ik8 = .int8 },
+    .{ .name = "s16", .ik8 = .int8g16 },
+    .{ .name = "q4vs8", .kv8 = true, .kv4 = .v, .ik8 = .int8 },
+    .{ .name = "q4s8", .kv4 = .kv, .ik8 = .int8 },
+};
+const bench_arms = named[0..7];
+
+pub fn armOf(name: []const u8) ?Arm {
+    for (named) |a| if (std.mem.eql(u8, a.name, name)) return a;
+    return null;
+}
+
+fn attnScale() f32 {
+    return @floatCast(std.math.pow(f64, geom.d, -0.5));
+}
+
+/// Row `x` (128 values) stored at page `page` of a one-layer image in format `v`; `which` 0 K, 1 V, 2 the index key.
+fn putRow(img: []u8, p: geom.Pool, v: geom.Val, page: usize, which: usize, h: usize, t: usize, x: []const f32) void {
+    const at = if (which == 2) p.ik(page, 0, t) else p.kv(page, 0, which, h, t);
+    switch (v) {
+        .bf16 => for (x, 0..) |e, i| std.mem.writeInt(u16, img[at + 2 * i ..][0..2], c.toBf16(e), .little),
+        .e4m3 => {
+            const sc = mr.quantRowF32(x, img[at..][0..geom.d]);
+            const s_at = if (which == 2) p.ikScale(page, 0, t) else p.scale(page, 0, which, h, t);
+            std.mem.writeInt(u32, img[s_at..][0..4], @bitCast(sc), .little);
+        },
+        .s8, .s16 => {
+            var codes: [geom.d]i8 = undefined;
+            var sc_all: [geom.d / geom.s16_group]f32 = undefined;
+            const group: usize = if (v == .s16) geom.s16_group else geom.q4_group;
+            const sc = sc_all[0 .. geom.d / group];
+            mr.quantRowS8F32(x, &codes, sc);
+            @memcpy(img[at..][0..geom.d], std.mem.sliceAsBytes(&codes));
+            const s_at = p.ikScale(page, 0, t);
+            for (sc, 0..) |sv, g| std.mem.writeInt(u16, img[s_at + 2 * g ..][0..2], @bitCast(@as(f16, @floatCast(sv))), .little);
+        },
+        .q4 => {
+            var n: [geom.d]u8 = undefined;
+            var sc: [geom.d / geom.q4_group]f32 = undefined;
+            mr.quantRow4F32(x, &n, &sc);
+            mr.packQ4(&n, img[at..][0 .. geom.d / 2]);
+            const s_at = p.scale(page, 0, which, h, t);
+            for (sc, 0..) |sv, g| std.mem.writeInt(u16, img[s_at + 2 * g ..][0..2], @bitCast(@as(f16, @floatCast(sv))), .little);
+        },
+    }
+}
+
+/// `templates` one-layer pages of normal K, V and index keys in the arm's formats.
+fn images(a: std.mem.Allocator, arm: Arm, rng: std.Random) ![]u8 {
+    const p = arm.pool(1);
+    const f = p.fmt();
+    const img = try a.alloc(u8, templates * p.pageBytes());
+    @memset(img, 0);
+    var x: [geom.d]f32 = undefined;
+    for (0..templates) |page| for (0..geom.block) |t| {
+        for (0..2) |which| for (0..kvh) |h| {
+            for (&x) |*e| e.* = rng.floatNorm(f32);
+            putRow(img, p, if (which == 0) f.k else f.v, page, which, h, t, &x);
+        };
+        for (&x) |*e| e.* = rng.floatNorm(f32);
+        putRow(img, p, f.ik, page, 2, 0, t, &x);
+    };
+    return img;
+}
+
+/// One timed configuration: the launches' inputs on the device.
+const Case = struct {
+    s: *const sp.Sparse,
+    st: cuda.Stream,
+    iq: u64,
+    q: u64,
+    out: u64,
+    rows: sp.Rows,
+    paged: sp.Paged,
+    sc: sp.Scratch,
+    max_pos: usize,
+
+    fn launch(k: *const Case, attend: bool) !void {
+        if (attend) return k.s.attend(k.st, k.q, k.rows, k.paged, k.sc, k.out, attnScale(), false);
+        try k.s.score(k.st, k.iq, k.rows, k.paged, k.sc, k.max_pos, attnScale());
+    }
+
+    /// Microseconds a launch over `reps` back-to-back launches after three warm ones.
+    fn time(k: *const Case, ev: *[2]cuda.Event, reps: usize, attend: bool) !f64 {
+        for (0..3) |_| try k.launch(attend);
+        try ev[0].record(k.st);
+        for (0..reps) |_| try k.launch(attend);
+        try ev[1].record(k.st);
+        try ev[1].synchronize();
+        return @as(f64, try ev[0].elapsedMs(ev[1])) * 1000 / @as(f64, @floatFromInt(reps));
+    }
+};
+
+const Result = struct { arm: usize, ctx: usize, rows: usize, index_us: f64, attn_us: f64 };
+
+fn parseList(a: std.mem.Allocator, s: []const u8) ![]usize {
+    var out: std.ArrayList(usize) = .empty;
+    var it = std.mem.splitScalar(u8, s, ',');
+    while (it.next()) |v| try out.append(a, try std.fmt.parseInt(usize, v, 10));
+    return out.items;
+}
+
+fn upload(d: *const cuda.Driver, bytes: []const u8) !cuda.DeviceBuffer {
+    const b = try cuda.DeviceBuffer.alloc(d, @max(bytes.len, 4));
+    try b.upload(0, bytes);
+    return b;
+}
+
+/// Decode rows' positions: spread over [0, ctx) like the contract tests, the last at ctx - 1.
+fn positions(out: []i32, ctx: usize) void {
+    for (out, 0..) |*p, i| p.* = @intCast(if (i == out.len - 1) ctx - 1 else (i * 7919) % ctx);
+}
+
+fn find(res: []const Result, arm: usize, ctx: usize, rows: usize) ?Result {
+    for (res) |r| if (r.arm == arm and r.ctx == ctx and r.rows == rows) return r;
+    return null;
+}
+
+fn ratio(x: f64, y: ?Result, attend: bool) f64 {
+    const r = y orelse return 0;
+    return x / (if (attend) r.attn_us else r.index_us);
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    var arena_a = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena_a.deinit();
+    const a = arena_a.allocator();
+    const ctxs = if (rest.len > 0) try parseList(a, rest[0]) else try a.dupe(usize, &.{ 8192, 32768, 131072, 524288, 1048576 });
+    const rows_list = if (rest.len > 1) try parseList(a, rest[1]) else try a.dupe(usize, &.{ 1, 4 });
+    const reps = if (rest.len > 2) try std.fmt.parseInt(usize, rest[2], 10) else 50;
+    var top_ctx: usize = 1;
+    var top_rows: usize = 1;
+    for (ctxs) |x| top_ctx = @max(top_ctx, x);
+    for (rows_list) |x| top_rows = @max(top_rows, x);
+    try check.expect(reps > 0 and ctxs.len > 0 and rows_list.len > 0, "mm3-kvfmt-bench: empty argument", .{});
+    try geom.check(top_rows, kvh);
+    const d = gpu.d;
+    var s = try sp.Sparse.load(d);
+    defer s.unload();
+    var st = try cuda.Stream.init(d, false);
+    defer st.deinit();
+    var ev: [2]cuda.Event = .{ try cuda.Event.init(d, true), try cuda.Event.init(d, true) };
+    defer for (&ev) |*e| e.deinit();
+    var prng = std.Random.DefaultPrng.init(0x6b76666d74);
+    const rng = prng.random();
+    // the pool: pages for the largest context (every row reads one table), the largest page of any arm
+    const pages = geom.blocks(top_ctx - 1);
+    var big: usize = 0;
+    for (bench_arms) |arm| big = @max(big, arm.pool(1).pageBytes());
+    var pool = try cuda.DeviceBuffer.alloc(d, pages * big);
+    defer pool.free();
+    const perm = try a.alloc(i32, pages);
+    for (perm, 0..) |*x, i| x.* = @intCast(i);
+    rng.shuffle(i32, perm);
+    var table = try upload(d, std.mem.sliceAsBytes(perm));
+    defer table.free();
+    const iq_h = try a.alloc(u16, top_rows * kvh * geom.d);
+    for (iq_h) |*e| e.* = c.toBf16(rng.floatNorm(f32));
+    var iq = try upload(d, std.mem.sliceAsBytes(iq_h));
+    defer iq.free();
+    const q_h = try a.alloc(u16, top_rows * kvh * geom.group * geom.d);
+    for (q_h) |*e| e.* = c.toBf16(rng.floatNorm(f32));
+    var q = try upload(d, std.mem.sliceAsBytes(q_h));
+    defer q.free();
+    var out = try cuda.DeviceBuffer.alloc(d, top_rows * kvh * geom.group * geom.d * 2);
+    defer out.free();
+    var bmax = try cuda.DeviceBuffer.alloc(d, geom.bmaxBytes(top_rows, kvh, pages));
+    defer bmax.free();
+    var sel = try cuda.DeviceBuffer.alloc(d, geom.selBytes(top_rows, kvh));
+    defer sel.free();
+    var pos = try cuda.DeviceBuffer.alloc(d, top_rows * 4);
+    defer pos.free();
+    const pos_h = try a.alloc(i32, top_rows);
+    var res: std.ArrayList(Result) = .empty;
+    for (bench_arms, 0..) |arm, ai| {
+        const p = arm.pool(1);
+        const pb = p.pageBytes();
+        const img = try images(a, arm, rng);
+        var at: usize = 0;
+        while (at < pages) : (at += templates) {
+            const n = @min(templates, pages - at);
+            try pool.upload(at * pb, img[0 .. n * pb]);
+        }
+        const paged: sp.Paged = .{ .pool = pool.ptr, .page_bytes = pb, .layer_off = 0, .kvh = kvh, .tables = table.ptr, .kv8 = arm.kv8, .kv4 = arm.kv4, .ik8 = arm.ik8 };
+        const tb = arm.pool(model_layers).tokenBytes();
+        for (ctxs) |ctx| for (rows_list) |n| {
+            positions(pos_h[0..n], ctx);
+            try pos.upload(0, std.mem.sliceAsBytes(pos_h[0..n]));
+            const k: Case = .{ .s = &s, .st = st, .iq = iq.ptr, .q = q.ptr, .out = out.ptr, .rows = .{ .n = n, .pos = pos.ptr }, .paged = paged, .sc = .{ .bmax = bmax.ptr, .sel = sel.ptr, .bm_stride = pages }, .max_pos = ctx - 1 };
+            const index_us = try k.time(&ev, reps, false);
+            try s.select(st, k.rows, kvh, k.sc, .{});
+            const attn_us = try k.time(&ev, reps, true);
+            var read: usize = 0;
+            for (pos_h[0..n]) |x| read += geom.indexReadBytes(@intCast(x), p.fmt().ik);
+            const gbps = @as(f64, @floatFromInt(read)) / (index_us * 1e3);
+            std.debug.print("KVFMT arm={s} ctx={d} rows={d} index_us={d:.1} attn_us={d:.1} index_GBps={d:.1} token_bytes_tp2={d}\n", .{ arm.name, ctx, n, index_us, attn_us, gbps, tb });
+            try res.append(a, .{ .arm = ai, .ctx = ctx, .rows = n, .index_us = index_us, .attn_us = attn_us });
+        };
+    }
+    std.debug.print("\n| ctx | rows | arm | index us | attn us | index vs bf16 | index vs fp8 | attn vs bf16 | attn vs fp8 | B/token (TP2 rank, 60 layers) |\n|---|---|---|---|---|---|---|---|---|---|\n", .{});
+    for (ctxs) |ctx| for (rows_list) |n| for (bench_arms, 0..) |arm, ai| {
+        const r = find(res.items, ai, ctx, n).?;
+        const b = find(res.items, 0, ctx, n);
+        const f = find(res.items, 1, ctx, n);
+        std.debug.print("| {d} | {d} | {s} | {d:.1} | {d:.1} | {d:.3} | {d:.3} | {d:.3} | {d:.3} | {d} |\n", .{ ctx, n, arm.name, r.index_us, r.attn_us, ratio(r.index_us, b, false), ratio(r.index_us, f, false), ratio(r.attn_us, b, true), ratio(r.attn_us, f, true), arm.pool(model_layers).tokenBytes() });
+    };
+    check.pass("mm3-kvfmt-bench {d} arms, {d} contexts, {d} row counts", .{ bench_arms.len, ctxs.len, rows_list.len });
+}
diff --git a/zig/tests/cuda/mm3_kvfmt_quality.zig b/zig/tests/cuda/mm3_kvfmt_quality.zig
new file mode 100644
index 0000000000000000000000000000000000000000..584f4984971d8562257ade1a8ad67139586dd999
--- /dev/null
+++ b/zig/tests/cuda/mm3_kvfmt_quality.zig
@@ -0,0 +1,348 @@
+//! tf-cuda-test mm3-kvfmt-quality: real-pack MiniMax-M3.1-Flash layers per KV cell format against the bf16 pool.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const bench = @import("mm3_kvfmt.zig");
+
+const fw = mm.forward;
+const plan = mm.forward_plan;
+const rk = cuda.minimax_m3_rows;
+const iface = mm.iface;
+const geom = cuda.minimax_m3_sparse.geom;
+const SelTap = mm.forward_exec.SelTap;
+
+pub const usage = "  mm3-kvfmt-quality PACK LAYERS IDS.npy CTX STEPS ARM,..  KV formats (bf16 fp8 fp8ik fp8s8 fp8s16 q4ik q4vik ik8 s8 s16 q4vs8 q4s8) vs bf16: overlap@16, KL\n";
+
+/// The weights, geometry and buffers every arm's forward shares, and the prompt's ids.
+const Rig = struct {
+    gpu: check.Gpu,
+    a: std.mem.Allocator,
+    c: mm.config.Config,
+    share: mm.shard.Share,
+    st: cuda.Stream,
+    loaded: mm.weights_device.Loaded,
+    g: plan.Geometry,
+    m: fw.Modules,
+    b: fw.Buffers,
+    rows: mm.rows_plan.Plan,
+    base: mm.pool.Dims,
+    max_pages: usize,
+    ids: []const i32,
+
+    /// In place: the geometry and the weights point at `r.c`.
+    fn init(r: *Rig, gpu: check.Gpu, a: std.mem.Allocator, pack: []const u8, layers: u32, ids_path: []const u8, capacity: usize) !void {
+        const text = try std.Io.Dir.cwd().readFileAlloc(gpu.io, try std.fs.path.join(a, &.{ pack, "config.json" }), a, .limited(1 << 24));
+        r.gpu = gpu;
+        r.a = a;
+        r.c = try mm.config.parse(a, text);
+        r.share = try mm.shard.Share.of(&r.c, 0, 1);
+        r.st = try cuda.Stream.init(gpu.d, false);
+        const t0 = check.now(gpu.io);
+        r.loaded = try mm.weights_device.loadWeights(gpu.gpa, gpu.io, gpu.d, r.st, pack, &r.c, r.share, layers);
+        std.debug.print("  {d} layers and the head: {d} MiB of weights in {d:.1} s\n", .{ layers, r.loaded.bytes >> 20, secs(gpu.io, t0) });
+        r.g = try plan.Geometry.of(&r.c, r.share, layers, iface.max_rows);
+        r.m = try fw.Modules.load(gpu.d);
+        r.max_pages = iface.maxPages(capacity);
+        r.rows = mm.rows_plan.Plan.of(r.g.kvh, r.max_pages, 64);
+        r.b = try fw.Buffers.init(gpu.d, &r.g, r.rows.scratch);
+        r.base = try mm.pool.Dims.of(&r.c, r.share);
+        r.base.layers = layers;
+        const raw = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, a, .limited(1 << 30));
+        const x = try core.npy.parse(raw);
+        if (!std.mem.eql(u8, x.descr, "<i4")) return error.BadIds;
+        r.ids = @alignCast(std.mem.bytesAsSlice(i32, x.data));
+    }
+
+    fn deinit(r: *Rig) void {
+        r.b.deinit();
+        r.m.deinit();
+        r.loaded.deinit();
+        r.st.deinit();
+    }
+
+    /// The arm's page dims: the base with its K/V and index-key formats.
+    fn dims(r: *const Rig, arm: bench.Arm) mm.pool.Dims {
+        return r.base.withKv8(arm.kv8).withFormats(@fromBackingInt(@intCast(@backingInt(arm.kv4))), @fromBackingInt(@intCast(@backingInt(arm.ik8))));
+    }
+};
+
+fn secs(io: std.Io, t0: i96) f64 {
+    return @as(f64, @floatFromInt(check.now(io) - t0)) / 1e9;
+}
+
+/// One arm's forward over its own pool: prefill and decode on slot 0, the head's rows copied out.
+const Run = struct {
+    r: *Rig,
+    f: fw.Forward,
+    mirror: rk.Mirror,
+
+    fn init(r: *Rig, arm: bench.Arm, arena: u64) !*Run {
+        const rn = try r.gpu.gpa.create(Run);
+        errdefer r.gpu.gpa.destroy(rn);
+        rn.r = r;
+        rn.mirror = try rk.Mirror.init(r.gpu.d, 1, r.max_pages, iface.shared_rows);
+        errdefer rn.mirror.deinit();
+        const d = r.dims(arm);
+        const cache: rk.Cache = .{ .pool = arena, .page_bytes = d.pageBytes(), .layer_off = 0, .kvh = r.g.kvh, .kv8 = arm.kv8, .kv4 = arm.kv4, .ik8 = arm.ik8 };
+        const pages: fw.Pages = .{ .cache = cache, .layer_bytes = d.layerToken() * mm.pool.page_tokens, .mirror = &rn.mirror };
+        rn.f = try fw.Forward.init(r.gpu.gpa, r.gpu.d, r.st, &r.m, &r.loaded.weights, &r.g, &r.b, pages, null);
+        const row = try r.a.alloc(i32, r.max_pages);
+        for (row, 0..) |*e, b| e.* = @intCast(b);
+        try rn.mirror.put(0, 0, row);
+        return rn;
+    }
+
+    fn deinit(rn: *Run) void {
+        rn.f.deinit(rn.r.gpu.gpa);
+        rn.mirror.deinit();
+        rn.r.gpu.gpa.destroy(rn);
+    }
+
+    fn settle(rn: *Run) !void {
+        const s = try rn.f.dev.status();
+        try check.expect(s == 0, "mm3-kvfmt-quality: page status 0x{x}", .{s});
+    }
+
+    /// `out.rows` head rows as own_vocab fp32 each (caller frees).
+    fn rowsOf(rn: *Run, out: fw.Out) ![]f32 {
+        const v: usize = rn.r.g.own_vocab;
+        const stride: usize = rn.r.g.slot;
+        const raw = try rn.r.gpu.gpa.alloc(f32, out.rows * stride);
+        defer rn.r.gpu.gpa.free(raw);
+        const src: cuda.DeviceBuffer = .{ .d = rn.r.gpu.d, .ptr = rn.f.address(out), .len = raw.len * 4, .borrowed = true };
+        try src.download(0, std.mem.sliceAsBytes(raw));
+        const rows = try rn.r.gpu.gpa.alloc(f32, out.rows * v);
+        for (0..out.rows) |i| @memcpy(rows[i * v ..][0..v], raw[i * stride ..][0..v]);
+        return rows;
+    }
+
+    /// `ids` from position 0 in the plan's chunks.
+    fn prefill(rn: *Run, ids: []const i32) !void {
+        var at: usize = 0;
+        while (at < ids.len) {
+            const end = rn.r.rows.chunkEnd(at, ids.len, null);
+            const tail = end == ids.len;
+            _ = try rn.f.run(.{ .ids = ids[at..end], .slot = 0, .pos0 = @intCast(at), .prompt = true, .head = if (tail) .last else .none });
+            try rn.settle();
+            at = end;
+        }
+    }
+
+    /// One row at `pos`; its logits (caller frees).
+    fn decode(rn: *Run, pos: u32, id: i32) ![]f32 {
+        const out = try rn.f.run(.{ .ids = &.{id}, .slot = 0, .pos0 = pos, .head = .all });
+        try rn.settle();
+        return rn.rowsOf(out);
+    }
+};
+
+/// Every decode step's selections [step][layer][kvh][16], from the tap.
+const Record = struct {
+    gpa: std.mem.Allocator,
+    st: cuda.Stream,
+    layers: u32,
+    kvh: u32,
+    steps: usize,
+    sel: []i32,
+    step: usize = 0,
+
+    fn init(gpa: std.mem.Allocator, st: cuda.Stream, layers: u32, kvh: u32, steps: usize) !Record {
+        const sel = try gpa.alloc(i32, steps * layers * kvh * geom.topk);
+        @memset(sel, -1);
+        return .{ .gpa = gpa, .st = st, .layers = layers, .kvh = kvh, .steps = steps, .sel = sel };
+    }
+
+    fn deinit(r: *Record) void {
+        r.gpa.free(r.sel);
+    }
+
+    fn tap(r: *Record) SelTap {
+        return .{ .ctx = r, .call = call };
+    }
+
+    fn call(ctx: *anyopaque, layer: u32, rows: u32, sel: u64) anyerror!void {
+        const r: *Record = @ptrCast(@alignCast(ctx));
+        if (rows != 1 or r.step >= r.steps) return;
+        const n = r.kvh * geom.topk;
+        try r.st.synchronize();
+        const src: cuda.DeviceBuffer = .{ .d = r.st.d, .ptr = sel, .len = n * 4, .borrowed = true };
+        try src.download(0, std.mem.sliceAsBytes(r.sel[(r.step * r.layers + layer) * n ..][0..n]));
+    }
+};
+
+/// Share of the reference's selected blocks the arm selected too: mean, least and lists fully equal; per layer means.
+const Overlap = struct { mean: f64, min: f64, full: f64, layer: []f64 };
+
+fn overlap(a: std.mem.Allocator, want: *const Record, got: *const Record) !Overlap {
+    const k = geom.topk;
+    const per = try a.alloc(f64, want.layers);
+    const cnt = try a.alloc(usize, want.layers);
+    @memset(per, 0);
+    @memset(cnt, 0);
+    var sum: f64 = 0;
+    var least: f64 = 1;
+    var full: usize = 0;
+    var n: usize = 0;
+    var i: usize = 0;
+    while (i < want.sel.len) : (i += k) {
+        const layer = (i / (want.kvh * k)) % want.layers;
+        const w = want.sel[i..][0..k];
+        const g = got.sel[i..][0..k];
+        var have: usize = 0;
+        var hit: usize = 0;
+        for (w) |b| if (b >= 0) {
+            have += 1;
+            hit += @intFromBool(std.mem.indexOfScalar(i32, g, b) != null);
+        };
+        if (have == 0) continue;
+        const r = @as(f64, @floatFromInt(hit)) / @as(f64, @floatFromInt(have));
+        sum += r;
+        least = @min(least, r);
+        full += @intFromBool(hit == have and std.mem.eql(i32, w, g));
+        n += 1;
+        per[layer] += r;
+        cnt[layer] += 1;
+    }
+    for (per, cnt) |*p, m| p.* /= @floatFromInt(@max(m, 1));
+    const nf: f64 = @floatFromInt(@max(n, 1));
+    return .{ .mean = sum / nf, .min = least, .full = @as(f64, @floatFromInt(full)) / nf, .layer = per };
+}
+
+/// KL(p || q) of two logit rows, nats, in f64.
+fn kl(p: []const f32, q: []const f32) f64 {
+    const lp = logSoftmax(p);
+    const lq = logSoftmax(q);
+    var s: f64 = 0;
+    for (p, q) |x_, y| {
+        const x = @as(f64, x_) - lp;
+        s += @exp(x) * (x - (@as(f64, y) - lq));
+    }
+    return @max(s, 0);
+}
+
+fn logSoftmax(row: []const f32) f64 {
+    var m: f64 = -std.math.inf(f64);
+    for (row) |v| m = @max(m, v);
+    var s: f64 = 0;
+    for (row) |v| s += @exp(@as(f64, v) - m);
+    return m + @log(s);
+}
+
+fn argmax(row: []const f32) usize {
+    var best: usize = 0;
+    for (row, 0..) |v, i| if (v > row[best]) {
+        best = i;
+    };
+    return best;
+}
+
+/// One arm's results: its selections, its logits a decode step, and its times.
+const Done = struct {
+    arm: bench.Arm,
+    rec: Record,
+    rows: [][]f32,
+    prefill_ms: f64 = 0,
+    decode_ms: f64 = 0,
+};
+
+/// The arm's prefill of `ctx` ids, `steps` teacher-forced decode rows with the tap, then again untapped for the time.
+fn measure(r: *Rig, arm: bench.Arm, ctx: usize, steps: usize) !Done {
+    const gpa = r.gpu.gpa;
+    const io = r.gpu.io;
+    var arena = try cuda.DeviceBuffer.alloc(r.gpu.d, r.max_pages * r.dims(arm).pageBytes());
+    defer arena.free();
+    try arena.fill8(0, null);
+    const rn = try Run.init(r, arm, arena.ptr);
+    defer rn.deinit();
+    var out: Done = .{ .arm = arm, .rec = try Record.init(gpa, r.st, r.base.layers, r.g.kvh, steps), .rows = try r.a.alloc([]f32, steps) };
+    const t0 = check.now(io);
+    try rn.prefill(r.ids[0..ctx]);
+    try r.st.synchronize();
+    out.prefill_ms = secs(io, t0) * 1e3;
+    rn.f.dev.sel_tap = out.rec.tap();
+    for (0..steps) |k| {
+        out.rec.step = k;
+        out.rows[k] = try rn.decode(@intCast(ctx + k), r.ids[ctx + k]);
+    }
+    rn.f.dev.sel_tap = null;
+    const t1 = check.now(io);
+    for (0..steps) |k| gpa.free(try rn.decode(@intCast(ctx + k), r.ids[ctx + k]));
+    out.decode_ms = secs(io, t1) * 1e3 / @as(f64, @floatFromInt(steps));
+    std.debug.print("  {s}: prefill {d:.0} ms, decode {d:.2} ms a step\n", .{ arm.name, out.prefill_ms, out.decode_ms });
+    return out;
+}
+
+/// The `KVQ` lines of `got` against `want`.
+fn compare(a: std.mem.Allocator, want: *const Done, got: *const Done, ctx: usize, steps: usize) !void {
+    const ov = try overlap(a, &want.rec, &got.rec);
+    var ksum: f64 = 0;
+    var kmax: f64 = 0;
+    var tops: usize = 0;
+    var worst: f32 = 0;
+    for (want.rows, got.rows) |w, g| {
+        const d = kl(w, g);
+        ksum += d;
+        kmax = @max(kmax, d);
+        tops += @intFromBool(argmax(w) == argmax(g));
+        for (w, g) |x, y| worst = @max(worst, @abs(x - y));
+    }
+    const sf: f64 = @floatFromInt(steps);
+    std.debug.print("KVQ arm={s} vs={s} ctx={d} steps={d} overlap_mean={d:.5} overlap_min={d:.4} lists_equal={d:.4} kl_mean={e:.3} kl_max={e:.3} top1={d}/{d} max_abs={e:.3} prefill_ms={d:.0} decode_ms={d:.2}\n", .{ got.arm.name, want.arm.name, ctx, steps, ov.mean, ov.min, ov.full, ksum / sf, kmax, tops, steps, worst, got.prefill_ms, got.decode_ms });
+    var line: std.ArrayList(u8) = .empty;
+    for (ov.layer, 0..) |x, l| try line.print(a, " l{d}={d:.4}", .{ l, x });
+    std.debug.print("KVQ_LAYERS arm={s} vs={s}{s}\n", .{ got.arm.name, want.arm.name, line.items });
+}
+
+/// PACK LAYERS IDS.npy CTX STEPS ARM,..: bf16 first (the reference), fp8 next when listed, then the rest.
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len < 6) {
+        std.debug.print("{s}", .{usage});
+        return error.MissingArgument;
+    }
+    var arena_a = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena_a.deinit();
+    const a = arena_a.allocator();
+    const layers = try std.fmt.parseInt(u32, rest[1], 10);
+    const ctx = try std.fmt.parseInt(usize, rest[3], 10);
+    const steps = try std.fmt.parseInt(usize, rest[4], 10);
+    if (ctx == 0 or steps == 0) return error.BadOptions;
+    var order: std.ArrayList(bench.Arm) = .empty;
+    try order.append(a, bench.armOf("bf16").?);
+    var fp8 = false;
+    var it = std.mem.splitScalar(u8, rest[5], ',');
+    while (it.next()) |name| {
+        const arm = bench.armOf(name) orelse {
+            std.debug.print("mm3-kvfmt-quality: no arm {s}\n{s}", .{ name, usage });
+            return error.BadOptions;
+        };
+        if (std.mem.eql(u8, name, "bf16")) continue;
+        if (std.mem.eql(u8, name, "fp8")) {
+            if (!fp8) try order.insert(a, 1, arm);
+            fp8 = true;
+            continue;
+        }
+        try order.append(a, arm);
+    }
+    var r: Rig = undefined;
+    try r.init(gpu, a, rest[0], layers, rest[2], ctx + steps + 256);
+    defer r.deinit();
+    try check.expect(ctx + steps <= r.ids.len, "mm3-kvfmt-quality: {d} ids, {d} needed", .{ r.ids.len, ctx + steps });
+    const done = try a.alloc(Done, order.items.len);
+    var made: usize = 0;
+    defer for (done[0..made]) |*x| {
+        x.rec.deinit();
+        for (x.rows) |row| gpu.gpa.free(row);
+    };
+    for (order.items, 0..) |arm, i| {
+        done[i] = try measure(&r, arm, ctx, steps);
+        made += 1;
+    }
+    std.debug.print("KVQ arm=bf16 vs=self ctx={d} steps={d} prefill_ms={d:.0} decode_ms={d:.2}\n", .{ ctx, steps, done[0].prefill_ms, done[0].decode_ms });
+    for (done[1..]) |*x| {
+        try compare(a, &done[0], x, ctx, steps);
+        if (fp8 and x != &done[1]) try compare(a, &done[1], x, ctx, steps);
+    }
+    check.pass("mm3-kvfmt-quality ctx {d} steps {d} layers {d}, {d} arms", .{ ctx, steps, layers, order.items.len });
+}
diff --git a/zig/tests/cuda/mm3_layer_parity.zig b/zig/tests/cuda/mm3_layer_parity.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4409a71c394a36d2b351dad12ed9b2c8f0daa91c
--- /dev/null
+++ b/zig/tests/cuda/mm3_layer_parity.zig
@@ -0,0 +1,186 @@
+//! tf-cuda-test mm3-layer-parity: one real-pack MiniMax-M3.1-Flash layer (world 1, planLayer's ops), partials as .npy.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+
+const fw = mm.forward;
+const plan = mm.forward_plan;
+const Buf = plan.Buf;
+const rk = cuda.minimax_m3_rows;
+
+pub const usage = "  mm3-layer-parity PACK LAYER IN.npy OUT_DIR [IDS.npy|-] [HEAD_IN.npy]  one layer of a pack on given rows\n";
+
+/// A read .npy whose dtype and row width must be `descr` and `cols`.
+pub fn readRows(a: std.mem.Allocator, io: std.Io, path: []const u8, descr: []const u8, cols: usize) !core.npy.Array {
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(1 << 30));
+    const x = try core.npy.parse(bytes);
+    const width: usize = if (x.rank == 1) 1 else x.shape[1];
+    if (!std.mem.eql(u8, x.descr, descr) or x.rank > 2 or width != cols or x.shape[0] == 0) {
+        std.debug.print("FAIL {s}: {s} {any}, expected {s} [rows, {d}]\n", .{ path, x.descr, x.shape[0..x.rank], descr, cols });
+        return error.BadInput;
+    }
+    return x;
+}
+
+/// `data` as `<dir>/<name>.npy` of `rows` C-order rows; `descr` is the element type (bf16 as its `<u2` bits).
+pub fn writeNpy(a: std.mem.Allocator, io: std.Io, dir: []const u8, name: []const u8, descr: []const u8, rows: usize, data: []const u8) !void {
+    const item: usize = std.fmt.parseInt(usize, descr[2..], 10) catch unreachable;
+    const cols = data.len / rows / item;
+    var dict_buf: [160]u8 = undefined;
+    const dict = try std.fmt.bufPrint(&dict_buf, "{{'descr': '{s}', 'fortran_order': False, 'shape': ({d}, {d}), }}", .{ descr, rows, cols });
+    const pad = 64 - (10 + dict.len + 1) % 64;
+    const head = 10 + dict.len + pad + 1;
+    const file = try a.alloc(u8, head + data.len);
+    @memcpy(file[0..8], "\x93NUMPY\x01\x00");
+    std.mem.writeInt(u16, file[8..10], @intCast(dict.len + pad + 1), .little);
+    @memcpy(file[10..][0..dict.len], dict);
+    @memset(file[10 + dict.len ..][0..pad], ' ');
+    file[head - 1] = '\n';
+    @memcpy(file[head..], data);
+    const path = try std.fmt.allocPrint(a, "{s}/{s}.npy", .{ dir, name });
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = path, .data = file });
+    std.debug.print("  wrote {s} ({d} x {d} {s})\n", .{ path, rows, cols, descr });
+}
+
+/// Downloads rows of the step's buffers after each op that finishes a partial, and writes them as .npy files.
+const Dump = struct {
+    a: std.mem.Allocator,
+    io: std.Io,
+    f: *fw.Forward,
+    out: []const u8,
+    rows: u32,
+
+    fn bytesOf(d: *const Dump, buf: Buf, rows: u32) !struct { []u8, usize } {
+        const row = d.f.dev.g.rowBytes(buf);
+        const host = try d.a.alloc(u8, rows * row);
+        try d.f.dev.st.synchronize();
+        try d.f.dev.b.mem[@backingInt(buf)].download(0, host);
+        return .{ host, row };
+    }
+
+    /// `rows` rows of `buf` as `<name>.npy`; `descr` is the element type (bf16 rows go out as their `<u2` bits).
+    fn save(d: *const Dump, name: []const u8, buf: Buf, rows: u32, descr: []const u8) !void {
+        const host, _ = try d.bytesOf(buf, rows);
+        try writeNpy(d.a, d.io, d.out, name, descr, rows, host);
+    }
+
+    /// The plan's sink: launch the op, then keep what it finished.
+    pub fn emit(d: *Dump, op: plan.Op) !void {
+        try d.f.dev.emit(op);
+        const n = d.rows;
+        switch (op) {
+            .embed => try d.save("emb", .emb, n, "<u2"),
+            .linear => |o| switch (o.w) {
+                .o => try d.save("attn", .part, n, "<f4"),
+                .dense_down => try d.save("mlp", .part, n, "<f4"),
+                .shared_down => try d.save("shared", .shr, n, "<f4"),
+                else => {},
+            },
+            .norm_add => |o| switch (o.norm) {
+                .input => try d.save("in_norm", .a, n, "<u2"),
+                .post => {
+                    try d.save("mid", .res, n, "<f4");
+                    try d.save("post_norm", .a, n, "<u2");
+                },
+                .final => {},
+            },
+            .router => try d.save("router_logits", .logits_r, n, "<f4"),
+            .route => {
+                try d.save("pick", .pick, n, "<i4");
+                try d.save("wts", .wts, n, "<f4");
+            },
+            .experts => |o| if (o.row0 + o.rows == n) try d.save("routed", .routed, n, "<f4"),
+            else => {},
+        }
+    }
+};
+
+fn upload(f: *fw.Forward, buf: Buf, bytes: []const u8) !void {
+    try f.dev.st.synchronize();
+    try f.dev.b.mem[@backingInt(buf)].upload(0, bytes);
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len < 4) {
+        std.debug.print("{s}", .{usage});
+        return error.MissingArgument;
+    }
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const io = gpu.io;
+    const dir = rest[0];
+    const layer = try std.fmt.parseInt(u16, rest[1], 10);
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ dir, "config.json" }), a, .limited(1 << 24));
+    const c = try mm.config.parse(a, text);
+    if (layer >= c.layers) return error.BadLayer;
+    const x = try readRows(a, io, rest[2], "<f4", c.hidden);
+    const n: u32 = @intCast(x.shape[0]);
+    if (n > mm.iface.prefill_rows) return error.TooManyRows;
+    const share = try mm.shard.Share.of(&c, 0, 1);
+
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    const t0 = check.now(io);
+    var loaded = try mm.weights_device.loadLayers(gpu.gpa, io, gpu.d, stream, dir, &c, share, &.{layer});
+    defer loaded.deinit();
+    std.debug.print("  layer {d}: {d} MiB of weights in {d:.1} s\n", .{ layer, loaded.bytes >> 20, @as(f64, @floatFromInt(check.now(io) - t0)) / 1e9 });
+
+    const g = try plan.Geometry.of(&c, share, layer + 1, n);
+    var m = try fw.Modules.load(gpu.d);
+    defer m.deinit();
+    const max_pages = mm.iface.maxPages(n);
+    var b = try fw.Buffers.init(gpu.d, &g, mm.rows_plan.Plan.fixed(g.kvh, max_pages).scratch);
+    defer b.deinit();
+    const dims = try mm.pool.Dims.of(&c, share);
+    var pool = try cuda.DeviceBuffer.alloc(gpu.d, max_pages * dims.pageBytes());
+    defer pool.free();
+    try pool.fill8(0, null);
+    var mirror = try rk.Mirror.init(gpu.d, 1, max_pages, mm.iface.shared_rows);
+    defer mirror.deinit();
+    const table = try a.alloc(i32, max_pages);
+    for (table, 0..) |*e, i| e.* = @intCast(i);
+    try mirror.put(0, 0, table);
+    const pages: fw.Pages = .{ .cache = .{ .pool = pool.ptr, .page_bytes = dims.pageBytes(), .layer_off = 0, .kvh = g.kvh }, .layer_bytes = dims.layerToken() * mm.pool.page_tokens, .mirror = &mirror };
+    var f = try fw.Forward.init(gpu.gpa, gpu.d, stream, &m, &loaded.weights, &g, &b, pages, null);
+    defer f.deinit(gpu.gpa);
+    var dump: Dump = .{ .a = a, .io = io, .f = &f, .out = rest[3], .rows = n };
+
+    // one prompt chunk at positions 0 .. n - 1 of slot 0: the rows enter as the residual (res = 0, then res += rows)
+    const sh: plan.Shape = .{ .rows = n, .prompt = true, .max_pos = n - 1, .head = .none };
+    try plan.check(&g, sh);
+    try dump.emit(.{ .stage = .{ .rows = n, .shared = false } });
+    if (rest.len > 4 and !std.mem.eql(u8, rest[4], "-")) {
+        const ids = try readRows(a, io, rest[4], "<i4", 1);
+        if (ids.shape[0] != n) return error.BadInput;
+        try upload(&f, .ids, ids.data);
+        try dump.emit(.{ .embed = .{ .rows = n } });
+    }
+    try dump.emit(.{ .zero = .{ .buf = .res, .rows = n } });
+    try upload(&f, .part, x.data);
+    try dump.emit(.{ .norm_add = .{ .x = .{ .buf = .part }, .x_f32 = true, .norm = .input, .layer = layer, .y = .{ .buf = .a }, .rows = n } });
+    const t1 = check.now(io);
+    try plan.planLayer(&g, sh, layer, &dump);
+    try dump.save("out", .res, n, "<f4");
+    const status = try f.dev.status();
+    std.debug.print("  layer {d}: {d} rows in {d:.1} ms (dumps included), status {d}\n", .{ layer, n, @as(f64, @floatFromInt(check.now(io) - t1)) / 1e6, status });
+    try check.expect(status == 0, "mm3-layer-parity: a launch found no page (status {d})", .{status});
+
+    if (rest.len > 5) try headRows(&dump, rest[5], c.hidden);
+    check.pass("mm3-layer-parity layer {d} rows {d}", .{ layer, n });
+}
+
+/// The final norm and the head on given rows (at most the head's 128): their fp32 logits as head.npy.
+fn headRows(d: *Dump, path: []const u8, hidden: u32) !void {
+    const x = try readRows(d.a, d.io, path, "<f4", hidden);
+    const rows: u32 = @intCast(x.shape[0]);
+    if (rows > plan.head_rows or rows > d.rows) return error.TooManyRows;
+    try d.f.dev.emit(.{ .zero = .{ .buf = .res, .rows = rows } });
+    try upload(d.f, .part, x.data);
+    try d.f.dev.emit(.{ .norm_add = .{ .x = .{ .buf = .part }, .x_f32 = true, .norm = .final, .layer = 0, .y = .{ .buf = .a }, .rows = rows } });
+    try d.f.dev.emit(.{ .linear = .{ .w = .head, .layer = 0, .x = .{ .buf = .a }, .y = .{ .buf = .hlog }, .rows = rows, .prompt = false } });
+    try d.save("final_norm", .a, rows, "<u2");
+    try d.save("head", .hlog, rows, "<f4");
+}
diff --git a/zig/tests/cuda/mm3_pack_moe.zig b/zig/tests/cuda/mm3_pack_moe.zig
new file mode 100644
index 0000000000000000000000000000000000000000..45b8982e77f8dbfe7dd0ecd738c4cefea5aca24d
--- /dev/null
+++ b/zig/tests/cuda/mm3_pack_moe.zig
@@ -0,0 +1,374 @@
+//! MiniMax-M3.1-Flash layer 18's routed experts (w1/w3 3 bits, w2 4, 128 experts, top-4) through the family's tables.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const quant_ref_tests = @import("quant_ref_tests.zig");
+const exl3fmt = @import("core").exl3_format;
+const exl3e = cuda.exl3_experts;
+const Run = @import("exl3_tests.zig").Run;
+const Rig = quant_ref_tests.RigT;
+const bf = quant_ref_tests.helpers.bfOf;
+
+const E = 128;
+const D = 6144;
+const SLOTS = 4;
+const halves = [3]u32{ 6, 6, 8 }; // gate (w1), up (w3), down (w2): 3, 3 and 4 bits for every expert
+const cap_rows = 256; // forward_plan.zig expert_rows: the scratch capacity the engine sizes
+const eps24 = 0x1p-24;
+const eps23 = 0x1p-23; // tensor-core sums may truncate: one unit of fp32 per add, not half
+
+pub const Case = struct { id: []const u8, width: usize, rows: []const usize };
+
+/// A TP2 rank's slice of the 3072-wide experts (the shape the engine launches), then the whole width.
+pub const cases = [_]Case{
+    .{ .id = "mm3.moe.layer18.w3-3-4.rank-width-1536", .width = 1536, .rows = &.{ 1, 2, 16, 32 } },
+    .{ .id = "mm3.moe.layer18.w3-3-4.full-width-3072", .width = 3072, .rows = &.{ 1, 8 } },
+};
+
+const Built = struct {
+    layer: exl3e.Layer,
+    w: [3][E][]i16,
+    sh: [6][]u16, // suh_g, suh_u [E, D], svh_g, svh_u, suh_d [E, I], svh_d [E, D]
+    x: []u16,
+    pick: []i32,
+    wts: []f32,
+    dx: u64,
+    dpick: u64,
+    dwts: u64,
+};
+
+fn f16v(v: u16) f64 {
+    return @floatCast(@as(f16, @bitCast(v)));
+}
+
+fn randScale(r: *Rig, out: []u16, half_range: f32) void {
+    for (out) |*v| v.* = @bitCast(@as(f16, @floatCast((r.rng.float(f32) * 2 - 1) * half_range)));
+}
+
+/// Random trellises for 128 experts, scales that cross the clamp of 7; row 0 routes to 127, 0, 64, 31, others random.
+fn build(r: *Rig, width: usize, rows: usize) !Built {
+    var b: Built = undefined;
+    var ptrs: [3][]u64 = undefined;
+    var k2: [3][E]i32 = undefined;
+    for (0..3) |j| {
+        ptrs[j] = try r.a.alloc(u64, E);
+        const kd: usize = if (j == 2) width else D;
+        const nd: usize = if (j == 2) D else width;
+        const words = (exl3fmt.Width{ .halves = @intCast(halves[j]) }).tileWords();
+        for (0..E) |e| {
+            b.w[j][e] = try r.a.alloc(i16, (kd / 16) * (nd / 16) * words);
+            r.rng.bytes(std.mem.sliceAsBytes(b.w[j][e]));
+            ptrs[j][e] = try r.dev(std.mem.sliceAsBytes(b.w[j][e]));
+            k2[j][e] = @intCast(halves[j]);
+        }
+    }
+    const lens = [6]usize{ E * D, E * D, E * width, E * width, E * width, E * D };
+    const ranges = [6]f32{ 0.25, 0.25, 1.0, 1.0, 0.25, 0.25 };
+    for (&b.sh, lens, ranges) |*s, n, h| {
+        s.* = try r.a.alloc(u16, n);
+        randScale(r, s.*, h);
+    }
+    var dsh: [6]u64 = undefined;
+    for (&dsh, b.sh) |*d, s| d.* = try r.dev(std.mem.sliceAsBytes(s));
+    const t: mm.weights.Tables = .{ .layer = 0, .gate = ptrs[0], .up = ptrs[1], .down = ptrs[2], .gate_k2 = &k2[0], .up_k2 = &k2[1], .down_k2 = &k2[2] };
+    const base = try r.dev(try mm.weights.packTables(r.a, t));
+    const zw: cuda.exl3.Weight = .{ .trellis = 0, .suh = 0, .svh = 0, .k = 0, .n = 0, .halves = 0, .codebook = .mul1, .stride_k = 0, .stride_nb = 0 };
+    // as weights.moeLayer describes a routed layer; uniformK2 is 0 here because w2's width differs from w1's and w3's
+    const l0: exl3e.Layer = .{ .gate = 0, .up = 0, .down = 0, .gate_k2 = 0, .up_k2 = 0, .down_k2 = 0, .suh_g = dsh[0], .suh_u = dsh[1], .svh_g = dsh[2], .svh_u = dsh[3], .suh_d = dsh[4], .svh_d = dsh[5], .experts = E, .dims = D, .width = width, .codebook = .mul1, .uniform_k2 = 0, .shared_input = false };
+    var lays = [1]mm.weights.Layer{.{ .q = zw, .k = zw, .v = zw, .o = zw, .ffn = .{ .moe = .{ .router = 0, .bias = 0, .experts = l0, .shared = .{ .gate = zw, .up = zw, .down = zw } } } }};
+    var wt: mm.weights.Weights = .{ .head = zw, .layers = &lays };
+    mm.weights.attachTables(&wt, t, mm.weights.tablePtrs(base, E), .{});
+    b.layer = wt.layers[0].ffn.moe.experts;
+    b.x = try r.bfs(rows * D, 1.0);
+    b.pick = try r.a.alloc(i32, rows * SLOTS);
+    for (0..rows) |row| {
+        var idx: [E]i32 = undefined;
+        for (&idx, 0..) |*v, i| v.* = @intCast(i);
+        var n: usize = E;
+        for (0..SLOTS) |k| {
+            const j = r.rng.uintLessThan(usize, n);
+            b.pick[row * SLOTS + k] = idx[j];
+            idx[j] = idx[n - 1];
+            n -= 1;
+        }
+    }
+    @memcpy(b.pick[0..SLOTS], &[_]i32{ 127, 0, 64, 31 });
+    b.wts = try r.a.alloc(f32, rows * SLOTS);
+    for (b.wts) |*v| v.* = 0.1 + 0.9 * r.rng.float(f32);
+    b.dx = try r.dev(std.mem.sliceAsBytes(b.x));
+    b.dpick = try r.dev(std.mem.sliceAsBytes(b.pick));
+    b.dwts = try r.dev(std.mem.sliceAsBytes(b.wts));
+    return b;
+}
+
+/// Each 128-run along a row replaced by the sum of its |entries| over sqrt(128): a Hadamard output's worst case.
+fn absRotateRows(x: []f64) void {
+    const inv = 1.0 / @sqrt(@as(f64, 128.0));
+    var c: usize = 0;
+    while (c + 128 <= x.len) : (c += 128) {
+        var s: f64 = 0;
+        for (x[c..][0..128]) |v| s += @abs(v);
+        for (x[c..][0..128]) |*v| v.* = s * inv;
+    }
+}
+
+fn used(b: *const Built, ex: usize, p: usize) bool {
+    for (b.pick[0..p]) |v| if (v == @as(i32, @intCast(ex))) return true;
+    return false;
+}
+
+/// Two fp32 roundings a 16-wide tensor-core step (adds may truncate: a whole unit), the split sums, and the margin.
+fn depth(k: usize) f64 {
+    return @floatFromInt(k / 8 + 8);
+}
+
+/// Rows of a slot's GEMM over k: z [p][n] and the sums of |x w|, from inputs x [p][k], expert by expert.
+fn gemmRows(r: *Rig, b: *const Built, j: usize, x: []const f64, k: usize, n: usize, p: usize, wh: u32, z: []f64, s1: []f64) !void {
+    const wq = try r.a.alloc(f16, k * n);
+    @memset(z, 0);
+    @memset(s1, 0);
+    for (0..E) |ex| {
+        if (!used(b, ex, p)) continue;
+        exl3fmt.unpack(.{ .halves = @intCast(wh) }, .mul1, b.w[j][ex], k / 16, n / 16, wq);
+        for (0..p) |s0| {
+            if (b.pick[s0] != @as(i32, @intCast(ex))) continue;
+            const zr = z[s0 * n ..][0..n];
+            const sr = s1[s0 * n ..][0..n];
+            for (0..k) |ki| {
+                const t = x[s0 * k + ki];
+                const ta = @abs(t);
+                const row = wq[ki * n ..][0..n];
+                for (zr, sr, row) |*zv, *sv, wv| {
+                    const w: f64 = @floatCast(wv);
+                    zv.* += t * w;
+                    sv.* += ta * @abs(w);
+                }
+            }
+        }
+    }
+}
+
+/// z rotated along each slot's row in place; `err` gets its bound from the sums' depth and the Hadamard.
+fn rotRows(r: *Rig, z: []f64, s1: []const f64, n: usize, p: usize, k: usize, err: []f64) !void {
+    const za = try r.a.alloc(f64, z.len);
+    for (err, s1, za, z) |*e, s, *a, v| {
+        e.* = depth(k) * eps23 * s;
+        a.* = @abs(v);
+    }
+    exl3fmt.rotate(z, p, n, 1);
+    absRotateRows(err);
+    absRotateRows(za);
+    for (err, za) |*e, a| e.* += 9 * eps24 * a;
+}
+
+/// rot_in: x * suh rotated to fp16 (exact values and each one's bound: the fp32 product and Hadamard, the fp16 store).
+fn inStage(b: *const Built, j: usize, p: usize, out: []f64, tol: []f64) void {
+    for (0..p) |s0| {
+        const ex: usize = @intCast(b.pick[s0]);
+        const o = out[s0 * D ..][0..D];
+        const t = tol[s0 * D ..][0..D];
+        for (o, t, 0..) |*v, *e, i| {
+            v.* = bf(b.x[(s0 / SLOTS) * D + i]) * f16v(b.sh[j][ex * D + i]);
+            e.* = @abs(v.*);
+        }
+        exl3fmt.rotate(o, 1, D, 1);
+        absRotateRows(t);
+        for (t, o) |*e, v| e.* = (9 * eps24 * e.* + @abs(v) * 0x1p-11) * (1 + 0x1p-10) + 0x1p-25;
+    }
+}
+
+/// Gate/up GEMMs from fp16 inputs, Hadamard, svh, fp32 swigluoai (up bias `ub`), suh_d, Hadamard: xd [p][I], bounds.
+fn actStage(r: *Rig, b: *const Built, I: usize, p: usize, xg: []const f64, xu: []const f64, ub: f64, out: []f64, tol: []f64) !void {
+    const l = b.layer;
+    var z: [2][]f64 = undefined;
+    var e: [2][]f64 = undefined;
+    const s1 = try r.a.alloc(f64, p * I);
+    for (0..2) |j| {
+        z[j] = try r.a.alloc(f64, p * I);
+        e[j] = try r.a.alloc(f64, p * I);
+        try gemmRows(r, b, j, if (j == 0) xg else xu, D, I, p, halves[j], z[j], s1);
+        try rotRows(r, z[j], s1, I, p, D, e[j]);
+    }
+    const lim: f64 = l.limit;
+    const alpha: f64 = l.alpha;
+    for (0..p) |s0| for (0..I) |n| {
+        const ex: usize = @intCast(b.pick[s0]);
+        const i = s0 * I + n;
+        const hg = f16v(b.sh[2][ex * I + n]);
+        const hu = f16v(b.sh[3][ex * I + n]);
+        const vg = z[0][i] * hg;
+        const vu = z[1][i] * hu;
+        const egk = e[0][i] * @abs(hg) + 3 * eps24 * @abs(vg);
+        const euk = e[1][i] * @abs(hu) + 3 * eps24 * @abs(vu);
+        const gg = if (l.act_mode == 3) std.math.clamp(vg, -lim, lim) else @min(vg, lim);
+        const uu = std.math.clamp(vu, -lim, lim);
+        const x = alpha * gg;
+        const sg = gg / (1 + @exp(-x));
+        const act = sg * (uu + ub);
+        const sd = f16v(b.sh[4][ex * I + n]);
+        out[i] = act * sd;
+        // d(g sigmoid(a g))/dg <= 1.1, d(act)/du = sg, clamps 1-Lipschitz; exp 2 ulps, add, div, add, mul
+        const eact = 1.1 * egk * (@abs(uu + ub) + euk) + @abs(sg) * euk + @abs(act) * (8 + @abs(x)) * eps24;
+        tol[i] = eact * @abs(sd) + @abs(out[i]) * eps24;
+    };
+    const va = try r.a.alloc(f64, p * I);
+    for (va, out) |*a, v| a.* = @abs(v);
+    exl3fmt.rotate(out, p, I, 1);
+    absRotateRows(tol);
+    absRotateRows(va);
+    for (tol, va, out) |*t, a, v| t.* = (t.* + 9 * eps24 * a + @abs(v) * 0x1p-11) * (1 + 0x1p-10) + 0x1p-25;
+}
+
+/// Down from fp16 inputs [p][I] at `wh` half-bits, Hadamard and svh, the fma chain over 4 slots: [m][D] and bounds.
+fn downStage(r: *Rig, b: *const Built, I: usize, m: usize, xd: []const f64, wh: u32, want: []f64, tol: []f64) !void {
+    const p = m * SLOTS;
+    const z = try r.a.alloc(f64, p * D);
+    const s1 = try r.a.alloc(f64, p * D);
+    const e = try r.a.alloc(f64, p * D);
+    try gemmRows(r, b, 2, xd, I, D, p, wh, z, s1);
+    try rotRows(r, z, s1, D, p, I, e);
+    for (0..m) |row| for (0..D) |d| {
+        var acc: f64 = 0;
+        var err: f64 = 0;
+        var swy: f64 = 0;
+        for (0..SLOTS) |k| {
+            const s0 = row * SLOTS + k;
+            const ex: usize = @intCast(b.pick[s0]);
+            const sv = f16v(b.sh[5][ex * D + d]);
+            const y = z[s0 * D + d] * sv;
+            const w: f64 = b.wts[s0];
+            acc += w * y;
+            err += @abs(w) * (e[s0 * D + d] * @abs(sv) + 3 * eps24 * @abs(y));
+            swy += @abs(w * y);
+        }
+        want[row * D + d] = acc;
+        tol[row * D + d] = err + (SLOTS + 1) * eps24 * (swy + err) + 1e-30;
+    };
+}
+
+/// The worst |got - want| / tol, where it is, and the max abs and relative errors (relative where |want| > 1% of max).
+const Miss = struct { q: f64 = 0, at: usize = 0, abs: f64 = 0, rel: f64 = 0, top: f64 = 0 };
+
+fn miss(got: []const f64, want: []const f64, tol: ?[]const f64) Miss {
+    var o: Miss = .{};
+    for (want) |w| o.top = @max(o.top, @abs(w));
+    for (got, want, 0..) |g, w, i| {
+        const e = @abs(g - w);
+        if (tol) |t| {
+            const q = e / t[i];
+            if (!(q <= o.q)) {
+                o.q = q;
+                o.at = i;
+            }
+        }
+        o.abs = @max(o.abs, e);
+        if (@abs(w) > 0.01 * o.top) o.rel = @max(o.rel, e / @abs(w));
+    }
+    return o;
+}
+
+fn halfs(r: *Rig, ptr: u64, n: usize) ![]f64 {
+    const raw = try r.back(ptr, n * 2);
+    const out = try r.a.alloc(f64, n);
+    for (out, 0..) |*o, i| o.* = f16v(std.mem.bytesToValue(u16, raw[2 * i ..][0..2]));
+    return out;
+}
+
+fn floats(r: *Rig, ptr: u64, n: usize) ![]f64 {
+    const raw = try r.back(ptr, n * 4);
+    const out = try r.a.alloc(f64, n);
+    for (out, 0..) |*o, i| o.* = std.mem.bytesToValue(f32, raw[4 * i ..][0..4]);
+    return out;
+}
+
+fn say(id: []const u8, what: []const u8, m: usize, cols: usize, x: Miss) void {
+    std.debug.print("RESULT {s} {s} rows={d}: worst {d:.4} of the bound (slot or row {d}, col {d}), max abs err {e:.3} (max |want| {e:.3}), max rel err {e:.3}\n", .{ id, what, m, x.q, x.at / cols, x.at % cols, x.abs, x.top, x.rel });
+}
+
+/// Each stage from the kernel's previous one (scratch xg, xu, xd) within its bound; two planted controls must miss.
+fn stages(r: *Rig, b: *const Built, I: usize, m: usize, sc: exl3e.Scratch, out: u64, id: []const u8) !void {
+    const p = m * SLOTS;
+    const xg = try halfs(r, sc.xg, p * D);
+    const xu = try halfs(r, sc.xu, p * D);
+    const xd = try halfs(r, sc.xd, p * I);
+    const got = try floats(r, out, m * D);
+    const v_in = try r.a.alloc(f64, p * D);
+    const t_in = try r.a.alloc(f64, p * D);
+    const v_in2 = try r.a.alloc(f64, p * D);
+    var fail = false;
+    for ([_][]const f64{ xg, xu }, 0..) |k_in, j| {
+        inStage(b, j, p, if (j == 0) v_in2 else v_in, t_in);
+        const x = miss(k_in, if (j == 0) v_in2 else v_in, t_in);
+        say(id, if (j == 0) "stage rot_in gate" else "stage rot_in up", m, D, x);
+        fail = fail or !(x.q <= 1);
+    }
+    const v_xd = try r.a.alloc(f64, p * I);
+    const t_xd = try r.a.alloc(f64, p * I);
+    try actStage(r, b, I, p, xg, xu, b.layer.up_bias, v_xd, t_xd);
+    const xa = miss(xd, v_xd, t_xd);
+    say(id, "stage gate/up + swigluoai -> fp16 down input", m, I, xa);
+    fail = fail or !(xa.q <= 1);
+    const want = try r.a.alloc(f64, m * D);
+    const tol = try r.a.alloc(f64, m * D);
+    try downStage(r, b, I, m, xd, halves[2], want, tol);
+    const xo = miss(got, want, tol);
+    say(id, "stage down + combine", m, D, xo);
+    fail = fail or !(xo.q <= 1);
+    // planted controls: each must miss its stage's bound
+    try actStage(r, b, I, p, xg, xu, 0, v_xd, t_xd);
+    const c1 = miss(xd, v_xd, t_xd);
+    std.debug.print("CONTROL {s} up bias 0: {d:.1} of the bound ({s})\n", .{ id, c1.q, if (c1.q > 1) "red, as planted" else "MISSED" });
+    try downStage(r, b, I, m, xd, 6, want, tol);
+    const c2 = miss(got, want, tol);
+    std.debug.print("CONTROL {s} down read at 3 bits: {d:.1} of the bound ({s})\n", .{ id, c2.q, if (c2.q > 1) "red, as planted" else "MISSED" });
+    fail = fail or !(c1.q > 1) or !(c2.q > 1);
+    // the whole chain in float64 from x: informational error figures
+    inStage(b, 0, p, v_in2, t_in);
+    inStage(b, 1, p, v_in, t_in);
+    try actStage(r, b, I, p, v_in2, v_in, b.layer.up_bias, v_xd, t_xd);
+    try downStage(r, b, I, m, v_xd, halves[2], want, tol);
+    say(id, "end to end vs float64 (not gated)", m, D, miss(got, want, null));
+    if (fail) return error.TestFailed;
+}
+
+fn one(gpu: check.Gpu, s: cuda.Stream, exp: *const exl3e.Experts, c: Case, seed: u64) !void {
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(seed);
+    var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = s, .rng = prng.random() };
+    defer {
+        for (r.bufs.items) |*x| x.free();
+        r.bufs.deinit(gpu.gpa);
+    }
+    var most: usize = 0;
+    for (c.rows) |m| most = @max(most, m);
+    const b = try build(&r, c.width, most);
+    if (b.layer.act_mode != 2 or b.layer.limit != 7 or b.layer.alpha != 1.702 or b.layer.up_bias != 1) return error.NotSwigluoai;
+    const sb = try r.zeros(try exl3e.scratchBytes(b.layer, cap_rows, SLOTS));
+    const sc = try exl3e.scratch(sb, b.layer, cap_rows, SLOTS);
+    const big = try r.zeros(most * D * 4);
+    try exp.run(r.s, b.layer, b.dx, D, .bf16, b.dpick, b.dwts, most, big, sc);
+    try stages(&r, &b, c.width, most, sc, big, c.id);
+    // every smaller call's rows are the first rows of the largest call, byte for byte
+    const ref = try r.back(big, most * D * 4);
+    for (c.rows) |m| {
+        if (m == most) continue;
+        const out = try r.zeros(m * D * 4);
+        try exp.run(r.s, b.layer, b.dx, D, .bf16, b.dpick, b.dwts, m, out, sc);
+        const id = try std.fmt.allocPrint(r.a, "{s} rows={d} against the first rows of rows={d}", .{ c.id, m, most });
+        try check.sameBytes(id, try r.back(out, m * D * 4), ref[0 .. m * D * 4]);
+    }
+}
+
+pub fn run(gpu: check.Gpu, s: cuda.Stream, state: *Run) !void {
+    var exp = try exl3e.Experts.load(gpu.d);
+    defer exp.unload();
+    for (cases, 0..) |c, i| {
+        one(gpu, s, &exp, c, 0x6d6f65 + i) catch |e| {
+            state.fail(e, c.id);
+            continue;
+        };
+        check.pass("{s}", .{c.id});
+    }
+}
diff --git a/zig/tests/cuda/mm3_pack_tests.zig b/zig/tests/cuda/mm3_pack_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4f86dc0a87dcd871ef43e666da0a62da1442b4ed
--- /dev/null
+++ b/zig/tests/cuda/mm3_pack_tests.zig
@@ -0,0 +1,123 @@
+//! tf-cuda-test mm3-pack: 8-bit k/v (6144 x 512, TP2 rank cuts of 256) through exl3.Dense, then layer 18's experts.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const quant_ref_tests = @import("quant_ref_tests.zig");
+const exl3fmt = @import("core").exl3_format;
+const dense_t = @import("exl3_dense_tests.zig");
+const exl3 = cuda.exl3;
+const Run = @import("exl3_tests.zig").Run;
+const Rig = quant_ref_tests.RigT;
+const bf = quant_ref_tests.helpers.bfOf;
+
+const K = 6144; // hidden
+const N = 512; // 4 kv heads x 128
+const RANK_N = 256; // 2 kv heads a rank at TP2
+const HALVES = 16; // 8 bits
+const PROMPT = 300; // a prompt call: 128-row blocks and a 44-row tail
+const decode_rows = [_]usize{ 1, 2, 16, 128 };
+
+/// bf16 outputs within exl3_tests' tolerance (|want| / 128 + 2^-11 of |t| sums, above gamma(6144) = 3.7e-4 of them).
+fn compare(r: *Rig, id: []const u8, ptr: u64, m: usize, n: usize, want: []const f64, tol: []const f64, ld: usize, col0: usize) !void {
+    const raw = try r.back(ptr, m * n * 2);
+    var most: f64 = 0;
+    var at_r: usize = 0;
+    var at_c: usize = 0;
+    var max_abs: f64 = 0;
+    var max_rel: f64 = 0;
+    var top: f64 = 0;
+    for (0..m) |row| for (0..n) |col| {
+        top = @max(top, @abs(want[row * ld + col0 + col]));
+    };
+    for (0..m) |row| for (0..n) |col| {
+        const w = want[row * ld + col0 + col];
+        const got = bf(std.mem.bytesToValue(u16, raw[2 * (row * n + col) ..][0..2]));
+        const e = @abs(got - w);
+        const q = e / tol[row * ld + col0 + col];
+        if (!(q <= most)) {
+            most = q;
+            at_r = row;
+            at_c = col;
+        }
+        max_abs = @max(max_abs, e);
+        if (@abs(w) > 0.01 * top) max_rel = @max(max_rel, e / @abs(w));
+    };
+    std.debug.print("RESULT {s} rows={d}: worst {d:.4} of the tolerance (row {d} col {d}), max abs err {e:.3} (max |want| {e:.3}), max rel err {e:.3} where |want| > 1% of max\n", .{ id, m, most, at_r, at_c, max_abs, top, max_rel });
+    if (!(most <= 1)) {
+        std.debug.print("FAIL {s} rows={d}: largest difference {d:.3} of its tolerance\n", .{ id, m, most });
+        return error.TestFailed;
+    }
+}
+
+/// A rank's columns [rank * RANK_N, +RANK_N) of the stored [K/16][N/16][W] trellis, repacked contiguous, with its svh.
+fn cut(r: *Rig, trellis: []const i16, svh: []const u16, rank: usize) !struct { []i16, []u16 } {
+    const words = (exl3fmt.Width{ .halves = HALVES }).tileWords();
+    const nt = N / 16;
+    const rt = RANK_N / 16;
+    const out = try r.a.alloc(i16, (K / 16) * rt * words);
+    for (0..K / 16) |kt| @memcpy(out[kt * rt * words ..][0 .. rt * words], trellis[(kt * nt + rank * rt) * words ..][0 .. rt * words]);
+    return .{ out, try r.a.dupe(u16, svh[rank * RANK_N ..][0..RANK_N]) };
+}
+
+fn kv(r: *Rig, de: *exl3.Dense, which: []const u8) !void {
+    const width: exl3fmt.Width = .{ .halves = HALVES };
+    const trellis, const suh, const svh = try dense_t.tensors(r, K, N, width);
+    const x = try r.bfs(PROMPT * K, 1.0);
+    const dx = try r.dev(std.mem.sliceAsBytes(x));
+    const ref = try dense_t.promptReference(r, width, .mul1, trellis, K, N, x, suh, svh, PROMPT);
+    const w = try dense_t.weight(r, trellis, suh, svh, K, N, HALVES, .mul1);
+    const full_id = try std.fmt.allocPrint(r.a, "mm3.{s}_proj.exl3-8bit.k6144.n512", .{which});
+    for (decode_rows) |m| {
+        const y = try r.zeros(m * N * 2);
+        try de.decode(r.s, w, dx, .bf16, m, y, .bf16);
+        try compare(r, full_id, y, m, N, ref.want, ref.tol, N, 0);
+    }
+    const yfull = try r.zeros(PROMPT * N * 2);
+    try de.prompt(r.s, w, dx, .bf16, PROMPT, yfull, .bf16);
+    try compare(r, full_id, yfull, PROMPT, N, ref.want, ref.tol, N, 0);
+    const full = try r.back(yfull, PROMPT * N * 2);
+    for (0..2) |rank| {
+        const tr, const sv = try cut(r, trellis, svh, rank);
+        const wr = try dense_t.weight(r, tr, suh, sv, K, RANK_N, HALVES, .mul1);
+        const id = try std.fmt.allocPrint(r.a, "mm3.{s}_proj.exl3-8bit.k6144.n256.rank{d}", .{ which, rank });
+        for ([_]usize{ 1, 16 }) |m| {
+            const y = try r.zeros(m * RANK_N * 2);
+            try de.decode(r.s, wr, dx, .bf16, m, y, .bf16);
+            try compare(r, id, y, m, RANK_N, ref.want, ref.tol, N, rank * RANK_N);
+        }
+        const y = try r.zeros(PROMPT * RANK_N * 2);
+        try de.prompt(r.s, wr, dx, .bf16, PROMPT, y, .bf16);
+        try compare(r, id, y, PROMPT, RANK_N, ref.want, ref.tol, N, rank * RANK_N);
+        // informational: the rank cut against the full matrix' columns (the same plan, so the same sums are expected)
+        const got = try r.back(y, PROMPT * RANK_N * 2);
+        var differ: usize = 0;
+        for (0..PROMPT) |row| {
+            if (!std.mem.eql(u8, got[row * RANK_N * 2 ..][0 .. RANK_N * 2], full[(row * N + rank * RANK_N) * 2 ..][0 .. RANK_N * 2])) differ += 1;
+        }
+        std.debug.print("INFO {s}: {d} of {d} prompt rows differ in bytes from the full matrix' columns (plan sk {d} vs {d})\n", .{ id, differ, PROMPT, exl3.plan(K, RANK_N, 192, 8).sk, exl3.plan(K, N, 192, 8).sk });
+    }
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var state = Run{};
+    {
+        var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+        defer arena.deinit();
+        var prng = std.Random.DefaultPrng.init(0x6b76);
+        var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = s, .rng = prng.random() };
+        defer {
+            for (r.bufs.items) |*b| b.free();
+            r.bufs.deinit(gpu.gpa);
+        }
+        var de = try exl3.Dense.load(gpu.d);
+        defer de.unload();
+        for ([_][]const u8{ "k", "v" }) |which| {
+            const id = try std.fmt.allocPrint(r.a, "mm3.{s}_proj.exl3-8bit", .{which});
+            if (kv(&r, &de, which)) check.pass("{s}", .{id}) else |e| state.fail(e, id);
+        }
+    }
+    try @import("mm3_pack_moe.zig").run(gpu, s, &state);
+    if (state.failed) return error.TestFailed;
+}
diff --git a/zig/tests/cuda/mm3_plan_wire.zig b/zig/tests/cuda/mm3_plan_wire.zig
new file mode 100644
index 0000000000000000000000000000000000000000..917caf27b1b6cdf1e01dde2b513ab5a2f74598b1
--- /dev/null
+++ b/zig/tests/cuda/mm3_plan_wire.zig
@@ -0,0 +1,55 @@
+//! tf-cuda-test mm3-plan-wire: TF_MM3_PLAN_INLINE's step split through ncclBroadcast into mapped host memory, one GPU.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const Gpu = check.Gpu;
+
+const ed = mm.engine_dev;
+const Header = mm.iface.Header;
+
+/// Every step size the wire meets, at both edges of the first message and of the u7 the split once was.
+const sizes = [_]usize{ 1, 31, 32, 33, 111, 112, 113, 2048, 8192 };
+
+pub fn run(gpu: Gpu) !void {
+    const d = gpu.d;
+    var lib = try cuda.nccl.Library.open();
+    defer lib.close();
+    var comms: [1]cuda.nccl.Comm = .{null};
+    const devices = [1]c_int{gpu.ctx.device};
+    try lib.check(lib.api.ncclCommInitAll(&comms, 1, &devices), "ncclCommInitAll");
+    defer _ = lib.api.ncclCommDestroy(comms[0]);
+    var s = try cuda.Stream.init(d, false);
+    defer s.deinit();
+    const most = sizes[sizes.len - 1];
+    const bytes = ed.inline_bytes + most * 4;
+    var src = try cuda.DeviceBuffer.alloc(d, bytes); // rank 0's send buffer, as NcclWire's
+    defer src.free();
+    var land = try cuda.HostBuffer.allocMapped(d, bytes); // a receiver's mapped landing place
+    defer land.free();
+    const land_dev = try land.device();
+    const ids = try gpu.gpa.alloc(u32, most);
+    defer gpu.gpa.free(ids);
+    const out = try gpu.gpa.alloc(u32, most);
+    defer gpu.gpa.free(out);
+    for (sizes) |n| {
+        for (ids[0..n], 0..) |*x, i| x.* = @intCast((i *% 2654435761 +% n) % 200064);
+        @memset(land.bytes, 0xa5);
+        @memset(out, 0xffff_ffff);
+        const h: Header = .{ .kind = 7, .n = @intCast(n), .depth = 5 };
+        var msg: [ed.inline_bytes]u8 align(4) = undefined;
+        const head = ed.packFirst(&msg, &h, ids[0..n]);
+        try src.uploadAsync(0, &msg, s.handle);
+        try lib.check(lib.api.ncclBroadcast(src.ptr, land_dev, ed.inline_bytes, .u8, 0, comms[0], s.handle), "ncclBroadcast");
+        if (n > head) {
+            try src.uploadAsync(ed.inline_bytes, std.mem.sliceAsBytes(ids[head..n]), s.handle);
+            try lib.check(lib.api.ncclBroadcast(src.ptr + ed.inline_bytes, land_dev + ed.inline_bytes, (n - head) * 4, .u8, 0, comms[0], s.handle), "ncclBroadcast");
+        }
+        try s.synchronize();
+        const got = try ed.unpackFirst(land.bytes[0..ed.inline_bytes], out);
+        try check.expect(got.n == n and got.depth == 5 and got.kind == 7, "mm3-plan-wire: header of a {d}-id step", .{n});
+        if (n > head) @memcpy(std.mem.sliceAsBytes(out[head..n]), land.bytes[ed.inline_bytes..][0 .. (n - head) * 4]);
+        try check.sameBytes("mm3-plan-wire ids", std.mem.sliceAsBytes(out[0..n]), std.mem.sliceAsBytes(ids[0..n]));
+    }
+    check.pass("mm3-plan-wire: steps of {any} ids cross ncclBroadcast into mapped host memory whole (1 or 2 messages)", .{sizes});
+}
diff --git a/zig/tests/cuda/mm3_prefill_prof.zig b/zig/tests/cuda/mm3_prefill_prof.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e9e3a0fb3aaded2cc970612884bc96ac4ed938e2
--- /dev/null
+++ b/zig/tests/cuda/mm3_prefill_prof.zig
@@ -0,0 +1,213 @@
+//! tf-cuda-test mm3-prefill-prof [LAYERS] [reps=N] [moe=M]: TP2 rank 0's 2,048-row prompt chunk per op, 60 layers.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const synth = @import("mm3_synth.zig");
+
+const plan = mm.forward_plan;
+const Stage = plan.Stage;
+const Geometry = plan.Geometry;
+const stages = std.enums.values(Stage);
+const chunk: u32 = 2048;
+const depths = [_]u32{ 2048, 32768 };
+
+const Args = struct { layers: u32 = 5, reps: u32 = 3, first_moe: ?u32 = null };
+
+fn parseArgs(rest: []const [:0]const u8) !Args {
+    var a: Args = .{};
+    for (rest, 0..) |s, i| {
+        if (std.mem.startsWith(u8, s, "reps=")) {
+            a.reps = try std.fmt.parseInt(u32, s[5..], 10);
+        } else if (std.mem.startsWith(u8, s, "moe=")) {
+            a.first_moe = try std.fmt.parseInt(u32, s[4..], 10);
+        } else if (i == 0) {
+            a.layers = try std.fmt.parseInt(u32, s, 10);
+        } else return error.BadArgument;
+    }
+    if (a.reps == 0 or a.layers == 0) return error.BadArgument;
+    return a;
+}
+
+/// Ms per chunk of each stage: before the layers and the head, summed over dense layers, summed over routed layers.
+const Split = struct {
+    edge: [stages.len]f64 = @splat(0),
+    dense: [stages.len]f64 = @splat(0),
+    moe: [stages.len]f64 = @splat(0),
+    gaps: f64 = 0,
+    span: f64 = 0,
+    steps: u64 = 0,
+};
+
+fn splitOf(f: anytype, g: *const Geometry) Split {
+    const a = &f.prof.?.agg;
+    var s: Split = .{ .steps = a.steps, .span = a.span_ms };
+    if (a.steps == 0) return s;
+    const n: f64 = @floatFromInt(a.steps);
+    for (a.labels.items, a.op_ms.items, a.gap_ms.items) |l, o, gp| {
+        const i = @backingInt(l.stage);
+        const v = o / n;
+        if (l.layer < 0) s.edge[i] += v else if (g.isMoe(@intCast(l.layer))) s.moe[i] += v else s.dense[i] += v;
+        s.gaps += gp / n;
+    }
+    s.span /= @floatFromInt(a.timed);
+    return s;
+}
+
+/// Flops of one layer's stage for the chunk's rows from position pos0 (0: a stage not counted in flops).
+fn flops(g: *const Geometry, st: Stage, rows: u32, pos0: u32) f64 {
+    const r: f64 = @floatFromInt(rows);
+    const h: f64 = @floatFromInt(g.hidden);
+    const mid: f64 = @as(f64, @floatFromInt(pos0)) + (r + 1) / 2; // mean keys a row sees
+    var keys: f64 = 0; // attended keys over the rows: min(pos + 1, 16 blocks of 128)
+    var p: u32 = pos0;
+    while (p < pos0 + rows) : (p += 1) keys += @floatFromInt(@min(p + 1, 16 * 128));
+    const f = std.math.lossyCast;
+    return switch (st) {
+        .proj_q => 2 * r * h * f(f64, g.q_w),
+        .proj_k, .proj_v => 2 * r * h * f(f64, g.kv_w),
+        .proj_o => 2 * r * h * f(f64, g.q_w),
+        .index_proj => 2 * r * h * f(f64, g.iq_w + g.ik_w),
+        .score => 2 * r * mid * f(f64, g.kvh) * 128,
+        .attend => 4 * keys * f(f64, g.nq) * 128,
+        .router => 2 * r * h * f(f64, g.experts),
+        .experts => 2 * r * f(f64, g.topk) * 3 * h * f(f64, g.moe_w),
+        .shared_gate, .shared_up, .shared_down => 2 * r * h * f(f64, g.shared_w),
+        .dense_gate, .dense_up, .dense_down => 2 * r * h * f(f64, g.dense_w),
+        .head => 2 * h * f(f64, g.own_vocab),
+        else => 0,
+    };
+}
+
+/// Dense and routed layers of the shipped model.
+fn fullCounts(cfg: anytype) [2]f64 {
+    var dense: f64 = 0;
+    var moe: f64 = 0;
+    for (0..cfg.layers) |l| {
+        if (cfg.isMoe(@intCast(l))) moe += 1 else dense += 1;
+    }
+    return .{ dense, moe };
+}
+
+fn countLayers(g: *const Geometry) [2]f64 {
+    var dense: f64 = 0;
+    var moe: f64 = 0;
+    for (0..g.layers) |l| {
+        if (g.isMoe(@intCast(l))) moe += 1 else dense += 1;
+    }
+    return .{ dense, moe };
+}
+
+/// The table of one depth: each stage's 60-layer ms per chunk, share, per-layer ms and TFLOP/s; returns the total.
+fn report(g: *const Geometry, s: Split, full: [2]f64, depth: u32) f64 {
+    const thin = countLayers(g);
+    const pos0 = depth - chunk;
+    var total: f64 = 0;
+    var est: [stages.len]f64 = @splat(0);
+    for (stages, 0..) |_, i| {
+        const d = if (thin[0] > 0) s.dense[i] / thin[0] * full[0] else 0;
+        const m = if (thin[1] > 0) s.moe[i] / thin[1] * full[1] else 0;
+        est[i] = s.edge[i] + d + m;
+        total += est[i];
+    }
+    std.debug.print("TABLE mm3-prefill-prof depth={d} (chunk rows {d}..{d}), {d} reps, thin {d}+{d} layers -> {d}+{d}\n", .{ depth, pos0, depth - 1, s.steps, thin[0], thin[1], full[0], full[1] });
+    std.debug.print("  {s:<16} {s:>10} {s:>7} {s:>12} {s:>10}\n", .{ "stage", "ms/chunk", "share", "ms/layer", "TFLOP/s" });
+    for (stages, 0..) |st, i| {
+        if (est[i] == 0) continue;
+        const layers = (if (s.dense[i] > 0) full[0] else 0) + (if (s.moe[i] > 0) full[1] else 0);
+        const per = if (layers > 0) (est[i] - s.edge[i]) / layers else est[i];
+        const fl = flops(g, st, chunk, pos0);
+        const tf = if (fl > 0 and per > 0) fl / (per * 1e-3) / 1e12 else 0;
+        std.debug.print("  {s:<16} {d:>10.2} {d:>6.1}% {d:>12.4} {d:>10.2}\n", .{ @tagName(st), est[i], 100 * est[i] / total, per, tf });
+    }
+    const thin_total = blk: {
+        var t: f64 = 0;
+        for (s.edge, s.dense, s.moe) |a, b, c| t += a + b + c;
+        break :blk t;
+    };
+    std.debug.print("RESULT mm3-prefill-prof depth={d}: thin chunk {d:.2} ms (span {d:.2}, gaps {d:.2}); 60 layers {d:.1} ms -> {d:.0} tok/s a rank\n", .{ depth, thin_total, s.span, s.gaps, total, @as(f64, @floatFromInt(chunk)) / (total * 1e-3) });
+    return total;
+}
+
+fn randomIds(gpa: std.mem.Allocator, n: usize, vocab: u32) ![]i32 {
+    var prng = std.Random.DefaultPrng.init(0x70726566);
+    const ids = try gpa.alloc(i32, n);
+    for (ids) |*p| p.* = @intCast(prng.random().uintLessThan(u32, vocab));
+    return ids;
+}
+
+/// Geometry switches of the prompt path, each changing no bit: arm k runs with the first k on (arm 0: all off).
+const toggles = [_][]const u8{ "prompt_score", "attn_share", "side_shared" };
+
+fn setArm(m: *synth.Model, k: usize) void {
+    inline for (toggles, 0..) |name, i| @field(m.geo, name) = i < k;
+}
+
+fn armName(k: usize) []const u8 {
+    return if (k == 0) "off" else toggles[k - 1];
+}
+
+/// One arm at one depth: the unprofiled wall time, then the profiled chunks; the last logits' hash.
+fn arm(gpa: std.mem.Allocator, io: std.Io, m: *synth.Model, ids: []const i32, depth: u32, reps: u32, full: [2]f64, k: usize) !?u64 {
+    const f = m.fwd();
+    try f.useProf(gpa, .{ .on = false });
+    const plain = try m.prefill(0, ids[0..depth], chunk); // warm-up, and the unprofiled token
+    const hash = std.hash.Wyhash.hash(0, std.mem.sliceAsBytes(m.lastLogits()));
+    var wall: [16]f64 = undefined;
+    for (wall[0..reps]) |*t| {
+        const t0 = check.now(io);
+        _ = try m.prefill(0, ids[0..depth], chunk);
+        t.* = @as(f64, @floatFromInt(check.now(io) - t0)) / 1e6;
+    }
+    const med = check.median(wall[0..reps]);
+    try f.useProf(gpa, .{ .on = true, .every = 1, .prompt = depth, .out = "/tmp/tf-cuda-test-mm3-prefill-prof" });
+    var same = true;
+    for (0..reps) |_| same = same and (try m.prefill(0, ids[0..depth], chunk)) == plain;
+    same = same and std.hash.Wyhash.hash(0, std.mem.sliceAsBytes(m.lastLogits())) == hash;
+    const s = splitOf(f, m.geometry());
+    const ag = &f.prof.?.agg;
+    if (!same or s.steps != reps or ag.unread != 0 or ag.mismatch != 0) {
+        std.debug.print("FAIL mm3.prefill-prof arm={s} depth={d}: profiled logits equal {}, steps {d} of {d}, unread {d}, mismatch {d}\n", .{ armName(k), depth, same, s.steps, reps, ag.unread, ag.mismatch });
+        return null;
+    }
+    std.debug.print("ARM {s}\n", .{armName(k)});
+    const total = report(m.geometry(), s, full, depth);
+    std.debug.print("RESULT mm3-prefill-prof arm={s} depth={d}: 60-layer chunk {d:.1} ms; thin whole {d}-token prompt {d:.1} ms unprofiled ({d:.0} tok/s, median of {d}); logits {x:0>16}\n", .{ armName(k), depth, total, depth, med, @as(f64, @floatFromInt(depth)) / (med * 1e-3), reps, hash });
+    return hash;
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    const gpa = gpu.gpa;
+    const a = try parseArgs(rest);
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    const cap = depths[depths.len - 1] + 128;
+    const o: synth.Options = .{ .layers = a.layers, .slots = 1, .capacity_tokens = cap, .first_moe = a.first_moe, .world = 2, .widths = synth.pack_widths, .prompt_experts = true };
+    const m = try synth.Model.init(gpa, gpu.d, stream, o);
+    defer m.deinit();
+    const shipped = try mm.config.parse(gpa, mm.config.fixture);
+    const full = fullCounts(&shipped);
+    const ids = try randomIds(gpa, cap, m.cfg.vocab);
+    defer gpa.free(ids);
+    const reps = @min(a.reps, 16);
+    var failed = false;
+    for (depths) |depth| {
+        var first: ?u64 = null;
+        for (0..toggles.len + 1) |k| {
+            setArm(m, k);
+            const h = try arm(gpa, gpu.io, m, ids, depth, reps, full, k) orelse {
+                failed = true;
+                continue;
+            };
+            if (first == null) first = h;
+            if (h != first.?) {
+                std.debug.print("FAIL mm3.prefill-prof arm={s} depth={d}: last logits differ from arm off\n", .{ armName(k), depth });
+                failed = true;
+            }
+        }
+    }
+    setArm(m, toggles.len);
+    try m.fwd().useProf(gpa, .{ .on = false });
+    std.debug.print("RESULT mm3-prefill-prof layers={d}: {s}\n", .{ a.layers, if (failed) "FAIL" else "PASS" });
+    if (failed) return error.TestFailed;
+}
diff --git a/zig/tests/cuda/mm3_prof.zig b/zig/tests/cuda/mm3_prof.zig
new file mode 100644
index 0000000000000000000000000000000000000000..218bff9b30a482ecc5c1bd3f3862fb7181d84e1a
--- /dev/null
+++ b/zig/tests/cuda/mm3_prof.zig
@@ -0,0 +1,74 @@
+//! tf-cuda-test mm3-prof [LAYERS]: TF_MM3_PROF on a synthetic MiniMax-M3.1-Flash, eager and graphed decode steps read.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const synth = @import("mm3_synth.zig");
+
+const steps = 8;
+
+/// `n` greedy decode rows of slot 0 from `first` at `pos0`: each row's logits hash.
+fn decodeSteps(gpa: std.mem.Allocator, m: *synth.Model, pos0: u32, first: i32, hashes: []u64) !void {
+    var id = first;
+    for (hashes, 0..) |*h, k| {
+        const row = try m.decode(0, pos0 + @as(u32, @intCast(k)), &[_]i32{id});
+        defer gpa.free(row);
+        h.* = std.hash.Wyhash.hash(0, std.mem.sliceAsBytes(row));
+        id = @intCast(synth.argmax(row));
+    }
+}
+
+const Seen = struct { steps: u64, graph_steps: u64, unread: u64, mismatch: u64, timed: u64, worst: f64 };
+
+/// The profile's counts so far, and the worst |ops + gaps + tail - span| over the read steps as a fraction of the span.
+fn seen(f: anytype) Seen {
+    const a = &f.prof.?.agg;
+    var sum: f64 = a.tail_ms;
+    for (a.op_ms.items, a.gap_ms.items) |o, g| sum += o + g;
+    const worst = if (a.span_ms > 0) @abs(sum - a.span_ms) / a.span_ms else 1;
+    return .{ .steps = a.steps, .graph_steps = a.graph_steps, .unread = a.unread, .mismatch = a.mismatch, .timed = a.timed, .worst = worst };
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    const gpa = gpu.gpa;
+    const layers: u32 = if (rest.len > 0) try std.fmt.parseInt(u32, rest[0], 10) else 2;
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    const m = try synth.Model.init(gpa, gpu.d, stream, .{ .layers = layers, .slots = 1, .capacity_tokens = 4096, .first_moe = 1 });
+    defer m.deinit();
+    var prompt: [300]i32 = undefined;
+    var prng = std.Random.DefaultPrng.init(0x9f0f);
+    for (&prompt) |*t| t.* = @intCast(prng.random().uintLessThan(u32, m.cfg.vocab));
+    const first: i32 = @intCast(try m.prefill(0, &prompt, 0));
+    const pos0: u32 = prompt.len;
+    var off: [steps]u64 = undefined;
+    var eager: [steps]u64 = undefined;
+    var graphed: [steps]u64 = undefined;
+    try decodeSteps(gpa, m, pos0, first, &off);
+    const f = m.fwd();
+    try f.useProf(gpa, .{ .on = true, .rows = 1, .every = 1, .out = "/tmp/tf-cuda-test-mm3-prof" });
+    try decodeSteps(gpa, m, pos0, first, &eager); // every step timed eagerly: plain event records
+    const e = seen(f);
+    try f.useGraphs(gpa, .{});
+    try decodeSteps(gpa, m, pos0, first, &graphed); // first eager, then captured (external record nodes), then replayed
+    const g = seen(f);
+    const stats = f.graphs.?.cache.stats;
+    try f.useGraphs(gpa, .{ .on = false });
+
+    var failed = false;
+    if (std.mem.eql(u64, &off, &eager) and e.steps == steps and e.graph_steps == 0 and e.unread == 0 and e.mismatch == 0 and e.worst < 0.01) {
+        check.pass("mm3.prof eager: {d} steps read, logits equal the unprofiled run, ops + gaps within {d:.3}% of the span", .{ e.steps, e.worst * 100 });
+    } else {
+        std.debug.print("FAIL mm3.prof eager: logits equal {}, steps {d}, graph {d}, unread {d}, mismatch {d}, worst {d:.4}\n", .{ std.mem.eql(u64, &off, &eager), e.steps, e.graph_steps, e.unread, e.mismatch, e.worst });
+        failed = true;
+    }
+    const gs = g.steps - e.steps;
+    const gg = g.graph_steps - e.graph_steps;
+    if (std.mem.eql(u64, &off, &graphed) and gs == steps and gg >= steps - 1 and g.unread == 0 and g.mismatch == 0 and g.worst < 0.01 and stats.replayed > 0) {
+        check.pass("mm3.prof graphs: {d} steps read ({d} from graphs; {d} captured, {d} replayed), logits equal the unprofiled run", .{ gs, gg, stats.captured, stats.replayed });
+    } else {
+        std.debug.print("FAIL mm3.prof graphs: logits equal {}, steps {d}, graph {d}, unread {d}, mismatch {d}, worst {d:.4}, replayed {d}\n", .{ std.mem.eql(u64, &off, &graphed), gs, gg, g.unread, g.mismatch, g.worst, stats.replayed });
+        failed = true;
+    }
+    std.debug.print("RESULT mm3-prof layers={d}: {d} ops a step, {s}\n", .{ layers, f.prof.?.n_ops, if (failed) "FAIL" else "PASS" });
+    if (failed) return error.TestFailed;
+}
diff --git a/zig/tests/cuda/mm3_prompt_bench.zig b/zig/tests/cuda/mm3_prompt_bench.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9f0ab3ca65ff1ae45f82b1842fcd7e51efa8d319
--- /dev/null
