+                const body = try std.fmt.allocPrint(a, "{{\"model\":\"m\",\"max_tokens\":4096,\"stream\":true,\"thinking\":{{\"type\":\"{s}\"}},\"messages\":[{{\"role\":\"user\",\"content\":\"hi\"}}],\"tools\":{s}}}", .{ if (thinking) "adaptive" else "disabled", tools });
+                got.* = try post(a, srv, "/v1/messages", body);
