@@ -0,0 +1,160 @@
+//! int4 K/V and fp8 index keys on the family side at the shipped model's numbers: bytes, page map, capacity, settings.
+const std = @import("std");
+const kv = @import("core").kv_pool;
+const config = @import("config.zig");
+const shard = @import("shard.zig");
+const pool = @import("pool.zig");
+const budget = @import("budget.zig");
+const ranks = @import("ranks.zig");
+
+const expectEqual = std.testing.expectEqual;
+const expect = std.testing.expect;
+const GiB = budget.GiB;
+
+pub const Arm = struct { name: []const u8, kv8: bool, kv4: pool.Kv4, ik8: pool.Ik8, token: u64 };
+
+/// The formats at TP2 (2 kv heads a rank, 60 layers): bytes a token a rank.
+pub const arms = [_]Arm{
+    .{ .name = "bf16", .kv8 = false, .kv4 = .off, .ik8 = .off, .token = 76_800 },
+    .{ .name = "fp8 K/V", .kv8 = true, .kv4 = .off, .ik8 = .off, .token = 47_040 },
+    .{ .name = "fp8 K/V + int8g16 IK", .kv8 = true, .kv4 = .off, .ik8 = .int8g16, .token = 40_320 },
+    .{ .name = "fp8 K/V + int8 IK", .kv8 = true, .kv4 = .off, .ik8 = .int8, .token = 39_840 },
+    .{ .name = "fp8 K/V + fp8 IK", .kv8 = true, .kv4 = .off, .ik8 = .fp8, .token = 39_600 },
+    .{ .name = "fp8 K + q4 V + int8 IK", .kv8 = true, .kv4 = .v, .ik8 = .int8, .token = 32_640 },
+    .{ .name = "fp8 K + q4 V + fp8 IK", .kv8 = true, .kv4 = .v, .ik8 = .fp8, .token = 32_400 },
+    .{ .name = "q4 K/V + int8 IK", .kv8 = false, .kv4 = .kv, .ik8 = .int8, .token = 25_440 },
+    .{ .name = "q4 K/V + fp8 IK", .kv8 = false, .kv4 = .kv, .ik8 = .fp8, .token = 25_200 },
+};
+
+fn dims(rank: usize, a: Arm) !pool.Dims {
+    const c = config.flash;
+    return (try pool.Dims.of(&c, try shard.Share.of(&c, rank, 2))).withKv8(a.kv8).withFormats(a.kv4, a.ik8);
+}
+
+test "bytes a token a rank: fp8 IK 39,600, fp8 K + q4 V 32,400, q4 K/V 25,200 (fp8 47,040, bf16 76,800)" {
+    for (arms) |a| for ([_]usize{ 0, 1 }) |r| {
+        const d = try dims(r, a);
+        try expectEqual(a.token, d.tokenBytes());
+        try expectEqual(a.token * pool.page_tokens, d.pageBytes());
+    };
+}
+
+test "every format's page map tiles the page: K, V, IK and its scales, K scales, V scales, then the next layer" {
+    const gpa = std.testing.allocator;
+    for (arms) |a| {
+        const d = try dims(0, a);
+        const m = d.map();
+        const seen = try gpa.alloc(u8, @intCast(d.pageBytes()));
+        defer gpa.free(seen);
+        @memset(seen, 0);
+        const t: u64 = pool.page_tokens;
+        const row = struct {
+            fn bytes(v: pool.Val) u64 {
+                return switch (v) {
+                    .bf16 => 256,
+                    .e4m3, .s8, .s16 => 128,
+                    .q4 => 64,
+                };
+            }
+            fn scales(v: pool.Val) u64 {
+                return switch (v) {
+                    .bf16 => 0,
+                    .e4m3 => 4,
+                    .q4, .s8 => 8,
+                    .s16 => 16,
+                };
+            }
+        };
+        for (0..d.layers) |l| {
+            const layer: u32 = @intCast(l);
+            for (0..d.kv_heads) |hh| {
+                const h: u32 = @intCast(hh);
+                try mark(seen, m.k(layer, h), t * row.bytes(d.kVal()));
+                try mark(seen, m.v(layer, h), t * row.bytes(d.vVal()));
+                if (d.kVal() != .bf16) try mark(seen, m.kScale(layer, h), t * row.scales(d.kVal()));
+                if (d.vVal() != .bf16) try mark(seen, m.vScale(layer, h), t * row.scales(d.vVal()));
+            }
+            try mark(seen, m.ik(layer), m.ikBytes());
+        }
+        for (seen) |s| try expectEqual(@as(u8, 1), s);
+        const want: u64 = switch (a.ik8) {
+            .off => 128 * 256,
+            .fp8 => 128 * 132,
+            .int8 => 128 * 136,
+            .int8g16 => 128 * 144,
+        };
+        try expectEqual(want, m.ikBytes());
+    }
+}
+
+fn mark(s: []u8, off: u64, len: u64) !void {
+    for (s[@intCast(off)..][0..@intCast(len)]) |*x| {
+        try expectEqual(@as(u8, 0), x.*);
+        x.* = 1;
+    }
+}
+
+test "capacity at TP2: tokens one rank's KV room holds, and the context each of 4 slots gets" {
+    for ([_]f64{ 7.02, 7.18, 7.63 }) |room_gib| {
+        const room: u64 = @intFromFloat(room_gib * @as(f64, @floatFromInt(GiB)));
+        var last: usize = 0;
+        for (arms) |a| {
+            const d = try dims(0, a);
+            const l: kv.Layout = .{ .fixed_bytes = 0, .token_bytes = d.tokenBytes(), .page_tokens = pool.page_tokens, .snap_bytes = pool.snap_bytes, .all_paged = true };
+            const p = try kv.plan(l, .{ .room = room, .engine = 0, .lanes = 1 });
+            try expect(p.pages >= last or a.ik8 == .int8 or a.ik8 == .int8g16);
+            last = p.pages;
+            const tokens = p.pages * pool.page_tokens;
+            std.debug.print("kvfmt room {d:.2} GiB, {s}: {d} pages = {d} tokens; 4 slots x {d}\n", .{ room_gib, a.name, p.pages, tokens, (p.pages / 4 - 1) * pool.page_tokens });
+        }
+    }
+}
+
+test "the budget check prices each format: a longer context in the same room, the refusal quotes its bytes" {
+    const w = @import("pool_test.zig").weights_rank0;
+    const in: budget.Input = .{ .available = 119 * GiB, .weights = w, .terms = try budget.tensorfold(119 * GiB, null), .lanes = 1, .window = pool.page_tokens, .max_positions = 1 << 20 };
+    var last: u64 = 0;
+    for (arms) |a| {
+        const d = try dims(0, a);
+        const v = budget.check(d, in, null).ok;
+        try expect((v.context >= last or a.ik8 == .int8 or a.ik8 == .int8g16) and v.pool_bytes <= v.room);
+        last = v.context;
+        std.debug.print("kvfmt 119 GiB host, {s}: largest context {d}\n", .{ a.name, v.context });
+        const huge = budget.check(d, in, 1 << 20);
+        try expect(huge == .refused);
+        try expectEqual(a.token, huge.refused.token_bytes);
+    }
+}
+
+test "the ranks' fingerprint carries the formats: one rank on q4 or fp8 index keys and the other not refuse" {
+    const h = ranks.hashBytes("p");
+    const base = ranks.Fingerprint.of(.{ .rank = 0, .world = 2 }, .{ .kv8 = true }, 131072, ranks.hashBytes("c"), ranks.hashBytes("q"), h, ranks.hashBytes("w"));
+    for ([_]ranks.Settings{ .{ .kv8 = true, .ik8 = .fp8 }, .{ .kv8 = true, .ik8 = .int8 }, .{ .kv8 = true, .kv4 = .v }, .{ .kv4 = .kv } }) |s| {
+        const other = ranks.Fingerprint.of(.{ .rank = 1, .world = 2 }, s, 131072, ranks.hashBytes("c"), ranks.hashBytes("q"), h, ranks.hashBytes("w"));
+        const mm = ranks.mismatch(&.{ base, other }).?;
