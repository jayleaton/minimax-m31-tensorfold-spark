+
+const Obj = std.json.ObjectMap;
+
+fn int(o: Obj, key: []const u8) Error!u32 {
+    const v = o.get(key) orelse return error.BadConfig;
+    if (v != .integer) return error.BadConfig;
+    return std.math.cast(u32, v.integer) orelse error.BadConfig;
+}
+
+fn float(o: Obj, key: []const u8) Error!f64 {
+    const v = o.get(key) orelse return error.BadConfig;
+    return switch (v) {
+        .float => |f| f,
+        .integer => |i| @floatFromInt(i),
+        else => error.BadConfig,
+    };
+}
+
+/// An optional key: absent and null read as `none`.
+fn opt(o: Obj, key: []const u8) ?std.json.Value {
+    const v = o.get(key) orelse return null;
+    return if (v == .null) null else v;
+}
+
+fn flagOr(o: Obj, key: []const u8, none: bool) Error!bool {
+    const v = opt(o, key) orelse return none;
+    return if (v == .bool) v.bool else error.BadConfig;
+}
+
+fn text(o: Obj, key: []const u8) Error![]const u8 {
+    const v = o.get(key) orelse return error.BadConfig;
+    return if (v == .string) v.string else error.BadConfig;
+}
+
+fn object(o: Obj, key: []const u8) Error!Obj {
+    const v = o.get(key) orelse return error.BadConfig;
+    return if (v == .object) v.object else error.BadConfig;
+}
+
+fn list(o: Obj, key: []const u8) Error![]const std.json.Value {
+    const v = o.get(key) orelse return error.BadConfig;
+    return if (v == .array) v.array.items else error.BadConfig;
+}
+
+/// Whether `json` names a DFlash2 draft class (a cheap look before `parse`, for choosing the draft's kind).
+pub fn names(gpa: std.mem.Allocator, json: []const u8) bool {
+    const parsed = std.json.parseFromSlice(std.json.Value, gpa, json, .{}) catch return false;
+    defer parsed.deinit();
+    if (parsed.value != .object) return false;
+    const arch = list(parsed.value.object, "architectures") catch return false;
+    if (arch.len != 1 or arch[0] != .string) return false;
+    for (architectures) |a| if (std.mem.eql(u8, arch[0].string, a)) return true;
+    return false;
+}
+
+pub fn parse(gpa: std.mem.Allocator, json: []const u8) (Error || std.mem.Allocator.Error || error{SyntaxError})!Config {
+    const parsed = std.json.parseFromSlice(std.json.Value, gpa, json, .{}) catch |e| return switch (e) {
+        error.OutOfMemory => error.OutOfMemory,
+        else => error.SyntaxError,
+    };
+    defer parsed.deinit();
+    if (parsed.value != .object) return error.BadConfig;
+    const o = parsed.value.object;
+    if (!names(gpa, json)) return error.NotDflash2;
+    const df = try object(o, "dflash_config");
+    const rope = try object(o, "rope_parameters");
+    const head_dim = try int(o, "head_dim");
+    const partial = if (opt(rope, "partial_rotary_factor")) |_| try float(rope, "partial_rotary_factor") else 1.0;
+    const act_name = try text(o, "hidden_act");
+    const act: Act = if (std.mem.eql(u8, act_name, "silu")) .silu else if (std.mem.eql(u8, act_name, "swigluoai")) .swigluoai else return error.Unsupported;
+    var c: Config = .{
+        .layers = try int(o, "num_hidden_layers"),
+        .hidden = try int(o, "hidden_size"),
+        .heads = try int(o, "num_attention_heads"),
+        .kv_heads = try int(o, "num_key_value_heads"),
+        .head_dim = head_dim,
+        .rotary_dim = @intFromFloat(@round(partial * @as(f64, @floatFromInt(head_dim)))),
+        .vocab = try int(o, "vocab_size"),
+        .eps = @floatCast(try float(o, "rms_norm_eps")),
+        .rope_theta = try float(rope, "rope_theta"),
+        .ffn = try int(o, "intermediate_size"),
+        .window = try int(o, "sliding_window"),
+        .block = try int(df, "block_size"),
+        .proposals = 0,
+        .mask_token = try int(df, "mask_token_id"),
+        .group = try int(df, "conv_group_size"),
+        .rank = try int(df, "selector_rank"),
+        .top_k = try int(df, "selector_top_k"),
+        .act = act,
+        .swiglu_alpha = if (act == .silu) 1.0 else @floatCast(try float(o, "swiglu_alpha")),
+        .swiglu_limit = if (act == .silu) 0 else @floatCast(try float(o, "swiglu_limit")),
+        .gemma_norm = try flagOr(o, "use_gemma_norm", false),
+        .causal = try flagOr(o, "is_causal", true), // every layer is sliding_attention (checked below)
+        .taps = @splat(0),
+        .n_taps = 0,
+    };
+    const taps = try list(df, "target_layer_ids");
+    if (taps.len == 0 or taps.len > max_taps) return error.BadConfig;
+    for (taps, 0..) |e, i| {
+        if (e != .integer) return error.BadConfig;
+        c.taps[i] = std.math.cast(u32, e.integer) orelse return error.BadConfig;
+        if (i > 0 and c.taps[i] <= c.taps[i - 1]) return error.BadConfig; // the forward taps in layer order
+    }
+    c.n_taps = @intCast(taps.len);
+    c.proposals = c.block -| 1;
+    // settings spelled twice must agree; features the kernels do not run are refused
+    if (opt(o, "rotary_dim")) |_| if (try int(o, "rotary_dim") != c.rotary_dim) return error.BadConfig;
+    if (opt(o, "rope_theta")) |_| if (try float(o, "rope_theta") != c.rope_theta) return error.BadConfig;
+    if (opt(o, "block_size")) |_| if (try int(o, "block_size") != c.block) return error.BadConfig;
+    if (opt(o, "draft_vocab_size")) |_| if (try int(o, "draft_vocab_size") != c.vocab) return error.Unsupported;
+    if (try int(df, "conv_kernel_size") != 2) return error.Unsupported;
+    if (!std.mem.eql(u8, try text(rope, "rope_type"), "default") or opt(o, "rope_scaling") != null) return error.Unsupported;
+    if (try flagOr(o, "attention_output_gate", false) or try flagOr(o, "attention_bias", false)) return error.Unsupported;
+    if (try flagOr(o, "tie_word_embeddings", false) or !try flagOr(o, "use_sliding_window", true)) return error.Unsupported;
+    if (opt(o, "qk_norm_type")) |_| if (!std.mem.eql(u8, try text(o, "qk_norm_type"), "per_head")) return error.Unsupported;
+    const types = try list(o, "layer_types");
+    if (types.len != c.layers) return error.BadConfig;
+    for (types) |e| if (e != .string or !std.mem.eql(u8, e.string, "sliding_attention")) return error.Unsupported;
+    try check(c);
+    return c;
+}
+
+fn check(c: Config) Error!void {
+    if (c.layers == 0 or c.layers > 16 or c.block < 2 or c.block > 8 or c.window < 128 or c.window % 128 != 0) return error.BadShape;
+    if (c.head_dim != 128 or c.rotary_dim == 0 or c.rotary_dim > c.head_dim or c.rotary_dim % 2 != 0) return error.BadShape;
+    if (c.heads == 0 or c.kv_heads == 0 or c.heads % c.kv_heads != 0) return error.BadShape;
+    if (c.mask_token >= c.vocab or c.rank == 0 or c.rank % 32 != 0 or c.rank > 1024) return error.BadShape;
+    if (c.top_k == 0 or c.top_k > 64 or c.group == 0 or c.hidden % c.group != 0) return error.BadShape;
+    const wide = [_]u32{ c.hidden, c.qWidth(), c.kvWidth(), c.ffn, c.vocab, c.dynWidth() };
+    for (wide) |w| if (w == 0 or w % 64 != 0) return error.BadShape;
+}
+
+/// A rank's part of the draft: its query and kv heads and MLP rows (the draft's own counts, not the target's).
+pub const Split = struct {
+    q_heads: u32,
+    kv_heads: u32,
+    q0: u32, // first query head
+    kv0: u32,
+    ffn: u32,
+    ffn0: u32,
+
+    pub fn of(c: *const Config, rank: u32, world: u32) Error!Split {
+        if (world == 0 or rank >= world or c.kv_heads % world != 0 or c.ffn % (64 * world) != 0) return error.BadShape;
+        const kv = c.kv_heads / world;
+        const q = c.heads / world;
+        const f = c.ffn / world;
+        return .{ .q_heads = q, .kv_heads = kv, .q0 = rank * q, .kv0 = rank * kv, .ffn = f, .ffn0 = rank * f };
+    }
+};
+
+pub const Refusal = enum {
+    hidden_differs,
+    vocab_differs,
+    tap_out_of_range,
+    block_too_wide,
+    needs_two_ranks_or_one,
+    mask_token_out_of_vocab,
+    heads_do_not_split,
+    causal_block,
+
+    pub fn text(r: Refusal) []const u8 {
+        return switch (r) {
+            .hidden_differs => "--drafter: the DFlash2 draft's hidden width is not the model's: it reads the model's own hidden states",
+            .vocab_differs => "--drafter: the DFlash2 draft's vocabulary is not the model's: it drafts through the model's embedding and head",
+            .tap_out_of_range => "--drafter: the DFlash2 draft taps a layer the model does not have (TF_MM3_LAYERS cuts the model)",
+            .block_too_wide => "--drafter: a DFlash2 block (its anchor and proposals) does not fit one verify window of this engine",
+            .needs_two_ranks_or_one => "--drafter: this build runs the DFlash2 draft on one or two ranks only",
+            .mask_token_out_of_vocab => "--drafter: the DFlash2 draft's mask token is past the model's embedding rows",
+            .heads_do_not_split => "--drafter: the DFlash2 draft's kv heads or MLP width do not divide over the ranks",
+            .causal_block => "--drafter: the DFlash2 draft's block rows are causal (no is_causal: false), which this build does not run",
+        };
+    }
+};
+
+pub const Place = dc.Place;
+
+pub fn admit(c: *const Config, t: *const target.Config, p: Place) ?Refusal {
+    if (c.hidden != t.hidden) return .hidden_differs;
+    if (c.vocab != t.vocab) return .vocab_differs;
+    if (c.causal) return .causal_block; // the block attention kernel sees every block row
+    for (c.tapIds()) |id| if (id >= t.layers) return .tap_out_of_range;
+    if (c.mask_token >= t.vocab) return .mask_token_out_of_vocab;
+    if (c.block > p.window_rows) return .block_too_wide; // the anchor is the window's pending row
+    if (p.world == 0 or p.world > 2) return .needs_two_ranks_or_one;
+    _ = Split.of(c, 0, @intCast(p.world)) catch return .heads_do_not_split;
+    return null;
+}
+
+/// Bytes of the bf16 weights rank `s` holds: its heads and MLP rows; fc, the convs and the selector on every rank.
+pub const Weights = struct {
+    layers: u64, // q, k, v, o, gate, up, down: this rank's part
+    convs: u64, // both kernel projections and base kernels, every layer
+    fc: u64,
+    selector: u64, // the hidden projection and both codebooks
+    small: u64, // norms
+    pub fn total(w: Weights) u64 {
+        return w.layers + w.convs + w.fc + w.selector + w.small;
+    }
+};
+
+pub fn rankWeights(c: *const Config, s: Split) Weights {
+    const h: u64 = c.hidden;
+    const q: u64 = @as(u64, s.q_heads) * c.head_dim;
+    const kv: u64 = @as(u64, s.kv_heads) * c.head_dim;
+    const per_layer = 2 * q * h + 2 * kv * h + 3 * h * s.ffn;
+    const conv = 2 * (@as(u64, c.dynWidth()) * h + 2 * 2 * h);
+    return .{
+        .layers = c.layers * per_layer * 2,
+        .convs = c.layers * conv * 2,
+        .fc = h * c.fcIn() * 2,
+        .selector = (@as(u64, c.rank) * h + 2 * @as(u64, c.vocab) * c.rank) * 2,
+        .small = (c.layers * (2 * h + 2 * @as(u64, c.head_dim)) + 2 * h) * 2,
+    };
+}
+
+pub fn ringRows(c: *const Config, window_rows: u32) u64 {
+    return @as(u64, c.window) + window_rows;
+}
+
+/// A stream's ring on a rank: K and V of every layer, this rank's kv heads, `ringRows` positions.
+pub fn ringBytes(c: *const Config, s: Split, window_rows: u32) u64 {
+    return ringRows(c, window_rows) * c.layers * 2 * @as(u64, s.kv_heads) * c.head_dim * 2;
+}
+
+/// The device scratch's fields in order (dflash2_device carves exactly these), sized for `absorb_rows` and a block.
+pub fn scratchSizes(c: *const Config, s: Split, absorb_rows: u32, own_vocab: u64, world: u32) [scratch_fields.len]u64 {
+    const h: u64 = c.hidden;
+    const r: u64 = absorb_rows;
+    const b: u64 = c.block;
+    const qw: u64 = @as(u64, s.q_heads) * c.head_dim;
+    const kvw: u64 = @as(u64, s.kv_heads) * c.head_dim;
+    const f: u64 = s.ffn;
+    const k: u64 = c.top_k;
+    return .{
+        r * h * 2, r * h * 2, r * kvw * 2, r * kvw * 2, // fc_out, hn, k_raw, v_raw
+        b * 4, b * h * 4, b * h * 2, b * h * 2, b * c.dynWidth() * 2, // ids, res, a, conv, dyn
+        b * qw * 2, b * kvw * 2, b * kvw * 2, b * qw * 2, b * kvw * 2, b * kvw * 2, // q/k/v raw, q/k/v normed
+        b * qw * 2, b * h * 4, b * h * 4, world * b * h * 4, // attn, part, sum, gathered
+        b * f * 2, b * f * 2, b * f * 2, b * h * 2, // gate, up, act, post
+        b * own_vocab * 4, b * k * 8, world * b * k * 8, b * c.rank * 4, // logits, cand_local, cand_all, sel_h
+    };
+}
+
+pub const scratch_fields = [_][]const u8{
+    "fc_out", "hn",   "k_raw", "v_raw", "ids",  "res",  "a",  "conv", "dyn",  "q_raw",  "kb_raw", "vb_raw", "qn",    "kn",
+    "vn",     "attn", "part",  "sum",   "gath", "gate", "up", "act",  "post", "logits", "cand_l", "cand_a", "sel_h",
+};
+
+pub fn scratchBytes(c: *const Config, s: Split, absorb_rows: u32, own_vocab: u64, world: u32) u64 {
+    var total: u64 = 0;
+    for (scratchSizes(c, s, absorb_rows, own_vocab, world)) |sz| total = std.mem.alignForward(u64, total, 256) + sz;
+    return total;
+}
+
+/// What the draft adds to a rank's budget (budget.withDraft): weights, scratch and snapshots, a ring a stream.
+pub fn cost(c: *const Config, rank: u32, world: u32, window_rows: u32, absorb_rows: u32, snaps: u32) Error!dc.Cost {
+    const s = try Split.of(c, rank, world);
+    const own_vocab: u64 = (c.vocab + world - 1) / world;
+    return .{
+        .weights = rankWeights(c, s).total(),
+        .runtime = dc.runtime_estimate + scratchBytes(c, s, absorb_rows, own_vocab, world) + @as(u64, snaps) * ringBytes(c, s, window_rows),
+        .per_lane = ringBytes(c, s, window_rows),
+    };
+}
+
+pub const incoai_fixture = @embedFile("fixtures/dflash2_incoai_config.json");
+pub const mm_class_fixture = @embedFile("fixtures/dflash2_minimax_layout.json");
+
+test "both class layouts parse to their spelled-out shapes" {
+    const gpa = std.testing.allocator;
+    try std.testing.expectEqualDeep(incoai, try parse(gpa, incoai_fixture));
+    try std.testing.expectEqualDeep(mm_class, try parse(gpa, mm_class_fixture));
+    try std.testing.expect(names(gpa, incoai_fixture) and names(gpa, mm_class_fixture) and !names(gpa, dc.fixture));
+    try std.testing.expectEqual(@as(u32, 36864), incoai.fcIn());
+    try std.testing.expectEqual(@as(u32, 1536), incoai.dynWidth()); // kernel_projection.weight is [1536, 6144]
+    try std.testing.expectEqual(@as(u32, 7), mm_class.depth());
+}
+
+test "the whole draft's weight bytes: incoai's equal its safetensors data bytes" {
+    try std.testing.expectEqual(@as(u64, 4_247_767_552), rankWeights(&incoai, try Split.of(&incoai, 0, 1)).total());
+    try std.testing.expectEqual(@as(u64, 4_109_355_520), rankWeights(&mm_class, try Split.of(&mm_class, 0, 1)).total());
+    // two ranks: the heads and MLP halve, fc, the convs and the selector stay whole on each
+    const w = rankWeights(&incoai, try Split.of(&incoai, 1, 2));
+    try std.testing.expectEqual(rankWeights(&incoai, try Split.of(&incoai, 0, 1)).layers / 2, w.layers);
+    try std.testing.expect(w.total() < 2_600_000_000 and w.total() > 2_500_000_000);
+}
+
+fn patched(gpa: std.mem.Allocator, from: []const u8, to: []const u8) ![]u8 {
+    try std.testing.expect(std.mem.indexOf(u8, mm_class_fixture, from) != null);
+    return std.mem.replaceOwned(u8, gpa, mm_class_fixture, from, to);
+}
+
+fn refuses(want: anyerror, from: []const u8, to: []const u8) !void {
+    const gpa = std.testing.allocator;
+    const json = try patched(gpa, from, to);
+    defer gpa.free(json);
+    try std.testing.expectError(want, parse(gpa, json));
+}
+
+test "another class, a third conv tap, gated attention or a disagreeing copy is refused" {
+    try refuses(error.NotDflash2, "\"MiniMaxDFlash2DraftModel\"", "\"DSparkMiniMaxDraftModel\"");
+    try refuses(error.Unsupported, "\"conv_kernel_size\": 2", "\"conv_kernel_size\": 3");
+    try refuses(error.Unsupported, "\"attention_output_gate\": false", "\"attention_output_gate\": true");
+    try refuses(error.Unsupported, "\"hidden_act\": \"swigluoai\"", "\"hidden_act\": \"gelu\"");
+    try refuses(error.BadConfig, "\"rotary_dim\": 64", "\"rotary_dim\": 32");
+    try refuses(error.BadConfig, "\"block_size\": 8,\n  \"bos", "\"block_size\": 7,\n  \"bos");
+    try refuses(error.BadShape, "\"selector_top_k\": 16", "\"selector_top_k\": 65");
+}
+
+test "the draft is refused beside a model it cannot read, and each refusal has its own words" {
+    const here: Place = .{ .world = 2, .window_rows = 16 };
+    try std.testing.expect(admit(&incoai, &target.flash, here) == null);
+    // the MiniMax class's block rows are causal by the reference's rule until its config says otherwise
+    try std.testing.expectEqual(Refusal.causal_block, admit(&mm_class, &target.flash, here).?);
+    var bidirectional = mm_class;
+    bidirectional.causal = false;
+    try std.testing.expect(admit(&bidirectional, &target.flash, here) == null);
+    var t = target.flash;
+    t.layers = 58; // incoai taps layer 58
+    try std.testing.expectEqual(Refusal.tap_out_of_range, admit(&incoai, &t, here).?);
+    try std.testing.expectEqual(Refusal.block_too_wide, admit(&incoai, &target.flash, .{ .world = 2, .window_rows = 7 }).?);
+    try std.testing.expectEqual(Refusal.needs_two_ranks_or_one, admit(&incoai, &target.flash, .{ .world = 3, .window_rows = 16 }).?);
+    inline for (std.enums.values(Refusal)) |r| try std.testing.expect(std.mem.startsWith(u8, r.text(), "--drafter: "));
+}
+
+test "a ring a stream: window plus a verify window of positions, this rank's kv heads, K and V of every layer" {
+    const s = try Split.of(&incoai, 0, 2);
+    try std.testing.expectEqual(@as(u64, (2048 + 16) * 5 * 2 * 4 * 128 * 2), ringBytes(&incoai, s, 16));
+    // the MiniMax class's ring is the dspark draft's: the same window, kv heads and layers
+    try std.testing.expectEqual(dc.ringBytes(&dc.flash, try @import("shard.zig").Share.of(&target.flash, 0, 2), 16), ringBytes(&mm_class, try Split.of(&mm_class, 0, 2), 16));
+    const cst = try cost(&incoai, 0, 2, 16, 2048, 8);
+    try std.testing.expectEqual(ringBytes(&incoai, s, 16), cst.per_lane);
+    try std.testing.expect(cst.runtime > dc.runtime_estimate + 8 * cst.per_lane);
+}
