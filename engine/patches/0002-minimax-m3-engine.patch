+        var a: launch_.Args = .{};
+        a.add(logits);
+        a.add(@as(i64, @intCast(ld)));
+        a.add(@as(i32, @intCast(n)));
+        a.add(@as(i32, @intCast(per)));
+        a.add(@as(i32, @intCast(c)));
+        a.add(part);
+        try launch_.launch(t.part_fn, .{ .grid = .{ .x = rows, .y = sl, .z = 1 }, .block = .{ .x = threads } }, st, &a);
