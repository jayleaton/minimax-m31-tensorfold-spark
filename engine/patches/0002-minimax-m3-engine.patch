+++ b/tools/dflash2_reference.py
@@ -0,0 +1,263 @@
+"""The DFlash2 draft forward in fp32 PyTorch math from bf16 weights, and its greedy selector in float64 NumPy."""
+# Ported from z-lab/dflash @ 07ebd93db9f4 dflash/model.py (MIT, DFlash2DraftModel); gemma norm, swigluoai, partial RoPE.
+import glob
+import json
+import os
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+SELECTOR = "candidate_selector."
+CODEBOOKS = (SELECTOR + "predecessor_codebook", SELECTOR + "successor_codebook")
+
+
+class DraftConfig:
+    """config.json: the settings the forward reads, dflash_config first and then the top level (as model.py)."""
+
+    def __init__(self, cfg: dict):
+        d = cfg.get("dflash_config") or {}
+
+        def dv(name, default=None):
+            return d.get(name, cfg.get(name, default))
+
+        self.arch = (cfg.get("architectures") or [""])[0]
+        self.hidden = int(cfg["hidden_size"])
+        self.layers = int(cfg["num_hidden_layers"])
+        self.heads = int(cfg["num_attention_heads"])
+        self.kv_heads = int(cfg.get("num_key_value_heads") or self.heads)
+        self.head_dim = int(cfg.get("head_dim") or self.hidden // self.heads)
+        self.inter = int(cfg["intermediate_size"])
+        self.vocab = int(cfg["vocab_size"])
+        self.eps = float(cfg.get("rms_norm_eps", 1e-6))
+        rope = cfg.get("rope_parameters") or {}
+        if rope.get("rope_type", "default") != "default":
+            raise NotImplementedError(f"rope_type {rope.get('rope_type')!r}")
+        self.rope_theta = float(rope.get("rope_theta", cfg.get("rope_theta", 10000.0)))
+        prf = cfg.get("partial_rotary_factor", rope.get("partial_rotary_factor"))
+        prf = 1.0 if prf is None else float(prf)
+        self.rotary_dim = int(round(self.head_dim * prf))
+        if cfg.get("rotary_dim") is not None and int(cfg["rotary_dim"]) != self.rotary_dim:
+            raise ValueError("rotary_dim disagrees with partial_rotary_factor")
+        self.block = int(dv("block_size", 16))
+        self.mask_token = int(dv("mask_token_id"))
+        self.taps = [int(x) for x in dv("target_layer_ids")]
+        self.conv_k = int(dv("conv_kernel_size"))
+        self.conv_group = int(dv("conv_group_size"))
+        self.rank = int(dv("selector_rank"))
+        self.top_k = int(dv("selector_top_k"))
+        self.output_multiplier = float(dv("output_multiplier", 1.0))
+        sc = dv("final_logit_softcapping")
+        self.softcap = float(sc) if sc is not None and float(sc) > 0 else None
+        self.embed_scale = float(dv("input_embedding_scale", 1.0))
+        self.layer_types = list(cfg.get("layer_types") or ["full_attention"] * self.layers)
+        self.window = cfg.get("sliding_window")
+        self.is_causal = cfg.get("is_causal")
+        self.act = cfg.get("hidden_act", "silu")
+        if self.act == "swigluoai":
+            self.swiglu_alpha, self.swiglu_limit = float(cfg["swiglu_alpha"]), float(cfg["swiglu_limit"])
+        elif self.act != "silu":
+            raise NotImplementedError(f"hidden_act {self.act!r}")
+        self.gemma_norm = bool(cfg.get("use_gemma_norm", False))
+        if cfg.get("attention_output_gate") or cfg.get("attention_bias"):
+            raise NotImplementedError("attention_output_gate / attention_bias")
+
+    def layer_window(self, i):
+        """The sliding window of layer i (None on a full-attention layer)."""
+        return int(self.window) if self.layer_types[i] == "sliding_attention" else None
+
+    def causal(self, i, mode="auto"):
+        """Block rows see only earlier block rows: the override, else is_causal, else causal iff sliding (model.py)."""
+        if mode != "auto":
+            return mode == "causal"
+        if self.is_causal is not None:
+            return bool(self.is_causal)
+        return self.layer_types[i] == "sliding_attention"
+
+
+def norm_name(k: str) -> str:
+    """Checkpoint key to the draft's name: no 'model.' prefix, codebooks without '.weight' (model.py remap)."""
+    k = k[len("model."):] if k.startswith("model.") else k
+    return k[: -len(".weight")] if k.endswith(".weight") and k[: -len(".weight")] in CODEBOOKS else k
+
+
+def load_config(dir_: str) -> DraftConfig:
+    with open(os.path.join(dir_, "config.json")) as f:
+        return DraftConfig(json.load(f))
+
+
+def load_draft(dir_: str, only=None):
+    """(config, {name: bf16 CPU tensor}) of a draft checkpoint directory; `only` keeps just those names."""
+    from safetensors import safe_open
+    cfg = load_config(dir_)
+    files = sorted(glob.glob(os.path.join(dir_, "*.safetensors")))
+    if not files:
+        raise FileNotFoundError(f"no *.safetensors in {dir_}")
+    w = {}
+    for path in files:
+        with safe_open(path, framework="pt", device="cpu") as fh:
+            for k in fh.keys():
+                if only is None or norm_name(k) in only:
+                    w[norm_name(k)] = fh.get_tensor(k)
+    return cfg, w
+
+
+class DFlash2:
+    """One block of the draft: weights stay bf16 on `device`, every op upcasts them to float32."""
+
+    def __init__(self, cfg: DraftConfig, w: dict, device="cuda:0", block_attention="auto"):
+        self.c = cfg
+        self.dev = torch.device(device)
+        self.w = {k: v.to(self.dev) for k, v in w.items() if k not in CODEBOOKS}
+        self.mode = block_attention
+        fc = self.w["fc.weight"]
+        if tuple(fc.shape) != (cfg.hidden, len(cfg.taps) * cfg.hidden):
+            raise ValueError(f"fc.weight {tuple(fc.shape)} is not ({cfg.hidden}, {len(cfg.taps)} * {cfg.hidden})")
+
+    def f(self, name):
+        return self.w[name].float()
+
+    def lin(self, x, name):
+        """x @ W^T in float32 (every draft linear is bias-free)."""
+        return x.float() @ self.f(name).t()
+
+    def rms(self, x, name):
+        """RMSNorm over the last dim: w * xhat, or (1 + w) * xhat for gemma norms."""
+        x = x.float()
+        xhat = x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + self.c.eps)
+        w = self.f(name)
+        return xhat * (1.0 + w) if self.c.gemma_norm else xhat * w
+
+    def rope(self, x, pos):
+        """x [n, heads, head_dim] at positions pos [n]: NeoX rotate-half over the first rotary_dim dims."""
+        rd = self.c.rotary_dim
+        inv = 1.0 / (self.c.rope_theta ** (torch.arange(0, rd, 2, device=x.device, dtype=torch.float64) / rd))
+        ang = (pos.to(x.device).double()[:, None] * inv[None, :]).float()
+        cos = torch.cat([ang.cos(), ang.cos()], -1)[:, None, :]
+        sin = torch.cat([ang.sin(), ang.sin()], -1)[:, None, :]
+        xr, xp = x[..., :rd], x[..., rd:]
+        rot = torch.cat([-xr[..., rd // 2:], xr[..., : rd // 2]], -1)
+        return torch.cat([xr * cos + rot * sin, xp], -1)
+
+    def conv(self, x, dyn, base):
+        """y[t] = sum over lags l of (base[l] + dyn[t, l, group]) * x[t - l], with x[-1] = 0 (block rows only)."""
+        b, h = x.shape
+        gs = self.c.conv_group
+        g = h // gs
+        xs = x.view(b, g, gs)
+        out = torch.zeros_like(xs)
+        for lag in range(base.shape[0]):
+            vals = torch.zeros_like(xs)
+            vals[lag:] = xs[: b - lag]
+            out = out + base[lag].view(1, g, gs) * vals + dyn[:, lag].unsqueeze(-1) * vals
+        return out.view(b, h)
+
+    def conv_prepare(self, prefix, x):
+        """The pre-sublayer conv of the normed input, and side 1's coefficients from that same input."""
+        c = self.c
+        dyn = self.lin(x, prefix + ".kernel_projection.weight").view(x.shape[0], 2, c.conv_k, c.hidden // c.conv_group)
+        return self.conv(x, dyn[:, 0], self.f(prefix + ".base_kernel")[0]), dyn[:, 1]
+
+    def conv_finish(self, prefix, z, dyn1):
+        return self.conv(z, dyn1, self.f(prefix + ".base_kernel")[1])
+
+    def attention(self, i, x, ctx, pos_blk, pos_ctx):
+        """Block queries over [context in window; block rows], context K/V from the shared normed fc output."""
+        c = self.c
+        p = f"layers.{i}.self_attn."
+        b = x.shape[0]
+        q = self.lin(x, p + "q_proj.weight").view(b, c.heads, c.head_dim)
+        q = self.rope(self.rms(q, p + "q_norm.weight"), pos_blk)
+        kv_in = torch.cat([ctx, x], 0)
+        pos_all = torch.cat([pos_ctx, pos_blk], 0)
+        k = self.lin(kv_in, p + "k_proj.weight").view(-1, c.kv_heads, c.head_dim)
+        k = self.rope(self.rms(k, p + "k_norm.weight"), pos_all)
+        v = self.lin(kv_in, p + "v_proj.weight").view(-1, c.kv_heads, c.head_dim)
+        rep = c.heads // c.kv_heads
+        k, v = k.repeat_interleave(rep, dim=1), v.repeat_interleave(rep, dim=1)
+        qp, kp = pos_blk[:, None], pos_all[None, :]
+        visible = torch.ones(b, kv_in.shape[0], dtype=torch.bool, device=x.device)
+        causal, win = c.causal(i, self.mode), c.layer_window(i)
+        if causal:
+            visible &= kp <= qp
+        if win is not None:
+            visible &= (qp - kp) < win
+            if not causal:
+                visible &= (kp - qp) < win
+        s = torch.einsum("qhd,khd->hqk", q, k) * (c.head_dim ** -0.5)
+        a = torch.softmax(s.masked_fill(~visible[None], float("-inf")), -1)
+        return self.lin(torch.einsum("hqk,khd->qhd", a, v).reshape(b, c.heads * c.head_dim), p + "o_proj.weight")
+
+    def mlp(self, i, x):
+        p = f"layers.{i}.mlp."
+        g, u = self.lin(x, p + "gate_proj.weight"), self.lin(x, p + "up_proj.weight")
+        if self.c.act == "silu":
+            h = F.silu(g) * u
+        else:
+            lim, al = self.c.swiglu_limit, self.c.swiglu_alpha
+            g, u = g.clamp(max=lim), u.clamp(min=-lim, max=lim)
+            h = g * torch.sigmoid(al * g) * (u + 1.0)
+        return self.lin(h, p + "down_proj.weight")
+
+    def layer(self, i, h, ctx, pos_blk, pos_ctx):
+        """One decoder layer: each sublayer between its two convs, the residual added after the second."""
+        p = f"layers.{i}."
+        x, k_att = self.conv_prepare(p + "attention_conv", self.rms(h, p + "input_layernorm.weight"))
+        h = h + self.conv_finish(p + "attention_conv", self.attention(i, x, ctx, pos_blk, pos_ctx), k_att)
+        x, k_mlp = self.conv_prepare(p + "mlp_conv", self.rms(h, p + "post_attention_layernorm.weight"))
+        return h + self.conv_finish(p + "mlp_conv", self.mlp(i, x), k_mlp)
+
+    @torch.inference_mode()
+    def forward(self, taps, pos_ctx, block_embed, anchor_pos):
+        """taps [n, n_taps * hidden] bf16, block_embed [block, hidden]: the final-norm hidden of every block row."""
+        c = self.c
+        ctx = self.rms(self.lin(taps.to(self.dev), "fc.weight"), "hidden_norm.weight")
+        h = block_embed.to(self.dev).float() * c.embed_scale
+        pos_blk = torch.arange(h.shape[0], device=self.dev, dtype=torch.int64) + int(anchor_pos)
+        pos_ctx = pos_ctx.to(self.dev)
+        for i in range(c.layers):
+            h = self.layer(i, h, ctx, pos_blk, pos_ctx)
+        return self.rms(h, "norm.weight")
+
+    @torch.inference_mode()
+    def selector_hidden(self, final):
+        return self.lin(final, SELECTOR + "hidden_projection.weight")
+
+
+def finish_logits(cfg: DraftConfig, logits):
+    """The config's output multiplier and softcap on head logits (both absent in the published drafts)."""
+    logits = logits * cfg.output_multiplier
+    return torch.tanh(logits / cfg.softcap) * cfg.softcap if cfg.softcap else logits
+
+
+def top_k(logits: torch.Tensor, k: int):
+    """The k best of each row by (logit desc, id asc), TensorFold's and the sorted reference's order; one extra."""
+    vals, ids = torch.sort(logits.float(), dim=-1, descending=True, stable=True)
+    return ids[:, : k + 1].cpu().numpy().astype(np.int64), vals[:, : k + 1].cpu().numpy().astype(np.float32)
+
+
+def bf16_rows(table: torch.Tensor, ids) -> np.ndarray:
+    """Rows `ids` of a bf16 [vocab, rank] table as float64."""
+    return table[torch.as_tensor(np.asarray(ids, dtype=np.int64))].double().numpy()
+
+
+def select(cand_ids, cand_logits, sel_h, pred, succ, anchor, forced=None):
+    """Greedy float64 chain: logit + <pred[prev] * h_t, succ[c]>, first max in order; `forced` teacher-forces prev."""
+    rows = []
+    prev = int(anchor)
+    for t in range(cand_ids.shape[0]):
+        ids = np.asarray(cand_ids[t], dtype=np.int64)
+        ok = ids >= 0
+        s = np.full(ids.shape, -np.inf)
+        h = np.asarray(sel_h[t], dtype=np.float64)
+        edge = bf16_rows(succ, ids[ok]) @ (bf16_rows(pred, [prev])[0] * h)
+        s[ok] = np.asarray(cand_logits[t], dtype=np.float64)[ok] + edge
+        b = int(np.argmax(s))
+        others = s.copy()
+        others[b] = -np.inf
+        r = int(np.argmax(others))
+        margin = float(s[b] - others[r]) if ids.size > 1 else float("inf")
+        rows.append({"token": int(ids[b]), "index": b, "margin": margin, "score": float(s[b]),
+                     "runner_up": int(ids[r])})
+        prev = int(forced[t]) if forced is not None else int(ids[b])
+    return rows
