+    "for (int i = 0; i < n; i++) { v.push_back(x << 1); }\n",
+    "<div class=\"row\"><span>{{ name }}</span><a href=\"/x?a=1&b=2\">link</a></div>\n",
+    "fn add(a: u32, b: u32) u32 { return a + b; } // Vec<Option<T>> stays generic\n",
+    "    if x <= y:\n        return [y, x]\n",
+    "- item one\n- item two with **bold** and `code`\n",
+};
+
+/// A long, mixed text (prose, code, markup, UTF-8) to cut replies from.
+fn corpus(a: Allocator, bytes: usize) ![]const u8 {
+    var out: std.ArrayList(u8) = .empty;
+    var state: u64 = 0x9e3779b97f4a7c15;
+    while (out.items.len < bytes) {
+        state = state *% 6364136223846793005 +% 1442695040888963407;
+        try out.appendSlice(a, prose[(state >> 33) % prose.len]);
+    }
+    return out.items;
+}
+
+/// Answers ``reply`` a token a round, led by the think opener when the prompt left it to the reply; or from a thread.
+const Replay = struct {
+    reply: []const u32 = &.{},
+    lead: []const u32 = &.{}, // the opener and its newline, written by a reply whose prompt does not end in it
+    open: u32,
+    threaded: bool = false,
+    thread: ?std.Thread = null,
+    io: std.Io,
+    engine_ns: i96 = 0,
+    stop_ns: i96 = 0,
+
+    fn engine(e: *Replay) api.Engine {
+        return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 1 << 20, .structures = true };
+    }
+    fn submit(ctx: *anyopaque, id: api.Id, r: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const e: *Replay = @ptrCast(@alignCast(ctx));
+        const opened = r.prompt.len > 0 and r.prompt[r.prompt.len - 1] == e.open;
+        if (!e.threaded) return e.run(id, r, sink, opened);
+        e.thread = std.Thread.spawn(.{}, run, .{ e, id, r, sink, opened }) catch return error.Busy;
+    }
+    fn run(e: *Replay, id: api.Id, r: *const api.Request, sink: api.Sink, opened: bool) void {
+        const t0 = now(e.io);
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        var emitted: std.ArrayList(u32) = .empty;
+        defer emitted.deinit(std.heap.c_allocator);
+        const parts = [_][]const u32{ if (opened) &.{} else e.lead, e.reply };
+        outer: for (parts) |part| for (0..part.len) |i| {
+            sink.event(sink.ctx, id, &.{ .tokens = part[i .. i + 1] });
+            if (r.stop) |hook| {
+                emitted.append(std.heap.c_allocator, part[i]) catch {};
+                const s0 = now(e.io);
+                const hit = hook.check(hook.ctx, emitted.items);
+                e.stop_ns += now(e.io) - s0;
+                if (hit) break :outer;
+            }
+        };
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .stop } });
+        e.engine_ns = now(e.io) - t0;
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+fn now(io: std.Io) i96 {
+    return std.Io.Clock.awake.now(io).toNanoseconds();
+}
+
+fn cpuNow(io: std.Io) i96 {
+    return std.Io.Clock.cpu_thread.now(io).toNanoseconds();
+}
+
+/// The client: reads the reply to its end, slowly when ``pause_us`` > 0 (a read of ``chunk`` bytes, then a pause).
+const Reader = struct {
+    fd: platform.posix.socket_t,
+    io: std.Io,
+    pause_us: i64 = 0,
+    chunk: usize = 65536,
+    bytes: std.ArrayList(u8) = .empty,
+
+    fn run(r: *Reader) void {
+        var tmp: [65536]u8 = undefined;
+        while (true) {
+            const n = platform.posix.read(r.fd, tmp[0..r.chunk]) catch break;
+            if (n == 0) break;
+            r.bytes.appendSlice(std.heap.c_allocator, tmp[0..n]) catch break;
+            if (r.pause_us > 0) std.Io.sleep(r.io, .fromMicroseconds(r.pause_us), .awake) catch {};
+        }
+    }
+};
+
+const Result = struct { wall_ns: i96, cpu_ns: i96, arena: usize, bytes: usize, digest: u64, engine_ns: i96, stop_ns: i96 };
+
+fn writeAll(fd: platform.posix.socket_t, data: []const u8) !void {
+    var sent: usize = 0;
+    while (sent < data.len) {
+        const n = platform.posix.system.write(fd, data[sent..].ptr, data.len - sent);
+        if (n <= 0) return error.Closed;
+        sent += @intCast(n);
+    }
+}
+
+/// One request over a socket pair, the reply drained by a reader thread.
+fn exchange(srv: *server.Server, io: std.Io, replay: *Replay, path: []const u8, body: []const u8, pause_us: i64) !Result {
+    var pair: [2]platform.posix.socket_t = undefined;
+    if (platform.c.socketpair(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0, &pair) != 0) return error.SocketPair;
+    defer _ = platform.posix.system.close(pair[0]);
+    var head_buf: [256]u8 = undefined;
+    const head = try std.fmt.bufPrint(&head_buf, "POST {s} HTTP/1.1\r\nHost: t\r\nContent-Length: {d}\r\n\r\n", .{ path, body.len });
+    try writeAll(pair[0], head);
+    try writeAll(pair[0], body);
+    var reader: Reader = .{ .fd = pair[0], .io = io, .pause_us = pause_us, .chunk = if (pause_us > 0) 4096 else 65536 };
+    defer reader.bytes.deinit(std.heap.c_allocator);
+    const thread = try std.Thread.spawn(.{}, Reader.run, .{&reader});
+    var arena = std.heap.ArenaAllocator.init(std.heap.c_allocator);
+    defer arena.deinit();
+    const t0 = now(io);
+    const c0 = cpuNow(io);
+    {
+        var conn = try Conn.init(std.heap.c_allocator, pair[1], "bench");
+        defer conn.deinit();
+        conn.timeouts = .{ .idle_ms = 60000, .read_ms = 60000, .write_ms = 600000 };
+        if (try conn.readRequest(arena.allocator(), false) != .ready) return error.BadRequest;
+        routes.dispatch(srv, &conn, arena.allocator());
+    }
+    const wall = now(io) - t0;
+    const cpu = cpuNow(io) - c0;
+    _ = platform.posix.system.close(pair[1]);
+    thread.join();
+    if (replay.thread) |t| t.join();
+    replay.thread = null;
+    return .{ .wall_ns = wall, .cpu_ns = cpu, .arena = arena.queryCapacity(), .bytes = reader.bytes.items.len, .digest = try digest(reader.bytes.items), .engine_ns = replay.engine_ns, .stop_ns = replay.stop_ns };
+}
+
+const text_keys = [_][]const u8{ "content", "reasoning_content", "arguments", "name", "text", "thinking", "partial_json", "finish_reason", "stop_reason", "type" };
+
+fn walk(h: *std.hash.Wyhash, v: json.Value) void {
+    switch (v) {
+        .object => |o| for (o.keys(), o.values()) |k, x| {
+            for (text_keys) |t| if (std.mem.eql(u8, k, t) and x == .string) {
+                h.update(k);
+                h.update("=");
+                h.update(x.string);
+                h.update("\x01");
+            };
+            walk(h, x);
+        },
+        .array => |arr| for (arr) |x| walk(h, x),
+        else => {},
+    }
+}
+
+/// What the client saw, ids and times aside: every text a frame or the body carries, frame by frame.
+fn digest(bytes: []const u8) !u64 {
+    var arena = std.heap.ArenaAllocator.init(std.heap.c_allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var h = std.hash.Wyhash.init(0);
+    const split = std.mem.indexOf(u8, bytes, "\r\n\r\n") orelse return 0;
+    const body = bytes[split + 4 ..];
+    if (std.mem.indexOf(u8, bytes[0..split], "text/event-stream") == null) {
+        switch (try json.parse(a, body)) {
+            .ok => |v| walk(&h, v),
+            .err => return 1,
+        }
+        return h.final();
+    }
+    var lines = std.mem.splitScalar(u8, body, '\n');
+    while (lines.next()) |line| {
+        if (!std.mem.startsWith(u8, line, "data: {")) continue;
+        switch (try json.parse(a, line["data: ".len..])) {
+            .ok => |v| walk(&h, v),
+            .err => return 1,
+        }
+        h.update("\x02");
+    }
+    return h.final();
+}
+
+const Scenario = enum { plain, think, tools, agent, stops };
+
+/// The reply tokens a scenario answers with ``n`` tokens of text, and whether it thinks, offers tools or stops.
+fn replyOf(a: Allocator, text: *HfText, body: []const u32, s: Scenario, n: usize) ![]const u32 {
+    const t = text.text();
+    const close = t.tokenId("</mm:think>").?;
+    const eos = t.eosIds()[0];
+    const nl = try t.encode(a, "\n", false);
+    const nl2 = try t.encode(a, "\n\n", false);
+    const head = try t.encode(a, call_head, false);
+    const tail = try t.encode(a, call_tail, false);
+    const q = n / 4;
+    const e: []const u32 = &[_]u32{eos};
+    const c: []const u32 = &[_]u32{close};
+    const out = switch (s) {
+        .plain, .stops => try std.mem.concat(a, u32, &.{ body[0..n], e }),
+        .think => try std.mem.concat(a, u32, &.{ body[0 .. n - q], nl, c, nl2, body[0..q], e }),
+        .tools => try std.mem.concat(a, u32, &.{ body[0..q], head, body[q..n], tail, e }),
+        .agent => try std.mem.concat(a, u32, &.{ body[0 .. n / 2], nl, c, nl2, body[0 .. n / 8], head, body[n / 2 .. n / 2 + 3 * n / 8], tail, e }),
+    };
+    return out;
+}
+
+fn requestBody(a: Allocator, anthropic: bool, s: Scenario, n: usize, stream: bool) ![]const u8 {
+    const thinking = s == .think or s == .agent;
+    const tools = s == .tools or s == .agent;
+    const messages = "\"messages\":[{\"role\":\"user\",\"content\":\"Write a long answer about streaming servers.\"}]";
+    const schema = "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"path\",\"content\"]}";
+    if (anthropic) {
+        const tool_text = if (tools) ",\"tools\":[{\"name\":\"write_file\",\"description\":\"Write a file\",\"input_schema\":" ++ schema ++ "}]" else "";
+        const stop_text = if (s == .stops) ",\"stop_sequences\":[\"<<<END>>>\",\"\\n\\n\\n\\n\"]" else "";
+        return std.fmt.allocPrint(a, "{{\"model\":\"m\",\"max_tokens\":{d},\"stream\":{any},{s},\"thinking\":{{\"type\":\"{s}\"}}{s}{s}}}", .{ n + 64, stream, messages, if (thinking) "adaptive" else "disabled", tool_text, stop_text });
+    }
+    const tool_text = if (tools) ",\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"write_file\",\"description\":\"Write a file\",\"parameters\":" ++ schema ++ "}}]" else "";
+    const stop_text = if (s == .stops) ",\"stop\":[\"<<<END>>>\",\"\\n\\n\\n\\n\"]" else "";
+    return std.fmt.allocPrint(a, "{{\"model\":\"m\",\"max_tokens\":{d},\"stream\":{any},{s},\"chat_template_kwargs\":{{\"enable_thinking\":{any}}}{s}{s}}}", .{ n + 64, stream, messages, thinking, tool_text, stop_text });
+}
+
+pub fn main(init: std.process.Init) !void {
+    const io = init.io;
+    const gpa = std.heap.c_allocator;
+    const a = init.arena.allocator();
+    const argv = try init.minimal.args.toSlice(a);
+    const dir = if (argv.len > 1) argv[1] else std.fs.path.dirname(options.tokenizer_path) orelse ".";
+    const reps: usize = if (argv.len > 2) try std.fmt.parseInt(usize, argv[2], 10) else 2;
+    var problem: []const u8 = "";
+    const text = HfText.load(gpa, io, dir, null, a, &problem) catch |e| {
+        std.debug.print("cannot load {s}: {s} ({s})\n", .{ dir, problem, @errorName(e) });
+        return e;
+    };
+    defer text.deinit();
+    const t = text.text();
+    const body = try t.encode(a, try corpus(a, 400_000), false);
+    std.debug.print("corpus tokens={d}\n", .{body.len});
+    var replay: Replay = .{ .open = t.tokenId("<mm:think>").?, .io = io, .lead = try std.mem.concat(a, u32, &.{ &.{t.tokenId("<mm:think>").?}, try t.encode(a, "\n", false) }) };
+    const srv = try server.Server.init(gpa, io, replay.engine(), t, .{ .served_name = "m", .model_ids = &.{"m"}, .enable_thinking = false, .use_drafts = false, .default_max_tokens = 1 << 20, .keep_warm_s = 0 }, null);
+    defer srv.deinit();
+    @import("log.zig").init(io, true);
+    std.debug.print("api,mode,scenario,tokens,incremental,wall_ms,cpu_ms,us_per_token,arena_mb,bytes,stop_hook_ms,digest_same\n", .{});
+    for ([_]usize{ 1024, 8192, 32768 }) |n| for (std.enums.values(Scenario)) |s| for ([_]bool{ false, true }) |anthropic| for ([_]bool{ false, true }) |stream| {
+        replay.reply = try replyOf(a, text, body, s, n);
+        const req = try requestBody(a, anthropic, s, n, stream);
+        var digests: [2]u64 = undefined;
+        for ([_]bool{ false, true }, 0..) |on, k| {
+            srv.toggles.incremental = on;
+            var best: ?Result = null;
+            for (0..reps) |_| {
+                replay.stop_ns = 0;
+                const r = try exchange(srv, io, &replay, if (anthropic) "/v1/messages" else "/v1/chat/completions", req, 0);
+                if (best == null or r.cpu_ns < best.?.cpu_ns) best = r;
+            }
+            const r = best.?;
+            digests[k] = r.digest;
+            const cpu_ms = @as(f64, @floatFromInt(r.cpu_ns)) / 1e6;
+            std.debug.print("{s},{s},{s},{d},{s},{d:.2},{d:.2},{d:.2},{d:.1},{d},{d:.2},{s}\n", .{ if (anthropic) "anthropic" else "openai", if (stream) "stream" else "whole", @tagName(s), n, if (on) "on" else "off", @as(f64, @floatFromInt(r.wall_ns)) / 1e6, cpu_ms, cpu_ms * 1000 / @as(f64, @floatFromInt(n)), @as(f64, @floatFromInt(r.arena)) / (1 << 20), r.bytes, @as(f64, @floatFromInt(r.stop_ns)) / 1e6, if (k == 1) (if (digests[0] == digests[1]) "yes" else "NO") else "-" });
+        }
+    };
+    // a slow client: the engine thread emits as fast as it can while the reader takes 4 KiB a pause
+    std.debug.print("slow,reader_pause_us,tokens,engine_ms,server_wall_ms,cpu_ms,arena_mb,bytes\n", .{});
+    replay.threaded = true;
+    srv.toggles.incremental = true;
+    for ([_]i64{ 0, 1000 }) |pause| {
+        const n = 8192;
+        replay.reply = try replyOf(a, text, body, .think, n);
+        const r = try exchange(srv, io, &replay, "/v1/chat/completions", try requestBody(a, false, .think, n, true), pause);
+        std.debug.print("slow,{d},{d},{d:.2},{d:.2},{d:.2},{d:.1},{d}\n", .{ pause, n, @as(f64, @floatFromInt(r.engine_ns)) / 1e6, @as(f64, @floatFromInt(r.wall_ns)) / 1e6, @as(f64, @floatFromInt(r.cpu_ns)) / 1e6, @as(f64, @floatFromInt(r.arena)) / (1 << 20), r.bytes });
+    }
+}
