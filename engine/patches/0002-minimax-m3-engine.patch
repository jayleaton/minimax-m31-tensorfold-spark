+//! A chain drafter's landing chances through the drafts wrapper: node probabilities on only when offered and readable.
+const std = @import("std");
+const fake = @import("fake.zig");
+const sm = @import("stream.zig");
+const dr = @import("drafter.zig");
+const dt = @import("drafted_test.zig");
+const Drafted = @import("drafted.zig").Drafted;
+const gpa = std.testing.allocator;
+
+fn noChances(_: *anyopaque, _: *sm.Stream, _: []f64) anyerror!bool {
+    return false;
+}
+
+test "a chain drafter's own chances turn on node probabilities only when it says so and can give them" {
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var head: dt.FakeDrafter = .{ .facts_ = .{ .depth = 7, .step_ms = 1.0, .chain_chances = true } };
+    defer head.deinit();
+    const plain = head.drafter();
+    var vt = plain.vtable.*;
+    vt.chances = noChances;
+    const priced: dr.Drafter = .{ .ptr = plain.ptr, .vtable = &vt };
+    const t = dt.base();
+    var without: Drafted = .{ .gpa = gpa, .target = target.backend(), .drafter = plain };
+    defer without.deinit();
+    var with: Drafted = .{ .gpa = gpa, .target = target.backend(), .drafter = priced };
+    defer with.deinit();
+    try std.testing.expect(!without.facts(t).draft_probabilities); // no chances to read: the rule's rates price it
+    try std.testing.expect(with.facts(t).draft_probabilities and with.facts(t).chances_gated);
+    head.facts_.chain_chances = false;
+    try std.testing.expect(!with.facts(t).draft_probabilities); // the drafter did not offer them for chains
+}
