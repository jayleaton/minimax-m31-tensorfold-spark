diff --git a/zig/tests/cuda/contract_minimax_rows_fmt.zig b/zig/tests/cuda/contract_minimax_rows_fmt.zig
new file mode 100644
index 0000000000000000000000000000000000000000..cf4495b159579d3493851c93033956f98137a231
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_rows_fmt.zig
@@ -0,0 +1,133 @@
+//! tf_mm3_rows into int4 K/V and e4m3 index-key pools: v exact to the host twins, k and ik within half a step.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rows = @import("contract_minimax_rows.zig");
+
+const c = core.contract.spec;
+const mr = core.minimax_ref;
+const geom = cuda.minimax_m3_sparse.geom;
+
+const kvh = 2;
+
+/// The float64 norm and rotation of a source row (fp16 bits for the index key, bf16 for k).
+fn reference(w: *const rows.Writer, src: []const u16, fp: bool, wi: usize, p: usize) [128]f64 {
+    var x: [128]f64 = undefined;
+    var wt: [128]f64 = undefined;
+    for (&x, &wt, src, w.w[wi][0..]) |*o, *ww, s, wv| {
+        o.* = if (fp) rows.Writer.fp16v(s) else c.fromBf16(s);
+        ww.* = wv;
+    }
+    var y: [128]f64 = undefined;
+    mr.gemmaNorm(&x, &wt, 1e-6, false, &y);
+    mr.rope(&y, 64, p, 1e7, .neox_half);
+    return y;
+}
+
+fn f16At(b: []const u8, i: usize) f32 {
+    const h: f16 = @bitCast(std.mem.readInt(u16, b[2 * i ..][0..2], .little));
+    return h;
+}
+
+/// A stored row (values and scales in the pool) as floats: e4m3 codes times the row scale, int4 by the group scales.
+fn decoded(bytes: []const u8, at: usize, sc: usize, v: geom.Val, out: *[128]f64) void {
+    for (out, 0..) |*o, e| o.* = switch (v) {
+        .bf16 => c.fromBf16(std.mem.readInt(u16, bytes[at + 2 * e ..][0..2], .little)),
+        .e4m3 => mr.e4m3Value(bytes[at + e]) * @as(f64, @as(f32, @bitCast(std.mem.readInt(u32, bytes[sc..][0..4], .little)))),
+        .q4 => mr.q4Value((bytes[at + e / 2] >> @intCast(4 * (e % 2))) & 15, f16At(bytes[sc..], e / 32)),
+        .s8 => @as(f64, @floatFromInt(@as(i8, @bitCast(bytes[at + e])))) * f16At(bytes[sc..], e / 32),
+        .s16 => @as(f64, @floatFromInt(@as(i8, @bitCast(bytes[at + e])))) * f16At(bytes[sc..], e / 16),
+    };
+}
+
+/// A k or ik row against its float64 value: within half its format's step, the bf16 rounding and the norm's error.
+fn near(got: *const [128]f64, want: *const [128]f64, v: geom.Val) bool {
+    var amax: [4]f64 = @splat(0);
+    var amax16: [8]f64 = @splat(0);
+    for (want, 0..) |x, e| {
+        amax[e / 32] = @max(amax[e / 32], @abs(x));
+        amax16[e / 16] = @max(amax16[e / 16], @abs(x));
+    }
+    const row = @max(@max(amax[0], amax[1]), @max(amax[2], amax[3]));
+    for (got, want, 0..) |g, x, e| {
+        const lim = switch (v) {
+            .bf16 => @abs(x) * 0x1p-7,
+            .e4m3 => @abs(x) * (0x1p-4 + 0x1p-7) + row / 448 * 0x1p-9,
+            .q4 => amax[e / 32] / 7 * (0.5 + 0x1p-6) + @abs(x) * 0x1p-7,
+            .s8 => amax[e / 32] / 127 * (0.5 + 0x1p-6) + @abs(x) * 0x1p-7,
+            .s16 => amax16[e / 16] / 127 * (0.5 + 0x1p-6) + @abs(x) * 0x1p-7,
+        };
+        if (!(@abs(g - x) <= lim + 1e-4)) return false;
+    }
+    return true;
+}
+
+/// v's stored bytes equal the twin's quantization of its bf16 value (codes and scales, bit for bit).
+fn vExact(bytes: []const u8, at: usize, sc: usize, v: geom.Val, src: []const u16) bool {
+    var x: [128]f32 = undefined;
+    for (&x, src) |*o, s| o.* = c.fromBf16(s);
+    switch (v) {
+        .bf16 => return std.mem.eql(u8, bytes[at..][0..256], std.mem.sliceAsBytes(src)),
+        .e4m3 => {
+            var codes: [128]u8 = undefined;
+            const s = mr.quantRowF32(&x, &codes);
+            return std.mem.eql(u8, bytes[at..][0..128], &codes) and std.mem.readInt(u32, bytes[sc..][0..4], .little) == @as(u32, @bitCast(s));
+        },
+        .s8, .s16 => unreachable, // v is never int8
+        .q4 => {
+            var n: [128]u8 = undefined;
+            var s: [4]f32 = undefined;
+            var packed_: [64]u8 = undefined;
+            mr.quantRow4F32(&x, &n, &s);
+            mr.packQ4(&n, &packed_);
+            if (!std.mem.eql(u8, bytes[at..][0..64], &packed_)) return false;
+            for (s, 0..) |want, gi| {
+                const got = f16At(bytes[sc..], gi);
+                if (!(got == want or (std.math.isNan(got) and std.math.isNan(want)))) return false;
+            }
+            return true;
+        },
+    }
+}
+
+fn touch(t: []bool, at: usize, len: usize) void {
+    @memset(t[at..][0..len], true);
+}
+
+pub fn check(w: *rows.Writer) !?[]const u8 {
+    const pool = rows.poolFor(w.f);
+    const f = pool.fmt();
+    const bytes = try w.rig.bytes(w.dev[10], w.pages * pool.pageBytes());
+    const touched = try w.arena.allocator().alloc(bool, bytes.len);
+    @memset(touched, false);
+    for (0..w.shape.rows) |r| {
+        const p: usize = @intCast(w.pos[r]);
+        const page: usize = @intCast(w.table[(if (w.f.prompt) 0 else r * w.blocks) + p / geom.block]);
+        const t = p % geom.block;
+        for (0..kvh) |h| {
+            const k0 = pool.kv(page, 0, 0, h, t);
+            const v0 = pool.kv(page, 0, 1, h, t);
+            touch(touched, k0, f.k.rowBytes());
+            touch(touched, v0, f.v.rowBytes());
+            const ks = if (f.k == .bf16) 0 else pool.scale(page, 0, 0, h, t);
+            const vs = if (f.v == .bf16) 0 else pool.scale(page, 0, 1, h, t);
+            if (f.k != .bf16) touch(touched, ks, f.k.scaleBytes());
+            if (f.v != .bf16) touch(touched, vs, f.v.scaleBytes());
+            if (!vExact(bytes, v0, vs, f.v, w.vv[(r * kvh + h) * 128 ..][0..128])) return "v was not stored as the twin's quantized row of its bf16 value";
+            var got: [128]f64 = undefined;
+            decoded(bytes, k0, ks, f.k, &got);
+            const want = reference(w, w.kk[(r * kvh + h) * 128 ..][0..128], false, 1, p);
+            if (!near(&got, &want, f.k)) return "k differs from the float64 norm and rotation beyond its format's half step";
+        }
+        const ik0 = pool.ik(page, 0, t);
