+/// Each streamed reasoning delta's text, joined.
+const Thought = struct {
+    a: Allocator,
+    text: std.ArrayList(u8) = .empty,
+
+    fn call(ctx: *anyopaque, delta: json.Value) error{Closed}!void {
+        const t: *Thought = @ptrCast(@alignCast(ctx));
