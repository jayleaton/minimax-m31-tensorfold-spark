+    const d = try dd.Draft.init(gpa, &w.lanes, .{ .dspark = dc.flash }, 0, .{});
+    defer d.deinit();
+    const static_8 = d.costs[7].ms;
+    var t: calib.Table = .{ .window_ms = undefined, .pass_ms = 8.4 };
+    for (&t.window_ms, 1..) |*m, rows| m.* = 20 + 0.5 * @as(f64, @floatFromInt(rows));
