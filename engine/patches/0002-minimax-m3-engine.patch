+}
+
+} // namespace
+
+extern "C" __global__ void __launch_bounds__(256) tf_mm3_attn4(
+    const bf16* __restrict__ q, const int* __restrict__ sel, const int* __restrict__ pos, int pos0,
+    const int* __restrict__ row_tab, const int* __restrict__ tables, const char* __restrict__ pool,
+    long long page_bytes, long long layer_off, int kvh, bf16* __restrict__ out, float scale,
+    int fmt) {  // V int4; K int4 (kind 2) or e4m3 (kind 1)
+    __shared__ Attn4Shared sh;
+    if (k_val(fmt) == VAL_Q4) attn4_body<VAL_Q4>(sh, q, sel, pos, pos0, row_tab, tables, pool, page_bytes, layer_off, kvh, out, scale, fmt);
+    else attn4_body<VAL_E4M3>(sh, q, sel, pos, pos0, row_tab, tables, pool, page_bytes, layer_off, kvh, out, scale, fmt);
+}
diff --git a/zig/kernels/cuda/minimax_m3_dflash2.cu b/zig/kernels/cuda/minimax_m3_dflash2.cu
