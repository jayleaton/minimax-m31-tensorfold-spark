new file mode 100644
index 0000000000000000000000000000000000000000..1771e1eb32d0b3afe6ea24cc7737b7bf5a09bdf0
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_dflash2_conv.zig
@@ -0,0 +1,179 @@
+//! The DFlash2 dynamic conv under the contract on CUDA: float64 reference dflash2_ref.zig `conv`, one planted control.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const common = @import("contract_minimax_dspark_common.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const dk = cuda.minimax_m3_dflash2;
+const ref = @import("minimax_cuda").dflash2_ref;
+const hidden = common.hidden;
+const zeroDepth = common.zeroDepth;
+const bf = common.bf;
+
+pub const group = 16; // both published drafts
+
+/// store: the pre-sublayer side (bf16 z, bf16 out); add: the post-sublayer side (f32 z added to the f32 residual).
+pub const Form = enum { store, add, ctl_side };
+
+// Both drafts' block of eight, one row, and a width past one 1024-channel block (rows, hidden, group).
+const served = &[_]c.Shape{ .{ .rows = 8, .n = hidden, .k = group }, .{ .rows = 1, .n = hidden, .k = group }, .{ .rows = 3, .n = 1040, .k = group } };
+
+pub fn spec(f: Form) c.Spec {
+    return .{
+        .name = switch (f) {
+            .store => "cuda minimax_m3_dflash2 tf_mm3_d2_conv (bf16 z, side 0, bf16 out)",
+            .add => "cuda minimax_m3_dflash2 tf_mm3_d2_conv (f32 z, side 1, added to f32)",
+            .ctl_side => "control: dflash2 conv reading the other side's coefficients",
+        },
+        .accum = .none,
+        .depth = zeroDepth,
+        .out = if (f == .add) .f32 else .bf16,
+        // rows, channels (a block takes 1024, a valid width moves by a group), the group
+        .tiles = .{ .{}, .{ .size = 1024, .step = group, .min = group }, .{} },
+        .served = served,
+        .sums = .{ .f16 = 0, .bf16 = 0, .why = "two products a channel, no sum of many" },
+    };
+}
+
+pub fn control(f: Form) ?g.Gate {
+    return if (f == .ctl_side) .shapes else null;
+}
+
+pub const Conv = struct {
+    rig: rig_.Rig,
+    form: Form,
+    k: *const dk.Dflash2,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    ld: usize = 0,
+    zb: []u16 = &.{},
+    zf: []f32 = &.{},
+    dyn: []u16 = &.{},
+    base: []u16 = &.{},
+    acc: []f32 = &.{},
+    dev: [4]u64 = @splat(0), // z, dyn, base, out
+
+    pub fn deinit(self: *Conv) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    const vt = g.hooks(Conv);
+
+    pub fn kernel(self: *Conv) g.Kernel {
+        return .{ .spec = spec(self.form), .ctx = self, .vt = &vt, .control = control(self.form) };
+    }
+
+    fn adds(self: *const Conv) bool {
+        return self.form == .add;
+    }
+
+    /// The side the reference reads; the control launches the other one.
+    fn which(self: *const Conv) usize {
+        return if (self.adds()) 1 else 0;
+    }
+
+    fn setZ(self: *Conv, i: usize, v: f32) void {
+        if (self.adds()) self.zf[i] = v else self.zb[i] = c.toBf16(v);
+    }
+
+    pub fn prepare(self: *Conv, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        const hid = shape.n;
+        const grp = shape.k;
+        const rows = shape.rows;
+        if (grp == 0 or hid == 0 or hid % grp != 0) return false;
+        const groups = hid / grp;
+        const pad: usize = if (hid == hidden) 0 else 3; // a padded dyn row at the other widths: the pads hold NaN
+        const ld = 4 * groups + pad;
+        dk.checkConv(.{ .hidden = @intCast(hid), .group = @intCast(grp), .ld_dyn = @intCast(ld), .rows = @intCast(rows) }) catch return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        self.ld = ld;
+        const n = rows * hid;
+        self.dyn = try a.alloc(u16, rows * ld);
+        for (self.dyn, 0..) |*e, i| e.* = if (i % ld >= 4 * groups) c.toBf16(std.math.nan(f32)) else bf(rng, 0.05);
+        // lag 0 near 1 and lag 1 near 0, as both checkpoints' base kernels sit
+        self.base = try a.alloc(u16, 4 * hid);
+        for (self.base, 0..) |*e, i| e.* = if ((i / hid) % 2 == 0) c.toBf16(1 + rng.floatNorm(f32) * 0.1) else bf(rng, 0.05);
+        if (self.adds()) {
+            self.zf = try a.alloc(f32, n);
+            self.acc = try a.alloc(f32, n);
+            for (self.zf, self.acc) |*z, *r| {
+                z.* = rng.floatNorm(f32);
+                r.* = rng.floatNorm(f32) * 4;
+            }
+        } else {
+            self.zb = try a.alloc(u16, n);
+            for (self.zb) |*z| z.* = bf(rng, 1);
+        }
+        if (fill == .nonfinite) {
+            const w = self.which();
+            const inf = std.math.inf(f32);
+            if (rows > 1) self.setZ(hid + 5, std.math.nan(f32));
+            if (rows > 2) self.setZ(2 * hid + 100 % hid, inf);
+            if (rows > 3) self.setZ(3 * hid + 7, -inf);
+            if (rows > 4 and groups > 3) self.dyn[4 * ld + w * 2 * groups + 3] = c.toBf16(inf); // lag 0, group 3, row 4
+            // lag 1 of channel 9: NaN on every row, row 0 included (its zero z[-1] times NaN)
+            self.base[(w * 2 + 1) * hid + 9 % hid] = c.toBf16(std.math.nan(f32));
+            if (self.adds()) self.acc[3 % n] = std.math.nan(f32);
+        }
+        self.dev[0] = if (self.adds()) try self.rig.input(std.mem.sliceAsBytes(self.zf)) else try self.rig.input(std.mem.sliceAsBytes(self.zb));
+        self.dev[1] = try self.rig.input(std.mem.sliceAsBytes(self.dyn));
+        self.dev[2] = try self.rig.input(std.mem.sliceAsBytes(self.base));
+        const size: usize = if (self.adds()) 4 else 2;
+        self.dev[3] = try self.rig.output(n * size);
+        return true;
+    }
+
+    /// The add form first restores the residual it adds into, so every run starts from the same bytes.
+    pub fn run(self: *Conv) !void {
+        const s = self.shape;
+        const add = self.adds();
+        if (add) {
+            const b: cuda.DeviceBuffer = .{ .d = self.rig.gpu.d, .ptr = self.dev[3], .len = self.acc.len * 4 };
+            try b.upload(0, std.mem.sliceAsBytes(self.acc));
+        }
+        const w: u32 = if (self.form == .ctl_side) 1 else @intCast(self.which());
+        const shape: dk.Conv = .{ .hidden = @intCast(s.n), .group = @intCast(s.k), .ld_dyn = @intCast(self.ld), .rows = @intCast(s.rows) };
+        try self.k.conv(self.rig.s, shape, self.dev[0], add, self.dev[1], w, self.dev[2], self.dev[3], add);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Conv) usize {
+        return self.shape.rows * self.shape.n;
+    }
+
+    fn input(self: *const Conv) ref.Conv {
+        const s = self.shape;
+        const z: ref.Z = if (self.adds()) .{ .f32 = self.zf } else .{ .bf16 = self.zb };
+        return .{ .z = z, .dyn = self.dyn, .ld_dyn = self.ld, .which = self.which(), .base = self.base, .hidden = s.n, .group = s.k, .rows = s.rows };
+    }
+
+    pub fn reference(self: *Conv, want: []f64, mag: []f64) !void {
+        ref.conv(self.input(), if (self.adds()) self.acc else null, want, mag);
+    }
+
+    /// fp32 coefficient adds, the product and the fma (3 deep), the residual add (4); then bf16's own rounding.
+    pub fn bounds(self: *Conv, want: []const f64, mag: []const f64, allow: []f64) !void {
+        const depth: f64 = if (self.adds()) 4 else 3;
+        const out_unit: f64 = if (self.adds()) 0 else 0x1p-8;
+        const floor: f64 = if (self.adds()) 0x1p-149 else 0x1p-133;
+        for (allow, want, mag) |*l, w, m| {
+            const work = c.gamma(depth, 0x1p-24) * m;
+            l.* = work + out_unit * (@abs(w) + work) + floor;
+        }
+    }
+};
+
+test "the controls are the one named fault at its gate, and the served shapes fit the launch" {
+    try std.testing.expectEqual(@as(?g.Gate, .shapes), control(.ctl_side));
+    try std.testing.expectEqual(@as(?g.Gate, null), control(.store));
+    for (served) |s| try dk.checkConv(.{ .hidden = @intCast(s.n), .group = @intCast(s.k), .ld_dyn = @intCast(4 * (s.n / s.k)), .rows = @intCast(s.rows) });
+}
diff --git a/zig/tests/cuda/contract_minimax_dflash2_select.zig b/zig/tests/cuda/contract_minimax_dflash2_select.zig
new file mode 100644
index 0000000000000000000000000000000000000000..25cb8f6b8ca1b4c09d16bca74aae82a7c89b0d63
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_dflash2_select.zig
@@ -0,0 +1,227 @@
+//! The DFlash2 path selector under the contract on CUDA: float64 reference dflash2_ref.zig `row`, one planted control.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const common = @import("contract_minimax_dspark_common.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const dk = cuda.minimax_m3_dflash2;
+const ref = @import("minimax_cuda").dflash2_ref;
+const zeroDepth = common.zeroDepth;
+const bf = common.bf;
+
+pub const vocab_t = 4096;
+pub const rank = 256; // both published drafts
+pub const anchor: u32 = 17;
+
+/// Roundings in an fp32 score: pred * h, a lane's fma chain, the warp's five-level tree and the logit add.
+pub const score_depth = rank / 32 + 7;
+
+// Both drafts' top_k (incoai 32, the MiniMax class 16) on one and two ranks, the least block and the most candidates.
+const served = &[_]c.Shape{ .{ .rows = 8, .n = 32, .k = 2 }, .{ .rows = 8, .n = 32, .k = 1 }, .{ .rows = 8, .n = 16, .k = 2 }, .{ .rows = 8, .n = 16, .k = 1 }, .{ .rows = 2, .n = 16, .k = 2 }, .{ .rows = 5, .n = 64, .k = 2 } };
+
+pub fn spec(ctl: bool) c.Spec {
+    return .{
+        .name = if (ctl) "control: dflash2 selector scoring row 1 after the wrong predecessor" else "cuda minimax_m3_dflash2 tf_mm3_d2_select",
+        .accum = .none,
+        .depth = zeroDepth,
+        .out = .raw,
+        .nan = .{ .stated = "the k best by logit desc then id asc, NaN logits last, none skipped; the first NaN score wins, else the first maximum; no candidate gives {none, 0}" },
+        // rows, top_k, ranks
+        .served = served,
+        .sums = .{ .f16 = 0, .bf16 = 0, .why = "scores are checked against float64 within the fp32 dot's bound; no sums are declared" },
+    };
+}
+
+pub const Select = struct {
+    rig: rig_.Rig,
+    control: bool,
+    k: *const dk.Dflash2,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    temp: f32 = 1,
+    cands: []u32 = &.{}, // [world][rows][top_k] x {logit bits, id}
+    h: []f32 = &.{},
+    pred: []u16 = &.{},
+    succ: []u16 = &.{},
+    dev: [4]u64 = @splat(0),
+    out: u64 = 0,
+    /// Rows where the kernel took a float64 runner-up inside the two scores' fp32 bounds.
+    ties: usize = 0,
+    msg: [240]u8 = undefined,
+
+    pub fn deinit(self: *Select) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    const vt = g.hooks(Select);
+
+    pub fn kernel(self: *Select) g.Kernel {
+        return .{ .spec = spec(self.control), .ctx = self, .vt = &vt, .control = if (self.control) .shapes else null };
+    }
+
+    fn ent(self: *const Select, w: usize, t: usize, j: usize) *[2]u32 {
+        const s = self.shape;
+        return self.cands[((w * s.rows + t) * s.n + j) * 2 ..][0..2];
+    }
+
+    fn put(self: *const Select, w: usize, t: usize, j: usize, x: ref.Cand) void {
+        self.ent(w, t, j).* = .{ @bitCast(x.logit), x.id };
+    }
+
+    fn byOrder(_: void, a: ref.Cand, b: ref.Cand) bool {
+        return ref.before(a, b);
+    }
+
+    pub fn prepare(self: *Select, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        const k = shape.n;
+        const world = shape.k;
+        const rows = shape.rows;
+        if (world == 0 or world > 2 or k == 0 or k * world > dk.max_cand or vocab_t / world < k) return false;
+        dk.checkSelect(.{ .rank = rank, .top_k = @intCast(k), .world = @intCast(world), .rows = @intCast(rows) }) catch return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        self.temp = if (seed % 2 == 0) 1 else 0.75;
+        self.cands = try a.alloc(u32, world * rows * k * 2);
+        self.h = try a.alloc(f32, rows * rank);
+        self.pred = try a.alloc(u16, vocab_t * rank);
+        self.succ = try a.alloc(u16, vocab_t * rank);
+        for (self.pred) |*e| e.* = bf(rng, 0.25);
+        for (self.succ) |*e| e.* = bf(rng, 0.25);
+        for (self.h) |*e| e.* = rng.floatNorm(f32);
+        const nan = std.math.nan(f32);
+        const inf = std.math.inf(f32);
+        // each rank's ids are its own slice of the vocabulary, its list in top-C's order (row 3's left unordered)
+        const slice = vocab_t / world;
+        const perm = try a.alloc(u32, slice);
+        const list = try a.alloc(ref.Cand, k);
+        for (0..world) |w| for (0..rows) |t| {
+            for (perm, 0..) |*p, i| p.* = @intCast(w * slice + i);
+            rng.shuffle(u32, perm);
+            for (list, perm[0..k]) |*x, id| x.* = .{ .logit = rng.floatNorm(f32) * 2, .id = id };
+            if (t != 3) std.mem.sort(ref.Cand, list, {}, byOrder);
+            for (list, 0..) |x, j| self.put(w, t, j, x);
+            // row 0 is the anchor's and never read; rows 2, 5, .. end in padding; row 4 has no candidate at all
+            if (t == 0) for (0..k) |j| self.put(w, t, j, .{ .logit = nan, .id = 0 });
+            if (t % 3 == 2) for (k - @min(3, k - 1)..k) |j| self.put(w, t, j, .{ .logit = -inf, .id = ref.none });
+            if (t == 4) for (0..k) |j| self.put(w, t, j, .{ .logit = -inf, .id = ref.none });
+        };
+        // row 1: two candidates (across the ranks when there are two) on equal logits and successor rows: a true tie
+        if (rows > 1 and k >= 2) {
+            const ea = self.ent(0, 1, 0);
+            const eb = if (world == 2) self.ent(1, 1, 0) else self.ent(0, 1, 1);
+            @memcpy(self.succ[@as(usize, eb[1]) * rank ..][0..rank], self.succ[@as(usize, ea[1]) * rank ..][0..rank]);
+            ea[0] = @bitCast(@as(f32, 40));
+            eb[0] = @bitCast(@as(f32, 40));
+        }
+        if (fill == .nonfinite) {
+            if (rows > 3) self.ent(0, 3, 0)[0] = @bitCast(-inf);
+            if (rows > 5) self.h[5 * rank + 9] = nan;
+            // row 6: every logit of rank 0 NaN (cut by rank 1's numbers on two ranks, all NaN on one)
+            if (rows > 6) for (0..k) |j| {
+                self.ent(0, 6, j)[0] = @bitCast(nan);
+            };
+            if (rows > 7) self.ent(0, 7, k - 1)[0] = @bitCast(inf);
+        }
+        const bytes = [_][]const u8{ std.mem.sliceAsBytes(self.cands), std.mem.sliceAsBytes(self.h), std.mem.sliceAsBytes(self.pred), std.mem.sliceAsBytes(self.succ) };
+        for (bytes, &self.dev) |b, *p| p.* = try self.rig.input(b);
+        self.out = try self.rig.output((rows - 1) * 8);
+        return true;
+    }
+
+    /// The control takes anchor + 1 as row 1's predecessor.
+    pub fn run(self: *Select) !void {
+        const s = self.shape;
+        const d = self.dev;
+        const prev: u32 = if (self.control) anchor + 1 else anchor;
+        const call: dk.Select = .{ .rank = rank, .top_k = @intCast(s.n), .world = @intCast(s.k), .rows = @intCast(s.rows), .temp = self.temp };
+        try self.k.select(self.rig.s, call, prev, d[0], d[1], d[2], d[3], self.out);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Select) usize {
+        return (self.shape.rows - 1) * 8;
+    }
+
+    pub fn reference(self: *Select, want: []f64, mag: []f64) !void {
+        _ = self;
+        @memset(want, 0);
+        @memset(mag, 0);
+    }
+
+    fn input(self: *const Select) ref.Select {
+        const s = self.shape;
+        return .{ .cands = self.cands, .h = self.h, .pred = self.pred, .succ = self.succ, .rank = rank, .top_k = s.n, .world = s.k, .rows = s.rows, .anchor = anchor, .temp = self.temp };
+    }
+
+    fn err(r: *const ref.Row, i: usize) f64 {
+        return c.gamma(score_depth, 0x1p-24) * r.mag[i];
+    }
+
+    /// The share's relative allowance: each exp's argument off by both scores' bounds, expf's two ulps, the sum.
+    fn shareTol(self: *const Select, r: *const ref.Row, at: usize) f64 {
+        const temp: f64 = self.temp;
+        var most: f64 = 0;
+        for (0..r.m) |i| {
+            if (!std.math.isFinite(r.score[i])) continue;
+            const arg = @abs(r.score[i] - r.score[at]) / temp;
+            const e = (err(r, i) + err(r, at)) / temp + (2 * arg + 4) * 0x1p-24;
+            most = @max(most, @exp(e) - 1 + 0x1p-22);
+        }
+        return most + @as(f64, @floatFromInt(r.m + 1)) * 0x1p-24;
+    }
+
+    /// Along the kernel's path: float64's pick, or a runner-up inside both fp32 bounds (a near-tie); then its share.
+    pub fn check(self: *Select, at: g.Gate) !?[]const u8 {
+        _ = at;
+        const s = self.shape;
+        const in = self.input();
+        const out = try self.rig.outputBytes();
+        var prev = anchor;
+        for (1..s.rows) |t| {
+            const o = (t - 1) * 8;
+            const id = std.mem.readInt(u32, out[o..][0..4], .little);
+            const share: f32 = @bitCast(std.mem.readInt(u32, out[o + 4 ..][0..4], .little));
+            const r = ref.row(in, t, prev);
+            const want = r.pick orelse {
+                if (id != ref.none or share != 0) return std.fmt.bufPrint(&self.msg, "row {d}: no candidate, but the kernel gives {d} at share {e}", .{ t, id, share }) catch "a row with no candidate is not {none, 0}";
+                prev = anchor;
+                continue;
+            };
+            const got = for (r.c[0..r.m], 0..) |x, i| {
+                if (x.id == id) break i;
+            } else return std.fmt.bufPrint(&self.msg, "row {d}: token {d} is not among the {d} best", .{ t, id, r.m }) catch "token is not a candidate";
+            if (got != want) {
+                const ws = r.score[want];
+                const gs = r.score[got];
+                if (std.math.isNan(ws) or std.math.isNan(gs)) return std.fmt.bufPrint(&self.msg, "row {d}: token {d} where float64's first NaN is {d}", .{ t, id, r.c[want].id }) catch "the first NaN did not win";
+                const margin = err(&r, want) + err(&r, got);
+                if (!(ws - gs <= margin)) return std.fmt.bufPrint(&self.msg, "row {d}: token {d} scores {e} where {d} scores {e} (margin {e})", .{ t, id, gs, r.c[want].id, ws, margin }) catch "token is not the best";
+                if (!self.control) self.ties += 1;
+                std.debug.print("NEAR-TIE {s} row {d}: token {d} for float64's {d}, {e} apart within the fp32 margin {e}\n", .{ spec(self.control).name, t, id, r.c[want].id, ws - gs, margin });
+            }
+            const sw = r.share(got, self.temp);
+            if (std.math.isNan(sw)) {
+                if (!std.math.isNan(share)) return std.fmt.bufPrint(&self.msg, "row {d}: share {e} where float64's is NaN", .{ t, share }) catch "a NaN score must give a NaN share";
+            } else if (!(@abs(share - sw) <= self.shareTol(&r, got) * sw + 0x1p-126)) {
+                return std.fmt.bufPrint(&self.msg, "row {d}: share {e} where float64 gives {e}", .{ t, share, sw }) catch "share differs";
+            }
+            prev = id;
+        }
+        if (!try self.rig.intact()) return "the selector changed a buffer guard";
+        return null;
+    }
+};
+
+test "the served shapes fit the launch, and the scores' rounding depth is the kernel's" {
+    for (served) |s| try dk.checkSelect(.{ .rank = rank, .top_k = @intCast(s.n), .world = @intCast(s.k), .rows = @intCast(s.rows) });
+    try std.testing.expectEqual(@as(usize, 15), score_depth);
+    try std.testing.expect(vocab_t / 2 >= dk.max_cand);
+}
diff --git a/zig/tests/cuda/contract_minimax_index.zig b/zig/tests/cuda/contract_minimax_index.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c0bc6769fd61a7eb2e908f0203dffa2b952e34f5
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_index.zig
@@ -0,0 +1,437 @@
+//! MiniMax-M3.1-Flash tf_mm3_index and tf_mm3_index8 (e4m3 keys) under the contract, against float64, then select.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const attn = @import("contract_attn.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const mr = core.minimax_ref;
+const sp = cuda.minimax_m3_sparse;
+const geom = sp.geom;
+
+/// A rank's index heads (= local kv heads), layers in the test pool, and the layer read (the other is NaN).
+const kvh = 2;
+const layers = 2;
+const layer = 1;
+
+pub const Cfg = struct { name: []const u8, prompt: bool, kv8: bool, kv4: geom.Kv4 = .off, ik8: geom.Ik8 = .off, tiled: bool = false };
+
+pub const cfgs = [_]Cfg{
+    .{ .name = "cuda minimax_m3 tf_mm3_index decode, fp8 pages (kv8), 2 index heads, paged", .prompt = false, .kv8 = true },
+    .{ .name = "cuda minimax_m3 tf_mm3_index prompt chunk, fp8 pages (kv8), 2 index heads, paged", .prompt = true, .kv8 = true },
+    .{ .name = "cuda minimax_m3 tf_mm3_index decode, bf16 pages, 2 index heads, paged", .prompt = false, .kv8 = false },
+    .{ .name = "cuda minimax_m3 tf_mm3_index prompt chunk, bf16 pages, 2 index heads, paged", .prompt = true, .kv8 = false },
+    .{ .name = "cuda minimax_m3 tf_mm3_index8 decode, fp8 K/V and fp8 index keys (ik8), 2 index heads, paged", .prompt = false, .kv8 = true, .ik8 = .fp8 },
+    .{ .name = "cuda minimax_m3 tf_mm3_index8 prompt chunk, fp8 K/V and fp8 index keys (ik8), 2 index heads, paged", .prompt = true, .kv8 = true, .ik8 = .fp8 },
+    .{ .name = "cuda minimax_m3 tf_mm3_index8 decode, int4 K/V (kv4) and fp8 index keys, 2 index heads, paged", .prompt = false, .kv8 = false, .kv4 = .kv, .ik8 = .fp8 },
+    .{ .name = "cuda minimax_m3 tf_mm3_index8 decode, fp8 K/V and int8 index keys, 2 index heads, paged", .prompt = false, .kv8 = true, .ik8 = .int8 },
+    .{ .name = "cuda minimax_m3 tf_mm3_index8 decode, int8 index keys in 16-value groups, 2 index heads, paged", .prompt = false, .kv8 = true, .ik8 = .int8g16 },
+    .{ .name = "cuda minimax_m3 tf_mm3_index8 prompt chunk, int8 index keys in 16-value groups, 2 index heads, paged", .prompt = true, .kv8 = true, .ik8 = .int8g16 },
+    .{ .name = "cuda minimax_m3 tf_mm3_index8 prompt chunk, int4 K/V and int8 index keys, 2 index heads, paged", .prompt = true, .kv8 = false, .kv4 = .kv, .ik8 = .int8 },
+    .{ .name = "cuda minimax_m3 tf_mm3_index_rows prompt chunk, fp8 pages (kv8), 2 index heads, paged", .prompt = true, .kv8 = true, .tiled = true },
+    .{ .name = "cuda minimax_m3 tf_mm3_index_rows prompt chunk, bf16 pages, 2 index heads, paged", .prompt = true, .kv8 = false, .tiled = true },
+};
+
+/// A score: one fp32 product and 3 adds in a lane, then the 5-step xor tree.
+fn depth(_: c.Shape) usize {
+    return 9;
+}
+
+pub fn spec(f: Cfg) c.Spec {
+    return .{
+        .name = f.name,
+        .accum = .f32,
+        .depth = depth,
+        .ops = if (f.ik8 != .off) 2 else 1, // the scale (and the key's own scale)
+        .out = .f32,
+        .nan = .{ .stated = "fmax drops a NaN key score; a block whose scores are all NaN is -inf; blocks past a row's own stay unwritten" },
+        // rows, index heads, and the positions' bound (the last row's position + 1): edges at a block boundary
+        .tiles = .{ .{}, .{}, .{ .size = geom.block, .min = 1 } },
+        .served = &.{
+            .{ .rows = 8, .n = kvh, .k = 4100 },
+            .{ .rows = 16, .n = kvh, .k = 8192 },
+            .{ .rows = 1, .n = kvh, .k = 2049 },
+            .{ .rows = 64, .n = kvh, .k = 2048 },
+        },
+    };
+}
+
+/// Running worst figures over the shapes gate, printed by `report`.
+const Stats = struct { q: f64 = 0, abs: f64 = 0, rel: f64 = 0, sparse: usize = 0, lists: usize = 0, ties: usize = 0 };
+
+pub const Index = struct {
+    rig: rig_.Rig,
+    f: Cfg,
+    s: *const sp.Sparse,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    fill: g.Fill = .random,
+    pos: std.ArrayList(i32) = .empty,
+    table: std.ArrayList(i32) = .empty,
+    iq: std.ArrayList(u16) = .empty,
+    /// The index keys of the read layer by logical token (block * 128 + t), bf16, through the last written page.
+    ik: std.ArrayList(u16) = .empty,
+    /// The key values scoring reads: each element's bf16 value or e4m3 code value; each token's 1 or e4m3 scale.
+    ikv: std.ArrayList(f64) = .empty,
+    iks: std.ArrayList(f64) = .empty,
+    img: std.ArrayList(u8) = .empty,
+    want: std.ArrayList(f64) = .empty,
+    mag: std.ArrayList(f64) = .empty,
+    dev: [4]u64 = @splat(0),
+    out: u64 = 0,
+    sel: u64 = 0,
+    nb: usize = 0,
+    st: Stats = .{},
+
+    pub fn deinit(self: *Index) void {
+        const a = self.rig.gpu.gpa;
+        inline for (.{ "pos", "table", "iq", "ik", "ikv", "iks", "img", "want", "mag" }) |n| @field(self, n).deinit(a);
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Index) g.Kernel {
+        return .{ .spec = spec(self.f), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Index);
+
+    fn pool(self: *const Index) geom.Pool {
+        return .{ .kvh = kvh, .layers = layers, .kv8 = self.f.kv8, .kv4 = self.f.kv4, .ik8 = self.f.ik8 };
+    }
+
+    /// Values an int8 key's scale covers: 32, or 16 for `int8g16`.
+    fn group(self: *const Index) usize {
+        return if (self.f.ik8 == .int8g16) geom.s16_group else geom.q4_group;
+    }
+
+    fn posOf(self: *const Index, r: usize) usize {
+        return @intCast(self.pos.items[r]);
+    }
+
+    fn scale() f32 {
+        return @floatCast(std.math.pow(f64, geom.d, -0.5));
+    }
+
+    pub fn prepare(self: *Index, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.n != kvh or shape.rows == 0 or shape.k == 0 or shape.k + shape.rows > 16384) return false;
+        self.rig.reset();
+        const a = self.rig.gpu.gpa;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        self.fill = fill;
+        const n = shape.rows;
+        // positions: a decode window spread over [0, k), the last at k - 1 (stress: all there); a prompt's k + i
+        try self.pos.resize(a, n);
+        for (self.pos.items, 0..) |*p, i| p.* = @intCast(if (self.f.prompt) shape.k + i else if (fill == .stress or i == n - 1) shape.k - 1 else (i * 7919) % shape.k);
+        var top: usize = 0;
+        for (self.pos.items) |p| top = @max(top, @as(usize, @intCast(p)));
+        const nb = geom.blocks(top);
+        self.nb = nb;
+        const pages = nb + 3;
+        try self.table.resize(a, nb);
+        const perm = try a.alloc(i32, pages);
+        defer a.free(perm);
+        for (perm, 0..) |*x, i| x.* = @intCast(i);
+        rng.shuffle(i32, perm);
+        @memcpy(self.table.items, perm[0..nb]);
+        // index keys: random up to the last position; past it, decoys of +-100 that win any max they wrongly enter
+        try self.ik.resize(a, nb * geom.block * geom.d);
+        for (0..nb * geom.block) |j| {
+            const row = self.ik.items[j * geom.d ..][0..geom.d];
+            if (j > top) {
+                @memset(row, c.toBf16(if (j % 2 == 0) 100 else -100));
+            } else for (row) |*e| {
+                e.* = attn.normal(rng);
+            }
+        }
+        try self.iq.resize(a, n * kvh * geom.d);
+        for (self.iq.items) |*e| e.* = attn.normal(rng);
+        switch (fill) {
+            .random => {},
+            .nonfinite => self.plant(),
+            .stress => self.stress(rng, top),
+        }
+        // the pool image: every byte NaN (bf16, fp32 and e4m3 alike), then the read layer's index keys
+        const p = self.pool();
+        try self.img.resize(a, pages * p.pageBytes());
+        @memset(self.img.items, 0xff);
+        try self.ikv.resize(a, self.ik.items.len);
+        try self.iks.resize(a, nb * geom.block);
+        for (0..nb) |b| for (0..geom.block) |t| {
+            const page: usize = @intCast(self.table.items[b]);
+            const j = b * geom.block + t;
+            const row = self.ik.items[j * geom.d ..][0..geom.d];
+            const vals = self.ikv.items[j * geom.d ..][0..geom.d];
+            if (self.f.ik8 == .off) {
+                const src = std.mem.sliceAsBytes(row);
+                @memcpy(self.img.items[p.ik(page, layer, t)..][0..src.len], src);
+                for (vals, row) |*v, e| v.* = c.fromBf16(e);
+                self.iks.items[j] = 1;
+                continue;
+            }
+            var x: [geom.d]f32 = undefined;
+            for (&x, row) |*o, e| o.* = c.fromBf16(e);
+            const codes = self.img.items[p.ik(page, layer, t)..][0..geom.d];
+            if (self.f.ik8 == .int8 or self.f.ik8 == .int8g16) {
+                var q: [geom.d]i8 = undefined;
+                var gs_all: [geom.d / geom.s16_group]f32 = undefined;
+                const gs = gs_all[0 .. geom.d / self.group()];
+                mr.quantRowS8F32(&x, &q, gs);
+                @memcpy(codes, std.mem.sliceAsBytes(&q));
+                const at = p.ikScale(page, layer, t);
+                for (gs, 0..) |v, gi| std.mem.writeInt(u16, self.img.items[at + 2 * gi ..][0..2], @bitCast(@as(f16, @floatCast(v))), .little);
+                for (vals, q, 0..) |*v, code, e| v.* = @as(f64, @floatFromInt(code)) * gs[e / self.group()];
+                self.iks.items[j] = 1;
+                continue;
+            }
+            const sc = mr.quantRowF32(&x, codes);
+            std.mem.writeInt(u32, self.img.items[p.ikScale(page, layer, t)..][0..4], @bitCast(sc), .little);
+            for (vals, codes) |*v, code| v.* = mr.e4m3Value(code);
+            self.iks.items[j] = sc;
+        };
+        try self.computeWant();
+        for ([_][]const u8{ std.mem.sliceAsBytes(self.iq.items), std.mem.sliceAsBytes(self.pos.items), std.mem.sliceAsBytes(self.table.items), self.img.items }, &self.dev) |bytes, *d| d.* = try self.rig.input(bytes);
+        self.out = try self.rig.output(n * kvh * nb * 4);
+        self.sel = try self.rig.scratch(n * kvh * geom.topk * 4);
+        return true;
+    }
+
+    /// NaN in one query element (every score NaN: -inf blocks), +inf in another, a NaN key, a key with both infinities.
+    fn plant(self: *Index) void {
+        const nan = c.toBf16(std.math.nan(f32));
+        const inf = c.toBf16(std.math.inf(f32));
+        self.iq.items[0 * geom.d + 3] = nan; // row 0, head 0
+        self.iq.items[(1 * kvh + 1) * geom.d + 17] = inf; // row 1, head 1
+        const top = self.posOf(self.shape.rows - 1);
+        const keys = top + 1;
+        self.ik.items[(keys / 3) * geom.d + 9] = nan;
+        const both = (2 * keys) / 3;
+        self.ik.items[both * geom.d + 5] = inf;
+        self.ik.items[both * geom.d + 6] = c.toBf16(-std.math.inf(f32));
+        self.ik.items[(keys - 1) * geom.d + 40] = inf;
+    }
+
+    /// Gate 4: mirrored integers (score q[1] * scale): fp32 exact, fp16 overflows, bf16 loses; int8 keys exact too.
+    fn stress(self: *Index, rng: std.Random, top: usize) void {
+        const h = geom.d / 2;
+        for (0..self.shape.rows * kvh) |i| {
+            const q = self.iq.items[i * geom.d ..][0..geom.d];
+            for (0..h) |e| {
+                q[e] = c.toBf16(@floatFromInt(129 + rng.uintLessThan(u32, 127)));
+                q[h + e] = q[e];
+            }
+        }
+        for (0..top + 1) |j| {
+            const k = self.ik.items[j * geom.d ..][0..geom.d];
+            for (0..h) |e| {
+                // int8 keys: integers within 127 and a +-127 anchor a group, so every group scale is exactly 1
+                const int8 = self.f.ik8 == .int8 or self.f.ik8 == .int8g16;
+                const anchor = int8 and e % self.group() == 0;
+                const v: f32 = if (anchor) 127 else @floatFromInt(if (int8) 1 + rng.uintLessThan(u32, 120) else 129 + rng.uintLessThan(u32, 127));
+                k[e] = c.toBf16(v);
+                k[h + e] = c.toBf16(-v + @as(f32, if (e == 1) 1 else 0));
+            }
+        }
+    }
+
+    /// Float64 block maxima by the stated rule; `mag` is the largest finite score's sum of |terms| (its error's scale).
+    fn computeWant(self: *Index) !void {
+        const a = self.rig.gpu.gpa;
+        const n = self.shape.rows * kvh * self.nb;
+        try self.want.resize(a, n);
+        try self.mag.resize(a, n);
+        const sc: f64 = scale();
+        for (0..self.shape.rows) |r| for (0..kvh) |hd| {
+            const q = self.iq.items[(r * kvh + hd) * geom.d ..][0..geom.d];
+            const p = self.posOf(r);
+            for (0..self.nb) |b| {
+                const i = (r * kvh + hd) * self.nb + b;
+                if (b > p / geom.block) {
+                    self.want.items[i] = std.math.nan(f64);
+                    self.mag.items[i] = 0;
+                    continue;
+                }
+                var best = -std.math.inf(f64);
+                var m: f64 = 0;
+                for (b * geom.block..@min((b + 1) * geom.block, p + 1)) |j| {
+                    const k = self.ikv.items[j * geom.d ..][0..geom.d];
+                    const ks = self.iks.items[j];
+                    var s: f64 = 0;
+                    var abs: f64 = 0;
+                    for (q, k) |qe, ke| {
+                        const t = @as(f64, c.fromBf16(qe)) * ke * ks;
+                        s += t;
+                        abs += @abs(t);
+                    }
+                    s *= sc;
+                    if (std.math.isNan(s)) continue;
+                    if (s > best) best = s;
+                    if (std.math.isFinite(s)) m = @max(m, abs * sc);
+                }
+                self.want.items[i] = best;
+                self.mag.items[i] = m;
+            }
+        };
+    }
+
+    fn paged(self: *const Index) sp.Paged {
+        const p = self.pool();
+        return .{ .pool = self.dev[3], .page_bytes = p.pageBytes(), .layer_off = p.layerOff(layer), .kvh = kvh, .tables = self.dev[2], .kv8 = self.f.kv8, .kv4 = self.f.kv4, .ik8 = self.f.ik8 };
+    }
+
+    fn rows(self: *const Index) sp.Rows {
+        return if (self.f.prompt) .{ .n = self.shape.rows, .pos0 = @intCast(self.shape.k) } else .{ .n = self.shape.rows, .pos = self.dev[1] };
+    }
+
+    fn scratch(self: *const Index) sp.Scratch {
+        return .{ .bmax = self.out, .sel = self.sel, .bm_stride = self.nb };
+    }
+
+    pub fn run(self: *Index) !void {
+        const top = self.posOf(self.shape.rows - 1);
+        if (self.f.tiled) {
+            try self.s.scoreRows(self.rig.s, self.dev[0], self.rows(), self.paged(), self.scratch(), top, scale());
+        } else try self.s.score(self.rig.s, self.dev[0], self.rows(), self.paged(), self.scratch(), top, scale());
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Index) usize {
+        return self.shape.rows * kvh * self.nb;
+    }
+
+    pub fn reference(self: *Index, want: []f64, mag: []f64) !void {
+        @memcpy(want, self.want.items);
+        @memcpy(mag, self.mag.items);
+    }
+
+    pub fn simulate(self: *Index, acc: c.Accum, order: g.Order, out: []f64) !void {
+        const a = self.rig.gpu.gpa;
+        const terms = try a.alloc(f64, geom.d);
+        defer a.free(terms);
+        const sc: f64 = scale();
+        for (0..self.shape.rows) |r| for (0..kvh) |hd| {
+            const q = self.iq.items[(r * kvh + hd) * geom.d ..][0..geom.d];
+            const p = self.posOf(r);
+            for (0..self.nb) |b| {
+                const i = (r * kvh + hd) * self.nb + b;
+                if (b > p / geom.block) {
+                    out[i] = std.math.nan(f64);
+                    continue;
+                }
+                var best = -std.math.inf(f64);
+                for (b * geom.block..@min((b + 1) * geom.block, p + 1)) |j| {
+                    const k = self.ikv.items[j * geom.d ..][0..geom.d];
+                    for (terms, q, k) |*t, qe, ke| t.* = @as(f64, c.fromBf16(qe)) * ke;
+                    const s = contract.rows.sumIn(acc, order, terms) * self.iks.items[j] * sc;
+                    if (!std.math.isNan(s) and s > best) best = s;
+                }
+                out[i] = best;
+            }
+        };
+    }
+
+    /// Visible blocks within their float64 bound (or class), the rest unwritten, inputs and guards intact; then select.
+    pub fn check(self: *Index, at: g.Gate) !?[]const u8 {
+        if (!try self.rig.intact()) return "scoring changed a buffer guard";
+        const a = self.rig.gpu.gpa;
+        const got = try a.dupe(u8, try self.rig.outputBytes());
+        defer a.free(got);
+        const sp_ = spec(self.f);
+        for (self.want.items, self.mag.items, 0..) |w, m, i| {
+            const bits = std.mem.readInt(u32, got[4 * i ..][0..4], .little);
+            const v: f64 = @as(f32, @bitCast(bits));
+            if (std.math.isNan(w)) {
+                if (bits != 0xffff_ffff) return "a block past a row's own was written";
+                continue;
+            }
+            if (c.classOf(v) != c.classOf(w)) return "a block maximum's class differs from float64's (stated NaN rule)";
+            if (!std.math.isFinite(w)) continue;
+            const lim = c.bound(sp_, self.shape, w, m);
+            const err = @abs(v - w);
+            if (!(err <= lim)) {
+                std.debug.print("INDEX MISS {s} at {d}x{d}x{d} cell {d}: got {e:.9} want {e:.9} err {e:.3} bound {e:.3}\n", .{ self.f.name, self.shape.rows, self.shape.n, self.shape.k, i, v, w, err, lim });
+                return "a block maximum leaves its float64 bound";
+            }
+            if (at == .shapes) {
+                self.st.q = @max(self.st.q, err / lim);
+                self.st.abs = @max(self.st.abs, err);
+                self.st.rel = @max(self.st.rel, err / @max(@abs(w), 1e-30));
+            }
+        }
+        const inputs = try self.rig.inputBytes();
+        const parts = [_][]const u8{ std.mem.sliceAsBytes(self.iq.items), std.mem.sliceAsBytes(self.pos.items), std.mem.sliceAsBytes(self.table.items), self.img.items };
+        var off: usize = 0;
+        for (parts) |p| {
+            if (off + p.len > inputs.len or !std.mem.eql(u8, p, inputs[off..][0..p.len])) return "scoring changed an input";
+            off += p.len;
+        }
+        if (at == .shapes) return self.selection(got);
+        return null;
+    }
+
+    /// tf_mm3_select equals selectBlocks over the device maxima, and over float64's but for near ties at the cut.
+    fn selection(self: *Index, got: []const u8) !?[]const u8 {
+        try self.s.select(self.rig.s, self.rows(), kvh, self.scratch(), .{});
+        const lists = try self.rig.bytes(self.sel, self.shape.rows * kvh * geom.topk * 4);
+        const sel = try self.rig.gpu.gpa.dupe(u8, lists);
+        defer self.rig.gpu.gpa.free(sel);
+        var dev_s: [1024]f64 = undefined;
+        var ref_s: [1024]f64 = undefined;
+        var work: [1024]f64 = undefined;
+        var ids: [geom.topk]usize = undefined;
+        var rids: [geom.topk]usize = undefined;
+        const sp_ = spec(self.f);
+        for (0..self.shape.rows) |r| for (0..kvh) |hd| {
+            const nb = geom.blocks(self.posOf(r));
+            if (nb > dev_s.len) return "more blocks than the check holds";
+            const base = (r * kvh + hd) * self.nb;
+            for (0..nb) |b| {
+                dev_s[b] = @as(f32, @bitCast(std.mem.readInt(u32, got[4 * (base + b) ..][0..4], .little)));
+                ref_s[b] = self.want.items[base + b];
+            }
+            const cnt = mr.selectBlocks(dev_s[0..nb], nb - 1, geom.topk, .{}, &work, &ids);
+            const out = sel[(r * kvh + hd) * geom.topk * 4 ..][0 .. geom.topk * 4];
+            for (0..geom.topk) |i| {
+                const v = std.mem.readInt(i32, out[4 * i ..][0..4], .little);
+                const w: i32 = if (i < cnt) @intCast(ids[i]) else -1;
+                if (v != w) return "tf_mm3_select over the scored maxima differs from selectBlocks over them";
+            }
+            self.st.lists += 1;
+            if (nb <= geom.topk) continue;
+            self.st.sparse += 1;
+            if (std.mem.indexOfScalar(usize, ids[0..cnt], nb - 1) == null) return "a sparse row's own block is not selected";
+            _ = mr.selectBlocks(ref_s[0..nb], nb - 1, geom.topk, .{}, &work, &rids);
+            if (std.mem.eql(usize, ids[0..cnt], rids[0..cnt])) continue;
+            // the blocks only one side picked: float64 must not separate them by more than their bounds
+            var lo = std.math.inf(f64);
+            var hi = -std.math.inf(f64);
+            var slack: f64 = 0;
+            for (ids[0..cnt]) |b| if (std.mem.indexOfScalar(usize, rids[0..cnt], b) == null) {
+                lo = @min(lo, ref_s[b]);
+                slack += c.bound(sp_, self.shape, ref_s[b], self.mag.items[base + b]);
+            };
+            for (rids[0..cnt]) |b| if (std.mem.indexOfScalar(usize, ids[0..cnt], b) == null) {
+                hi = @max(hi, ref_s[b]);
+                slack += c.bound(sp_, self.shape, ref_s[b], self.mag.items[base + b]);
+            };
+            if (!(hi - lo <= slack)) return "the selected blocks differ from float64's beyond a near tie";
+            self.st.ties += 1;
+        };
+        return null;
+    }
+
+    pub fn report(self: *const Index) void {
+        std.debug.print("RESULT {s}: worst {d:.3} of the bound, max abs err {e:.3}, max rel err {e:.3}; select lists {d} ({d} sparse, > 16 blocks), {d} near-tie cuts\n", .{ self.f.name, self.st.q, self.st.abs, self.st.rel, self.st.lists, self.st.sparse, self.st.ties });
+    }
+};
+
+test "the served shapes are sparse past 2048 keys and fit the launch" {
+    for (spec(cfgs[0]).served) |s| {
+        try geom.check(s.rows, s.n);
+        try std.testing.expect(s.k + s.rows <= 16384);
+    }
+    try std.testing.expect(geom.blocks(8191) > geom.topk and geom.blocks(4099) > geom.topk);
+}
