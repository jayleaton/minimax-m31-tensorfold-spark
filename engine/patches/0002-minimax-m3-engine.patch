+test "TF_MM3_PLAN_INLINE: every step size packs and unpacks whole (a u7 split overflowed at 32 ids in window-all-3)" {
+    const gpa = std.testing.allocator;
+    const most = follow.Link.capacityFor(131072);
+    const ids = try gpa.alloc(u32, most);
+    defer gpa.free(ids);
+    const out = try gpa.alloc(u32, most);
+    defer gpa.free(out);
+    for (ids, 0..) |*x, i| x.* = @intCast(i *% 2654435761 % 200064);
+    for ([_]usize{ 0, 1, 31, 32, 33, 111, 112, 113, 2048, most }) |n| {
+        var msg: [inline_bytes]u8 align(4) = undefined;
+        const h: iface.Header = .{ .kind = 7, .n = @intCast(n), .depth = 3 };
+        const head = packFirst(&msg, &h, ids[0..n]);
+        try std.testing.expectEqual(@min(n, @as(usize, inline_ids)), head);
+        @memset(out, 0xffff_ffff);
+        const got = try unpackFirst(&msg, out);
+        try std.testing.expectEqual(h.n, got.n);
+        try std.testing.expectEqual(h.depth, got.depth);
+        try std.testing.expectEqualSlices(u32, ids[0..head], out[0..head]);
+        try std.testing.expectEqual(n * 4, head * 4 + (n - head) * 4); // the second message's bytes
+    }
+    var msg: [inline_bytes]u8 align(4) = undefined;
+    const h: iface.Header = .{ .kind = 7, .n = 40 };
+    _ = packFirst(&msg, &h, ids[0..40]);
+    try std.testing.expectError(error.TooManyIds, unpackFirst(&msg, out[0..39]));
+}
