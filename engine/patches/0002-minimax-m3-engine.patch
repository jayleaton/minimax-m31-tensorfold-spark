index 0000000000000000000000000000000000000000..408ed1914f6925800c5af83991454da6422f966b
--- /dev/null
+++ b/zig/src/server/serve_stages.zig
@@ -0,0 +1,102 @@
+//! A reply's stage times (TF_SERVE_STAGES=1): each step from receipt to done, and the request thread's own work.
+const std = @import("std");
+const json = @import("json");
+const clock = @import("clock.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Stages = struct {
+    received: i96,
+    cpu_start: i96, // the request thread's CPU clock at receipt
+    prepared: ?i96 = null, // rendered and checked
+    submitted: ?i96 = null, // the engine took the request
+    prefilled: ?i96 = null, // the engine said its prompt was in
+    first_event: ?i96 = null, // the engine's first token event reached the request's mailbox
+    first_taken: ?i96 = null, // the request thread took the first tokens
+    first_write: ?i96 = null, // the first delta was written to the client
+    last_taken: ?i96 = null, // the request thread took the last tokens
+    done: ?i96 = null, // the reply was finished, before its last bytes went out
+    text_ns: i96 = 0, // taking rounds: decode, think split, call markup and stop strings, without the writes
+    write_ns: i96 = 0, // deltas as JSON and SSE frames to the client
+    cpu_ns: i96 = 0,
+
+    const marks = [_][]const u8{ "prepared", "submitted", "prefilled", "first_event", "first_taken", "first_write", "last_taken", "done" };
+
+    pub fn start(io: std.Io) Stages {
+        return .{ .received = clock.nowNs(io), .cpu_start = std.Io.Clock.cpu_thread.now(io).toNanoseconds() };
+    }
+
+    fn at(s: *const Stages, i: usize) ?i96 {
+        return switch (i) {
+            0 => s.prepared,
+            1 => s.submitted,
+            2 => s.prefilled,
+            3 => s.first_event,
+            4 => s.first_taken,
+            5 => s.first_write,
+            6 => s.last_taken,
+            else => s.done,
+        };
+    }
+
+    fn ms(ns: i96) f64 {
+        return clock.seconds(ns) * 1000;
+    }
+
+    /// A round's text work from ``begin``, of which ``wrote`` went to writes.
+    pub fn round(s: *Stages, begin: i96, end: i96, wrote: i96) void {
+        s.text_ns += @max(0, end - begin - wrote);
+    }
+
+    /// A delta written from ``begin`` to ``end``.
+    pub fn write(s: *Stages, begin: i96, end: i96) void {
+        if (s.first_write == null) s.first_write = end;
+        s.write_ns += end - begin;
+    }
+
+    /// The reply is finished: its done time and the request thread's CPU since receipt.
+    pub fn finish(s: *Stages, io: std.Io) void {
+        s.done = clock.nowNs(io);
+        s.cpu_ns = std.Io.Clock.cpu_thread.now(io).toNanoseconds() - s.cpu_start;
+    }
+
+    /// ``{"prepared_ms": ..., ..., "text_ms": ..., "write_ms": ..., "cpu_ms": ...}``, milliseconds from receipt.
+    pub fn value(s: *const Stages, a: Allocator) Allocator.Error!json.Value {
+        const o = try json.newObject(a);
+        for (marks, 0..) |name, i| {
+            const key = try std.mem.concat(a, u8, &.{ name, "_ms" });
+            try o.put(a, key, if (s.at(i)) |t| .{ .float = ms(t - s.received) } else .null);
+        }
+        try o.put(a, "text_ms", .{ .float = ms(s.text_ns) });
+        try o.put(a, "write_ms", .{ .float = ms(s.write_ns) });
+        try o.put(a, "cpu_ms", .{ .float = ms(s.cpu_ns) });
+        return .{ .object = o };
+    }
+
+    /// The done line's `` stages=prepared:0.8,...,done:901.0 text_ms=.. write_ms=.. cpu_ms=..``; ``-``: not taken.
+    pub fn line(s: *const Stages, buf: []u8) []const u8 {
+        var w: std.Io.Writer = .fixed(buf);
+        w.writeAll(" stages=") catch return "";
+        for (marks, 0..) |name, i| {
+            if (i > 0) w.writeByte(',') catch return "";
+            if (s.at(i)) |t| {
+                w.print("{s}:{d:.3}", .{ name, ms(t - s.received) }) catch return "";
+            } else {
+                w.print("{s}:-", .{name}) catch return "";
+            }
+        }
+        w.print(" text_ms={d:.3} write_ms={d:.3} cpu_ms={d:.3}", .{ ms(s.text_ns), ms(s.write_ns), ms(s.cpu_ns) }) catch return "";
+        return w.buffered();
+    }
+};
+
+test "stage line and object name each step from receipt, a step not taken as - and null" {
+    var s: Stages = .{ .received = 1_000_000, .cpu_start = 0, .prepared = 2_000_000, .submitted = 2_500_000, .done = 9_000_000, .cpu_ns = 3_000_000 };
+    s.write(5_000_000, 5_250_000);
+    var buf: [512]u8 = undefined;
+    try std.testing.expectEqualStrings(" stages=prepared:1.000,submitted:1.500,prefilled:-,first_event:-,first_taken:-,first_write:4.250,last_taken:-,done:8.000 text_ms=0.000 write_ms=0.250 cpu_ms=3.000", s.line(&buf));
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const v = try s.value(arena.allocator());
+    try std.testing.expect(v.get("prefilled_ms").? == .null);
+    try std.testing.expectEqual(@as(f64, 8.0), v.get("done_ms").?.float);
+}
