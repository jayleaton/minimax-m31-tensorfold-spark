+// A tile's int4 rows are decoded once into fp32 (exact), so every head's dot and P.V read plain values.
+template <int KV>
+__device__ __forceinline__ void attn4_body(Attn4Shared& sh, const bf16* __restrict__ q, const int* __restrict__ sel,
