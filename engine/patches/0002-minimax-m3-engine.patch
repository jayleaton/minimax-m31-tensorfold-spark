+    // the depth rule's price of d drafts, cost(d + 1) + step x d, is the forward of d + 1 rows plus one whole pass
+    for (1..dc.flash.block + 1) |drafts| {
+        const priced = cfg.family_costs.get(@intCast(drafts + 1)).? + cfg.mtp_step_ms * @as(f64, @floatFromInt(drafts));
