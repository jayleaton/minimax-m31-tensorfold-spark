+
+// int4 KV cache (TF_MM3_KV=q4): a 128-value row is 4 groups of 32, each with one fp16 scale amax / 7 (fp32 divide).
+
+// q = round-half-even(x / s) clamped to -7..7 in fp32, stored as nibble q + 8; the value is (nibble - 8) * s.
+
+pub const q4_group: usize = 32;
+pub const q4_max: f32 = 7;
+
+/// Half-to-even rounding of an fp32 (the kernel's __float2int_rn).
+fn rne(y: f32) f32 {
+    const f = @floor(y);
+    const d = y - f;
+    if (d < 0.5) return f;
+    if (d > 0.5) return f + 1;
+    return if (@mod(f, 2) == 0) f else f + 1;
+}
+
+/// The kernel's int4 row: nibbles (0..15) and the 4 group scales as stored fp16 values; a non-finite row: NaN scales.
+pub fn quantRow4F32(x: []const f32, nibbles: []u8, scales: []f32) void {
+    var bad = false;
+    for (x) |v| bad = bad or !std.math.isFinite(v);
+    for (scales, 0..) |*sc, gi| {
+        const grp = x[gi * q4_group ..][0..q4_group];
+        var amax: f32 = 0;
+        for (grp) |v| amax = @max(amax, @abs(v));
+        const h: f16 = @floatCast(amax / q4_max);
+        const s: f32 = h;
+        const ok = !bad and s > 0 and std.math.isFinite(s);
+        sc.* = if (bad or !std.math.isFinite(s)) std.math.nan(f32) else s;
+        for (nibbles[gi * q4_group ..][0..q4_group], grp) |*n, v| {
+            n.* = if (ok) @intFromFloat(std.math.clamp(rne(v / s), -q4_max, q4_max) + 8) else 8;
+        }
+    }
+}
+
+/// An int4 value: (nibble - 8) * scale, exact in fp32 (a NaN scale reads NaN).
+pub fn q4Value(nibble: u8, scale: f32) f32 {
+    return (@as(f32, @floatFromInt(nibble)) - 8) * scale;
+}
+
+/// Packs nibbles two to a byte: value 2i in the low half of byte i.
+pub fn packQ4(nibbles: []const u8, out: []u8) void {
+    for (out, 0..) |*b, i| b.* = nibbles[2 * i] | (nibbles[2 * i + 1] << 4);
+}
+
+/// The kernel's int8 index-key row: codes and each group's fp16 amax / 127 (x.len / scales.len a group).
+pub fn quantRowS8F32(x: []const f32, codes: []i8, scales: []f32) void {
+    var bad = false;
+    for (x) |v| bad = bad or !std.math.isFinite(v);
+    const group = x.len / scales.len;
+    for (scales, 0..) |*sc, gi| {
+        const grp = x[gi * group ..][0..group];
+        var amax: f32 = 0;
+        for (grp) |v| amax = @max(amax, @abs(v));
+        const h: f16 = @floatCast(amax / 127.0);
+        const s: f32 = h;
+        const ok = !bad and s > 0 and std.math.isFinite(s);
+        sc.* = if (bad or !std.math.isFinite(s)) std.math.nan(f32) else s;
+        for (codes[gi * group ..][0..group], grp) |*c, v| {
+            c.* = if (ok) @intFromFloat(std.math.clamp(rne(v / s), -127, 127)) else 0;
+        }
+    }
+}
