@@ -0,0 +1,223 @@
+//! A DFlash2 draft's bf16 safetensors onto one rank: its heads' and MLP rows' cuts, packed for the lane matmul.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const load = @import("load.zig");
+const d2 = @import("dflash2_config.zig");
+
+const qmmf = cuda.qmmf;
+const dio = core.direct_io;
+
+pub const Layer = struct {
+    input_ln: u64,
+    post_ln: u64,
+    q_norm: u64,
+    k_norm: u64,
+    a_base: u64, // attention_conv.base_kernel bf16 [2 branches][2 lags][hidden]
+    m_base: u64, // mlp_conv.base_kernel
+    q: qmmf.Weight,
+    k: qmmf.Weight,
+    v: qmmf.Weight,
+    o: qmmf.Weight,
+    gate: qmmf.Weight,
+    up: qmmf.Weight,
+    down: qmmf.Weight,
+    a_proj: qmmf.Weight, // attention_conv.kernel_projection: hidden -> dynWidth coefficients
+    m_proj: qmmf.Weight,
+};
+
+pub const Model = struct {
+    gpa: std.mem.Allocator,
+    layers: []Layer,
+    fc: qmmf.Weight,
+    hproj: qmmf.Weight, // candidate_selector.hidden_projection
+    hidden_norm: u64,
+    final_norm: u64,
+    pred: u64, // candidate_selector.predecessor_codebook bf16 [vocab][rank]
+    succ: u64,
+    bufs: []cuda.DeviceBuffer,
+    bytes: u64,
+
+    pub fn deinit(m: *Model) void {
+        for (m.bufs) |*b| b.free();
+        m.gpa.free(m.bufs);
+        m.gpa.free(m.layers);
+        m.* = undefined;
+    }
+};
+
+/// Which part of a stored [rows, cols] matrix a rank keeps: all of it, a span of rows, or a span of columns.
+pub const Cut = union(enum) { whole, rows: [2]usize, cols: [2]usize };
+
+/// `src` bf16 [n, k] cut by `cut` into `out` (its rows by its columns); the cut's shape.
+pub fn cutInto(out: []u16, src: []const u16, n: usize, k: usize, cut: Cut) error{BadShape}![2]usize {
+    switch (cut) {
+        .whole => {
+            if (out.len < n * k) return error.BadShape;
+            @memcpy(out[0 .. n * k], src[0 .. n * k]);
+            return .{ n, k };
+        },
+        .rows => |r| {
+            if (r[1] > n or r[0] >= r[1] or out.len < (r[1] - r[0]) * k) return error.BadShape;
+            @memcpy(out[0 .. (r[1] - r[0]) * k], src[r[0] * k .. r[1] * k]);
+            return .{ r[1] - r[0], k };
+        },
+        .cols => |c| {
+            if (c[1] > k or c[0] >= c[1]) return error.BadShape;
+            const w = c[1] - c[0];
+            if (out.len < n * w) return error.BadShape;
+            for (0..n) |i| @memcpy(out[i * w ..][0..w], src[i * k + c[0] ..][0..w]);
+            return .{ n, w };
+        },
+    }
+}
+
+const Loader = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    cat: *load.Catalog,
+    buf: dio.Buffer,
+    cut: []u16,
+    packed_: []u16,
+    keep: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    bytes: u64 = 0,
+
+    /// Tensor `name`'s bf16 values (checked against `shape`), read past the page cache.
+    fn read(l: *Loader, name: []const u8, shape: []const usize) ![]const u16 {
+        const r = l.cat.get(name) orelse {
+            std.log.err("dflash2: no {s} in the draft's checkpoint", .{name});
+            return error.MissingTensor;
+        };
+        if (!r.is(.bf16, shape)) {
+            std.log.err("dflash2: {s} is not bf16 {any}", .{ name, shape });
+            return error.BadShape;
+        }
+        r.used = true;
+        const f = l.cat.files.items[r.shard];
+        const got = try f.read(l.buf, r.begin, @intCast(r.len));
+        return @alignCast(std.mem.bytesAsSlice(u16, got));
+    }
+
+    fn upload(l: *Loader, bytes: []const u8) !u64 {
+        const b = try cuda.DeviceBuffer.fromHost(l.d, bytes);
+        try l.keep.append(l.gpa, b);
+        l.bytes += b.len;
+        return b.ptr;
+    }
+
+    /// A small tensor (norms, base kernels, codebooks) as stored.
+    fn plain(l: *Loader, name: []const u8, shape: []const usize) !u64 {
+        return l.upload(std.mem.sliceAsBytes(try l.read(name, shape)));
+    }
+
+    /// Matrix `name` [n, k], this rank's `cut` of it, packed in the lane matmul's bf16 order.
+    fn matrix(l: *Loader, name: []const u8, n: usize, k: usize, cut: Cut) !qmmf.Weight {
+        const src = try l.read(name, &.{ n, k });
+        const sh = try cutInto(l.cut, src, n, k, cut);
+        if (sh[1] % qmmf.group != 0) return error.BadShape;
+        const npad = (sh[0] + 127) / 128 * 128;
+        const out = l.packed_[0 .. npad * sh[1]];
+        qmmf.packBf16(out, l.cut[0 .. sh[0] * sh[1]], sh[0], sh[1]);
+        const p = try l.upload(std.mem.sliceAsBytes(out));
+        return .{ .mode = .bf16, .codes = p, .scales = 0, .n = @intCast(sh[0]), .k = @intCast(sh[1]), .npad = @intCast(npad) };
+    }
+};
+
+fn layerName(buf: *[96]u8, l: usize, s: []const u8) ![]const u8 {
+    return std.fmt.bufPrint(buf, "layers.{d}.{s}", .{ l, s });
+}
+
+/// The largest stored tensor's elements: fc's, or a codebook's, or an MLP matrix's.
+fn largest(c: *const d2.Config) usize {
+    const h: usize = c.hidden;
+    return @max(h * c.fcIn(), @max(@as(usize, c.vocab) * c.rank, h * c.ffn));
+}
+
+/// The matrices a rank packs, [n, k] whole (a cut only shrinks them).
+fn shapes(c: *const d2.Config) [7][2]usize {
+    const h: usize = c.hidden;
+    return .{ .{ h, c.fcIn() }, .{ c.ffn, h }, .{ h, c.ffn }, .{ c.qWidth(), h }, .{ h, c.qWidth() }, .{ c.dynWidth(), h }, .{ c.rank, h } };
+}
+
+/// Elements of the largest packed matrix (rows padded to 128).
+fn packRoom(c: *const d2.Config) usize {
+    var most: usize = 0;
+    for (shapes(c)) |nk| most = @max(most, (nk[0] + 127) / 128 * 128 * nk[1]);
+    return most;
+}
+
+/// Rank `s`'s part of the draft in `dir` onto the device; every stored tensor must be read (no stray weights).
+pub fn loadModel(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, c: *const d2.Config, s: d2.Split) !Model {
+    var cat = try load.Catalog.open(gpa, io, dir);
+    defer cat.deinit();
+    const big = largest(c);
+    const buf = try gpa.alignedAlloc(u8, .fromByteUnits(dio.alignment), std.mem.alignForward(usize, big * 2, dio.alignment) + 2 * dio.alignment);
+    defer gpa.free(buf);
+    const cut = try gpa.alloc(u16, big);
+    defer gpa.free(cut);
+    const packed_ = try gpa.alloc(u16, packRoom(c));
