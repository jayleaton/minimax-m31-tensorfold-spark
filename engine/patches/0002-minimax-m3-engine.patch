+//! Which draft --drafter names (MiniMax's dspark or a DFlash2) and what the engine, budget and lane host ask of it.
+const std = @import("std");
+const target = @import("config.zig");
+const shard = @import("shard.zig");
+const dc = @import("dspark_config.zig");
+const d2 = @import("dflash2_config.zig");
+
+pub const Kind = enum { dspark, dflash2 };
+
+pub const Spec = union(Kind) {
+    dspark: dc.Config,
+    dflash2: d2.Config,
+
+    /// A draft folder's config.json: a DFlash2 class, else it must be the dspark draft (its own refusals).
+    pub fn parse(gpa: std.mem.Allocator, json: []const u8) !Spec {
+        if (d2.names(gpa, json)) return .{ .dflash2 = try d2.parse(gpa, json) };
+        return .{ .dspark = try dc.parse(gpa, json) };
+    }
+
+    pub fn tapIds(s: *const Spec) []const u32 {
+        return switch (s.*) {
+            inline else => |*c| c.tapIds(),
+        };
+    }
+
+    /// The same draft tapping `ids` instead (TF_MM3_DRAFT_TAPS on a thin model): as many layers as its own taps.
+    pub fn retap(s: *Spec, ids: []const u32) error{TapCount}!void {
+        switch (s.*) {
+            inline else => |*c| {
+                if (ids.len != c.n_taps) return error.TapCount;
+                @memcpy(c.taps[0..ids.len], ids);
+            },
+        }
+    }
+
+    /// At most `n` proposals a pass (TF_MM3_DRAFT_DEPTH): DFlash2 offers its first n; dspark's drafter caps rounds.
+    pub fn limit(s: *Spec, n: u32) error{BadDepth}!void {
+        switch (s.*) {
+            .dspark => if (n == 0) return error.BadDepth,
+            .dflash2 => |*c| {
+                if (n == 0 or n > c.block - 1) return error.BadDepth;
+                c.proposals = n;
+            },
+        }
+    }
+
+    /// Tokens one pass proposes: dspark drafts from every row, DFlash2 from the rows after the anchor.
+    pub fn depth(s: *const Spec) u32 {
+        return switch (s.*) {
+            .dspark => |c| c.block,
+            .dflash2 => |c| c.depth(),
+        };
+    }
+
+    /// Bytes of one tapped row: every tap's hidden state side by side, bf16.
+    pub fn featureBytes(s: *const Spec) u32 {
+        return switch (s.*) {
+            inline else => |c| c.fcIn() * 2,
+        };
+    }
+
+    /// The target's hidden width each tap carries.
+    pub fn hidden(s: *const Spec) u32 {
+        return switch (s.*) {
+            inline else => |c| c.hidden,
+        };
+    }
+
+    pub fn name(s: *const Spec) []const u8 {
+        return switch (s.*) {
+            .dspark => "dspark",
+            .dflash2 => "dflash2",
+        };
+    }
+
+    /// Why the draft cannot sit beside model `t` on these ranks, in the server's words; null: it can.
+    pub fn refusal(s: *const Spec, t: *const target.Config, p: dc.Place) ?[]const u8 {
+        return switch (s.*) {
+            .dspark => |*c| if (dc.admit(c, t, p)) |r| r.text() else null,
+            .dflash2 => |*c| if (d2.admit(c, t, p)) |r| r.text() else null,
+        };
+    }
+
+    /// What the draft adds to rank `rank`'s budget: weights, scratch and `snaps` ring snapshots, a ring a stream.
+    pub fn cost(s: *const Spec, t: *const target.Config, rank: u32, world: u32, window_rows: u32, absorb_rows: u32, snaps: u32) !dc.Cost {
+        switch (s.*) {
+            .dspark => |*c| {
+                const share = try shard.Share.of(t, rank, world);
+                var out = dc.cost(c, share, window_rows, absorb_rows, false);
+                out.runtime += @as(u64, snaps) * dc.ringBytes(c, share, window_rows);
+                return out;
+            },
+            .dflash2 => |*c| return d2.cost(c, rank, world, window_rows, absorb_rows, snaps),
+        }
+    }
+
+    /// Acceptance by draft depth the round loop starts from, until a stream has its own.
+    pub fn prior(s: *const Spec) []const f64 {
+        return switch (s.*) {
+            .dspark => &dspark_prior,
+            .dflash2 => dflash2_prior[0..s.depth()],
+        };
+    }
+};
+
+/// The model the draft's taps are checked on: a dspark tap past a TF_MM3_LAYERS cut never fires (forward_ops.setTaps).
+pub fn tapped(s: *const Spec, t: *const target.Config, layers: u32) target.Config {
+    return cut(t, if (s.* == .dspark) 0 else layers);
+}
+
+/// The model as TF_MM3_LAYERS cuts it (0: whole): a draft may tap only layers the forward runs.
+pub fn cut(t: *const target.Config, layers: u32) target.Config {
+    var c = t.*;
+    if (layers != 0 and layers < c.layers) c.layers = layers;
+    return c;
+}
+
+/// The dspark draft's conditional acceptance by depth: five domains' mean offline (a lower bound).
+const dspark_prior = [_]f64{ 0.62, 0.45, 0.52, 0.55, 0.6, 0.55, 0.5 };
+/// GLM-5.3's DFlash2 survival by depth on code (W11 acceptfix-f7), a prior only: MiniMax's own is not measured.
+const dflash2_prior = [_]f64{ 0.874, 0.707, 0.56, 0.437, 0.34, 0.27, 0.21 };
