+pub fn lowest(all: []const Sample, me: usize) Low {
+    var out: Low = .{ .low = unknown, .rank = 0, .others = unknown };
+    for (all, 0..) |s, r| {
+        if (s.avail < out.low) out = .{ .low = s.avail, .rank = r, .others = out.others };
