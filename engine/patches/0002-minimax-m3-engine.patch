+        if (try draw.sample(&b, row, reseeded, @intCast(pos)) != first[pos]) differs += 1;
+    }
+    try std.testing.expect(differs > first.len / 2);
+}
+
+test "rank 0's sampled draw over two ranks' gathered shares is the reference draw over the whole row" {
+    const gpa = std.testing.allocator;
