diff --git a/zig/src/core/contract/minimax_m3_dflash2_records.zig b/zig/src/core/contract/minimax_m3_dflash2_records.zig
new file mode 100644
index 0000000000000000000000000000000000000000..da79b0b005a981aa26a748698245f00269914083
--- /dev/null
+++ b/zig/src/core/contract/minimax_m3_dflash2_records.zig
@@ -0,0 +1,21 @@
+//! MiniMax-M3.1-Flash DFlash2 draft launches (minimax_m3_dflash2.cu); usage from kernel-contract-limits' RECORD lines.
+const std = @import("std");
+const registry = @import("registry.zig");
+const limits = @import("limits.zig");
+
+/// The selector's static shared bytes: gp[1024], zs[128], ids[128], tv[64], ti[64], s_tok and s_share, 4 bytes each.
+pub const select_static = (1024 + 128 + 128 + 64 + 64 + 2) * 4;
+
+pub const records = [_]registry.CudaRecord{
+    .{ .launch = .{ .name = "minimax_m3_dflash2 tf_mm3_d2_conv", .symbol = "tf_mm3_d2_conv", .image = "minimax_m3_dflash2", .threads = 256 }, .usage = registry.none },
+    .{ .launch = .{ .name = "minimax_m3_dflash2 tf_mm3_d2_select", .symbol = "tf_mm3_d2_select", .image = "minimax_m3_dflash2", .threads = 256 }, .usage = registry.none },
+};
+
+test "DFlash2 launches: no invented usage, so the resource gate fails them until their compiles are recorded" {
+    for (records) |r| {
+        try std.testing.expectEqual(registry.none, r.usage);
+        try std.testing.expectEqual(limits.sms.len, try registry.checkCuda(std.testing.allocator, &.{r}, true));
+        for (registry.cuda) |measured| try std.testing.expect(!std.mem.eql(u8, r.launch.symbol, measured.launch.symbol));
+    }
+    try std.testing.expectEqual(@as(usize, 5640), select_static);
+}
