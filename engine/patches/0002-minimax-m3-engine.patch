+//! MiniMax-M3.1-Flash's CUDA vision tower: tf-mm3-vision-parity (its rows for HF to compare) and its host tests.
+const std = @import("std");
+
+const Mod = *std.Build.Module;
+
+fn tower(b: *std.Build, target: std.Build.ResolvedTarget, optimize: std.builtin.OptimizeMode, cuda: Mod, core: Mod, lanes: Mod) Mod {
+    return b.createModule(.{
+        .root_source_file = b.path("zig/src/families/minimax_m3/vision/tower.zig"),
+        .target = target,
+        .optimize = optimize,
+        .link_libc = true,
+        .imports = &.{ .{ .name = "cuda", .module = cuda }, .{ .name = "core", .module = core }, .{ .name = "lanes", .module = lanes } },
+    });
+}
+
+/// `mm3-vision-parity`: installs tf-mm3-vision-parity (it needs the fatbins: -Dnvcc or -Dfatbins).
+pub fn parity(b: *std.Build, target: std.Build.ResolvedTarget, optimize: std.builtin.OptimizeMode, cuda: Mod, core: Mod, lanes: Mod) void {
+    const m = b.createModule(.{
+        .root_source_file = b.path("zig/tests/mm3_vision_parity_main.zig"),
+        .target = target,
+        .optimize = optimize,
+        .link_libc = true,
+        .imports = &.{ .{ .name = "cuda", .module = cuda }, .{ .name = "core", .module = core }, .{ .name = "lanes", .module = lanes }, .{ .name = "mm3_tower", .module = tower(b, target, optimize, cuda, core, lanes) } },
+    });
+    const exe = b.addExecutable(.{ .name = "tf-mm3-vision-parity", .root_module = m });
+    const step = b.step("mm3-vision-parity", "MiniMax-M3.1-Flash vision tower and projector rows on the GPU for tools/zig/mm3_vision/hf_tower_ref.py");
+    step.dependOn(&b.addInstallArtifact(exe, .{}).step);
+}
+
+/// `test-mm3-vision-tower-host`: the rotary table and its twin, the weight plan's bytes, no GPU; `umbrella` takes it.
+pub fn host(b: *std.Build, target: std.Build.ResolvedTarget, cuda: Mod, core: Mod, lanes: Mod, umbrella: *std.Build.Step) void {
+    const run = b.addRunArtifact(b.addTest(.{ .root_module = tower(b, target, .debug, cuda, core, lanes) }));
+    b.step("test-mm3-vision-tower-host", "MiniMax-M3.1-Flash vision tower's rotary tables, rotary twin and weight plan without a GPU").dependOn(&run.step);
+    umbrella.dependOn(&run.step);
+}
