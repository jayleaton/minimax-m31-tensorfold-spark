+
+/// Bytes as tokens, MiniMax's specials one token each; ``switched`` ends the prompt in the think opener.
+const Text = struct {
+    switched: bool = false,
+
+    fn text(t: *Text) model_text.Text {
+        return .{ .ctx = t, .vtable = &.{ .encode = encode, .decode = decode, .token_id = tokenId, .token_string = tokenString, .vocab_size = vocabSize, .eos_ids = eosIds, .render = render, .template_source = templateSource } };
+    }
+    fn encode(_: *anyopaque, a: Allocator, input: []const u8, _: bool) model_text.Error![]u32 {
+        var out: std.ArrayList(u32) = .empty;
+        var i: usize = 0;
+        outer: while (i < input.len) {
+            for (specials, 0..) |s, k| if (std.mem.startsWith(u8, input[i..], s)) {
+                try out.append(a, @intCast(ns_id + k));
+                i += s.len;
+                continue :outer;
+            };
+            try out.append(a, input[i]);
+            i += 1;
+        }
+        return out.items;
+    }
+    /// A character the ids cut short decodes as U+FFFD, as a byte-level tokenizer's does.
+    fn decode(_: *anyopaque, a: Allocator, ids: []const u32) Allocator.Error![]u8 {
+        var out: std.ArrayList(u8) = .empty;
+        for (ids) |id| if (id >= ns_id and id < ns_id + specials.len) try out.appendSlice(a, specials[id - ns_id]) else if (id < 256) try out.append(a, @intCast(id));
+        var back: usize = 0;
+        while (back < @min(3, out.items.len) and out.items[out.items.len - 1 - back] & 0xc0 == 0x80) back += 1;
+        if (back < out.items.len) {
+            const need = std.unicode.utf8ByteSequenceLength(out.items[out.items.len - 1 - back]) catch 1;
+            if (need > back + 1) {
+                out.shrinkRetainingCapacity(out.items.len - 1 - back);
+                try out.appendSlice(a, "\u{fffd}");
+            }
+        }
+        return out.items;
+    }
+    fn tokenId(_: *anyopaque, s: []const u8) ?u32 {
+        for (specials, 0..) |x, k| if (std.mem.eql(u8, x, s)) return @intCast(ns_id + k);
+        return null;
+    }
+    fn tokenString(_: *anyopaque, a: Allocator, id: u32) Allocator.Error![]u8 {
+        return decode(undefined, a, &.{id});
+    }
+    fn vocabSize(_: *anyopaque) u32 {
+        return 304;
+    }
+    fn eosIds(_: *anyopaque) []const u32 {
+        return &.{eos_id};
+    }
+    fn render(ptr: *anyopaque, a: Allocator, _: json.Value, o: model_text.RenderOptions, _: *[]const u8) model_text.Error!model_text.Rendered {
+        const t: *Text = @ptrCast(@alignCast(ptr));
+        const tail = if (t.switched and o.enable_thinking) "]~b]ai\n<mm:think>" else "]~b]ai\n";
+        return .{ .text = try std.mem.concat(a, u8, &.{ "]~b]user\nhi[e~[\n", tail }) };
+    }
+    fn templateSource(_: *anyopaque) []const u8 {
+        return "";
+    }
+};
+
+/// Answers ``reply`` in rounds of ``size`` tokens (negative: seeded random rounds), then EOS.
+const Script = struct {
+    reply: []const u32 = &.{},
+    size: i32 = 1,
+
+    fn engine(e: *Script) api.Engine {
+        return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 1 << 20, .structures = true };
+    }
+    fn submit(ctx: *anyopaque, id: api.Id, _: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const e: *Script = @ptrCast(@alignCast(ctx));
+        var prng: std.Random.DefaultPrng = .init(@intCast(@abs(e.size)));
+        const rng: ?*std.Random.DefaultPrng = if (e.size < 0) &prng else null;
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        var at: usize = 0;
+        while (at < e.reply.len) {
+            const end = @min(e.reply.len, at + nextCut(rng, e.size));
+            sink.event(sink.ctx, id, &.{ .tokens = e.reply[at..end] });
+            at = end;
+        }
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .stop } });
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+/// ``text`` with every ``"id": "..."`` value blanked (random message and call ids).
+fn blankIds(a: Allocator, text: []const u8) Allocator.Error![]const u8 {
+    const key = "\"id\": \"";
+    var out: std.ArrayList(u8) = .empty;
+    var rest = text;
+    while (std.mem.indexOf(u8, rest, key)) |at| {
+        const from = at + key.len;
+        try out.appendSlice(a, rest[0..from]);
+        rest = rest[from + (std.mem.indexOfScalar(u8, rest[from..], '"') orelse 0) ..];
+    }
+    try out.appendSlice(a, rest);
+    return out.items;
+}
+
+/// Each streamed delta as JSON, a call's random id blanked.
+const Deltas = struct {
+    a: Allocator,
+    items: std.ArrayList([]const u8) = .empty,
+
+    fn call(ctx: *anyopaque, delta: json.Value) error{Closed}!void {
+        const d: *Deltas = @ptrCast(@alignCast(ctx));
+        const s = json.stringify(d.a, delta, .{}) catch return error.Closed;
+        d.items.append(d.a, blankIds(d.a, s) catch return error.Closed) catch return error.Closed;
+    }
+    fn sink(d: *Deltas) chat.Sink {
+        return .{ .ctx = d, .call = call };
+    }
+};
+
+const Gone = struct {
+    pub fn check(_: @This()) bool {
+        return false;
+    }
+};
+
+const tools_json = "[{\"type\":\"function\",\"function\":{\"name\":\"write_file\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}}}}}]";
+
+/// One streamed reply's deltas, then its whole content and reasoning, as JSON lines.
+fn streamed(a: Allocator, reply: []const u8, size: i32, scan: bool, thinking: bool, switched: bool, tools: bool, stops: bool) ![]const u8 {
+    var text: Text = .{ .switched = switched };
+    var script: Script = .{ .size = size };
+    script.reply = try std.mem.concat(a, u32, &.{ try Text.encode(undefined, a, reply, false), &[_]u32{eos_id} });
+    const srv = try server.Server.init(std.testing.allocator, std.testing.io, script.engine(), text.text(), .{ .served_name = "m", .model_ids = &.{"m"}, .enable_thinking = thinking, .use_drafts = false }, null);
+    defer srv.deinit();
+    srv.toggles.incremental = scan;
+    const fields = try std.fmt.allocPrint(a, "{{\"enable_thinking\":{any}{s}}}", .{ thinking, if (stops) ",\"stop\":[\"END\",\"\\n\\n\\n\"]" else "" });
+    const input: chat.Input = .{
+        .messages = (try json.parse(a, "[{\"role\":\"user\",\"content\":\"hi\"}]")).ok,
+        .tools = if (tools) (try json.parse(a, tools_json)).ok.array else &.{},
+        .max_tokens = 4096,
+        .fields = (try json.parse(a, fields)).ok,
+    };
+    var d: Deltas = .{ .a = a };
+    var cx: Cx = .{ .a = a };
+    const r = try chat.run(srv, &cx, input, d.sink(), Gone{});
+    try d.items.append(a, try std.mem.concat(a, u8, &.{ r.content, "\x00", r.reasoning orelse "", "\x00", r.finish_reason }));
+    return std.mem.join(a, "\n", d.items.items);
+}
+
+test "stream scan: replies through generate stream the same deltas with TF_SERVE_INCREMENTAL on and off at every chunking" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var compared: usize = 0;
+    for (corpus) |reply| for (chunkings) |size| for ([3][2]bool{ .{ false, false }, .{ true, false }, .{ true, true } }) |mode| for ([_]bool{ false, true }) |tools| {
+        const stops = !tools;
+        const off = try streamed(a, reply, size, false, mode[0], mode[1], tools, stops);
+        const on = try streamed(a, reply, size, true, mode[0], mode[1], tools, stops);
+        try std.testing.expectEqualStrings(off, on);
+        compared += 1;
+    };
+    try std.testing.expectEqual(corpus.len * chunkings.len * 6, compared);
+}
+
+/// A POST's reply body over a socket pair, its random ids blanked.
+fn post(a: Allocator, srv: *server.Server, path: []const u8, body: []const u8) ![]const u8 {
+    var pair: [2]platform.posix.socket_t = undefined;
+    if (platform.c.socketpair(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0, &pair) != 0) return error.SocketPair;
+    defer _ = platform.posix.system.close(pair[0]);
+    defer _ = platform.posix.system.close(pair[1]);
+    const request = try std.fmt.allocPrint(a, "POST {s} HTTP/1.1\r\nHost: t\r\nContent-Length: {d}\r\n\r\n{s}", .{ path, body.len, body });
+    var sent: usize = 0;
+    while (sent < request.len) {
+        const n = platform.posix.system.write(pair[0], request[sent..].ptr, request.len - sent);
+        if (n <= 0) return error.Closed;
+        sent += @intCast(n);
+    }
+    var conn = try Conn.init(std.testing.allocator, pair[1], "test");
+    defer conn.deinit();
+    if (try conn.readRequest(a, false) != .ready) return error.BadRequest;
+    var out: std.ArrayList(u8) = .empty; // the reader thread's own allocator: the request's arena is this thread's
+    defer out.deinit(std.testing.allocator);
+    const Drain = struct {
+        fn run(fd: platform.posix.socket_t, into: *std.ArrayList(u8), gpa: Allocator) void {
+            var tmp: [4096]u8 = undefined;
+            while (true) {
+                const n = platform.posix.read(fd, &tmp) catch return;
+                if (n == 0) return;
+                into.appendSlice(gpa, tmp[0..n]) catch return;
+            }
+        }
+    };
+    const reader = try std.Thread.spawn(.{}, Drain.run, .{ pair[0], &out, std.testing.allocator });
+    routes.dispatch(srv, &conn, a);
+    _ = platform.posix.system.shutdown(pair[1], platform.posix.SHUT.WR);
+    reader.join();
+    return blankIds(a, out.items[(std.mem.indexOf(u8, out.items, "\r\n\r\n") orelse return error.BadReply) + 4 ..]);
+}
+
