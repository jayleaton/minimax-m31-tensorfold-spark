diff --git a/zig/src/families/minimax_m3/kv_format.zig b/zig/src/families/minimax_m3/kv_format.zig
new file mode 100644
index 0000000000000000000000000000000000000000..3ce3b029987c00cad53a1e27510d3e5a52aea1f4
--- /dev/null
+++ b/zig/src/families/minimax_m3/kv_format.zig
@@ -0,0 +1,54 @@
+//! MiniMax-M3.1-Flash KV cell formats chosen from the environment: int4 K/V (TF_MM3_KV) and e4m3 index keys.
+const std = @import("std");
+
+pub const kv_var = "TF_MM3_KV";
+pub const index_keys_var = "TF_MM3_INDEX_KEYS";
+
+/// Where int4 K/V applies: off, K and V (`q4`), or V only with K as `--kv-cache` says (`q4v`, needs fp8 K).
+pub const Kv4 = enum { off, kv, v };
+/// One-byte index keys: off (bf16), e4m3 with an fp32 scale a key, int8 with an fp16 scale a 32 values.
+pub const Ik8 = enum { off, fp8, int8, int8g16 };
+
+pub const Error = error{BadSetting};
+
+/// TF_MM3_KV: unset or `off` keeps `--kv-cache`'s K/V, `q4` int4 K and V, `q4v` int4 V beside fp8 K.
+pub fn kv4(value: ?[]const u8, problem: *[]const u8) Error!Kv4 {
+    const v = value orelse return .off;
+    if (std.mem.eql(u8, v, "off")) return .off;
+    if (std.mem.eql(u8, v, "q4")) return .kv;
+    if (std.mem.eql(u8, v, "q4v")) return .v;
+    problem.* = "TF_MM3_KV: off, q4 (int4 K and V) or q4v (int4 V beside --kv-cache fp8 K)";
+    return error.BadSetting;
+}
+
+/// TF_MM3_INDEX_KEYS: unset or `bf16` keeps bf16 keys; `fp8` e4m3 rows, `int8` / `int8g16` int8 in 32 / 16 groups.
+pub fn ik8(value: ?[]const u8, problem: *[]const u8) Error!Ik8 {
+    const v = value orelse return .off;
+    if (std.mem.eql(u8, v, "bf16")) return .off;
+    if (std.mem.eql(u8, v, "fp8")) return .fp8;
+    if (std.mem.eql(u8, v, "int8")) return .int8;
+    if (std.mem.eql(u8, v, "int8g16")) return .int8g16;
+    problem.* = "TF_MM3_INDEX_KEYS: bf16, fp8, int8 or int8g16";
+    return error.BadSetting;
+}
+
+/// The fingerprint's cell-format word: bit 0 fp8 K/V, bits 1-2 int4 K/V, bits 3-4 index keys (fp8 alone stays 1).
+pub fn word(kv8: bool, k4: Kv4, ik: Ik8) u32 {
+    return @as(u32, @intFromBool(kv8)) | (@as(u32, @backingInt(k4)) << 1) | (@as(u32, @backingInt(ik)) << 3);
+}
+
+test "the settings parse their choices and refuse anything else" {
+    var problem: []const u8 = "";
+    try std.testing.expectEqual(Kv4.off, try kv4(null, &problem));
+    try std.testing.expectEqual(Kv4.kv, try kv4("q4", &problem));
+    try std.testing.expectEqual(Kv4.v, try kv4("q4v", &problem));
+    try std.testing.expectError(error.BadSetting, kv4("int4", &problem));
+    try std.testing.expect(std.mem.startsWith(u8, problem, "TF_MM3_KV"));
+    try std.testing.expectEqual(Ik8.off, try ik8(null, &problem));
+    try std.testing.expectEqual(Ik8.fp8, try ik8("fp8", &problem));
+    try std.testing.expectEqual(Ik8.int8, try ik8("int8", &problem));
+    try std.testing.expectEqual(Ik8.int8g16, try ik8("int8g16", &problem));
+    try std.testing.expectError(error.BadSetting, ik8("e4m3", &problem));
+    try std.testing.expectEqual(@as(u32, 1), word(true, .off, .off));
+    try std.testing.expect(word(false, .kv, .off) != word(false, .v, .off) and word(true, .off, .fp8) != word(true, .off, .int8));
+}
