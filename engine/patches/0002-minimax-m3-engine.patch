+//! The image goldens (tools/zig/mm3_vision/gen_preprocess_golden.py) as a module: grids, prompts, processor ids.
+const std = @import("std");
+
+pub const golden = @embedFile("golden.json");
+
+const names = [_][]const u8{ "round_half.png", "tiny_up.jpg" };
+const files = [_][]const u8{ @embedFile("round_half.png"), @embedFile("tiny_up.jpg") };
+
+/// The bytes of the prompts' pictures, by file name.
+pub fn picture(name: []const u8) ?[]const u8 {
+    for (names, files) |n, f| if (std.mem.eql(u8, n, name)) return f;
+    return null;
+}
+
+/// The file name of a prompt picture's bytes.
+pub fn nameOf(bytes: []const u8) ?[]const u8 {
+    for (names, files) |n, f| if (std.mem.eql(u8, f, bytes)) return n;
+    return null;
+}
