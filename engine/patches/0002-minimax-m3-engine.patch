+//! A marked render's text before the generation statement is the render without the generation prompt, byte for byte.
+const std = @import("std");
+const template = @import("template.zig");
+const t = std.testing;
+
+const talk =
+    \\[{"role": "system", "content": "be brief"}, {"role": "user", "content": "hi <b>"},
+    \\ {"role": "assistant", "content": "hello"}, {"role": "user", "content": "again"}]
+;
+
+/// Compiles `source`, renders `talk` both ways, and checks the mark against the plain render; returns whether it split.
+fn check(source: []const u8) !bool {
+    const gpa = t.allocator;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const messages = try std.json.parseFromSliceLeaky(std.json.Value, arena.allocator(), talk, .{});
+    var c = try template.compile(gpa, source, null);
+    defer c.deinit();
+    const marked = try template.renderMarked(gpa, &c, messages, .null, .null, .null, true, true, null);
+    defer gpa.free(marked.str.s);
+    defer gpa.free(marked.str.spans);
+    const on = try template.renderProvenance(gpa, &c, messages, .null, .null, true, null);
+    defer gpa.free(on.s);
+    defer gpa.free(on.spans);
+    try t.expectEqualStrings(on.s, marked.str.s);
+    try t.expectEqualSlices([2]usize, on.spans, marked.str.spans);
+    const off = try template.renderProvenance(gpa, &c, messages, .null, .null, false, null);
+    defer gpa.free(off.s);
+    defer gpa.free(off.spans);
+    const h = marked.history orelse return false;
+    try t.expectEqualStrings(off.s, marked.str.s[0..h[0]]);
+    try t.expectEqualSlices([2]usize, off.spans, marked.str.spans[0..h[1]]);
+    return true;
+}
+
+const body = "{%- for m in messages -%}<{{ m.role }}>{{ m.content }}</s>\n{%- endfor -%}";
+
+test "a last generation if splits, and the text before it is the render without the generation prompt" {
+    try t.expect(try check(body ++ "{%- if add_generation_prompt -%}<assistant>{%- endif -%}\n"));
+    try t.expect(try check(body ++ "{%- set ns = namespace(n=0) -%}{%- if add_generation_prompt -%}<a>{{ ns.n }}{%- if messages|length > 2 -%}x{%- endif -%}{%- endif -%}"));
+}
+
+test "a template whose other output may read the generation flag never splits" {
+    const cases = [_][]const u8{
+        body ++ "{%- if add_generation_prompt -%}<a>{%- else -%}<end>{%- endif -%}",
+        body ++ "{%- if add_generation_prompt -%}<a>{%- elif messages -%}<m>{%- endif -%}",
+        body ++ "{%- if add_generation_prompt -%}<a>{%- endif -%}trailing",
+        "{%- set g = add_generation_prompt -%}" ++ body ++ "{%- if add_generation_prompt -%}<a>{%- endif -%}",
+        "{%- if add_generation_prompt -%}<early>{%- endif -%}" ++ body ++ "{%- if add_generation_prompt -%}<a>{%- endif -%}",
+        "{%- macro m(x) -%}{{ add_generation_prompt }}{%- endmacro -%}" ++ body ++ "{%- if add_generation_prompt -%}{{ m(1) }}{%- endif -%}",
+        "{%- set add_generation_prompt = true -%}" ++ body ++ "{%- if add_generation_prompt -%}<a>{%- endif -%}",
+        body ++ "{%- if add_generation_prompt and messages -%}<a>{%- endif -%}",
+        body,
+    };
+    for (cases) |source| try t.expect(!try check(source));
+}
+
+test "a mark forced onto a generation if with an else branch is not the render without it" {
+    const gpa = t.allocator;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const messages = try std.json.parseFromSliceLeaky(std.json.Value, arena.allocator(), talk, .{});
+    var c = try template.compile(gpa, body ++ "{%- if add_generation_prompt -%}<a>{%- else -%}<end>{%- endif -%}", null);
+    defer c.deinit();
+    try t.expectEqual(@as(?usize, null), c.generation);
+    c.generation = c.tree.body.len - 1; // the planted bug: the detector's refusal skipped
+    const marked = try template.renderMarked(gpa, &c, messages, .null, .null, .null, true, true, null);
+    defer gpa.free(marked.str.s);
+    defer gpa.free(marked.str.spans);
+    const off = try template.renderProvenance(gpa, &c, messages, .null, .null, false, null);
+    defer gpa.free(off.s);
+    defer gpa.free(off.spans);
+    try t.expect(!std.mem.eql(u8, off.s, marked.str.s[0..marked.history.?[0]]));
+}
