diff --git a/zig/src/server/draft_positions.zig b/zig/src/server/draft_positions.zig
new file mode 100644
index 0000000000000000000000000000000000000000..781ec17a68c4de63bd365f051ee4cd66c21d2edc
--- /dev/null
+++ b/zig/src/server/draft_positions.zig
@@ -0,0 +1,31 @@
+//! A reply's acceptance by draft position: `speculative.positions` of its runtime fields (neural drafts only).
+const std = @import("std");
+const json = @import("json");
+
+const Value = json.Value;
+
+/// {"tried": [...], "kept": [...]} up to the deepest position any round offered; both empty without neural rounds.
+pub fn positions(a: std.mem.Allocator, tried: []const u32, kept: []const u32) !Value {
+    var n: usize = 0;
+    for (tried, 0..) |t, j| if (t > 0) {
+        n = j + 1;
+    };
+    const o = try json.newObject(a);
+    inline for (.{ .{ "tried", tried }, .{ "kept", kept } }) |pair| {
+        const list = try a.alloc(Value, n);
+        for (pair[1][0..n], list) |x, *slot| slot.* = try json.intValue(a, x);
+        try o.put(a, pair[0], .{ .array = list });
+    }
+    return .{ .object = o };
+}
+
+test "positions stop at the deepest one offered" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const v = try positions(arena.allocator(), &.{ 9, 7, 3, 0, 0 }, &.{ 7, 3, 1, 0, 0 });
+    const tried = v.object.get("tried").?.array;
+    try std.testing.expectEqual(@as(usize, 3), tried.len);
+    try std.testing.expectEqual(@as(usize, 3), v.object.get("kept").?.array.len);
+    const none = try positions(arena.allocator(), &.{ 0, 0 }, &.{ 0, 0 });
+    try std.testing.expectEqual(@as(usize, 0), none.object.get("tried").?.array.len);
+}
