diff --git a/zig/tests/minimax_kvfmt_tests.zig b/zig/tests/minimax_kvfmt_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6bcf24df8ccd2519d1239a5945b576da4e02ce73
--- /dev/null
+++ b/zig/tests/minimax_kvfmt_tests.zig
@@ -0,0 +1,202 @@
+//! MiniMax-M3.1-Flash int4 K/V and e4m3 index keys on the host: layouts against the page map, the int4 twin.
+const std = @import("std");
+const core = @import("core");
+const geom = @import("mm3_geom");
+const pool = @import("mm3_pool");
+
+const mr = core.minimax_ref;
+const testing = std.testing;
+
+const Arm = struct { kv8: bool, kv4: geom.Kv4, ik8: geom.Ik8 };
+
+/// Every combination the kernels take (q4v needs fp8 K, `native.open` refuses it otherwise).
+const arms = [_]Arm{
+    .{ .kv8 = false, .kv4 = .off, .ik8 = .off },    .{ .kv8 = true, .kv4 = .off, .ik8 = .off },
+    .{ .kv8 = false, .kv4 = .off, .ik8 = .fp8 },    .{ .kv8 = true, .kv4 = .off, .ik8 = .fp8 },
+    .{ .kv8 = false, .kv4 = .kv, .ik8 = .off },     .{ .kv8 = false, .kv4 = .kv, .ik8 = .fp8 },
+    .{ .kv8 = true, .kv4 = .v, .ik8 = .off },       .{ .kv8 = true, .kv4 = .v, .ik8 = .fp8 },
+    .{ .kv8 = true, .kv4 = .off, .ik8 = .int8 },    .{ .kv8 = false, .kv4 = .kv, .ik8 = .int8 },
+    .{ .kv8 = true, .kv4 = .off, .ik8 = .int8g16 }, .{ .kv8 = false, .kv4 = .kv, .ik8 = .int8g16 },
+};
+
+fn mark(seen: []u8, byte: usize, len: usize) !void {
+    for (seen[byte..][0..len]) |*s| {
+        try testing.expectEqual(@as(u8, 0), s.*);
+        s.* = 1;
+    }
+}
+
+test "format bits: K bits 0-1, V bits 2-3, e4m3 index keys bit 4; the fp8 pool stays 5 and the bf16 pool 0" {
+    try testing.expectEqual(@as(i32, 0), (geom.Format{}).bits());
+    try testing.expectEqual(@as(i32, 5), geom.Format.of(true, .off, .off).bits());
+    try testing.expectEqual(@as(i32, 2 | 8 | 16), geom.Format.of(false, .kv, .fp8).bits());
+    try testing.expectEqual(@as(i32, 1 | 8 | 16), geom.Format.of(true, .v, .fp8).bits());
+    try testing.expectEqual(@as(i32, 16), geom.Format.of(false, .off, .fp8).bits());
+    try testing.expectEqual(@as(i32, 5 | 16 | 32), geom.Format.of(true, .off, .int8).bits());
+    try testing.expectEqual(@as(i32, 5 | 16 | 32 | 64), geom.Format.of(true, .off, .int8g16).bits());
+}
+
+test "every format tiles a page: K, V and IK rows, IK scales, K and V scales of every layer, head and token" {
+    for (arms) |a| {
+        const p: geom.Pool = .{ .kvh = 2, .layers = 2, .kv8 = a.kv8, .kv4 = a.kv4, .ik8 = a.ik8 };
+        const f = p.fmt();
+        const seen = try testing.allocator.alloc(u8, 2 * p.pageBytes());
+        defer testing.allocator.free(seen);
+        @memset(seen, 0);
+        for (0..2) |pg| for (0..p.layers) |ly| for (0..128) |t| {
+            for (0..2) |w| for (0..p.kvh) |h| {
+                const v = if (w == 0) f.k else f.v;
+                try mark(seen, p.kv(pg, ly, w, h, t), v.rowBytes());
+                if (v != .bf16) try mark(seen, p.scale(pg, ly, w, h, t), v.scaleBytes());
+                try testing.expectEqual(@as(usize, 0), p.kv(pg, ly, w, h, t) % 16); // the kernels' 16-byte loads
+            };
+            try mark(seen, p.ik(pg, ly, t), f.ik.rowBytes());
+            if (a.ik8 != .off) try mark(seen, p.ikScale(pg, ly, t), f.ik.scaleBytes());
+        };
+        for (seen) |s| try testing.expectEqual(@as(u8, 1), s);
+        // the index keys and their scales are one run (what a copy of a block's index keys moves)
+        if (a.ik8 != .off) try testing.expectEqual(p.ik(0, 0, 127) + 128, p.ikScale(0, 0, 0));
+        const want: usize = switch (a.ik8) {
+            .off => 128 * 256,
+            .fp8 => 128 * 132,
+            .int8 => 128 * 136,
+            .int8g16 => 128 * 144,
+        };
+        try testing.expectEqual(want, f.ikBytes());
+    }
+}
+
+test "the fp8 and bf16 layouts keep their offsets: scales after the bf16 IK plane, as docs/fp8-kv.md" {
+    const p: geom.Pool = .{ .kvh = 2, .layers = 3, .kv8 = true };
+    try testing.expectEqual(@as(usize, 100_352), p.layerBytes());
+    try testing.expectEqual(@as(usize, 2 * 2 * 128 * 128), p.ikInLayer());
+    try testing.expectEqual(p.ik(0, 0, 127) + 256, p.scale(0, 0, 0, 0, 0));
+    try testing.expectEqual(p.layerBytes(), p.scale(0, 0, 1, 1, 127) + 4);
+    const b: geom.Pool = .{ .kvh = 2, .layers = 3 };
+    try testing.expectEqual(@as(usize, 2 * 2 * 128 * 128 * 2), b.ikInLayer());
+    try testing.expectEqual(@as(usize, 128 * 1280), b.layerBytes());
+}
+
+fn dims(a: Arm) pool.Dims {
+    const d: pool.Dims = .{ .layers = 60, .kv_heads = 2, .head_dim = 128, .index_dim = 128 };
+    return d.withKv8(a.kv8).withFormats(@fromBackingInt(@intCast(@backingInt(a.kv4))), @fromBackingInt(@intCast(@backingInt(a.ik8))));
+}
+
+test "the family's page map and the kernels' geometry place every cell at the same byte, for every format" {
+    for (std.meta.fieldNames(geom.Kv4), std.meta.fieldNames(pool.Kv4)) |x, y| try testing.expectEqualStrings(x, y);
+    for (arms) |a| {
+        const p: geom.Pool = .{ .kvh = 2, .layers = 60, .kv8 = a.kv8, .kv4 = a.kv4, .ik8 = a.ik8 };
+        const d = dims(a);
+        const m = d.map();
+        try testing.expectEqual(@as(u64, p.tokenBytes()), d.tokenBytes());
+        try testing.expectEqual(@as(u64, p.pageBytes()), d.pageBytes());
+        for ([_]u32{ 0, 7, 59 }) |ly| for (0..2) |hh| {
+            const h: u32 = @intCast(hh);
+            try testing.expectEqual(@as(u64, p.kv(0, ly, 0, h, 0)), m.k(ly, h));
+            try testing.expectEqual(@as(u64, p.kv(0, ly, 1, h, 0)), m.v(ly, h));
+            if (p.fmt().k != .bf16) try testing.expectEqual(@as(u64, p.scale(0, ly, 0, h, 0)), m.kScale(ly, h));
+            if (p.fmt().v != .bf16) try testing.expectEqual(@as(u64, p.scale(0, ly, 1, h, 0)), m.vScale(ly, h));
+            try testing.expectEqual(@as(u64, p.ik(0, ly, 0)), m.ik(ly));
+        };
+        try testing.expectEqual(@as(u64, p.fmt().ikBytes()), m.ikBytes());
+    }
+}
+
+test "int4 rows: every value within half a step of its group's scale, a group's largest magnitude is exactly 7 steps" {
+    var prng = std.Random.DefaultPrng.init(41);
+    const rng = prng.random();
+    var x: [128]f32 = undefined;
+    var n: [128]u8 = undefined;
+    var s: [4]f32 = undefined;
+    for (0..2000) |it| {
+        const sd: f32 = std.math.pow(f32, 10, @as(f32, @floatFromInt(it % 7)) - 3);
+        for (&x) |*v| v.* = core.bf16_round.round32(rng.floatNorm(f32) * sd);
+        mr.quantRow4F32(&x, &n, &s);
+        for (0..4) |g| {
+            var amax: f32 = 0;
+            for (x[g * 32 ..][0..32]) |v| amax = @max(amax, @abs(v));
+            try testing.expect(@abs(s[g] - amax / 7) <= amax / 7 * 0x1p-10);
+            for (0..32) |i| {
+                const j = g * 32 + i;
+                try testing.expect(n[j] >= 1 and n[j] <= 15);
+                const back = mr.q4Value(n[j], s[g]);
+                // half a step, plus the fp16 scale's rounding at the clamped ends
+                try testing.expect(@abs(back - x[j]) <= s[g] * 0.5 + amax * 0x1p-10);
+                if (@abs(x[j]) == amax and amax > 0) try testing.expectEqual(@as(f32, 7), @abs(back / s[g]));
+            }
+        }
+    }
+}
+
+test "int4 rule corners: a zero group, ties to even, a NaN anywhere poisons the row's scales, packing two to a byte" {
+    var x: [128]f32 = @splat(0);
+    var n: [128]u8 = undefined;
+    var s: [4]f32 = undefined;
+    // group 0 all zero; group 1 amax 7 (scale 1): 2.5 -> 2, 3.5 -> 4, -0.5 -> 0
+    x[32] = 7;
+    x[33] = 2.5;
+    x[34] = 3.5;
+    x[35] = -0.5;
+    mr.quantRow4F32(&x, &n, &s);
+    try testing.expectEqual(@as(f32, 0), s[0]);
+    for (n[0..32]) |v| try testing.expectEqual(@as(u8, 8), v);
+    try testing.expectEqual(@as(f32, 1), s[1]);
+    try testing.expectEqual(@as(u8, 15), n[32]);
+    try testing.expectEqual(@as(u8, 10), n[33]);
+    try testing.expectEqual(@as(u8, 12), n[34]);
+    try testing.expectEqual(@as(u8, 8), n[35]);
+    var packed_: [64]u8 = undefined;
+    mr.packQ4(&n, &packed_);
+    try testing.expectEqual(@as(u8, 15 | (10 << 4)), packed_[16]);
+    x[100] = std.math.inf(f32);
+    mr.quantRow4F32(&x, &n, &s);
+    for (s) |v| try testing.expect(std.math.isNan(v));
+    for (n) |v| try testing.expectEqual(@as(u8, 8), v);
+    try testing.expect(std.math.isNan(mr.q4Value(8, s[0]))); // a zero nibble still reads NaN through its scale
+}
+
+test "index8 launch: one CTA reads a block's keys for every head, split a head a CTA when the call has few blocks" {
+    try testing.expectEqual(@as(usize, 1), geom.index8Heads(1, 2, 8191)); // 64 blocks: split
+    try testing.expectEqual(@as([3]u32, .{ 64, 1, 2 }), geom.index8Launch(1, 2, 8191).grid);
+    try testing.expectEqual(@as(usize, 2), geom.index8Heads(1, 2, 32767)); // 256 blocks: shared read
+    try testing.expectEqual(@as([3]u32, .{ 256, 1, 1 }), geom.index8Launch(1, 2, 32767).grid);
+    try testing.expectEqual(@as(usize, 2), geom.index8Heads(8, 2, 4099)); // 33 x 8 rows
+}
+
+test "int8 index-key rows: within half a step of the group scale, the group's largest value exactly 127 steps" {
+    var prng = std.Random.DefaultPrng.init(43);
+    const rng = prng.random();
+    var x: [128]f32 = undefined;
+    var c: [128]i8 = undefined;
+    var s: [4]f32 = undefined;
+    for (0..500) |_| {
+        for (&x) |*v| v.* = core.bf16_round.round32(rng.floatNorm(f32));
+        mr.quantRowS8F32(&x, &c, &s);
+        for (0..4) |g| {
+            var amax: f32 = 0;
+            for (x[g * 32 ..][0..32]) |v| amax = @max(amax, @abs(v));
+            for (0..32) |i| {
+                const j = g * 32 + i;
+                const back = @as(f32, @floatFromInt(c[j])) * s[g];
+                try testing.expect(@abs(back - x[j]) <= s[g] * 0.5 + amax * 0x1p-10);
+                if (@abs(x[j]) == amax) try testing.expectEqual(@as(i8, 127), @as(i8, @intCast(@abs(c[j]))));
+            }
+        }
+    }
+    x[5] = std.math.nan(f32);
+    mr.quantRowS8F32(&x, &c, &s);
+    for (s) |v| try testing.expect(std.math.isNan(v));
+    for (c) |v| try testing.expectEqual(@as(i8, 0), v);
+}
+
+test "int8 index keys in 16-value groups: 8 scales, each group's largest value exactly 127 steps" {
+    var x: [128]f32 = undefined;
+    var c: [128]i8 = undefined;
+    var s: [8]f32 = undefined;
+    for (&x, 0..) |*v, i| v.* = @floatFromInt((i % 16) * (i / 16 + 1));
+    mr.quantRowS8F32(&x, &c, &s);
+    for (0..8) |g| {
+        try testing.expectEqual(@as(f32, @floatCast(@as(f16, @floatCast(15.0 * @as(f32, @floatFromInt(g + 1)) / 127.0)))), s[g]);
+        try testing.expectEqual(@as(i8, 127), c[g * 16 + 15]);
+    }
+}
