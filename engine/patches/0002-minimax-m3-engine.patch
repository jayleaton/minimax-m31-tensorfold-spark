diff --git a/zig/src/cuda/minimax_m3_dflash2.zig b/zig/src/cuda/minimax_m3_dflash2.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f86cefecf46fe2ed553ae7c4a4d0359eb5cddf83
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_dflash2.zig
@@ -0,0 +1,105 @@
+//! MiniMax-M3.1-Flash DFlash2 draft kernels (minimax_m3_dflash2.cu): the two-tap dynamic conv and the path selector.
+const std = @import("std");
+const kernels = @import("kernels.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+
+const Driver = @import("driver.zig").Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = @import("stream.zig").Stream;
+
+pub const threads = 256;
+pub const max_rows = 8; // a DFlash2 block: the anchor and its proposals
+pub const max_cand = 128; // world * top_k the selector gathers
+pub const max_top_k = 64;
+pub const max_rank = 1024;
+
+pub const Error = error{ Empty, TooManyRows, BadShape, Align };
+
+fn aligned(p: u64, to: u64) bool {
+    return p % to == 0;
+}
+
+/// A conv call's widths: `hidden` channels in groups of `group`, dyn rows `ld_dyn` apart (4 coefficients a group).
+pub const Conv = struct { hidden: u32, group: u32, ld_dyn: u32, rows: u32 };
+
+pub fn checkConv(c: Conv) Error!void {
+    if (c.rows == 0 or c.hidden == 0) return error.Empty;
+    if (c.rows > max_rows) return error.TooManyRows;
+    if (c.group == 0 or c.hidden % c.group != 0 or c.ld_dyn < 4 * (c.hidden / c.group)) return error.BadShape;
+}
+
+/// A selector call: `rows` block rows (the first is the anchor's), each rank's `top_k` candidates, `rank` code dims.
+pub const Select = struct { rank: u32, top_k: u32, world: u32, rows: u32, temp: f32 = 1.0 };
+
+pub fn checkSelect(s: Select) Error!void {
+    if (s.rows < 2 or s.top_k == 0 or s.world == 0) return error.Empty;
+    if (s.rows > max_rows) return error.TooManyRows;
+    if (s.top_k > max_top_k or s.world * s.top_k > max_cand or s.rank == 0 or s.rank % 32 != 0 or s.rank > max_rank) return error.BadShape;
+    if (!(s.temp > 0)) return error.BadShape;
+}
+
+pub const Dflash2 = struct {
+    mod: Module,
+    conv_fn: Function,
+    select_fn: Function,
+
+    pub fn load(d: *const Driver) !Dflash2 {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var m = try Module.load(d, kernels.minimax_m3_dflash2);
+        errdefer m.unload();
+        return .{ .mod = m, .conv_fn = try m.function("tf_mm3_d2_conv"), .select_fn = try m.function("tf_mm3_d2_select") };
+    }
+
+    pub fn unload(g: *Dflash2) void {
+        g.mod.unload();
+    }
+
+    /// Branch `which` of the conv over the block's z (bf16, or f32 with z_f32) into out: stored bf16, or added to f32.
+    pub fn conv(g: *const Dflash2, st: Stream, c: Conv, z: u64, z_f32: bool, dyn: u64, which: u32, base: u64, out: u64, add: bool) !void {
+        try checkConv(c);
+        if (which > 1) return error.BadShape;
+        if (z == 0 or dyn == 0 or base == 0 or out == 0 or !aligned(z, if (z_f32) 4 else 2) or !aligned(out, if (add) 4 else 2)) return error.Align;
+        var args: launch_.Args = .{};
+        args.add(z);
+        args.add(@as(i32, @intFromBool(z_f32)));
+        args.add(dyn);
+        args.add(@as(i32, @intCast(c.ld_dyn)));
+        args.add(@as(i32, @intCast(which)));
+        args.add(base);
+        args.add(out);
+        args.add(@as(i32, @intFromBool(add)));
+        args.add(@as(i32, @intCast(c.hidden)));
+        args.add(@as(i32, @intCast(c.group)));
+        const cols = (c.hidden + 1023) / 1024;
+        try launch_.launch(g.conv_fn, .{ .grid = .{ .x = c.rows, .y = cols, .z = 1 }, .block = .{ .x = threads } }, st, &args);
+    }
+
+    /// The path through the gathered candidates: out [rows - 1] of {i32 token, f32 share}, one CTA.
+    pub fn select(g: *const Dflash2, st: Stream, s: Select, anchor: u32, cands: u64, h: u64, pred: u64, succ: u64, out: u64) !void {
+        try checkSelect(s);
+        for ([_]u64{ cands, h, out }) |x| if (x == 0 or !aligned(x, 8)) return error.Align;
+        for ([_]u64{ pred, succ }) |x| if (x == 0 or !aligned(x, 2)) return error.Align;
+        var args: launch_.Args = .{};
+        for ([_]u64{ cands, h, pred, succ, out }) |x| args.add(x);
+        args.add(@as(i32, @intCast(s.rank)));
+        args.add(@as(i32, @intCast(s.top_k)));
+        args.add(@as(i32, @intCast(s.world)));
+        args.add(@as(i32, @intCast(s.rows)));
+        args.add(anchor);
+        args.add(s.temp);
+        try launch_.launch(g.select_fn, .{ .grid = .{ .x = 1, .y = 1, .z = 1 }, .block = .{ .x = threads } }, st, &args);
+    }
+};
+
+test "conv and selector shapes: a block of eight, both drafts' widths, both ranks' candidates in one CTA" {
+    try checkConv(.{ .hidden = 6144, .group = 16, .ld_dyn = 1536, .rows = 8 });
+    try std.testing.expectError(error.BadShape, checkConv(.{ .hidden = 6144, .group = 16, .ld_dyn = 1535, .rows = 8 }));
+    try std.testing.expectError(error.TooManyRows, checkConv(.{ .hidden = 6144, .group = 16, .ld_dyn = 1536, .rows = 9 }));
+    try checkSelect(.{ .rank = 256, .top_k = 32, .world = 2, .rows = 8 }); // incoai
+    try checkSelect(.{ .rank = 256, .top_k = 16, .world = 2, .rows = 8 }); // the MiniMax class's selector
+    try std.testing.expectError(error.BadShape, checkSelect(.{ .rank = 256, .top_k = 65, .world = 1, .rows = 8 }));
+    try std.testing.expectError(error.Empty, checkSelect(.{ .rank = 256, .top_k = 32, .world = 2, .rows = 1 }));
+    try std.testing.expectError(error.BadShape, checkSelect(.{ .rank = 256, .top_k = 32, .world = 2, .rows = 8, .temp = 0 }));
+}
