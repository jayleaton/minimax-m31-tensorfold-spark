+//! MiniMax-M3.1-Flash dspark two-step top-C launch records: nvcc 13.0.88 cuobjdump, sm_80, 86, 89, 120, 121.
+const L = @import("limits.zig");
+
+fn u(regs: u32, static: u32, bound: u32) L.Usage {
+    return .{ .regs = regs, .static = static, .bound = bound };
+}
+
+pub fn records(comptime Record: type) [2]Record {
+    return .{
+        .{ .launch = .{ .name = "minimax_m3_dspark_topc tf_mm3_ds_topc_part", .symbol = "tf_mm3_ds_topc_part", .image = "minimax_m3_dspark_topc", .threads = 256 }, .usage = .{ u(32, 3092, 256), u(40, 3092, 256), u(40, 3092, 256), u(34, 3092, 256), u(34, 3092, 256) } },
