+//! TF_SERVE_INCREMENTAL streams the deltas the plain path streams at every chunking; TF_SERVE_STAGES adds only fields.
+const std = @import("std");
+const platform = @import("sys");
+const api = @import("engine_api");
+const json = @import("json");
+const server = @import("server.zig");
+const chat = @import("chat.zig");
+const log = @import("log.zig");
+const model_text = @import("model_text.zig");
+const reply_text = @import("reply_text.zig");
+const text_scan = @import("text_scan.zig");
+const routes = @import("routes.zig");
+const Conn = @import("http_conn.zig").Conn;
+const Cx = @import("errors.zig").Cx;
+const Allocator = std.mem.Allocator;
+
+const ns = "]<]minimax[>[";
+const specials = [_][]const u8{ ns, "<mm:think>", "</mm:think>" };
+const ns_id = 300;
+const eos_id = 303;
+
+const call_block = ns ++ "<tool_call>\n" ++ ns ++ "<invoke name=\"write_file\">" ++ ns ++ "<path>a.txt" ++ ns ++ "</path>" ++ ns ++
+    "<content>line <1> & \"q\"\nzw\u{e9}i \u{4e2d}\u{6587} a<b" ++ ns ++ "</content>" ++ ns ++ "</invoke>\n" ++ ns ++ "</tool_call>";
+
+/// Replies with every path a stream scans: think blocks, calls, stray markup, Harmony channels, stop strings, UTF-8.
+const corpus = [_][]const u8{
+    "Plain answer with \u{e9} and \u{4e2d}\u{6587}, <b>tags</b>, a < b and x<<1 <tool_ca",
+    "<mm:think>\nLet me think: a <tool_call> mention, a<b and </mm:th then more.\n</mm:think>\n\nThe answer is 42 END and on.",
+    "</mm:think>\n\nParis, END.",
+    "Sure. <mm:think>hm <mm:th</mm:think>Done \n\n\n twice.",
+    "I'll write it.\n" ++ call_block ++ " after",
+    "<mm:think>\nplan: call " ++ ns ++ " the tool\n</mm:think>\n\n" ++ call_block,
+    "<mm:think>\nreasoning that calls early " ++ call_block,
+    "a <tool_call>{\"name\":\"write_file\",\"arguments\":{}}</tool_call> b <|tool_call>x<tool_call|> c <tool_call",
+    "<|channel|>analysis<|message|>think<|end|><|start|>assistant<|channel|>final<|message|>Hi END<|return|>",
+    "\n\n<think>\nqwen plan</think>\n\nanswer ]<]minimax[>[<tool_call>",
+};
+
+const stop_sets = [_][]const []const u8{ &.{}, &.{ "END", "\n\n\n" }, &.{ "<b>", "q\"\nzw" } };
+const marker_sets = [_]?reply_text.Markers{ null, reply_text.mm_think_markers, reply_text.mm_think_prompt_markers, reply_text.think_markers };
+
+/// Chunk sizes, byte by byte first; a negative size is a seeded random chunking.
+const chunkings = [_]i32{ 1, 2, 3, 5, 8, 64, -1, -2, -3 };
+
+fn nextCut(rng: ?*std.Random.DefaultPrng, size: i32) usize {
+    if (rng) |r| return r.random().intRangeAtMost(usize, 1, 9);
+    return @intCast(size);
+}
+
+/// What the stream would send after each chunk: the visible text, reasoning, answer and shown prose, joined.
+fn pieces(a: Allocator, all: []const u8, stops: []const []const u8, markers: ?reply_text.Markers, tools: bool, hidden: *std.ArrayList(u8), f: reply_text.Finder) ![]const u8 {
+    const st: reply_text.Stops = .{ .strings = stops };
+    const text = st.visibleIn(all, true, f);
+    var answer = text;
+    var reasoning: []const u8 = "";
+    if (markers) |m| {
+        const split = try reply_text.splitThinkingIn(a, text, false, m, f);
+        reasoning = split.reasoning;
+        answer = split.answer;
+    }
+    const shown = if (tools) try reply_text.hideIntoIn(a, hidden, answer, false, f, f.ctx != null) else answer;
+    const vis = reply_text.heldBack(reply_text.streamingVisibleIn(shown, f), tools);
+    return std.mem.join(a, "\x00", &.{ text, reasoning, answer, vis });
+}
+
+/// A finder over a growing text that searches only what the text gained, forgetting a tag may straddle the seam.
+const Seamless = struct {
+    base: []const u8 = "",
+    searched: [8]struct { tag: []const u8, upto: usize, found: ?usize } = undefined,
+    used: usize = 0,
+
+    fn call(ctx: ?*anyopaque, text: []const u8, from: usize, tag: []const u8) ?usize {
+        const s: *Seamless = @ptrCast(@alignCast(ctx.?));
+        if (from != 0 or text.ptr != s.base.ptr) return text_scan.findTag(text, from, tag);
+        for (s.searched[0..s.used]) |*e| if (std.mem.eql(u8, e.tag, tag)) {
+            if (e.found == null and text.len > e.upto) e.found = text_scan.findTag(text, e.upto, tag);
+            e.upto = @max(e.upto, text.len);
+            return if (e.found) |at| (if (at + tag.len <= text.len) at else null) else null;
+        };
+        if (s.used == s.searched.len) return text_scan.findTag(text, from, tag);
+        s.searched[s.used] = .{ .tag = tag, .upto = text.len, .found = text_scan.findTag(text, 0, tag) };
+        s.used += 1;
+        return s.searched[s.used - 1].found;
+    }
+};
+
+const Kind = enum { scan, seamless };
+
+/// The first reply, chunking and setting where ``kind``'s finder streams other pieces than the plain one; null: none.
+fn firstMismatch(kind: Kind) !?[]const u8 {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for (corpus, 0..) |reply, ri| for (chunkings) |size| for (stop_sets, 0..) |stops, si| for (marker_sets, 0..) |markers, mi| for ([_]bool{ false, true }) |tools| {
+        var prng: std.Random.DefaultPrng = .init(@intCast(@abs(size)));
+        const rng: ?*std.Random.DefaultPrng = if (size < 0) &prng else null;
+        var buf: std.ArrayList(u8) = .empty;
+        var plain_hidden: std.ArrayList(u8) = .empty;
+        var scan_hidden: std.ArrayList(u8) = .empty;
+        var scan: text_scan.Scan = .{};
+        var seamless: Seamless = .{};
+        var at: usize = 0;
+        while (at < reply.len) {
+            const end = @min(reply.len, at + nextCut(rng, size));
+            try buf.appendSlice(a, reply[at..end]);
+            at = end;
+            if (buf.capacity == buf.items.len) try buf.ensureTotalCapacityPrecise(a, buf.capacity + 1); // it moves
+            scan.base = buf.items;
+            seamless.base = buf.items;
+            const f: reply_text.Finder = switch (kind) {
+                .scan => scan.finder(),
+                .seamless => .{ .ctx = &seamless, .call = Seamless.call },
+            };
+            const want = try pieces(a, buf.items, stops, markers, tools, &plain_hidden, .{});
+            const got = try pieces(a, buf.items, stops, markers, tools, &scan_hidden, f);
+            if (!std.mem.eql(u8, want, got))
+                return try std.fmt.allocPrint(std.testing.allocator, "reply {d} chunking {d} stops {d} markers {d} tools {any} at {d}", .{ ri, size, si, mi, tools, at });
+        }
