+/// Static shared of tf_mm3_attn4 (43 KiB): q heads, a tile's K (fp32 values, or e4m3 codes), V as fp32 values, weights.
+struct Attn4Shared {
+    float sq[GROUP * D];
+    float sk[TILE * FSTRIDE];
+    float sks[TILE];
+    float sv[TILE * D];
+    float sp[GROUP * TILE];
