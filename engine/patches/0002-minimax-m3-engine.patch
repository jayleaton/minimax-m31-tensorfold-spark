index 0000000000000000000000000000000000000000..457712381e73c9c53bd82775cd8439e2cbee9d95
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_dflash2.zig
@@ -0,0 +1,90 @@
+//! MiniMax-M3.1-Flash DFlash2 kernels under the contract on CUDA: the conv and the selector, their controls, a run.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const conv_k = @import("contract_minimax_dflash2_conv.zig");
+const select_k = @import("contract_minimax_dflash2_select.zig");
+
+const g = core.contract.gates;
+const dk = cuda.minimax_m3_dflash2;
+
+/// The writers of this file as harness kernels, owned by `Set` until `deinit`.
+pub const Set = struct {
+    convs: [std.enums.values(conv_k.Form).len]conv_k.Conv,
+    selects: [2]select_k.Select,
+
+    pub fn init(self: *Set, gpu: @import("check.zig").Gpu, s: cuda.Stream, k: *const dk.Dflash2) void {
+        const rig: rig_.Rig = .{ .gpu = gpu, .s = s };
+        const a = gpu.gpa;
+        for (std.enums.values(conv_k.Form), &self.convs) |f, *x| x.* = .{ .rig = rig, .form = f, .k = k, .arena = .init(a) };
+        for ([_]bool{ false, true }, &self.selects) |ctl, *x| x.* = .{ .rig = rig, .control = ctl, .k = k, .arena = .init(a) };
+    }
+
+    pub fn deinit(self: *Set) void {
+        for (&self.convs) |*x| x.deinit();
+        for (&self.selects) |*x| x.deinit();
+    }
+
+    /// The kernels, and with `controls` the two planted faults (each must go red at gate 3).
+    pub fn append(self: *Set, a: std.mem.Allocator, list: *std.ArrayList(g.Kernel), controls: bool) !void {
+        for (&self.convs) |*x| if (controls or conv_k.control(x.form) == null) try list.append(a, x.kernel());
+        for (&self.selects) |*x| if (controls or !x.control) try list.append(a, x.kernel());
+    }
+
+    /// Selector rows where the kernel took float64's runner-up inside the fp32 margin.
+    pub fn ties(self: *const Set) usize {
+        var n: usize = 0;
+        for (&self.selects) |*x| n += x.ties;
+        return n;
+    }
+};
+
+/// A loaded module and its writers, registered into a kernel list; the writers point into it, so it lives on the heap.
+pub const Holder = struct {
+    gpa: std.mem.Allocator,
+    k: *dk.Dflash2,
+    set: *Set,
+
+    pub fn open(gpu: @import("check.zig").Gpu, s: cuda.Stream, list: *std.ArrayList(g.Kernel), controls: bool) !Holder {
+        const a = gpu.gpa;
+        const k = try a.create(dk.Dflash2);
+        errdefer a.destroy(k);
+        k.* = try dk.Dflash2.load(gpu.d);
+        errdefer k.unload();
+        const set = try a.create(Set);
+        errdefer a.destroy(set);
+        set.init(gpu, s, k);
+        errdefer set.deinit();
+        try set.append(a, list, controls);
+        return .{ .gpa = a, .k = k, .set = set };
+    }
+
+    pub fn close(h: *Holder) void {
+        h.set.deinit();
+        h.k.unload();
+        h.gpa.destroy(h.set);
+        h.gpa.destroy(h.k);
+    }
+};
+
+/// tf-cuda-test mm3-dflash2-contract: these kernels through gates 1 to 4 and their two controls.
+pub fn run(gpu: @import("check.zig").Gpu) !void {
+    const check = @import("check.zig");
+    const a = gpu.gpa;
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var kernels: std.ArrayList(g.Kernel) = .empty;
+    defer kernels.deinit(a);
+    var h = try Holder.open(gpu, s, &kernels, true);
+    defer h.close();
+    var t: g.Tally = .{};
+    try g.runAll(a, kernels.items, 0x6d35, &t);
+    std.debug.print("SUMMARY mm3-dflash2-contract {d} kernels: {d} pass gates 1-4, {d} fail, {d} known findings; {d} controls: {d} red as planted, {d} missed; {d} selector near-ties\n", .{ t.kernels, t.passed, t.failed, t.known, t.controls, t.caught, t.missed, h.set.ties() });
+    try check.expect(t.problems() == 0, "mm3-dflash2-contract: {d} gate failures, {d} controls missed", .{ t.failed, t.missed });
+}
+
+test {
+    _ = conv_k;
+    _ = select_k;
+}
