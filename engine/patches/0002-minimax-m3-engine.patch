+}
+
+// Prompt chunks: tf_mm3_index's bits, a 16-row tile a CTA, each score's lane partials and its xor tree in one thread.
+namespace {
+
+constexpr int ROWS_TILE = 16; // rows a CTA (2 a warp)
+constexpr int KS = 132;       // index-key row stride in shared (bf16): 264 B, conflict-free 8-byte lane reads
+
+/// One lane's partial of tf_mm3_index: dims 4l..4l+3 multiplied and added in order.
+__device__ __forceinline__ float part4(uint2 q, uint2 k) {
+    float a = __fmul_rn(lo(q.x), lo(k.x));
+    a = __fadd_rn(a, __fmul_rn(hi(q.x), hi(k.x)));
+    a = __fadd_rn(a, __fmul_rn(lo(q.y), lo(k.y)));
+    return __fadd_rn(a, __fmul_rn(hi(q.y), hi(k.y)));
+}
+
+/// One thread's scores in flight: 2 rows by 2 keys.
+struct Tile {
+    float v[2][2];
+};
+
+/// The xor tree over lanes whose low L bits are M: T<M, L> = T<M, L + 1> + T<M | 1 << L, L + 1>, a partial at 5.
+template <int M, int L>
+__device__ __forceinline__ Tile tree(const uint2* q, const uint2* k0, const uint2* k1) {
+    Tile t;
+    if constexpr (L == 5) {
+        const uint2 a = k0[M], b = k1[M];
+#pragma unroll
+        for (int r = 0; r < 2; ++r) {
+            const uint2 x = q[r * (D / 4) + M];
+            t.v[r][0] = part4(x, a);
+            t.v[r][1] = part4(x, b);
+        }
+    } else {
+        const Tile x = tree<M, L + 1>(q, k0, k1);
+        if constexpr (L <= 2) asm volatile("" ::: "memory"); // each 8-leaf group's loads stay in it: bounded registers
+        const Tile y = tree<(M | (1 << L)), L + 1>(q, k0, k1);
+#pragma unroll
+        for (int r = 0; r < 2; ++r) {
+            t.v[r][0] = __fadd_rn(x.v[r][0], y.v[r][0]);
+            t.v[r][1] = __fadd_rn(x.v[r][1], y.v[r][1]);
+        }
+    }
+    return t;
+}
+
+} // namespace
+
+extern "C" __global__ void __launch_bounds__(256) tf_mm3_index_rows(
+    const bf16* __restrict__ iq,       // [rows, kvh, 128] post norm and rotary
+    int rows, int pos0,
+    const int* __restrict__ tables,    // page ids by block (one table: the chunk's stream)
+    const char* __restrict__ pool,
+    long long page_bytes, long long layer_off,
+    int kvh,
+    float* __restrict__ bmax,          // [rows, kvh, bm_stride]
+    int bm_stride,
+    float scale,
+    int fmt) {                         // the pool's cell formats (minimax_m3_sparse.cuh); IK must be bf16 here
+    const int b = blockIdx.x, g = blockIdx.y, r0 = blockIdx.z * ROWS_TILE;
+    const int nr = min(ROWS_TILE, rows - r0);
+    const int pmax = pos0 + r0 + nr - 1;
+    if (b > pmax / BLOCK) return;
+    __shared__ __align__(16) uint2 sk[BLOCK * KS / 4];
+    __shared__ __align__(16) uint2 sq[ROWS_TILE * D / 4];
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    const int valid = min(BLOCK, pmax + 1 - b * BLOCK); // keys any row of the tile reads; later ones are never loaded
+    const char* base = page_layer(pool, page_bytes, layer_off, __ldg(tables + b));
+    const uint2* ik = reinterpret_cast<const uint2*>(base + ik_at(fmt, kvh));
+    for (int i = t; i < BLOCK * D / 4; i += 256) {
+        const int j = i >> 5, c = i & 31;
+        sk[j * (KS / 4) + c] = j < valid ? __ldg(ik + i) : make_uint2(0, 0);
+    }
+    for (int i = t; i < ROWS_TILE * D / 4; i += 256) {
+        const int rr = i >> 5, c = i & 31;
+        const uint2* qr = reinterpret_cast<const uint2*>(iq + ((long long)(r0 + rr) * kvh + g) * D);
+        sq[i] = rr < nr ? __ldg(qr + c) : make_uint2(0, 0);
+    }
+    __syncthreads();
+    float best[2];
+#pragma unroll
+    for (int i = 0; i < 2; ++i) best[i] = -INFINITY;
+#pragma unroll 1
+    for (int pass = 0; pass < 2; ++pass) {
+        const int j0 = lane + 64 * pass, j1 = j0 + 32; // this lane's keys of the pass
+        const Tile acc = tree<0, 0>(sq + warp * 2 * (D / 4), sk + j0 * (KS / 4), sk + j1 * (KS / 4));
+#pragma unroll
+        for (int rr = 0; rr < 2; ++rr) {
+            const int key = b * BLOCK;
+            const int p = pos0 + r0 + warp * 2 + rr;
+            if (key + j0 <= p) best[rr] = fmaxf(best[rr], __fmul_rn(acc.v[rr][0], scale));
+            if (key + j1 <= p) best[rr] = fmaxf(best[rr], __fmul_rn(acc.v[rr][1], scale));
+        }
+    }
+#pragma unroll
+    for (int rr = 0; rr < 2; ++rr) {
+        float m = best[rr];
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) m = fmaxf(m, __shfl_xor_sync(0xffffffffu, m, o));
+        const int r = warp * 2 + rr;
+        if (lane == 0 && r < nr && b <= (pos0 + r0 + r) / BLOCK)
+            bmax[((long long)(r0 + r) * kvh + g) * bm_stride + b] = m;
+    }
+}
