+//! MiniMax-M3 prompt kernels against the served ones at TP2 rank 0's shapes: routed experts and dense rows, timed.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const cand = @import("exl3_candidate_tests.zig");
+const Gpu = check.Gpu;
+const Rig = cand.Rig;
+const st = core.safetensors;
+const ex = cuda.exl3_experts;
+const gmk = cuda.exl3_gm;
+
+const E = 128;
+const slots = 4;
+const D = 6144;
+const I = 1536; // rank 0's rows of each expert's 3072
+const I_full = 3072;
+const old_rows = 256; // forward_plan.expert_rows
+const new_rows = 2048; // forward_plan.prompt_expert_rows
+const lm = "language_model.model.";
+
+/// A routed-expert layer of the pack and the gate/up and down bits its synthetic stand-in takes.
+const Spec = struct { layer: u32, gu: u32, down: u32 };
+const specs = [_]Spec{ .{ .layer = 20, .gu = 3, .down = 3 }, .{ .layer = 3, .gu = 4, .down = 4 }, .{ .layer = 18, .gu = 3, .down = 4 } };
+
+const Axis = enum { col, row };
+
+/// A stored matrix (K x N) and rank 0's cut of it: output columns or input rows [0, keep).
+const Mat = struct {
+    k: usize,
+    n: usize,
+    axis: Axis,
+    keep: usize,
+
+    fn localK(m: Mat) usize {
+        return if (m.axis == .row) m.keep else m.k;
+    }
+    fn localN(m: Mat) usize {
+        return if (m.axis == .col) m.keep else m.n;
+    }
+};
+const gate_mat: Mat = .{ .k = D, .n = I_full, .axis = .col, .keep = I };
+const down_mat: Mat = .{ .k = I_full, .n = D, .axis = .row, .keep = I };
+
+/// A dense projection at rank 0's shape, its synthetic bits, output type and aggregate group.
+const Proj = struct { class: []const u8, name: []const u8, m: Mat, bits: u32, f32_out: bool, group: usize };
+const groups = [_][]const u8{ "attn_qkvo", "dense_mlp", "shared_expert" };
+const projs = [_]Proj{
+    .{ .class = "q_proj", .name = "layers.0.self_attn.q_proj", .m = .{ .k = D, .n = 8192, .axis = .col, .keep = 4096 }, .bits = 6, .f32_out = false, .group = 0 },
+    .{ .class = "k_proj", .name = "layers.0.self_attn.k_proj", .m = .{ .k = D, .n = 512, .axis = .col, .keep = 256 }, .bits = 8, .f32_out = false, .group = 0 },
+    .{ .class = "v_proj", .name = "layers.0.self_attn.v_proj", .m = .{ .k = D, .n = 512, .axis = .col, .keep = 256 }, .bits = 8, .f32_out = false, .group = 0 },
+    .{ .class = "o_proj", .name = "layers.0.self_attn.o_proj", .m = .{ .k = 8192, .n = D, .axis = .row, .keep = 4096 }, .bits = 6, .f32_out = true, .group = 0 },
+    .{ .class = "mlp_gate", .name = "layers.0.mlp.gate_proj", .m = .{ .k = D, .n = 12288, .axis = .col, .keep = 6144 }, .bits = 6, .f32_out = false, .group = 1 },
+    .{ .class = "mlp_up", .name = "layers.0.mlp.up_proj", .m = .{ .k = D, .n = 12288, .axis = .col, .keep = 6144 }, .bits = 6, .f32_out = false, .group = 1 },
+    .{ .class = "mlp_down", .name = "layers.0.mlp.down_proj", .m = .{ .k = 12288, .n = D, .axis = .row, .keep = 6144 }, .bits = 6, .f32_out = true, .group = 1 },
+    .{ .class = "shared_gate", .name = "layers.20.block_sparse_moe.shared_experts.gate_proj", .m = gate_mat, .bits = 6, .f32_out = false, .group = 2 },
+    .{ .class = "shared_up", .name = "layers.20.block_sparse_moe.shared_experts.up_proj", .m = gate_mat, .bits = 6, .f32_out = false, .group = 2 },
+    .{ .class = "shared_down", .name = "layers.20.block_sparse_moe.shared_experts.down_proj", .m = down_mat, .bits = 6, .f32_out = true, .group = 2 },
+};
+
+/// The pack's weight map and up to four mapped shards; a tensor's bytes are copied before the next lookup.
+const Pack = struct {
+    a: std.mem.Allocator,
+    io: std.Io,
+    dir: []const u8,
+    text: []u8,
+    json: std.json.Parsed(std.json.Value),
+    map: std.json.ObjectMap,
+    open: [4]?Open = @splat(null),
+    next: usize = 0,
+
+    const Open = struct { shard: []const u8, file: st.File };
+
+    fn init(gpu: Gpu, dir: []const u8) !Pack {
+        const a = gpu.gpa;
+        const path = try std.fmt.allocPrint(a, "{s}/model.safetensors.index.json", .{dir});
+        defer a.free(path);
+        const text = try std.Io.Dir.cwd().readFileAlloc(gpu.io, path, a, .limited(st.index.max_bytes));
+        errdefer a.free(text);
+        const json = try std.json.parseFromSlice(std.json.Value, a, text, .{});
+        errdefer json.deinit();
+        return .{ .a = a, .io = gpu.io, .dir = dir, .text = text, .json = json, .map = try st.index.weightMap(json.value) };
+    }
+
+    fn deinit(p: *Pack) void {
+        p.drop();
+        p.json.deinit();
+        p.a.free(p.text);
+    }
+
+    /// Closes every shard and returns its pages (unified memory needs the room).
+    fn drop(p: *Pack) void {
+        for (&p.open) |*slot| {
+            if (slot.*) |*o| {
+                o.file.release();
+                o.file.close(p.io);
+            }
+            slot.* = null;
+        }
+    }
+
+    fn get(p: *Pack, name: []const u8) !st.Tensor {
+        const shard = (p.map.get(name) orelse return error.TensorNotInIndex).string;
+        for (&p.open) |*slot| {
+            if (slot.*) |*o| if (std.mem.eql(u8, o.shard, shard)) return o.file.get(name) orelse return error.TensorNotInShard;
+        }
+        const slot = &p.open[p.next];
+        p.next = (p.next + 1) % p.open.len;
+        if (slot.*) |*o| {
+            o.file.release();
+            o.file.close(p.io);
+            slot.* = null;
+        }
+        const path = try std.fmt.allocPrint(p.a, "{s}/{s}", .{ p.dir, shard });
+        defer p.a.free(path);
+        slot.* = .{ .shard = shard, .file = try st.File.open(p.a, p.io, path) };
+        return slot.*.?.file.get(name) orelse return error.TensorNotInShard;
+    }
+};
+
+fn readScale(p: *Pack, a: std.mem.Allocator, name: []const u8, part_name: []const u8, whole: usize, keep: usize) ![]f16 {
+    var buf: [192]u8 = undefined;
+    const t = try p.get(try std.fmt.bufPrint(&buf, "{s}.{s}", .{ name, part_name }));
+    if (t.dtype != .f16 or t.bytes.len != 2 * whole) return error.UnsupportedScale;
+    const out = try a.alloc(f16, keep);
+    @memcpy(std.mem.sliceAsBytes(out), t.bytes[0 .. 2 * keep]);
+    return out;
+}
+
+/// Rank 0's share of one stored matrix: the cut's trellis tiles (each K-tile row's run), suh and svh cut to match.
+fn readPart(p: *Pack, a: std.mem.Allocator, name: []const u8, m: Mat) !cand.Host {
+    var buf: [192]u8 = undefined;
+    const t = try p.get(try std.fmt.bufPrint(&buf, "{s}.trellis", .{name}));
+    if (t.dtype != .i16 or t.rank != 3 or t.dim(0) != m.k / 16 or t.dim(1) != m.n / 16 or t.dim(2) % 16 != 0) return error.UnsupportedTrellis;
+    const tile = 2 * t.dim(2);
+    const kt = m.localK() / 16;
+    const per = m.localN() / 16 * tile;
+    const row = t.dim(1) * tile;
+    const trellis = try a.alloc(i16, kt * per / 2);
+    errdefer a.free(trellis);
+    const dst = std.mem.sliceAsBytes(trellis);
+    for (0..kt) |r| @memcpy(dst[r * per ..][0..per], t.bytes[r * row ..][0..per]);
+    const bits: u32 = @intCast(t.dim(2) / 16);
+    const suh = try readScale(p, a, name, "suh", m.k, m.localK());
+    errdefer a.free(suh);
+    const svh = try readScale(p, a, name, "svh", m.n, m.localN());
+    return .{ .k = m.localK(), .n = m.localN(), .bits = bits, .book = .mul1, .trellis = trellis, .suh = suh, .svh = svh };
+}
+
+fn part(pack: ?*Pack, a: std.mem.Allocator, r: std.Random, name: []const u8, m: Mat, bits: u32) !cand.Host {
+    if (pack) |p| return readPart(p, a, name, m);
+    return cand.randomMatrix(a, r, .{ .k = m.localK(), .n = m.localN(), .bits = bits, .book = .mul1 });
+}
+
+/// One layer's rank-0 routed experts on the device, laid out as exl3_experts.Layer documents.
+const Routed = struct {
+    rig: Rig,
+    layer: ex.Layer,
+    bits: [3]u32,
+    pack: bool,
+
+    fn widths(b: *const Routed) gmk.Widths {
+        return .{ .gu = 2 * b.bits[0], .down = 2 * b.bits[2] };
+    }
+};
+
+fn buildExperts(gpu: Gpu, pack: ?*Pack, spec: Spec, r: std.Random) !Routed {
+    const a = gpu.gpa;
+    var rig: Rig = .{ .gpu = gpu };
+    errdefer rig.deinit();
+    const kinds = [3][]const u8{ "w1", "w3", "w2" };
+    const mats = [3]Mat{ gate_mat, gate_mat, down_mat };
+    const synth = [3]u32{ spec.gu, spec.gu, spec.down };
+    // scales in Layer order: suh_g, svh_g, suh_u, svh_u, suh_d, svh_d
+    const lens = [6]usize{ D, I, D, I, I, D };
+    var scales: [6][]f16 = undefined;
+    var made: usize = 0;
+    defer for (scales[0..made]) |s| a.free(s);
+    for (&scales, lens) |*s, n| {
+        s.* = try a.alloc(f16, E * n);
+        made += 1;
+    }
+    var tables: [3][E]i64 = undefined;
+    var k2: [3][E]i32 = undefined;
+    var base: [3]u64 = undefined;
+    var per: [3]usize = undefined;
+    var bits: [3]u32 = undefined;
+    var buf: [192]u8 = undefined;
+    for (0..E) |e| for (0..3) |j| {
+        const name = try std.fmt.bufPrint(&buf, lm ++ "layers.{d}.block_sparse_moe.experts.{d}.{s}", .{ spec.layer, e, kinds[j] });
+        const h = try part(pack, a, r, name, mats[j], synth[j]);
+        defer cand.freeHost(a, h);
+        if (e == 0) {
+            bits[j] = h.bits;
+            per[j] = 2 * h.trellis.len;
+            base[j] = try rig.zeros(E * per[j]);
+        }
+        if (h.bits != bits[j] or 2 * h.trellis.len != per[j]) return error.MixedWidths;
+        const at = base[j] + @as(u64, e * per[j]);
+        const dst: cuda.DeviceBuffer = .{ .d = gpu.d, .ptr = at, .len = per[j] };
+        try dst.upload(0, std.mem.sliceAsBytes(h.trellis));
+        tables[j][e] = @intCast(at);
+        k2[j][e] = @intCast(2 * h.bits);
+        @memcpy(scales[2 * j][e * h.k ..][0..h.k], h.suh);
+        @memcpy(scales[2 * j + 1][e * h.n ..][0..h.n], h.svh);
+    };
+    if (bits[0] != bits[1]) return error.MixedWidths;
+    var tp: [3]u64 = undefined;
+    var kp: [3]u64 = undefined;
+    var sp: [6]u64 = undefined;
+    for (0..3) |j| {
+        tp[j] = try rig.put(&tables[j]);
+        kp[j] = try rig.put(&k2[j]);
+    }
+    for (scales, &sp) |s, *p| p.* = try rig.put(s);
+    return .{ .rig = rig, .bits = bits, .pack = pack != null, .layer = .{
+        .gate = tp[0],
+        .up = tp[1],
+        .down = tp[2],
+        .gate_k2 = kp[0],
+        .up_k2 = kp[1],
+        .down_k2 = kp[2],
+        .suh_g = sp[0],
+        .svh_g = sp[1],
+        .suh_u = sp[2],
+        .svh_u = sp[3],
+        .suh_d = sp[4],
+        .svh_d = sp[5],
+        .experts = E,
+        .dims = D,
+        .width = I,
+        .codebook = .mul1,
+        .act_mode = 2,
+        .limit = 7.0,
+        .alpha = 1.702,
+        .up_bias = 1.0,
+    } };
+}
+
+/// The pack's layer, or synthetic words and scales of the spec's widths when there is no pack or a read fails.
+fn loadExperts(gpu: Gpu, pack: ?*Pack, spec: Spec, r: std.Random) !Routed {
+    if (pack) |p| {
+        defer p.drop();
+        if (buildExperts(gpu, p, spec, r)) |b| return b else |err| std.debug.print("NOTE experts layer {d}: pack read failed ({s}), synthetic weights\n", .{ spec.layer, @errorName(err) });
+    }
+    return buildExperts(gpu, null, spec, r);
+}
+
+const Inputs = struct { x: u64, pick: u64, wts: u64, out: u64 };
+
+/// Distinct experts a row, uniform or Zipf(0.8) by expert id (rejection over the CDF), weights summing to 1.
+fn route(r: std.Random, pick: []i32, wts: []f32, zipf: bool) void {
+    var cdf: [E]f64 = undefined;
+    var acc: f64 = 0;
+    for (&cdf, 0..) |*c, e| {
+        acc += if (zipf) 1.0 / std.math.pow(f64, @floatFromInt(e + 1), 0.8) else 1.0;
+        c.* = acc;
+    }
+    for (0..pick.len / slots) |row| {
+        const p = pick[row * slots ..][0..slots];
+        var n: usize = 0;
+        while (n < slots) {
+            const u = r.float(f64) * acc;
+            var e: usize = 0;
+            while (e + 1 < E and cdf[e] < u) e += 1;
+            const ei: i32 = @intCast(e);
+            if (std.mem.indexOfScalar(i32, p[0..n], ei) != null) continue;
+            p[n] = ei;
+            n += 1;
+        }
+        const w = wts[row * slots ..][0..slots];
+        var sum: f32 = 0;
+        for (w) |*v| {
+            v.* = 0.05 + r.float(f32);
+            sum += v.*;
+        }
+        for (w) |*v| v.* /= sum;
+    }
+}
+
+/// One timed routed-experts pass over `rows` rows: the served kernels in 256-row calls, or x3gm in 2048-row calls.
+const RoutedJob = struct {
+    path: enum { old, new },
+    old: *const ex.Experts,
+    gm: *const gmk.Experts,
+    d: *const cuda.Driver,
+    s: cuda.Stream,
+    l: ex.Layer,
+    w: gmk.Widths = .{},
+    in: Inputs,
+    rows: usize = 0,
+    osc: ex.Scratch,
+    nsc: gmk.Scratch,
+
+    fn call(j: *const RoutedJob) !void {
+        const step: usize = if (j.path == .old) old_rows else new_rows;
+        var r: usize = 0;
+        while (r < j.rows) : (r += step) {
+            const n = @min(step, j.rows - r);
+            const at: u64 = r;
+            const x = j.in.x + at * D * 2;
+            const pk = j.in.pick + at * slots * 4;
+            const wt = j.in.wts + at * slots * 4;
+            const out = j.in.out + at * D * 4;
+            switch (j.path) {
+                .old => try j.old.run(j.s, j.l, x, D, .bf16, pk, wt, n, out, j.osc),
+                .new => try j.gm.run(j.d, j.s, j.l, j.w, x, D, pk, wt, n, out, j.nsc),
+            }
+        }
+    }
+};
+
+/// One timed dense prompt call: the 128-row decode blocks, or pfdense once usePromptTiles loaded it.
+const DenseJob = struct {
+    de: *cuda.exl3.Dense,
+    s: cuda.Stream,
+    w: cuda.exl3.Weight,
+    x: u64,
+    rows: usize,
+    y: u64,
+    ydt: cuda.exl3.DType,
+
+    fn call(j: *const DenseJob) !void {
+        try j.de.prompt(j.s, j.w, j.x, .bf16, j.rows, j.y, j.ydt);
+    }
+};
+
+/// The median ms of `reps` event-timed calls after two warm-ups.
+fn timeIt(s: cuda.Stream, d: *const cuda.Driver, job: anytype, reps: usize) !f64 {
+    var t0 = try cuda.Event.init(d, true);
+    defer t0.deinit();
+    var t1 = try cuda.Event.init(d, true);
+    defer t1.deinit();
+    for (0..2) |_| try job.call();
+    var ms: [64]f64 = undefined;
+    const n = @min(@max(reps, 1), ms.len);
+    for (0..n) |i| {
+        try t0.record(s);
+        try job.call();
+        try t1.record(s);
+        try t1.synchronize();
+        ms[i] = try cuda.Event.elapsedMs(t0, t1);
+    }
+    return check.median(ms[0..n]);
+}
+
+fn tokS(rows: usize, ms: f64) f64 {
+    return @as(f64, @floatFromInt(rows)) * 1000.0 / ms;
+}
+
+fn report(class: []const u8, rows: usize, routing: []const u8, old: f64, new: f64, tail: []const u8) void {
+    std.debug.print("BENCH {s} rows={d} routing={s} old_ms={d:.3} new_ms={d:.3} old_tok_s={d:.0} new_tok_s={d:.0} speedup={d:.2}x {s}\n", .{ class, rows, routing, old, new, tokS(rows, old), tokS(rows, new), old / new, tail });
+}
+
+fn benchExperts(gpu: Gpu, s: cuda.Stream, pack: ?*Pack, rows: []const usize, reps: usize, in: Inputs, pb: cuda.DeviceBuffer, wb: cuda.DeviceBuffer, r: std.Random) !void {
+    const a = gpu.gpa;
+    var old = try ex.Experts.load(gpu.d);
+    defer old.unload();
+    var gm = try gmk.Experts.load(gpu.d);
+    defer gm.unload();
+    const max_rows = std.mem.max(usize, rows);
+    const pick = try a.alloc(i32, max_rows * slots);
+    defer a.free(pick);
+    const wts = try a.alloc(f32, max_rows * slots);
+    defer a.free(wts);
+    for (specs) |spec| {
+        var b = try loadExperts(gpu, pack, spec, r);
+        defer b.rig.deinit();
+        var cb: [32]u8 = undefined;
+        const class = try std.fmt.bufPrint(&cb, "experts_l{d}", .{spec.layer});
+        const ob = try ex.scratchBytes(b.layer, old_rows, slots);
+        const nb = gmk.scratchBytes(b.layer, new_rows, slots);
+        std.debug.print("MEM {s} old_scratch_bytes={d} new_scratch_bytes={d}\n", .{ class, ob, nb });
+        var osb = try cuda.DeviceBuffer.alloc(gpu.d, ob);
+        defer osb.free();
+        var nsb = try cuda.DeviceBuffer.alloc(gpu.d, nb);
+        defer nsb.free();
+        const base: RoutedJob = .{
+            .path = .old,
+            .old = &old,
+            .gm = &gm,
+            .d = gpu.d,
+            .s = s,
+            .l = b.layer,
+            .in = in,
+            .osc = try ex.scratch(osb.ptr, b.layer, old_rows, slots),
+            .nsc = gmk.scratch(nsb.ptr, b.layer, new_rows, slots),
+        };
+        var tb: [96]u8 = undefined;
+        for ([_]bool{ false, true }) |zipf| {
+            route(r, pick, wts, zipf);
+            try pb.upload(0, std.mem.sliceAsBytes(pick));
+            try wb.upload(0, std.mem.sliceAsBytes(wts));
+            for (rows) |R| {
+                var jo = base;
+                jo.rows = R;
+                var jn = jo;
+                jn.path = .new;
+                jn.w = b.widths();
+                var j2 = jn;
+                j2.w = .{};
+                const t_old = try timeIt(s, gpu.d, &jo, reps);
+                const t_new = try timeIt(s, gpu.d, &jn, reps);
+                const t_v2 = try timeIt(s, gpu.d, &j2, reps);
+                const tail = try std.fmt.bufPrint(&tb, "v2_ms={d:.3} weights={s} bits={d}/{d}/{d}", .{ t_v2, if (b.pack) "pack" else "synthetic", b.bits[0], b.bits[1], b.bits[2] });
+                report(class, R, if (zipf) "zipf" else "uniform", t_old, t_new, tail);
+            }
+        }
+    }
+}
+
+/// The pack's share of a dense matrix, or random words of the class's bits when there is no pack or a read fails.
+fn densePart(pack: ?*Pack, a: std.mem.Allocator, r: std.Random, p: Proj, from_pack: *bool) !cand.Host {
+    var buf: [192]u8 = undefined;
+    const name = try std.fmt.bufPrint(&buf, lm ++ "{s}", .{p.name});
+    from_pack.* = false;
+    if (pack) |pk| {
+        if (readPart(pk, a, name, p.m)) |h| {
+            from_pack.* = true;
+            return h;
+        } else |err| std.debug.print("NOTE {s}: pack read failed ({s}), synthetic weights\n", .{ p.class, @errorName(err) });
+    }
+    return cand.randomMatrix(a, r, .{ .k = p.m.localK(), .n = p.m.localN(), .bits = p.bits, .book = .mul1 });
+}
+
+fn benchDense(gpu: Gpu, s: cuda.Stream, pack: ?*Pack, rows: []const usize, reps: usize, in: Inputs, r: std.Random) !void {
+    const a = gpu.gpa;
+    var rig: Rig = .{ .gpu = gpu };
+    defer rig.deinit();
+    var ws: [projs.len]cuda.exl3.Weight = undefined;
+    var from_pack: [projs.len]bool = undefined;
+    for (projs, &ws, &from_pack) |p, *w, *fp| {
+        const h = try densePart(pack, a, r, p, fp);
+        defer cand.freeHost(a, h);
+        const halves = 2 * h.bits;
+        const at = cuda.exl3.strides(h.k, h.n, halves, false);
+        w.* = .{ .trellis = try rig.put(h.trellis), .suh = try rig.put(h.suh), .svh = try rig.put(h.svh), .k = @intCast(h.k), .n = @intCast(h.n), .halves = halves, .codebook = .mul1, .stride_k = at.k, .stride_nb = at.nb };
+    }
+    if (pack) |p| p.drop();
+    var old = try cuda.exl3.Dense.load(gpu.d);
+    defer old.unload();
+    var new = try cuda.exl3.Dense.load(gpu.d);
+    defer new.unload();
+    try new.usePromptTiles();
+    var tb: [64]u8 = undefined;
+    for (rows) |R| {
+        var sums: [groups.len][2]f64 = @splat(.{ 0, 0 });
+        for (projs, ws, from_pack) |p, w, fp| {
+            const jo: DenseJob = .{ .de = &old, .s = s, .w = w, .x = in.x, .rows = R, .y = in.out, .ydt = if (p.f32_out) .f32 else .bf16 };
+            var jn = jo;
+            jn.de = &new;
+            const t_old = try timeIt(s, gpu.d, &jo, reps);
+            const t_new = try timeIt(s, gpu.d, &jn, reps);
+            sums[p.group][0] += t_old;
+            sums[p.group][1] += t_new;
+            const tail = try std.fmt.bufPrint(&tb, "weights={s} bits={d} k={d} n={d}", .{ if (fp) "pack" else "synthetic", w.halves / 2, w.k, w.n });
+            report(p.class, R, "none", t_old, t_new, tail);
+        }
+        for (groups, sums) |g, t| report(g, R, "none", t[0], t[1], "sum=gemms");
+    }
+}
+
+/// `tf-cuda-test mm3-prompt-bench PACK_DIR [rows_csv] [reps]`: old against new prompt kernels, alternating.
+pub fn run(gpu: check.Gpu, pack_dir: []const u8, rest: []const []const u8) !void {
+    const a = gpu.gpa;
+    const rows_arg = if (rest.len > 0) rest[0] else "2048,8192,32768";
+    var list: [16]usize = undefined;
+    var nrows: usize = 0;
+    var it = std.mem.tokenizeScalar(u8, rows_arg, ',');
+    while (it.next()) |t| {
+        if (nrows == list.len) return error.TooManyRowCounts;
+        list[nrows] = try std.fmt.parseInt(usize, t, 10);
+        if (list[nrows] == 0) return error.BadRowCount;
+        nrows += 1;
+    }
+    if (nrows == 0) return error.BadRowCount;
+    const reps: usize = if (rest.len > 1) try std.fmt.parseInt(usize, rest[1], 10) else 5;
+    const rows = list[0..nrows];
+    const max_rows = std.mem.max(usize, rows);
+    var name_buf: [256]u8 = undefined;
+    std.debug.print("mm3-prompt-bench: GPU {s}, {d} SMs; rows {s}, {d} reps (median after 2 warm-ups), TP2 rank 0 shapes\n", .{ try gpu.ctx.name(&name_buf), try gpu.ctx.attribute(.multiprocessor_count), rows_arg, reps });
+
+    var pack_v: ?Pack = Pack.init(gpu, pack_dir) catch |err| blk: {
+        std.debug.print("NOTE pack index unreadable ({s}): every matrix synthetic\n", .{@errorName(err)});
+        break :blk null;
+    };
+    defer if (pack_v) |*p| p.deinit();
+    const pack: ?*Pack = if (pack_v) |*p| p else null;
+
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var xb = try cuda.DeviceBuffer.alloc(gpu.d, max_rows * D * 2);
+    defer xb.free();
+    var pb = try cuda.DeviceBuffer.alloc(gpu.d, max_rows * slots * 4);
+    defer pb.free();
+    var wb = try cuda.DeviceBuffer.alloc(gpu.d, max_rows * slots * 4);
+    defer wb.free();
+    var ob = try cuda.DeviceBuffer.alloc(gpu.d, max_rows * D * 4);
+    defer ob.free();
+    var prng = std.Random.DefaultPrng.init(0x3A11_F00D);
+    const r = prng.random();
+    var row: usize = 0;
+    while (row < max_rows) : (row += new_rows) {
+        const n = @min(new_rows, max_rows - row);
+        const x = try cand.randomRows(a, r, n, D);
+        defer a.free(x);
+        try xb.upload(row * D * 2, std.mem.sliceAsBytes(x));
+    }
+    const in: Inputs = .{ .x = xb.ptr, .pick = pb.ptr, .wts = wb.ptr, .out = ob.ptr };
+    try benchExperts(gpu, s, pack, rows, reps, in, pb, wb, r);
+    try benchDense(gpu, s, pack, rows, reps, in, r);
+    check.pass("mm3-prompt-bench: {d} expert layers x 2 routings and {d} dense projections at {d} row counts", .{ specs.len, projs.len, nrows });
+}
diff --git a/zig/tests/cuda/mm3_prompt_dense.zig b/zig/tests/cuda/mm3_prompt_dense.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d9c2ebc645c5f038c9bd8823f1bf1114b888f7e7
--- /dev/null
+++ b/zig/tests/cuda/mm3_prompt_dense.zig
@@ -0,0 +1,149 @@
+//! MiniMax-M3.1-Flash's dense prompt rows (pfdense) by class: FP64 bounds beside the decode blocks', rows bit-stable.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const cand = @import("exl3_candidate_tests.zig");
+const Gpu = check.Gpu;
+const Rig = cand.Rig;
+
+const CAP = 2048;
+const row_counts = [_]usize{ 1, 17, 128, 300, 2048 };
+
+/// One projection class at a TP2 rank's shape, its bits and the output type forward_exec gives it.
+const Class = struct { name: []const u8, k: usize, n: usize, bits: u32, f32_out: bool };
+const classes = [_]Class{
+    .{ .name = "q", .k = 6144, .n = 4096, .bits = 6, .f32_out = false },
+    .{ .name = "k/v", .k = 6144, .n = 256, .bits = 8, .f32_out = false },
+    .{ .name = "o", .k = 4096, .n = 6144, .bits = 6, .f32_out = true },
+    .{ .name = "dense gate/up", .k = 6144, .n = 6144, .bits = 6, .f32_out = false },
+    .{ .name = "dense down", .k = 6144, .n = 6144, .bits = 6, .f32_out = true },
+    .{ .name = "shared gate/up", .k = 6144, .n = 1536, .bits = 6, .f32_out = false },
+    .{ .name = "shared down", .k = 1536, .n = 6144, .bits = 6, .f32_out = true },
+    .{ .name = "4-bit", .k = 6144, .n = 1536, .bits = 4, .f32_out = false },
+    .{ .name = "5-bit", .k = 1536, .n = 6144, .bits = 5, .f32_out = true },
+};
+
+/// The rows the reference checks: the first 16 and 17 spread up to the chunk's last.
+fn sampleRows() [33]usize {
+    var s: [33]usize = undefined;
+    for (0..16) |i| s[i] = i;
+    for (0..16) |i| s[16 + i] = 16 + i * 127;
+    s[32] = CAP - 1;
+    return s;
+}
+
+fn ofBf16(b: u16) f32 {
+    return @bitCast(@as(u32, b) << 16);
+}
+
+const Score = struct { frac: f64 = 0, err: f64 = 0, col: f64 = 0, rms: f64 = 0 };
+
+fn score(got: []const f32, n_out: usize, rows: []const usize, n: usize, want: []const f64, bound: []const f64) Score {
+    var s: Score = .{};
+    var n_vals: f64 = 0;
+    var scale: f64 = 0;
+    for (rows, 0..) |row, ri| if (row < n) {
+        for (want[ri * n_out ..][0..n_out]) |w| scale = @max(scale, @abs(w));
+    };
+    for (0..n_out) |j| {
+        var col: f64 = 0;
+        for (rows, 0..) |row, ri| if (row < n) {
+            const e = @abs(@as(f64, got[row * n_out + j]) - want[ri * n_out + j]);
+            s.frac = @max(s.frac, e / bound[ri * n_out + j]);
+            s.err = @max(s.err, e);
+            s.rms += e * e;
+            n_vals += 1;
+            col = @max(col, e);
+        };
+        if (scale > 0) s.col = @max(s.col, col / scale);
+    }
+    s.rms = @sqrt(s.rms / @max(n_vals, 1));
+    return s;
+}
+
+/// The first `n` rows of `y` as f32, after a sync.
+fn fetch(gpu: Gpu, s: cuda.Stream, y: u64, n: usize, n_out: usize, f32_out: bool, out: []f32) ![]f32 {
+    try s.synchronize();
+    const vals = out[0 .. n * n_out];
+    if (f32_out) {
+        const dev: cuda.DeviceBuffer = .{ .d = gpu.d, .ptr = y, .len = vals.len * 4 };
+        try dev.download(0, std.mem.sliceAsBytes(vals));
+        return vals;
+    }
+    const raw = try gpu.gpa.alloc(u16, vals.len);
+    defer gpu.gpa.free(raw);
+    const dev: cuda.DeviceBuffer = .{ .d = gpu.d, .ptr = y, .len = vals.len * 2 };
+    try dev.download(0, std.mem.sliceAsBytes(raw));
+    for (vals, raw) |*v, b| v.* = ofBf16(b);
+    return vals;
+}
+
+/// `tf-cuda-test mm3-prompt-dense`: every class's FP64 bounds, old and new, and the new rows' bytes at every count.
+pub fn run(gpu: Gpu) !void {
+    const a = gpu.gpa;
+    var old = try cuda.exl3.Dense.load(gpu.d);
+    defer old.unload();
+    var new = try cuda.exl3.Dense.load(gpu.d);
+    defer new.unload();
+    try new.usePromptTiles();
+    var s = try cuda.Stream.init(gpu.d, true);
+    defer s.deinit();
+    var prng = std.Random.DefaultPrng.init(0xD3A5);
+    const rows = sampleRows();
+    var failed = false;
+    for (classes) |c| {
+        const r = prng.random();
+        var rig: Rig = .{ .gpu = gpu };
+        defer rig.deinit();
+        const h = try cand.randomMatrix(a, r, .{ .k = c.k, .n = c.n, .bits = c.bits, .book = .mul1 });
+        defer cand.freeHost(a, h);
+        const x = try cand.randomRows(a, r, CAP, c.k);
+        defer a.free(x);
+        const xs = try a.alloc(u16, rows.len * c.k);
+        defer a.free(xs);
+        for (&rows, 0..) |row, i| @memcpy(xs[i * c.k ..][0..c.k], x[row * c.k ..][0..c.k]);
+        const want = try a.alloc(f64, rows.len * c.n);
+        defer a.free(want);
+        const bound = try a.alloc(f64, rows.len * c.n);
+        defer a.free(bound);
+        try cand.reference(a, h, xs, rows.len, want, bound, true);
+        const st = cuda.exl3.strides(c.k, c.n, 2 * c.bits, false);
+        const w: cuda.exl3.Weight = .{ .trellis = try rig.put(h.trellis), .suh = try rig.put(h.suh), .svh = try rig.put(h.svh), .k = @intCast(c.k), .n = @intCast(c.n), .halves = 2 * c.bits, .codebook = .mul1, .stride_k = st.k, .stride_nb = st.nb };
+        const dx = try rig.put(x);
+        const ydt: cuda.exl3.DType = if (c.f32_out) .f32 else .bf16;
+        const y = try rig.zeros(CAP * c.n * 4);
+        const got = try a.alloc(f32, CAP * c.n);
+        defer a.free(got);
+        const keep = try a.alloc(f32, CAP * c.n);
+        defer a.free(keep);
+        var stable = true;
+        for (row_counts) |n| {
+            try new.prompt(s, w, dx, .bf16, n, y, ydt);
+            const sn = score(try fetch(gpu, s, y, n, c.n, c.f32_out, got), c.n, &rows, n, want, bound);
+            if (n == 1) @memcpy(keep[0..c.n], got[0..c.n]);
+            if (n == CAP) {
+                // every shorter call's rows are a prefix of this one's, byte for byte
+                stable = std.mem.eql(f32, keep[0..c.n], got[0..c.n]);
+                @memcpy(keep, got);
+            }
+            try old.prompt(s, w, dx, .bf16, n, y, ydt);
+            const so = score(try fetch(gpu, s, y, n, c.n, c.f32_out, got), c.n, &rows, n, want, bound);
+            std.debug.print("TABLE mm3.dense {s} k={d} n={d} bits={d} out={s} rows={d} new_frac={e:.3} old_frac={e:.3} new_err={e:.3} old_err={e:.3} new_col={e:.3} old_col={e:.3} new_rms={e:.3} old_rms={e:.3}\n", .{ c.name, c.k, c.n, c.bits, if (c.f32_out) "f32" else "bf16", n, sn.frac, so.frac, sn.err, so.err, sn.col, so.col, sn.rms, so.rms });
+            if (!(sn.frac <= 1)) {
+                std.debug.print("FAIL mm3.dense {s} rows={d}: pfdense at {d:.4} of its FP64 bound\n", .{ c.name, n, sn.frac });
+                failed = true;
+            }
+            if (!(so.frac <= 1)) std.debug.print("FINDING mm3.dense {s} rows={d}: the decode blocks at {d:.4} of the bound\n", .{ c.name, n, so.frac });
+        }
+        for ([_]usize{ 17, 300 }) |n| {
+            try new.prompt(s, w, dx, .bf16, n, y, ydt);
+            stable = stable and std.mem.eql(f32, try fetch(gpu, s, y, n, c.n, c.f32_out, got), keep[0 .. n * c.n]);
+        }
+        if (!stable) {
+            std.debug.print("FAIL mm3.dense {s}: a row's bytes depend on the call's row count\n", .{c.name});
+            failed = true;
+        }
+    }
+    if (failed) return error.TestFailed;
+    check.pass("mm3.dense: pfdense within its FP64 bounds for every class and row count, each row's bytes independent of the call", .{});
+}
diff --git a/zig/tests/cuda/mm3_prompt_score.zig b/zig/tests/cuda/mm3_prompt_score.zig
new file mode 100644
index 0000000000000000000000000000000000000000..bd0e78bc42765de67140ccb3d6fd8b51fbfab5f8
--- /dev/null
+++ b/zig/tests/cuda/mm3_prompt_score.zig
@@ -0,0 +1,211 @@
+//! tf-cuda-test mm3-prompt-score: tf_mm3_index_rows and shared-expf attention write the old bytes; all timed.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+
+const sp = cuda.minimax_m3_sparse;
+const geom = sp.geom;
+const kvh = 2; // TP2 rank 0's index heads
+const max_tokens = 32768;
+
+/// A chunk of `rows` prompt rows from `pos0`.
+const Case = struct { rows: u32, pos0: u32 };
+
+const cases = [_]Case{
+    .{ .rows = 2048, .pos0 = 0 },
+    .{ .rows = 2048, .pos0 = 30720 },
+    .{ .rows = 2047, .pos0 = 6001 }, // a partial last tile, rows across a block boundary
+    .{ .rows = 33, .pos0 = 127 },
+    .{ .rows = 1, .pos0 = 5000 },
+    .{ .rows = 300, .pos0 = 16461 },
+    .{ .rows = 128, .pos0 = 128 * 40 - 1 },
+};
+
+/// A bf16 of random sign and mantissa at magnitude [2^-2, 2^-1).
+fn value(rng: std.Random) u16 {
+    return @as(u16, @truncate(rng.int(u32) & 0x807f)) | ((127 - 2) << 7);
+}
+
+const Rig = struct {
+    pool: geom.Pool,
+    arena: cuda.DeviceBuffer,
+    tables: cuda.DeviceBuffer,
+    iq: cuda.DeviceBuffer,
+    bmax: cuda.DeviceBuffer,
+    sel: cuda.DeviceBuffer,
+    q: cuda.DeviceBuffer,
+    out: cuda.DeviceBuffer,
+    nb: usize,
+
+    /// Index keys of the read layer at random, then planted: an all-zero block, NaN keys, a zero query row.
+    fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, kv8: bool) !Rig {
+        const pool: geom.Pool = .{ .kvh = kvh, .layers = 1, .kv8 = kv8 };
+        const nb = geom.blocks(max_tokens - 1);
+        var prng = std.Random.DefaultPrng.init(if (kv8) 0x6b7638 else 0x626631);
+        const rng = prng.random();
+        const page = pool.pageBytes();
+        const img = try gpa.alloc(u8, nb * page);
+        defer gpa.free(img);
+        rng.bytes(img);
+        const ik_at = 2 * kvh * geom.block * geom.d * @as(usize, if (kv8) 1 else 2);
+        const perm = try gpa.alloc(i32, nb);
+        defer gpa.free(perm);
+        for (perm, 0..) |*x, i| x.* = @intCast(i);
+        rng.shuffle(i32, perm);
+        for (0..nb) |b| {
+            const keys = std.mem.bytesAsSlice(u16, img[@as(usize, @intCast(perm[b])) * page + ik_at ..][0 .. geom.block * geom.d * 2]);
+            for (keys, 0..) |*k, i| k.* = if (b == 41) 0 else if (b == 7 and i / geom.d % 37 == 5) 0x7fc0 else value(rng);
+        }
+        const q = try gpa.alloc(u16, @as(usize, max_tokens) * kvh * geom.d);
+        defer gpa.free(q);
+        for (q, 0..) |*x, i| x.* = if (i / (kvh * geom.d) == 9) 0 else value(rng);
+        var r: Rig = .{ .pool = pool, .arena = undefined, .tables = undefined, .iq = undefined, .bmax = undefined, .sel = undefined, .q = undefined, .out = undefined, .nb = nb };
+        r.arena = try cuda.DeviceBuffer.alloc(d, img.len);
+        errdefer r.arena.free();
+        try r.arena.upload(0, img);
+        r.tables = try cuda.DeviceBuffer.alloc(d, nb * 4);
+        errdefer r.tables.free();
+        try r.tables.upload(0, std.mem.sliceAsBytes(perm));
+        r.iq = try cuda.DeviceBuffer.alloc(d, q.len * 2);
+        errdefer r.iq.free();
+        try r.iq.upload(0, std.mem.sliceAsBytes(q));
+        r.bmax = try cuda.DeviceBuffer.alloc(d, geom.bmaxBytes(2048, kvh, nb));
+        errdefer r.bmax.free();
+        r.sel = try cuda.DeviceBuffer.alloc(d, 2048 * kvh * geom.topk * 4);
+        errdefer r.sel.free();
+        const qa = try gpa.alloc(u16, 2048 * kvh * 16 * geom.d);
+        defer gpa.free(qa);
+        for (qa) |*x| x.* = value(rng);
+        r.q = try cuda.DeviceBuffer.alloc(d, qa.len * 2);
+        errdefer r.q.free();
+        try r.q.upload(0, std.mem.sliceAsBytes(qa));
+        r.out = try cuda.DeviceBuffer.alloc(d, qa.len * 2);
+        return r;
+    }
+
+    fn deinit(r: *Rig) void {
+        r.out.free();
+        r.q.free();
+        r.sel.free();
+        r.bmax.free();
+        r.iq.free();
+        r.tables.free();
+        r.arena.free();
+    }
+
+    fn paged(r: *const Rig) sp.Paged {
+        return .{ .pool = r.arena.ptr, .page_bytes = r.pool.pageBytes(), .layer_off = 0, .kvh = kvh, .tables = r.tables.ptr, .kv8 = r.pool.kv8 };
+    }
+
+    /// One kernel's block maxima of `c` (the query rows are the chunk's own), over a 0xA5 sentinel.
+    fn run(r: *Rig, s: *const sp.Sparse, st: cuda.Stream, c: Case, tiled: bool, out: []u8) !void {
+        try r.bmax.fill8(0xa5, st.handle);
+        const rows: sp.Rows = .{ .n = c.rows, .pos0 = @intCast(c.pos0) };
+        const sc: sp.Scratch = .{ .bmax = r.bmax.ptr, .sel = 0, .bm_stride = r.nb };
+        const iq = r.iq.ptr + @as(u64, c.pos0) * kvh * geom.d * 2;
+        const scale: f32 = @floatCast(std.math.pow(f64, geom.d, -0.5));
+        const top = c.pos0 + c.rows - 1;
+        if (tiled) try s.scoreRows(st, iq, rows, r.paged(), sc, top, scale) else try s.score(st, iq, rows, r.paged(), sc, top, scale);
+        try st.synchronize();
+        try r.bmax.download(0, out[0..geom.bmaxBytes(c.rows, kvh, r.nb)]);
+    }
+
+    /// Median ms of `reps` launches after two warm-ups.
+    fn time(r: *Rig, io: std.Io, s: *const sp.Sparse, st: cuda.Stream, c: Case, tiled: bool) !f64 {
+        const rows: sp.Rows = .{ .n = c.rows, .pos0 = @intCast(c.pos0) };
+        const sc: sp.Scratch = .{ .bmax = r.bmax.ptr, .sel = 0, .bm_stride = r.nb };
+        const scale: f32 = @floatCast(std.math.pow(f64, geom.d, -0.5));
+        const top = c.pos0 + c.rows - 1;
+        const iq = r.iq.ptr + @as(u64, c.pos0) * kvh * geom.d * 2;
+        var t: [7]f64 = undefined;
+        for (0..t.len + 2) |i| {
+            const t0 = check.now(io);
+            if (tiled) try s.scoreRows(st, iq, rows, r.paged(), sc, top, scale) else try s.score(st, iq, rows, r.paged(), sc, top, scale);
+            try st.synchronize();
+            if (i >= 2) t[i - 2] = @as(f64, @floatFromInt(check.now(io) - t0)) / 1e6;
+        }
+        return check.median(&t);
+    }
+
+    /// The chunk's selections (old scoring, then select), for the attention runs.
+    fn select(r: *Rig, s: *const sp.Sparse, st: cuda.Stream, c: Case) !void {
+        const rows: sp.Rows = .{ .n = c.rows, .pos0 = @intCast(c.pos0) };
+        const sc: sp.Scratch = .{ .bmax = r.bmax.ptr, .sel = r.sel.ptr, .bm_stride = r.nb };
+        const iq = r.iq.ptr + @as(u64, c.pos0) * kvh * geom.d * 2;
+        const scale: f32 = @floatCast(std.math.pow(f64, geom.d, -0.5));
+        try s.score(st, iq, rows, r.paged(), sc, c.pos0 + c.rows - 1, scale);
+        try s.select(st, rows, kvh, sc, .{});
+        try st.synchronize();
+    }
+
+    /// Attention of the selected rows into `out` (null: timing only, the median of 7 after two warm-ups in ms).
+    fn attend(r: *Rig, io: std.Io, s: *const sp.Sparse, st: cuda.Stream, c: Case, share: bool, out: ?[]u8) !f64 {
+        const rows: sp.Rows = .{ .n = c.rows, .pos0 = @intCast(c.pos0) };
+        const sc: sp.Scratch = .{ .bmax = r.bmax.ptr, .sel = r.sel.ptr, .bm_stride = r.nb };
+        const scale: f32 = @floatCast(std.math.pow(f64, geom.d, -0.5));
+        var t: [7]f64 = undefined;
+        const n: usize = if (out == null) t.len + 2 else 1;
+        for (0..n) |i| {
+            const t0 = check.now(io);
+            try s.attend(st, r.q.ptr, rows, r.paged(), sc, r.out.ptr, scale, share);
+            try st.synchronize();
+            if (i >= 2) t[i - 2] = @as(f64, @floatFromInt(check.now(io) - t0)) / 1e6;
+        }
+        if (out) |o| {
+            try r.out.download(0, o[0 .. @as(usize, c.rows) * kvh * 16 * geom.d * 2]);
+            return 0;
+        }
+        return check.median(&t);
+    }
+};
+
+pub fn run(gpu: check.Gpu) !void {
+    const gpa = gpu.gpa;
+    var st = try cuda.Stream.init(gpu.d, false);
+    defer st.deinit();
+    var s = try sp.Sparse.load(gpu.d);
+    defer s.unload();
+    var failed = false;
+    for ([_]bool{ false, true }) |kv8| {
+        var r = try Rig.init(gpa, gpu.d, kv8);
+        defer r.deinit();
+        const want = try gpa.alloc(u8, r.bmax.len);
+        defer gpa.free(want);
+        const got = try gpa.alloc(u8, r.bmax.len);
+        defer gpa.free(got);
+        const a_want = try gpa.alloc(u8, r.out.len);
+        defer gpa.free(a_want);
+        const a_got = try gpa.alloc(u8, r.out.len);
+        defer gpa.free(a_got);
+        for (cases) |c| {
+            const n = geom.bmaxBytes(c.rows, kvh, r.nb);
+            try r.run(&s, st, c, false, want);
+            try r.run(&s, st, c, true, got);
+            var id: [96]u8 = undefined;
+            const what = try std.fmt.bufPrint(&id, "mm3.prompt-score kv8={} rows={d} pos0={d}", .{ kv8, c.rows, c.pos0 });
+            if (check.sameBytes(what, got[0..n], want[0..n])) |_| {
+                check.pass("{s}: block maxima bit-equal ({d} bytes, unwritten entries alike)", .{ what, n });
+            } else |_| failed = true;
+            try r.select(&s, st, c);
+            const an = @as(usize, c.rows) * kvh * 16 * geom.d * 2;
+            _ = try r.attend(gpu.io, &s, st, c, false, a_want);
+            _ = try r.attend(gpu.io, &s, st, c, true, a_got);
+            const awhat = try std.fmt.bufPrint(&id, "mm3.attn-share kv8={} rows={d} pos0={d}", .{ kv8, c.rows, c.pos0 });
+            if (check.sameBytes(awhat, a_got[0..an], a_want[0..an])) |_| {
+                check.pass("{s}: attention output bit-equal ({d} bytes)", .{ awhat, an });
+            } else |_| failed = true;
+        }
+        for ([_]u32{ 2048, 8192, 32768 }) |depth| {
+            const c: Case = .{ .rows = 2048, .pos0 = depth - 2048 };
+            const old = try r.time(gpu.io, &s, st, c, false);
+            const new = try r.time(gpu.io, &s, st, c, true);
+            std.debug.print("RESULT mm3-prompt-score kv8={} depth={d} rows=2048 kvh={d}: tf_mm3_index {d:.3} ms, tf_mm3_index_rows {d:.3} ms ({d:.2}x)\n", .{ kv8, depth, kvh, old, new, old / new });
+            try r.select(&s, st, c);
+            const a0 = try r.attend(gpu.io, &s, st, c, false, null);
+            const a1 = try r.attend(gpu.io, &s, st, c, true, null);
+            std.debug.print("RESULT mm3-attn-share kv8={} depth={d} rows=2048 kvh={d}: per-thread expf {d:.3} ms, shared expf {d:.3} ms ({d:.2}x)\n", .{ kv8, depth, kvh, a0, a1, a0 / a1 });
+        }
+    }
+    std.debug.print("RESULT mm3-prompt-score: {s}\n", .{if (failed) "FAIL" else "PASS"});
+    if (failed) return error.TestFailed;
+}
diff --git a/zig/tests/cuda/mm3_prompt_tests.zig b/zig/tests/cuda/mm3_prompt_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1d0f01151d676e3d929156b54b02ae7c9a67c6e4
--- /dev/null
+++ b/zig/tests/cuda/mm3_prompt_tests.zig
@@ -0,0 +1,509 @@
+//! MiniMax-M3.1-Flash's prompt experts (x3gm) by width: FP64 bounds beside the decode kernel's, bit-stable tiles, rows.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const cand = @import("exl3_candidate_tests.zig");
+const fmt = core.exl3_format;
+const ex = cuda.exl3_experts;
+const gm = cuda.exl3_gm;
+const Gpu = check.Gpu;
+const Rig = cand.Rig;
+
+const E = 128; // one rank's TP2 share: every expert at half the 3,072-row width
+const D = 6144;
+const I = 1536;
+const SLOTS = 4;
+const CAP = 2048; // rows built: one prompt chunk
+const ALPHA: f32 = 1.702;
+const LIMIT: f32 = 7.0;
+const UP_BIAS: f32 = 1.0;
+const u: f64 = 1.0 / 16777216.0;
+const row_counts = [_]usize{ 1, 17, 300, 2048 };
+
+/// Expert e's gate (= up) and down bits: gate[e % 2], down[e % 2]; one value each is a uniform layer.
+const Combo = struct { name: []const u8, gate: [2]u32, down: [2]u32 };
+const combos = [_]Combo{
+    .{ .name = "3/3/3", .gate = .{ 3, 3 }, .down = .{ 3, 3 } },
+    .{ .name = "4/4/4", .gate = .{ 4, 4 }, .down = .{ 4, 4 } },
+    .{ .name = "3/3/4", .gate = .{ 3, 3 }, .down = .{ 4, 4 } },
+    .{ .name = "ragged", .gate = .{ 3, 4 }, .down = .{ 4, 3 } },
+};
+
+fn uniformOf(c: Combo) gm.Widths {
+    if (c.gate[0] != c.gate[1] or c.down[0] != c.down[1]) return .{};
+    return .{ .gu = 2 * c.gate[0], .down = 2 * c.down[0] };
+}
+
+/// One synthetic layer: device tensors, the host trellises and scales the reference reads, the seeded routing.
+const Built = struct {
+    layer: ex.Layer,
+    gbits: [E]u32,
+    dbits: [E]u32,
+    gate: [E][]i16,
+    up: [E][]i16,
+    down: [E][]i16,
+    suh_g: []f16,
+    suh_u: []f16,
+    svh_g: []f16,
+    svh_u: []f16,
+    suh_d: []f16,
+    svh_d: []f16,
+    x: []u16, // bf16 [CAP, D]
+    pick: []i32, // [CAP, SLOTS]
+    wts: []f32,
+    dx: u64,
+    dpick: u64,
+    dwts: u64,
+};
+
+fn randI16(a: std.mem.Allocator, r: std.Random, n: usize) ![]i16 {
+    const out = try a.alloc(i16, n);
+    for (out) |*v| v.* = r.int(i16);
+    return out;
+}
+
+/// Moderate scales, one in 16 large: the large gate and up columns reach swigluoai's clamp.
+fn scales(a: std.mem.Allocator, r: std.Random, n: usize, large: bool) ![]f16 {
+    const out = try a.alloc(f16, n);
+    for (out, 0..) |*v, i| {
+        const m: f32 = if (large and i % 16 == 5) 4 + 4 * r.float(f32) else 0.125 * r.float(f32);
+        v.* = @floatCast(if (r.boolean()) m else -m);
+    }
+    return out;
+}
+
+fn build(gpu: Gpu, rig: *Rig, r: std.Random, c: Combo) !Built {
+    const a = gpu.gpa;
+    var b: Built = undefined;
+    var gp: [E]u64 = undefined;
+    var up_p: [E]u64 = undefined;
+    var dp: [E]u64 = undefined;
+    var gk2: [E]i32 = undefined;
+    var dk2: [E]i32 = undefined;
+    for (0..E) |e| {
+        b.gbits[e] = c.gate[e % 2];
+        b.dbits[e] = c.down[e % 2];
+        b.gate[e] = try randI16(a, r, (D / 16) * (I / 16) * 16 * b.gbits[e]);
+        b.up[e] = try randI16(a, r, (D / 16) * (I / 16) * 16 * b.gbits[e]);
+        b.down[e] = try randI16(a, r, (I / 16) * (D / 16) * 16 * b.dbits[e]);
+        gp[e] = try rig.put(b.gate[e]);
+        up_p[e] = try rig.put(b.up[e]);
+        dp[e] = try rig.put(b.down[e]);
+        gk2[e] = @intCast(2 * b.gbits[e]);
+        dk2[e] = @intCast(2 * b.dbits[e]);
+    }
+    b.suh_g = try scales(a, r, E * D, false);
+    b.suh_u = try scales(a, r, E * D, false);
+    b.svh_g = try scales(a, r, E * I, true);
+    b.svh_u = try scales(a, r, E * I, true);
+    b.suh_d = try scales(a, r, E * I, false);
+    b.svh_d = try scales(a, r, E * D, false);
+    b.layer = .{
+        .gate = try rig.put(&gp),
+        .up = try rig.put(&up_p),
+        .down = try rig.put(&dp),
+        .gate_k2 = try rig.put(&gk2),
+        .up_k2 = try rig.put(&gk2),
+        .down_k2 = try rig.put(&dk2),
+        .suh_g = try rig.put(b.suh_g),
+        .suh_u = try rig.put(b.suh_u),
+        .svh_g = try rig.put(b.svh_g),
+        .svh_u = try rig.put(b.svh_u),
+        .suh_d = try rig.put(b.suh_d),
+        .svh_d = try rig.put(b.svh_d),
+        .experts = E,
+        .dims = D,
+        .width = I,
+        .codebook = .mul1,
+        .limit = LIMIT,
+        .act_mode = 2,
+        .alpha = ALPHA,
+        .up_bias = UP_BIAS,
+    };
+    b.x = try a.alloc(u16, CAP * D);
+    for (b.x) |*v| v.* = cand.bf16(r.float(f32) - 0.5);
+    b.pick = try a.alloc(i32, CAP * SLOTS);
+    for (0..CAP) |row| {
+        var idx: [E]i32 = undefined;
+        for (&idx, 0..) |*v, i| v.* = @intCast(i);
+        var n: usize = E;
+        for (0..SLOTS) |k| {
+            // a hot expert: a quarter of the rows send slot 0 to expert 0, so its passes split
+            var j = r.uintLessThan(usize, n);
+            if (k == 0 and r.uintLessThan(u32, 4) == 0) j = std.mem.indexOfScalar(i32, idx[0..n], 0) orelse j;
+            b.pick[row * SLOTS + k] = idx[j];
+            idx[j] = idx[n - 1];
+            n -= 1;
+        }
+    }
+    b.wts = try a.alloc(f32, CAP * SLOTS);
+    for (b.wts) |*v| v.* = 0.1 + 0.9 * r.float(f32);
+    b.dx = try rig.put(b.x);
+    b.dpick = try rig.put(b.pick);
+    b.dwts = try rig.put(b.wts);
+    return b;
+}
+
+fn freeBuilt(a: std.mem.Allocator, b: *Built) void {
+    for (0..E) |e| {
+        a.free(b.gate[e]);
+        a.free(b.up[e]);
+        a.free(b.down[e]);
+    }
+    for ([_][]f16{ b.suh_g, b.suh_u, b.svh_g, b.svh_u, b.suh_d, b.svh_d }) |s| a.free(s);
+    a.free(b.x);
+    a.free(b.pick);
+    a.free(b.wts);
+}
+
+/// The rows the reference checks: the first 32 and 33 spread up to the chunk's last.
+fn sampleRows() [65]usize {
+    var s: [65]usize = undefined;
+    for (0..32) |i| s[i] = i;
+    for (0..32) |i| s[32 + i] = 32 + i * 63;
+    s[64] = CAP - 1;
+    return s;
+}
+
+fn f16v(v: f16) f64 {
+    return @floatCast(v);
+}
+
+fn bfv(v: u16) f64 {
+    return @as(f32, @bitCast(@as(u32, v) << 16));
+}
+
+/// Each 128-block along the row axis replaced by the sum of its |entries| over sqrt(128) (the worst case).
+fn absRotate(x: []f64, nrows: usize, cols: usize) void {
+    const inv = 1.0 / @sqrt(@as(f64, 128.0));
+    var r: usize = 0;
+    while (r < nrows) : (r += 128) {
+        for (0..cols) |c| {
+            var s: f64 = 0;
+            for (0..128) |n| s += @abs(x[(r + n) * cols + c]);
+            for (0..128) |n| x[(r + n) * cols + c] = s * inv;
+        }
+    }
+}
+
+/// exl3_experts_f64_tests' f64 mirror and worst-case bound on the sampled rows, swigluoai's fp32 steps for the SiLU.
+fn reference(a: std.mem.Allocator, b: *const Built, rows: []const usize, want: []f64, tol: []f64) !void {
+    const p = rows.len * SLOTS;
+    const pair = struct {
+        fn row(rs: []const usize, s0: usize) usize {
+            return rs[s0 / SLOTS] * SLOTS + s0 % SLOTS;
+        }
+    }.row;
+    // xg / xu: fp16((x * suh) H) per slot, their error the fp16 rounding plus the fp32 rotation's, of the block's sum
+    const xg = try a.alloc(f16, p * D);
+    defer a.free(xg);
+    const xu = try a.alloc(f16, p * D);
+    defer a.free(xu);
+    const xgerr = try a.alloc(f64, p * D);
+    defer a.free(xgerr);
+    const xuerr = try a.alloc(f64, p * D);
+    defer a.free(xuerr);
+    const xs = try a.alloc(f64, p * D);
+    defer a.free(xs);
+    for ([_]struct { []f16, []f64, []const f16 }{ .{ xg, xgerr, b.suh_g }, .{ xu, xuerr, b.suh_u } }) |m| {
+        for (0..p) |s0| {
+            const e: usize = @intCast(b.pick[pair(rows, s0)]);
+            for (0..D) |k| xs[s0 * D + k] = bfv(b.x[rows[s0 / SLOTS] * D + k]) * f16v(m[2][e * D + k]);
+        }
+        fmt.rotate(xs, p, D, 1);
+        for (m[0], xs) |*o, v| o.* = @floatCast(v);
+        for (m[1], xs) |*o, v| o.* = @abs(v);
+        for (0..p) |s0| {
+            var c: usize = 0;
+            while (c < D) : (c += 128) {
+                var s: f64 = 0;
+                for (0..128) |n| s += @abs(m[1][s0 * D + c + n]);
+                for (0..128) |n| m[1][s0 * D + c + n] = s / @sqrt(128.0) * (1.0 / 2048.0 + 8 * u);
+            }
+        }
+    }
+    const zg = try a.alloc(f64, I * p);
+    defer a.free(zg);
+    const zu = try a.alloc(f64, I * p);
+    defer a.free(zu);
+    const eg = try a.alloc(f64, I * p);
+    defer a.free(eg);
+    const eu = try a.alloc(f64, I * p);
+    defer a.free(eu);
+    const s1g = try a.alloc(f64, I * p);
+    defer a.free(s1g);
+    const s1u = try a.alloc(f64, I * p);
+    defer a.free(s1u);
+    for ([_][]f64{ zg, zu, eg, eu, s1g, s1u }) |z| @memset(z, 0);
+    const wq = try a.alloc(f16, D * I);
+    defer a.free(wq);
+    for (0..E) |e| {
+        var used = false;
+        for (0..p) |s0| used = used or b.pick[pair(rows, s0)] == @as(i32, @intCast(e));
+        if (!used) continue;
+        const w: fmt.Width = .{ .halves = @intCast(2 * b.gbits[e]) };
+        for ([_]struct { []const i16, []const f16, []const f64, []f64, []f64, []f64 }{ .{ b.gate[e], xg, xgerr, zg, s1g, eg }, .{ b.up[e], xu, xuerr, zu, s1u, eu } }) |m| {
+            fmt.unpack(w, .mul1, m[0], D / 16, I / 16, wq);
+            for (0..p) |s0| {
+                if (b.pick[pair(rows, s0)] != @as(i32, @intCast(e))) continue;
+                for (0..D) |k| {
+                    const t: f64 = f16v(m[1][s0 * D + k]);
+                    const xe = m[2][s0 * D + k];
+                    for (0..I) |n| {
+                        const wv = f16v(wq[k * I + n]);
+                        m[3][n * p + s0] += t * wv;
+                        m[4][n * p + s0] += @abs(t) * @abs(wv);
+                        m[5][n * p + s0] += @abs(wv) * xe;
+                    }
+                }
+            }
+        }
+    }
+    // the fp32 accumulation (2^-17 of 128 roundings) on the |t||w| sums, then the output Hadamard and its rotation
+    for ([_]struct { []f64, []f64, []f64 }{ .{ zg, eg, s1g }, .{ zu, eu, s1u } }) |m| {
+        for (m[1], m[2]) |*e, s| e.* += s * (1.0 / 131072.0);
+        fmt.rotate(m[0], I, p, 0);
+        absRotate(m[1], I, p);
+        for (m[2], m[0]) |*o, v| o.* = @abs(v);
+        absRotate(m[2], I, p);
+        for (m[1], m[2]) |*e, v| e.* += v * 8 * u;
+    }
+    // swigluoai in fp32: the clamps are 1-Lipschitz, |d(g sigmoid(a g))/dg| <= 1.1, sigmoid's steps (|a g| + 4) u
+    const v = try a.alloc(f64, I * p);
+    defer a.free(v);
+    const verr = try a.alloc(f64, I * p);
+    defer a.free(verr);
+    for (0..I) |n| for (0..p) |s0| {
+        const e: usize = @intCast(b.pick[pair(rows, s0)]);
+        const at = n * p + s0;
+        const vg = zg[at] * f16v(b.svh_g[e * I + n]);
+        const vu = zu[at] * f16v(b.svh_u[e * I + n]);
+        const g = @min(vg, @as(f64, LIMIT));
+        const uu = @min(@max(vu, -@as(f64, LIMIT)), @as(f64, LIMIT));
+        const sg = g / (1.0 + @exp(-@as(f64, ALPHA) * g));
+        const act = sg * (uu + UP_BIAS);
+        v[at] = act * f16v(b.suh_d[e * I + n]);
+        const egk = eg[at] * @abs(f16v(b.svh_g[e * I + n])) + @abs(vg) * 4 * u;
+        const euk = eu[at] * @abs(f16v(b.svh_u[e * I + n])) + @abs(vu) * 4 * u;
+        const esg = 1.1 * egk + @abs(sg) * (@abs(ALPHA * g) + 4) * u;
+        const eact = @abs(uu + UP_BIAS) * esg + @abs(sg) * (euk + @abs(uu + UP_BIAS) * u) + @abs(act) * 2 * u;
+        verr[at] = eact * @abs(f16v(b.suh_d[e * I + n])) + @abs(v[at]) * u;
+    };
+    fmt.rotate(v, I, p, 0);
+    absRotate(verr, I, p);
+    const vrot = try a.alloc(f64, I * p);
+    defer a.free(vrot);
+    for (vrot, v) |*o, val| o.* = @abs(val);
+    absRotate(vrot, I, p);
+    const xd = try a.alloc(f16, p * I);
+    defer a.free(xd);
+    const xderr = try a.alloc(f64, p * I);
+    defer a.free(xderr);
+    for (0..p) |s0| for (0..I) |k| {
+        xd[s0 * I + k] = @floatCast(v[k * p + s0]);
+        xderr[s0 * I + k] = verr[k * p + s0] + vrot[k * p + s0] * 8 * u + @abs(f16v(xd[s0 * I + k])) / 2048;
+    };
+    const zd = try a.alloc(f64, D * p);
+    defer a.free(zd);
+    const s1d = try a.alloc(f64, D * p);
+    defer a.free(s1d);
+    const de = try a.alloc(f64, D * p);
+    defer a.free(de);
+    for ([_][]f64{ zd, s1d, de }) |z| @memset(z, 0);
+    const wd = try a.alloc(f16, I * D);
+    defer a.free(wd);
+    for (0..E) |e| {
+        var used = false;
+        for (0..p) |s0| used = used or b.pick[pair(rows, s0)] == @as(i32, @intCast(e));
+        if (!used) continue;
+        fmt.unpack(.{ .halves = @intCast(2 * b.dbits[e]) }, .mul1, b.down[e], I / 16, D / 16, wd);
+        for (0..p) |s0| {
+            if (b.pick[pair(rows, s0)] != @as(i32, @intCast(e))) continue;
+            for (0..I) |k| {
+                const t: f64 = f16v(xd[s0 * I + k]);
+                const xe = xderr[s0 * I + k];
+                for (0..D) |d| {
+                    const wv = f16v(wd[k * D + d]);
+                    zd[d * p + s0] += t * wv;
+                    s1d[d * p + s0] += @abs(t) * @abs(wv);
+                    de[d * p + s0] += @abs(wv) * xe;
+                }
+            }
+        }
+    }
+    for (de, s1d) |*e, s| e.* += s * (1.0 / 2048.0 + 1.0 / 131072.0);
+    fmt.rotate(zd, D, p, 0);
+    absRotate(de, D, p);
+    const zderr = try a.alloc(f64, D * p);
+    defer a.free(zderr);
+    for (zderr, zd) |*o, val| o.* = @abs(val);
+    absRotate(zderr, D, p);
+    for (de, zderr) |*e, val| e.* += val * 8 * u;
+    // the per-slot outputs and the weighted fp32 fma chain over the slots
+    for (rows, 0..) |row, ri| for (0..D) |d| {
+        var acc: f32 = 0;
+        var err: f64 = 0;
+        var swy: f64 = 0;
+        for (0..SLOTS) |k| {
+            const s0 = ri * SLOTS + k;
+            const e: usize = @intCast(b.pick[row * SLOTS + k]);
+            const y: f32 = @floatCast(zd[d * p + s0] * f16v(b.svh_d[e * D + d]));
+            const w = b.wts[row * SLOTS + k];
+            acc = @mulAdd(f32, w, y, acc);
+            err += @abs(w) * (de[d * p + s0] * @abs(f16v(b.svh_d[e * D + d])) + @abs(y) * u);
+            swy += @abs(w * y);
+        }
+        want[ri * D + d] = acc;
+        tol[ri * D + d] = err + swy / 2097152 + @abs(@as(f64, acc)) * u + 1e-30;
+    };
+}
+
+/// Sampled rows below `n`: worst fraction of the bound, largest error, worst column's error over the largest output.
+const Score = struct { frac: f64 = 0, err: f64 = 0, col: f64 = 0, rms: f64 = 0 };
+
+fn score(got: []const f32, rows: []const usize, n: usize, want: []const f64, tol: []const f64) Score {
+    var s: Score = .{};
+    var n_vals: f64 = 0;
+    var scale: f64 = 0;
+    for (rows, 0..) |row, ri| if (row < n) {
+        for (want[ri * D ..][0..D]) |w| scale = @max(scale, @abs(w));
+    };
+    for (0..D) |d| {
+        var col: f64 = 0;
+        for (rows, 0..) |row, ri| if (row < n) {
+            const e = @abs(@as(f64, got[row * D + d]) - want[ri * D + d]);
+            s.frac = @max(s.frac, e / tol[ri * D + d]);
+            s.err = @max(s.err, e);
+            s.rms += e * e;
+            n_vals += 1;
+            col = @max(col, e);
+        };
+        if (scale > 0) s.col = @max(s.col, col / scale);
+    }
+    s.rms = @sqrt(s.rms / @max(n_vals, 1));
+    return s;
+}
+
+const Runner = struct {
+    gpu: Gpu,
+    s: cuda.Stream,
+    old: *const ex.Experts,
+    new: *gm.Experts,
+    old_sc: u64,
+    new_sc: u64,
+    out: u64,
+    host: []f32,
+
+    fn newRun(r: *Runner, b: *const Built, w: gm.Widths, row0: usize, n: usize) !void {
+        const sc = gm.scratch(r.new_sc, b.layer, CAP, SLOTS);
+        try r.new.run(r.gpu.d, r.s, b.layer, w, b.dx + row0 * D * 2, D, b.dpick + row0 * SLOTS * 4, b.dwts + row0 * SLOTS * 4, n, r.out + row0 * D * 4, sc);
+    }
+
+    fn oldRun(r: *Runner, b: *const Built, n: usize) !void {
+        const sc = try ex.scratch(r.old_sc, b.layer, 256, SLOTS);
+        var at: usize = 0;
+        while (at < n) : (at += 256) {
+            const m = @min(256, n - at);
+            try r.old.run(r.s, b.layer, b.dx + at * D * 2, D, .bf16, b.dpick + at * SLOTS * 4, b.dwts + at * SLOTS * 4, m, r.out + at * D * 4, sc);
+        }
+    }
+
+    /// The fp32 outputs of the first `n` rows, after a sync.
+    fn fetch(r: *Runner, n: usize) ![]f32 {
+        try r.s.synchronize();
+        const dev: cuda.DeviceBuffer = .{ .d = r.gpu.d, .ptr = r.out, .len = n * D * 4 };
+        try dev.download(0, std.mem.sliceAsBytes(r.host[0 .. n * D]));
+        return r.host[0 .. n * D];
+    }
+
+    fn clear(r: *Runner) !void {
+        const dev: cuda.DeviceBuffer = .{ .d = r.gpu.d, .ptr = r.out, .len = CAP * D * 4 };
+        try dev.fill8(0xff, r.s.handle); // NaN canaries: a row left unwritten fails every comparison
+    }
+};
+
+/// `tf-cuda-test mm3-prompt-contract`: every width combination's FP64 bounds, tiles, v2 and chunk splits.
+pub fn run(gpu: Gpu) !void {
+    const a = gpu.gpa;
+    var old = try ex.Experts.load(gpu.d);
+    defer old.unload();
+    var new = try gm.Experts.load(gpu.d);
+    defer new.unload();
+    var s = try cuda.Stream.init(gpu.d, true);
+    defer s.deinit();
+    var prng = std.Random.DefaultPrng.init(0x3A3A);
+    const rows = sampleRows();
+    const want = try a.alloc(f64, rows.len * D);
+    defer a.free(want);
+    const tol = try a.alloc(f64, rows.len * D);
+    defer a.free(tol);
+    const keep = try a.alloc(f32, CAP * D);
+    defer a.free(keep);
+    var failed = false;
+    for (combos) |c| {
+        var rig: Rig = .{ .gpu = gpu };
+        defer rig.deinit();
+        var b = try build(gpu, &rig, prng.random(), c);
+        defer freeBuilt(a, &b);
+        var r: Runner = .{ .gpu = gpu, .s = s, .old = &old, .new = &new, .old_sc = try rig.zeros(try ex.scratchBytes(b.layer, 256, SLOTS)), .new_sc = try rig.zeros(gm.scratchBytes(b.layer, CAP, SLOTS)), .out = try rig.zeros(CAP * D * 4), .host = try a.alloc(f32, CAP * D) };
+        defer a.free(r.host);
+        const w = uniformOf(c);
+        try reference(a, &b, &rows, want, tol);
+        for (row_counts) |n| {
+            new.force = null;
+            try r.clear();
+            try r.newRun(&b, w, 0, n);
+            const sn = score(try r.fetch(n), &rows, n, want, tol);
+            if (n == CAP) @memcpy(keep, r.host);
+            try r.clear();
+            try r.oldRun(&b, n);
+            const so = score(try r.fetch(n), &rows, n, want, tol);
+            var diff: f64 = 0;
+            for (&rows, 0..) |row, ri| if (row < n) for (0..D) |d| {
+                diff = @max(diff, @abs(@as(f64, keep[row * D + d]) - r.host[row * D + d]) / tol[ri * D + d]);
+            };
+            if (n != CAP) diff = std.math.nan(f64); // the kept rows are the 2,048-row call's
+            std.debug.print("TABLE mm3.experts {s} rows={d} new_frac={e:.3} old_frac={e:.3} new_err={e:.3} old_err={e:.3} new_col={e:.3} old_col={e:.3} new_rms={e:.3} old_rms={e:.3} new_vs_old={e:.3}\n", .{ c.name, n, sn.frac, so.frac, sn.err, so.err, sn.col, so.col, sn.rms, so.rms, diff });
+            if (!(sn.frac <= 1)) {
+                std.debug.print("FAIL mm3.experts {s} rows={d}: x3gm at {d:.4} of its FP64 bound\n", .{ c.name, n, sn.frac });
+                failed = true;
+            }
+            if (!(so.frac <= 1)) std.debug.print("FINDING mm3.experts {s} rows={d}: the decode kernel at {d:.4} of the bound\n", .{ c.name, n, so.frac });
+        }
+        bitChecks(&r, &b, c, w, keep) catch |e| {
+            std.debug.print("FAIL mm3.experts {s}: {t}\n", .{ c.name, e });
+            failed = true;
+        };
+    }
+    if (failed) return error.TestFailed;
+    check.pass("mm3.experts: x3gm within its FP64 bounds at every width combination and row count; tiles, v2 and chunk splits bit-equal", .{});
+}
+
+/// The 2,048-row call's bytes (`keep`) again from every tile it builds, v2's kernel, and two other chunk splits.
+fn bitChecks(r: *Runner, b: *const Built, c: Combo, w: gm.Widths, keep: []const f32) !void {
+    var tiles: usize = 0;
+    const ngu: usize = if (w.gu == 0) 2 else cuda.exl3.block.x3gm.gu_tiles.len;
+    const ndn: usize = if (w.gu == 0) 1 else cuda.exl3.block.x3gm.dn_tiles.len;
+    for (0..ngu) |gu| for (0..ndn) |dn| {
+        r.new.force = .{ .gu = gu, .dn = dn };
+        try r.clear();
+        r.newRun(b, w, 0, CAP) catch |e| if (e == error.Unsupported) continue else return e;
+        try check.sameBytes("mm3.experts tile", std.mem.sliceAsBytes(try r.fetch(CAP)), std.mem.sliceAsBytes(keep));
+        tiles += 1;
+    };
+    r.new.force = null;
+    if (w.gu != 0) {
+        try r.clear();
+        try r.newRun(b, .{}, 0, CAP);
+        try check.sameBytes("mm3.experts v2", std.mem.sliceAsBytes(try r.fetch(CAP)), std.mem.sliceAsBytes(keep));
+    }
+    try r.clear();
+    try r.newRun(b, w, 0, 1000);
+    try r.newRun(b, w, 1000, CAP - 1000);
+    try check.sameBytes("mm3.experts split 1000", std.mem.sliceAsBytes(try r.fetch(CAP)), std.mem.sliceAsBytes(keep));
+    try r.clear();
+    for (0..CAP / 128) |k| try r.newRun(b, w, k * 128, 128);
+    try check.sameBytes("mm3.experts 128-row calls", std.mem.sliceAsBytes(try r.fetch(CAP)), std.mem.sliceAsBytes(keep));
+    check.pass("mm3.experts {s}: {d} tile pairs{s}, a 1000 + 1048 split and 128-row calls give the 2,048-row call's bytes", .{ c.name, tiles, if (w.gu != 0) ", v2" else "" });
+}
diff --git a/zig/tests/cuda/mm3_speed.zig b/zig/tests/cuda/mm3_speed.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d3a2eec9d001e519d5a979d6895b7aa265874ef1
--- /dev/null
+++ b/zig/tests/cuda/mm3_speed.zig
@@ -0,0 +1,315 @@
+//! tf-cuda-test mm3-graph-eq / mm3-rows-eq / mm3-speed-bench: graph replay equals eager, adaptive rows equal fixed.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const synth = @import("mm3_synth.zig");
+
+const Seg = mm.iface.Seg;
+const steps = 24;
+
+const Args = struct { layers: u32 = 1, kv8: bool = false, first_moe: ?u32 = null, decode_only: bool = false, tp2: bool = false };
+
+fn parseArgs(rest: []const [:0]const u8) !Args {
+    var a: Args = .{};
+    for (rest, 0..) |s, i| {
+        if (std.mem.eql(u8, s, "kv8")) {
+            a.kv8 = true;
+        } else if (std.mem.eql(u8, s, "decode")) {
+            a.decode_only = true;
+        } else if (std.mem.eql(u8, s, "tp2")) {
+            a.tp2 = true; // TP2 rank 0 alone at the shipped pack's widths
+        } else if (std.mem.startsWith(u8, s, "moe=")) {
+            a.first_moe = try std.fmt.parseInt(u32, s[4..], 10);
+        } else if (i == 0) {
+            a.layers = try std.fmt.parseInt(u32, s, 10);
+        } else return error.BadArgument;
+    }
+    return a;
+}
+
+fn options(a: Args, slots: u32, capacity: u32, score_mib: u32) synth.Options {
+    const o: synth.Options = .{ .layers = a.layers, .slots = slots, .capacity_tokens = capacity, .kv8 = a.kv8, .first_moe = a.first_moe, .score_mib = score_mib };
+    if (!a.tp2) return o;
+    var t = o;
+    t.world = 2;
+    t.widths = synth.pack_widths;
+    return t;
+}
+
+fn randomIds(gpa: std.mem.Allocator, n: usize, vocab: u32, seed: u64) ![]i32 {
+    var prng = std.Random.DefaultPrng.init(seed);
+    const ids = try gpa.alloc(i32, n);
+    for (ids) |*p| p.* = @intCast(prng.random().uintLessThan(u32, vocab));
+    return ids;
+}
+
+fn hashOf(xs: []const f32) u64 {
+    return std.hash.Wyhash.hash(0, std.mem.sliceAsBytes(xs));
+}
+
+fn ms(ns: i96) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e6;
+}
+
+/// What a script left: every call's logits hash, every drawn token and each slot's KV bytes.
+const Rec = struct {
+    hashes: std.ArrayList(u64) = .empty,
+    tokens: std.ArrayList(u32) = .empty,
+    kv: [3][]u8 = .{ &.{}, &.{}, &.{} },
+
+    fn deinit(r: *Rec, gpa: std.mem.Allocator) void {
+        r.hashes.deinit(gpa);
+        r.tokens.deinit(gpa);
+        for (r.kv) |k| gpa.free(k);
+    }
+
+    fn note(r: *Rec, gpa: std.mem.Allocator, rows: []const f32, tok: u32) !void {
+        try r.hashes.append(gpa, hashOf(rows));
+        try r.tokens.append(gpa, tok);
+    }
+
+    fn same(a: *const Rec, b: *const Rec, what: []const u8) bool {
+        if (!std.mem.eql(u64, a.hashes.items, b.hashes.items)) {
+            for (a.hashes.items, b.hashes.items, 0..) |x, y, i| if (x != y) {
+                std.debug.print("FAIL {s}: call {d} logits differ ({d} calls)\n", .{ what, i, a.hashes.items.len });
+                break;
+            };
+            return false;
+        }
+        if (!std.mem.eql(u32, a.tokens.items, b.tokens.items)) {
+            std.debug.print("FAIL {s}: tokens differ\n", .{what});
+            return false;
+        }
+        for (a.kv, b.kv, 0..) |x, y, s| {
+            var id_buf: [64]u8 = undefined;
+            const id = std.fmt.bufPrint(&id_buf, "{s} kv slot {d}", .{ what, s }) catch unreachable;
+            check.sameBytes(id, y, x) catch return false;
+        }
+        return true;
+    }
+};
+
+fn draft(step: usize, i: usize, vocab: u32) i32 {
+    return @intCast((step * 7919 + i * 104729 + 13) % vocab);
+}
+
+/// Prompts on 3 slots, then decode rows, verify windows kept in part, and shared windows over all three slots.
+fn script(gpa: std.mem.Allocator, m: *synth.Model, prompts: [3][]const i32, rec: *Rec) !void {
+    const v: usize = m.geometry().own_vocab;
+    const vocab = m.cfg.vocab;
+    var pos: [3]u32 = undefined;
+    var tok: [3]u32 = undefined;
+    for (0..3) |s| {
+        tok[s] = try m.prefill(@intCast(s), prompts[s], 2048);
+        pos[s] = @intCast(prompts[s].len);
+        try rec.note(gpa, m.lastLogits(), tok[s]);
+    }
+    for (0..steps) |step| {
+        for (0..3) |s| {
+            if (s == 2 and step % 6 == 3) { // a 5-row verify window that keeps 1 to 3 rows; the rest are overwritten
+                var ids: [5]i32 = undefined;
+                ids[0] = @intCast(tok[2]);
+                for (1..5) |i| ids[i] = draft(step, i, vocab);
+                const out = try m.decode(2, pos[2], &ids);
+                defer gpa.free(out);
+                const keep = 1 + step % 3;
+                tok[2] = synth.argmax(out[(keep - 1) * v ..][0..v]);
+                try rec.note(gpa, out, tok[2]);
+                pos[2] += @intCast(keep);
+                continue;
+            }
+            const out = try m.decode(@intCast(s), pos[s], &[_]i32{@intCast(tok[s])});
+            defer gpa.free(out);
+            tok[s] = synth.argmax(out);
+            try rec.note(gpa, out, tok[s]);
+            pos[s] += 1;
+        }
+        if (step % 5 == 4) { // slots 1, 0, 2 with 1, 2, 3 rows; each keeps its first row
+            const segs = [_]Seg{ .{ .slot = 1, .row0 = 0, .rows = 1 }, .{ .slot = 0, .row0 = 1, .rows = 2 }, .{ .slot = 2, .row0 = 3, .rows = 3 } };
+            var ids: [6]i32 = undefined;
+            var at: [6]i32 = undefined;
+            for (segs) |g| for (0..g.rows) |k| {
+                ids[g.row0 + k] = if (k == 0) @intCast(tok[g.slot]) else draft(step, g.row0 + k, vocab);
+                at[g.row0 + k] = @intCast(pos[g.slot] + k);
+            };
+            const out = try m.shared(&segs, &ids, &at);
+            defer gpa.free(out);
+            for (segs) |g| {
+                tok[g.slot] = synth.argmax(out[g.row0 * v ..][0..v]);
+                pos[g.slot] += 1;
+            }
+            try rec.note(gpa, out, tok[0] ^ tok[1] ^ tok[2]);
+        }
+    }
+    for (0..3) |s| rec.kv[s] = try m.kvBytes(@intCast(s), pos[s]);
+}
+
+pub fn graphEq(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    const gpa = gpu.gpa;
+    const a = try parseArgs(rest);
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    const m = try synth.Model.init(gpa, gpu.d, stream, options(a, 3, 4096, 64));
+    defer m.deinit();
+    // slot 0 crosses the 2048-token bucket edge while decoding; slots 1 and 2 sit in buckets 0 and 1
+    const lens = [3]usize{ 2030, 1500, 2200 };
+    var prompts: [3][]i32 = undefined;
+    for (&prompts, lens, 0..) |*p, n, s| p.* = try randomIds(gpa, n, m.cfg.vocab, 0x6571 + s);
+    defer for (prompts) |p| gpa.free(p);
+    const ps: [3][]const i32 = .{ prompts[0], prompts[1], prompts[2] };
+
+    var eager: Rec = .{};
+    defer eager.deinit(gpa);
+    try script(gpa, m, ps, &eager);
+    try m.fwd().useGraphs(gpa, .{});
+    var cold: Rec = .{};
+    defer cold.deinit(gpa);
+    try script(gpa, m, ps, &cold);
+    const c1 = m.fwd().graphs.?.cache.stats;
+    var warm: Rec = .{};
+    defer warm.deinit(gpa);
+    try script(gpa, m, ps, &warm);
+    const c2 = m.fwd().graphs.?.cache.stats;
+    const held = m.fwd().graphs.?.cache.count();
+    try m.fwd().useGraphs(gpa, .{ .on = false });
+
+    var failed = false;
+    const calls = eager.hashes.items.len;
+    if (eager.same(&cold, "mm3.graph-eq cold")) check.pass("mm3.graph-eq cold: {d} calls' logits, tokens and 3 slots' KV equal eager ({d} captured, {d} replayed, {d} eager)", .{ calls, c1.captured, c1.replayed, c1.eager }) else failed = true;
+    if (eager.same(&warm, "mm3.graph-eq warm")) check.pass("mm3.graph-eq warm: equal eager again ({d} new captures, {d} replays)", .{ c2.captured - c1.captured, c2.replayed - c1.replayed }) else failed = true;
+    if (c1.replayed == 0 or c2.replayed - c1.replayed <= c1.replayed) {
+        std.debug.print("FAIL mm3.graph-eq: graphs did not replay as keyed ({d} replayed cold, {d} warm)\n", .{ c1.replayed, c2.replayed - c1.replayed });
+        failed = true;
+    }
+    std.debug.print("RESULT mm3-graph-eq layers={d} kv8={} moe={?d}: {d} calls a pass, {d} graphs held, {s}\n", .{ a.layers, a.kv8, a.first_moe, calls, held, if (failed) "FAIL" else "PASS" });
+    if (failed) return error.TestFailed;
+}
+
+/// One prefill and `steps` greedy decode rows from slot 0: the prompt row, then every row's logits hash and token.
+fn greedy(gpa: std.mem.Allocator, m: *synth.Model, ids: []const i32, chunk_rows: u32, rec: *Rec) !void {
+    var tok = try m.prefill(0, ids, chunk_rows);
+    try rec.note(gpa, m.lastLogits(), tok);
+    var pos: u32 = @intCast(ids.len);
+    for (0..steps) |_| {
+        const out = try m.decode(0, pos, &[_]i32{@intCast(tok)});
+        defer gpa.free(out);
+        tok = synth.argmax(out);
+        try rec.note(gpa, out, tok);
+        pos += 1;
+    }
+    rec.kv[0] = try m.kvBytes(0, pos);
+}
+
+pub fn rowsEq(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    const gpa = gpu.gpa;
+    const a = try parseArgs(rest);
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    const n = 8192 + 333;
+    var fixed: Rec = .{};
+    defer fixed.deinit(gpa);
+    var cuts: [2]Rec = .{ .{}, .{} };
+    defer for (&cuts) |*c| c.deinit(gpa);
+    var ids: []i32 = &.{};
+    defer gpa.free(ids);
+    var fixed_chunks: u32 = 0;
+    {
+        const m = try synth.Model.init(gpa, gpu.d, stream, options(a, 1, 12288, 64));
+        defer m.deinit();
+        ids = try randomIds(gpa, n, m.cfg.vocab, 0x726f7773);
+        try greedy(gpa, m, ids, 2048, &fixed);
+        fixed_chunks = m.chunks;
+        for (&cuts, [_]u32{ 512, 1024 }) |*c, rows| try greedy(gpa, m, ids, rows, c);
+    }
+    // a 1 MiB bound: 2048-row chunks while they fit, then fewer whole pages as positions grow (the engine's plan)
+    const m = try synth.Model.init(gpa, gpu.d, stream, options(a, 1, 12288, 1));
+    defer m.deinit();
+    var adapt: Rec = .{};
+    defer adapt.deinit(gpa);
+    try greedy(gpa, m, ids, 0, &adapt);
+    var rows_seen: [8]usize = @splat(0);
+    var at: usize = 0;
+    var k: usize = 0;
+    while (at < n and k < rows_seen.len) : (k += 1) {
+        rows_seen[k] = m.plan.rowsAt(at, n);
+        at += rows_seen[k];
+    }
+    var failed = false;
+    if (fixed.same(&cuts[0], "mm3.rows-eq 512")) check.pass("mm3.rows-eq: 512-row chunks equal 2048-row chunks: prompt row, {d} greedy tokens and KV", .{steps}) else failed = true;
+    if (fixed.same(&cuts[1], "mm3.rows-eq 1024")) check.pass("mm3.rows-eq: 1024-row chunks equal 2048-row chunks", .{}) else failed = true;
+    if (fixed.same(&adapt, "mm3.rows-eq adaptive")) check.pass("mm3.rows-eq: the bounded plan's chunks {any} under a {d}-byte scratch equal fixed rows", .{ rows_seen[0..k], m.plan.scratch }) else failed = true;
+    std.debug.print("RESULT mm3-rows-eq layers={d} kv8={} moe={?d}: {d} tokens, fixed {d} chunks, adaptive {d} chunks, {s}\n", .{ a.layers, a.kv8, a.first_moe, n, fixed_chunks, m.chunks, if (failed) "FAIL" else "PASS" });
+    if (failed) return error.TestFailed;
+}
+
+/// Milliseconds a forward of `call` takes to the stream's end, median of `reps` after `warm` untimed runs.
+fn timeCall(io: std.Io, m: *synth.Model, call: mm.forward.Call, warm: usize, reps: usize, out: []f64) !f64 {
+    for (0..warm) |_| {
+        _ = try m.fwd().run(call);
+        try m.settle();
+    }
+    for (out[0..reps]) |*t| {
+        const t0 = check.now(io);
+        _ = try m.fwd().run(call);
+        try m.settle();
+        t.* = ms(check.now(io) - t0);
+    }
+    return check.median(out[0..reps]);
+}
+
+pub fn bench(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    const gpa = gpu.gpa;
+    const io = gpu.io;
+    const a = try parseArgs(rest);
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    const ctxs = [_]u32{ 2048, 8192, 32768 };
+    const m = try synth.Model.init(gpa, gpu.d, stream, options(a, 4, 32768 + 256, 64));
+    defer m.deinit();
+    const ids = try randomIds(gpa, 32768 + 64, m.cfg.vocab, 0x62656e63);
+    defer gpa.free(ids);
+    var times: [64]f64 = undefined;
+    const reps = 40;
+
+    // prefill: whole prompts of each length at each chunk size, and at the plan's rows (median of 3)
+    if (!a.decode_only) for (ctxs) |n| for ([_]u32{ 512, 1024, 2048, 0 }) |rows| {
+        var t: [3]f64 = undefined;
+        for (&t) |*x| {
+            const t0 = check.now(io);
+            _ = try m.prefill(0, ids[0..n], rows);
+            x.* = ms(check.now(io) - t0);
+        }
+        const med = check.median(&t);
+        std.debug.print("RESULT mm3-bench prefill layers={d} moe={?d} tokens={d} rows={s}{d}: {d:.1} ms, {d:.0} tok/s (median of 3)\n", .{ a.layers, a.first_moe, n, if (rows == 0) "plan:" else "", if (rows == 0) m.plan.rowsAt(0, n) else rows, med, @as(f64, @floatFromInt(n)) / (med / 1e3) });
+    };
+
+    // decode windows, eager then graphs (warm-up covers first use and capture); `decode` skips prefill (zeroed pool)
+    if (!a.decode_only) for (1..4) |s| {
+        _ = try m.prefill(@intCast(s), ids[0..32768], 2048);
+    };
+    for (ctxs) |n| {
+        if (!a.decode_only) _ = try m.prefill(0, ids[0..n], 2048);
+        const pos0: u32 = n;
+        var positions: [64]i32 = undefined;
+        const segs = [_]Seg{ .{ .slot = 0, .row0 = 0, .rows = 16 }, .{ .slot = 1, .row0 = 16, .rows = 16 }, .{ .slot = 2, .row0 = 32, .rows = 16 }, .{ .slot = 3, .row0 = 48, .rows = 16 } };
+        for (segs) |g| for (0..16) |k| {
+            positions[g.row0 + k] = @intCast((if (g.slot == 0) pos0 else 32768 - 64) + k);
+        };
+        const shapes = [_]struct { name: []const u8, call: mm.forward.Call }{
+            .{ .name = "rows=1", .call = .{ .ids = ids[0..1], .slot = 0, .pos0 = pos0 } },
+            .{ .name = "rows=4", .call = .{ .ids = ids[0..4], .slot = 0, .pos0 = pos0 } },
+            .{ .name = "rows=16", .call = .{ .ids = ids[0..16], .slot = 0, .pos0 = pos0 } },
+            .{ .name = "shared=4x16", .call = .{ .ids = ids[0..64], .segs = &segs, .positions = &positions } },
+        };
+        for (shapes) |sh| {
+            try m.fwd().useGraphs(gpa, .{ .on = false });
+            const e = try timeCall(io, m, sh.call, 3, reps, &times);
+            try m.fwd().useGraphs(gpa, .{ .tp = a.tp2 });
+            const g = try timeCall(io, m, sh.call, 3, reps, &times);
+            const st = m.fwd().graphs.?.cache.stats;
+            std.debug.print("RESULT mm3-bench decode{s} layers={d} moe={?d} prefilled={} ctx={d} {s}: eager {d:.3} ms, graph {d:.3} ms ({d:.2}x, {d} replays), median of {d}\n", .{ if (a.tp2) " tp2-rank0" else "", a.layers, a.first_moe, !a.decode_only, n, sh.name, e, g, e / g, st.replayed, reps });
+        }
+    }
+    try m.fwd().useGraphs(gpa, .{ .on = false });
+}
diff --git a/zig/tests/cuda/mm3_synth.zig b/zig/tests/cuda/mm3_synth.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d04a51925989ff19014a7523020b745453294a01
--- /dev/null
+++ b/zig/tests/cuda/mm3_synth.zig
@@ -0,0 +1,468 @@
+//! A synthetic MiniMax-M3.1-Flash on one GPU (rank 0 alone, no checkpoint): seeded EXL3 codes, production forward.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+
+const fw = mm.forward;
+const iface = mm.iface;
+const weights = mm.weights;
+const Config = mm.config.Config;
+const exl3 = cuda.exl3;
+const rk = cuda.minimax_m3_rows;
+const Pool = cuda.minimax_m3_sparse.geom.Pool;
+
+/// Half-bit widths of the synthetic pack: 3-bit experts, 4-bit attention and dense/shared MLPs, a 6-bit head.
+pub const expert_k2: u32 = 6;
+pub const linear_halves: u32 = 8;
+pub const head_halves: u32 = 12;
+
+/// Half-bit widths of one synthetic pack's classes.
+pub const Widths = struct { attn: u32 = linear_halves, kv: u32 = linear_halves, mlp: u32 = linear_halves, head: u32 = head_halves };
+/// The shipped MiniMax-M3.1-Flash pack's: 6-bit q, o and MLPs, 8-bit k, v and head.
+pub const pack_widths: Widths = .{ .attn = 12, .kv = 16, .mlp = 12, .head = 16 };
+
+pub const Options = struct {
+    layers: u32 = 1,
+    slots: u32 = 2,
+    capacity_tokens: u32 = 4096, // positions a slot holds, rounded up to whole pages
+    seed: u64 = 0x6d33_5e7d,
+    kv8: bool = false,
+    first_moe: ?u32 = null, // layers from this one on are routed (null: the config's own moe_layer_freq)
+    score_mib: u32 = 64, // the block-score scratch bound (rows_plan; 0: unbounded)
+    world: u32 = 1, // rank 0's share of this many ranks, run alone (Device.solo) above one
+    widths: Widths = .{},
+    prompt_experts: bool = false, // prompt chunks' routed experts on x3gm (the pack's path), else the decode kernel
+};
+
+pub const Error = error{ BadOptions, PageStatus, BadSlot };
+
+/// What one matrix's trellis takes in bytes at `halves` half-bits a value, stored layout.
+fn trellisBytes(k: usize, n: usize, halves: usize) usize {
+    return (k / 16) * (n / 16) * halves * 4 * 4;
+}
+
+/// Uploads synthetic tensors and keeps every buffer it made; codes are windows into one shared noise buffer.
+const Maker = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    rng: std.Random,
+    owned: *std.ArrayList(cuda.DeviceBuffer),
+    wd: Widths,
+    noise: cuda.DeviceBuffer = undefined,
+
+    fn keep(mk: *Maker, b: cuda.DeviceBuffer) !u64 {
+        errdefer {
+            var x = b;
+            x.free();
+        }
+        try mk.owned.append(mk.gpa, b);
+        return b.ptr;
+    }
+
+    fn upload(mk: *Maker, bytes: []const u8) !u64 {
+        return mk.keep(try cuda.DeviceBuffer.fromHost(mk.d, bytes));
+    }
+
+    /// `len` random bytes on the device, filled from the host in 64 MiB pieces.
+    fn randomBytes(mk: *Maker, len: usize) !cuda.DeviceBuffer {
+        var b = try cuda.DeviceBuffer.alloc(mk.d, len);
+        errdefer b.free();
+        const piece = try mk.gpa.alloc(u8, @min(len, 64 << 20));
+        defer mk.gpa.free(piece);
+        var at: usize = 0;
+        while (at < len) : (at += piece.len) {
+            const n = @min(piece.len, len - at);
+            mk.rng.bytes(piece[0..n]);
+            try b.upload(at, piece[0..n]);
+        }
+        return b;
+    }
+
+    /// A trellis of `bytes`: a 256-byte aligned window at a random offset of the noise buffer.
+    fn codes(mk: *Maker, bytes: usize) u64 {
+        std.debug.assert(bytes <= mk.noise.len);
+        const span = (mk.noise.len - bytes) / 256;
+        return mk.noise.ptr + 256 * mk.rng.uintLessThan(usize, span + 1);
+    }
+
+    fn f16s(mk: *Maker, n: usize, comptime fill: anytype, arg: f32) !u64 {
+        const h = try mk.gpa.alloc(u16, n);
+        defer mk.gpa.free(h);
+        for (h) |*v| v.* = @bitCast(@as(f16, @floatCast(fill(mk.rng, arg))));
+        return mk.upload(std.mem.sliceAsBytes(h));
+    }
+
+    fn f32s(mk: *Maker, n: usize, comptime fill: anytype, arg: f32) !u64 {
+        const h = try mk.gpa.alloc(f32, n);
+        defer mk.gpa.free(h);
+        for (h) |*v| v.* = fill(mk.rng, arg);
+        return mk.upload(std.mem.sliceAsBytes(h));
+    }
+
+    /// One EXL3 matrix [k] -> [n]: sign `suh`, `svh` of 1/sqrt(k) so a unit-rms row stays near unit rms.
+    fn matrix(mk: *Maker, k: u32, n: u32, halves: u32) !exl3.Weight {
+        const st = exl3.strides(k, n, halves, false);
+        return .{
+            .trellis = mk.codes(trellisBytes(k, n, halves)),
+            .suh = try mk.f16s(k, sign, 1),
+            .svh = try mk.f16s(n, sign, 1 / @sqrt(@as(f32, @floatFromInt(k)))),
+            .k = k,
+            .n = n,
+            .halves = halves,
+            .codebook = .mul1,
+            .stride_k = st.k,
+            .stride_nb = st.nb,
+        };
+    }
+
+    fn norm(mk: *Maker, n: usize) !u64 {
+        return mk.f32s(n, around, 1);
+    }
+
+    /// A routed layer's experts at `expert_k2` and its packed tables; `attachTables` wires them once Weights exist.
+    fn experts(mk: *Maker, l: u32, e: u32, dims: u32, width: u32, tabs: *std.ArrayList(Pending)) !cuda.exl3_experts.Layer {
+        const bytes = trellisBytes(dims, width, expert_k2);
+        const ptrs = try mk.gpa.alloc(u64, 3 * e);
+        defer mk.gpa.free(ptrs);
+        for (ptrs) |*p| p.* = mk.codes(bytes);
+        const k2 = try mk.gpa.alloc(i32, e);
+        defer mk.gpa.free(k2);
+        @memset(k2, @intCast(expert_k2));
+        const t: weights.Tables = .{ .layer = @intCast(l), .gate = ptrs[0..e], .up = ptrs[e .. 2 * e], .down = ptrs[2 * e ..], .gate_k2 = k2, .up_k2 = k2, .down_k2 = k2 };
+        const packed_ = try weights.packTables(mk.gpa, t);
+        defer mk.gpa.free(packed_);
+        const base = try mk.upload(packed_);
+        try tabs.append(mk.gpa, .{ .layer = @intCast(l), .experts = e, .ptrs = weights.tablePtrs(base, e) });
+        const du: f32 = 1 / @sqrt(@as(f32, @floatFromInt(dims)));
+        const wu: f32 = 1 / @sqrt(@as(f32, @floatFromInt(width)));
+        return .{
+            .gate = 0,
+            .up = 0,
+            .down = 0,
+            .gate_k2 = 0,
+            .up_k2 = 0,
+            .down_k2 = 0,
+            .suh_g = try mk.f16s(@as(usize, e) * dims, sign, 1),
+            .suh_u = try mk.f16s(@as(usize, e) * dims, sign, 1),
+            .svh_g = try mk.f16s(@as(usize, e) * width, sign, du),
+            .svh_u = try mk.f16s(@as(usize, e) * width, sign, du),
+            .suh_d = try mk.f16s(@as(usize, e) * width, sign, 1),
+            .svh_d = try mk.f16s(@as(usize, e) * dims, sign, wu),
+            .experts = e,
+            .dims = dims,
+            .width = width,
+            .codebook = .mul1,
+            .uniform_k2 = expert_k2,
+        };
+    }
+
+    fn layer(mk: *Maker, g: *const fw.Geometry, l: u32, tabs: *std.ArrayList(Pending)) !weights.Layer {
+        const h = g.hidden;
+        const proj: f32 = @sqrt(3 / @as(f32, @floatFromInt(h)));
+        var ly: weights.Layer = .{
+            .input_ln = try mk.norm(h),
+            .post_ln = try mk.norm(h),
+            .q_norm = try mk.norm(g.q_w),
+            .k_norm = try mk.norm(g.q_w),
+            .index_q_norm = try mk.norm(g.q_w),
+            .index_k_norm = try mk.norm(g.q_w),
+            .index_q_proj = try mk.f16s(@as(usize, g.iq_w) * h, uniform, proj),
+            .index_k_proj = try mk.f16s(@as(usize, g.ik_w) * h, uniform, proj),
+            .q = try mk.matrix(h, g.q_w, mk.wd.attn),
+            .k = try mk.matrix(h, g.kv_w, mk.wd.kv),
+            .v = try mk.matrix(h, g.kv_w, mk.wd.kv),
+            .o = try mk.matrix(g.q_w, h, mk.wd.attn),
+            .ffn = undefined,
+        };
+        if (!g.isMoe(l)) {
+            ly.ffn = .{ .dense = try mk.mlp(h, g.dense_w) };
+            return ly;
+        }
+        ly.ffn = .{ .moe = .{
+            .router = try mk.f32s(@as(usize, g.experts) * h, uniform, proj),
+            .bias = try mk.f32s(g.experts, uniform, 0.05),
+            .experts = try mk.experts(l, g.experts, h, g.moe_w, tabs),
+            .shared = try mk.mlp(h, g.shared_w),
+        } };
+        return ly;
+    }
+
+    fn mlp(mk: *Maker, h: u32, w: u32) !weights.Dense {
+        const b = mk.wd.mlp;
+        return .{ .gate = try mk.matrix(h, w, b), .up = try mk.matrix(h, w, b), .down = try mk.matrix(w, h, b) };
+    }
+
+    /// bf16 [vocab, hidden]: a random sign and mantissa at magnitude [2^-6, 2^-5), four values per draw.
+    fn embed(mk: *Maker, rows: usize, hidden: usize) !u64 {
+        const n = rows * hidden;
+        var b = try cuda.DeviceBuffer.alloc(mk.d, n * 2);
+        errdefer b.free();
+        const piece = try mk.gpa.alloc(u16, @min(n, 32 << 20));
+        defer mk.gpa.free(piece);
+        var at: usize = 0;
+        while (at < n) : (at += piece.len) {
+            const len = @min(piece.len, n - at);
+            var i: usize = 0;
+            while (i < len) : (i += 4) {
+                var r = mk.rng.int(u64);
+                for (piece[i..@min(i + 4, len)]) |*v| {
+                    v.* = @as(u16, @truncate(r & 0x807f)) | ((127 - 6) << 7);
+                    r >>= 16;
+                }
+            }
+            try b.upload(at * 2, std.mem.sliceAsBytes(piece[0..len]));
+        }
+        return mk.keep(b);
+    }
+};
+
+const Pending = struct { layer: u32, experts: u32, ptrs: weights.TablePtrs };
+
+fn sign(r: std.Random, scale: f32) f32 {
+    return if (r.boolean()) scale else -scale;
+}
+
+fn uniform(r: std.Random, scale: f32) f32 {
+    return (r.float(f32) * 2 - 1) * scale;
+}
+
+fn around(r: std.Random, center: f32) f32 {
+    return center + (r.float(f32) * 2 - 1) * 0.05;
+}
+
+/// The lowest id of the largest logit.
+pub fn argmax(row: []const f32) u32 {
+    var best: usize = 0;
+    for (row, 0..) |v, i| {
+        if (v > row[best]) best = i;
+    }
+    return @intCast(best);
+}
+
+pub const Model = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    st: cuda.Stream,
+    o: Options,
+    cfg: Config,
+    geo: fw.Geometry,
+    mods: fw.Modules,
+    bufs: fw.Buffers,
+    f: fw.Forward,
+    w: weights.Weights,
+    owned: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    pool: Pool,
+    max_pages: u32,
+    plan: mm.rows_plan.Plan, // the block-score scratch bound (64 MiB) the forward's buffers are sized by
+    arena: cuda.DeviceBuffer,
+    mirror: rk.Mirror,
+    table: []i32, // host copy of the block tables: slot s's block b is page table[s * max_pages + b]
+    last: []f32, // the last prompt chunk's head row (own_vocab logits)
+    weight_bytes: u64 = 0,
+    chunks: u32 = 0, // prompt chunks run so far
+
+    /// The model, its pages (a seeded permutation of page ids over the slots) and the forward over them.
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, st: cuda.Stream, o: Options) !*Model {
+        const m = try gpa.create(Model);
+        errdefer gpa.destroy(m);
+        m.* = .{ .gpa = gpa, .d = d, .st = st, .o = o, .cfg = undefined, .geo = undefined, .mods = undefined, .bufs = undefined, .f = undefined, .w = undefined, .pool = undefined, .max_pages = 0, .plan = undefined, .arena = undefined, .mirror = undefined, .table = &.{}, .last = &.{} };
+        errdefer m.freeOwned();
+        m.cfg = try mm.config.parse(gpa, mm.config.fixture);
+        if (o.layers == 0 or o.layers > m.cfg.layers or o.slots == 0 or o.capacity_tokens == 0) return error.BadOptions;
+        if (o.first_moe) |first| {
+            m.cfg.moe = .empty;
+            for (first..m.cfg.layers) |l| m.cfg.moe.set(l);
+        }
+        const share = try mm.shard.Share.of(&m.cfg, 0, o.world);
+        m.geo = try fw.Geometry.of(&m.cfg, share, o.layers, iface.max_rows);
+        var prng = std.Random.DefaultPrng.init(o.seed);
+        const layers = try gpa.alloc(weights.Layer, o.layers);
+        errdefer gpa.free(layers);
+        try m.makeWeights(prng.random(), layers);
+        m.max_pages = @intCast(iface.maxPages(o.capacity_tokens));
+        try m.makePages(prng.random());
+        errdefer m.freePages();
+        m.mods = try fw.Modules.load(d);
+        errdefer m.mods.deinit();
+        m.plan = mm.rows_plan.Plan.of(m.geo.kvh, m.max_pages, o.score_mib);
+        m.bufs = try fw.Buffers.init(d, &m.geo, m.plan.scratch);
+        errdefer m.bufs.deinit();
+        const pages: fw.Pages = .{ .cache = .{ .pool = m.arena.ptr, .page_bytes = m.pool.pageBytes(), .layer_off = 0, .kvh = m.geo.kvh, .kv8 = o.kv8 }, .layer_bytes = m.pool.layerBytes(), .mirror = &m.mirror };
+        m.f = try fw.Forward.init(gpa, d, st, &m.mods, &m.w, &m.geo, &m.bufs, pages, null);
+        m.f.dev.solo = o.world > 1;
+        errdefer m.f.deinit(gpa);
+        m.last = try gpa.alloc(f32, m.geo.own_vocab);
+        return m;
+    }
+
+    fn makeWeights(m: *Model, rng: std.Random, layers: []weights.Layer) !void {
+        var tabs: std.ArrayList(Pending) = .empty;
+        defer tabs.deinit(m.gpa);
+        var mk: Maker = .{ .gpa = m.gpa, .d = m.d, .rng = rng, .owned = &m.owned, .wd = m.o.widths };
+        const g = &m.geo;
+        mk.noise = try mk.randomBytes(trellisBytes(g.hidden, g.own_vocab, m.o.widths.head) + (64 << 20));
+        _ = try mk.keep(mk.noise);
+        for (layers, 0..) |*ly, l| ly.* = try mk.layer(g, @intCast(l), &tabs);
+        m.w = .{ .embed = try mk.embed(m.cfg.vocab, g.hidden), .final_norm = try mk.norm(g.hidden), .head = try mk.matrix(g.hidden, g.own_vocab, m.o.widths.head), .layers = layers };
+        for (tabs.items) |t| {
+            const fake: weights.Tables = .{ .layer = @intCast(t.layer), .gate = &.{}, .up = &.{}, .down = &.{}, .gate_k2 = &.{}, .up_k2 = &.{}, .down_k2 = &.{} };
+            weights.attachTables(&m.w, fake, t.ptrs, .{});
+            if (m.o.prompt_experts) m.w.layers[t.layer].ffn.moe.prompt = .{ .gu = expert_k2, .down = expert_k2 };
+        }
+        for (m.owned.items) |b| m.weight_bytes += b.len;
+    }
+
+    fn makePages(m: *Model, rng: std.Random) !void {
+        m.pool = .{ .kvh = m.geo.kvh, .layers = m.o.layers, .kv8 = m.o.kv8 };
+        const n: usize = @as(usize, m.o.slots) * m.max_pages;
+        m.table = try m.gpa.alloc(i32, n);
+        errdefer m.gpa.free(m.table);
+        for (m.table, 0..) |*t, i| t.* = @intCast(i);
+        rng.shuffle(i32, m.table);
+        m.arena = try cuda.DeviceBuffer.alloc(m.d, n * m.pool.pageBytes());
+        errdefer m.arena.free();
+        try m.arena.fill8(0, null);
+        m.mirror = try rk.Mirror.init(m.d, m.o.slots, m.max_pages, iface.shared_rows);
+        errdefer m.mirror.deinit();
+        try m.mirror.putAll(m.table);
+    }
+
+    fn freePages(m: *Model) void {
+        m.mirror.deinit();
+        m.arena.free();
+        m.gpa.free(m.table);
+    }
+
+    fn freeOwned(m: *Model) void {
+        for (m.owned.items) |*b| b.free();
+        m.owned.deinit(m.gpa);
+    }
+
+    pub fn deinit(m: *Model) void {
+        m.st.synchronize() catch {};
+        m.gpa.free(m.last);
+        m.f.deinit(m.gpa);
+        m.bufs.deinit();
+        m.mods.deinit();
+        m.freePages();
+        m.gpa.free(m.w.layers);
+        m.freeOwned();
+        m.gpa.destroy(m);
+    }
+
+    /// The forward, for callers that drive `run` themselves (graph mode, timing loops).
+    pub fn fwd(m: *Model) *fw.Forward {
+        return &m.f;
+    }
+
+    pub fn geometry(m: *const Model) *const fw.Geometry {
+        return &m.geo;
+    }
+
+    /// Waits for the stream and refuses a call that found no page for a row.
+    pub fn settle(m: *Model) !void {
+        const s = try m.f.dev.status();
+        if (s != 0) {
+            std.debug.print("FAIL mm3.synth: page status 0x{x}\n", .{s});
+            return error.PageStatus;
+        }
+    }
+
+    /// `rows` head rows of `out` copied to the host, own_vocab logits each (caller frees).
+    fn rowsOf(m: *Model, out: fw.Out) ![]f32 {
+        const v: usize = m.geo.own_vocab;
+        const stride: usize = m.geo.slot;
+        const raw = try m.gpa.alloc(f32, out.rows * stride);
+        defer m.gpa.free(raw);
+        const src: cuda.DeviceBuffer = .{ .d = m.d, .ptr = m.f.address(out), .len = raw.len * 4, .borrowed = true };
+        try src.download(0, std.mem.sliceAsBytes(raw));
+        const rows = try m.gpa.alloc(f32, out.rows * v);
+        for (0..out.rows) |r| @memcpy(rows[r * v ..][0..v], raw[r * stride ..][0..v]);
+        return rows;
+    }
+
+    /// A prompt on `slot` in `chunk_rows`-row chunks (page multiple; 0: the plan's rows); the last row's token.
+    pub fn prefill(m: *Model, slot: u32, ids: []const i32, chunk_rows: u32) !u32 {
+        if (slot >= m.o.slots or ids.len == 0 or chunk_rows % 128 != 0 or chunk_rows > iface.prefill_rows) return error.BadOptions;
+        if (ids.len > @as(usize, m.max_pages) * 128) return error.BadOptions;
+        var at: usize = 0;
+        while (at < ids.len) {
+            const end = if (chunk_rows == 0) m.plan.chunkEnd(at, ids.len, null) else @min(ids.len, at + chunk_rows);
+            m.chunks += 1;
+            const last = end == ids.len;
+            if (!m.plan.fits(end - at, end - 1)) return error.BadOptions;
+            const out = try m.f.run(.{ .ids = ids[at..end], .slot = slot, .pos0 = @intCast(at), .prompt = true, .head = if (last) .last else .none });
+            try m.settle();
+            if (last) {
+                const row = try m.rowsOf(out);
+                defer m.gpa.free(row);
+                @memcpy(m.last, row);
+            }
+            at = end;
+        }
+        return argmax(m.last);
+    }
+
+    /// The last prompt chunk's head row, valid until the next `prefill`.
+    pub fn lastLogits(m: *const Model) []const f32 {
+        return m.last;
+    }
+
+    /// One stream's window: `ids` at positions pos .. pos + len - 1 of `slot`; every row's logits (caller frees).
+    pub fn decode(m: *Model, slot: u32, pos: u32, ids: []const i32) ![]f32 {
+        if (slot >= m.o.slots) return error.BadSlot;
+        const out = try m.f.run(.{ .ids = ids, .slot = slot, .pos0 = pos, .head = .all });
+        try m.settle();
+        return m.rowsOf(out);
+    }
+
+    /// Several streams' windows in one forward: rows in `segs` order, each at its own position (caller frees).
+    pub fn shared(m: *Model, segs: []const iface.Seg, ids: []const i32, positions: []const i32) ![]f32 {
+        for (segs) |s| if (s.slot >= m.o.slots) return error.BadSlot;
+        const out = try m.f.run(.{ .ids = ids, .segs = segs, .positions = positions, .head = .all });
+        try m.settle();
+        return m.rowsOf(out);
+    }
+
+    /// Bytes one token takes in kvBytes' copy (every layer: K and V rows, the index key, fp8's scales).
+    pub fn kvTokenBytes(m: *const Model) usize {
+        return m.pool.tokenBytes();
+    }
+
+    /// `slot`'s first `tokens` positions in logical order, per layer: K[h][t], V[h][t], IK[t], then kv8's Ks, Vs.
+    pub fn kvBytes(m: *Model, slot: u32, tokens: usize) ![]u8 {
+        if (slot >= m.o.slots or tokens > @as(usize, m.max_pages) * 128) return error.BadSlot;
+        try m.st.synchronize();
+        const all = try m.gpa.alloc(u8, m.arena.len);
+        defer m.gpa.free(all);
+        try m.arena.download(0, all);
+        const p = m.pool;
+        const out = try m.gpa.alloc(u8, tokens * p.tokenBytes());
+        const row = 128 * p.valueBytes();
+        const ik = 128 * 2;
+        var at: usize = 0;
+        const put = struct {
+            fn f(o: []u8, i: *usize, src: []const u8) void {
+                @memcpy(o[i.*..][0..src.len], src);
+                i.* += src.len;
+            }
+        }.f;
+        for (0..p.layers) |l| {
+            for (0..2) |which| for (0..p.kvh) |h| for (0..tokens) |t| {
+                const off = p.kv(m.page(slot, t), l, which, h, t % 128);
+                put(out, &at, all[off..][0..row]);
+            };
+            for (0..tokens) |t| put(out, &at, all[p.ik(m.page(slot, t), l, t % 128)..][0..ik]);
+            if (p.kv8) for (0..2) |which| for (0..p.kvh) |h| for (0..tokens) |t| {
+                put(out, &at, all[p.scale(m.page(slot, t), l, which, h, t % 128)..][0..4]);
+            };
+        }
+        std.debug.assert(at == out.len);
+        return out;
+    }
+
+    /// The page holding position `pos` of `slot`.
+    pub fn page(m: *const Model, slot: u32, pos: usize) usize {
+        return @intCast(m.table[@as(usize, slot) * m.max_pages + pos / 128]);
+    }
+};
diff --git a/zig/tests/cuda/mm3_synth_smoke.zig b/zig/tests/cuda/mm3_synth_smoke.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d68448197746e0b7f655e7b8dfdb9a77a6f83654
--- /dev/null
+++ b/zig/tests/cuda/mm3_synth_smoke.zig
@@ -0,0 +1,198 @@
+//! tf-cuda-test mm3-synth-smoke [LAYERS] [kv8] [moe=N]: the synthetic MiniMax-M3.1-Flash end to end on one GPU.
+const std = @import("std");
+const cuda = @import("cuda");
+const mm = @import("minimax_cuda");
+const check = @import("check.zig");
+const synth = @import("mm3_synth.zig");
+
+const prompt_len = 3000;
+const chunk_rows = 2048;
+const steps = 32;
+const window = 4; // the verify window re-runs the last `window` decode rows
+
+/// One greedy run on a slot: the prompt's token, then every decode row's logits and the token it picked.
+const Run = struct {
+    tokens: [steps + 1]u32, // tokens[0] from the prompt, tokens[i + 1] from decode row i
+    first: []const f32, // the prompt's last row
+    rows: []f32, // decode row i at [i * vocab ..]
+    prefill_ns: u64,
+    step_ns: [steps]u64,
+
+    fn deinit(r: *Run, gpa: std.mem.Allocator) void {
+        gpa.free(r.first);
+        gpa.free(r.rows);
+    }
+
+    fn row(r: *const Run, i: usize, v: usize) []const f32 {
+        return r.rows[i * v ..][0..v];
+    }
+};
+
+fn sequence(gpa: std.mem.Allocator, io: std.Io, m: *synth.Model, slot: u32, prompt: []const i32) !Run {
+    const v: usize = m.geometry().own_vocab;
+    var r: Run = .{ .tokens = undefined, .first = &.{}, .rows = try gpa.alloc(f32, steps * v), .prefill_ns = 0, .step_ns = undefined };
+    errdefer r.deinit(gpa);
+    const t0 = check.now(io);
+    r.tokens[0] = try m.prefill(slot, prompt, chunk_rows);
+    r.prefill_ns = @intCast(check.now(io) - t0);
+    r.first = try gpa.dupe(f32, m.lastLogits());
+    for (0..steps) |i| {
+        const id: i32 = @intCast(r.tokens[i]);
+        const s0 = check.now(io);
+        const out = try m.decode(slot, @intCast(prompt.len + i), &[_]i32{id});
+        defer gpa.free(out);
+        r.tokens[i + 1] = synth.argmax(out);
+        r.step_ns[i] = @intCast(check.now(io) - s0);
+        @memcpy(r.rows[i * v ..][0..v], out);
+    }
+    return r;
+}
+
+fn allFinite(xs: []const f32) ?usize {
+    for (xs, 0..) |x, i| if (!std.math.isFinite(x)) return i;
+    return null;
+}
+
+fn bytesOf(xs: []const f32) []const u8 {
+    return std.mem.sliceAsBytes(xs);
+}
+
+const Args = struct { layers: u32 = 1, kv8: bool = false, first_moe: ?u32 = null };
+
+fn parseArgs(rest: []const [:0]const u8) !Args {
+    var a: Args = .{};
+    for (rest, 0..) |s, i| {
+        if (std.mem.eql(u8, s, "kv8")) {
+            a.kv8 = true;
+        } else if (std.mem.startsWith(u8, s, "moe=")) {
+            a.first_moe = try std.fmt.parseInt(u32, s[4..], 10);
+        } else if (i == 0) {
+            a.layers = try std.fmt.parseInt(u32, s, 10);
+        } else return error.BadArgument;
+    }
+    return a;
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    const gpa = gpu.gpa;
+    const io = gpu.io;
+    const args = try parseArgs(rest);
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    const b0 = check.now(io);
+    const m = try synth.Model.init(gpa, gpu.d, stream, .{ .layers = args.layers, .slots = 2, .capacity_tokens = 4096, .kv8 = args.kv8, .first_moe = args.first_moe });
+    defer m.deinit();
+    const g = m.geometry();
+    var moe: u32 = 0;
+    for (0..g.layers) |l| moe += @intFromBool(g.isMoe(@intCast(l)));
+    std.debug.print("INFO mm3-synth: {d} layers ({d} routed), kv8 {}, {d:.2} GiB weights, built in {d:.1} s\n", .{ g.layers, moe, args.kv8, @as(f64, @floatFromInt(m.weight_bytes)) / (1 << 30), ms(@intCast(check.now(io) - b0)) / 1e3 });
+
+    var prng = std.Random.DefaultPrng.init(0x7072_6f6d);
+    var prompt: [prompt_len]i32 = undefined;
+    for (&prompt) |*p| p.* = @intCast(prng.random().uintLessThan(u32, m.cfg.vocab));
+    const v: usize = g.own_vocab;
+    var failed = false;
+
+    var a = try sequence(gpa, io, m, 0, &prompt);
+    defer a.deinit(gpa);
+    const bad = allFinite(a.first) orelse allFinite(a.rows);
+    if (bad) |i| {
+        std.debug.print("FAIL mm3.synth.finite: logit {d} is {e}\n", .{ i, if (allFinite(a.first) != null) a.first[i] else a.rows[i] });
+        failed = true;
+    } else check.pass("mm3.synth.finite prompt row and {d} decode rows", .{steps});
+    var sq: f64 = 0;
+    var top: f32 = 0;
+    for (a.rows) |x| {
+        sq += @as(f64, x) * x;
+        top = @max(top, @abs(x));
+    }
+    std.debug.print("INFO decode logits: rms {d:.3}, largest magnitude {d:.3}\n", .{ @sqrt(sq / @as(f64, @floatFromInt(a.rows.len))), top });
+
+    var b = try sequence(gpa, io, m, 1, &prompt);
+    defer b.deinit(gpa);
+    const total = prompt_len + steps;
+    const kv_a = try m.kvBytes(0, total);
+    defer gpa.free(kv_a);
+    if (slotsAgree(&a, &b) and kvAgree(m, kv_a, total)) check.pass("mm3.synth.slots: slot 1 (other pages) equals slot 0: tokens, logits and {d} KV bytes", .{kv_a.len}) else failed = true;
+
+    if (try verify(gpa, m, &a, v, kv_a, total)) check.pass("mm3.synth.verify: a {d}-row window equals its decode rows, KV unchanged", .{window}) else failed = true;
+    if (try sharedWindow(gpa, m, &a, v)) check.pass("mm3.synth.shared: two slots' windows in one forward equal their decode rows", .{}) else failed = true;
+
+    var sorted: [steps]f64 = undefined;
+    var sum: f64 = 0;
+    for (a.step_ns, &sorted) |t, *s| {
+        s.* = ms(t);
+        sum += s.*;
+    }
+    const pms = ms(a.prefill_ns);
+    std.debug.print("RESULT mm3-synth layers={d} routed={d} kv8={}: prefill {d} tokens in {d:.1} ms ({d:.0} tok/s), decode {d:.3} ms/step mean {d:.3} median ({d} steps, logits copy and host argmax included)\n", .{ g.layers, moe, args.kv8, prompt_len, pms, prompt_len / (pms / 1e3), sum / steps, check.median(&sorted), steps });
+    std.debug.print("INFO tokens {any}\n", .{a.tokens});
+    if (failed) return error.TestFailed;
+}
+
+fn ms(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e6;
+}
+
+fn slotsAgree(a: *const Run, b: *const Run) bool {
+    if (!std.mem.eql(u32, &a.tokens, &b.tokens)) {
+        std.debug.print("FAIL mm3.synth.slots tokens: {any} vs {any}\n", .{ a.tokens, b.tokens });
+        return false;
+    }
+    check.sameBytes("mm3.synth.slots prompt row", bytesOf(b.first), bytesOf(a.first)) catch return false;
+    check.sameBytes("mm3.synth.slots decode rows", bytesOf(b.rows), bytesOf(a.rows)) catch return false;
+    return true;
+}
+
+fn kvAgree(m: *synth.Model, kv_a: []const u8, total: usize) bool {
+    const kv_b = m.kvBytes(1, total) catch return false;
+    defer m.gpa.free(kv_b);
+    check.sameBytes("mm3.synth.slots kv", kv_b, kv_a) catch return false;
+    return true;
+}
+
+/// Decode rows steps - window .. steps - 1 again as one window on slot 0: the same logits and the same KV bytes.
+fn verify(gpa: std.mem.Allocator, m: *synth.Model, a: *const Run, v: usize, kv_a: []const u8, total: usize) !bool {
+    const first = steps - window;
+    var ids: [window]i32 = undefined;
+    for (&ids, a.tokens[first..steps]) |*d, t| d.* = @intCast(t);
+    const got = try m.decode(0, prompt_len + first, &ids);
+    defer gpa.free(got);
+    var ok = true;
+    for (0..window) |r| {
+        var id_buf: [64]u8 = undefined;
+        const id = std.fmt.bufPrint(&id_buf, "mm3.synth.verify row {d}", .{r}) catch unreachable;
+        check.sameBytes(id, bytesOf(got[r * v ..][0..v]), bytesOf(a.row(first + r, v))) catch {
+            ok = false;
+        };
+    }
+    const kv = try m.kvBytes(0, total);
+    defer gpa.free(kv);
+    check.sameBytes("mm3.synth.verify kv", kv, kv_a) catch {
+        ok = false;
+    };
+    return ok;
+}
+
+/// Slot 0 re-runs decode rows 28, 29 and slot 1 rows 30, 31 in one shared forward.
+fn sharedWindow(gpa: std.mem.Allocator, m: *synth.Model, a: *const Run, v: usize) !bool {
+    const first = steps - window;
+    const segs = [_]mm.iface.Seg{ .{ .slot = 0, .row0 = 0, .rows = 2 }, .{ .slot = 1, .row0 = 2, .rows = 2 } };
+    var ids: [window]i32 = undefined;
+    var pos: [window]i32 = undefined;
+    for (0..window) |r| {
+        ids[r] = @intCast(a.tokens[first + r]);
+        pos[r] = @intCast(prompt_len + first + r);
+    }
+    const got = try m.shared(&segs, &ids, &pos);
+    defer gpa.free(got);
+    var ok = true;
+    for (0..window) |r| {
+        var id_buf: [64]u8 = undefined;
+        const id = std.fmt.bufPrint(&id_buf, "mm3.synth.shared row {d}", .{r}) catch unreachable;
+        check.sameBytes(id, bytesOf(got[r * v ..][0..v]), bytesOf(a.row(first + r, v))) catch {
+            ok = false;
+        };
+    }
+    return ok;
+}
