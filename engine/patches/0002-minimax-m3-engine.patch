--- /dev/null
+++ b/zig/src/families/minimax_m3/dspark_knobs.zig
@@ -0,0 +1,31 @@
+//! The draft pass's speed switches, each off unless its variable is 1; the drafts stay the bits of the plain pass.
+const std = @import("std");
+
+pub const Knobs = struct {
+    batch: bool = false, // TF_MM3_DRAFT_BATCH: a round's streams in one pass (dspark_batch.zig)
+    topc: bool = false, // TF_MM3_DRAFT_TOPC: the head's top-C over slices of a row, then a merge
+    attn: bool = false, // TF_MM3_DRAFT_ATTN_SPLIT: a short ring's attention splits its queries over more CTAs
+
+    pub fn fromEnv() Knobs {
+        return .{ .batch = on("TF_MM3_DRAFT_BATCH"), .topc = on("TF_MM3_DRAFT_TOPC"), .attn = on("TF_MM3_DRAFT_ATTN_SPLIT") };
+    }
+};
+
+/// CTAs a split attention launch aims for: two per SM of a GB10 (48 SMs).
+pub const attn_ctas = 96;
+
+fn on(name: [*:0]const u8) bool {
+    return parse(if (std.c.getenv(name)) |v| std.mem.span(v) else null);
+}
+
+pub fn parse(v: ?[]const u8) bool {
+    return std.mem.eql(u8, std.mem.trim(u8, v orelse return false, " "), "1");
+}
+
+test "a switch is on only at 1" {
+    try std.testing.expect(!parse(null));
+    try std.testing.expect(!parse("0"));
+    try std.testing.expect(!parse("yes"));
+    try std.testing.expect(parse("1"));
+    try std.testing.expect(parse(" 1"));
+}
