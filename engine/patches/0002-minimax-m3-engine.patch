+"""Goldens for minimax_m3/vision/image.zig: the checkpoint's own processor on small synthetic pictures and prompts."""
+
+import argparse
+import hashlib
+import io
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image
+from torchvision.transforms import InterpolationMode
+from torchvision.transforms.v2 import functional as tvf
+
+SAMPLES = 128
+
+
+def smooth(w, h, seed, channels=3, noise=6.0):
+    """A deterministic picture with gradients, a checker and mild noise: small files that still exercise the filter."""
+    rng = np.random.default_rng(seed)
+    y, x = np.mgrid[0:h, 0:w].astype(np.float64)
+    planes = []
+    for c in range(channels):
+        f = 2 + c + seed % 5
+        v = 128 + 90 * np.sin(x / (w / f) + c) * np.cos(y / (h / (f + 1))) + 30 * (((x // 7) + (y // 5)) % 2)
+        planes.append(v + rng.normal(0, noise, size=(h, w)))
+    return np.clip(np.stack(planes, -1), 0, 255).astype(np.uint8)
+
+
+def encode(arr, fmt, **kw):
+    out = io.BytesIO()
+    mode = {3: "RGB", 4: "RGBA"}[arr.shape[-1]]
+    Image.fromarray(arr, mode).save(out, fmt, **kw)
+    return out.getvalue()
+
+
+def palette(w, h, seed):
+    """A palette PNG whose colour 0 is transparent through tRNS."""
+    img = Image.fromarray(smooth(w, h, seed)).quantize(colors=16)
+    out = io.BytesIO()
+    img.save(out, "PNG", transparency=0)
+    return out.getvalue()
+
+
+def alpha(w, h, seed):
+    arr = smooth(w, h, seed, channels=4)
+    arr[..., 3] = np.linspace(0, 255, w, dtype=np.uint8)[None, :]
+    return arr
+
+
+def fixtures():
+    """(name, bytes): sizes cover halves rounding to even, growth under min_pixels, shrinking past max_pixels."""
+    gray = Image.fromarray(smooth(64, 48, 9)[..., 0], "L")
+    g = io.BytesIO()
+    gray.save(g, "JPEG", quality=85)
+    return [
+        ("round_half.png", encode(smooth(98, 70, 1), "PNG")),
+        ("tiny_up.jpg", encode(smooth(30, 20, 2), "JPEG", quality=90)),
+        ("exact.png", encode(smooth(84, 56, 3), "PNG")),
+        ("odd_aspect.jpg", encode(smooth(900, 30, 4), "JPEG", quality=80)),
+        ("big_down.webp", encode(smooth(760, 600, 5, noise=0), "WEBP", quality=30)),
+        ("full.jpg", encode(smooth(672, 672, 6, noise=0), "JPEG", quality=35)),
+        ("alpha.png", encode(alpha(60, 50, 7), "PNG")),
+        ("palette.png", palette(90, 40, 8)),
+        ("lossless_alpha.webp", encode(alpha(47, 33, 10), "WEBP", lossless=True)),
+        ("gray.jpg", g.getvalue()),
+        ("too_wide.png", encode(smooth(402, 2, 11), "PNG")),
+    ]
+
+
+def photos():
+    """Larger pictures for the report (not committed): a photo-sized JPEG, a 1080p PNG and a tall WebP."""
+    return [
+        ("photo_800x600.jpg", encode(smooth(800, 600, 21), "JPEG", quality=90)),
+        ("photo_1920x1080.png", encode(smooth(1920, 1080, 22), "PNG")),
+        ("photo_500x2000.webp", encode(smooth(500, 2000, 23), "WEBP", quality=80)),
+        ("photo_4000x3000.jpg", encode(smooth(4000, 3000, 24), "JPEG", quality=85)),
+    ]
+
+
+def sha(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def case(proc, name, data):
+    """One picture through the processor, with the decode and the resize hashed apart so a difference is placed."""
+    rgb = Image.open(io.BytesIO(data)).convert("RGB")
+    entry = {"name": name, "width": rgb.width, "height": rgb.height, "rgb": sha(rgb.tobytes())}
+    try:
+        out = proc(images=[rgb], return_tensors="pt")
+    except ValueError as e:
+        entry["problem"] = str(e)
+        return entry
+    t, gh, gw = (int(v) for v in out["image_grid_thw"][0])
+    px = out["pixel_values"].to(torch.float32).contiguous()
+    resized = tvf.resize(tvf.pil_to_tensor(rgb), [gh * 14, gw * 14], interpolation=InterpolationMode.BICUBIC,
+                         antialias=True)
+    flat = px.numpy().astype("<f4").reshape(-1)
+    stride = max(1, flat.size // SAMPLES)
+    entry.update({"t": t, "gh": gh, "gw": gw, "tokens": gh * gw // 4, "rows": int(px.shape[0]),
+                  "width_f32": int(px.shape[1]), "resized": sha(resized.permute(1, 2, 0).contiguous().numpy().tobytes()),
+                  "pixels": sha(flat.tobytes()), "stride": stride,
+                  "samples": [float(str(v)) for v in flat[::stride][:SAMPLES]]})
+    return entry
+
+
+def requests(files):
+    """OpenAI chat messages holding the fixtures as data URLs: one picture, two, and one in a tool result."""
+    def img(name):
+        return {"type": "image_url", "image_url": {"url": "data:," + name}}
+    a, b = files[0][0], files[1][0]
+    text = {"type": "text", "text": "Describe the picture."}
+    call = {"id": "call_1", "type": "function", "function": {"name": "camera", "arguments": "{}"}}
+    tool = [{"role": "user", "content": "Take a photo."}, {"role": "assistant", "content": "", "tool_calls": [call]},
+            {"role": "tool", "tool_call_id": "call_1", "content": [img(b), {"type": "text", "text": "taken"}]},
+            {"role": "user", "content": [img(a), {"type": "text", "text": "Compare them."}]}]
+    return [[{"role": "user", "content": [img(a), text]}], [{"role": "user", "content": [img(a), img(b), text]}], tool]
+
+
+def for_template(messages):
+    """The messages as the template reads them: image parts as {"type": "image"}, tool arguments as objects."""
+    out = []
+    for m in messages:
+        m = dict(m)
+        if isinstance(m.get("content"), list):
+            m["content"] = [{"type": "image"} if p["type"] == "image_url" else p for p in m["content"]]
+        if "tool_calls" in m:
+            m["tool_calls"] = [{**c, "function": {**c["function"], "arguments": json.loads(c["function"]["arguments"])}}
+                               for c in m["tool_calls"]]
+        out.append(m)
+    return out
+
+
+def prompts(processor, files):
+    """Each request's prompt as the processor expands the template's image parts, as exact id lists."""
+    data = dict(files)
+    out = []
+    for messages in requests(files):
+        names = [p["image_url"]["url"][len("data:,"):] for m in messages if isinstance(m["content"], list)
+                 for p in m["content"] if p["type"] == "image_url"]
+        text = processor.tokenizer.apply_chat_template(for_template(messages), tokenize=False,
+                                                       add_generation_prompt=True)
+        images = [Image.open(io.BytesIO(data[n])).convert("RGB") for n in names]
+        ids = processor(text=[text], images=images, return_tensors="pt")["input_ids"][0].tolist()
+        out.append({"images": names, "messages": messages, "text": text, "input_ids": ids})
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--pack", required=True, help="checkpoint dir with image_processor.py and processing_minimax.py")
+    ap.add_argument("--out", required=True, help="directory for the pictures and golden.json")
+    ap.add_argument("--photos", action="store_true", help="the larger report pictures instead of the fixtures")
+    args = ap.parse_args()
+    torch.set_num_threads(4)
+    sys.path.insert(0, args.pack)
+    from transformers import AutoProcessor
+    processor = AutoProcessor.from_pretrained(args.pack, trust_remote_code=True)
+    proc = processor.image_processor
+    files = photos() if args.photos else fixtures()
+    out = Path(args.out)
+    out.mkdir(parents=True, exist_ok=True)
+    for name, data in files:
+        (out / name).write_bytes(data)
+    golden = {"processor": type(proc).__name__, "max_pixels": proc.max_pixels,
+              "cases": [case(proc, n, d) for n, d in files]}
+    if not args.photos:
+        golden["prompts"] = prompts(processor, files)
+    (out / "golden.json").write_text(json.dumps(golden, indent=1) + "\n")
+    for c in golden["cases"]:
+        print(c["name"], c["width"], c["height"], c.get("gh"), c.get("gw"), c.get("tokens"), c.get("problem", ""))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/zig/mm3_vision/hf_tower_ref.py b/tools/zig/mm3_vision/hf_tower_ref.py
new file mode 100644
index 0000000000000000000000000000000000000000..b3b641608776777e6d1a518ceeee3cc12706c5d9
--- /dev/null
+++ b/tools/zig/mm3_vision/hf_tower_ref.py
@@ -0,0 +1,201 @@
+"""MiniMax-M3.1-Flash vision tower parity: HF's tower and projector on the pack's weights, and our rows against them."""
+
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+
+SHARD = "model-00026-of-00026.safetensors"
+
+
+def mapped(name):
+    """A pack tensor's module ("tower" or "proj": the HF vision model or projector) and name there; else None."""
+    tower = "vision_tower.vision_model."
+    if name.startswith(tower):
+        rest = name[len(tower):]
+        rest = rest.replace("embeddings.patch_embedding.", "embeddings.proj.").replace("encoder.layers.", "layers.")
+        return "tower", rest
+    if name.startswith("multi_modal_projector."):
+        return "proj", name[len("multi_modal_projector."):]
+    if name.startswith("patch_merge_mlp."):
+        return "proj", name[len("patch_merge_mlp."):].replace("linear_", "merge_linear_")
+    return None
+
+
+def weights(pack):
+    """The pack's vision tensors as stored (bf16, the patch Conv3d f32), split per module."""
+    from safetensors import safe_open
+    out = {"tower": {}, "proj": {}}
+    with safe_open(str(Path(pack) / SHARD), framework="pt") as f:
+        for k in f.keys():
+            m = mapped(k)
+            if m:
+                out[m[0]][m[1]] = f.get_tensor(k)
+    return out
+
+
+def build(w, dtype, device, f32_conv=False):
+    """The modules as from_pretrained(dtype=...) makes them: parameters in `dtype`, the rotary's inv_freq in f32."""
+    from transformers.models.minimax_m3_vl import modeling_minimax_m3_vl as M
+    from transformers.models.minimax_m3_vl.configuration_minimax_m3_vl import MiniMaxM3VLVisionConfig
+    vc = MiniMaxM3VLVisionConfig(hidden_size=1280, intermediate_size=5120, num_hidden_layers=32, num_attention_heads=16,
+                                 patch_size=14, temporal_patch_size=2, spatial_merge_size=2, layer_norm_eps=1e-5,
+                                 rope_parameters={"rope_type": "axial", "rope_theta": 10000.0})
+    vc._attn_implementation = "sdpa"
+    pc = SimpleNamespace(text_config=SimpleNamespace(hidden_size=6144), vision_config=vc, projector_hidden_size=6144,
+                         merged_hidden_size=4 * 6144)
+    old = torch.get_default_dtype()
+    torch.set_default_dtype(dtype)
+    try:
+        tower = M.MiniMaxM3VLVisionModel(vc)
+        proj = M.MiniMaxM3VLMultiModalProjector(pc)
+    finally:
+        torch.set_default_dtype(old)
+    if f32_conv:
+        tower.embeddings.proj.float()
+    tower.load_state_dict(w["tower"], strict=True)
+    proj.load_state_dict(w["proj"], strict=True)
+    assert tower.rotary_emb.inv_freq.dtype == torch.float32
+    return tower.to(device).eval(), proj.to(device).eval()
+
+
+@torch.no_grad()
+def run(tower, proj, pixels, grid, device):
+    """One image alone (attention within it): the last hidden state [n, 1280] and the rows [n / 4, 6144] as f32."""
+    px = torch.from_numpy(pixels).to(device)
+    g = torch.tensor([grid], dtype=torch.long, device=device)
+    h = tower(pixel_values=px, grid_thw=g).last_hidden_state.squeeze(0)
+    rows = proj(h)
+    return h.float().cpu().numpy(), rows.float().cpu().numpy()
+
+
+def pictures(specs):
+    """NAME=PATH[:WxH] specs to (name, RGB picture), resized with PIL's LANCZOS first when a size is given."""
+    from PIL import Image
+    out = []
+    for spec in specs:
+        name, rest = spec.split("=", 1)
+        path, _, size = rest.partition(":")
+        img = Image.open(path).convert("RGB")
+        if size:
+            w, h = (int(v) for v in size.split("x"))
+            img = img.resize((w, h), Image.LANCZOS)
+        out.append((name, img))
+    return out
+
+
+def ref(args):
+    """The processor's pixels and grids, then HF bf16 on the GPU (and with an f32 Conv3d), then f32 on the CPU."""
+    torch.set_num_threads(args.threads)
+    sys.path.insert(0, args.pack)
+    from image_processor import MiniMaxM3VLImageProcessor
+    proc = MiniMaxM3VLImageProcessor.from_pretrained(args.pack)
+    out = Path(args.out)
+    out.mkdir(parents=True, exist_ok=True)
+    meta = {"images": []}
+    for name, img in pictures(args.image):
+        b = proc(images=[img], return_tensors="pt")
+        t, gh, gw = (int(v) for v in b["image_grid_thw"][0])
+        px = b["pixel_values"].to(torch.float32).contiguous().numpy()
+        np.save(out / f"{name}.pixels.npy", px)
+        meta["images"].append({"name": name, "width": img.width, "height": img.height, "t": t, "gh": gh, "gw": gw,
+                               "tokens": gh * gw // 4})
+        print(name, img.width, img.height, "grid", t, gh, gw, "tokens", gh * gw // 4, flush=True)
+    (out / "meta.json").write_text(json.dumps(meta, indent=1) + "\n")
+    w = weights(args.pack)
+    runs = [("hf16", torch.bfloat16, "cuda", False), ("hf16c", torch.bfloat16, "cuda", True),
+            ("hf32", torch.float32, "cpu", False)]
+    for tag, dtype, device, f32_conv in (r for r in runs if r[0] in args.runs.split(",")):
+        tower, proj = build(w, dtype, device, f32_conv)
+        for m in meta["images"]:
+            px = np.load(out / f"{m['name']}.pixels.npy")
+            t0 = time.perf_counter()
+            h, rows = run(tower, proj, px, (m["t"], m["gh"], m["gw"]), device)
+            if device == "cuda":
+                torch.cuda.synchronize()
+            m[f"{tag}_s"] = time.perf_counter() - t0
+            np.save(out / f"{m['name']}.{tag}_tower.npy", h)
+            np.save(out / f"{m['name']}.{tag}_rows.npy", rows)
+            print(tag, m["name"], f"{m[f'{tag}_s']:.2f} s", flush=True)
+        del tower, proj
+        if device == "cuda":
+            torch.cuda.empty_cache()
+    (out / "meta.json").write_text(json.dumps(meta, indent=1) + "\n")
+
+
+def stats(got, want):
+    """Cosine over all values, the worst row's cosine, and the largest absolute difference (float64)."""
+    g = got.astype(np.float64)
+    x = want.astype(np.float64)
+    cos = float((g * x).sum() / np.sqrt((g * g).sum() * (x * x).sum()))
+    rows = (g * x).sum(1) / np.sqrt((g * g).sum(1) * (x * x).sum(1))
+    return {"cos": cos, "worst_row_cos": float(rows.min()), "max_abs": float(np.abs(g - x).max()),
+            "ref_max_abs": float(np.abs(x).max())}
+
+
+def compare(args):
+    """Ours against HF bf16 (at --min-cos) and f32 (within --f32-slack of HF bf16's own distance), tower and rows."""
+    case, ours = Path(args.case), Path(args.ours)
+    meta = json.loads((case / "meta.json").read_text())
+    timing = json.loads((ours / "ours.json").read_text())
+    results = {"ours": timing, "images": []}
+    ok = True
+    print(f"{'image':10} {'size':>10} {'grid':>7} {'tok':>4} | {'what':5} {'vs':14} {'cos':>9} {'worst row':>9} "
+          f"{'max abs':>8} {'|ref| max':>9}")
+    for m in meta["images"]:
+        n = m["name"]
+        entry = dict(m)
+        for what in ("tower", "rows"):
+            pairs = (("ours-hf_bf16", ours / f"{n}.{what}.npy", case / f"{n}.hf16_{what}.npy"),
+                     ("ours-hf_bf16c", ours / f"{n}.{what}.npy", case / f"{n}.hf16c_{what}.npy"),
+                     ("ours-hf_f32", ours / f"{n}.{what}.npy", case / f"{n}.hf32_{what}.npy"),
+                     ("hf_bf16-hf_f32", case / f"{n}.hf16_{what}.npy", case / f"{n}.hf32_{what}.npy"))
+            for label, got, want in pairs:
+                s = stats(np.load(got), np.load(want))
+                entry[f"{what}:{label}"] = s
+                if label == "ours-hf_bf16" and s["cos"] < args.min_cos:
+                    ok = False
+            if entry[f"{what}:ours-hf_f32"]["cos"] < entry[f"{what}:hf_bf16-hf_f32"]["cos"] - args.f32_slack:
+                ok = False
+                print(f"{n:10} {m['width']:>4}x{m['height']:<5} {m['gh']:>3}x{m['gw']:<3} {m['tokens']:>4} | {what:5} "
+                      f"{label:14} {s['cos']:.6f} {s['worst_row_cos']:.6f} {s['max_abs']:8.4f} {s['ref_max_abs']:9.3f}")
+        results["images"].append(entry)
+    results["pass"] = ok
+    results["min_cos"] = args.min_cos
+    results["f32_slack"] = args.f32_slack
+    Path(args.json).write_text(json.dumps(results, indent=1) + "\n")
+    print("PASS" if ok else "FAIL", f"every image: cos vs HF bf16 >= {args.min_cos}, vs f32 within {args.f32_slack} of HF "
+          "bf16's own")
+    return 0 if ok else 1
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    r = sub.add_parser("ref", help="processor pixels and HF references")
+    r.add_argument("--pack", required=True, help="the checkpoint dir (image_processor.py and the vision shard)")
+    r.add_argument("--out", required=True, help="the case directory to write")
+    r.add_argument("--image", action="append", required=True, help="NAME=PATH[:WxH], repeated")
+    r.add_argument("--threads", type=int, default=16, help="CPU threads for the f32 run")
+    r.add_argument("--runs", default="hf16,hf16c,hf32", help="which references: hf16 (bf16 GPU, as from_pretrained "
+                   "makes it), hf16c (the same with an f32 Conv3d), hf32 (f32 CPU)")
+    c = sub.add_parser("compare", help="our rows (tf-mm3-vision-parity's out dir) against the references")
+    c.add_argument("--case", required=True)
+    c.add_argument("--ours", required=True)
+    c.add_argument("--json", required=True, help="the small results file to keep")
+    c.add_argument("--min-cos", type=float, default=0.999)
+    c.add_argument("--f32-slack", type=float, default=0.001, help="how much further from f32 than HF bf16 ours may be")
+    args = ap.parse_args()
+    if args.cmd == "ref":
+        ref(args)
+        return 0
+    return compare(args)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
