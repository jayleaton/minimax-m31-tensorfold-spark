diff --git a/zig/src/families/minimax_m3/draw_mass.zig b/zig/src/families/minimax_m3/draw_mass.zig
new file mode 100644
index 0000000000000000000000000000000000000000..22d6457d9435185be8514b04cad0c13117da4014
--- /dev/null
+++ b/zig/src/families/minimax_m3/draw_mass.zig
@@ -0,0 +1,99 @@
+//! Bounds on a sampled row's whole-vocabulary normalizer from binned scaled logits, so top-p needs no exp per column.
+const std = @import("std");
+const Cand = @import("lanes").gpu_rule.Cand;
+
+/// Bins per unit of x = v - m below 0; x under -`span` (exp underflows f32) shares the last bin.
+const per = 64;
+const span = 104;
+const bins = per * span;
+
+/// The row's columns outside the candidates: a count and an f64 sum of x per bin of width 1 / `per`.
+pub const Tail = struct {
+    count: []u32,
+    sum: []f64,
+    edge: []f64, // edge[b] = exp(-b / per)
+
+    pub fn init(gpa: std.mem.Allocator) !Tail {
+        const count = try gpa.alloc(u32, bins + 1);
+        errdefer gpa.free(count);
+        const sum = try gpa.alloc(f64, bins + 1);
+        errdefer gpa.free(sum);
+        const edge = try gpa.alloc(f64, bins + 1);
+        for (edge, 0..) |*e, b| e.* = @exp(-@as(f64, @floatFromInt(b)) / per);
+        return .{ .count = count, .sum = sum, .edge = edge };
+    }
+
+    pub fn deinit(t: *Tail, gpa: std.mem.Allocator) void {
+        gpa.free(t.count);
+        gpa.free(t.sum);
+        gpa.free(t.edge);
+    }
+
+    pub fn reset(t: *Tail) void {
+        @memset(t.count, 0);
+        @memset(t.sum, 0);
+    }
+
+    /// One column with x = v - m <= 0 (f32, the value the full normalizer exponentiates); -inf is a masked column.
+    pub inline fn add(t: *Tail, x: f32) void {
+        const y = -x * per; // exact: a power-of-two scale, so x lies in (-(b + 1) / per, -b / per]
+        const b: usize = if (y < bins) @intFromFloat(@floor(y)) else bins;
+        t.count[b] += 1;
+        if (b < bins) t.sum[b] += x;
+    }
+
+    /// [lo, hi] holding gpu_rule's f32 lane sum of exp(x) over the candidates `all` and these columns, of `len` in all.
+    pub fn bounds(t: *const Tail, all: []const Cand, m: f32, len: usize) [2]f32 {
+        var exact: f64 = 0.0;
+        for (all) |c| exact += @exp(@as(f64, c.v - m));
+        var lo = exact;
+        var hi = exact;
+        for (0..bins) |b| {
+            if (t.count[b] == 0) continue;
+            const k: f64 = @floatFromInt(t.count[b]);
+            const a = -@as(f64, @floatFromInt(b + 1)) / per;
+            lo += k * @exp(t.sum[b] / k); // Jensen: the mean of exp is at least exp of the mean
+            hi += k * t.edge[b + 1] + (t.sum[b] - k * a) * (t.edge[b] - t.edge[b + 1]) * per; // the chord over the bin
+        }
+        hi += @as(f64, @floatFromInt(t.count[bins])) * t.edge[bins];
+        // each f32 exp within 2 ulp, each term through at most `chain` f32 adds (lanes, butterfly, groups), f64 slack
+        const chain: f64 = @floatFromInt(len / 1024 + 1 + 5 + 32);
+        const eps = 0x1p-22 + 1.01 * chain * 0x1p-24 + 1e-8;
+        const lo32: f32 = @floatCast(lo * (1.0 - eps));
+        const hi32: f32 = @floatCast(hi * (1.0 + eps));
+        return .{ std.math.nextAfter(f32, lo32, 0.0), std.math.nextAfter(f32, hi32, std.math.inf(f32)) };
+    }
+};
+
+test "the bounds hold the lane core's f32 normalizer over skewed, flat, tied and masked rows" {
+    const gpa = std.testing.allocator;
+    const gpu_rule = @import("lanes").gpu_rule;
+    var t = try Tail.init(gpa);
+    defer t.deinit(gpa);
+    var prng = std.Random.DefaultPrng.init(11);
+    const r = prng.random();
+    const row = try gpa.alloc(f32, 50_000);
+    defer gpa.free(row);
+    for (0..24) |case| {
+        const scale: f32 = switch (case % 4) {
+            0 => 0.05, // nearly flat: most mass in the tail
+            1 => 2.0,
+            2 => 8.0, // a few columns hold the mass
+            else => 0.0, // every column ties
+        };
+        for (row, 0..) |*v, i| v.* = if (case % 3 == 0 and i % 7 != 0) -std.math.inf(f32) else r.floatNorm(f32) * scale;
+        var m = -std.math.inf(f32);
+        for (row) |v| m = @max(m, v);
+        var lanes: [1024]f32 = @splat(0.0);
+        for (row, 0..) |v, i| lanes[i % 1024] += @exp(v - m);
+        const z = gpu_rule.lanesSum(&lanes);
+        // the first 300 columns stand in for the candidates, the rest go to the bins
+        var cands: [300]Cand = undefined;
+        for (&cands, 0..) |*c, i| c.* = .{ .v = row[i], .i = @intCast(i) };
+        t.reset();
+        for (row[300..]) |v| t.add(v - m);
+        const b = t.bounds(&cands, m, row.len);
+        try std.testing.expect(b[0] <= z and z <= b[1]);
+        try std.testing.expect(b[1] - b[0] <= z * 1e-3); // tight enough to decide most cutoffs
+    }
+}
