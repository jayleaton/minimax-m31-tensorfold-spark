index 0000000000000000000000000000000000000000..8b39ed437b57cf588a90b019463010f21b916c42
--- /dev/null
+++ b/zig/src/families/minimax_m3/vision/engine_images_test.zig
@@ -0,0 +1,136 @@
+//! Image prompts on the fake ranks: both hold a pass's spans, rows go at its end, the cache tells images apart.
+const std = @import("std");
+const lanes = @import("lanes");
+const ops = @import("../engine_ops.zig");
+const fakes = @import("../engine_fake.zig");
+
+const gpa = std.testing.allocator;
+
+/// A rank's image rows as a recorder: the spans' words it held last, the images it was handed, whether it holds any.
+const Held = struct {
+    words: std.ArrayList(u32) = .empty,
+    passes: u32 = 0,
+    encoded: std.ArrayList(u32) = .empty, // rank 0: the image index of each span it encoded
+    live: bool = false,
+
+    fn images(h: *Held) ops.Images {
+        return .{ .ptr = h, .vtable = &.{ .hold = hold, .drop = drop, .holds = holds } };
+    }
+
+    fn deinit(h: *Held) void {
+        h.words.deinit(gpa);
+        h.encoded.deinit(gpa);
+    }
+
+    fn of(p: *anyopaque) *Held {
+        return @ptrCast(@alignCast(p));
+    }
+
+    fn hold(p: *anyopaque, _: u32, words: []const u32, imgs: []const ops.Image, index: []const u32) anyerror!void {
+        const h = of(p);
+        h.passes += 1;
+        h.words.clearRetainingCapacity();
+        try h.words.appendSlice(gpa, words);
+        for (index) |i| if (i >= imgs.len) return error.ImageSpans;
+        try h.encoded.appendSlice(gpa, index);
+        h.live = true;
+    }
+
+    fn drop(p: *anyopaque, _: u32) void {
+        of(p).live = false;
+    }
+
+    fn holds(p: *anyopaque, _: u32) bool {
+        return of(p).live;
+    }
+};
+
+fn tokens(n: usize, salt: u32) ![]u32 {
+    const p = try gpa.alloc(u32, n);
+    for (p, 0..) |*t, i| t.* = @intCast((i * 7 + salt) % 90);
+    return p;
+}
+
+/// `prompt`'s cache key with rows [at, at + n) of each image named by `id` (as the server's image_key writes them).
+fn keyed(prompt: []const u32, images: []const ops.Image, id: u32) ![]u32 {
+    const k = try gpa.dupe(u32, prompt);
+    for (images) |img| for (k[img.at..][0..img.tokens], 0..) |*w, j| {
+        w.* = 0x8000_0000 | (id *% 2654435761 +% @as(u32, @intCast(j)));
+    };
+    return k;
+}
+
+/// One stream's prompt pass and release on `w`; returns the rows it resumed from the cache.
+fn pass(w: *fakes.World, prompt: []const u32, images: []const ops.Image, key: []const u32) !u32 {
+    var s = try lanes.Stream.init(gpa, .{ .id = "i", .prompt = prompt, .max_new = 8, .images = images, .key = key, .history_len = @intCast(prompt.len) });
+    defer s.deinit(gpa);
+    const b = w.lanes.backend();
+    try b.prefill(&s);
+    b.release(&s);
+    return s.cached;
+}
+
+test "an image prompt's rows: rank 0 encodes, the follower hears the same spans, both drop them at the pass's end" {
+    const w = try fakes.World.create(gpa, 6000, 1, 60);
+    defer w.destroy();
+    var h0: Held = .{};
+    defer h0.deinit();
+    var h1: Held = .{};
+    defer h1.deinit();
+    w.e0.p.images = h0.images();
+    w.e1.p.images = h1.images();
+    const prompt = try tokens(1500, 3);
+    defer gpa.free(prompt);
+    const imgs = [_]ops.Image{
+        .{ .pixels = &.{}, .gh = 32, .gw = 32, .at = 100, .tokens = 256 },
+        .{ .pixels = &.{}, .gh = 16, .gw = 16, .at = 1100, .tokens = 64 },
+    };
+    const key = try keyed(prompt, &imgs, 1);
+    defer gpa.free(key);
+    try std.testing.expectEqual(@as(u32, 0), try pass(w, prompt, &imgs, key));
+    try std.testing.expectEqual(@as(u32, 1), h0.passes);
+    try std.testing.expectEqualSlices(u32, &.{ 100, 256, 0, 1100, 64, 256 }, h0.words.items);
+    try std.testing.expectEqualSlices(u32, &.{ 0, 1 }, h0.encoded.items);
+    try std.testing.expect(!h0.live); // the last chunk's draw ended the pass
+    try w.replay();
+    try std.testing.expectEqual(@as(u32, 1), h1.passes);
+    try std.testing.expectEqualSlices(u32, h0.words.items, h1.words.items);
+    try std.testing.expectEqual(@as(usize, 0), h1.encoded.items.len); // the follower encodes nothing: it receives
+    try std.testing.expect(!h1.live);
+}
+
+test "the prompt cache keys image rows by image: the same placeholders with another image start over" {
+    const w = try fakes.World.create(gpa, 6000, 1, 120);
+    defer w.destroy();
+    w.pg.limit(80, 8);
+    var h0: Held = .{};
+    defer h0.deinit();
+    var h1: Held = .{};
+    defer h1.deinit();
+    w.e0.p.images = h0.images();
+    w.e1.p.images = h1.images();
+    const prompt = try tokens(2700, 5);
+    defer gpa.free(prompt);
+    const imgs = [_]ops.Image{.{ .pixels = &.{}, .gh = 32, .gw = 32, .at = 40, .tokens = 256 }};
+    const first = try keyed(prompt, &imgs, 1);
+    defer gpa.free(first);
+    const other = try keyed(prompt, &imgs, 2);
+    defer gpa.free(other);
+    try std.testing.expectEqual(@as(u32, 0), try pass(w, prompt, &imgs, first));
+    try std.testing.expectEqual(@as(u32, 0), try pass(w, prompt, &imgs, other)); // ids alike, image not: no resume
+    const again = try pass(w, prompt, &imgs, first); // the first image again: its kept prefix, image rows included
+    try std.testing.expect(again > imgs[0].at + imgs[0].tokens);
+    try std.testing.expectEqual(@as(u32, 2), h0.passes); // the resumed pass is past the image: no rows to hold
+}
+
+test "without --vision an image prompt is refused before any rank hears of it" {
+    const w = try fakes.World.create(gpa, 6000, 1, 60);
+    defer w.destroy();
+    const sent = w.tape.steps.items.len;
+    const prompt = try tokens(500, 2);
+    defer gpa.free(prompt);
+    var s = try lanes.Stream.init(gpa, .{ .id = "v", .prompt = prompt, .max_new = 8, .images = &.{.{ .pixels = &.{}, .gh = 2, .gw = 2, .at = 10, .tokens = 1 }} });
+    defer s.deinit(gpa);
+    try std.testing.expectError(error.VisionUnsupported, w.lanes.backend().prefill(&s));
+    try std.testing.expectEqual(sent, w.tape.steps.items.len);
+}
