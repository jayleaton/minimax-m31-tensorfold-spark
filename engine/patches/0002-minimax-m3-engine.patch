diff --git a/zig/tests/mm3_vision_parity_main.zig b/zig/tests/mm3_vision_parity_main.zig
new file mode 100644
index 0000000000000000000000000000000000000000..297e906c7760034d78c4c9d7a3cb17d737ac262b
--- /dev/null
+++ b/zig/tests/mm3_vision_parity_main.zig
@@ -0,0 +1,211 @@
+//! `tf-mm3-vision-parity <model> <case> <out> [reps]`: the MiniMax-M3.1-Flash tower's rows for HF to compare.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const lanes = @import("lanes");
+const mm3 = @import("mm3_tower");
+const Tower = mm3.Tower;
+const rope = mm3.rotary;
+
+const usage =
+    \\usage: tf-mm3-vision-parity <model dir> <case dir> <out dir> [reps]
+    \\<case dir>/meta.json lists {"images": [{"name", "gh", "gw"}]}, each with NAME.pixels.npy (f32 [gh*gw, 1176],
+    \\merge order, the pack's processor). <out dir> gets NAME.tower.npy (the last hidden state [n, 1280]) and
+    \\NAME.rows.npy (the projector's rows [n/4, 6144]), bf16 widened to f32, and ours.json: device bytes, the
+    \\median of <reps> (default 5) timed passes an image, and whether a second pass gave the same bits.
+    \\tf_vit_rope is first checked bit for bit against its host twin on a synthetic 6 x 10 grid, and the tower warmed;
+    \\last, two images' rows are held as one slot's pass and spliced into a prompt's embedded rows chunk by chunk.
+    \\
+;
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(a);
+    if (args.len != 4 and args.len != 5) {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    }
+    const reps = if (args.len == 5) try std.fmt.parseInt(usize, args[4], 10) else 5;
+    const model = args[1];
+    const cwd = std.Io.Dir.cwd();
+    const config_text = try cwd.readFileAlloc(io, try std.fs.path.join(a, &.{ model, "config.json" }), a, .limited(1 << 24));
+    const pre_text = try cwd.readFileAlloc(io, try std.fs.path.join(a, &.{ model, "preprocessor_config.json" }), a, .limited(1 << 20));
+    const c = (try mm3.config.parse(a, config_text, pre_text)) orelse return error.NoVisionTower;
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var s = try cuda.Stream.init(ctx.d, true);
+    defer s.deinit();
+    const free0 = (try ctx.memInfo()).free;
+    const t0 = std.Io.Clock.awake.now(io);
+    var tower = try Tower.init(init.gpa, io, ctx.d, model, c);
+    defer tower.deinit();
+    const load_s = seconds(io, t0);
+    const free1 = (try ctx.memInfo()).free;
+    const weights = tower.w.bytes;
+    const scratch = tower.scratch.len;
+    std.debug.print("loaded in {d:.1} s: weights {d} B, scratch {d} B, workspace {d} B, Tower.bytes {d} B, plannedBytes {d} B, cuMemGetInfo drop {d} B\n", .{ load_s, weights, scratch, tower.g.workspace.len, tower.bytes, Tower.plannedBytes(c), free0 -| free1 });
+    if (tower.bytes != Tower.plannedBytes(c)) return fail("Tower.bytes differs from plannedBytes", .{});
+    try ropeCheck(a, &tower, s);
+    const free2 = (try ctx.memInfo()).free;
+    try tower.warm(ctx.d, s);
+    const warm_drop = free2 -| (try ctx.memInfo()).free;
+    std.debug.print("warm: cuMemGetInfo drop {d} B (first_call_bytes {d} B)\n", .{ warm_drop, mm3.first_call_bytes });
+    if (warm_drop > mm3.first_call_bytes) return fail("the first call took more than first_call_bytes", .{});
+    var out_buf = try cuda.DeviceBuffer.alloc(ctx.d, @as(usize, c.maxPatches() / 4) * c.text_hidden * 2);
+    defer out_buf.free();
+    const case = args[2];
+    const out = args[3];
+    const meta_text = try cwd.readFileAlloc(io, try std.fs.path.join(a, &.{ case, "meta.json" }), a, .limited(1 << 20));
+    const meta = try std.json.parseFromSliceLeaky(std.json.Value, a, meta_text, .{});
+    var json: std.ArrayList(u8) = .empty;
+    try json.print(a, "{{\"weights_bytes\": {d}, \"scratch_bytes\": {d}, \"workspace_bytes\": {d}, \"tower_bytes\": {d}, \"planned_bytes\": {d}, \"load_meminfo_drop\": {d}, \"load_s\": {d:.2}, \"images\": [", .{ weights, scratch, tower.g.workspace.len, tower.bytes, Tower.plannedBytes(c), free0 -| free1, load_s });
+    var worst_drop: u64 = 0;
+    var held: [2]lanes.stream.Image = undefined;
+    var kept: [2][]u16 = undefined;
+    for (meta.object.get("images").?.array.items, 0..) |m, idx| {
+        const name = m.object.get("name").?.string;
+        const gh: u32 = @intCast(m.object.get("gh").?.integer);
+        const gw: u32 = @intCast(m.object.get("gw").?.integer);
+        const n = @as(usize, gh) * gw;
+        const raw = try cwd.readFileAlloc(io, try std.fmt.allocPrint(a, "{s}/{s}.pixels.npy", .{ case, name }), a, .limited(1 << 30));
+        const arr = try core.npy.parse(raw);
+        if (!std.mem.eql(u8, arr.descr, "<f4") or arr.count() != n * c.patchWidth()) return fail("{s}: pixels {s} x {d}", .{ name, arr.descr, arr.count() });
+        const pixels = try a.alloc(f32, arr.count());
+        @memcpy(std.mem.sliceAsBytes(pixels), arr.data);
+        const img: lanes.stream.Image = .{ .pixels = pixels, .gh = gh, .gw = gw, .at = 0, .tokens = @intCast(n / 4) };
+        const before = (try ctx.memInfo()).free;
+        const feats = try tower.features(s, img);
+        const hidden = try back(a, s, feats, n * c.hidden);
+        try tower.project(s, feats, n, out_buf.ptr);
+        const rows = try back(a, s, out_buf.ptr, n / 4 * c.text_hidden);
+        const drop = before -| (try ctx.memInfo()).free;
+        worst_drop = @max(worst_drop, drop);
+        const times = try a.alloc(f64, reps);
+        for (times) |*t| {
+            const t1 = std.Io.Clock.awake.now(io);
+            try tower.picture(s, img, out_buf.ptr);
+            try s.synchronize();
+            t.* = seconds(io, t1) * 1e3;
+        }
+        const again = try back(a, s, out_buf.ptr, n / 4 * c.text_hidden);
+        const same = std.mem.eql(u16, rows, again);
+        std.mem.sort(f64, times, {}, std.sort.asc(f64));
+        const ms = times[times.len / 2];
+        try writeNpy(io, a, out, name, "tower", hidden, n, c.hidden);
+        try writeNpy(io, a, out, name, "rows", rows, n / 4, c.text_hidden);
+        std.debug.print("{s}: grid {d} x {d}, {d} tokens, {d:.2} ms (median of {d}), repeat bit-equal {}, cuMemGetInfo drop {d} B\n", .{ name, gh, gw, n / 4, ms, reps, same, drop });
+        try json.print(a, "{s}{{\"name\": \"{s}\", \"gh\": {d}, \"gw\": {d}, \"tokens\": {d}, \"ms\": {d:.3}, \"repeat_equal\": {}, \"meminfo_drop\": {d}}}", .{ if (idx > 0) ", " else "", name, gh, gw, n / 4, ms, same, drop });
+        if (!same) return fail("{s}: a second pass changed the rows", .{name});
+        if (idx < 2) {
+            held[idx] = img;
+            kept[idx] = rows;
+        }
+    }
+    if (try spliceCheck(a, init.gpa, ctx.d, s, &tower, held, kept) != 0) return 1;
+    try json.print(a, "], \"worst_image_meminfo_drop\": {d}, \"allocator_peak\": {d}}}\n", .{ worst_drop, cuda.usage(false).peak });
+    try cwd.writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "{s}/ours.json", .{out}), .data = json.items });
+    return 0;
+}
+
+/// Two images held as one slot's pass at prompt rows 10 and 700, spliced into embedded rows in chunks of 512.
+fn spliceCheck(a: std.mem.Allocator, gpa: std.mem.Allocator, d: *const cuda.Driver, s: cuda.Stream, t: *Tower, imgs: [2]lanes.stream.Image, want: [2][]u16) !u8 {
+    const P = mm3.passes;
+    const w = t.c.text_hidden;
+    var ps: P.Passes = .{ .gpa = gpa, .d = d, .hidden = w, .limit = imgs[0].tokens + imgs[1].tokens };
+    defer ps.deinit();
+    var placed = imgs;
+    placed[0].at = 10;
+    placed[1].at = 700;
+    var index: [2]u32 = undefined;
+    const spans = try P.plan(gpa, &placed, 0, &index);
+    const pass = try ps.open(3, spans);
+    for (pass.spans, index) |sp, i| try t.picture(s, placed[i], pass.at(sp, w));
+    const n: usize = 700 + imgs[1].tokens + 20;
+    var emb = try cuda.DeviceBuffer.alloc(d, n * w * 2);
+    defer emb.free();
+    try d.check(d.api.cuMemsetD8Async(emb.ptr, 0, n * w * 2, s.handle), "cuMemsetD8Async");
+    var lo: usize = 0;
+    while (lo < n) : (lo += 512) {
+        const hi = @min(n, lo + 512);
+        try ps.splice(s, 3, lo, hi, emb.ptr + lo * w * 2);
+        try ps.splice(s, 4, lo, hi, emb.ptr + lo * w * 2); // another slot holds nothing: no rows
+    }
+    const got = try back(a, s, emb.ptr, n * w);
+    for (0..n) |r| {
+        const row = got[r * w ..][0..w];
+        const src: ?[]const u16 = for (placed, want) |im, rows| {
+            if (r >= im.at and r < im.at + im.tokens) break rows[(r - im.at) * w ..][0..w];
+        } else null;
+        if (src) |x| {
+            if (!std.mem.eql(u16, row, x)) return fail("splice: prompt row {d} is not its image row", .{r});
+        } else if (std.mem.indexOfNone(u16, row, &.{0}) != null) return fail("splice: text row {d} was written", .{r});
+    }
+    ps.drop(3);
+    if (ps.holds(3)) return fail("splice: the dropped pass is still held", .{});
+    std.debug.print("PASS splice: {d} + {d} image rows at 10 and 700 of {d}, chunks of 512, bit for bit; text rows untouched\n", .{ imgs[0].tokens, imgs[1].tokens, n });
+    return 0;
+}
+
+fn fail(comptime fmt: []const u8, args: anytype) u8 {
+    std.debug.print("FAIL " ++ fmt ++ "\n", args);
+    return 1;
+}
+
+fn seconds(io: std.Io, t0: std.Io.Timestamp) f64 {
+    return @as(f64, @floatFromInt(t0.durationTo(std.Io.Clock.awake.now(io)).toNanoseconds())) / 1e9;
+}
+
+/// bf16 values at a device address, after the stream's work.
+fn back(a: std.mem.Allocator, s: cuda.Stream, at: u64, len: usize) ![]u16 {
+    try s.synchronize();
+    const raw = try a.alloc(u16, len);
+    try s.d.check(s.d.api.cuMemcpyDtoH_v2(raw.ptr, at, 2 * len), "cuMemcpyDtoH");
+    return raw;
+}
+
+/// `<out>/<name>.<what>.npy`: bf16 rows widened to f32 [rows, cols].
+fn writeNpy(io: std.Io, a: std.mem.Allocator, out: []const u8, name: []const u8, what: []const u8, v: []const u16, rows: usize, cols: usize) !void {
+    const dict = try std.fmt.allocPrint(a, "{{'descr': '<f4', 'fortran_order': False, 'shape': ({d}, {d}), }}", .{ rows, cols });
+    const hl = std.mem.alignForward(usize, 10 + dict.len + 1, 64) - 10; // the header text, padded, ending in a newline
+    const body = try a.alloc(u8, 10 + hl + 4 * v.len);
+    @memcpy(body[0..8], "\x93NUMPY\x01\x00");
+    std.mem.writeInt(u16, body[8..10], @intCast(hl), .little);
+    @memset(body[10 .. 10 + hl], ' ');
+    @memcpy(body[10..][0..dict.len], dict);
+    body[10 + hl - 1] = '\n';
+    const data = body[10 + hl ..];
+    for (v, 0..) |x, i| std.mem.writeInt(u32, data[4 * i ..][0..4], @as(u32, x) << 16, .little);
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "{s}/{s}.{s}.npy", .{ out, name, what }), .data = body });
+}
+
+/// tf_vit_rope on random bf16 rows of a 6 x 10 grid's real table against rope.apply, bit for bit.
+fn ropeCheck(a: std.mem.Allocator, t: *Tower, s: cuda.Stream) !void {
+    const c = t.c;
+    const gh = 6;
+    const gw = 10;
+    const n = gh * gw;
+    const dim: usize = c.headDim();
+    const hf = rope.half(dim);
+    const width = 3 * @as(usize, c.hidden);
+    const cs = try a.alloc(u16, n * 2 * hf);
+    rope.table(cs, gh, gw, dim, c.rope_theta);
+    const qkv = try a.alloc(u16, n * width);
+    var prng: std.Random.DefaultPrng = .init(0x6d6d33);
+    for (qkv) |*v| v.* = @truncate(@as(u32, @bitCast(prng.random().floatNorm(f32) * 3)) >> 16);
+    var dq = try cuda.DeviceBuffer.fromHost(s.d, std.mem.sliceAsBytes(qkv));
+    defer dq.free();
+    var dc = try cuda.DeviceBuffer.fromHost(s.d, std.mem.sliceAsBytes(cs));
+    defer dc.free();
+    try t.k.rope(s, dq.ptr, dc.ptr, n, c.heads, dim, hf);
+    const got = try back(a, s, dq.ptr, qkv.len);
+    rope.apply(qkv, cs, n, c.heads, dim, hf);
+    if (!std.mem.eql(u16, got, qkv)) {
+        const i = std.mem.indexOfDiff(u16, got, qkv).?;
