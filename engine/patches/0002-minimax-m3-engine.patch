+    const int* __restrict__ iktab,     // this layer's IK arena slices by block (< 0: the slice's own IK)
+    const char* __restrict__ slices, long long slice_bytes,
+    const bf16* __restrict__ ik_arena, // [n][128][128]
+    const bf16* __restrict__ summ,     // [vpage][layers][lo 128, hi 128]
+    int layers, int layer, int horizon, int kvh,
+    float* __restrict__ bmax, int bm_stride, float scale, int kv8) {
+    const int b = blockIdx.x, g = blockIdx.y, r = blockIdx.z;
+    const int p = row_pos(pos, pos0, r);
+    const int own = p / BLOCK;
+    if (b > own) return;
+    const int e = row_table(row_tab, r) + b;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const uint2 qw = __ldg(reinterpret_cast<const uint2*>(iq + ((long long)r * kvh + g) * D) + lane);
+    const float q0 = lo(qw.x), q1 = hi(qw.x), q2 = lo(qw.y), q3 = hi(qw.y);
+    float* out = bmax + ((long long)r * kvh + g) * bm_stride + b;
+    if (!cold(b, own, horizon)) {
+        const int iks = __ldg(iktab + e);
+        const bf16* ik = iks >= 0 ? ik_arena + (long long)iks * BLOCK * D
+                                  : reinterpret_cast<const bf16*>(slices + (long long)__ldg(kvtab + e) * slice_bytes + ik_byte(kvh, kv8));
+        const float m = exact_max(ik, min(BLOCK, p + 1 - b * BLOCK), q0, q1, q2, q3, scale, warp, lane);
+        if (threadIdx.x == 0) *out = m;
+        return;
+    }
+    if (warp != 0) return;
+    const bf16* s = summ + ((long long)__ldg(vtab + e) * layers + layer) * 2 * D;
+    const uint2 lw = __ldg(reinterpret_cast<const uint2*>(s) + lane);
+    const uint2 hw = __ldg(reinterpret_cast<const uint2*>(s + D) + lane);
+    float u = fmaxf(q0 * lo(lw.x), q0 * lo(hw.x)) + fmaxf(q1 * hi(lw.x), q1 * hi(hw.x));
+    u += fmaxf(q2 * lo(lw.y), q2 * lo(hw.y)) + fmaxf(q3 * hi(lw.y), q3 * hi(hw.y));
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) u += __shfl_xor_sync(0xffffffffu, u, o);
+    if (lane == 0) *out = u * scale;
+}
+
+/// The `k` largest keys of a class over blocks [0, nb) into `out` (any order); every thread of the CTA calls.
+template <typename InClass, typename Key>
+__device__ void top_keys(int nb, int k, int* __restrict__ out, InClass in, Key key) {
+    __shared__ unsigned hist[256];
+    __shared__ unsigned long long prefix_sh;
+    __shared__ int krem_sh, count_sh, put_sh;
+    const int t = threadIdx.x;
+    if (t == 0) { count_sh = 0; put_sh = 0; prefix_sh = 0; }
+    __syncthreads();
+    int mine = 0;
+    for (int b = t; b < nb; b += blockDim.x) mine += in(b) ? 1 : 0;
+    atomicAdd(&count_sh, mine);
+    __syncthreads();
+    const int n = count_sh;
+    unsigned long long kth = 0;
+    if (n > k) {
+        if (t == 0) krem_sh = k;
+        unsigned long long mask = 0;
+        for (int shift = 56; shift >= 0; shift -= 8) {
+            for (int i = t; i < 256; i += blockDim.x) hist[i] = 0;
+            __syncthreads();
+            const unsigned long long prefix = prefix_sh;
+            for (int b = t; b < nb; b += blockDim.x) {
+                if (!in(b)) continue;
+                const unsigned long long kb = key(b);
+                if ((kb & mask) == prefix) atomicAdd(&hist[(kb >> shift) & 255u], 1u);
+            }
+            __syncthreads();
+            if (t == 0) {
+                int rem = krem_sh;
+                for (int bin = 255; bin >= 0; --bin) {
+                    if ((int)hist[bin] >= rem) {
+                        prefix_sh = prefix | ((unsigned long long)bin << shift);
+                        break;
+                    }
+                    rem -= hist[bin];
+                }
+                krem_sh = rem;
+            }
+            mask |= 255ull << shift;
+            __syncthreads();
+        }
+        kth = prefix_sh;
+    }
+    for (int b = t; b < nb; b += blockDim.x)
+        if (in(b) && (n <= k || key(b) >= kth)) out[atomicAdd(&put_sh, 1)] = b;
+    __syncthreads();
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_mm3_tier_cand(
+    const float* __restrict__ bmax, const int* __restrict__ pos, int pos0,
+    int* __restrict__ cand,            // [rows, kvh, 16 + m]: the horizon's top 16, then the top m cold; -1 padded
+    int kvh, int bm_stride, int horizon, int m,
+    int init_n, int init_inclusive, int local_n, int local_trailing, int higher_tie) {
+    const int g = blockIdx.x, r = blockIdx.y, t = threadIdx.x;
+    const int p = row_pos(pos, pos0, r);
+    const int nb = p / BLOCK + 1, own = nb - 1;
+    const int ncand = TOPK + m;
+    int* out = cand + ((long long)r * kvh + g) * ncand;
+    for (int i = t; i < ncand; i += blockDim.x) out[i] = (nb <= TOPK && i < nb) ? i : -1;
+    __syncthreads();
+    if (nb <= TOPK) return;
+    const float* sc = bmax + ((long long)r * kvh + g) * bm_stride;
+    auto is_forced = [&](int b) { return forced(b, own, init_n, init_inclusive, local_n, local_trailing); };
+    auto key = [&](int b) { return rank_key(is_forced(b) ? INFINITY : __ldg(sc + b), b, higher_tie); };
+    top_keys(nb, TOPK, out, [&](int b) { return is_forced(b) || !cold(b, own, horizon); }, key);
+    if (m > 0) top_keys(nb, m, out + TOPK, [&](int b) { return !is_forced(b) && cold(b, own, horizon); }, key);
+}
+
+extern "C" __global__ void __launch_bounds__(128) tf_mm3_tier_rerank(
+    const bf16* __restrict__ iq, const int* __restrict__ pos, int pos0,
+    const int* __restrict__ row_tab, const int* __restrict__ kvtab,
+    const char* __restrict__ slices, long long slice_bytes,
+    const int* __restrict__ cand, int m, int horizon, int kvh,
+    float* __restrict__ bmax, int bm_stride, float scale, int kv8,
+    int init_n, int init_inclusive, int local_n, int local_trailing) {
+    const int b = blockIdx.x, g = blockIdx.y, r = blockIdx.z;
+    const int p = row_pos(pos, pos0, r);
+    const int own = p / BLOCK;
+    if (b > own || own + 1 <= TOPK || !cold(b, own, horizon) || forced(b, own, init_n, init_inclusive, local_n, local_trailing))
+        return;
+    __shared__ int member;
+    if (threadIdx.x == 0) member = 0;
+    __syncthreads();
+    const int* c = cand + ((long long)r * kvh + g) * (TOPK + m) + TOPK;
+    for (int i = threadIdx.x; i < m; i += blockDim.x)
+        if (__ldg(c + i) == b) member = 1;
+    __syncthreads();
+    float* out = bmax + ((long long)r * kvh + g) * bm_stride + b;
+    if (!member) {
+        if (threadIdx.x == 0) *out = -INFINITY;
+        return;
+    }
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const uint2 qw = __ldg(reinterpret_cast<const uint2*>(iq + ((long long)r * kvh + g) * D) + lane);
+    const int e = row_table(row_tab, r) + b;
+    const bf16* ik = reinterpret_cast<const bf16*>(slices + (long long)__ldg(kvtab + e) * slice_bytes + ik_byte(kvh, kv8));
+    const float s = exact_max(ik, BLOCK, lo(qw.x), hi(qw.x), lo(qw.y), hi(qw.y), scale, warp, lane);
+    if (threadIdx.x == 0) *out = s;
+}
+
+/// A finished slice: its IK's per-dimension min and max to the summaries and, when ikslot >= 0, its IK to the arena.
+extern "C" __global__ void __launch_bounds__(128) tf_mm3_tier_summ(
+    const int4* __restrict__ jobs,     // [n] (slice slot, virtual page, layer, IK arena slice or -1)
+    const char* __restrict__ slices, long long slice_bytes, int kvh, int kv8,
+    bf16* __restrict__ summ, int layers, bf16* __restrict__ ik_arena) {
+    const int4 j = __ldg(jobs + blockIdx.x);
+    const bf16* ik = reinterpret_cast<const bf16*>(slices + (long long)j.x * slice_bytes + ik_byte(kvh, kv8));
+    const int d = threadIdx.x;
+    float lo_v = INFINITY, hi_v = -INFINITY;
+    for (int t = 0; t < BLOCK; ++t) {
+        const float v = __bfloat162float(ik[(long long)t * D + d]);
+        lo_v = fminf(lo_v, v);
+        hi_v = fmaxf(hi_v, v);
+    }
+    bf16* s = summ + ((long long)j.y * layers + j.z) * 2 * D;
+    s[d] = __float2bfloat16_rn(lo_v); // exact: lo_v and hi_v are bf16 values
+    s[D + d] = __float2bfloat16_rn(hi_v);
+    if (j.w < 0) return;
+    const uint4* src = reinterpret_cast<const uint4*>(ik);
+    uint4* dst = reinterpret_cast<uint4*>(ik_arena + (long long)j.w * BLOCK * D);
+    for (int i = d; i < BLOCK * D * 2 / 16; i += blockDim.x) dst[i] = __ldg(src + i);
+}
+
+/// IK of slices to the arena alone: (slice slot, arena slice) pairs, a CTA each.
+extern "C" __global__ void __launch_bounds__(128) tf_mm3_tier_ikcopy(
+    const int2* __restrict__ jobs, const char* __restrict__ slices, long long slice_bytes, int kvh, int kv8,
+    bf16* __restrict__ ik_arena) {
+    const int2 j = __ldg(jobs + blockIdx.x);
+    const uint4* src = reinterpret_cast<const uint4*>(slices + (long long)j.x * slice_bytes + ik_byte(kvh, kv8));
+    uint4* dst = reinterpret_cast<uint4*>(ik_arena + (long long)j.y * BLOCK * D);
+    for (int i = threadIdx.x; i < BLOCK * D * 2 / 16; i += blockDim.x) dst[i] = __ldg(src + i);
+}
+
+/// Table entries from a patch list: tabs[at] = value for each (at, value).
+extern "C" __global__ void __launch_bounds__(256) tf_mm3_tier_patch(int* __restrict__ tabs, const int2* __restrict__ patches, int n) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const int2 pv = __ldg(patches + i);
+    tabs[pv.x] = pv.y;
+}
