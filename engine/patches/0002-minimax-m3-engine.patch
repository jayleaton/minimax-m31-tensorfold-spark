+//! EXL3 parts launches (Dense.decodeParts): every part's rows byte-equal its own Dense.decode, every width and plan.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const exl3 = cuda.exl3;
+const parts_ = cuda.exl3_parts;
+const exl3_tests = @import("exl3_tests.zig");
+const dense_t = @import("exl3_dense_tests.zig");
+const Run = exl3_tests.Run;
+const Rig = @import("quant_ref_tests.zig").RigT;
+
+const Spec = struct { n: usize, halves: u32, cb: exl3.Codebook = .mul1 };
+const Case = struct { id: []const u8, k: usize, specs: []const Spec };
+
+const cases = [_]Case{
+    // TP2 rank 0 of MiniMax-M3.1-Flash: 6-bit q beside 8-bit k and v; the shared expert's gate and up
+    .{ .id = "qkv.tp2", .k = 6144, .specs = &.{ .{ .n = 4096, .halves = 12 }, .{ .n = 256, .halves = 16 }, .{ .n = 256, .halves = 16 } } },
+    .{ .id = "gate_up", .k = 6144, .specs = &.{ .{ .n = 1536, .halves = 12 }, .{ .n = 1536, .halves = 12 } } },
+    // TP1: q plans 8 warps (the plain kernel) beside one k | v launch
+    .{ .id = "qkv.tp1", .k = 6144, .specs = &.{ .{ .n = 8192, .halves = 12 }, .{ .n = 512, .halves = 16 }, .{ .n = 512, .halves = 16 } } },
+    // no instance takes 4- and 6-bit together; mcg runs alone; a half step; four parts
+    .{ .id = "mixed", .k = 2048, .specs = &.{ .{ .n = 1024, .halves = 8 }, .{ .n = 512, .halves = 12 }, .{ .n = 512, .halves = 12, .cb = .mcg } } },
+    .{ .id = "half", .k = 2048, .specs = &.{ .{ .n = 768, .halves = 9 }, .{ .n = 256, .halves = 16 }, .{ .n = 1024, .halves = 9 }, .{ .n = 128, .halves = 16 } } },
+    .{ .id = "narrow", .k = 1024, .specs = &.{ .{ .n = 128, .halves = 4 }, .{ .n = 256, .halves = 4 } } },
+};
+
+const row_counts = [_]usize{ 1, 3, 16, 17, 64, 128, 130 };
+
+pub fn run(r: *Rig, state: *Run) !void {
+    var dense = try exl3.Dense.load(r.gpu.d);
+    defer dense.unload();
+    for (cases) |c| {
+        const id = try std.fmt.allocPrint(r.a, "exl3.parts.{s}", .{c.id});
+        if (one(r, &dense, c, id)) |_| check.pass("{s}", .{id}) else |e| state.fail(e, id);
+    }
+}
+
+fn one(r: *Rig, de: *exl3.Dense, c: Case, id: []const u8) !void {
+    var ws: [parts_.max_parts]exl3.Weight = undefined;
+    for (c.specs, ws[0..c.specs.len]) |s, *w| {
+        const t, const suh, const svh = try dense_t.tensors(r, c.k, s.n, .{ .halves = @intCast(s.halves) });
+        w.* = try dense_t.weight(r, t, suh, svh, c.k, s.n, s.halves, s.cb);
+    }
+    const most = row_counts[row_counts.len - 1];
+    const x = try r.dev(std.mem.sliceAsBytes(try r.bfs(most * c.k, 1.0)));
+    var ls: [parts_.max_parts]parts_.Launch = undefined;
+    var ps: [parts_.max_parts]parts_.Part = undefined;
+    for (ws[0..c.specs.len], ps[0..c.specs.len]) |w, *p| p.* = .{ .w = w, .y = 0 };
+    const launches = try parts_.group(ps[0..c.specs.len], &ls);
+    std.debug.print("RESULT {s}: {d} parts in {d} launch(es)\n", .{ id, c.specs.len, launches });
+    for (row_counts) |m| {
+        for (c.specs, ps[0..c.specs.len]) |s, *p| p.y = try r.zeros(m * s.n * 2);
+        try de.decodeParts(r.s, ps[0..c.specs.len], x, .bf16, m, .bf16);
+        for (c.specs, ws[0..c.specs.len], ps[0..c.specs.len], 0..) |s, w, p, i| {
+            const want = try r.zeros(m * s.n * 2);
+            try de.decode(r.s, w, x, .bf16, m, want, .bf16);
+            const pid = try std.fmt.allocPrint(r.a, "{s} part {d} m={d}", .{ id, i, m });
+            try check.sameBytes(pid, try r.back(p.y, m * s.n * 2), try r.back(want, m * s.n * 2));
+        }
+    }
+}
diff --git a/zig/tests/cuda/exl3_ring_tests.zig b/zig/tests/cuda/exl3_ring_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5a3cd85760d08afa1b83fbb40e6f17faf626a821
--- /dev/null
+++ b/zig/tests/cuda/exl3_ring_tests.zig
@@ -0,0 +1,206 @@
+//! EXL3 routed experts' ring loads: bit-equal to the per-lane loads at MiniMax-M3's rank-0 shapes, then timed cold.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const cand = @import("exl3_candidate_tests.zig");
+const Gpu = check.Gpu;
+const Rig = cand.Rig;
+const ex = cuda.exl3_experts;
+
+const E = 128;
+const slots = 4;
+const D = 6144;
+const I = 1536; // rank 0's rows of each expert's 3072
+const pool_bytes = 1536 << 20; // random trellis words every layer's matrices are windows of (far past the L2)
+
+/// One layer's widths: K2 of gate, up and down for each expert (or one for all), its codebook and layout.
+const Case = struct {
+    name: []const u8,
+    gate: u32 = 0,
+    up: u32 = 0,
+    down: u32 = 0,
+    codebook: ex.Codebook = .mul1,
+    misalign: bool = false, // trellis pointers 4 bytes past 16-byte alignment: the per-lane loads
+    fused: bool = false, // gate and up halves of one [D, 2I] trellis (gu_stride)
+};
+
+const cases = [_]Case{
+    .{ .name = "3/3/3", .gate = 6, .up = 6, .down = 6 },
+    .{ .name = "4/4/4", .gate = 8, .up = 8, .down = 8 },
+    .{ .name = "3/3/4", .gate = 6, .up = 6, .down = 8 },
+    .{ .name = "per-expert 2-6 bits" },
+    .{ .name = "6/6/6", .gate = 12, .up = 12, .down = 12 },
+    .{ .name = "mcg 4/4/4", .gate = 8, .up = 8, .down = 8, .codebook = .mcg },
+    .{ .name = "3inst 4/4/4", .gate = 8, .up = 8, .down = 8, .codebook = .inst3 },
+    .{ .name = "3/3/4 misaligned", .gate = 6, .up = 6, .down = 8, .misalign = true },
+    .{ .name = "4/4/4 fused gate/up", .gate = 8, .up = 8, .down = 8, .fused = true },
+};
+
+fn trellisBytes(k: usize, n: usize, k2: usize) usize {
+    return (k / 16) * (n / 16) * 16 * k2;
+}
+
+/// A window of the pool, 256-aligned (plus 4 when misaligned).
+fn window(rng: std.Random, pool: u64, bytes: usize, misalign: bool) u64 {
+    const span = (pool_bytes - bytes - 256) / 256;
+    return pool + 256 * rng.uintLessThan(usize, span + 1) + @as(u64, if (misalign) 4 else 0);
+}
+
+fn f16s(r: *Rig, rng: std.Random, n: usize, scale: f32) !u64 {
+    const h = try r.gpu.gpa.alloc(f16, n);
+    defer r.gpu.gpa.free(h);
+    for (h) |*v| v.* = @floatCast(if (rng.boolean()) scale else -scale);
+    return r.put(h);
+}
+
+fn layer(r: *Rig, rng: std.Random, pool: u64, c: Case) !ex.Layer {
+    var ptr: [3][E]u64 = undefined;
+    var k2: [3][E]i32 = undefined;
+    const widths = [_]u32{ 4, 6, 8, 10, 12 };
+    for (0..E) |e| {
+        const w = [3]u32{ if (c.gate != 0) c.gate else widths[e % 5], if (c.up != 0) c.up else widths[(e + 2) % 5], if (c.down != 0) c.down else widths[(e + 3) % 5] };
+        for (0..3) |m| {
+            k2[m][e] = @intCast(w[m]);
+            const bytes = if (m == 2) trellisBytes(I, D, w[m]) else trellisBytes(D, if (c.fused) 2 * I else I, w[m]);
+            ptr[m][e] = window(rng, pool, bytes, c.misalign);
+        }
+        if (c.fused) ptr[1][e] = ptr[0][e] + (I / 16) * 16 * w[0]; // up: the next I columns of the same rows
+    }
+    return .{
+        .gate = try r.put(&ptr[0]),
+        .up = try r.put(&ptr[1]),
+        .down = try r.put(&ptr[2]),
+        .gate_k2 = try r.put(&k2[0]),
+        .up_k2 = try r.put(&k2[1]),
+        .down_k2 = try r.put(&k2[2]),
+        .suh_g = try f16s(r, rng, E * D, 1),
+        .suh_u = try f16s(r, rng, E * D, 1),
+        .svh_g = try f16s(r, rng, E * I, 1 / @sqrt(@as(f32, D))),
+        .svh_u = try f16s(r, rng, E * I, 1 / @sqrt(@as(f32, D))),
+        .suh_d = try f16s(r, rng, E * I, 1),
+        .svh_d = try f16s(r, rng, E * D, 1 / @sqrt(@as(f32, I))),
+        .experts = E,
+        .dims = D,
+        .width = I,
+        .codebook = c.codebook,
+        .gu_stride = if (c.fused) 2 * I / 16 else 0,
+        .limit = 7,
+        .act_mode = 2,
+    };
+}
+
+/// Inputs of `rows` rows: bf16 activations, distinct picks a row, routing weights.
+const Rows = struct { x: u64, pick: u64, wts: u64 };
+
+fn rowsOf(r: *Rig, rng: std.Random, rows: usize) !Rows {
+    const a = r.gpu.gpa;
+    const x = try a.alloc(u16, rows * D);
+    defer a.free(x);
+    for (x) |*v| v.* = @truncate(@as(u32, @bitCast(@as(f32, (rng.float(f32) * 2 - 1) * 0.5))) >> 16);
+    const pick = try a.alloc(i32, rows * slots);
+    defer a.free(pick);
+    const wts = try a.alloc(f32, rows * slots);
+    defer a.free(wts);
+    for (0..rows) |row| {
+        var q: usize = 0;
+        while (q < slots) {
+            const e: i32 = @intCast(rng.uintLessThan(usize, E));
+            if (std.mem.indexOfScalar(i32, pick[row * slots ..][0..q], e) != null) continue;
+            pick[row * slots + q] = e;
+            wts[row * slots + q] = 0.1 + rng.float(f32);
+            q += 1;
+        }
+    }
+    return .{ .x = try r.put(x), .pick = try r.put(pick), .wts = try r.put(wts) };
+}
+
+/// One call's output and scratch, reused by every call (NaN canaries before each).
+const Bufs = struct { scratch: cuda.DeviceBuffer, out: cuda.DeviceBuffer };
+
+const Loads = @FieldType(ex.Experts, "loads");
+
+/// out and the per-slot y of one call with `loads`, downloaded.
+fn call(r: *Rig, exp: *ex.Experts, s: cuda.Stream, b: Bufs, l: ex.Layer, in: Rows, rows: usize, loads: Loads) ![2][]u8 {
+    exp.loads = loads;
+    try b.scratch.fill8(0xff, s.handle);
+    try b.out.fill8(0xff, s.handle);
+    const sc = try ex.scratch(b.scratch.ptr, l, rows, slots);
+    try exp.run(s, l, in.x, D, .bf16, in.pick, in.wts, rows, b.out.ptr, sc);
+    try s.synchronize();
+    const got_out = try r.gpu.gpa.alloc(u8, rows * D * 4);
+    try r.get(b.out.ptr, got_out);
+    const got_y = try r.gpu.gpa.alloc(u8, rows * slots * D * 4);
+    try r.get(sc.y, got_y);
+    return .{ got_out, got_y };
+}
+
+/// `exl3-ring [REPS]`: every case's rows equal through the ring and the per-lane loads, then cold milliseconds a call.
+pub fn run(gpu: Gpu, rest: []const [:0]const u8) !void {
+    const reps: usize = if (rest.len > 0) try std.fmt.parseInt(usize, rest[0], 10) else 200;
+    var s = try cuda.Stream.init(gpu.d, true);
+    defer s.deinit();
+    var exp = try ex.Experts.load(gpu.d);
+    defer exp.unload();
+    var prng = std.Random.DefaultPrng.init(0x72696e67);
+    const rng = prng.random();
+    var r: Rig = .{ .gpu = gpu };
+    defer r.deinit();
+    const host = try gpu.gpa.alloc(u8, pool_bytes);
+    defer gpu.gpa.free(host);
+    rng.bytes(host);
+    const pool = try r.put(host);
+
+    const shape: ex.Layer = .{ .gate = 0, .up = 0, .down = 0, .gate_k2 = 0, .up_k2 = 0, .down_k2 = 0, .suh_g = 0, .suh_u = 0, .svh_g = 0, .svh_u = 0, .suh_d = 0, .svh_d = 0, .experts = E, .dims = D, .width = I, .codebook = .mul1 };
+    var b: Bufs = .{ .scratch = try cuda.DeviceBuffer.alloc(gpu.d, try ex.scratchBytes(shape, 256, slots)), .out = try cuda.DeviceBuffer.alloc(gpu.d, 256 * D * 4) };
+    defer {
+        b.scratch.free();
+        b.out.free();
+    }
+    var failed = false;
+    for (cases) |c| {
+        const l = try layer(&r, rng, pool, c);
+        for ([_]usize{ 1, 2, 3, 4, 8, 16, 17, 64, 256 }) |rows| {
+            const in = try rowsOf(&r, rng, rows);
+            const want = try call(&r, &exp, s, b, l, in, rows, .lanes);
+            defer for (want) |w| gpu.gpa.free(w);
+            const got = try call(&r, &exp, s, b, l, in, rows, .ring);
+            defer for (got) |g| gpu.gpa.free(g);
+            if (!std.mem.eql(u8, got[0], want[0]) or !std.mem.eql(u8, got[1], want[1])) {
+                failed = true;
+                check.sameBytes("exl3-ring out", got[0], want[0]) catch {};
+                check.sameBytes("exl3-ring y", got[1], want[1]) catch {};
+                std.debug.print("FAIL exl3-ring {s} rows={d}\n", .{ c.name, rows });
+            }
+        }
+        if (!failed) check.pass("exl3-ring {s}: out and y through the ring equal the per-lane loads, rows 1-256", .{c.name});
+    }
+
+    // cold calls: 32 layers of distinct windows in turn, fresh picks; every launch of run(), ms a call (median of 5)
+    for ([_]usize{ 0, 1, 2 }) |ci| {
+        var ls: [32]ex.Layer = undefined;
+        for (&ls) |*l| l.* = try layer(&r, rng, pool, cases[ci]);
+        for ([_]usize{ 1, 4, 16 }) |rows| {
+            var ins: [32]Rows = undefined;
+            for (&ins) |*in| in.* = try rowsOf(&r, rng, rows);
+            const sc = try ex.scratch(b.scratch.ptr, ls[0], rows, slots);
+            const out = b.out.ptr;
+            var line: [2]f64 = undefined;
+            for ([_]Loads{ .lanes, .ring }, 0..) |loads, li| {
+                exp.loads = loads;
+                var t: [5]f64 = undefined;
+                for (&t) |*x| {
+                    for (0..32) |i| try exp.run(s, ls[i], ins[i].x, D, .bf16, ins[i].pick, ins[i].wts, rows, out, sc);
+                    try s.synchronize();
+                    const t0 = check.now(gpu.io);
+                    for (0..reps) |i| try exp.run(s, ls[i % 32], ins[i % 32].x, D, .bf16, ins[i % 32].pick, ins[i % 32].wts, rows, out, sc);
+                    try s.synchronize();
+                    x.* = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6 / @as(f64, @floatFromInt(reps));
+                }
+                line[li] = check.median(&t);
+            }
+            std.debug.print("RESULT exl3-ring cold {s} rows={d}: ms a call lanes {d:.4}, ring {d:.4} ({d:.3}x)\n", .{ cases[ci].name, rows, line[0], line[1], line[0] / line[1] });
+        }
+    }
+    exp.loads = .ring;
+    if (failed) return error.TestFailed;
+}
