+#!/usr/bin/env python3
+"""Real target hidden states for the MiniMax-M3.1-Flash dspark draft, a PyTorch reference of the draft, and comparisons.
+
+    mm3_dspark_ref.py corpus --eval STEM --out DIR [--domains code:4,chat:4,tools:4,text:4] [--max-len 2048]
+    mm3_dspark_ref.py taps   --pack PACK --exllamav3 SRC --corpus DIR [--device cuda:0]
+    mm3_dspark_ref.py draft  --pack PACK --exllamav3 SRC --dspark DIR --corpus DIR [--anchors 256] [--save-rows 4]
+    mm3_dspark_ref.py accept --corpus DIR                                    acceptance by position and domain
+    mm3_dspark_ref.py compare --corpus DIR       TensorFold's tf_*.npy (tf-cuda-test mm3-dspark-real) against draft.npz
+
+corpus picks rows of a calibration set (build.py stem: STEM.json + STEM.exl3.safetensors) by domain and writes
+DIR/rows.json and DIR/r<i>/ids.npy. taps runs the EXL3 pack layer by layer (one row at a time: padded batches are wrong
+on this pack) and writes per row: out.npy = each tapped layer's output, in.npy = its input (bf16 bits, [n, 5, hidden]),
+post.npy = the last layer's output after the final norm (bf16 bits, [n, hidden]) and top.npy / topv.npy = the target's
+8 best next tokens and their logits at every position (int32 / float32, [n, 8]).
+
+draft is the dspark draft in PyTorch with the serving engines' semantics (vLLM #63232 minimax_m3/common/dspark.py,
+SGLang dspark_minimax.py, TokenSpeed minimax_m3_dspark.py): fc over the five taps (layer outputs, layer 59 before
+the final norm), hidden_norm, per-layer context K (k_norm, NeoX RoPE on 64 dims at its position) and V, a block of
+[anchor, mask x 6] at P..P+6 attending bidirectionally to itself and to context keys within 4096 positions, final_norm,
+the target's lm_head, the Markov bias w2[id] . w1[prev] over the whole vocabulary, confidence sigmoid. Linears run in
+bf16 on dequantized MXFP8 weights (e4m3 x 2^(scale - 127)); norms and RoPE in fp32 with bf16 outputs. It writes
+DIR/r<i>/draft.npz: anchors, drafts, conf and, for the candidate-limited chain the TensorFold device runs, drafts_c64 /
+drafts_c128; with --save-rows the first rows' block rows after final_norm (post) for the TensorFold parity harness.
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+TAPS = [3, 17, 31, 45, 59]
+TOPK = 8
+
+
+def bf16_bits(t) -> np.ndarray:
+    """A float tensor as bf16 bits (round to nearest even), uint16."""
+    import torch
+    return t.detach().to(torch.bfloat16).view(torch.int16).cpu().numpy().view(np.uint16)
+
+
+def cmd_corpus(a):
+    from safetensors.numpy import load_file
+    meta = json.loads(Path(a.eval).with_suffix(".json").read_text())
+    packed = load_file(str(Path(a.eval).with_suffix(".exl3.safetensors")))
+    want = {d: int(n) for d, n in (x.split(":") for x in a.domains.split(","))}
+    src = [name for name, v in meta.get("sources", {}).items() for _ in v.get("rows", [])]
+    out = Path(a.out)
+    rows, got = [], {}
+    for i, d in enumerate(meta["domains"]):
+        if got.get(d, 0) >= want.get(d, 0):
+            continue
+        n = min(int(packed["lengths"][i]), a.max_len)
+        spans = [[s, min(e, n)] for s, e in (meta["assistant_spans"][i] or [[1, n]]) if s < n]
+        if not spans:
+            continue
+        got[d] = got.get(d, 0) + 1
+        r = len(rows)
+        (out / f"r{r}").mkdir(parents=True, exist_ok=True)
+        np.save(out / f"r{r}" / "ids.npy", packed["input_ids"][i, :n].astype(np.int32))
+        rows.append({"row": r, "set_index": i, "domain": d, "source": src[i] if i < len(src) else "?", "tokens": n,
+                     "assistant_spans": spans})
+    (out / "rows.json").write_text(json.dumps({"eval": str(a.eval), "taps": TAPS, "rows": rows}, indent=1))
+    print(f"{len(rows)} rows, {sum(r['tokens'] for r in rows)} tokens -> {out}: {got}")
+
+
+def cmd_taps(a):
+    sys.path.insert(0, a.exllamav3)
+    import torch
+    from exllamav3 import Config, Model
+    from exllamav3.util.memory import free_mem
+    corpus = Path(a.corpus)
+    rows = json.loads((corpus / "rows.json").read_text())["rows"]
+    dev = torch.device(a.device)
+    c = Config.from_directory(a.pack)
+    c.override_dynamic_seq_len(max(2048, max(r["tokens"] for r in rows)))
+    m = Model.from_config(c)
+    ids = [torch.from_numpy(np.load(corpus / f"r{r['row']}" / "ids.npy").astype(np.int64)).view(1, -1) for r in rows]
+    params = [{} for _ in rows]
+    xs = [m.prepare_inputs(t, p) for t, p in zip(ids, params)]
+    taps_out = [np.zeros((t.shape[1], len(TAPS), c.hidden_size), np.uint16) for t in ids]
+    taps_in = [np.zeros_like(o) for o in taps_out]
+
+    def load(idx):
+        c.stc.begin_deferred_load()
+        mod = m.modules[idx]
+        mod.load(dev)
+        c.stc.end_deferred_load()
+        return mod
+
+    def unload(mod):
+        mod.unload()
+        c.stc.close()
+        c.stc.release_arena()
+        free_mem()
+
+    def each(mod, fn):
+        for j in range(len(rows)):
+            p = dict(params[j])
+            xs[j] = fn(mod, mod.prepare_for_device(xs[j], p), p, j)
+
+    with torch.inference_mode():
+        mod = load(0)
+        each(mod, lambda md, v, p, j: md.forward(v, p).float().cpu())
+        unload(mod)
+        for layer in range(TAPS[-1] + 1):
+            mod = load(m.first_block_idx + layer)
+            t = TAPS.index(layer) if layer in TAPS else None
+
+            def step(md, v, p, j):
+                if t is not None:
+                    taps_in[j][:, t] = bf16_bits(v.float()[0])
+                y = md.forward(v.float(), p).float()
+                if t is not None:
+                    taps_out[j][:, t] = bf16_bits(y[0])
+                return y.cpu()
+            each(mod, step)
+            unload(mod)
+            print(f" -- layer {layer} done", flush=True)
+        norm, head = load(m.logit_layer_idx - 1), load(m.logit_layer_idx)
+        for j, r in enumerate(rows):
+            d = corpus / f"r{r['row']}"
+            n = xs[j].shape[1]
+            post = np.zeros((n, c.hidden_size), np.uint16)
+            top = np.zeros((n, TOPK), np.int32)
+            topv = np.zeros((n, TOPK), np.float32)
+            for s in range(0, n, 256):
+                e = min(s + 256, n)
+                p = dict(params[j])
+                h = norm.forward(norm.prepare_for_device(xs[j][:, s:e], p), p)
+                post[s:e] = bf16_bits(h.float()[0])
+                lg = head.forward(head.prepare_for_device(h, dict(params[j])), dict(params[j])).float()[0]
+                v, i = lg.topk(TOPK, dim=-1)
+                top[s:e], topv[s:e] = i.cpu().numpy().astype(np.int32), v.cpu().numpy()
+            np.save(d / "out.npy", taps_out[j])
+            np.save(d / "in.npy", taps_in[j])
+            np.save(d / "post.npy", post)
+            np.save(d / "top.npy", top)
+            np.save(d / "topv.npy", topv)
+            agree = float((top[:-1, 0] == np.load(d / "ids.npy")[1:]).mean())
+            print(f" -- row {r['row']} ({r['domain']}): {n} positions, target top-1 = next token {agree:.3f}", flush=True)
+        unload(norm)
+        unload(head)
+
+
+GEMMA = True
+EPS = 1e-6
+
+
+def rms(x, w, torch):
+    """Gemma RMS norm (1 + w) in fp32, bf16 out."""
+    x32 = x.float()
+    y = x32 * torch.rsqrt(x32.pow(2).mean(-1, keepdim=True) + EPS)
+    return (y * (1.0 + w.float())).to(torch.bfloat16)
+
+
+def rope(x, pos, torch, rot=64, theta=1e7):
+    """NeoX rotate-half over the first `rot` dims of the last axis; `pos` broadcasts against x's leading axes."""
+    half = rot // 2
+    inv = 1.0 / (theta ** (torch.arange(0, half, device=x.device, dtype=torch.float64) * 2 / rot))
+    ang = (pos.to(torch.float64)[..., None] * inv).float()
+    cos, sin = ang.cos(), ang.sin()
+    while cos.dim() < x.dim():
+        cos, sin = cos.unsqueeze(-2), sin.unsqueeze(-2)
+    x32 = x.float()
+    a, b, rest = x32[..., :half], x32[..., half:rot], x32[..., rot:]
+    return torch.cat((a * cos - b * sin, b * cos + a * sin, rest), -1).to(torch.bfloat16)
+
+
+def load_draft(path: Path, dev, torch):
+    """The dspark tensors: MXFP8 linears dequantized to bf16 [n, k], the rest as stored."""
+    from safetensors.torch import load_file
+    raw = load_file(str(next(path.glob("model-dspark-*.safetensors"))), device=str(dev))
+    P = "language_model.model.dspark."
+    w = {}
+    for name, t in raw.items():
+        if not name.startswith(P) or name.endswith("weight_scale_inv"):
+            continue
+        key = name[len(P):]
+        if t.dtype == torch.float8_e4m3fn:
+            s = raw[name[:-len("weight")] + "weight_scale_inv"]
+            scale = torch.exp2(s.float() - 127.0).repeat_interleave(32, dim=1)
+            t = (t.float() * scale).to(torch.bfloat16)
+        w[key] = t
+    return w
+
+
+def swigluoai(g, u, torch, alpha=1.702, limit=7.0):
+    g, u = g.float().clamp(max=limit), u.float().clamp(-limit, limit)
+    return (g * torch.sigmoid(alpha * g) * (u + 1)).to(torch.bfloat16)
+
+
+def lin(x, w):
+    return x @ w.t()
+
+
+class Draft:
+    """The dspark draft over one row's taps; `embed` and `head` are the target's (exllamav3 modules)."""
+
+    def __init__(self, w, embed, head, torch, layers=5, block=7, mask=200058, window=4096):
+        self.w, self.embed, self.head, self.t = w, embed, head, torch
+        self.layers, self.block, self.mask, self.window = layers, block, mask, window
+        self.w1 = w["markov_head.markov_w1.weight"].float()
+        self.w2t = w["markov_head.markov_w2.weight"].float().t().contiguous()
+
+    def L(self, l, name):
+        return self.w[f"layers.{l}.decoder_layer.{name}"]
+
+    def context(self, taps):
+        """taps [n, 5, hidden] bf16 -> per layer K [n, 4, 128] (normed, roped) and V [n, 4, 128]."""
+        t = self.t
+        n = taps.shape[0]
+        ctx = rms(lin(taps.reshape(n, -1), self.w["fc.weight"]), self.w["hidden_norm.weight"], t)
+        pos = t.arange(n, device=taps.device)
+        ks, vs = [], []
+        for l in range(self.layers):
+            k = lin(ctx, self.L(l, "self_attn.k_proj.weight")).view(n, 4, 128)
+            v = lin(ctx, self.L(l, "self_attn.v_proj.weight")).view(n, 4, 128)
+            k = rope(rms(k, self.L(l, "self_attn.k_norm.weight"), t), pos[:, None], t)
+            ks.append(k)
+            vs.append(v)
+        return ks, vs
+
+    def block_rows(self, ks, vs, anchors, P):
+        """Blocks for anchors (tokens) at positions P (both [B]): rows after final_norm [B, block, hidden]."""
+        t = self.t
+        B, nb = P.shape[0], self.block
+        ids = t.full((B, nb), self.mask, dtype=t.long, device=P.device)
+        ids[:, 0] = anchors
+        h = self.embed(ids).to(t.bfloat16).float()                      # residual stream in fp32
+        rp = P[:, None] + t.arange(nb, device=P.device)[None]           # [B, nb] row positions
+        n = ks[0].shape[0]
+        kp = t.arange(n, device=P.device)
+        # context key j visible to row (b, i) iff j < P_b and rp - j < window
+        cmask = (kp[None, None] < P[:, None, None]) & ((rp[:, :, None] - kp[None, None]) < self.window)
+        for l in range(self.layers):
+            a = rms(h, self.L(l, "input_layernorm.weight"), t)
+            q = lin(a, self.L(l, "self_attn.q_proj.weight")).view(B, nb, 64, 128)
+            k = lin(a, self.L(l, "self_attn.k_proj.weight")).view(B, nb, 4, 128)
+            v = lin(a, self.L(l, "self_attn.v_proj.weight")).view(B, nb, 4, 128)
+            q = rope(rms(q, self.L(l, "self_attn.q_norm.weight"), t), rp, t)
+            k = rope(rms(k, self.L(l, "self_attn.k_norm.weight"), t), rp, t)
+            qg = q.float().view(B, nb, 4, 16, 128)
+            sc = t.einsum("bigrd,jgd->bgrij", qg, ks[l].float())        # context scores [B, 4, 16, nb, n]
+            sb = t.einsum("bigrd,bjgd->bgrij", qg, k.float())           # block scores [B, 4, 16, nb, nb]
+            s = t.cat((sc, sb), -1) * 128 ** -0.5
+            full = t.cat((cmask, t.ones(B, nb, nb, dtype=t.bool, device=P.device)), -1)
+            s = s.masked_fill(~full[:, None, None], float("-inf")).softmax(-1)
+            o = t.einsum("bgrij,jgd->bigrd", s[..., :n], vs[l].float()) + \
+                t.einsum("bgrij,bjgd->bigrd", s[..., n:], v.float())
+            o = o.reshape(B, nb, 64 * 128).to(t.bfloat16)
+            h = h + lin(o, self.L(l, "self_attn.o_proj.weight")).float()
+            m = rms(h, self.L(l, "post_attention_layernorm.weight"), t)
+            g = lin(m, self.L(l, "mlp.gate_proj.weight"))
+            u = lin(m, self.L(l, "mlp.up_proj.weight"))
+            h = h + lin(swigluoai(g, u, t), self.L(l, "mlp.down_proj.weight")).float()
+        return rms(h, self.w["final_norm.weight"], t)
+
+    def chain(self, post, anchors, cands=(64, 128)):
+        """Drafts (full vocabulary Markov argmax), confidences, and the chains limited to each base top-C."""
+        t = self.t
+        B, nb = post.shape[:2]
+        w1 = self.w1
+        cw, cb = self.w["confidence_head.proj.weight"].float()[0], self.w["confidence_head.proj.bias"].float()[0]
+        base = self.head(post.reshape(B * nb, -1)).float().view(B, nb, -1)
+        out = {"drafts": t.zeros(B, nb, dtype=t.long, device=post.device), "conf": t.zeros(B, nb, device=post.device)}
+        for c in cands:
+            out[f"drafts_c{c}"] = t.zeros(B, nb, dtype=t.long, device=post.device)
+        prev = {k: anchors.clone() for k in out if k.startswith("drafts")}
+        for i in range(nb):
+            bi = base[:, i]
+            for key in prev:
+                bias = w1[prev[key]] @ self.w2t                          # [B, vocab]
+                z = bi + bias
+                if key != "drafts":
+                    c = int(key[len("drafts_c"):])
+                    top = bi.topk(c, dim=-1).indices
+                    d = top.gather(1, z.gather(1, top).argmax(-1, keepdim=True))[:, 0]
+                else:
+                    d = z.argmax(-1)
+                    feat = t.cat((post[:, i].float(), w1[prev[key]]), -1)
+                    out["conf"][:, i] = t.sigmoid(feat @ cw + cb)
+                out[key][:, i] = d
+                prev[key] = d
+        return out
+
+
+def head_fns(a, torch, dev):
+    """The target's embedding and lm_head (no final norm) as functions, from the EXL3 pack via exllamav3."""
+    sys.path.insert(0, a.exllamav3)
+    from exllamav3 import Config, Model
+    c = Config.from_directory(a.pack)
+    m = Model.from_config(c)
+    emb, head = m.modules[0], m.modules[m.logit_layer_idx]
+    for mod in (emb, head):
+        c.stc.begin_deferred_load()
+        mod.load(dev)
+        c.stc.end_deferred_load()
+
+    def embed(ids):
+        return emb.forward(ids.to(dev), {})
+
+    def logits(x):
+        out = []
+        for s in range(0, x.shape[0], 256):
+            p = {}
+            out.append(head.forward(head.prepare_for_device(x[s:s + 256].unsqueeze(0).half(), p), p).float()[0])
+        return torch.cat(out)
+    return embed, logits
+
+
+def cmd_draft(a):
+    import torch
+    dev = torch.device(a.device)
+    corpus = Path(a.corpus)
+    rows = json.loads((corpus / "rows.json").read_text())["rows"]
+    embed, logits = head_fns(a, torch, dev)
+    d = Draft(load_draft(Path(a.dspark), dev, torch), embed, logits, torch)
+    if a.rows:
+        rows = [r for r in rows if r["row"] in {int(x) for x in a.rows.split(",")}]
+    with torch.inference_mode():
+        for r in rows:
+            rd = corpus / f"r{r['row']}"
+            ids = torch.from_numpy(np.load(rd / "ids.npy").astype(np.int64)).to(dev)
+            taps = torch.from_numpy(np.load(rd / "out.npy").astype(np.int16)).to(dev).view(torch.bfloat16)
+            cand = [p for s, e in r["assistant_spans"] for p in range(max(s, 1), e - 1)]
+            sel = np.unique(np.linspace(0, len(cand) - 1, min(a.anchors, len(cand))).round().astype(int))
+            P = torch.tensor([cand[i] for i in sel], device=dev)
+            ks, vs = d.context(taps)
+            res = {}
+            for s in range(0, P.shape[0], a.batch):
+                Pb = P[s:s + a.batch]
+                post = d.block_rows(ks, vs, ids[Pb], Pb)
+                o = d.chain(post, ids[Pb])
+                if r["row"] < a.save_rows and s == 0:
+                    res["post"] = post.view(torch.int16).cpu().numpy().view(np.uint16)
+                for k, v in o.items():
+                    res.setdefault(k, []).append(v.cpu().numpy())
+            out = {k: (np.concatenate(v) if isinstance(v, list) else v) for k, v in res.items()}
+            out["anchors"] = P.cpu().numpy()
+            np.savez(rd / "draft.npz", **out)
+            np.save(rd / "anchors.npy", out["anchors"].astype(np.int32))
+            same = {k: float((out[k] == out["drafts"]).all(1).mean()) for k in out if k.startswith("drafts_c")}
+            print(f" -- row {r['row']} ({r['domain']}): {len(P)} anchors; chains equal to full vocab: {same}", flush=True)
+
+
+def accepted(drafts, P, ids, top):
+    """Kept drafts per anchor under greedy verification on the row's text: draft i is checkable only while the text
+    follows drafts 1..i-1 (teacher forcing), so a text that leaves the drafted path truncates (a lower bound)."""
+    n = len(ids)
+    out = np.zeros(len(P), np.int32)
+    trunc = np.zeros(len(P), bool)
+    for j, p in enumerate(P):
+        k = 0
+        for i, t in enumerate(drafts[j]):
+            if p + i >= n - 1 or t != top[p + i, 0]:
+                break
+            k += 1
+            if p + i + 1 >= n or ids[p + i + 1] != t:
+                trunc[j] = i + 1 < len(drafts[j])
+                break
+        out[j] = k
+    return out, trunc
+
+
+def cmd_accept(a):
+    corpus = Path(a.corpus)
+    rows = json.loads((corpus / "rows.json").read_text())["rows"]
+    by = {}
+    for r in rows:
+        rd = corpus / f"r{r['row']}"
+        z = np.load(rd / "draft.npz")
+        ids, top = np.load(rd / "ids.npy"), np.load(rd / "top.npy")
+        for key in [k for k in z.files if k.startswith("drafts")]:
+            k, tr = accepted(z[key], z["anchors"], ids, top)
+            g = by.setdefault((r["domain"], key), {"k": [], "trunc": [], "conf": []})
+            g["k"].append(k)
+            g["trunc"].append(tr)
+            if key == "drafts":
+                g["conf"].append(z["conf"])
+    report = {}
+    for (dom, key), g in sorted(by.items()):
+        k, tr = np.concatenate(g["k"]), np.concatenate(g["trunc"])
+        cum = [float((k >= i).mean()) for i in range(1, 8)]
+        cond = [float((k >= i).sum() / max(1, (k >= i - 1).sum())) for i in range(1, 8)]
+        e = {"anchors": int(len(k)), "tau": float(1 + k.mean()), "cumulative": cum, "conditional": cond,
+             "truncated": float(tr.mean())}
+        if g["conf"]:
+            conf = np.concatenate(g["conf"])
+            e["conf1_vs_first_kept"] = [[float(lo), int(((conf[:, 0] >= lo) & (conf[:, 0] < lo + .1)).sum()),
+                                         float((k[(conf[:, 0] >= lo) & (conf[:, 0] < lo + .1)] >= 1).mean())
+                                         if ((conf[:, 0] >= lo) & (conf[:, 0] < lo + .1)).any() else None]
+                                        for lo in np.arange(0, 1, .1)]
+        report[f"{dom}/{key}"] = e
+        print(f"{dom:13s} {key:12s} n={len(k):5d} tau={e['tau']:.2f} cum " +
+              "/".join(f"{x:.2f}" for x in cum) + " cond " + "/".join(f"{x:.2f}" for x in cond) +
+              f" trunc={e['truncated']:.2f}")
+    (corpus / "accept.json").write_text(json.dumps(report, indent=1))
+
+
+def bf16f(u):
+    return (u.astype(np.uint32) << 16).view(np.float32)
+
+
+def cmd_compare(a):
+    corpus = Path(a.corpus)
+    rows = json.loads((corpus / "rows.json").read_text())["rows"]
+    tot = {"anchors": 0, "chain_full": 0, "chain_c64": 0, "first_full": 0, "first_c64": 0}
+    conf_err, post_err, kt, kr = [], [], [], []
+    for r in rows:
+        rd = corpus / f"r{r['row']}"
+        if not (rd / "tf_drafts.npy").exists():
+            continue
+        z = np.load(rd / "draft.npz")
+        tf, tc = np.load(rd / "tf_drafts.npy"), np.load(rd / "tf_conf.npy")
+        tot["anchors"] += len(tf)
+        tot["chain_full"] += int((tf == z["drafts"]).all(1).sum())
+        tot["chain_c64"] += int((tf == z["drafts_c64"]).all(1).sum())
+        tot["first_full"] += int((tf[:, 0] == z["drafts"][:, 0]).sum())
+        tot["first_c64"] += int((tf[:, 0] == z["drafts_c64"][:, 0]).sum())
+        same = (tf == z["drafts"]).all(1)  # confidences compare only where both chains took the same tokens
+        if same.any():
+            conf_err.append(np.abs(tc[same] - z["conf"][same]).max())
+        if (rd / "tf_post.npy").exists() and "post" in z.files:
+            g, w = bf16f(np.load(rd / "tf_post.npy")), bf16f(z["post"])
+            m = min(len(g), len(w))
+            for j in range(m):
+                d = (g[j] - w[j]).ravel()
+                post_err.append(float(np.linalg.norm(d) / np.linalg.norm(w[j].ravel())))
+        ids, top = np.load(rd / "ids.npy"), np.load(rd / "top.npy")
+        kt.append(accepted(tf, z["anchors"], ids, top)[0])
+        kr.append(accepted(z["drafts"], z["anchors"], ids, top)[0])
+    n = max(1, tot["anchors"])
+    rep = {k: (v / n if k != "anchors" else v) for k, v in tot.items()}
+    rep["conf_max_abs"] = float(max(conf_err)) if conf_err else None
+    rep["post_rel_l2_mean"] = float(np.mean(post_err)) if post_err else None
+    rep["post_rel_l2_max"] = float(np.max(post_err)) if post_err else None
+    if kt:
+        rep["tau_tf"], rep["tau_ref"] = float(1 + np.concatenate(kt).mean()), float(1 + np.concatenate(kr).mean())
+    (corpus / "compare.json").write_text(json.dumps(rep, indent=1))
+    print(json.dumps(rep, indent=1))
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    p = sub.add_parser("corpus")
+    p.add_argument("--eval", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--domains", default="code:4,chat:4,tools:4,text:4")
+    p.add_argument("--max-len", type=int, default=2048)
+    p = sub.add_parser("taps")
+    p.add_argument("--pack", required=True)
+    p.add_argument("--exllamav3", required=True)
+    p.add_argument("--corpus", required=True)
+    p.add_argument("--device", default="cuda:0")
+    p = sub.add_parser("draft")
+    p.add_argument("--pack", required=True)
+    p.add_argument("--exllamav3", required=True)
+    p.add_argument("--dspark", required=True)
+    p.add_argument("--corpus", required=True)
+    p.add_argument("--anchors", type=int, default=256, help="anchor positions a row, spread over its assistant spans")
+    p.add_argument("--batch", type=int, default=32)
+    p.add_argument("--save-rows", type=int, default=4, help="rows whose first batch keeps its post rows")
+    p.add_argument("--rows", help="only these rows (comma separated), e.g. a smoke run")
+    p.add_argument("--device", default="cuda:0")
+    p = sub.add_parser("accept")
+    p.add_argument("--corpus", required=True)
+    p = sub.add_parser("compare")
+    p.add_argument("--corpus", required=True)
+    a = ap.parse_args()
+    {"corpus": cmd_corpus, "taps": cmd_taps, "draft": cmd_draft, "accept": cmd_accept, "compare": cmd_compare}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
