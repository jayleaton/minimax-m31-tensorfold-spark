+// A key quantized from a NaN or inf row has a NaN scale: all its scores are NaN and fmax drops them.
+extern "C" __global__ void __launch_bounds__(128) tf_mm3_index8(
+    const bf16* __restrict__ iq,       // [rows, kvh, 128] post norm and rotary
+    const int* __restrict__ pos,       // [rows] or null (pos0 + r)
