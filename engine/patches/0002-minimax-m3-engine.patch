diff --git a/zig/build/minimax_dflash2.zig b/zig/build/minimax_dflash2.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ce53f23ec5831e2bffb9e5f0226cf95e2034e6f4
--- /dev/null
+++ b/zig/build/minimax_dflash2.zig
@@ -0,0 +1,21 @@
+//! test-minimax-dflash2: the DFlash2 draft's config, weight cuts, draft kind and float64 conv and selector; no GPU.
+const std = @import("std");
+
+pub fn step(b: *std.Build, host: std.Build.ResolvedTarget, core: *std.Build.Module, cuda: *std.Build.Module, umbrella: *std.Build.Step) *std.Build.Step {
+    const canon = b.createModule(.{ .root_source_file = b.path("zig/src/cluster/canon.zig"), .target = host, .optimize = .debug });
+    const lanes = b.createModule(.{ .root_source_file = b.path("zig/src/core/lanes/lanes.zig"), .target = host, .optimize = .debug, .link_libc = true });
+    const api = b.createModule(.{ .root_source_file = b.path("zig/src/core/engine_api.zig"), .target = host, .optimize = .debug, .link_libc = true, .imports = &.{.{ .name = "lanes", .module = lanes }} });
+    // dflash2_weights.zig loads onto a device, so the module takes the host-built cuda runtime as well
+    const family = b.createModule(.{
+        .root_source_file = b.path("zig/src/families/minimax_m3/dflash2_test.zig"),
+        .target = host,
