+// MiniMax-M3.1-Flash KV tier: horizon-exact and summary-bound block scores, candidates, rerank (mm3-kv-tier DESIGN.md).
+#include "minimax_m3_sparse.cuh"
+
+using namespace tf_mm3;
+
+namespace {
+
+/// One block's index score maximum over `valid` keys of `ik`, as tf_mm3_index computes it (all 128 threads call).
+__device__ __forceinline__ float exact_max(const bf16* __restrict__ ik, int valid, float q0, float q1, float q2,
+                                           float q3, float scale, int warp, int lane) {
+    float best = -INFINITY;
+    for (int j = warp; j < valid; j += 4) {
+        const uint2 kw = __ldg(reinterpret_cast<const uint2*>(ik + (long long)j * D) + lane);
+        float a = __fmul_rn(q0, lo(kw.x));
+        a = __fadd_rn(a, __fmul_rn(q1, hi(kw.x)));
+        a = __fadd_rn(a, __fmul_rn(q2, lo(kw.y)));
+        a = __fadd_rn(a, __fmul_rn(q3, hi(kw.y)));
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) a = __fadd_rn(a, __shfl_xor_sync(0xffffffffu, a, o));
+        best = fmaxf(best, __fmul_rn(a, scale));
+    }
+    __shared__ float part[4];
+    if (lane == 0) part[warp] = best;
+    __syncthreads();
+    return fmaxf(fmaxf(part[0], part[1]), fmaxf(part[2], part[3]));
+}
+
+__device__ __forceinline__ bool forced(int b, int own, int init_n, int init_inclusive, int local_n, int local_trailing) {
+    const bool init = init_inclusive ? b <= init_n : b < init_n;
+    const bool local = local_trailing ? (b <= own && own - b < local_n) : (local_n > 0 && b == own);
+    return init || local;
+}
+
+/// A total order equal to tf_mm3_select's `before`: the score (NaN as -inf), then the tie rule's block id.
+__device__ __forceinline__ unsigned long long rank_key(float s, int b, int higher) {
+    if (s != s) s = -INFINITY;
+    unsigned u = __float_as_uint(s);
+    u = (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+    const unsigned id = higher ? (unsigned)b : 0xffffffffu - (unsigned)b;
+    return ((unsigned long long)u << 32) | id;
+}
+
+/// The row's own block id `own` minus `horizon` and below are cold: scored by their summaries' bound.
+__device__ __forceinline__ bool cold(int b, int own, int horizon) { return b <= own - horizon; }
