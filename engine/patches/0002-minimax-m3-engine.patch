+//! TF_MM3_PROF: a decode step's or prompt chunk's time per op on each rank (prof_dev.zig reads it), saved as JSON.
+const std = @import("std");
+const plan = @import("forward_plan.zig");
+const prof_env = @import("prof_env.zig");
+
+/// The report's `format` field; report.py refuses any other.
+pub const format = "tf-mm3-prof/1";
+/// The layer of the ops before layer 0's attention (stage, embedding, zero, the first norm).
+pub const pre: i32 = -1;
+/// The layer of the head's ops (head linear, logits gather or pick).
+pub const head: i32 = -2;
+/// A gap between two decode calls this long or longer is idle time between requests, not a step's host time.
+pub const idle_ns: u64 = 2 * std.time.ns_per_s;
+
+pub const Error = error{Stale};
+
+pub const Settings = prof_env.Settings;
+
+comptime {
+    if (prof_env.max_rows != @import("iface.zig").shared_rows) @compileError("a profile times any shared window's width");
+}
+pub const Get = prof_env.Get;
+
+/// An op's place in the report: its kernel class and the layer whose time it is.
+pub const Label = struct { stage: plan.Stage, layer: i32 };
+
+/// Labels a step's ops in plan order: a closing norm, exchange or tap belongs to the layer it ends.
+pub const Labeler = struct {
+    cur: i32 = pre,
+
+    pub fn of(l: *Labeler, op: plan.Op) Label {
+        const st = plan.stageOf(op);
+        switch (op) {
+            .stage, .embed, .zero => return .{ .stage = st, .layer = pre },
+            .logits_gather, .local_pick, .pick_gather => return .{ .stage = st, .layer = head },
+            .linear => |o| {
+                if (o.w == .head) return .{ .stage = st, .layer = head };
+                l.cur = @intCast(o.layer);
+            },
+            inline .linears, .down, .index_proj, .qk_rope, .score, .select, .attend, .router, .route, .experts, .swiglu, .fork, .join => |o| l.cur = @intCast(o.layer),
+            .norm_add, .add2, .exchange, .tap => {},
+        }
+        return .{ .stage = st, .layer = l.cur };
+    }
+};
+
+/// A plan sink that only labels (no launch): the op list a timed step's events stand for.
+pub const LabelSink = struct {
+    out: []Label,
+    n: u32 = 0,
+    labeler: Labeler = .{},
+
+    pub fn emit(s: *LabelSink, op: plan.Op) !void {
+        const lab = s.labeler.of(op);
+        if (s.n < s.out.len) s.out[s.n] = lab;
+        s.n += 1;
+    }
+};
+
+/// A plan sink that counts the ops.
+pub const Count = struct {
+    n: u32 = 0,
+
+    pub fn emit(c: *Count, _: plan.Op) !void {
+        c.n += 1;
+    }
+};
+
+/// How an op's marker event is recorded: a capture keeps an external record node; eagerly the driver refuses that flag.
+pub const Record = enum { plain, external };
+
+pub fn recordFor(capturing: bool) Record {
+    return if (capturing) .external else .plain;
+}
+
+/// Op i's busy time and the idle gap before it, from event times in ms after the step's first event.
+pub fn split(stamps: []const f32, end: f32, op: []f32, gap: []f32) Error!f32 {
+    std.debug.assert(stamps.len == 2 * op.len and gap.len == op.len);
+    var prev: f32 = 0;
+    for (op, gap, 0..) |*o, *g, i| {
+        const a = stamps[2 * i];
+        const b = stamps[2 * i + 1];
+        if (a < prev or b < a) return error.Stale; // an event this step did not record (a graph without them)
+        g.* = a - prev;
+        o.* = b - a;
+        prev = b;
+    }
+    if (end < prev) return error.Stale;
+    return end - prev;
+}
+
+/// Rank 0's host draw after a timed step (draw.zig adds it while `draws_on`): the logits' fetch and the sampling.
+pub const Draws = struct {
+    n: u64 = 0,
+    fetch_ns: u64 = 0,
+    sample_ns: u64 = 0,
+};
+pub var draws: Draws = .{};
+pub var draws_on: bool = false;
+
+pub fn noteDraw(fetch_ns: u64, sample_ns: u64) void {
+    if (!draws_on) return;
+    draws.n += 1;
+    draws.fetch_ns += fetch_ns;
+    draws.sample_ns += sample_ns;
+}
+
+fn msOf(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e6;
+}
+
+/// Sums over the timed steps; every field only grows, so two saved reports subtract to the steps between them.
+pub const Agg = struct {
