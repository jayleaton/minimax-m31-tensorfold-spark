diff --git a/zig/src/families/minimax_m3/tier.zig b/zig/src/families/minimax_m3/tier.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e0a67b8314ff47d8a92847a50c793224dade43b9
--- /dev/null
+++ b/zig/src/families/minimax_m3/tier.zig
@@ -0,0 +1,452 @@
+//! MiniMax-M3.1-Flash's KV tier: virtual pages on NVMe, a GPU slice cache, an exact IK horizon and block summaries.
+const std = @import("std");
+const cuda = @import("cuda");
+const kt = cuda.minimax_m3_tier;
+const sp = cuda.minimax_m3_sparse;
+const geom = sp.geom;
+const cache_ = @import("tier_cache.zig");
+const io_ = @import("tier_io.zig");
+
+/// Open blocks a stream holds at once: a prompt chunk's pages and the partial page before it.
+pub const max_open = 20;
+
+pub const Config = struct {
+    layers: u32,
+    kvh: u32,
+    kv8: bool,
+    streams: u32,
+    max_pages: u32,
+    vpages: u32,
+    /// Blocks before a row's own block, own included, scored exactly (DESIGN.md: H / 128).
+    horizon: u32,
+    /// Cold candidates a (row, kv head) reranks.
+    m: u32 = 16,
+    /// Slots of the device slice cache.
+    slices: u32,
+    max_rows: u32,
+    path: [:0]const u8,
+    depth: u32 = 64,
+
+    pub fn sliceBytes(c: Config) u64 {
+        return (geom.Pool{ .kvh = c.kvh, .layers = 1, .kv8 = c.kv8 }).layerBytes();
+    }
+
+    fn entries(c: Config) u64 {
+        return @as(u64, c.layers) * c.streams * c.max_pages;
+    }
+
+    /// Device bytes the tier makes: slices, IK arena, summaries, both tables and the candidates.
+    pub fn deviceBytes(c: Config) u64 {
+        const ik = @as(u64, c.streams) * c.horizon * c.layers * kt.ik_bytes;
+        const cand = @as(u64, c.max_rows) * c.kvh * (geom.topk + c.m) * 4;
+        return c.slices * c.sliceBytes() + ik + @as(u64, c.vpages) * c.layers * kt.summ_bytes + 2 * c.entries() * 4 + cand + upd_entries * 16;
+    }
+};
+
+/// Patch and job entries one upload carries (more go in turns).
+const upd_entries = 1 << 16;
+/// Slices a horizon fill reads before it flushes them.
+const ring_batch = 4096;
+
+/// One stream's rows in a call: its slot, first position and row count.
+pub const Seg = struct { slot: u32, pos0: u32, rows: u32 };
+
+/// A stream's blocks being written, [lo, hi), with their virtual pages; `written` positions so far.
+const Open = struct { lo: u32 = 0, hi: u32 = 0, written: u32 = 0, vp: [max_open]u32 = undefined };
+
+pub const Stats = struct { layers: u64 = 0, cand_ns: u64 = 0, fetch_ns: u64 = 0, fetched: u64 = 0, finalized: u64 = 0, ring_fills: u64 = 0 };
+
+pub const Tier = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    st: cuda.Stream,
+    k: kt.Tier,
+    c: Config,
+    slice_bytes: u64,
+    slices: cuda.DeviceBuffer,
+    ik: cuda.DeviceBuffer,
+    summ: cuda.DeviceBuffer,
+    tabs: cuda.DeviceBuffer, // kvtab [layers][streams][max_pages], then iktab alike
+    cand: cuda.DeviceBuffer,
+    upd: cuda.DeviceBuffer,
+    cand_h: cuda.HostBuffer,
+    vtab: u64, // the engine's block table on the device: virtual page ids
+    row_tab: u64 = 0, // a shared call's per-row table offsets (the forward's mirror)
+    logical: []i32,
+    kv_m: []i32, // host copies of kvtab and iktab
+    ik_m: []i32,
+    ring: []i32, // [streams * horizon] the block a ring slot's IK holds, -1 none
+    final: std.DynamicBitSetUnmanaged, // a virtual page's summaries and file copy hold its final bytes
+    open: []Open,
+    seen: std.DynamicBitSetUnmanaged, // (stream, block) entries made resident this layer
+    cache: cache_.Cache,
+    store: io_.Store,
+    patches: std.ArrayList([2]i32) = .empty,
+    jobs: std.ArrayList([4]i32) = .empty,
+    copies: std.ArrayList([2]i32) = .empty,
+    reads: std.ArrayList(io_.Move) = .empty,
+    writes: std.ArrayList(io_.Move) = .empty,
+    held_w: std.ArrayList(u32) = .empty, // slots held until their write lands
+    segs: [32]Seg = undefined,
+    nsegs: usize = 0,
+    stats: Stats = .{},
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, st: cuda.Stream, c: Config, vtab: u64) !*Tier {
+        if (c.horizon == 0 or c.streams == 0 or c.vpages == 0) return error.BadTier;
+        const t = try gpa.create(Tier);
+        errdefer gpa.destroy(t);
+        t.* = .{ .gpa = gpa, .d = d, .st = st, .k = undefined, .c = c, .slice_bytes = c.sliceBytes(), .slices = undefined, .ik = undefined, .summ = undefined, .tabs = undefined, .cand = undefined, .upd = undefined, .cand_h = undefined, .vtab = vtab, .logical = &.{}, .kv_m = &.{}, .ik_m = &.{}, .ring = &.{}, .final = .{}, .open = &.{}, .seen = .{}, .cache = undefined, .store = undefined };
+        t.k = try kt.Tier.load(d);
+        errdefer t.k.unload();
+        t.slices = try cuda.DeviceBuffer.alloc(d, c.slices * t.slice_bytes);
+        errdefer t.slices.free();
+        try t.slices.fill8(0, null);
+        t.ik = try cuda.DeviceBuffer.alloc(d, @as(usize, c.streams) * c.horizon * c.layers * kt.ik_bytes);
+        errdefer t.ik.free();
+        t.summ = try cuda.DeviceBuffer.alloc(d, @as(usize, c.vpages) * c.layers * kt.summ_bytes);
+        errdefer t.summ.free();
+        t.tabs = try cuda.DeviceBuffer.alloc(d, 2 * c.entries() * 4);
+        errdefer t.tabs.free();
+        try t.tabs.fill32(0xffff_ffff, null);
+        t.cand = try cuda.DeviceBuffer.alloc(d, @as(usize, c.max_rows) * c.kvh * (geom.topk + c.m) * 4);
+        errdefer t.cand.free();
+        t.upd = try cuda.DeviceBuffer.alloc(d, upd_entries * 16);
+        errdefer t.upd.free();
+        t.cand_h = try cuda.HostBuffer.alloc(d, t.cand.len);
+        errdefer t.cand_h.free();
+        try t.hostInit();
+        errdefer t.hostDeinit();
+        t.cache = try cache_.Cache.init(gpa, c.vpages, c.layers, c.slices);
+        errdefer t.cache.deinit();
+        t.store = try io_.Store.open(d, c.path, .{ .slice_bytes = t.slice_bytes, .layers = c.layers, .vpages = c.vpages, .depth = c.depth });
+        return t;
+    }
+
+    fn hostInit(t: *Tier) !void {
+        const c = t.c;
+        t.logical = try t.gpa.alloc(i32, @as(usize, c.streams) * c.max_pages);
+        @memset(t.logical, -1);
+        t.kv_m = try t.gpa.alloc(i32, @intCast(c.entries()));
+        @memset(t.kv_m, -1);
+        t.ik_m = try t.gpa.alloc(i32, @intCast(c.entries()));
+        @memset(t.ik_m, -1);
+        t.ring = try t.gpa.alloc(i32, @as(usize, c.streams) * c.horizon);
+        @memset(t.ring, -1);
+        t.final = try .initEmpty(t.gpa, c.vpages);
+        t.seen = try .initEmpty(t.gpa, @as(usize, c.streams) * c.max_pages);
+        t.open = try t.gpa.alloc(Open, c.streams);
+        @memset(t.open, .{});
+    }
+
+    fn hostDeinit(t: *Tier) void {
+        t.gpa.free(t.logical);
+        t.gpa.free(t.kv_m);
+        t.gpa.free(t.ik_m);
+        t.gpa.free(t.ring);
+        t.final.deinit(t.gpa);
+        t.seen.deinit(t.gpa);
+        t.gpa.free(t.open);
+    }
+
+    pub fn deinit(t: *Tier) void {
+        t.st.synchronize() catch {};
+        t.store.close();
+        t.cache.deinit();
+        t.hostDeinit();
+        inline for (.{ "patches", "jobs", "copies", "reads", "writes", "held_w" }) |f| @field(t, f).deinit(t.gpa);
+        t.cand_h.free();
+        t.upd.free();
+        t.cand.free();
+        t.tabs.free();
+        t.summ.free();
+        t.ik.free();
+        t.slices.free();
+        t.k.unload();
+        t.gpa.destroy(t);
+    }
+
+    fn entry(t: *const Tier, l: u32, s: u32, b: u32) usize {
+        return (@as(usize, l) * t.c.streams + s) * t.c.max_pages + b;
+    }
+
+    fn vpageOf(t: *const Tier, s: u32, b: u32) !u32 {
+        const v = t.logical[@as(usize, s) * t.c.max_pages + b];
+        return if (v < 0) error.NoPage else @intCast(v);
+    }
+
+    fn slotAddr(t: *const Tier, slot: u32) u64 {
+        return t.slices.ptr + slot * t.slice_bytes;
+    }
+
+    fn setKv(t: *Tier, e: usize, v: i32) !void {
+        if (t.kv_m[e] == v) return;
+        t.kv_m[e] = v;
+        try t.patches.append(t.gpa, .{ @intCast(e), v });
+    }
+
+    fn setIk(t: *Tier, e: usize, v: i32) !void {
+        if (t.ik_m[e] == v) return;
+        t.ik_m[e] = v;
+        try t.patches.append(t.gpa, .{ @intCast(t.c.entries() + e), v });
+    }
+
+    /// The engine's block-table write on this rank: kept here too; a stream whose open pages change is closed.
+    pub fn putLogical(t: *Tier, slot: u32, from: usize, entries_: []const i32) void {
+        const row = t.logical[@as(usize, slot) * t.c.max_pages ..][0..t.c.max_pages];
+        const o = &t.open[slot];
+        var closes = false;
+        for (entries_, from..) |v, b| {
+            if (b >= o.lo and b < o.hi and row[b] != v) closes = true;
+            row[b] = v;
+        }
+        if (closes) t.closeStream(slot);
+    }
+
+    /// The stream's open blocks go (their bytes were never final) and its horizon ring empties.
+    pub fn closeStream(t: *Tier, s: u32) void {
+        const o = &t.open[s];
+        for (o.lo..o.hi) |b| {
+            const vp = o.vp[b - o.lo];
+            for (0..t.c.layers) |l| if (t.cache.lookup(vp, @intCast(l))) |slot| {
+                t.cache.unhold(slot);
+                t.cache.drop(vp, @intCast(l));
+            };
+        }
+        o.* = .{};
+        @memset(t.ring[@as(usize, s) * t.c.horizon ..][0..t.c.horizon], -1);
+    }
+
+    /// Before a call: final pages finished, the rows' pages resident and held, the horizon's IK in the arena.
+    pub fn begin(t: *Tier, segs: []const Seg) !void {
+        if (segs.len > t.segs.len) return error.BadCall;
+        @memcpy(t.segs[0..segs.len], segs);
+        t.nsegs = segs.len;
+        t.cache.nextEpoch();
+        for (segs) |g| {
+            const o = &t.open[g.slot];
+            if (g.pos0 < o.lo * geom.block) t.closeStream(g.slot); // a new stream on the slot, or one rewound past its open pages
+            if (o.hi == o.lo) {
+                o.lo = g.pos0 / geom.block;
+                o.hi = o.lo;
+            }
+            try t.finishTo(g.slot, g.pos0 / geom.block);
+            try t.openRows(g);
+            try t.fillRing(g.slot, g.pos0 / geom.block);
+        }
+        try t.flush();
+    }
+
+    /// After a call: a prompt chunk's rows are final, so its whole pages finish now (the prompt cache may keep them).
+    pub fn end(t: *Tier, prompt: bool) !void {
+        if (!prompt) return;
+        for (t.segs[0..t.nsegs]) |g| try t.finishTo(g.slot, (g.pos0 + g.rows) / geom.block);
+        try t.flush();
+    }
+
+    /// Open blocks of `s` below `to` finish: summaries, a file copy, their holds released once written.
+    fn finishTo(t: *Tier, s: u32, to: u32) !void {
+        const o = &t.open[s];
+        while (o.lo < @min(o.hi, to)) {
+            const vp = o.vp[0];
+            for (0..t.c.layers) |li| {
+                const l: u32 = @intCast(li);
+                const slot = t.cache.lookup(vp, l) orelse return error.OpenSliceLost;
+                try t.jobs.append(t.gpa, .{ @intCast(slot), @intCast(vp), @intCast(l), -1 });
+                try t.writes.append(t.gpa, .{ .vpage = vp, .layer = l, .dev = t.slotAddr(slot) });
+                try t.held_w.append(t.gpa, slot);
+            }
+            t.final.set(vp);
+            std.mem.copyForwards(u32, o.vp[0 .. o.hi - o.lo - 1], o.vp[1 .. o.hi - o.lo]);
+            o.lo += 1;
+            t.stats.finalized += 1;
+        }
+        if (o.lo > o.hi) o.hi = o.lo;
+    }
+
+    /// The pages the call's rows write, resident and held for every layer; their IK is read from the slices.
+    fn openRows(t: *Tier, g: Seg) !void {
+        const o = &t.open[g.slot];
+        const b0 = g.pos0 / geom.block;
+        const b1 = (g.pos0 + g.rows - 1) / geom.block;
+        var b = b0;
+        while (b <= b1) : (b += 1) {
+            const vp = try t.vpageOf(g.slot, b);
+            if (b >= o.hi) {
+                if (b != o.hi) return error.OpenGap;
+                if (b * geom.block < g.pos0) return error.PartialPageNotOpen;
+                if (o.hi - o.lo >= max_open) return error.TooManyOpen;
+                o.vp[o.hi - o.lo] = vp;
+                o.hi += 1;
+                t.final.unset(vp);
+                for (0..t.c.layers) |l| t.cache.hold((try t.cache.take(vp, @intCast(l))).slot); // fresh: written before read
+            }
+            for (0..t.c.layers) |li| {
+                const l: u32 = @intCast(li);
+                const slot = t.cache.lookup(vp, l) orelse return error.OpenSliceLost;
+                const e = t.entry(l, g.slot, b);
+                try t.setKv(e, @intCast(slot));
+                try t.setIk(e, -2);
+            }
+        }
+        o.written = @max(o.written, g.pos0 + g.rows);
+    }
+
+    /// The final blocks within the horizon of a row at block `own`: their IK in the stream's ring of the arena.
+    fn fillRing(t: *Tier, s: u32, own: u32) !void {
+        const h = t.c.horizon;
+        const first = (own + 1) -| h;
+        var b = first;
+        while (b < own and b < t.open[s].lo) : (b += 1) {
+            const ri = @as(usize, s) * h + b % h;
+            const vp = try t.vpageOf(s, b);
+            if (!t.final.isSet(vp)) return error.PageNotFinal;
+            const fresh = t.ring[ri] != @as(i32, @intCast(b));
+            for (0..t.c.layers) |li| {
+                const l: u32 = @intCast(li);
+                const arena: i32 = @intCast(ri * t.c.layers + l);
+                if (fresh) {
+                    const r = try t.cache.take(vp, l);
+                    if (r.miss) try t.reads.append(t.gpa, .{ .vpage = vp, .layer = l, .dev = t.slotAddr(r.slot) });
+                    try t.copies.append(t.gpa, .{ @intCast(r.slot), arena });
+                }
+                try t.setIk(t.entry(l, s, b), arena);
+            }
+            if (fresh) t.stats.ring_fills += 1;
+            t.ring[ri] = @intCast(b);
+            // a horizon filled in turns, a quarter of the cache pinned at most: the stream orders reuse of the slots
+            if (t.reads.items.len >= ring_batch or t.copies.items.len >= @max(t.c.layers, t.cache.count() / 4)) {
+                try t.flush();
+                t.cache.nextEpoch();
+            }
+        }
+    }
+
+    /// Queued reads, summaries, IK copies, write-backs and table patches, in that order on the stream.
+    fn flush(t: *Tier) !void {
+        const tb = t.tables(0, true, 0);
+        try t.store.read(t.st, t.reads.items);
+        t.reads.clearRetainingCapacity();
+        try t.uploadRun(t.jobs.items, struct {
+            fn f(tt: *Tier, dev: u64, n: usize, x: kt.Tables) !void {
+                try tt.k.summarize(tt.st, dev, n, x);
+            }
+        }.f, tb);
+        t.jobs.clearRetainingCapacity();
+        try t.uploadRun(t.copies.items, struct {
+            fn f(tt: *Tier, dev: u64, n: usize, x: kt.Tables) !void {
+                try tt.k.ikCopy(tt.st, dev, n, x);
+            }
+        }.f, tb);
+        t.copies.clearRetainingCapacity();
+        try t.store.write(t.st, t.writes.items);
+        t.writes.clearRetainingCapacity();
+        for (t.held_w.items) |slot| t.cache.unhold(slot);
+        t.held_w.clearRetainingCapacity();
+        try t.applyPatches();
+    }
+
+    fn uploadRun(t: *Tier, items: anytype, comptime run: anytype, tb: kt.Tables) !void {
+        const per = upd_entries * 16 / @sizeOf(@TypeOf(items[0]));
+        var at: usize = 0;
+        while (at < items.len) {
+            const n = @min(per, items.len - at);
+            try cuda.copy_source.enqueue(t.d, t.upd.ptr, std.mem.sliceAsBytes(items[at..][0..n]), t.st);
+            try run(t, t.upd.ptr, n, tb);
+            at += n;
+        }
+    }
+
+    fn applyPatches(t: *Tier) !void {
+        try t.uploadRun(t.patches.items, struct {
+            fn f(tt: *Tier, dev: u64, n: usize, _: kt.Tables) !void {
+                try tt.k.patch(tt.st, tt.tabs.ptr, dev, n);
+            }
+        }.f, t.tables(0, true, 0));
+        t.patches.clearRetainingCapacity();
+    }
+
+    /// Layer `l`'s tables for a call: one stream's rows (`slot`) or a shared call's rows through `row_tab`.
+    pub fn tables(t: *const Tier, l: u32, shared: bool, slot: u32) kt.Tables {
+        const s: u32 = if (shared) 0 else slot;
+        const kv = t.tabs.ptr + t.entry(l, s, 0) * 4;
+        return .{
+            .vtab = t.vtab + @as(u64, s) * t.c.max_pages * 4,
+            .kvtab = kv,
+            .iktab = kv + t.c.entries() * 4,
+            .row_tab = if (shared) t.row_tab else 0,
+            .slices = t.slices.ptr,
+            .slice_bytes = t.slice_bytes,
+            .ik_arena = t.ik.ptr,
+            .summ = t.summ.ptr,
+            .layers = t.c.layers,
+            .layer = l,
+            .kvh = t.c.kvh,
+            .kv8 = t.c.kv8,
+            .horizon = t.c.horizon,
+            .m = t.c.m,
+        };
+    }
+
+    /// The paged view qk_rope and attend address: the slice arena through layer `l`'s slot table.
+    pub fn paged(t: *const Tier, l: u32, shared: bool, slot: u32) sp.Paged {
+        const tb = t.tables(l, shared, slot);
+        return .{ .pool = t.slices.ptr, .page_bytes = t.slice_bytes, .layer_off = 0, .kvh = t.c.kvh, .tables = tb.kvtab, .row_tab = tb.row_tab, .kv8 = t.c.kv8 };
+    }
+
+    /// Layer `l`'s block maxima as the select kernel reads them, with every block it may select made resident.
+    pub fn score(t: *Tier, l: u32, iq: u64, rows: sp.Rows, sc: sp.Scratch, max_pos: usize, scale: f32, shared: bool, slot: u32) !void {
+        const tb = t.tables(l, shared, slot);
+        const rules: geom.Rules = .{};
+        try t.k.index(t.st, iq, rows, tb, sc, max_pos, scale);
+        try t.k.candidates(t.st, rows, tb, sc, t.cand.ptr, rules);
+        const per = geom.topk + t.c.m;
+        const n = rows.n * t.c.kvh * per;
+        const t0 = now();
+        try t.d.check(t.d.api.cuMemcpyDtoHAsync_v2(t.cand_h.bytes.ptr, t.cand.ptr, n * 4, t.st.handle), "cuMemcpyDtoHAsync");
+        try t.st.synchronize();
+        const t1 = now();
+        t.cache.nextEpoch();
+        const cand = t.cand_h.slice(i32)[0..n];
+        var touched: std.ArrayList(usize) = .empty;
+        defer touched.deinit(t.gpa);
+        var r: usize = 0;
+        for (t.segs[0..t.nsegs]) |g| for (0..g.rows) |_| {
+            for (cand[r * t.c.kvh * per ..][0 .. t.c.kvh * per]) |cb| {
+                if (cb < 0) continue;
+                const b: u32 = @intCast(cb);
+                const se = @as(usize, g.slot) * t.c.max_pages + b;
+                if (t.seen.isSet(se)) continue;
+                t.seen.set(se);
+                try touched.append(t.gpa, se);
+                const vp = try t.vpageOf(g.slot, b);
+                const got = try t.cache.take(vp, l);
+                if (got.miss) try t.reads.append(t.gpa, .{ .vpage = vp, .layer = l, .dev = t.slotAddr(got.slot) });
+                try t.setKv(t.entry(l, g.slot, b), @intCast(got.slot));
+            }
+            r += 1;
+        };
+        for (touched.items) |se| t.seen.unset(se);
+        t.stats.fetched += t.reads.items.len;
+        try t.store.read(t.st, t.reads.items);
+        t.reads.clearRetainingCapacity();
+        try t.applyPatches();
+        try t.k.rerank(t.st, iq, rows, tb, sc, t.cand.ptr, max_pos, scale, rules);
+        t.stats.layers += 1;
+        t.stats.cand_ns += t1 - t0;
+        t.stats.fetch_ns += now() - t1;
+    }
+};
+
+fn now() u64 {
+    var ts: std.os.linux.timespec = undefined;
+    _ = std.os.linux.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+test {
+    _ = @import("tier_cache.zig");
+    _ = @import("tier_settings.zig");
+    _ = @import("tier_pool.zig");
+    _ = @import("tier_io.zig");
+    _ = @import("tier_admit_test.zig");
+}
diff --git a/zig/src/families/minimax_m3/tier_admit_test.zig b/zig/src/families/minimax_m3/tier_admit_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d81d5ec6ae214df2658ec33b1f3e11896e021d10
--- /dev/null
+++ b/zig/src/families/minimax_m3/tier_admit_test.zig
@@ -0,0 +1,52 @@
+//! The KV tier's admission is a fixed point: the context it admits, asked again, is admitted with the same cache.
+const std = @import("std");
+const native = @import("native.zig");
+const budget = @import("budget.zig");
+const pool = @import("pool.zig");
+const tier_settings = @import("tier_settings.zig");
+
+const GiB = budget.GiB;
+
+/// One TP2 rank of the shipped model with fp8 K/V, the budget the combined window's Spark 1 showed (107.96 GiB).
+fn input(lanes: u32) budget.Input {
+    const dims = rank();
+    return .{ .available = 107 * GiB + GiB * 96 / 100, .weights = 92 * GiB + GiB * 62 / 100, .terms = native.scoreTerms(budget.hosted(), dims), .lanes = lanes, .lanes_fixed = true, .window = native.window_rows };
+}
+
+fn rank() pool.Dims {
+    return .{ .layers = 60, .kv_heads = 2, .head_dim = 128, .index_dim = 128, .kv8 = true };
+}
+
+fn admit(context: usize, lanes: u32, horizon: u32) native.Admission {
+    var t: tier_settings.Tier = .{ .dir = "/kvtier", .gib = 252, .horizon = horizon, .m = 16 };
+    t.exact(native.capacity(context));
+    const blank: native.Admission = .{ .place = .{ .rank = 0, .world = 2 }, .weights = input(lanes).weights, .verdict = null, .fingerprint_weights = @splat(0) };
+    return native.tierAdmission(blank, rank(), t.cost(60).?, t.m, input(lanes), context);
+}
+
+fn expectFixedPoint(context: usize, lanes: u32, horizon: u32) !void {
+    const a = admit(context, lanes, horizon);
+    const cap = switch (a.verdict.?) {
+        .ok => |c| c,
+        .refused => |r| {
+            std.debug.print("refused {d} x {d}: largest {d}, need {d} room {d}\n", .{ lanes, context, r.largest, r.need_bytes, r.room_bytes });
+            return error.TestUnexpectedResult;
+        },
+    };
+    try std.testing.expectEqual(@as(u64, context), cap.context);
+    try std.testing.expect(a.tier_cache > 0);
+    const again = admit(cap.context, lanes, horizon);
+    try std.testing.expect(again.verdict.? == .ok);
+    try std.testing.expectEqual(a.tier_cache, again.tier_cache);
+}
+
+test "kv tier admission: the window's contexts are admitted as asked, and the admitted context again (exact mode)" {
+    try expectFixedPoint(262144, 1, 0);
+    try expectFixedPoint(262128, 1, 0);
+    try expectFixedPoint(120832, 1, 0);
+    try expectFixedPoint(131072, 1, 0);
+}
+
+test "kv tier admission: 4 x 1M with a 32K horizon is admitted as asked, and again" {
+    try expectFixedPoint(1048576, 4, 32768);
+}
diff --git a/zig/src/families/minimax_m3/tier_cache.zig b/zig/src/families/minimax_m3/tier_cache.zig
new file mode 100644
index 0000000000000000000000000000000000000000..22195f39797ccb7cfede0a48695146b04e7da708
--- /dev/null
+++ b/zig/src/families/minimax_m3/tier_cache.zig
@@ -0,0 +1,155 @@
+//! The KV tier's host map of (virtual page, layer) slices to device slots: clock eviction, layer pins, holds.
+const std = @import("std");
+
+const none: u32 = std.math.maxInt(u32);
+
+pub const Error = error{CacheFull};
+
+/// Slots of the device slice arena and the slice each holds; `slot_of` answers which slot a slice is in.
+pub const Cache = struct {
+    gpa: std.mem.Allocator,
+    layers: u32,
+    slot_of: []i32, // [vpages * layers] slot or -1
+    owner: []u32, // [slots] key (vpage * layers + layer) or none
+    ref: []bool, // [slots] the clock's second chance
+    held: []u16, // [slots] long pins: a block being written, a slice waiting for its write-back
+    epoch_of: []u32, // [slots] the epoch the slice was last pinned in: no eviction within it
+    epoch: u32 = 1,
+    hand: u32 = 0,
+    used: u32 = 0,
+    stats: Stats = .{},
+
+    pub const Stats = struct { hits: u64 = 0, misses: u64 = 0, fresh: u64 = 0, evictions: u64 = 0 };
+
+    pub fn init(gpa: std.mem.Allocator, vpages: u32, layers: u32, slots: u32) !Cache {
+        const slot_of = try gpa.alloc(i32, @as(usize, vpages) * layers);
+        errdefer gpa.free(slot_of);
+        @memset(slot_of, -1);
+        const owner = try gpa.alloc(u32, slots);
+        errdefer gpa.free(owner);
+        @memset(owner, none);
+        const ref = try gpa.alloc(bool, slots);
+        errdefer gpa.free(ref);
+        @memset(ref, false);
+        const held = try gpa.alloc(u16, slots);
+        errdefer gpa.free(held);
+        @memset(held, 0);
+        const epoch_of = try gpa.alloc(u32, slots);
+        @memset(epoch_of, 0);
+        return .{ .gpa = gpa, .layers = layers, .slot_of = slot_of, .owner = owner, .ref = ref, .held = held, .epoch_of = epoch_of };
+    }
+
+    pub fn deinit(c: *Cache) void {
+        c.gpa.free(c.slot_of);
+        c.gpa.free(c.owner);
+        c.gpa.free(c.ref);
+        c.gpa.free(c.held);
+        c.gpa.free(c.epoch_of);
+        c.* = undefined;
+    }
+
+    pub fn count(c: *const Cache) u32 {
+        return @intCast(c.owner.len);
+    }
+
+    pub fn key(c: *const Cache, vpage: u32, layer: u32) u32 {
+        return vpage * c.layers + layer;
+    }
+
+    /// A new epoch: the last one's pins end (holds stay).
+    pub fn nextEpoch(c: *Cache) void {
+        c.epoch +%= 1;
+        if (c.epoch == 0) c.epoch = 1;
+    }
+
+    /// The slot holding the slice, pinned for this epoch; null on a miss.
+    pub fn lookup(c: *Cache, vpage: u32, layer: u32) ?u32 {
+        const s = c.slot_of[c.key(vpage, layer)];
+        if (s < 0) return null;
+        const slot: u32 = @intCast(s);
+        c.ref[slot] = true;
+        c.epoch_of[slot] = c.epoch;
+        return slot;
+    }
+
+    /// The slice's slot, pinned for this epoch: `.miss` when it was not resident and its bytes must be read or made.
+    pub fn take(c: *Cache, vpage: u32, layer: u32) Error!struct { slot: u32, miss: bool } {
+        if (c.lookup(vpage, layer)) |s| {
+            c.stats.hits += 1;
+            return .{ .slot = s, .miss = false };
+        }
+        const slot = try c.victim();
+        const k = c.key(vpage, layer);
+        c.owner[slot] = k;
+        c.slot_of[k] = @intCast(slot);
+        c.ref[slot] = true;
+        c.epoch_of[slot] = c.epoch;
+        c.stats.misses += 1;
+        return .{ .slot = slot, .miss = true };
+    }
+
+    /// A free slot, else the clock's next unpinned and unheld one, its slice forgotten.
+    fn victim(c: *Cache) Error!u32 {
+        const n = c.count();
+        if (c.used < n) {
+            c.used += 1;
+            return c.used - 1;
+        }
+        var tries: u64 = 0;
+        while (tries < 2 * @as(u64, n) + 1) : (tries += 1) {
+            const s = c.hand;
+            c.hand = if (c.hand + 1 == n) 0 else c.hand + 1;
+            if (c.held[s] > 0 or c.epoch_of[s] == c.epoch) continue;
+            if (c.ref[s]) {
+                c.ref[s] = false;
+                continue;
+            }
+            if (c.owner[s] != none) c.slot_of[c.owner[s]] = -1;
+            c.owner[s] = none;
+            c.stats.evictions += 1;
+            return s;
+        }
+        return error.CacheFull;
+    }
+
+    pub fn hold(c: *Cache, slot: u32) void {
+        c.held[slot] += 1;
+    }
+
+    pub fn unhold(c: *Cache, slot: u32) void {
+        std.debug.assert(c.held[slot] > 0);
+        c.held[slot] -= 1;
+    }
+
+    /// Forgets the slice (its bytes are stale); a held slot stays held for its holder to release.
+    pub fn drop(c: *Cache, vpage: u32, layer: u32) void {
+        const k = c.key(vpage, layer);
+        const s = c.slot_of[k];
+        if (s < 0) return;
+        c.slot_of[k] = -1;
+        c.owner[@intCast(s)] = none;
+        c.ref[@intCast(s)] = false;
+    }
+};
+
+test "tier cache: hits pin for the epoch, the clock skips pinned and held slots, a full epoch refuses" {
+    const gpa = std.testing.allocator;
+    var c = try Cache.init(gpa, 8, 2, 3);
+    defer c.deinit();
+    const a = try c.take(0, 0);
+    const b = try c.take(0, 1);
+    const d = try c.take(1, 0);
+    try std.testing.expect(a.miss and b.miss and d.miss);
+    try std.testing.expectError(error.CacheFull, c.take(2, 0)); // all three pinned in this epoch
+    c.nextEpoch();
+    c.hold(a.slot);
+    try std.testing.expectEqual(a.slot, (try c.take(0, 0)).slot);
+    const e = try c.take(2, 0); // evicts b or d, never the held a
+    try std.testing.expect(e.miss and e.slot != a.slot);
+    try std.testing.expectEqual(@as(?u32, a.slot), c.lookup(0, 0));
+    try std.testing.expect(c.lookup(0, 1) == null or c.lookup(1, 0) == null);
+    c.drop(0, 0);
+    try std.testing.expectEqual(@as(?u32, null), c.lookup(0, 0));
+    c.unhold(a.slot);
+    try std.testing.expectEqual(@as(u64, 1), c.stats.evictions);
+}
diff --git a/zig/src/families/minimax_m3/tier_io.zig b/zig/src/families/minimax_m3/tier_io.zig
new file mode 100644
index 0000000000000000000000000000000000000000..3551a931720cba4cd48af30ce5a8a83c534bfb3a
--- /dev/null
+++ b/zig/src/families/minimax_m3/tier_io.zig
@@ -0,0 +1,237 @@
+//! The KV tier's NVMe file: one O_DIRECT file a rank of 4 KiB-aligned slices, batched through io_uring and staging.
+const std = @import("std");
+const cuda = @import("cuda");
+const linux = std.os.linux;
+
+/// One slice to move: its virtual page and layer, and its device address.
+pub const Move = struct { vpage: u32, layer: u32, dev: u64 };
+
+pub const Error = error{ OpenFailed, NoSpaceLeft, ReadFailed, WriteFailed, ShortRead, IoSetup };
+
+pub const Options = struct {
+    /// Bytes of one slice on the device, and the layers of a virtual page.
+    slice_bytes: u64,
+    layers: u32,
+    vpages: u32,
+    /// Slices the pinned staging holds at once (the queue depth).
+    depth: u32 = 64,
+};
+
+/// Threads a batch takes without io_uring: NVMe needs ~16-32 requests in flight for its bandwidth.
+const threads = 16;
+
+pub const Stats = struct { read_bytes: u64 = 0, write_bytes: u64 = 0, reads: u64 = 0, writes: u64 = 0, read_ns: u64 = 0, write_ns: u64 = 0 };
+
+pub const Store = struct {
+    fd: linux.fd_t,
+    direct: bool,
+    /// null: io_uring is not allowed here (a container's default seccomp profile, io_uring_disabled): threads pread
+    ring: ?linux.IoUring,
+    stage: cuda.HostBuffer,
+    o: Options,
+    stride: u64,
+    stats: Stats = .{},
+
+    /// Opens (creating) `path` and reserves room for every virtual page; staging of `o.depth` slices.
+    pub fn open(d: *const cuda.Driver, path: [:0]const u8, o: Options) !Store {
+        const stride = std.mem.alignForward(u64, o.slice_bytes, 4096);
+        var flags: linux.O = .{ .ACCMODE = .RDWR, .CREAT = true, .CLOEXEC = true, .DIRECT = true };
+        var rc = linux.openat(linux.AT.FDCWD, path, flags, 0o644);
+        var direct = true;
+        if (linux.errno(rc) == .INVAL) { // a filesystem without O_DIRECT: buffered (the page cache grows)
+            flags.DIRECT = false;
+            direct = false;
+            rc = linux.openat(linux.AT.FDCWD, path, flags, 0o644);
+        }
+        if (linux.errno(rc) != .SUCCESS) return error.OpenFailed;
+        const fd: linux.fd_t = @intCast(rc);
+        errdefer _ = linux.close(fd);
+        const total: i64 = @intCast(stride * o.layers * o.vpages);
+        switch (linux.errno(linux.fallocate(fd, 0, 0, total))) {
+            .SUCCESS => {},
+            .NOSPC => return error.NoSpaceLeft,
+            else => if (linux.errno(linux.ftruncate(fd, total)) != .SUCCESS) return error.OpenFailed,
+        }
+        const off = if (std.c.getenv("TF_MM3_KV_TIER_URING")) |v| std.mem.eql(u8, std.mem.span(v), "0") else false;
+        var ring: ?linux.IoUring = if (off) null else linux.IoUring.init(@intCast(std.math.ceilPowerOfTwoAssert(u32, o.depth)), 0) catch |e| blk: {
+            std.log.warn("minimax KV tier: io_uring unavailable ({s}: a container's seccomp profile blocks it by default); {d} threads pread and pwrite instead", .{ @errorName(e), threads });
+            break :blk null;
+        };
+        if (off) std.log.info("minimax KV tier: TF_MM3_KV_TIER_URING=0: {d} threads pread and pwrite", .{threads});
+        errdefer if (ring) |*r| r.deinit();
+        const stage = try cuda.HostBuffer.alloc(d, @intCast(stride * o.depth));
+        return .{ .fd = fd, .direct = direct, .ring = ring, .stage = stage, .o = o, .stride = stride };
+    }
+
+    pub fn close(s: *Store) void {
+        s.stage.free();
+        if (s.ring) |*r| r.deinit();
+        _ = linux.close(s.fd);
+        s.* = undefined;
+    }
+
+    pub fn offset(s: *const Store, vpage: u32, layer: u32) u64 {
+        return (@as(u64, vpage) * s.o.layers + layer) * s.stride;
+    }
+
+    fn stageAt(s: *Store, i: usize) []u8 {
+        return s.stage.bytes[i * s.stride ..][0..s.stride];
+    }
+
+    /// Reads `moves` from the file into their device slots on `st` (the copies are queued when this returns).
+    pub fn read(s: *Store, st: cuda.Stream, moves: []const Move) !void {
+        const t0 = now();
+        var at: usize = 0;
+        while (at < moves.len) {
+            const n = @min(moves.len - at, s.o.depth);
+            if (at > 0) try st.synchronize(); // the last batch's copies out of the staging have landed
+            try s.batch(moves[at..][0..n], false);
+            for (moves[at..][0..n], 0..) |m, i| try s.stage.d.check(s.stage.d.api.cuMemcpyHtoDAsync_v2(m.dev, s.stageAt(i).ptr, s.o.slice_bytes, st.handle), "cuMemcpyHtoDAsync");
+            at += n;
+        }
+        s.stats.reads += moves.len;
+        s.stats.read_bytes += moves.len * s.stride;
+        s.stats.read_ns += now() - t0;
+    }
+
+    /// Writes `moves` from their device slots to the file; returns once every write has landed.
+    pub fn write(s: *Store, st: cuda.Stream, moves: []const Move) !void {
+        const t0 = now();
+        var at: usize = 0;
+        while (at < moves.len) {
+            const n = @min(moves.len - at, s.o.depth);
+            for (moves[at..][0..n], 0..) |m, i| try s.stage.d.check(s.stage.d.api.cuMemcpyDtoHAsync_v2(s.stageAt(i).ptr, m.dev, s.o.slice_bytes, st.handle), "cuMemcpyDtoHAsync");
+            try st.synchronize();
+            try s.batch(moves[at..][0..n], true);
+            at += n;
+        }
+        s.stats.writes += moves.len;
+        s.stats.write_bytes += moves.len * s.stride;
+        s.stats.write_ns += now() - t0;
+    }
+
+    /// One batch of whole slices between the file and staging slots 0.. (write: staging to file), every one landed.
+    fn batch(s: *Store, moves: []const Move, write_: bool) !void {
+        const fail: Error = if (write_) error.WriteFailed else error.ReadFailed;
+        if (s.ring) |*r| {
+            for (moves, 0..) |m, i| {
+                const off = s.offset(m.vpage, m.layer);
+                _ = (if (write_) r.write(i, s.fd, s.stageAt(i), off) else r.read(i, s.fd, .{ .buffer = s.stageAt(i) }, off)) catch return fail;
+            }
+            return s.complete(r, moves.len, s.stride, fail);
+        }
+        return spread(s.fd, s.stage.bytes, s.stride, s.o.layers, moves, write_, fail);
+    }
+
+    /// Submits the queued entries and waits for `n` completions of `len` bytes each.
+    fn complete(s: *Store, ring: *linux.IoUring, n: usize, len: u64, fail: Error) !void {
+        _ = s;
+        _ = ring.submit_and_wait(@intCast(n)) catch return fail;
+        var got: usize = 0;
+        while (got < n) : (got += 1) {
+            const cqe = ring.copy_cqe() catch return fail;
+            if (cqe.res < 0) return if (-cqe.res == @backingInt(linux.E.NOSPC)) error.NoSpaceLeft else fail;
+            if (@as(u64, @intCast(cqe.res)) != len) return if (fail == error.ReadFailed) error.ShortRead else fail;
+        }
+    }
+};
+
+/// The batch without io_uring: worker t of k moves slices t, t+k, ..; default stacks (glibc: >= PTHREAD_STACK_MIN)
+fn spread(fd: linux.fd_t, stage: []u8, stride: u64, layers: u32, moves: []const Move, write_: bool, fail: Error) Error!void {
+    const job: Job = .{ .fd = fd, .stage = stage, .stride = stride, .layers = layers, .moves = moves, .write_ = write_ };
+    var errs: [threads]?Error = @splat(null);
+    var pool: [threads]?std.Thread = @splat(null);
+    const k = @min(threads, moves.len);
+    for (0..k) |t| pool[t] = std.Thread.spawn(.{}, Job.run, .{ &job, t, k, &errs[t] }) catch blk: {
+        job.run(t, k, &errs[t]); // no thread: this one does its share
+        break :blk null;
+    };
+    for (pool[0..k]) |th| if (th) |x| x.join();
+    for (errs[0..k]) |e| if (e) |x| return if (x == error.NoSpaceLeft or x == error.ShortRead) x else fail;
+}
+
+const Job = struct {
+    fd: linux.fd_t,
+    stage: []u8,
+    stride: u64,
+    layers: u32,
+    moves: []const Move,
+    write_: bool,
+
+    fn run(j: *const Job, t: usize, k: usize, err: *?Error) void {
+        var i = t;
+        while (i < j.moves.len) : (i += k) {
+            const off = (@as(u64, j.moves[i].vpage) * j.layers + j.moves[i].layer) * j.stride;
+            const buf = j.stage[i * j.stride ..][0..j.stride];
+            (if (j.write_) pwriteAll(j.fd, buf, off) else preadAll(j.fd, buf, off)) catch |e| {
+                err.* = e;
+                return;
+            };
+        }
+    }
+};
+
+/// Reads `out.len` bytes at `off` (a short file is an error).
+pub fn preadAll(fd: linux.fd_t, out: []u8, off: u64) Error!void {
+    var done: usize = 0;
+    while (done < out.len) {
+        const rc = linux.pread(fd, out[done..].ptr, out.len - done, @intCast(off + done));
+        switch (linux.errno(rc)) {
+            .SUCCESS => if (rc == 0) return error.ShortRead,
+            .INTR => continue,
+            else => return error.ReadFailed,
+        }
+        done += rc;
+    }
+}
+
+/// Writes all of `data` at `off`.
+pub fn pwriteAll(fd: linux.fd_t, data: []const u8, off: u64) Error!void {
+    var done: usize = 0;
+    while (done < data.len) {
+        const rc = linux.pwrite(fd, data[done..].ptr, data.len - done, @intCast(off + done));
+        switch (linux.errno(rc)) {
+            .SUCCESS => if (rc == 0) return error.WriteFailed,
+            .INTR => continue,
+            .NOSPC => return error.NoSpaceLeft,
+            else => return error.WriteFailed,
+        }
+        done += rc;
+    }
+}
+
+fn now() u64 {
+    var ts: linux.timespec = undefined;
+    _ = linux.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+test "tier io without io_uring: the threads write and read back every slice; past the file is a short read" {
+    // window-all-3: a 64 KiB stack is below aarch64 glibc's PTHREAD_STACK_MIN: spawn's assert panicked
+    const gpa = std.testing.allocator;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const root = try tmp.dir.realPathFileAlloc(std.testing.io, ".", gpa);
+    defer gpa.free(root);
+    var buf: [std.fs.max_path_bytes]u8 = undefined;
+    const path = try std.fmt.bufPrintSentinel(&buf, "{s}/kv.pages", .{root}, 0);
+    const rc = linux.openat(linux.AT.FDCWD, path, .{ .ACCMODE = .RDWR, .CREAT = true, .CLOEXEC = true }, 0o644);
+    try std.testing.expectEqual(linux.E.SUCCESS, linux.errno(rc));
+    const fd: linux.fd_t = @intCast(rc);
+    defer _ = linux.close(fd);
+    const stride = 512;
+    const layers = 3;
+    var moves: [40]Move = undefined; // more than `threads`: each worker takes several, strided
+    for (&moves, 0..) |*m, i| m.* = .{ .vpage = @intCast(39 - i), .layer = @intCast(i % layers), .dev = 0 };
+    const stage = try gpa.alloc(u8, moves.len * stride);
+    defer gpa.free(stage);
+    for (stage, 0..) |*b, i| b.* = @truncate(i *% 31 +% i / stride);
+    const want = try gpa.dupe(u8, stage);
+    defer gpa.free(want);
+    try spread(fd, stage, stride, layers, &moves, true, error.WriteFailed);
+    @memset(stage, 0);
+    try spread(fd, stage, stride, layers, &moves, false, error.ReadFailed);
+    try std.testing.expectEqualSlices(u8, want, stage);
+    moves[7].vpage = 1000;
+    try std.testing.expectError(error.ShortRead, spread(fd, stage, stride, layers, &moves, false, error.ReadFailed));
+}
diff --git a/zig/src/families/minimax_m3/tier_pool.zig b/zig/src/families/minimax_m3/tier_pool.zig
new file mode 100644
index 0000000000000000000000000000000000000000..cabe5bc2cc6b062a3a5e9d32f599c421c4e9b838
--- /dev/null
+++ b/zig/src/families/minimax_m3/tier_pool.zig
@@ -0,0 +1,43 @@
+//! The engine's pool on the KV tier: what each rank makes at `attach` in place of the page arena.
+const std = @import("std");
+const cuda = @import("cuda");
+const tier = @import("tier.zig");
+const tier_settings = @import("tier_settings.zig");
+const iface = @import("iface.zig");
+const linux = std.os.linux;
+
+/// What a rank's tier is made of: the settings (its cache share set by the budget), this rank's dims and number.
+pub const Spec = struct {
+    gpa: std.mem.Allocator,
+    settings: tier_settings.Tier,
+    layers: u32,
+    kvh: u32,
+    kv8: bool,
+    rank: usize,
+};
+
+pub const Error = error{ TierDiskTooSmall, TierCacheTooSmall, TierPath };
+
+/// The tier over `slots` streams and `vpages` virtual pages, its file `<dir>/rank<r>/kv.pages`, over the block table.
+pub fn make(spec: Spec, d: *const cuda.Driver, st: cuda.Stream, slots: u32, vpages: usize, max_pages: usize, table: u64) !*tier.Tier {
+    var c: tier.Config = .{ .layers = spec.layers, .kvh = spec.kvh, .kv8 = spec.kv8, .streams = slots, .max_pages = @intCast(max_pages), .vpages = @intCast(vpages), .horizon = spec.settings.horizonBlocks(), .m = spec.settings.m, .slices = 0, .max_rows = iface.max_rows, .path = "" };
+    const stride = std.mem.alignForward(u64, c.sliceBytes(), 4096);
+    const disk = @as(u64, vpages) * spec.layers * stride;
+    if (disk > spec.settings.gib << 30) {
+        std.log.err("minimax KV tier: {d} pages need {d:.1} GiB of NVMe a rank, TF_MM3_KV_TIER_GIB is {d}", .{ vpages, @as(f64, @floatFromInt(disk)) / (1 << 30), spec.settings.gib });
+        return error.TierDiskTooSmall;
+    }
+    c.slices = @intCast(@as(u64, slots) * spec.settings.cache_stream / c.sliceBytes());
+    if (c.slices < spec.layers * (tier.max_open + 2 * slots)) return error.TierCacheTooSmall;
+    var buf: [std.fs.max_path_bytes]u8 = undefined;
+    const dir = std.fmt.bufPrintSentinel(&buf, "{s}/rank{d}", .{ spec.settings.dir, spec.rank }, 0) catch return error.TierPath;
+    switch (linux.errno(linux.mkdirat(linux.AT.FDCWD, dir, 0o755))) {
+        .SUCCESS, .EXIST => {},
+        else => return error.TierPath,
+    }
+    var pbuf: [std.fs.max_path_bytes]u8 = undefined;
+    c.path = std.fmt.bufPrintSentinel(&pbuf, "{s}/kv.pages", .{dir}, 0) catch return error.TierPath;
+    const t = try tier.Tier.init(spec.gpa, d, st, c, table);
+    std.log.info("minimax KV tier rank {d}: {d} pages ({d:.1} GiB) at {s}, {d} slices ({d:.2} GiB) of cache, horizon {d} tokens, {d} candidates", .{ spec.rank, vpages, @as(f64, @floatFromInt(disk)) / (1 << 30), c.path, c.slices, @as(f64, @floatFromInt(c.slices * c.sliceBytes())) / (1 << 30), spec.settings.horizon, spec.settings.m });
+    return t;
+}
diff --git a/zig/src/families/minimax_m3/tier_settings.zig b/zig/src/families/minimax_m3/tier_settings.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1e39fa4a7ce198354e1a151e152f1a9857e2d625
--- /dev/null
+++ b/zig/src/families/minimax_m3/tier_settings.zig
@@ -0,0 +1,132 @@
+//! TF_MM3_KV_TIER*: the KV tier's folder, NVMe budget, exact horizon and candidates, and what a rank's budget prices.
+const std = @import("std");
+
+pub const dir_var = "TF_MM3_KV_TIER";
+pub const gib_var = "TF_MM3_KV_TIER_GIB";
+pub const horizon_var = "TF_MM3_KV_HORIZON";
+pub const candidates_var = "TF_MM3_KV_CANDIDATES";
+
+/// Tokens a page and a prompt chunk's rows: the horizon covers a chunk, so a block a chunk finishes is scored exactly.
+const page_tokens = 128;
+const chunk_rows = 2048;
+/// Bytes of one block-layer's summary and of its IK (the tier's GPU terms, cuda/minimax_m3_tier.zig).
+pub const summ_bytes: u64 = 512;
+pub const ik_bytes: u64 = 32768;
+
+pub const Get = *const fn ([:0]const u8) ?[]const u8;
+
+pub const Tier = struct {
+    /// The folder of the rank files (empty: no tier, every page resident).
+    dir: []const u8 = "",
+    gib: u64 = 0,
+    /// Tokens scored exactly; 0 (unset): the whole context, every selection exact (`exact` sets it at open).
+    horizon: u32 = 0,
+    m: u32 = 16,
+    /// Bytes of slice cache a stream brings (the budget sets it: the room's rest, split by the streams).
+    cache_stream: u64 = 0,
+
+    pub fn on(t: Tier) bool {
+        return t.dir.len > 0;
+    }
+
+    /// Unset horizon: the whole `capacity` (exact selection, only K/V pages leave the GPU); approximate is opt-in.
+    pub fn exact(t: *Tier, capacity: usize) void {
+        if (t.horizon == 0) t.horizon = @intCast(std.mem.alignForward(usize, capacity, page_tokens));
+    }
+
+    pub fn approximate(t: Tier, capacity: usize) bool {
+        return t.horizon < capacity;
+    }
+
+    pub fn horizonBlocks(t: Tier) u32 {
+        return t.horizon / page_tokens;
+    }
+
+    /// What the budget prices for these layers: summaries a page, horizon IK and the cache share a stream (null: off).
+    pub fn cost(t: Tier, layers: u32) ?Cost {
+        if (!t.on()) return null;
+        return .{ .layers = layers, .horizon_blocks = t.horizonBlocks(), .cache_stream = t.cache_stream };
+    }
+
+    /// One fingerprint word: ranks must score the same blocks exactly and rerank as many (0: no tier).
+    pub fn digest(t: Tier) u32 {
+        if (!t.on()) return 0;
+        return 1 ^ (t.horizon *% 0x9e3779b1) ^ (t.m *% 0x85ebca6b);
+    }
+
+    pub fn read(get: Get, problem: *[]const u8) error{BadSetting}!Tier {
+        var t: Tier = .{};
+        const dir = get(dir_var) orelse return t;
+        if (dir.len == 0) return t; // an empty value is unset (the recipe's smoke profile writes it so)
+        t.dir = dir;
+        t.gib = whole(get, gib_var, 0) orelse return bad(problem, "TF_MM3_KV_TIER_GIB: the tier's NVMe GiB a rank, 1 or more");
+        if (t.gib == 0) return bad(problem, "TF_MM3_KV_TIER_GIB: the tier's NVMe GiB a rank, 1 or more");
+        const h = whole(get, horizon_var, 0) orelse return bad(problem, "TF_MM3_KV_HORIZON: tokens, a multiple of 128");
+        if (h != 0 and (h % page_tokens != 0 or h < chunk_rows + page_tokens)) return bad(problem, "TF_MM3_KV_HORIZON: a multiple of 128 tokens, 2176 or more (a prompt chunk and a page)");
+        t.horizon = @intCast(h);
+        const m = whole(get, candidates_var, t.m) orelse return bad(problem, "TF_MM3_KV_CANDIDATES: cold pages a kv head reranks, 0 or more");
+        t.m = @intCast(@min(m, 4096));
+        return t;
+    }
+
+    fn whole(get: Get, name: [:0]const u8, default: u64) ?u64 {
+        const v = get(name) orelse return default;
+        if (v.len == 0) return default;
+        return std.fmt.parseInt(u64, v, 10) catch null;
+    }
+
+    fn bad(problem: *[]const u8, words: []const u8) error{BadSetting} {
+        problem.* = words;
+        return error.BadSetting;
+    }
+};
+
+/// What the budget prices: a virtual page's summaries, a stream's horizon IK and cache share, the least cache.
+pub const Cost = struct {
+    layers: u32,
+    horizon_blocks: u32,
+    cache_stream: u64,
+
+    pub fn pageBytes(c: Cost) u64 {
+        return @as(u64, c.layers) * summ_bytes;
+    }
+
+    pub fn streamBytes(c: Cost) u64 {
+        return @as(u64, c.horizon_blocks) * c.layers * ik_bytes + c.cache_stream;
+    }
+
+    /// The least slice cache: twice the slices pinned at once (a chunk and every tail, all layers; one layer's picks).
+    pub fn cacheMin(c: Cost, lanes: u32, max_pages: u64, m: u32, slice_bytes: u64) u64 {
+        const open: u64 = chunk_rows / page_tokens + 2;
+        const pinned = c.layers * open + @as(u64, lanes) * c.layers * 2 + @min(max_pages, chunk_rows * 2 * (16 + @as(u64, m)));
+        return 2 * pinned * slice_bytes;
+    }
+};
+
+test "tier settings: unset and empty are off, values parse, a horizon short of a chunk refuses" {
+    const E = struct {
+        var vals: [4]?[]const u8 = .{ null, null, null, null };
+        fn get(name: [:0]const u8) ?[]const u8 {
+            inline for (.{ dir_var, gib_var, horizon_var, candidates_var }, 0..) |v, i| if (std.mem.eql(u8, name, v)) return vals[i];
+            return null;
+        }
+    };
+    var problem: []const u8 = "";
+    try std.testing.expect(!(try Tier.read(E.get, &problem)).on());
+    E.vals = .{ "", null, null, null };
+    try std.testing.expect(!(try Tier.read(E.get, &problem)).on());
+    E.vals = .{ "/kvtier", "252", "32768", "16" };
+    const t = try Tier.read(E.get, &problem);
+    try std.testing.expect(t.on() and t.gib == 252 and t.horizonBlocks() == 256 and t.m == 16 and t.digest() != 0);
+    E.vals = .{ "/kvtier", "252", null, null };
+    var x = try Tier.read(E.get, &problem);
+    x.exact(131072 + 64);
+    try std.testing.expect(x.horizon == 131200 and !x.approximate(131072 + 64));
+    E.vals = .{ "/kvtier", "252", "1024", null };
+    try std.testing.expectError(error.BadSetting, Tier.read(E.get, &problem));
+    E.vals = .{ "/kvtier", null, null, null };
+    try std.testing.expectError(error.BadSetting, Tier.read(E.get, &problem));
+    const c: Cost = .{ .layers = 60, .horizon_blocks = 256, .cache_stream = 0 };
+    try std.testing.expectEqual(@as(u64, 30720), c.pageBytes());
+    try std.testing.expectEqual(@as(u64, 256 * 60 * 32768), c.streamBytes());
+}
