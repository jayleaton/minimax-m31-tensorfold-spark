@@ -0,0 +1,262 @@
+//! `bench-prompt-prep`: a chat request's CPU prompt preparation on MiniMax-M3.1's tokenizer and templates, by stage.
+const std = @import("std");
+const json = @import("json");
+const options = @import("mm3_options");
+const errors = @import("errors.zig");
+const chat = @import("chat.zig");
+const prompt = @import("prompt.zig");
+const messages_mod = @import("messages.zig");
+const openai = @import("openai.zig");
+const tool_grammar = @import("tool_grammar.zig");
+const talk = @import("prompt_bench_talk.zig");
+const HfText = @import("hf_text.zig").HfText;
+const Server = @import("server.zig").Server;
+const tokenizer = @import("tokenizer");
+const Value = json.Value;
+const Cx = errors.Cx;
+const Allocator = std.mem.Allocator;
+
+const stub = @import("prompt_stub.zig");
+const Never = stub.Never;
+
+const stage_names = [_][]const u8{ "normalize", "to_std", "render_on", "encode_on", "render_off", "encode_off", "rewind_len", "system_prefix", "reply_spans", "chunk_starts", "tools_json", "grammar_probe", "prepare" };
+const Stage = enum(u8) { normalize, to_std, render_on, encode_on, render_off, encode_off, rewind_len, system_prefix, reply_spans, chunk_starts, tools_json, grammar_probe, prepare };
+const Times = [stage_names.len]u64;
+
+var io_global: std.Io = undefined;
+
+fn now() std.Io.Timestamp {
+    return std.Io.Clock.awake.now(io_global);
+}
+
+fn since(t: std.Io.Timestamp) u64 {
+    return @intCast(t.durationTo(now()).nanoseconds);
+}
+
+var memo_short = true;
+
+/// Empties the tokenizer's segment memo: the next request is a server's first sight of this conversation.
+fn coldMemo(text: *HfText) !void {
+    text.tok.memo.?.destroy();
+    text.tok.memo = try tokenizer.Memo.create(std.heap.c_allocator, 64 << 20);
+    if (memo_short) text.tok.memo.?.keepShort();
+}
+
+/// A TF_SERVE_* switch as the server reads it: on unless "0".
+fn on(name: [*:0]const u8) bool {
+    const v = std.c.getenv(name) orelse return true;
+    return !std.mem.eql(u8, std.mem.sliceTo(v, 0), "0");
+}
+
+fn inputOf(srv: *Server, cx: *Cx, body: []const u8) !chat.Input {
+    const raw = switch (try json.parse(cx.a, body)) {
+        .ok => |v| v,
+        .err => |e| {
+            std.debug.print("bench body is not JSON: {s}\n", .{e});
+            return error.BadBody;
+        },
+    };
+    return openai.chatInput(srv, cx, raw) catch |e| {
+        std.debug.print("refused: {s}\n", .{cx.message});
+        return e;
+    };
+}
+
+/// One whole `chat.prepare`, as the chat route runs it; returns its prompt length.
+fn prepareOnce(srv: *Server, body: []const u8, out_ns: ?*u64) !usize {
+    var arena = std.heap.ArenaAllocator.init(std.heap.c_allocator);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    const input = try inputOf(srv, &cx, body);
+    const t = now();
+    const p = chat.prepare(srv, &cx, input, Never{}) catch |e| {
+        std.debug.print("prepare failed: {s} {s}\n", .{ @errorName(e), cx.message });
+        return e;
+    };
+    if (out_ns) |o| o.* = since(t);
+    chat.release(srv, p.preparing);
+    return p.prompt_len;
+}
+
+/// Each stage `chat.prepare` runs, timed apart in its order (the memo state carries through as it does there).
+fn stages(srv: *Server, body: []const u8, times: *Times) !void {
+    var arena = std.heap.ArenaAllocator.init(std.heap.c_allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var cx: Cx = .{ .a = a };
+    const input = try inputOf(srv, &cx, body);
+    const thinking = if (input.fields.get("enable_thinking")) |v| v.truthy() else srv.config.enable_thinking;
+    const effort = srv.effortFor(null);
+    var problem: []const u8 = "";
+    var t = now();
+    const normalized = try messages_mod.forTemplate(&cx, input.messages, srv.late_system, srv.needs_user_after_tool, .of(null));
+    times[@backingInt(Stage.normalize)] = since(t);
+    t = now();
+    _ = try @import("hf_text.zig").toStd(a, normalized);
+    times[@backingInt(Stage.to_std)] = since(t);
+    var ids: [2][]const u32 = undefined;
+    for ([_]bool{ true, false }, 0..) |generation, k| {
+        t = now();
+        const r = try srv.text.render(a, normalized, prompt.renderOptions(input.tools, thinking, effort, generation), &problem);
+        times[@backingInt(Stage.render_on) + 2 * k] = since(t);
+        t = now();
+        ids[k] = try r.encode(srv.text, a, &problem);
+        times[@backingInt(Stage.encode_on) + 2 * k] = since(t);
+    }
+    const full = try prompt.renderIds(srv, &cx, input.messages, input.tools, thinking, effort, true);
+    const count = input.messages.array.len;
+    t = now();
+    _ = prompt.rewindLen(srv, &cx, input.messages, count, input.tools, full, thinking, effort);
+    times[@backingInt(Stage.rewind_len)] = since(t);
+    t = now();
+    _ = prompt.systemPrefixLen(srv, &cx, input.messages, input.tools, full, thinking, effort);
+    times[@backingInt(Stage.system_prefix)] = since(t);
+    t = now();
+    _ = try prompt.replySpans(srv, &cx, full);
+    times[@backingInt(Stage.reply_spans)] = since(t);
+    t = now();
+    _ = try srv.chunks.starts(a, full);
+    times[@backingInt(Stage.chunk_starts)] = since(t);
+    t = now();
+    if (input.tools.len > 0) _ = try json.stringify(a, .{ .array = @constCast(input.tools) }, .{ .ascii = false });
+    times[@backingInt(Stage.tools_json)] = since(t);
+    t = now();
+    if (input.tools.len > 0) _ = try tool_grammar.structure(srv, &cx, input.tools, true, thinking, .required);
+    times[@backingInt(Stage.grammar_probe)] = since(t);
+}
+
+fn median(xs: []u64) u64 {
+    std.mem.sort(u64, xs, {}, std.sort.asc(u64));
+    return xs[xs.len / 2];
+}
+
+fn ms(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e6;
+}
+
+const Case = struct { template: []const u8, label: []const u8, shape: talk.Shape };
+
+/// Cold (an empty memo) and warm (the previous turn prepared first) runs of one case: median stage times.
+fn runCase(srv: *Server, text: *HfText, c: Case, reps: usize) !void {
+    var arena = std.heap.ArenaAllocator.init(std.heap.c_allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const b = try talk.bodies(a, c.shape);
+    for ([_][]const u8{ "cold", "warm" }) |phase| {
+        const samples = try a.alloc(Times, reps);
+        var len: usize = 0;
+        for (samples) |*s| {
+            s.* = @splat(0);
+            try coldMemo(text);
+            const body = if (phase[0] == 'c') b[0] else b[1];
+            if (phase[0] == 'w') _ = try prepareOnce(srv, b[0], null);
+            len = try prepareOnce(srv, body, &s[@backingInt(Stage.prepare)]);
+            try coldMemo(text);
+            if (phase[0] == 'w') _ = try prepareOnce(srv, b[0], null);
+            try stages(srv, body, s);
+        }
+        var line: std.ArrayList(u8) = .empty;
+        try line.print(a, "{s} {s} tok={d} tools={d} think={any}", .{ c.label, phase, len, c.shape.tools, c.shape.thinking });
+        for (stage_names, 0..) |name, k| {
+            var xs = try a.alloc(u64, reps);
+            for (samples, 0..) |s, i| xs[i] = s[k];
+            try line.print(a, " {s}={d:.2}", .{ name, ms(median(xs)) });
+        }
+        std.debug.print("{s}\n", .{line.items});
+    }
+}
+
+const Worker = struct {
+    srv: *Server,
+    body: []const u8,
+    ns: u64 = 0,
+    failed: bool = false,
+
+    fn run(w: *Worker) void {
+        _ = prepareOnce(w.srv, w.body, &w.ns) catch {
+            w.failed = true;
+        };
+    }
+};
+
+/// `n` requests' prepare at once on distinct conversations, against each alone: what a shared lock serializes.
+fn contention(srv: *Server, text: *HfText, label: []const u8, shape: talk.Shape, n: usize, warm: bool) !void {
+    var arena = std.heap.ArenaAllocator.init(std.heap.c_allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const workers = try a.alloc(Worker, n);
+    const firsts = try a.alloc([]const u8, n);
+    for (workers, firsts, 0..) |*w, *f, i| {
+        var s = shape;
+        s.seed = shape.seed + i;
+        const b = try talk.bodies(a, s);
+        f.* = b[0];
+        w.* = .{ .srv = srv, .body = if (warm) b[1] else b[0] };
+    }
+    var solo: u64 = 0;
+    try coldMemo(text);
+    for (workers, firsts) |*w, f| {
+        if (warm) _ = try prepareOnce(srv, f, null);
+        w.run();
+        solo += w.ns;
+    }
+    try coldMemo(text);
+    if (warm) for (firsts) |f| {
+        _ = try prepareOnce(srv, f, null);
+    };
+    const threads = try a.alloc(std.Thread, n);
+    const t = now();
+    for (workers, threads) |*w, *th| th.* = try std.Thread.spawn(.{}, Worker.run, .{w});
+    for (threads) |th| th.join();
+    const wall = since(t);
+    var sum: u64 = 0;
+    var worst: u64 = 0;
+    for (workers) |w| {
+        if (w.failed) return error.PrepareFailed;
+        sum += w.ns;
+        worst = @max(worst, w.ns);
+    }
+    std.debug.print("{s} {s} concurrent={d} solo_mean={d:.2} together_mean={d:.2} together_worst={d:.2} wall={d:.2}\n", .{ label, if (warm) "warm" else "cold", n, ms(solo / n), ms(sum / n), ms(worst), ms(wall) });
+}
+
+pub fn main(init: std.process.Init) !void {
+    io_global = init.io;
+    const gpa = std.heap.c_allocator;
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    const only: []const u8 = if (args.len > 1 and !std.mem.eql(u8, args[1], "all")) args[1] else "";
+    const reps: usize = if (args.len > 2) try std.fmt.parseInt(usize, args[2], 10) else 5;
+    const largest: usize = if (args.len > 3) try std.fmt.parseInt(usize, args[3], 10) else 128000;
+    const dir = std.fs.path.dirname(options.tokenizer_path) orelse ".";
+    const templates = [_][2][]const u8{
+        .{ "m31", "zig/src/families/minimax_m3/fixtures/chat_template.m31-54e4e69d.jinja" },
+        .{ "mia", "zig/src/families/minimax_m3/fixtures/chat_template.jinja" },
+    };
+    for (templates) |tp| {
+        if (only.len > 0 and std.mem.indexOf(u8, only, tp[0]) == null) continue;
+        var problem: []const u8 = "";
+        const text = HfText.load(gpa, init.io, dir, tp[1], init.arena.allocator(), &problem) catch |e| {
+            std.debug.print("cannot load {s}: {s} ({s})\n", .{ tp[1], problem, @errorName(e) });
+            return e;
+        };
+        defer text.deinit();
+        var engine: stub.Stub = .{};
+        var compile: stub.Compile = .{};
+        var compiler = compile.compiler();
+        const srv = try stub.server(gpa, init.io, &engine, text, &compiler);
+        defer srv.deinit();
+        srv.prompt_once = on("TF_SERVE_PROMPT_ONCE");
+        memo_short = on("TF_SERVE_MEMO_SHORT");
+        if (!on("TF_SERVE_REPLY_SPANS")) srv.reply_openers = null;
+        std.debug.print("{s} PROMPT_ONCE={any} MEMO_SHORT={any} REPLY_SPANS={any} generation_mark={any}\n", .{ tp[0], srv.prompt_once, memo_short, srv.reply_openers != null, text.compiled.?.generation != null });
+        for ([_]usize{ 2000, 32000, 128000 }) |size| for ([_]usize{ 20, 0 }) |tools| for ([_]bool{ true, false }) |thinking| {
+            if (size > largest) continue;
+            const label = try std.fmt.allocPrint(init.arena.allocator(), "{s}/{d}k", .{ tp[0], size / 1000 });
+            try runCase(srv, text, .{ .template = tp[1], .label = label, .shape = .{ .tokens = size, .tools = tools, .thinking = thinking, .seed = size + tools } }, if (size >= 128000) @max(1, reps / 2) else reps);
+        };
+        if (largest >= 128000) for ([_]bool{ false, true }) |warm| try contention(srv, text, tp[0], .{ .tokens = 128000, .tools = 20, .thinking = true, .seed = 99 }, 4, warm);
+    }
+}
+
+test {
+    _ = talk;
+}
diff --git a/zig/src/server/prompt_bench_talk.zig b/zig/src/server/prompt_bench_talk.zig
new file mode 100644
index 0000000000000000000000000000000000000000..37030f095c44ed7f5ee335606dd529f7cf553a7b
--- /dev/null
+++ b/zig/src/server/prompt_bench_talk.zig
@@ -0,0 +1,209 @@
+//! Deterministic chat request bodies for the prompt-preparation benchmark: tool turns, tool results and schemas.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+const words = [_][]const u8{
+    "the",       "server",  "request", "token",  "cache",  "prompt", "history", "model",  "reply", "a",
+    "of",        "and",     "to",      "in",     "is",     "that",   "for",     "with",   "on",    "as",
+    "function",  "returns", "value",   "error",  "file",   "path",   "line",    "build",  "test",  "check",
+    "should",    "would",   "because", "when",   "after",  "before", "every",   "only",   "each",  "this",
+    "kernel",    "memory",  "buffer",  "length", "offset", "index",  "window",  "stream", "lane",  "batch",
+    "we",        "it",      "they",    "not",    "but",    "or",     "if",      "then",   "else",  "into",
+    "configure", "measure", "compare", "render", "encode", "decode", "parse",   "schema", "field", "object",
+    "JSON",      "UTF-8",   "Zig",     "CUDA",   "GPU",    "CPU",    "thread",  "mutex",  "lock",  "queue",
+    "résumé",
+    "naïve",
+    "café",
+    "数据",
+    "模型",
+    "接口",
+    "über",
+    "straße",
+    "日本",
+    "東京",
+    "42",        "1024",    "3.14",    "0x7f",   "2026",   "128K",   "v1.0",    "id_17",  "#3",    "x86_64",
+};
+
+const code = [_][]const u8{
+    "    const ids = try tokenizer.encode(a, text);\n",
+    "    if (len > window) return error.ContextLength;\n",
+    "fn render(srv: *Server, messages: Value) ![]u32 {\n",
+    "    for (items, 0..) |item, i| total += item.len * i;\n",
+    "}\n",
+    "// keep the prefix when the template is a pure suffix\n",
+    "    std.debug.print(\"{d} tokens\\n\", .{ids.len});\n",
+    "def prepare(self, request):\n        return self.render(request.messages)\n",
+    "    let mut cache = HashMap::<u64, Vec<u32>>::new();\n",
+    "  \"name\": \"tensorfold\", \"version\": \"1.0.0\",\n",
+};
+
+pub const Shape = struct {
+    /// Approximate history size in tokens (about four bytes a token).
+    tokens: usize,
+    tools: usize,
+    thinking: bool,
+    seed: u64,
+};
+
+const Gen = struct {
+    a: Allocator,
+    r: std.Random.DefaultPrng,
+    out: std.ArrayList(u8) = .empty,
+
+    fn rand(g: *Gen, lo: usize, hi: usize) usize {
+        return g.r.random().intRangeAtMost(usize, lo, hi);
+    }
+
+    /// `n` words as JSON string text; a line break only where `breaks` (never in a call's encoded arguments).
+    fn phrase(g: *Gen, n: usize, breaks: bool) !void {
+        for (0..n) |i| {
+            if (i > 0) try g.out.appendSlice(g.a, if (breaks and g.rand(0, 14) == 0) "\\n" else " ");
+            try escaped(g, words[g.rand(0, words.len - 1)]);
+            if (g.rand(0, 11) == 0) try g.out.appendSlice(g.a, if (g.rand(0, 1) == 0) "." else ",");
+        }
+    }
+
+    fn sentence(g: *Gen, n: usize) !void {
+        return g.phrase(n, true);
+    }
+
+    fn lines(g: *Gen, bytes: usize) !void {
+        const start = g.out.items.len;
+        while (g.out.items.len - start < bytes) try escaped(g, code[g.rand(0, code.len - 1)]);
+    }
+
+    fn str(g: *Gen, s: []const u8) !void {
+        try g.out.appendSlice(g.a, s);
+    }
+
+    fn print(g: *Gen, comptime fmt: []const u8, args: anytype) !void {
+        try g.out.print(g.a, fmt, args);
+    }
+};
+
+fn escaped(g: *Gen, s: []const u8) !void {
+    for (s) |c| switch (c) {
+        '"' => try g.out.appendSlice(g.a, "\\\""),
+        '\\' => try g.out.appendSlice(g.a, "\\\\"),
+        '\n' => try g.out.appendSlice(g.a, "\\n"),
+        else => try g.out.append(g.a, c),
+    };
+}
+
+fn tool(g: *Gen, k: usize) !void {
+    try g.print("{{\"type\":\"function\",\"function\":{{\"name\":\"tool_{d}\",\"description\":\"", .{k});
+    try g.sentence(g.rand(12, 40));
+    try g.str("\",\"parameters\":{\"type\":\"object\",\"properties\":{");
+    const n = g.rand(2, 6);
+    for (0..n) |p| {
+        const kinds = [_][]const u8{ "string", "integer", "boolean", "number" };
+        if (p > 0) try g.str(",");
+        try g.print("\"arg_{d}\":{{\"type\":\"{s}\",\"description\":\"", .{ p, kinds[g.rand(0, kinds.len - 1)] });
+        try g.sentence(g.rand(4, 16));
+        try g.str("\"}");
+    }
+    try g.str(",\"items\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}}}}");
+    try g.str("},\"required\":[\"arg_0\"]}}}");
+}
+
+fn call(g: *Gen, id: usize, tools: usize) !void {
+    try g.print("{{\"id\":\"call_{d}\",\"type\":\"function\",\"function\":{{\"name\":\"tool_{d}\",\"arguments\":\"{{\\\"arg_0\\\":\\\"", .{ id, g.rand(0, tools - 1) });
+    try g.phrase(g.rand(3, 12), false);
+    try g.print("\\\",\\\"arg_1\\\":{d},\\\"items\\\":[{{\\\"key\\\":\\\"k\\\",\\\"value\\\":\\\"", .{g.rand(0, 9999)});
+    try g.phrase(g.rand(2, 6), false);
+    try g.str("\\\"}]}\"}}");
+}
+
+fn assistant(g: *Gen, thinking: bool) !void {
+    try g.str(",{\"role\":\"assistant\"");
+    if (thinking) {
+        try g.str(",\"reasoning_content\":\"");
+        try g.sentence(g.rand(20, 90));
+        try g.str("\"");
+    }
+    try g.str(",\"content\":\"");
+    try g.sentence(g.rand(30, 200));
+    try g.str("\"}");
+}
+
+fn user(g: *Gen) !void {
+    try g.str(",{\"role\":\"user\",\"content\":\"");
+    try g.sentence(g.rand(10, 120));
+    try g.str("\"}");
+}
+
+/// One turn: a user message, then (with tools) an assistant's calls and their results, then its answer.
+fn turn(g: *Gen, s: Shape, calls: *usize, last: bool) !void {
+    try user(g);
+    if (last) return;
+    if (s.tools > 0) {
+        try g.str(",{\"role\":\"assistant\"");
+        if (s.thinking) {
+            try g.str(",\"reasoning_content\":\"");
+            try g.sentence(g.rand(20, 60));
+            try g.str("\"");
+        }
+        try g.str(",\"content\":\"\",\"tool_calls\":[");
+        const n = g.rand(1, 3);
+        for (0..n) |i| {
+            if (i > 0) try g.str(",");
+            try call(g, calls.* + i, s.tools);
+        }
+        try g.str("]}");
+        for (0..n) |i| {
+            try g.print(",{{\"role\":\"tool\",\"tool_call_id\":\"call_{d}\",\"content\":\"", .{calls.* + i});
+            try g.lines(g.rand(400, 4000));
+            try g.str("\"}");
+        }
+        calls.* += n;
+    }
+    try assistant(g, s.thinking);
+}
+
+/// The request body for `s`, and the next turn's (the same history, the reply, and one more user message).
+pub fn bodies(a: Allocator, s: Shape) ![2][]const u8 {
+    var g: Gen = .{ .a = a, .r = .init(s.seed) };
+    var calls: usize = 0;
+    try g.str("{\"model\":\"m\",\"max_tokens\":256,\"messages\":[{\"role\":\"system\",\"content\":\"");
+    try g.sentence(@min(1500, s.tokens / 10));
+    try g.str("\"}");
+    while (g.out.items.len < s.tokens * 4) try turn(&g, s, &calls, false);
+    try turn(&g, s, &calls, true);
+    const history = g.out.items.len;
+    try assistant(&g, s.thinking);
+    try user(&g);
+    const next_turn = try a.dupe(u8, g.out.items[history..]);
+    g.out.shrinkRetainingCapacity(history);
+    var tail: std.ArrayList(u8) = .empty;
+    try tail.appendSlice(a, "]");
+    if (s.tools > 0) {
+        try tail.appendSlice(a, ",\"tool_choice\":\"auto\",\"tools\":[");
+        var t: Gen = .{ .a = a, .r = .init(s.seed ^ 0x5eed) };
+        for (0..s.tools) |k| {
+            if (k > 0) try t.str(",");
+            try tool(&t, k);
+        }
+        try tail.appendSlice(a, t.out.items);
+        try tail.appendSlice(a, "]");
+    }
+    try tail.print(a, ",\"enable_thinking\":{any}}}", .{s.thinking});
+    const first = try std.mem.concat(a, u8, &.{ g.out.items, tail.items });
+    const second = try std.mem.concat(a, u8, &.{ g.out.items, next_turn, tail.items });
+    return .{ first, second };
+}
+
+test "bench bodies parse as JSON, and the next turn extends the first" {
+    const a = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    for ([_]usize{ 0, 20 }) |tools| for ([_]bool{ false, true }) |thinking| {
+        const b = try bodies(arena.allocator(), .{ .tokens = 2000, .tools = tools, .thinking = thinking, .seed = 7 });
+        for (b) |body| {
+            const v = try std.json.parseFromSliceLeaky(std.json.Value, arena.allocator(), body, .{});
+            try std.testing.expect(v.object.get("messages").?.array.items.len > 2);
+        }
+        const first = try std.json.parseFromSliceLeaky(std.json.Value, arena.allocator(), b[0], .{});
+        const second = try std.json.parseFromSliceLeaky(std.json.Value, arena.allocator(), b[1], .{});
+        try std.testing.expectEqual(first.object.get("messages").?.array.items.len + 2, second.object.get("messages").?.array.items.len);
+    };
+}
diff --git a/zig/src/server/prompt_prep_test.zig b/zig/src/server/prompt_prep_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..751bc955791782131eff1f5dc32bedb3971c894e
--- /dev/null
+++ b/zig/src/server/prompt_prep_test.zig
@@ -0,0 +1,141 @@
+//! The TF_SERVE_* prompt switches on and off prepare the same request for MiniMax-M3.1's tokenizer and both templates.
+const std = @import("std");
+const json = @import("json");
+const options = @import("mm3_options");
+const fixtures = @import("mm3_serve_fixtures");
+const errors = @import("errors.zig");
+const chat = @import("chat.zig");
+const openai = @import("openai.zig");
+const prompt = @import("prompt.zig");
+const tokenizer = @import("tokenizer");
+const talk = @import("prompt_bench_talk.zig");
+const stub = @import("prompt_stub.zig");
+const HfText = @import("hf_text.zig").HfText;
+const Server = @import("server.zig").Server;
+const t = std.testing;
+
+/// What a prepared request carries from its prompt, in one comparable shape (a refusal is its message).
+const Seen = struct {
+    refused: []const u8 = "",
+    prompt: []const u32 = &.{},
+    history_len: u32 = 0,
+    rewind_len: u32 = 0,
+    shared: []const u32 = &.{},
+    spans: []const [2]u32 = &.{},
+    chunks: []const u32 = &.{},
+    decide: ?u32 = null,
+
+    fn same(x: Seen, y: Seen) bool {
+        return std.mem.eql(u8, x.refused, y.refused) and std.mem.eql(u32, x.prompt, y.prompt) and x.history_len == y.history_len and
+            x.rewind_len == y.rewind_len and std.mem.eql(u32, x.shared, y.shared) and std.mem.eql([2]u32, x.spans, y.spans) and
+            std.mem.eql(u32, x.chunks, y.chunks) and x.decide == y.decide;
+    }
+};
+
+fn prepared(srv: *Server, a: std.mem.Allocator, body: []const u8) !Seen {
+    var cx: errors.Cx = .{ .a = a };
+    const raw = switch (try json.parse(a, body)) {
+        .ok => |v| v,
+        .err => |e| {
+            std.debug.print("corpus body is not JSON: {s}\n", .{e});
+            return error.TestUnexpectedResult;
+        },
+    };
+    const input = openai.chatInput(srv, &cx, raw) catch |e| return if (e == error.Refused) .{ .refused = cx.message } else e;
+    const p = chat.prepare(srv, &cx, input, stub.Never{}) catch |e| return if (e == error.Refused) .{ .refused = cx.message } else e;
+    defer chat.release(srv, p.preparing);
+    const r = p.request;
+    return .{ .prompt = r.prompt, .history_len = r.history_len, .rewind_len = r.rewind_len, .shared = r.shared_prefixes, .spans = r.decode_spans, .chunks = r.chunks, .decide = r.decide };
+}
+
+/// Every reference request, and long generated tool conversations (both turns), thinking on and off.
+fn corpus(a: std.mem.Allocator, name: []const u8) ![]const []const u8 {
+    var out: std.ArrayList([]const u8) = .empty;
+    var lines = std.mem.splitScalar(u8, fixtures.reference, '\n');
+    while (lines.next()) |line| {
+        if (line.len == 0) continue;
+        const c = (try json.parse(a, line)).ok;
+        if (std.mem.eql(u8, c.get("template").?.string, "mia") != std.mem.eql(u8, name, "mia")) continue;
+        const o = try json.newObject(a);
+        try o.put(a, "model", .{ .string = "m" });
+        try o.put(a, "messages", c.get("messages").?);
+        if (c.get("tools").? == .array) try o.put(a, "tools", c.get("tools").?);
+        try o.put(a, "enable_thinking", c.get("thinking").?);
+        if (c.get("effort").? == .string) try o.put(a, "reasoning_effort", c.get("effort").?);
+        try out.append(a, try json.stringify(a, .{ .object = o }, .{ .ascii = false }));
+    }
+    for ([_]usize{ 0, 12 }) |tools| for ([_]bool{ false, true }) |thinking| {
+        const b = try talk.bodies(a, .{ .tokens = 3000, .tools = tools, .thinking = thinking, .seed = tools + @intFromBool(thinking) });
+        try out.appendSlice(a, &b);
+    };
+    return out.items;
+}
+
+/// TF_SERVE_PROMPT_ONCE, TF_SERVE_MEMO_SHORT and TF_SERVE_REPLY_SPANS.
+const Switches = struct { once: bool, short: bool, spans: bool };
+const settings = [_]Switches{ .{ .once = false, .short = false, .spans = false }, .{ .once = true, .short = false, .spans = false }, .{ .once = false, .short = true, .spans = false }, .{ .once = false, .short = false, .spans = true }, .{ .once = true, .short = true, .spans = true } };
+
+/// Sets `s` as the server and main set it at startup, with an empty memo.
+fn set(srv: *Server, text: *HfText, a: std.mem.Allocator, s: Switches) !void {
+    srv.prompt_once = s.once;
+    srv.reply_openers = if (s.spans) prompt.openers(srv, a) else null;
+    text.tok.memo.?.destroy();
+    text.tok.memo = try tokenizer.Memo.create(t.allocator, 64 << 20);
+    if (s.short) text.tok.memo.?.keepShort();
+}
+
+test "TF_SERVE switches: each on, and all on, give off's prompt, history, rewind, system prefix, spans and chunks" {
+    const gpa = t.allocator;
+    const dir = std.fs.path.dirname(options.tokenizer_path) orelse return error.SkipZigTest;
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    for ([_][2][]const u8{ .{ "m31", fixtures.m31 }, .{ "mia", fixtures.mia } }) |tp| {
+        var arena = std.heap.ArenaAllocator.init(gpa);
+        defer arena.deinit();
+        const a = arena.allocator();
+        try tmp.dir.writeFile(t.io, .{ .sub_path = "chat_template.jinja", .data = tp[1] });
+        const path = try tmp.dir.realPathFileAlloc(t.io, "chat_template.jinja", a);
+        var problem: []const u8 = "";
+        const text = HfText.load(gpa, t.io, dir, path, a, &problem) catch |err| {
+            std.debug.print("skipped: {s} ({s}); pass -Dmm3-tokenizer=<checkpoint>/tokenizer.json\n", .{ problem, @errorName(err) });
+            return error.SkipZigTest;
+        };
+        defer text.deinit();
+        try t.expect(text.compiled.?.generation != null); // else PROMPT_ONCE would quietly take off's path
+        var engine: stub.Stub = .{};
+        var compile: stub.Compile = .{};
+        var compiler = compile.compiler();
+        const srv = try stub.server(gpa, t.io, &engine, text, &compiler);
+        defer srv.deinit();
+        const bodies = try corpus(a, tp[0]);
+        const off = try a.alloc(Seen, bodies.len);
+        for (settings, 0..) |sw, n| {
+            try set(srv, text, a, sw); // a fresh memo each time: a conversation's second turn finds its first's segments
+            for (bodies, 0..) |body, i| {
+                const got = try prepared(srv, a, body);
+                if (n == 0) {
+                    off[i] = got;
+                    continue;
+                }
+                if (!off[i].same(got)) {
+                    std.debug.print("{s} {any}: differs from off for {s}\n", .{ tp[0], sw, body[0..@min(body.len, 200)] });
+                    return error.TestUnexpectedResult;
+                }
+            }
+        }
+        var checked: usize = 0;
+        var spanned: usize = 0;
+        for (off) |o| {
+            var planted = o; // the comparison catches a history one token short
+            planted.history_len -|= 1;
+            if (o.history_len > 0) try t.expect(!o.same(planted));
+            checked += @intFromBool(o.refused.len == 0 and o.history_len > 0);
+            spanned += @intFromBool(o.spans.len > 1);
+        }
+        try t.expect(checked >= 40 and spanned >= 8);
+    }
+}
+
+test {
+    _ = talk;
+}
diff --git a/zig/src/server/prompt_stub.zig b/zig/src/server/prompt_stub.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8c134457f27ce120fd0c71f720091362ee88c006
--- /dev/null
+++ b/zig/src/server/prompt_stub.zig
@@ -0,0 +1,57 @@
+//! A Server over a real HfText and an engine that never replies, for prompt-preparation benchmarks and checks.
+const std = @import("std");
+const api = @import("engine_api");
+const Server = @import("server.zig").Server;
+const HfText = @import("hf_text.zig").HfText;
+
+/// A served MiniMax lane engine's info (prompt cache, prefill chunks, grammars); a submit is refused.
+pub const Stub = struct {
+    pub fn engine(s: *Stub) api.Engine {
+        return .{ .ctx = s, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 1 << 20, .structures = true, .prompt_cache = true, .prefill_step = 2048 };
+    }
+    fn submit(_: *anyopaque, _: api.Id, _: *const api.Request, _: api.Sink) api.SubmitError!void {
+        return error.Busy;
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+/// Every grammar compiles: prompt preparation is measured and checked apart from xgrammar.
+pub const Compile = struct {
+    pub fn compiler(c: *Compile) api.grammar.Compiler {
+        var out: api.grammar.Compiler = undefined;
+        out.h = c;
+        out.words = 10;
+        out.mutex = .init;
+        out.f.compile = compile;
+        out.f.free = free;
+        out.f.close = free;
+        return out;
+    }
+    fn compile(ptr: *anyopaque, _: c_int, _: [*]const u8, _: usize, _: [*]u8, _: usize) callconv(.c) ?*anyopaque {
+        return ptr;
+    }
+    fn free(_: *anyopaque) callconv(.c) void {}
+};
+
+/// A Server on `text` and the stub engine; `compiler` must outlive it.
+pub fn server(gpa: std.mem.Allocator, io: std.Io, stub: *Stub, text: *HfText, compiler: *api.grammar.Compiler) !*Server {
+    const srv = try Server.init(gpa, io, stub.engine(), text.text(), .{ .served_name = "m", .model_ids = &.{"m"}, .use_drafts = false, .keep_warm_s = 0 }, null);
+    srv.grammars = compiler;
+    return srv;
+}
+
+/// Never cancelled.
+pub const Never = struct {
+    pub fn check(_: @This()) bool {
+        return false;
+    }
+};
diff --git a/zig/src/server/reasoning_markup.zig b/zig/src/server/reasoning_markup.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b1d4fe017b53f5a36286ced8a461ef85e98cccf6
--- /dev/null
+++ b/zig/src/server/reasoning_markup.zig
@@ -0,0 +1,223 @@
+//! What clients see of markup: reasoning and tool-reply content keep no call blocks or MiniMax namespace tags.
+const std = @import("std");
+const reply_text = @import("reply_text.zig");
+const tool_minimax = @import("tool_minimax.zig");
+const Allocator = std.mem.Allocator;
+
+const ns = tool_minimax.ns;
+/// Tags dropped wherever they stand: think tags nested in reasoning, every call markup's closer.
+const stray = [_][]const u8{ reply_text.mm_think_markers.open, reply_text.mm_think_markers.close, "<think>", "</think>" } ++ closers();
+
+fn closers() [reply_text.calls.len][]const u8 {
+    var out: [reply_text.calls.len][]const u8 = undefined;
+    for (reply_text.calls, &out) |c, *o| o.* = c[1];
+    return out;
+}
+
+/// `text`'s reasoning as clients see it; while streaming (`finished` false) a tag the end may still complete is held.
+pub fn clean(a: Allocator, text: []const u8, finished: bool) Allocator.Error![]const u8 {
+    const shown = try reply_text.hideToolCalls(a, text, finished);
+    var out: std.ArrayList(u8) = .empty;
+    _ = try read(a, shown, 0, &out, finished);
+    return held(&out, finished);
+}
+
+/// Bytes a step reads past its place at most: a step taken with this many ahead stands however the text grows.
+const ahead = blk: {
+    var n = ns.len + 1;
+    for (stray) |tag| n = @max(n, tag.len);
+    break :blk n;
+};
+
+/// Where a read stands for good: the text's bytes read and `out`'s bytes they gave.
+pub const Mark = struct { at: usize, len: usize };
+
+/// Cleans `shown` from `from` onto `out`; the mark through which no step depends on text not yet written.
+pub fn read(a: Allocator, shown: []const u8, from: usize, out: *std.ArrayList(u8), finished: bool) Allocator.Error!Mark {
+    var i = from;
+    var mark: Mark = .{ .at = i, .len = out.items.len };
+    var sure = true;
+    outer: while (i < shown.len) {
+        const room = shown.len - i >= ahead;
+        defer {
+            if (sure and !finished) mark = .{ .at = i, .len = out.items.len };
+        }
+        if (std.mem.startsWith(u8, shown[i..], ns)) {
+            const gt = std.mem.indexOfScalarPos(u8, shown, i + ns.len, '>');
+            const lt = i + ns.len < shown.len and shown[i + ns.len] == '<';
+            if (lt and gt != null) {
+                i = gt.? + 1; // a namespace element's tag: `NS<name ...>` or `NS</name>`
+                continue;
+            }
+            if (!finished and (gt == null and (lt or i + ns.len == shown.len))) {
+                sure = false;
+                break; // its tag may still be written
+            }
+            sure = sure and room;
+            i += ns.len;
+            continue;
+        }
+        sure = sure and room;
+        for (stray) |tag| if (std.mem.startsWith(u8, shown[i..], tag)) {
+            i += tag.len;
+            continue :outer;
+        };
+        try out.append(a, shown[i]);
+        i += 1;
+    }
+    return mark;
+}
+
+/// `out` without a tag its end may still complete, while streaming.
+fn held(out: *std.ArrayList(u8), finished: bool) []const u8 {
+    if (finished) return out.items;
+    var n: usize = reply_text.partialTag(out.items, ns);
+    for (stray) |tag| n = @max(n, reply_text.partialTag(out.items, tag));
+    return out.items[0 .. out.items.len - n];
+}
+
+/// A streamed reply's reasoning cleaned as `clean` cleans it, each read resumed where the last one stood for good.
+pub const Stream = struct {
+    off: ?usize = null, // where the shown reasoning starts in the reply; null: it was copied (a call block hid)
+    mark: Mark = .{ .at = 0, .len = 0 },
+    out: std.ArrayList(u8) = .empty,
+    hidden: std.ArrayList(u8) = .empty,
+    last: usize = 0, // where `out` lay after the last read
+    /// Since `sent` was last called: bytes of `out` no read rewrote, and whether `out` stayed where it was.
+    steady: usize = 0,
+    still: bool = false,
+
+    /// `clean(a, text, false)`; `text` lies in `reply`, which only grows, and `f` finds its tags.
+    pub fn clean(s: *Stream, a: Allocator, text: []const u8, reply: []const u8, f: reply_text.Finder) Allocator.Error![]const u8 {
+        const shown = try reply_text.hideIntoIn(a, &s.hidden, text, false, f, true);
+        const lo = @intFromPtr(reply.ptr);
+        const at = @intFromPtr(shown.ptr);
+        const off: ?usize = if (at >= lo and at + shown.len <= lo + reply.len) at - lo else null;
+        if (off == null or s.off == null or off.? != s.off.? or shown.len < s.mark.at) s.mark = .{ .at = 0, .len = 0 };
+        s.off = off;
+        s.out.shrinkRetainingCapacity(s.mark.len);
+        s.steady = @min(s.steady, s.mark.len);
+        s.mark = try read(a, shown, s.mark.at, &s.out, false);
+        if (off == null) s.mark = .{ .at = 0, .len = 0 };
+        s.still = s.still and @intFromPtr(s.out.items.ptr) == s.last;
+        s.last = @intFromPtr(s.out.items.ptr);
+        return held(&s.out, false);
+    }
+
+    /// The text the caller sent was read last: what `same` compares from.
+    pub fn sent(s: *Stream) void {
+        s.steady = std.math.maxInt(usize);
+        s.still = true;
+    }
+
+    /// Leading bytes of `now` (this read's text, maybe stripped) that equal the sent text, which lay at `was`.
+    pub fn same(s: *const Stream, now: []const u8, was: ?[*]const u8) usize {
+        if (!s.still or was != now.ptr) return 0;
+        const start = @intFromPtr(now.ptr) -| @intFromPtr(s.out.items.ptr);
+        return s.steady -| start;
+    }
+};
+
+/// A reply's content with no MiniMax namespace markup: a block no call came from goes whole, as the stream hid it.
+pub fn withoutNamespace(a: Allocator, text: []const u8) Allocator.Error![]const u8 {
+    return reply_text.pyRstrip(try namespaceFree(a, text, true));
+}
+
+/// `text` without MiniMax namespace markup; while streaming a tag not yet closed is held. Text without NS is `text`.
+pub fn namespaceFree(a: Allocator, text: []const u8, finished: bool) Allocator.Error![]const u8 {
+    if (std.mem.indexOf(u8, text, ns) == null) return text;
+    var out: std.ArrayList(u8) = .empty;
+    var i: usize = 0;
+    while (std.mem.indexOfPos(u8, text, i, ns)) |at| {
+        try out.appendSlice(a, text[i..at]);
+        if (std.mem.startsWith(u8, text[at..], tool_minimax.open)) {
+            const end = reply_text.findTag(text, at + tool_minimax.open.len, tool_minimax.close);
+            i = if (end) |e| e + tool_minimax.close.len else text.len;
+            continue;
+        }
+        const gt = std.mem.indexOfScalarPos(u8, text, at + ns.len, '>');
+        const lt = at + ns.len < text.len and text[at + ns.len] == '<';
+        if (!finished and gt == null and (lt or at + ns.len == text.len)) return out.items; // a tag still being written
+        i = if (lt and gt != null) gt.? + 1 else at + ns.len;
+    }
+    try out.appendSlice(a, text[i..]);
+    return out.items;
+}
+
+test "content keeps no MiniMax markup: a cut or unoffered block goes whole, a stray tag goes, prose stays" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const g = arena.allocator();
+    const cut = ns ++ "<tool_call>\n" ++ ns ++ "<invoke name=\"get_weather\">" ++ ns ++ "<city>Requir";
+    try std.testing.expectEqualStrings("", try withoutNamespace(g, cut));
+    try std.testing.expectEqualStrings("Before. After.", try withoutNamespace(g, "Before. " ++ ns ++ "<tool_call>\n" ++ ns ++ "<invoke name=\"nope\">" ++ ns ++ "</invoke>\n" ++ ns ++ "</tool_call>After."));
+    try std.testing.expectEqualStrings("a b", try withoutNamespace(g, "a " ++ ns ++ "<invoke name=\"x\">b"));
+    const plain = "no markup <tool_call>kept</tool_call> ";
+    try std.testing.expectEqual(plain.ptr, (try namespaceFree(g, plain, false)).ptr);
+    try std.testing.expectEqual(plain.ptr, (try withoutNamespace(g, plain)).ptr);
+    // streaming: every cut is a prefix of the finished text, and holds no markup
+    const reply = "Sure. " ++ ns ++ "<tool_call>\n" ++ ns ++ "<invoke name=\"get_weather\">" ++ ns ++ "<city>P" ++ ns ++ "</city>" ++ ns ++ "</invoke>\n" ++ ns ++ "</tool_call> Done " ++ ns ++ "<x>y";
+    const whole = try namespaceFree(g, reply, true);
+    try std.testing.expectEqualStrings("Sure.  Done y", whole);
+    for (0..reply.len + 1) |n| {
+        if (reply_text.partialTag(reply[0..n], ns) > 0) continue; // NS is one token: a stream never cuts inside it
+        const part = try namespaceFree(g, reply[0..n], false);
+        try std.testing.expect(std.mem.startsWith(u8, whole, part) and std.mem.indexOf(u8, part, "<invoke") == null);
+    }
+}
+
+test "reasoning that quotes a tool result's MiniMax markup comes back as its text, whole and at every streamed cut" {
+    const a = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    const g = arena.allocator();
+    const quoted = "The file holds " ++ ns ++ "<tool_call>\n" ++ ns ++ "<invoke name=\"bash\">" ++ ns ++ "<command>ls -la" ++ ns ++
+        "</command>" ++ ns ++ "</invoke>\n" ++ ns ++ "</tool_call>\n, a call in text. Partial: " ++ ns ++ "<invoke name=\"bash\">" ++
+        ns ++ "<command>pwd" ++ ns ++ "</command>" ++ ns ++ "</invoke> and </tool_call> and <mm:think>nested</mm:think> done.";
+    const whole = try clean(g, quoted, true);
+    try std.testing.expectEqualStrings("The file holds \n, a call in text. Partial: pwd and  and nested done.", whole);
+    for (0..quoted.len + 1) |n| {
+        const part = try clean(g, quoted[0..n], false);
+        std.testing.expect(std.mem.startsWith(u8, whole, part)) catch |e| {
+            std.debug.print("cut {d}: {s}\n", .{ n, part });
+            return e;
+        };
+        for ([_][]const u8{ ns, "<invoke", "tool_call>", "mm:think" }) |mark| try std.testing.expect(std.mem.indexOf(u8, part, mark) == null);
+    }
+    try std.testing.expectEqualStrings("plain < and > text", try clean(g, "plain < and > text", true));
+}
+
+test "reasoning keeps every other model's text as it was, and drops their call blocks" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const g = arena.allocator();
+    try std.testing.expectEqualStrings("I will call  then answer.", try clean(g, "I will call <tool_call>{\"name\":\"x\"}</tool_call> then answer.", true));
+    try std.testing.expectEqualStrings("a <b> c", try clean(g, "a <b> c", false));
+    try std.testing.expectEqualStrings("cut ", try clean(g, "cut <tool_c", false));
+}
+
+test "a streamed reasoning's resumed reads give clean's text at every cut, chunking and reply move" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const g = arena.allocator();
+    const replies = [_][]const u8{
+        "plan " ++ ns ++ "<invoke name=\"bash\">" ++ ns ++ "<command>ls" ++ ns ++ "</command> then </mm:think-ish <mm:think>x</think> " ++ ns ++ "y " ++ ns,
+        "quote " ++ ns ++ "<tool_call>\n" ++ ns ++ "<invoke name=\"a\">" ++ ns ++ "</invoke>\n" ++ ns ++ "</tool_call> after <tool_call>x</tool_call> end",
+        "a " ++ ns ++ "<b long tag without a close for a while and then> c </tool_call> <|tool_call>z<tool_call|> done",
+    };
+    for (replies) |reply| for ([_]usize{ 1, 2, 3, 7, 64 }) |step| for ([_]usize{ 0, 2 }) |start| {
+        var buf: std.ArrayList(u8) = .empty;
+        var s: Stream = .{};
+        var scan: @import("text_scan.zig").Scan = .{};
+        var n: usize = 0;
+        while (n < reply.len) {
+            const end = @min(reply.len, n + step);
+            try buf.appendSlice(g, reply[n..end]);
+            n = end;
+            try buf.ensureTotalCapacityPrecise(g, buf.capacity + 1); // the reply moves
+            scan.base = buf.items;
+            const text = buf.items[@min(start, buf.items.len)..];
+            try std.testing.expectEqualStrings(try clean(g, text, false), try s.clean(g, text, buf.items, scan.finder()));
+        }
+    };
+}
diff --git a/zig/src/server/reply_report.zig b/zig/src/server/reply_report.zig
new file mode 100644
index 0000000000000000000000000000000000000000..977128959513d1d98fdb7ae5a74272478087537d
--- /dev/null
+++ b/zig/src/server/reply_report.zig
@@ -0,0 +1,98 @@
+//! A finished reply's own numbers: its ``tensorfold`` runtime and ``speculative`` objects, and its done line.
+const std = @import("std");
+const json = @import("json");
+const log = @import("log.zig");
+const clock = @import("clock.zig");
+const tokens_mod = @import("tokens.zig");
+const Stages = @import("serve_stages.zig").Stages;
+const Mailbox = @import("mailbox.zig").Mailbox;
+const Server = @import("server.zig").Server;
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+const seconds = clock.seconds;
+
+pub const Report = struct {
+    srv: *Server,
+    box: *const Mailbox,
+    tokens: []const u32,
+    reply_id: []const u8,
+    prompt_len: usize,
+    received: i96,
+    first_ns: ?i96,
+    finished_ns: i96,
+    thinking: bool,
+    effort: ?[]const u8,
+    exact: bool,
+    drafts: bool,
+    seed: ?u64,
+    stages: ?*const Stages,
+
+    pub fn runtime(r: *const Report, a: Allocator) Allocator.Error!Value {
+        const m = r.box;
+        const decode_s: f64 = if (m.prefilled_ns) |p| @max(0, seconds(r.finished_ns - p)) else 0;
+        const decode_tokens = r.tokens.len -| 1;
+        const o = try json.newObject(a);
+        try o.put(a, "enable_thinking", .{ .bool = r.thinking });
+        try o.put(a, "reasoning_effort", if (!r.thinking) .{ .string = "none" } else if (r.effort) |e| .{ .string = e } else .null);
+        try o.put(a, "engine", .{ .string = r.srv.info.name });
+        try o.put(a, "tokens_per_second", .{ .float = if (decode_s > 0) @as(f64, @floatFromInt(decode_tokens)) / decode_s else 0 });
+        // the reply's decode seconds, as tokens_per_second divides them
+        try o.put(a, "seconds", .{ .float = @max(0, decode_s) });
+        try o.put(a, "prefill_seconds", if (m.stats.prefill_seconds) |p| .{ .float = p } else .null);
+        const widths = try a.alloc(Value, m.widths.len);
+        for (m.widths, widths) |w, *slot| slot.* = try json.intValue(a, w);
+        try o.put(a, "prefill_widths", .{ .array = widths });
+        const raised = try a.alloc(Value, m.raised.len);
+        for (m.raised, raised) |x, *slot| slot.* = .{ .bool = x };
+        try o.put(a, "prefill_raised", .{ .array = raised });
+        try o.put(a, "time_to_first_token", if (r.first_ns) |t| .{ .float = seconds(t - r.received) } else .null);
+        try o.put(a, "sampling", .{ .string = if (r.exact) "exact" else "greedy" });
+        try o.put(a, "drafts", .{ .bool = r.drafts });
+        const sha = tokens_mod.tokenSha(r.tokens);
+        try o.put(a, "token_sha", .{ .string = try a.dupe(u8, &sha) });
+        const sha256 = tokens_mod.tokenSha256(r.tokens);
+        try o.put(a, "token_sha256", .{ .string = try a.dupe(u8, &sha256) });
+        try o.put(a, "min_rows", try json.intValue(a, m.stats.min_rows));
+        if (m.stats.loop_period) |period| {
+            const loop_field = try json.newObject(a);
+            try loop_field.put(a, "period", try json.intValue(a, period));
+            try o.put(a, "loop", .{ .object = loop_field });
+        }
+        if (r.stages) |s| try o.put(a, "stages", try s.value(a));
+        return .{ .object = o };
+    }
+
+    pub fn speculative(r: *const Report, a: Allocator) Allocator.Error!Value {
+        const s = r.box.stats;
+        const spec = try json.newObject(a);
+        try spec.put(a, "rounds", try json.intValue(a, s.rounds));
+        try spec.put(a, "drafted", try json.intValue(a, s.drafted));
