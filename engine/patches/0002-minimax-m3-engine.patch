+//! A DFlash2 draft on one rank (engine_ops.Draft): the dspark draft's rings and kernels, plus convs and selector.
+const std = @import("std");
+const cuda = @import("cuda");
+const iface = @import("iface.zig");
+const ops = @import("engine_ops.zig");
+const exec = @import("forward_exec.zig");
+const plan = @import("forward_plan.zig");
+const weights = @import("weights.zig");
+const d2 = @import("dflash2_config.zig");
+const dw = @import("dflash2_weights.zig");
+const dspark = @import("dspark_device.zig");
+
+const ds = cuda.minimax_m3_dspark;
+const dk = cuda.minimax_m3_dflash2;
+const qmmf = cuda.qmmf;
+const DeviceBuffer = cuda.DeviceBuffer;
+
+pub const max_snaps = dspark.max_snaps;
+pub const Meta = dspark.Meta;
+
+/// The device scratch, one field a d2.scratch_fields entry in its order (then the lane matmul's split-K partials).
+const Scratch = struct {
+    buf: DeviceBuffer,
+    fc_out: u64,
+    hn: u64,
+    k_raw: u64,
+    v_raw: u64,
+    ids: u64,
+    res: u64,
+    a: u64,
+    conv: u64,
+    dyn: u64,
+    q_raw: u64,
+    kb_raw: u64,
+    vb_raw: u64,
+    qn: u64,
+    kn: u64,
+    vn: u64,
+    attn: u64,
+    part: u64,
+    sum: u64,
+    gath: u64,
+    gate: u64,
+    up: u64,
+    act: u64,
+    post: u64,
+    logits: u64,
+    cand_l: u64,
+    cand_a: u64,
+    sel_h: u64,
+    mm_part: u64,
+};
+
+comptime {
+    const names = @typeInfo(Scratch).@"struct".field_names;
+    std.debug.assert(names.len == d2.scratch_fields.len + 2);
+    for (d2.scratch_fields, names[1 .. names.len - 1]) |a, b| std.debug.assert(std.mem.eql(u8, a, b));
+}
+
+pub const Device = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    st: cuda.Stream,
+    cfg: d2.Config,
+    split: d2.Split,
+    model: dw.Model,
+    lane: qmmf.Lane,
+    k: *const ds.Dspark,
+    kd: dk.Dflash2,
+    m: *exec.Modules,
+    tw: *const weights.Weights, // the target's embedding and head
+    g: *const plan.Geometry,
+    link: ?exec.Link,
+    world: u32,
+    rank: u32,
+    ring_rows: u32,
+    ring_bytes: usize,
+    rings: []DeviceBuffer = &.{},
+    meta: []Meta = &.{},
+    snaps: [max_snaps]DeviceBuffer = undefined,
+    snap_meta: [max_snaps]Meta = @splat(.{}),
+    snap_made: bool = false,
+    results: DeviceBuffer = undefined, // [slots][max_block] of {i32 token, f32 share}
+    result_slots: u32 = 0,
+    sc: Scratch = undefined,
+
+    fn layout(dv: *const Device, assign: ?*Scratch) usize {
+        const sizes = d2.scratchSizes(&dv.cfg, dv.split, iface.prefill_rows, dv.g.slot, dv.world);
+        var total: usize = 0;
+        var all: [sizes.len + 1]u64 = undefined;
+        @memcpy(all[0..sizes.len], &sizes);
+        all[sizes.len] = dv.mmPartBytes();
+        var offs: [all.len]u64 = undefined;
+        for (all, &offs) |sz, *o| {
+            total = std.mem.alignForward(usize, total, 256);
+            o.* = total;
+            total += @intCast(sz);
+        }
+        if (assign) |s| inline for (@typeInfo(Scratch).@"struct".field_names[1..], 0..) |name, i| {
+            @field(s, name) = s.buf.ptr + offs[i];
+        };
+        return total;
+    }
+
+    fn mmPartBytes(dv: *const Device) usize {
+        var most: usize = 16;
+        const calls = [_]usize{ dspark.max_block, iface.prefill_rows };
+        for (dv.model.layers) |ly| for ([_]qmmf.Weight{ ly.q, ly.k, ly.v, ly.o, ly.gate, ly.up, ly.down, ly.a_proj, ly.m_proj }) |wt| {
+            for (calls) |mm| most = @max(most, dv.lane.partBytes(mm, wt));
+        };
+        for (calls) |mm| most = @max(most, @max(dv.lane.partBytes(mm, dv.model.fc), dv.lane.partBytes(mm, dv.model.hproj)));
+        return most;
+    }
+
+    pub fn open(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, ctx: *const cuda.Context, stream: cuda.Stream, dir: []const u8, cfg: d2.Config, m: *exec.Modules, tw: *const weights.Weights, g: *const plan.Geometry, link: ?exec.Link) !*Device {
+        if (cfg.block > dspark.max_block) return error.BadShape;
+        const split = try d2.Split.of(&cfg, g.rank, g.world);
+        const dv = try gpa.create(Device);
+        errdefer gpa.destroy(dv);
+        const cap = (try ctx.capability()) / 10;
+        dv.* = .{
+            .gpa = gpa,
+            .d = d,
+            .st = stream,
+            .cfg = cfg,
+            .split = split,
+            .model = try dw.loadModel(gpa, io, d, dir, &cfg, split),
+            .lane = undefined,
+            .k = &m.dspark,
+            .kd = undefined,
+            .m = m,
+            .tw = tw,
+            .g = g,
+            .link = link,
+            .world = g.world,
+            .rank = g.rank,
+            .ring_rows = @intCast(d2.ringRows(&cfg, iface.window_rows)),
+            .ring_bytes = @intCast(d2.ringBytes(&cfg, split, iface.window_rows)),
+        };
+        errdefer dv.model.deinit();
+        dv.kd = try dk.Dflash2.load(d);
+        errdefer dv.kd.unload();
+        dv.lane = try qmmf.Lane.load(d, cap);
+        errdefer dv.lane.unload();
+        dv.sc.buf = try DeviceBuffer.alloc(d, dv.layout(null));
+        errdefer dv.sc.buf.free();
+        _ = dv.layout(&dv.sc);
+        try dv.sc.buf.fill8(0, stream.handle);
+        var made: usize = 0;
+        errdefer for (dv.snaps[0..made]) |*b| b.free();
+        for (&dv.snaps) |*b| {
+            b.* = try DeviceBuffer.alloc(d, dv.ring_bytes);
+            made += 1;
+        }
+        dv.snap_made = true;
+        try stream.synchronize();
+        std.log.info("dflash2 draft: {d} layers, taps {any}, {d:.2} GiB of weights and {d:.2} GiB of scratch on rank {d}", .{ cfg.layers, cfg.tapIds(), gib(dv.model.bytes), gib(dv.sc.buf.len), dv.rank });
+        return dv;
+    }
+
+    fn gib(n: u64) f64 {
+        return @as(f64, @floatFromInt(n)) / (1 << 30);
+    }
+
+    pub fn interface(dv: *Device) ops.Draft {
+        return .{ .ptr = dv, .vtable = &.{ .attach = attach, .begin = begin, .absorb = absorb, .pass = pass, .result = result, .snap_save = snapSave, .snap_restore = snapRestore, .snap_drop = snapDrop, .deinit = deinit } };
+    }
+
+    /// Device bytes the draft holds on this rank besides its rings and snapshots.
+    pub fn bytes(dv: *const Device) u64 {
+        return dv.model.bytes + dv.sc.buf.len;
+    }
+
+    fn of(p: *anyopaque) *Device {
+        return @ptrCast(@alignCast(p));
+    }
+
+    fn freeRings(dv: *Device) void {
+        for (dv.rings) |*r| r.free();
+        dv.gpa.free(dv.rings);
+        dv.gpa.free(dv.meta);
+        dv.rings = &.{};
+        dv.meta = &.{};
+        if (dv.result_slots > 0) dv.results.free();
+        dv.result_slots = 0;
+    }
+
+    fn attach(p: *anyopaque, slots: u32) anyerror!void {
+        const dv = of(p);
+        dv.freeRings();
+        dv.rings = try dv.gpa.alloc(DeviceBuffer, slots);
+        errdefer dv.gpa.free(dv.rings);
+        dv.meta = try dv.gpa.alloc(Meta, slots);
+        errdefer dv.gpa.free(dv.meta);
+        var made: usize = 0;
+        errdefer for (dv.rings[0..made]) |*r| r.free();
+        for (dv.rings) |*r| {
+            r.* = try DeviceBuffer.alloc(dv.d, dv.ring_bytes);
+            made += 1;
+        }
+        @memset(dv.meta, .{});
+        dv.results = try DeviceBuffer.alloc(dv.d, @as(usize, slots) * dspark.max_block * 8);
+        dv.result_slots = slots;
+        try dv.results.fill8(0, dv.st.handle);
+    }
+
+    fn begin(p: *anyopaque, slot: u32) void {
+        const dv = of(p);
+        if (slot < dv.meta.len) dv.meta[slot] = .{};
+    }
+
+    /// K (kind 0) or V (kind 1) ring of layer `l` in a stream's buffer.
+    fn ringAt(dv: *const Device, base: u64, l: usize, kind: usize) u64 {
+        const one: u64 = @as(u64, dv.ring_rows) * dv.split.kv_heads * 128 * 2;
+        return base + (@as(u64, l) * 2 + kind) * one;
+    }
+
+    fn heads(dv: *const Device) ds.Heads {
+        const c = &dv.cfg;
+        return .{ .nq = dv.split.q_heads, .kvh = dv.split.kv_heads, .rot = c.rotary_dim, .theta = c.rope_theta, .eps = c.eps, .gemma = c.gemma_norm };
+    }
+
+    /// Tap rows [row0, row0 + rows): fc, hidden_norm, then each layer's K and V into the slot's ring (no conv).
+    fn absorb(p: *anyopaque, slot: u32, start: u32, rows: u32, base: u64, row0: u32) anyerror!void {
+        const dv = of(p);
+        if (slot >= dv.meta.len or rows == 0 or rows > iface.prefill_rows or base == 0) return error.BadAbsorb;
+        const c = &dv.cfg;
+        const sc = &dv.sc;
+        const x = base + @as(u64, row0) * c.fcIn() * 2;
+        try dv.lane.matmul(dv.st, x, c.fcIn(), rows, dv.model.fc, sc.fc_out, sc.mm_part);
+        try dv.k.norm(dv.st, sc.fc_out, false, dv.model.hidden_norm, c.gemma_norm, sc.hn, rows, c.hidden, c.eps);
+        const ring = dv.rings[slot].ptr;
+        var kh = dv.heads();
+        kh.nq = 0; // (ring_put reads no query heads)
+        for (dv.model.layers, 0..) |ly, l| {
+            try dv.lane.matmul(dv.st, sc.hn, c.hidden, rows, ly.k, sc.k_raw, sc.mm_part);
+            try dv.lane.matmul(dv.st, sc.hn, c.hidden, rows, ly.v, sc.v_raw, sc.mm_part);
+            try dv.k.ringPut(dv.st, kh, sc.k_raw, sc.v_raw, ly.k_norm, dv.ringAt(ring, l, 0), dv.ringAt(ring, l, 1), dv.ring_rows, rows, start);
+        }
+        dv.meta[slot] = dspark.afterAbsorb(dv.meta[slot], start, rows, dv.ring_rows);
+    }
+
+    /// `src` f32 [rows][hidden] partial sums of the ranks added in rank order into `dst` (src itself on one rank).
+    fn exchange(dv: *const Device, src: u64, dst: u64, rows: u32) !u64 {
+        const link = dv.link orelse return src;
+        const n: usize = @as(usize, rows) * dv.cfg.hidden;
+        try link.group.allGather(dv.st, src, dv.sc.gath, n * 4);
+        try dv.m.scatter.rankSum(dv.st, dv.sc.gath, src, dv.world, dv.rank, n, dst);
+        return dst;
+    }
+
+    fn pass(p: *anyopaque, req: ops.DraftPass) anyerror!void {
+        const dv = of(p);
+        if (req.slot >= dv.meta.len) return error.BadPass;
+        try dv.block(req);
+        try dv.choose(req);
+    }
+
+    /// The MLP's activation: silu(g) * u, or the config's swigluoai (MiniMax's (u + 1) form).
+    fn actParams(c: *const d2.Config) cuda.minimax_m3_act.Params {
+        return switch (c.act) {
+            .silu => .{ .alpha = 1.0, .limit = 0, .up_bias = 0 },
+            .swigluoai => .{ .alpha = c.swiglu_alpha, .limit = c.swiglu_limit, .up_bias = 1.0 },
+        };
+    }
+
+    /// The block's layers and the final norm: `sc.post` [block][hidden] bf16.
+    pub fn block(dv: *Device, req: ops.DraftPass) !void {
+        const c = &dv.cfg;
+        const sc = &dv.sc;
+        const rows: u32 = c.block;
+        const h: u32 = c.hidden;
+        const n: usize = @as(usize, rows) * h;
+        const lo = dspark.passWindow(dv.meta[req.slot], req.pos, dv.ring_rows);
+        const ring = dv.rings[req.slot].ptr;
+        var ids: [dspark.max_block]u32 = @splat(c.mask_token);
+        ids[0] = req.anchor;
+        try dv.sc.buf.uploadAsync(sc.ids - dv.sc.buf.ptr, std.mem.sliceAsBytes(ids[0..rows]), dv.st.handle);
+        try dv.m.embed.bf16(dv.st, sc.ids, dv.tw.embed, sc.a, rows, h);
+        try dv.k.add(dv.st, 0, sc.a, false, sc.res, n);
+        const attn: ds.Attn = .{ .nq = dv.split.q_heads, .kvh = dv.split.kv_heads, .ring_rows = dv.ring_rows, .window = c.window, .scale = @floatCast(std.math.pow(f64, @floatFromInt(c.head_dim), -0.5)) };
+        const conv: dk.Conv = .{ .hidden = h, .group = c.group, .ld_dyn = c.dynWidth(), .rows = rows };
+        const ffn = dv.split.ffn;
+        for (dv.model.layers, 0..) |ly, l| {
+            // attention inside the attention conv: its first branch before q/k/v, its second on o's output
+            try dv.k.norm(dv.st, sc.res, true, ly.input_ln, c.gemma_norm, sc.a, rows, h, c.eps);
+            try dv.lane.matmul(dv.st, sc.a, h, rows, ly.a_proj, sc.dyn, sc.mm_part);
+            try dv.kd.conv(dv.st, conv, sc.a, false, sc.dyn, 0, ly.a_base, sc.conv, false);
+            try dv.lane.matmul(dv.st, sc.conv, h, rows, ly.q, sc.q_raw, sc.mm_part);
+            try dv.lane.matmul(dv.st, sc.conv, h, rows, ly.k, sc.kb_raw, sc.mm_part);
+            try dv.lane.matmul(dv.st, sc.conv, h, rows, ly.v, sc.vb_raw, sc.mm_part);
+            try dv.k.blockHeads(dv.st, dv.heads(), sc.q_raw, sc.kb_raw, sc.vb_raw, ly.q_norm, ly.k_norm, sc.qn, sc.kn, sc.vn, rows, req.pos);
+            try dv.k.blockAttn(dv.st, attn, sc.qn, dv.ringAt(ring, l, 0), dv.ringAt(ring, l, 1), sc.kn, sc.vn, sc.attn, rows, req.pos, lo);
+            try dv.lane.matmulF32(dv.st, sc.attn, @as(usize, dv.split.q_heads) * c.head_dim, rows, ly.o, sc.part, sc.mm_part);
+            const o_sum = try dv.exchange(sc.part, sc.sum, rows);
+            try dv.kd.conv(dv.st, conv, o_sum, true, sc.dyn, 1, ly.a_base, sc.res, true);
+            // the MLP inside the MLP conv
+            try dv.k.norm(dv.st, sc.res, true, ly.post_ln, c.gemma_norm, sc.a, rows, h, c.eps);
+            try dv.lane.matmul(dv.st, sc.a, h, rows, ly.m_proj, sc.dyn, sc.mm_part);
+            try dv.kd.conv(dv.st, conv, sc.a, false, sc.dyn, 0, ly.m_base, sc.conv, false);
+            try dv.lane.matmul(dv.st, sc.conv, h, rows, ly.gate, sc.gate, sc.mm_part);
+            try dv.lane.matmul(dv.st, sc.conv, h, rows, ly.up, sc.up, sc.mm_part);
+            try dv.m.act.swigluoai(dv.st, .bf16, sc.gate, ffn, sc.up, ffn, sc.act, ffn, rows, ffn, actParams(c));
+            try dv.lane.matmulF32(dv.st, sc.act, ffn, rows, ly.down, sc.part, sc.mm_part);
+            const d_sum = try dv.exchange(sc.part, sc.sum, rows);
+            try dv.kd.conv(dv.st, conv, d_sum, true, sc.dyn, 1, ly.m_base, sc.res, true);
+        }
+        try dv.k.norm(dv.st, sc.res, true, dv.model.final_norm, c.gemma_norm, sc.post, rows, h, c.eps);
+    }
+
+    /// The target's head over every block row, each rank's best `top_k`, gathered; the selector's path on every rank.
+    fn choose(dv: *Device, req: ops.DraftPass) !void {
+        const c = &dv.cfg;
+        const sc = &dv.sc;
+        const rows: u32 = c.block;
+        try dv.m.dense.decode(dv.st, dv.tw.head, sc.post, .bf16, rows, sc.logits, .f32);
+        try dv.k.topC(dv.st, sc.logits, dv.tw.head.n, dv.g.own_vocab, dv.g.vocab_lo, rows, c.top_k, sc.cand_l);
+        var all = sc.cand_l;
+        if (dv.link) |link| {
+            try link.group.allGather(dv.st, sc.cand_l, sc.cand_a, @as(usize, rows) * c.top_k * 8);
+            all = sc.cand_a;
+        }
+        try dv.lane.matmulF32(dv.st, sc.post, c.hidden, rows, dv.model.hproj, sc.sel_h, sc.mm_part);
+        const out = dv.results.ptr + @as(u64, req.slot) * dspark.max_block * 8;
+        try dv.kd.select(dv.st, .{ .rank = c.rank, .top_k = c.top_k, .world = dv.world, .rows = rows }, req.anchor, all, sc.sel_h, dv.model.pred, dv.model.succ, out);
+    }
+
+    fn result(p: *anyopaque, slot: u32, out: *ops.DraftResult) anyerror!void {
+        const dv = of(p);
+        if (slot >= dv.result_slots) return error.BadPass;
+        try dv.st.synchronize();
+        var raw: [dspark.max_block * 8]u8 = undefined;
+        try dv.results.download(@as(usize, slot) * dspark.max_block * 8, &raw);
+        const n = dv.cfg.depth();
+        out.* = .{ .n = n };
+        for (0..n) |i| {
+            out.tokens[i] = std.mem.readInt(i32, raw[8 * i ..][0..4], .little);
+            out.conf[i] = @bitCast(std.mem.readInt(u32, raw[8 * i + 4 ..][0..4], .little));
+        }
+    }
+
+    fn snapSave(p: *anyopaque, slot: u32, id: u32) anyerror!void {
+        const dv = of(p);
+        if (slot >= dv.meta.len or id >= max_snaps) return error.BadSnap;
+        try dv.d.check(dv.d.api.cuMemcpyDtoDAsync_v2(dv.snaps[id].ptr, dv.rings[slot].ptr, dv.ring_bytes, dv.st.handle), "cuMemcpyDtoDAsync");
+        dv.snap_meta[id] = dv.meta[slot];
+    }
+
+    fn snapRestore(p: *anyopaque, slot: u32, id: u32) anyerror!void {
+        const dv = of(p);
+        if (slot >= dv.meta.len or id >= max_snaps) return error.BadSnap;
+        try dv.d.check(dv.d.api.cuMemcpyDtoDAsync_v2(dv.rings[slot].ptr, dv.snaps[id].ptr, dv.ring_bytes, dv.st.handle), "cuMemcpyDtoDAsync");
+        dv.meta[slot] = dv.snap_meta[id];
+    }
+
+    fn snapDrop(_: *anyopaque, _: u32) void {}
+
+    fn deinit(p: *anyopaque) void {
+        const dv = of(p);
+        dv.st.synchronize() catch {};
+        dv.freeRings();
+        if (dv.snap_made) for (&dv.snaps) |*b| b.free();
+        dv.sc.buf.free();
+        dv.lane.unload();
+        dv.kd.unload();
+        dv.model.deinit();
+        dv.gpa.destroy(dv);
+    }
+};
diff --git a/zig/src/families/minimax_m3/dflash2_ref.zig b/zig/src/families/minimax_m3/dflash2_ref.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1dffc9ac8fe8a16d875ee18592e2d178efcfd3fb
--- /dev/null
+++ b/zig/src/families/minimax_m3/dflash2_ref.zig
@@ -0,0 +1,338 @@
+//! The DFlash2 draft's own kernels on the CPU in float64: the two-tap dynamic conv and the candidate path selector.
+const std = @import("std");
+// Inputs are the kernels' own (bf16 bits, f32 values, {logit bits, id} pairs), so a GPU check reads what they read.
+
+/// An id slot with no candidate: a rank with fewer valid logits than top_k pads with it.
+pub const none: u32 = 0xffff_ffff;
+pub const max_top_k = 64;
+pub const max_cand = 128;
+
+pub fn bf(h: u16) f64 {
+    return @as(f32, @bitCast(@as(u32, h) << 16));
+}
+
+// ---- the dynamic conv ------------------------------------------------------------------------------------------
+
+/// The conv's input rows [rows][hidden]: bf16 bits or f32 values.
+pub const Z = union(enum) {
+    bf16: []const u16,
+    f32: []const f32,
+
+    pub fn at(z: Z, i: usize) f64 {
+        return switch (z) {
+            .bf16 => |v| bf(v[i]),
+            .f32 => |v| v[i],
+        };
+    }
+};
+
+/// One conv call: side `which` of base [2 sides][2 lags][hidden] and of dyn [rows][ld_dyn] (side, lag, group).
+pub const Conv = struct {
+    z: Z,
+    dyn: []const u16,
+    ld_dyn: usize,
+    which: usize,
+    base: []const u16,
+    hidden: usize,
+    group: usize,
+    rows: usize,
+
+    /// Lag `lag`'s coefficient of channel `ch` at row t: base[which][lag][ch] + dyn[t][which][lag][ch / group].
+    pub fn coef(c: Conv, t: usize, lag: usize, ch: usize) f64 {
+        const groups = c.hidden / c.group;
+        const side = c.which * 2 + lag;
+        return bf(c.base[side * c.hidden + ch]) + bf(c.dyn[t * c.ld_dyn + side * groups + ch / c.group]);
+    }
+};
+
+/// y[t][ch] = coef(t, 0, ch) z[t][ch] + coef(t, 1, ch) z[t-1][ch] with z[-1] = 0, plus acc when given (the f32 add).
+pub fn conv(c: Conv, acc: ?[]const f32, out: []f64, mag: ?[]f64) void {
+    for (0..c.rows) |t| for (0..c.hidden) |ch| {
+        const i = t * c.hidden + ch;
+        const last: f64 = if (t > 0) c.z.at(i - c.hidden) else 0;
+        const a = c.coef(t, 0, ch) * c.z.at(i);
+        const b = c.coef(t, 1, ch) * last;
+        const prior: f64 = if (acc) |v| v[i] else 0;
+        out[i] = prior + (a + b);
+        if (mag) |m| m[i] = @abs(prior) + @abs(a) + @abs(b);
+    };
+}
+
+// ---- the selector ----------------------------------------------------------------------------------------------
+
+pub const Cand = struct { logit: f32, id: u32 };
+
+/// True when b comes before a: the larger logit, then the lower id, NaN logits last (the kernel's `beats`).
+pub fn before(b: Cand, a: Cand) bool {
+    const an = std.math.isNan(a.logit);
+    const bn = std.math.isNan(b.logit);
+    if (an and bn) return b.id < a.id;
+    if (bn) return false;
+    if (an) return true;
+    return b.logit > a.logit or (b.logit == a.logit and b.id < a.id);
+}
+
+fn first(_: void, a: Cand, b: Cand) bool {
+    return before(a, b);
+}
+
+/// A selector call: cands [world][rows][top_k] {logit bits, id}, h f32 [rows][rank], pred, succ bf16 [vocab][rank].
+pub const Select = struct {
+    cands: []const u32,
+    h: []const f32,
+    pred: []const u16,
+    succ: []const u16,
+    rank: usize,
+    top_k: usize,
+    world: usize,
+    rows: usize,
+    anchor: u32,
+    temp: f64 = 1,
+
+    pub fn cand(s: Select, w: usize, t: usize, j: usize) Cand {
+        const at = ((w * s.rows + t) * s.top_k + j) * 2;
+        return .{ .logit = @bitCast(s.cands[at]), .id = s.cands[at + 1] };
+    }
+};
+
+/// A row's k best candidates in order, their float64 scores after one predecessor, and the pick (null: no candidate).
+pub const Row = struct {
+    m: usize = 0,
+    c: [max_top_k]Cand = undefined,
+    score: [max_top_k]f64 = undefined,
+    /// |logit| plus the dot's |terms|: the magnitude an fp32 score's error bound scales.
+    mag: [max_top_k]f64 = undefined,
+    pick: ?usize = null,
+
+    /// Candidate `at`'s share: 1 / sum_i exp((score_i - score_at) / temp).
+    pub fn share(r: *const Row, at: usize, temp: f64) f64 {
+        var z: f64 = 0;
+        for (r.score[0..r.m]) |s| z += @exp((s - r.score[at]) / temp);
+        return 1 / z;
+    }
+};
+
+/// The first NaN if any, else the first maximum (torch.argmax and the kernel); null for no scores.
+pub fn firstBest(s: []const f64) ?usize {
+    var b: ?usize = null;
+    for (s, 0..) |v, i| {
+        if (std.math.isNan(v)) return i;
+        if (b == null or v > s[b.?]) b = i;
+    }
+    return b;
+}
+
+/// Row t after `prev`: the ranks' candidates gathered, the k best kept, each scored logit + <pred[prev] * h[t], succ>.
+pub fn row(s: Select, t: usize, prev: u32) Row {
+    var all: [max_cand]Cand = undefined;
+    var n: usize = 0;
+    for (0..s.world) |w| for (0..s.top_k) |j| {
+        const x = s.cand(w, t, j);
+        if (x.id == none) continue;
+        all[n] = x;
+        n += 1;
+    };
+    std.mem.sort(Cand, all[0..n], {}, first);
+    var r: Row = .{ .m = @min(n, s.top_k) };
+    const p = s.pred[@as(usize, prev) * s.rank ..][0..s.rank];
+    const hr = s.h[t * s.rank ..][0..s.rank];
+    for (all[0..r.m], 0..) |x, i| {
+        const q = s.succ[@as(usize, x.id) * s.rank ..][0..s.rank];
+        var dot: f64 = 0;
+        var m: f64 = 0;
+        for (p, hr, q) |a, b, cc| {
+            const term = bf(a) * b * bf(cc);
+            dot += term;
+            m += @abs(term);
+        }
+        r.c[i] = x;
+        r.score[i] = @as(f64, x.logit) + dot;
+        r.mag[i] = @abs(@as(f64, x.logit)) + m;
+    }
+    r.pick = firstBest(r.score[0..r.m]);
+    return r;
+}
+
+pub const Pick = struct { id: u32, share: f64 };
+
+/// The path, out[t - 1] for t = 1 .. rows - 1; a row with no candidate gives {none, 0} and the anchor leads the next.
+pub fn select(s: Select, out: []Pick) void {
+    var prev = s.anchor;
+    for (1..s.rows) |t| {
+        const r = row(s, t, prev);
+        if (r.pick) |b| {
+            out[t - 1] = .{ .id = r.c[b].id, .share = r.share(b, s.temp) };
+            prev = r.c[b].id;
+        } else {
+            out[t - 1] = .{ .id = none, .share = 0 };
+            prev = s.anchor;
+        }
+    }
+}
+
+// ---- tests -----------------------------------------------------------------------------------------------------
+
+const testing = std.testing;
+
+fn b16(v: f32) u16 {
+    return @truncate(@as(u32, @bitCast(v)) >> 16);
+}
+
+fn put(cands: []u32, rows: usize, k: usize, w: usize, t: usize, j: usize, logit: f32, id: u32) void {
+    const at = ((w * rows + t) * k + j) * 2;
+    cands[at] = @bitCast(logit);
+    cands[at + 1] = id;
+}
+
+/// hidden 4 in groups of 2, two rows; dyn row 0 holds a side-1 lag-1 coefficient that z[-1] = 0 must cancel.
+const conv_dyn = [2][8]f32{ .{ 0.25, 0, 0, 0, 0, 0, 0.5, 0 }, .{ 0, 0.5, 0.25, 0, 0, 0, 0, 0 } };
+const conv_base = [16]f32{ 1, 1, 1, 1, 0.5, 0.5, 0.5, 0.5, 2, 2, 2, 2, -1, -1, -1, -1 };
+const conv_z = [8]f32{ 1, 2, 3, 4, -1, 0.5, 2, 1 };
+
+fn convCase(dyn: *[16]u16, base: *[16]u16, zb: *[8]u16) void {
+    for (0..2) |t| for (0..8) |i| {
+        dyn[t * 8 + i] = b16(conv_dyn[t][i]);
+    };
+    for (base, conv_base) |*o, v| o.* = b16(v);
+    for (zb, conv_z) |*o, v| o.* = b16(v);
+}
+
+test "conv side 0: lag 0 alone at row 0, the previous row at lag 1 after it, a coefficient a group" {
+    var dyn: [16]u16 = undefined;
+    var base: [16]u16 = undefined;
+    var zb: [8]u16 = undefined;
+    convCase(&dyn, &base, &zb);
+    var out: [8]f64 = undefined;
+    conv(.{ .z = .{ .bf16 = &zb }, .dyn = &dyn, .ld_dyn = 8, .which = 0, .base = &base, .hidden = 4, .group = 2, .rows = 2 }, null, &out, null);
+    try testing.expectEqualSlices(f64, &.{ 1.25, 2.5, 3, 4, -0.25, 2, 4.5, 3.5 }, &out);
+}
+
+test "conv side 1 added to f32: row 0's lag 1 is zero although its coefficient is not" {
+    var dyn: [16]u16 = undefined;
+    var base: [16]u16 = undefined;
+    var zb: [8]u16 = undefined;
+    convCase(&dyn, &base, &zb);
+    const acc = [8]f32{ 10, 10, 10, 10, 0, 0, 0, 0 };
+    var out: [8]f64 = undefined;
+    var mag: [8]f64 = undefined;
+    conv(.{ .z = .{ .f32 = &conv_z }, .dyn = &dyn, .ld_dyn = 8, .which = 1, .base = &base, .hidden = 4, .group = 2, .rows = 2 }, &acc, &out, &mag);
+    try testing.expectEqualSlices(f64, &.{ 12, 14, 16, 18, -3, -1, 1, -2 }, &out);
+    try testing.expectEqual(@as(f64, 10 + 2 * 1), mag[0]);
+    try testing.expectEqual(@as(f64, 2 * 1 + 1 * 4), mag[7]);
+}
+
+test "conv: a NaN lag-1 coefficient at row 0 meets z[-1] = 0 and gives NaN, as the reference's zero row does" {
+    var dyn: [16]u16 = undefined;
+    var base: [16]u16 = undefined;
+    var zb: [8]u16 = undefined;
+    convCase(&dyn, &base, &zb);
+    dyn[6] = b16(std.math.nan(f32)); // row 0, side 1, lag 1, group 0
+    var out: [8]f64 = undefined;
+    conv(.{ .z = .{ .bf16 = &zb }, .dyn = &dyn, .ld_dyn = 8, .which = 1, .base = &base, .hidden = 4, .group = 2, .rows = 2 }, null, &out, null);
+    try testing.expect(std.math.isNan(out[0]) and std.math.isNan(out[1]));
+    try testing.expectEqual(@as(f64, 6), out[2]);
+    try testing.expectEqual(@as(f64, -3), out[4]); // row 1 reads its own coefficients
+}
+
+test "order: larger logit, then lower id, NaN last; -0 ties +0" {
+    const nan = std.math.nan(f32);
+    try testing.expect(before(.{ .logit = 2, .id = 9 }, .{ .logit = 1, .id = 0 }));
+    try testing.expect(before(.{ .logit = 1, .id = 3 }, .{ .logit = 1, .id = 4 }));
+    try testing.expect(before(.{ .logit = -0.0, .id = 3 }, .{ .logit = 0.0, .id = 4 }));
+    try testing.expect(before(.{ .logit = -std.math.inf(f32), .id = 9 }, .{ .logit = nan, .id = 0 }));
+    try testing.expect(before(.{ .logit = nan, .id = 1 }, .{ .logit = nan, .id = 2 }));
+    try testing.expect(!before(.{ .logit = nan, .id = 0 }, .{ .logit = -1, .id = 5 }));
+    try testing.expectEqual(@as(?usize, 1), firstBest(&.{ 1, 3, 3 }));
+    try testing.expectEqual(@as(?usize, 1), firstBest(&.{ 5, std.math.nan(f64), std.math.nan(f64) }));
+    try testing.expectEqual(@as(?usize, null), firstBest(&.{}));
+}
+
+test "select: two ranks' candidates merge into the k best, a missing one is skipped, row 2 follows row 1's pick" {
+    const rows = 3;
+    const k = 2;
+    var cands: [2 * rows * k * 2]u32 = @splat(0);
+    put(&cands, rows, k, 0, 1, 0, 3, 1);
+    put(&cands, rows, k, 0, 1, 1, 1, 2);
+    put(&cands, rows, k, 1, 1, 0, 2, 5);
+    put(&cands, rows, k, 1, 1, 1, -std.math.inf(f32), none);
+    put(&cands, rows, k, 0, 2, 0, 1, 3);
+    put(&cands, rows, k, 0, 2, 1, -std.math.inf(f32), none);
+    put(&cands, rows, k, 1, 2, 0, 0.5, 4);
+    put(&cands, rows, k, 1, 2, 1, 0.25, 6);
+    var pred: [8 * 2]u16 = @splat(0);
+    var succ: [8 * 2]u16 = @splat(0);
+    pred[1 * 2] = b16(1); // pred[1] = (1, 0)
+    succ[4 * 2] = b16(1); // succ[4] = (1, 0)
+    const h = [rows * 2]f32{ 0, 0, 0, 0, 2, 0 };
+    const s: Select = .{ .cands = &cands, .h = &h, .pred = &pred, .succ = &succ, .rank = 2, .top_k = k, .world = 2, .rows = rows, .anchor = 0 };
+    const r1 = row(s, 1, 0);
+    try testing.expectEqual(@as(usize, 2), r1.m);
+    try testing.expectEqual(@as(u32, 1), r1.c[0].id);
+    try testing.expectEqual(@as(u32, 5), r1.c[1].id);
+    var out: [rows - 1]Pick = undefined;
+    select(s, &out);
+    try testing.expectEqual(@as(u32, 1), out[0].id);
+    try testing.expectApproxEqRel(1 / (1 + @exp(@as(f64, -1))), out[0].share, 1e-15);
+    // after id 1: id 4 scores 0.5 + 1 * 2 * 1 = 2.5 over id 3's 1 (after the anchor id 3 would win)
+    try testing.expectEqual(@as(u32, 4), out[1].id);
+    try testing.expectApproxEqRel(1 / (1 + @exp(@as(f64, -1.5))), out[1].share, 1e-15);
+    try testing.expectEqual(@as(u32, 3), row(s, 2, 0).c[row(s, 2, 0).pick.?].id);
+}
+
+test "select: a tie goes to the lower id, a row with no candidate gives none and the anchor leads the next row" {
+    const rows = 4;
+    const k = 2;
+    var cands: [2 * rows * k * 2]u32 = undefined;
+    for (0..2) |w| for (0..rows) |t| for (0..k) |j| put(&cands, rows, k, w, t, j, -std.math.inf(f32), none);
+    put(&cands, rows, k, 0, 1, 0, 2, 5);
+    put(&cands, rows, k, 0, 1, 1, 2, 6);
+    put(&cands, rows, k, 1, 1, 0, 2, 2); // gathered last, ordered first
+    put(&cands, rows, k, 0, 3, 0, 1, 1);
+    put(&cands, rows, k, 1, 3, 0, 0.5, 4);
+    var pred: [8 * 2]u16 = @splat(0);
+    var succ: [8 * 2]u16 = @splat(0);
+    pred[7 * 2] = b16(1);
+    pred[7 * 2 + 1] = b16(1); // the anchor's row; id 2's is zero
+    succ[4 * 2] = b16(1);
+    const h = [rows * 2]f32{ 0, 0, 0, 0, 0, 0, 1, 1 };
+    const s: Select = .{ .cands = &cands, .h = &h, .pred = &pred, .succ = &succ, .rank = 2, .top_k = k, .world = 2, .rows = rows, .anchor = 7, .temp = 0.5 };
+    const r1 = row(s, 1, 7);
+    try testing.expectEqual(@as(u32, 2), r1.c[0].id);
+    try testing.expectEqual(@as(u32, 5), r1.c[1].id); // id 6 ties too but falls past top_k
+    var out: [rows - 1]Pick = undefined;
+    select(s, &out);
+    try testing.expectEqual(@as(u32, 2), out[0].id);
+    try testing.expectEqual(@as(f64, 0.5), out[0].share);
+    try testing.expectEqual(Pick{ .id = none, .share = 0 }, out[1]);
+    // after the anchor id 4 scores 0.5 + 1 = 1.5 over id 1's 1; after a stale id 2 it would lose
+    try testing.expectEqual(@as(u32, 4), out[2].id);
+    try testing.expectApproxEqRel(1 / (1 + @exp(@as(f64, -1))), out[2].share, 1e-15);
+    try testing.expectEqual(@as(u32, 1), row(s, 3, 2).c[row(s, 3, 2).pick.?].id);
+}
+
+test "select: a NaN score is picked first and its share is NaN; NaN logits sort past the k best" {
+    const rows = 2;
+    const k = 3;
+    var cands: [rows * k * 2]u32 = @splat(0);
+    put(&cands, rows, k, 0, 1, 0, 1, 1);
+    put(&cands, rows, k, 0, 1, 1, std.math.nan(f32), 2);
+    put(&cands, rows, k, 0, 1, 2, 3, 3);
+    const zero: [4 * 2]u16 = @splat(0);
+    const h = [rows * 2]f32{ 0, 0, 0, 0 };
+    var s: Select = .{ .cands = &cands, .h = &h, .pred = &zero, .succ = &zero, .rank = 2, .top_k = k, .world = 1, .rows = rows, .anchor = 0 };
+    var out: [1]Pick = undefined;
+    select(s, &out);
+    try testing.expectEqual(@as(u32, 2), out[0].id);
+    try testing.expect(std.math.isNan(out[0].share));
+    var two: [2 * rows * 1 * 2]u32 = @splat(0); // two ranks of one: rank 0's NaN logit falls past the k best
+    put(&two, rows, 1, 0, 1, 0, std.math.nan(f32), 2);
+    put(&two, rows, 1, 1, 1, 0, 3, 3);
+    s.cands = &two;
+    s.top_k = 1;
+    s.world = 2;
+    const r = row(s, 1, 0);
+    try testing.expectEqual(@as(usize, 1), r.m);
+    try testing.expectEqual(@as(u32, 3), r.c[0].id);
+    select(s, &out);
+    try testing.expectEqual(Pick{ .id = 3, .share = 1 }, out[0]);
+}
