+/// tf-cuda-test mm3-dspark-bench: milliseconds a launch of the shipped shapes takes (no contract).
+pub fn bench(gpu: @import("check.zig").Gpu) !void {
+    const check = @import("check.zig");
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var k = try ds.Dspark.load(gpu.d);
+    defer k.unload();
+    var set: Set = undefined;
+    set.init(gpu, s, &k);
+    defer set.deinit();
+    const runs = 50;
+    const Item = struct { name: []const u8, shape: c.Shape };
+    inline for (.{
+        .{ "attns", 0, Item{ .name = "tf_mm3_ds_attn 7 rows, 4096 context keys", .shape = .{ .rows = 7, .n = nq, .k = 4096 } } },
+        .{ "attns", 0, Item{ .name = "tf_mm3_ds_attn 7 rows, 1000 context keys", .shape = .{ .rows = 7, .n = nq, .k = 1000 } } },
+        .{ "topcs", 0, Item{ .name = "tf_mm3_ds_topc 7 rows, n 100096, c 64", .shape = .{ .rows = 7, .n = slot_n, .k = 64 } } },
+        .{ "chains", 0, Item{ .name = "tf_mm3_ds_chain 7 rows, 2 x 64 candidates", .shape = .{ .rows = 7, .n = cand, .k = 2 } } },
+        .{ "norms", 0, Item{ .name = "tf_mm3_ds_norm_bf16 7 rows", .shape = .{ .rows = 7, .n = hidden, .k = hidden } } },
+        .{ "norms", 0, Item{ .name = "tf_mm3_ds_norm_bf16 2048 rows of 6144", .shape = .{ .rows = 2048, .n = hidden, .k = hidden } } },
+        .{ "blocks", 0, Item{ .name = "tf_mm3_ds_block_heads 7 rows", .shape = .{ .rows = 7, .n = nq, .k = 3000 } } },
+        .{ "rings", 0, Item{ .name = "tf_mm3_ds_ring_put 16 rows", .shape = .{ .rows = 16, .n = kvh, .k = 5 } } },
+        .{ "taps", 0, Item{ .name = "tf_mm3_ds_tap 64 rows", .shape = .{ .rows = 64, .n = hidden, .k = 5 } } },
+    }) |it| {
+        const w = &@field(set, it[0])[it[1]];
+        if (!try w.prepare(it[2].shape, .random, 7)) return error.RefusedShape;
+        try w.run(); // warm
+        const t0 = check.now(gpu.io);
+        for (0..runs) |_| try w.run();
+        const ms = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6 / runs;
+        std.debug.print("BENCH {s}: {d:.4} ms a launch (incl. host sync)\n", .{ it[2].name, ms });
+    }
+}
+
+/// tf-cuda-test mm3-dspark-contract: these kernels alone through gates 1 to 4.
+pub fn run(gpu: @import("check.zig").Gpu) !void {
+    const check = @import("check.zig");
+    const a = gpu.gpa;
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var k = try ds.Dspark.load(gpu.d);
+    defer k.unload();
+    var set: Set = undefined;
+    set.init(gpu, s, &k);
+    defer set.deinit();
+    var kernels: std.ArrayList(g.Kernel) = .empty;
+    defer kernels.deinit(a);
+    try set.append(a, &kernels);
+    var t: g.Tally = .{};
+    try g.runAll(a, kernels.items, 0x6d34, &t);
+    std.debug.print("SUMMARY mm3-dspark-contract {d} kernels: {d} pass gates 1-4, {d} fail, {d} known findings\n", .{ t.kernels, t.passed, t.failed, t.known });
+    try check.expect(t.failed == 0, "mm3-dspark-contract: {d} gate failures", .{t.failed});
+}
+
+test "the served shapes fit the launches" {
+    for (normSpec(.bf16_gemma).served) |s| _ = try ds.rowLaunch(s.rows);
+    for (topc_spec.served) |s| _ = try ds.topcLaunch(s.rows, s.n, s.n + pad, s.k);
+    for (attnSpec(attn_cfgs[0]).served) |s| {
+        const a: ds.Attn = .{ .nq = nq, .kvh = kvh, .ring_rows = ring_rows, .window = 1 << 20, .scale = 1 };
+        _ = try ds.attnSplit(a, @intCast(s.rows), @intCast(s.k + base_pos), base_pos);
+    }
+    for (chain_spec.served) |s| try ds.checkChain(.{ .hidden = hidden, .rank = rank, .cand = @intCast(s.n), .world = @intCast(s.k), .rows = @intCast(s.rows) });
+    try std.testing.expectEqual(@as(usize, 100_096), slot_n);
+}
diff --git a/zig/tests/cuda/contract_minimax_dspark_attn.zig b/zig/tests/cuda/contract_minimax_dspark_attn.zig
new file mode 100644
index 0000000..31513ec
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_dspark_attn.zig
@@ -0,0 +1,239 @@
+//! The dspark block attention under the contract on CUDA.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const attn = @import("contract_attn.zig");
+const common = @import("contract_minimax_dspark_common.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const rows_ = contract.rows;
+const mr = core.minimax_ref;
+const ds = cuda.minimax_m3_dspark;
+const hidden = common.hidden;
+const eps32 = common.eps32;
+const eps = common.eps;
+const rot = common.rot;
+const theta = common.theta;
+const zeroDepth = common.zeroDepth;
+const bf = common.bf;
+const isNanBf = common.isNanBf;
+const nq = common.nq;
+const kvh = common.kvh;
+
+// ---- block attention
+
+pub const ring_rows = 4112;
+pub const group = nq / kvh; // 16 q heads a kv head
+pub const base_pos = 100;
+
+pub fn keyChain(s: c.Shape) usize {
+    return s.k + 16 + 32 + 32;
+}
+
+pub const AttnCfg = struct { name: []const u8, windowed: bool };
+
+pub const attn_cfgs = [_]AttnCfg{
+    .{ .name = "cuda minimax_m3_dspark tf_mm3_ds_attn, 32 q heads over 2 kv heads, whole context", .windowed = false },
+    .{ .name = "cuda minimax_m3_dspark tf_mm3_ds_attn, 32 q heads over 2 kv heads, 300-key window", .windowed = true },
+};
+
+pub fn attnSpec(f: AttnCfg) c.Spec {
+    return .{
+        .name = f.name,
+        // the windowed rows see different keys, so gate 4's identical-key construction needs the whole-context form
+        .accum = if (f.windowed) .none else .f32,
+        .depth = keyChain,
+        .ops = 1,
+        .out = .bf16,
+        // rows, the 32 query heads, and the context keys (edges at the 128-key chunk)
+        .tiles = .{ .{}, .{}, .{ .size = 128, .min = 0 } },
+        .served = &.{ .{ .rows = 7, .n = nq, .k = 4096 }, .{ .rows = 7, .n = nq, .k = 129 }, .{ .rows = 16, .n = nq, .k = 1000 }, .{ .rows = 1, .n = nq, .k = 0 }, .{ .rows = 7, .n = nq, .k = 4111 } },
+        .sums = .{ .why = attn.why },
+    };
+}
+
+pub const Attn = struct {
+    rig: rig_.Rig,
+    f: AttnCfg,
+    k: *const ds.Dspark,
+    arena: std.heap.ArenaAllocator,
+    r: ?attn.Ref = null,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    q: []u16 = &.{},
+    ring_k: []u16 = &.{},
+    ring_v: []u16 = &.{},
+    bk: []u16 = &.{},
+    bv: []u16 = &.{},
+    p: usize = 0,
+    lo: usize = 0,
+    window: usize = 0,
+    dev: [6]u64 = @splat(0),
+
+    pub fn deinit(self: *Attn) void {
+        if (self.r) |*r| r.deinit();
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Attn) g.Kernel {
+        return .{ .spec = attnSpec(self.f), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Attn);
+
+    fn lowest(self: *const Attn, row: usize) usize {
+        const w0 = if (self.p + row + 1 > self.window) self.p + row + 1 - self.window else 0;
+        return @max(self.lo, w0);
+    }
+
+    fn kvAt(self: *Attn, which: usize, kp: usize, grp: usize) []u16 {
+        const arr = if (which == 0) self.ring_k else self.ring_v;
+        return arr[((kp % ring_rows) * kvh + grp) * 128 ..][0..128];
+    }
+
+    pub fn prepare(self: *Attn, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.n != nq or shape.rows == 0 or shape.rows > 16 or shape.k > ring_rows) return false;
+        if (self.f.windowed and fill == .stress) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        const n = shape.rows;
+        if (self.f.windowed) {
+            self.p = shape.k;
+            self.lo = 0;
+            self.window = 300;
+        } else {
+            self.p = shape.k + base_pos;
+            self.lo = base_pos;
+            self.window = 1 << 20;
+        }
+        const first = @max(self.lo, if (self.p + 1 > self.window) self.p + 1 - self.window else 0);
+        const nan = c.toBf16(std.math.nan(f32));
+        self.ring_k = try a.alloc(u16, ring_rows * kvh * 128);
+        self.ring_v = try a.alloc(u16, ring_rows * kvh * 128);
+        @memset(self.ring_k, nan);
+        @memset(self.ring_v, nan);
+        for (first..self.p) |kp| for (0..kvh) |gq| {
+            for (self.kvAt(0, kp, gq)) |*e| e.* = attn.normal(rng);
+            for (self.kvAt(1, kp, gq)) |*e| e.* = attn.normal(rng);
+        };
+        self.q = try a.alloc(u16, n * nq * 128);
+        self.bk = try a.alloc(u16, n * kvh * 128);
+        self.bv = try a.alloc(u16, n * kvh * 128);
+        for (self.q) |*e| e.* = attn.normal(rng);
+        for (self.bk) |*e| e.* = attn.normal(rng);
+        for (self.bv) |*e| e.* = attn.normal(rng);
+        if (self.r) |*r| r.deinit();
+        self.r = null;
+        self.r = try attn.Ref.init(self.rig.gpu.gpa, 128, ring_rows + 16);
+        switch (fill) {
+            .random => {},
+            .nonfinite => self.plant(first),
+            .stress => try self.stress(rng, first),
+        }
+        const bytes = [_][]const u8{ std.mem.sliceAsBytes(self.q), std.mem.sliceAsBytes(self.ring_k), std.mem.sliceAsBytes(self.ring_v), std.mem.sliceAsBytes(self.bk), std.mem.sliceAsBytes(self.bv) };
+        for (bytes, self.dev[0..5]) |b, *p| p.* = try self.rig.input(b);
+        self.dev[5] = try self.rig.output(n * nq * 128 * 2);
+        return true;
+    }
+
+    /// NaN query; +inf and -inf values; a NaN key.
+    fn plant(self: *Attn, first: usize) void {
+        const n = self.shape.rows;
+        const nan = c.toBf16(std.math.nan(f32));
+        const inf = c.toBf16(std.math.inf(f32));
+        self.q[3] = nan;
+        if (self.p > first) self.kvAt(1, self.p - 1, 0)[7] = inf;
+        self.bv[(n - 1) * kvh * 128 + 128 + 9] = c.toBf16(-std.math.inf(f32));
+        if (n > 3) self.bk[0] = nan;
+    }
+
+    /// Gate 4: every key alike (p = 1), values mirrored over the keys all rows see, which are the same for every row.
+    fn stress(self: *Attn, rng: std.Random, first: usize) !void {
+        const al = self.arena.allocator();
+        const nctx = self.p - first;
+        const nk = nctx + self.shape.rows;
+        const key0 = try al.alloc(u16, kvh * 128);
+        for (key0) |*e| e.* = attn.normal(rng);
+        for (0..kvh) |gq| {
+            for (first..self.p) |kp| @memcpy(self.kvAt(0, kp, gq), key0[gq * 128 ..][0..128]);
+            for (0..self.shape.rows) |r| @memcpy(self.bk[(r * kvh + gq) * 128 ..][0..128], key0[gq * 128 ..][0..128]);
+        }
+        const col = try al.alloc(f32, nk);
+        for (0..kvh) |gq| for (0..128) |e| {
+            small(rng, col);
+            for (col, 0..) |y, i| {
+                const cell = if (i < nctx) &self.kvAt(1, first + i, gq)[e] else &self.bv[((i - nctx) * kvh + gq) * 128 + e];
+                cell.* = c.toBf16(y);
+            }
+        };
+    }
+
+    pub fn run(self: *Attn) !void {
+        const d = self.dev;
+        const a: ds.Attn = .{ .nq = nq, .kvh = kvh, .ring_rows = ring_rows, .window = @intCast(@min(self.window, 1 << 30)), .scale = @floatCast(self.scale()) };
+        try self.k.blockAttn(self.rig.s, a, d[0], d[1], d[2], d[3], d[4], d[5], @intCast(self.shape.rows), @intCast(self.p), @intCast(self.lo));
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Attn) usize {
+        return self.shape.rows * nq * 128;
+    }
+
+    fn scale(_: *const Attn) f64 {
+        return std.math.pow(f64, 128, -0.5);
+    }
+
+    /// Output head i (row i / 32, head i % 32): its row's visible context keys, then every block key.
+    pub fn load(self: *Attn, i: usize, hd: *attn.Head) !void {
+        const row = i / nq;
+        const head = i % nq;
+        const gq = head / group;
+        for (hd.q, 0..) |*x, e| x.* = c.fromBf16(self.q[i * 128 + e]);
+        var n: usize = 0;
+        for (self.lowest(row)..self.p) |kp| {
+            for (0..128) |e| {
+                hd.k[n * 128 + e] = c.fromBf16(self.kvAt(0, kp, gq)[e]);
+                hd.v[n * 128 + e] = c.fromBf16(self.kvAt(1, kp, gq)[e]);
+            }
+            n += 1;
+        }
+        for (0..self.shape.rows) |j| {
+            for (0..128) |e| {
+                hd.k[n * 128 + e] = c.fromBf16(self.bk[(j * kvh + gq) * 128 + e]);
+                hd.v[n * 128 + e] = c.fromBf16(self.bv[(j * kvh + gq) * 128 + e]);
+            }
+            n += 1;
+        }
+        hd.n = n;
+    }
+
+    pub fn check(self: *Attn, gate: g.Gate) !?[]const u8 {
+        return self.r.?.check(self, self.count() / 128, self.scale(), try self.rig.outputBytes(), gate);
+    }
+
+    pub fn reference(self: *Attn, want: []f64, mag: []f64) !void {
+        return self.r.?.reference(self, self.count() / 128, self.scale(), want, mag);
+    }
+
+    pub fn simulate(self: *Attn, acc: c.Accum, order: g.Order, out: []f64) !void {
+        return self.r.?.simulate(self, self.count() / 128, self.scale(), acc, order, out);
+    }
+};
+
+/// Gate 4's values: odd integers, every other one times 4, the second half cancelling the first; sums stay under 2^24.
+pub fn small(rng: std.Random, out: []f32) void {
+    const h = out.len / 2;
+    for (0..h) |i| {
+        const v: f32 = @floatFromInt((1 + 2 * rng.uintLessThan(u32, 128)) * @as(u32, if (i % 2 == 1) 4 else 1));
+        out[i] = v;
+        out[h + i] = (if (i < 8) @as(f32, 1) else 0) - v;
+    }
+    if (out.len % 2 == 1) out[out.len - 1] = 0;
+}
diff --git a/zig/tests/cuda/contract_minimax_dspark_common.zig b/zig/tests/cuda/contract_minimax_dspark_common.zig
new file mode 100644
index 0000000..fd31b74
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_dspark_common.zig
@@ -0,0 +1,25 @@
+//! Shared values and helpers of the dspark contract writers.
+const std = @import("std");
+const core = @import("core");
+
+const c = core.contract.spec;
+
+pub const hidden = 6144;
+pub const eps32: f32 = 1e-6;
+pub const eps: f64 = eps32;
+pub const rot = 64;
+pub const theta = 1e7;
+pub const nq = 32; // a rank's q heads
+pub const kvh = 2;
+
+pub fn zeroDepth(_: c.Shape) usize {
+    return 0;
+}
+
+pub fn bf(rng: std.Random, sd: f32) u16 {
+    return c.toBf16(rng.floatNorm(f32) * sd);
+}
+
+pub fn isNanBf(h: u16) bool {
+    return std.math.isNan(c.fromBf16(h));
+}
diff --git a/zig/tests/cuda/contract_minimax_dspark_heads.zig b/zig/tests/cuda/contract_minimax_dspark_heads.zig
new file mode 100644
index 0000000..6f79231
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_dspark_heads.zig
@@ -0,0 +1,305 @@
+//! The dspark block-heads and K/V ring writers under the contract on CUDA.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const attn = @import("contract_attn.zig");
+const common = @import("contract_minimax_dspark_common.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const rows_ = contract.rows;
+const mr = core.minimax_ref;
+const ds = cuda.minimax_m3_dspark;
+const hidden = common.hidden;
+const eps32 = common.eps32;
+const eps = common.eps;
+const rot = common.rot;
+const theta = common.theta;
+const zeroDepth = common.zeroDepth;
+const bf = common.bf;
+const isNanBf = common.isNanBf;
+const nq = common.nq;
+const kvh = common.kvh;
+
+// ---- per-head norm + RoPE: a draft block and the K/V ring
+
+pub fn headDepth(_: c.Shape) usize {
+    return 4 + 5 + 3;
+}
+
+pub fn headMag(n: *const [128]f64, v: f64, d: usize) f64 {
+    return if (d < 32) @abs(n[d]) + @abs(n[d + 32]) else if (d < 64) @abs(n[d]) + @abs(n[d - 32]) else @abs(v);
+}
+
+/// One head's float64 norm and rotation; kind 0 normed with the q weights, 1 with the k weights.
+pub fn headRef(x16: []const u16, w16: []const u16, gemma: bool, pos: usize, y: *[128]f64, m: *[128]f64) void {
+    var x: [128]f64 = undefined;
+    var w: [128]f64 = undefined;
+    for (&x, &w, x16, w16) |*o, *ww, s, wv| {
+        o.* = c.fromBf16(s);
+        ww.* = c.fromBf16(wv);
+    }
+    var n: [128]f64 = undefined;
+    mr.gemmaNorm(&x, &w, eps, gemma, &n);
+    y.* = n;
+    mr.rope(y, rot, pos, theta, .neox_half);
+    for (m, n, 0..) |*o, v, d| o.* = headMag(&n, v, d);
+}
+
+pub fn blockSpec(gemma_on: bool) c.Spec {
+    return .{
+        .name = if (gemma_on) "cuda minimax_m3_dspark tf_mm3_ds_block_heads (1 + w), 32 q + 2 kv heads" else "cuda minimax_m3_dspark tf_mm3_ds_block_heads (w), 32 q + 2 kv heads",
+        .accum = .f32,
+        .depth = headDepth,
+        // div, sqrt, add, div, two products, the rotation's three, the weight add
+        .ops = 14,
+        .out = .bf16,
+        // rows, q heads, and the first position (the rotation angle grows with it)
+        .tiles = .{ .{}, .{}, .{ .size = 128, .min = 0 } },
+        .served = &.{ .{ .rows = 7, .n = nq, .k = 3000 }, .{ .rows = 1, .n = nq, .k = 0 }, .{ .rows = 16, .n = nq, .k = 129 }, .{ .rows = 7, .n = nq, .k = 1_000_003 } },
+        .sums = .{ .f16 = 0, .bf16 = 0, .why = "a norm's sum of squares is not a dot the fp16 and bf16 accumulators can be made to miss" },
+    };
+}
+
+pub const Block = struct {
+    rig: rig_.Rig,
+    gemma: bool,
+    k: *const ds.Dspark,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    q: []u16 = &.{},
+    kk: []u16 = &.{},
+    vv: []u16 = &.{},
+    w: [2][128]u16 = undefined,
+    dev: [8]u64 = @splat(0),
+
+    pub fn deinit(self: *Block) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Block) g.Kernel {
+        return .{ .spec = blockSpec(self.gemma), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Block);
+
+    pub fn prepare(self: *Block, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.n != nq or shape.rows == 0 or shape.rows > 16 or shape.k + shape.rows > 1_100_000) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        const n = shape.rows;
+        inline for (.{ .{ "q", n * nq * 128 }, .{ "kk", n * kvh * 128 }, .{ "vv", n * kvh * 128 } }) |p| {
+            @field(self, p[0]) = try a.alloc(u16, p[1]);
+            for (@field(self, p[0])) |*e| e.* = c.toBf16(if (fill == .stress) @as(f32, @floatFromInt(rng.intRangeAtMost(i32, -3, 3))) else (rng.float(f32) - 0.5) * 8);
+        }
+        for (&self.w) |*row| {
+            for (row) |*e| e.* = bf(rng, 0.25);
+        }
+        if (fill == .nonfinite) {
+            self.q[5] = c.toBf16(std.math.nan(f32));
+            if (n > 1) self.q[(1 * nq + 3) * 128 + 70] = c.toBf16(std.math.inf(f32));
+            if (n > 2) self.kk[(2 * kvh + 1) * 128 + 9] = c.toBf16(-std.math.inf(f32));
+            if (n > 3) self.vv[3 * kvh * 128 + 4] = c.toBf16(std.math.nan(f32));
+        }
+        self.dev[0] = try self.rig.input(std.mem.sliceAsBytes(self.q));
+        self.dev[1] = try self.rig.input(std.mem.sliceAsBytes(self.kk));
+        self.dev[2] = try self.rig.input(std.mem.sliceAsBytes(self.vv));
+        self.dev[3] = try self.rig.input(std.mem.sliceAsBytes(self.w[0][0..]));
+        self.dev[4] = try self.rig.input(std.mem.sliceAsBytes(self.w[1][0..]));
+        self.dev[5] = try self.rig.output(self.q.len * 2);
+        self.dev[6] = try self.rig.output(self.kk.len * 2);
+        self.dev[7] = try self.rig.output(self.vv.len * 2);
+        return true;
+    }
+
+    fn heads(self: *const Block) ds.Heads {
+        return .{ .nq = nq, .kvh = kvh, .rot = rot, .theta = theta, .eps = eps32, .gemma = self.gemma };
+    }
+
+    pub fn run(self: *Block) !void {
+        const d = self.dev;
+        try self.k.blockHeads(self.rig.s, self.heads(), d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7], @intCast(self.shape.rows), @intCast(self.shape.k));
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Block) usize {
+        return self.q.len + 2 * self.kk.len;
+    }
+
+    pub fn reference(self: *Block, want: []f64, mag: []f64) !void {
+        var y: [128]f64 = undefined;
+        var m: [128]f64 = undefined;
+        const nrow = self.shape.rows;
+        for (0..nrow) |r| {
+            const pos = self.shape.k + r;
+            for (0..nq) |h| {
+                headRef(self.q[(r * nq + h) * 128 ..][0..128], &self.w[0], self.gemma, pos, &y, &m);
+                @memcpy(want[(r * nq + h) * 128 ..][0..128], &y);
+                @memcpy(mag[(r * nq + h) * 128 ..][0..128], &m);
+            }
+            for (0..kvh) |h| {
+                headRef(self.kk[(r * kvh + h) * 128 ..][0..128], &self.w[1], self.gemma, pos, &y, &m);
+                @memcpy(want[self.q.len + (r * kvh + h) * 128 ..][0..128], &y);
+                @memcpy(mag[self.q.len + (r * kvh + h) * 128 ..][0..128], &m);
+                for (0..128) |d| {
+                    want[self.q.len + self.kk.len + (r * kvh + h) * 128 + d] = c.fromBf16(self.vv[(r * kvh + h) * 128 + d]);
+                    mag[self.q.len + self.kk.len + (r * kvh + h) * 128 + d] = 0;
+                }
+            }
+        }
+    }
+
+    pub fn simulate(self: *Block, acc: c.Accum, order: g.Order, out: []f64) !void {
+        for (0..self.shape.rows) |r| {
+            const pos = self.shape.k + r;
+            for (0..nq + kvh) |s| {
+                const is_q = s < nq;
+                const h = if (is_q) s else s - nq;
+                const src = if (is_q) self.q[(r * nq + h) * 128 ..][0..128] else self.kk[(r * kvh + h) * 128 ..][0..128];
+                const wv = if (is_q) &self.w[0] else &self.w[1];
+                var x: [128]f64 = undefined;
+                var sq: [128]f64 = undefined;
+                for (&x, &sq, src) |*o, *t, v| {
+                    o.* = c.fromBf16(v);
+                    t.* = o.* * o.*;
+                }
+                const ss = rows_.sumIn(acc, order, &sq);
+                const inv = 1 / @sqrt(ss / 128 + eps);
+                var y: [128]f64 = undefined;
+                for (&y, x, wv) |*o, v, w16| o.* = v * inv * (c.fromBf16(w16) + @as(f64, if (self.gemma) 1 else 0));
+                mr.rope(&y, rot, pos, theta, .neox_half);
+                const at = if (is_q) (r * nq + h) * 128 else self.q.len + (r * kvh + h) * 128;
+                @memcpy(out[at..][0..128], &y);
+            }
+            for (0..kvh) |h| for (0..128) |d| {
+                out[self.q.len + self.kk.len + (r * kvh + h) * 128 + d] = c.fromBf16(self.vv[(r * kvh + h) * 128 + d]);
+            };
+        }
+    }
+};
+
+pub const ring_rows_test = 40;
+
+pub const ring_spec: c.Spec = .{
+    .name = "cuda minimax_m3_dspark tf_mm3_ds_ring_put, 2 kv heads, 40-slot ring",
+    .accum = .none,
+    .depth = zeroDepth,
+    .out = .raw,
+    .nan = .{ .stated = "a NaN or infinity in k keeps its class through the norm and the rotation; v is stored as it came" },
+    // rows, (unused), first position
+    .served = &.{ .{ .rows = 7, .n = kvh, .k = 3000 }, .{ .rows = 16, .n = kvh, .k = 5 }, .{ .rows = 1, .n = kvh, .k = 39 }, .{ .rows = 8, .n = kvh, .k = 1_000_003 } },
+    .sums = .{ .f16 = 0, .bf16 = 0, .why = "the norm's sum of squares is checked against float64 by the K check; this kernel declares no sums" },
+};
+
+pub const Ring = struct {
+    rig: rig_.Rig,
+    k: *const ds.Dspark,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    kk: []u16 = &.{},
+    vv: []u16 = &.{},
+    w: [128]u16 = undefined,
+    dev: [5]u64 = @splat(0),
+    msg: [160]u8 = undefined,
+
+    pub fn deinit(self: *Ring) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Ring) g.Kernel {
+        return .{ .spec = ring_spec, .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Ring);
+
+    pub fn prepare(self: *Ring, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.n != kvh or shape.rows == 0 or shape.rows > 16) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        const n = shape.rows;
+        self.kk = try a.alloc(u16, n * kvh * 128);
+        self.vv = try a.alloc(u16, n * kvh * 128);
+        for (self.kk) |*e| e.* = c.toBf16((rng.float(f32) - 0.5) * 8);
+        for (self.vv) |*e| e.* = c.toBf16((rng.float(f32) - 0.5) * 8);
+        for (&self.w) |*e| e.* = bf(rng, 0.25);
+        if (fill == .nonfinite) {
+            self.kk[7] = c.toBf16(std.math.nan(f32));
+            if (n > 1) self.kk[(1 * kvh + 1) * 128 + 70] = c.toBf16(std.math.inf(f32));
+            if (n > 2) self.vv[2 * kvh * 128 + 9] = c.toBf16(-std.math.inf(f32));
+        }
+        self.dev[0] = try self.rig.input(std.mem.sliceAsBytes(self.kk));
+        self.dev[1] = try self.rig.input(std.mem.sliceAsBytes(self.vv));
+        self.dev[2] = try self.rig.input(std.mem.sliceAsBytes(self.w[0..]));
+        self.dev[3] = try self.rig.output(ring_rows_test * kvh * 128 * 2);
+        self.dev[4] = try self.rig.output(ring_rows_test * kvh * 128 * 2);
+        return true;
+    }
+
+    pub fn run(self: *Ring) !void {
+        const d = self.dev;
+        const h: ds.Heads = .{ .nq = 0, .kvh = kvh, .rot = rot, .theta = theta, .eps = eps32, .gemma = true };
+        try self.k.ringPut(self.rig.s, h, d[0], d[1], d[2], d[3], d[4], ring_rows_test, @intCast(self.shape.rows), @intCast(self.shape.k));
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(_: *Ring) usize {
+        return ring_rows_test * kvh * 128 * 2;
+    }
+
+    pub fn reference(self: *Ring, want: []f64, mag: []f64) !void {
+        _ = self;
+        @memset(want, 0);
+        @memset(mag, 0);
+    }
+
+    fn near(got: u16, want: f64) bool {
+        const v: f64 = c.fromBf16(got);
+        if (std.math.isNan(want)) return std.math.isNan(v);
+        if (std.math.isInf(want)) return v == want;
+        return @abs(v - want) <= @abs(want) * 0x1p-7 + 1e-4;
+    }
+
+    pub fn check(self: *Ring, at: g.Gate) !?[]const u8 {
+        _ = at;
+        const out = try self.rig.outputBytes();
+        const half = ring_rows_test * kvh * 128 * 2;
+        var written: [ring_rows_test]bool = @splat(false);
+        for (0..self.shape.rows) |r| {
+            const slot = (self.shape.k + r) % ring_rows_test;
+            written[slot] = true;
+            for (0..kvh) |h| {
+                var y: [128]f64 = undefined;
+                var m: [128]f64 = undefined;
+                headRef(self.kk[(r * kvh + h) * 128 ..][0..128], &self.w, true, self.shape.k + r, &y, &m);
+                for (0..128) |d| {
+                    const at_e = (slot * kvh + h) * 128 + d;
+                    const gk = std.mem.readInt(u16, out[2 * at_e ..][0..2], .little);
+                    const gv = std.mem.readInt(u16, out[half + 2 * at_e ..][0..2], .little);
+                    if (!near(gk, y[d])) return std.fmt.bufPrint(&self.msg, "row {d} head {d} dim {d}: k {e} where float64 gives {e}", .{ r, h, d, c.fromBf16(gk), y[d] }) catch "ring k differs";
+                    if (gv != self.vv[(r * kvh + h) * 128 + d] and !isNanBf(gv)) return "ring v was not stored as it came";
+                    if (isNanBf(self.vv[(r * kvh + h) * 128 + d]) != isNanBf(gv)) return "ring v NaN class differs";
+                }
+            }
+        }
+        for (0..ring_rows_test) |slot| if (!written[slot]) {
+            for (0..kvh * 128) |e| {
+                const i = slot * kvh * 128 + e;
+                if (std.mem.readInt(u16, out[2 * i ..][0..2], .little) != 0xffff or std.mem.readInt(u16, out[half + 2 * i ..][0..2], .little) != 0xffff) return "the ring write touched a slot of another position";
+            }
+        };
+        if (!try self.rig.intact()) return "the ring write changed a buffer guard";
+        return null;
+    }
+};
diff --git a/zig/tests/cuda/contract_minimax_dspark_rows.zig b/zig/tests/cuda/contract_minimax_dspark_rows.zig
new file mode 100644
