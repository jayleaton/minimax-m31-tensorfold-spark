+pub const Model = struct {
+    gpa: std.mem.Allocator,
+    cfg: dc.Config,
+    layers: []Layer,
+    fc: qmmf.Weight,
+    hidden_norm: u64,
+    final_norm: u64,
+    markov_w1: u64,
+    markov_w2: u64,
+    conf_w: u64,
+    conf_b: u64,
+    bufs: []cuda.DeviceBuffer, // every allocation, for `deinit`
+    bytes: u64, // device bytes held
+
+    pub fn deinit(m: *Model) void {
+        for (m.bufs) |*b| b.free();
+        m.gpa.free(m.bufs);
+        m.gpa.free(m.layers);
+        m.* = undefined;
+    }
+
+    /// The matrix `proj` of layer `l`.
+    pub fn lin(m: *const Model, l: usize, p: dn.Lin) qmmf.Weight {
+        const ly = &m.layers[l];
+        return switch (p) {
+            .q => ly.q,
+            .k => ly.k,
+            .v => ly.v,
+            .o => ly.o,
+            .gate => ly.gate,
+            .up => ly.up,
+            .down => ly.down,
+        };
+    }
+};
+
+/// The sink onto per-slot device buffers (weights_device.zig's, which keeps its own private).
+const Upload = struct {
+    bufs: []const cuda.DeviceBuffer,
+    stream: cuda.Stream,
+    since: u64 = 0,
