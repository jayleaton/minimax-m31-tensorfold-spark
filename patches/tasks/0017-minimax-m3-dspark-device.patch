@@ -0,0 +1,398 @@
+//! The dspark draft on one rank's device (engine_ops.Draft): K/V rings over the target's taps, block pass, chain.
+const std = @import("std");
+const cuda = @import("cuda");
+const iface = @import("iface.zig");
+const ops = @import("engine_ops.zig");
+const exec = @import("forward_exec.zig");
+const plan = @import("forward_plan.zig");
+const weights = @import("weights.zig");
+const ffn = @import("ffn.zig");
+const dc = @import("dspark_config.zig");
+const dw = @import("dspark_weights.zig");
+const shard = @import("shard.zig");
+
+const ds = cuda.minimax_m3_dspark;
+const qmmf = cuda.qmmf;
+const DeviceBuffer = cuda.DeviceBuffer;
+
+/// Candidates a rank offers per drafted row: the head's best (dspark_ref.Config.candidates).
+pub const cand = 64;
+/// Rows of the block (the anchor and the noise rows); the pass is sized for this many.
+pub const max_block = 8;
+/// Snapshots of a ring the device keeps (backend.max_snaps).
+pub const max_snaps = @import("backend.zig").max_snaps;
+
+/// One stream's ring: `lo` is the first position whose slot still holds its own row, `next` one past the last absorbed.
+pub const Meta = struct { lo: u32 = 0, next: u32 = 0 };
+
+/// What the host knows of a pass before it launches: the ring window it reads.
+pub fn passWindow(m: Meta, pos: u32, ring_rows: u32) u32 {
+    // rows absorbed up to the pending position only: a ring that lags or leads has a gap, so it is read as empty
+    if (m.next != pos) return pos;
+    return @max(m.lo, pos -| ring_rows);
+}
+
+/// The ring after absorbing positions [start, start + rows): it continues, or starts over at `start` after a gap.
+pub fn afterAbsorb(m: Meta, start: u32, rows: u32, ring_rows: u32) Meta {
+    var r = m;
+    if (r.next == r.lo or start != r.next) r = .{ .lo = start, .next = start };
+    r.next = start + rows;
+    r.lo = @max(r.lo, r.next -| ring_rows);
+    return r;
+}
+
+pub const Device = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    st: cuda.Stream,
+    cfg: dc.Config,
+    model: dw.Model,
+    lane: qmmf.Lane,
+    k: *const ds.Dspark,
+    m: *exec.Modules,
+    tw: *const weights.Weights, // the target's embedding and head
+    g: *const plan.Geometry,
+    link: ?exec.Link,
+    world: u32,
+    rank: u32,
+    // dimensions of this rank
+    nq: u32,
+    kvh: u32,
+    ffn_w: u32,
+    ring_rows: u32,
+    ring_bytes: usize,
+    // per-stream state
+    rings: []DeviceBuffer = &.{},
+    meta: []Meta = &.{},
+    snaps: [max_snaps]DeviceBuffer = undefined,
+    snap_meta: [max_snaps]Meta = @splat(.{}),
+    snap_made: bool = false,
+    results: DeviceBuffer = undefined, // [slots][max_block] of {i32 token, f32 conf}
+    result_slots: u32 = 0,
+    // scratch
+    sc: Scratch = undefined,
+
+    const Scratch = struct {
+        buf: DeviceBuffer,
+        fc_out: u64,
+        hn: u64,
+        k_raw: u64,
+        v_raw: u64,
+        ids: u64,
+        emb: u64,
+        res: u64,
+        a: u64,
+        q_raw: u64,
+        qn: u64,
+        kn: u64,
+        vn: u64,
+        attn: u64,
+        part: u64,
+        sum: u64,
+        gathered: u64,
+        gate: u64,
+        up: u64,
+        act: u64,
+        post: u64,
+        logits: u64,
+        cand_local: u64,
+        cand_all: u64,
+        mm_part: u64,
+    };
+
+    /// Bytes of one scratch field laid out in `Scratch`'s order.
+    fn layout(dv: *const Device, assign: ?*Scratch) usize {
+        const h: usize = dv.cfg.hidden;
+        const rows = iface.prefill_rows;
+        const b = max_block;
+        const kvw: usize = @as(usize, dv.kvh) * 128;
+        const qw: usize = @as(usize, dv.nq) * 128;
+        const w: usize = dv.world;
+        const sizes = [_]usize{
+            rows * h * 2, rows * h * 2, rows * kvw * 2, rows * kvw * 2, // fc_out, hn, k_raw, v_raw
+            b * 4, b * h * 2, b * h * 4, b * h * 2, // ids, emb, res, a
+            b * qw * 2, b * qw * 2, b * kvw * 2, b * kvw * 2, // q_raw, qn, kn, vn
+            b * qw * 2, b * h * 4, b * h * 4, w * b * h * 4, // attn, part, sum, gathered
+            b * dv.ffn_w * 2, b * dv.ffn_w * 2, b * dv.ffn_w * 2, b * h * 2, // gate, up, act, post
+            b * @as(usize, dv.g.slot) * 4, b * cand * 8, w * b * cand * 8, dv.mmPartBytes(), // logits, cand_local, cand_all, mm_part
+        };
+        var total: usize = 0;
+        var ptrs: [sizes.len]u64 = undefined;
+        for (sizes, &ptrs) |sz, *p| {
+            total = std.mem.alignForward(usize, total, 256);
+            p.* = total;
+            total += sz;
+        }
+        if (assign) |s| {
+            const base = s.buf.ptr;
+            inline for (@typeInfo(Scratch).@"struct".field_names[1..], 0..) |name, i| @field(s, name) = base + ptrs[i];
+        }
+        return total;
+    }
+
+    /// Split-K partials the lane matmul needs for the largest call it makes here (0 with clusters).
+    fn mmPartBytes(dv: *const Device) usize {
+        var most: usize = 16;
+        const calls = [_]usize{ max_block, 255 };
+        for (dv.model.layers) |ly| for ([_]qmmf.Weight{ ly.q, ly.k, ly.v, ly.o, ly.gate, ly.up, ly.down }) |wt| {
+            for (calls) |mm| most = @max(most, dv.lane.partBytes(mm, wt));
+        };
+        for (calls) |mm| most = @max(most, dv.lane.partBytes(mm, dv.model.fc));
+        return most;
+    }
+
+    pub fn open(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, ctx: *const cuda.Context, stream: cuda.Stream, dir: []const u8, cfg: dc.Config, share: shard.Share, m: *exec.Modules, tw: *const weights.Weights, g: *const plan.Geometry, link: ?exec.Link) !*Device {
+        const dv = try gpa.create(Device);
+        errdefer gpa.destroy(dv);
+        const cap = (try ctx.capability()) / 10;
+        const rings = dc.ringRows(&cfg, iface.window_rows);
+        dv.* = .{
+            .gpa = gpa,
+            .d = d,
+            .st = stream,
+            .cfg = cfg,
+            .model = try dw.loadModel(gpa, io, d, stream, dir, &cfg, share),
+            .lane = undefined,
+            .k = &m.dspark,
+            .m = m,
+            .tw = tw,
+            .g = g,
+            .link = link,
+            .world = g.world,
+            .rank = g.rank,
+            .nq = @intCast(share.q_heads.len()),
+            .kvh = @intCast(share.kv_heads.len()),
+            .ffn_w = @intCast(share.dense.len()),
+            .ring_rows = @intCast(rings),
+            .ring_bytes = @intCast(dc.ringBytes(&cfg, share, iface.window_rows)),
+        };
+        errdefer dv.model.deinit();
+        dv.lane = try qmmf.Lane.load(d, cap);
+        errdefer dv.lane.unload();
+        const total = dv.layout(null);
+        dv.sc.buf = try DeviceBuffer.alloc(d, total);
+        errdefer dv.sc.buf.free();
+        _ = dv.layout(&dv.sc);
+        try dv.sc.buf.fill8(0, stream.handle);
+        for (&dv.snaps) |*b| b.* = .{ .d = d, .ptr = 0, .len = 0 };
+        var made: usize = 0;
+        errdefer for (dv.snaps[0..made]) |*b| b.free();
+        for (&dv.snaps) |*b| {
+            b.* = try DeviceBuffer.alloc(d, dv.ring_bytes);
+            made += 1;
+        }
+        dv.snap_made = true;
+        try stream.synchronize();
+        return dv;
+    }
+
+    pub fn interface(dv: *Device) ops.Draft {
+        return .{ .ptr = dv, .vtable = &.{ .attach = attach, .begin = begin, .absorb = absorb, .pass = pass, .result = result, .snap_save = snapSave, .snap_restore = snapRestore, .snap_drop = snapDrop, .deinit = deinit } };
+    }
+
+    /// Device bytes the draft holds on this rank besides the snapshots: weights, scratch, and a ring per stream.
+    pub fn bytes(dv: *const Device) u64 {
+        return dv.model.bytes + dv.sc.buf.len;
+    }
+
+    fn of(p: *anyopaque) *Device {
+        return @ptrCast(@alignCast(p));
+    }
+
+    fn freeRings(dv: *Device) void {
+        for (dv.rings) |*r| r.free();
+        dv.gpa.free(dv.rings);
+        dv.gpa.free(dv.meta);
+        dv.rings = &.{};
+        dv.meta = &.{};
+        if (dv.result_slots > 0) dv.results.free();
+        dv.result_slots = 0;
+    }
+
+    fn attach(p: *anyopaque, slots: u32) anyerror!void {
+        const dv = of(p);
+        dv.freeRings();
+        dv.rings = try dv.gpa.alloc(DeviceBuffer, slots);
+        errdefer dv.gpa.free(dv.rings);
+        dv.meta = try dv.gpa.alloc(Meta, slots);
+        errdefer dv.gpa.free(dv.meta);
+        var made: usize = 0;
+        errdefer for (dv.rings[0..made]) |*r| r.free();
+        for (dv.rings) |*r| {
+            r.* = try DeviceBuffer.alloc(dv.d, dv.ring_bytes);
+            made += 1;
+        }
+        @memset(dv.meta, .{});
+        dv.results = try DeviceBuffer.alloc(dv.d, @as(usize, slots) * max_block * 8);
+        dv.result_slots = slots;
+        try dv.results.fill8(0, dv.st.handle);
+    }
+
+    fn begin(p: *anyopaque, slot: u32) void {
+        const dv = of(p);
+        if (slot < dv.meta.len) dv.meta[slot] = .{};
+    }
+
+    /// K (kind 0) or V (kind 1) ring of layer `l` in stream `slot`'s buffer.
+    pub fn ringAt(dv: *const Device, base: u64, l: usize, kind: usize) u64 {
+        const one: u64 = @as(u64, dv.ring_rows) * dv.kvh * 128 * 2;
+        return base + (@as(u64, l) * 2 + kind) * one;
+    }
+
+    fn heads(dv: *const Device) ds.Heads {
+        return .{ .nq = dv.nq, .kvh = dv.kvh, .rot = dv.cfg.rotary_dim, .theta = dv.cfg.rope_theta, .eps = dv.cfg.eps, .gemma = true };
+    }
+
+    /// Tap rows [row0, row0 + rows): fc, hidden_norm, then each layer's K and V into the slot's ring.
+    fn absorb(p: *anyopaque, slot: u32, start: u32, rows: u32, base: u64, row0: u32) anyerror!void {
+        const dv = of(p);
+        if (slot >= dv.meta.len or rows == 0 or rows > iface.prefill_rows or base == 0) return error.BadAbsorb;
+        const c = &dv.cfg;
+        const h: u32 = c.hidden;
+        const row_bytes: u64 = @as(u64, c.fcIn()) * 2;
+        const x = base + @as(u64, row0) * row_bytes;
+        const sc = &dv.sc;
+        try dv.lane.matmul(dv.st, x, c.fcIn(), rows, dv.model.fc, sc.fc_out, sc.mm_part);
+        try dv.k.norm(dv.st, sc.fc_out, false, dv.model.hidden_norm, true, sc.hn, rows, h, c.eps);
+        const ring = dv.rings[slot].ptr;
+        for (dv.model.layers, 0..) |ly, l| {
+            try dv.lane.matmul(dv.st, sc.hn, h, rows, ly.k, sc.k_raw, sc.mm_part);
+            try dv.lane.matmul(dv.st, sc.hn, h, rows, ly.v, sc.v_raw, sc.mm_part);
+            var kh = dv.heads();
+            kh.nq = 0; // (ring_put reads no query heads)
+            try dv.k.ringPut(dv.st, kh, sc.k_raw, sc.v_raw, ly.k_norm, dv.ringAt(ring, l, 0), dv.ringAt(ring, l, 1), dv.ring_rows, rows, start);
+        }
+        dv.meta[slot] = afterAbsorb(dv.meta[slot], start, rows, dv.ring_rows);
+    }
+
+    /// `src` f32 [rows][hidden] partial sums of both ranks added in rank order into `dst` (src itself on one rank).
+    fn exchange(dv: *const Device, src: u64, dst: u64, rows: u32) !u64 {
+        const link = dv.link orelse return src;
+        const n: usize = @as(usize, rows) * dv.cfg.hidden;
+        try link.group.allGather(dv.st, src, dv.sc.gathered, n * 4);
+        try dv.m.scatter.rankSum(dv.st, dv.sc.gathered, src, dv.world, dv.rank, n, dst);
+        return dst;
+    }
+
+    fn pass(p: *anyopaque, req: ops.DraftPass) anyerror!void {
+        const dv = of(p);
+        if (req.slot >= dv.meta.len) return error.BadPass;
+        try dv.block(req);
+        try dv.heads_(req);
+    }
+
+    /// The block's layers and the final norm: `sc.post` [block][hidden] bf16 (the part of a pass that needs no head).
+    pub fn block(dv: *Device, req: ops.DraftPass) !void {
+        const c = &dv.cfg;
+        const sc = &dv.sc;
+        const rows: u32 = c.block;
+        const h: u32 = c.hidden;
+        const n: usize = @as(usize, rows) * h;
+        const lo = passWindow(dv.meta[req.slot], req.pos, dv.ring_rows);
+        const ring = dv.rings[req.slot].ptr;
+        // the block's ids: the anchor, then the noise token
+        var ids: [max_block]u32 = @splat(c.mask_token);
+        ids[0] = req.anchor;
+        try dv.sc.buf.uploadAsync(sc.ids - dv.sc.buf.ptr, std.mem.sliceAsBytes(ids[0..rows]), dv.st.handle);
+        try dv.m.embed.bf16(dv.st, sc.ids, dv.tw.embed, sc.emb, rows, h);
+        try dv.k.add(dv.st, 0, sc.emb, false, sc.res, n);
+        const attn: ds.Attn = .{ .nq = dv.nq, .kvh = dv.kvh, .ring_rows = dv.ring_rows, .window = c.window, .scale = @floatCast(std.math.pow(f64, 128, -0.5)) };
+        const act_params = ffn.actParams(.{});
+        for (dv.model.layers, 0..) |ly, l| {
+            try dv.k.norm(dv.st, sc.res, true, ly.input_ln, true, sc.a, rows, h, c.eps);
+            try dv.lane.matmul(dv.st, sc.a, h, rows, ly.q, sc.q_raw, sc.mm_part);
+            try dv.lane.matmul(dv.st, sc.a, h, rows, ly.k, sc.k_raw, sc.mm_part);
+            try dv.lane.matmul(dv.st, sc.a, h, rows, ly.v, sc.v_raw, sc.mm_part);
+            try dv.k.blockHeads(dv.st, dv.heads(), sc.q_raw, sc.k_raw, sc.v_raw, ly.q_norm, ly.k_norm, sc.qn, sc.kn, sc.vn, rows, req.pos);
+            try dv.k.blockAttn(dv.st, attn, sc.qn, dv.ringAt(ring, l, 0), dv.ringAt(ring, l, 1), sc.kn, sc.vn, sc.attn, rows, req.pos, lo);
+            try dv.lane.matmulF32(dv.st, sc.attn, @as(usize, dv.nq) * 128, rows, ly.o, sc.part, sc.mm_part);
+            const o_sum = try dv.exchange(sc.part, sc.sum, rows);
+            try dv.k.add(dv.st, sc.res, o_sum, true, sc.res, n);
+            try dv.k.norm(dv.st, sc.res, true, ly.post_ln, true, sc.a, rows, h, c.eps);
+            try dv.lane.matmul(dv.st, sc.a, h, rows, ly.gate, sc.gate, sc.mm_part);
+            try dv.lane.matmul(dv.st, sc.a, h, rows, ly.up, sc.up, sc.mm_part);
+            try dv.m.act.swigluoai(dv.st, .bf16, sc.gate, dv.ffn_w, sc.up, dv.ffn_w, sc.act, dv.ffn_w, rows, dv.ffn_w, act_params);
+            try dv.lane.matmulF32(dv.st, sc.act, dv.ffn_w, rows, ly.down, sc.part, sc.mm_part);
+            const d_sum = try dv.exchange(sc.part, sc.sum, rows);
+            try dv.k.add(dv.st, sc.res, d_sum, true, sc.res, n);
+        }
+        try dv.k.norm(dv.st, sc.res, true, dv.model.final_norm, true, sc.post, rows, h, c.eps);
+    }
+
+    /// The head, the best candidates, the chain and the confidences of the block `block` left.
+    fn heads_(dv: *Device, req: ops.DraftPass) !void {
+        const c = &dv.cfg;
+        const sc = &dv.sc;
+        const rows: u32 = c.block;
+        const h: u32 = c.hidden;
+        // the target's head over this rank's vocabulary rows, the best candidates, then the chain on both ranks alike
+        try dv.m.dense.decode(dv.st, dv.tw.head, sc.post, .bf16, rows, sc.logits, .f32);
+        // (the dense kernel writes a row w.n logits after the last: the head weight's own width is the stride here)
+        try dv.k.topC(dv.st, sc.logits, dv.tw.head.n, dv.g.own_vocab, dv.g.vocab_lo, rows, cand, sc.cand_local);
+        var all = sc.cand_local;
+        if (dv.link) |link| {
+            try link.group.allGather(dv.st, sc.cand_local, sc.cand_all, @as(usize, rows) * cand * 8);
+            all = sc.cand_all;
+        }
+        const out = dv.results.ptr + @as(u64, req.slot) * max_block * 8;
+        try dv.k.chain(dv.st, .{ .hidden = h, .rank = c.markov_rank, .cand = cand, .world = dv.world, .rows = rows }, req.anchor, all, sc.post, dv.model.markov_w1, dv.model.markov_w2, dv.model.conf_w, dv.model.conf_b, out);
+    }
+
+    fn result(p: *anyopaque, slot: u32, out: *ops.DraftResult) anyerror!void {
+        const dv = of(p);
+        if (slot >= dv.result_slots) return error.BadPass;
+        try dv.st.synchronize();
+        var raw: [max_block * 8]u8 = undefined;
+        try dv.results.download(@as(usize, slot) * max_block * 8, &raw);
+        out.* = .{ .n = dv.cfg.block };
+        for (0..dv.cfg.block) |i| {
+            out.tokens[i] = std.mem.readInt(i32, raw[8 * i ..][0..4], .little);
+            out.conf[i] = @bitCast(std.mem.readInt(u32, raw[8 * i + 4 ..][0..4], .little));
+        }
+    }
+
+    fn snapSave(p: *anyopaque, slot: u32, id: u32) anyerror!void {
+        const dv = of(p);
+        if (slot >= dv.meta.len or id >= max_snaps) return error.BadSnap;
+        try dv.d.check(dv.d.api.cuMemcpyDtoDAsync_v2(dv.snaps[id].ptr, dv.rings[slot].ptr, dv.ring_bytes, dv.st.handle), "cuMemcpyDtoDAsync");
+        dv.snap_meta[id] = dv.meta[slot];
+    }
+
+    fn snapRestore(p: *anyopaque, slot: u32, id: u32) anyerror!void {
+        const dv = of(p);
+        if (slot >= dv.meta.len or id >= max_snaps) return error.BadSnap;
+        try dv.d.check(dv.d.api.cuMemcpyDtoDAsync_v2(dv.rings[slot].ptr, dv.snaps[id].ptr, dv.ring_bytes, dv.st.handle), "cuMemcpyDtoDAsync");
+        dv.meta[slot] = dv.snap_meta[id];
+    }
+
+    fn snapDrop(_: *anyopaque, _: u32) void {}
+
+    fn deinit(p: *anyopaque) void {
+        const dv = of(p);
+        dv.st.synchronize() catch {};
+        dv.freeRings();
+        if (dv.snap_made) for (&dv.snaps) |*b| b.free();
+        dv.sc.buf.free();
+        dv.lane.unload();
+        dv.model.deinit();
+        dv.gpa.destroy(dv);
+    }
+};
+
+test "an absorb continues the ring or starts it over at a gap; the window is what the ring still holds" {
+    const rr: u32 = 4112;
+    var m: Meta = .{};
+    m = afterAbsorb(m, 0, 100, rr);
+    try std.testing.expectEqual(Meta{ .lo = 0, .next = 100 }, m);
+    m = afterAbsorb(m, 100, 5, rr);
+    try std.testing.expectEqual(Meta{ .lo = 0, .next = 105 }, m);
+    m = afterAbsorb(m, 2048, 10, rr); // a gap (a resumed prompt): the ring starts over there
+    try std.testing.expectEqual(Meta{ .lo = 2048, .next = 2058 }, m);
+    m = afterAbsorb(.{ .lo = 0, .next = 4100 }, 4100, 16, rr); // the oldest rows are overwritten
+    try std.testing.expectEqual(Meta{ .lo = 4, .next = 4116 }, m);
+    // a pass reads the window up to the pending position only if the ring ends exactly there
+    try std.testing.expectEqual(@as(u32, 0), passWindow(.{ .lo = 0, .next = 105 }, 105, rr));
+    try std.testing.expectEqual(@as(u32, 2048), passWindow(.{ .lo = 2048, .next = 2058 }, 2058, rr));
+    try std.testing.expectEqual(@as(u32, 300), passWindow(.{ .lo = 0, .next = 100 }, 300, rr)); // the ring lags: read as empty
+    try std.testing.expectEqual(@as(u32, 9000 - 4112), passWindow(.{ .lo = 0, .next = 9000 }, 9000, rr));
+}
diff --git a/zig/src/families/minimax_m3/dspark_drafter.zig b/zig/src/families/minimax_m3/dspark_drafter.zig
new file mode 100644
index 0000000..1e19ebb
--- /dev/null
+++ b/zig/src/families/minimax_m3/dspark_drafter.zig
@@ -0,0 +1,173 @@
+//! The dspark draft behind core/lanes/drafter.zig: every device step goes through the leader, so rank 1 runs it too.
+const std = @import("std");
+const lanes = @import("lanes");
+const iface = @import("iface.zig");
+const ops = @import("engine_ops.zig");
+const backend = @import("backend.zig");
+const dc = @import("dspark_config.zig");
+
+const dr = lanes.drafter;
+
+/// What the round loop is told of the draft's cost: UNVERIFIED planning figures (docs/dspark-plan.md sections 7 and 8).
+pub const Pricing = struct {
+    /// One block pass: the five layers' weight reads, the head slice and the exchanges.
+    pass_ms: f64 = 6.0,
+    /// A one-token target step (the plan's estimate, two ranks).
+    step_ms: f64 = 33.0,
+    /// Device bytes each stream holds on a rank (its ring and pass scratch): dspark_config.Cost.per_lane.
+    stream_bytes: usize = 0,
+};
+
+/// Acceptance by draft depth until a stream has its own (UNVERIFIED guesses; the pack's taps are 17-23 % off).
+pub const prior = [_]f64{ 0.7, 0.55, 0.45, 0.38, 0.32, 0.27, 0.23 };
+
+/// A stream the draft has opened; its engine slot is known once the target's pass has begun.
+const State = struct {
+    tokens: [8]i32 = @splat(-1),
+    n: u32 = 0,
+    conf: [8]f32 = @splat(0),
+    fresh: bool = false, // the last hold's results are not read yet
+};
+
+pub const Stats = struct { absorbs: u64 = 0, absorbed_rows: u64 = 0, passes: u64 = 0, drafted: u64 = 0, accepted: u64 = 0 };
+
+pub const Draft = struct {
+    gpa: std.mem.Allocator,
+    cfg: dc.Config,
+    lanes: *backend.Lanes,
+    price: Pricing,
+    costs: []lanes.config.Cost,
+    streams: std.AutoHashMapUnmanaged(*lanes.Stream, State) = .empty,
+    stats: Stats = .{},
+
+    pub fn init(gpa: std.mem.Allocator, host: *backend.Lanes, cfg: dc.Config, price: Pricing) !*Draft {
+        const d = try gpa.create(Draft);
+        errdefer gpa.destroy(d);
+        d.* = .{ .gpa = gpa, .cfg = cfg, .lanes = host, .price = price, .costs = &.{} };
+        d.costs = try windowCosts(gpa, price.step_ms);
+        return d;
+    }
+
+    pub fn deinit(d: *Draft) void {
+        std.log.info("dspark draft: {d} passes, {d} absorbs of {d} rows; the streams drafted {d} tokens and the target kept {d}", .{ d.stats.passes, d.stats.absorbs, d.stats.absorbed_rows, d.stats.drafted, d.stats.accepted });
+        d.streams.deinit(d.gpa);
+        d.gpa.free(d.costs);
+        d.gpa.destroy(d);
+    }
+
+    /// The target's forward ms by window rows from the plan's byte model (dspark_config.windowCostRatio), 1 to 16 rows.
+    pub fn windowCosts(gpa: std.mem.Allocator, step_ms: f64) ![]lanes.config.Cost {
+        const out = try gpa.alloc(lanes.config.Cost, iface.window_rows);
+        for (out, 1..) |*c, rows| c.* = .{ .width = @intCast(rows), .ms = step_ms * dc.windowCostRatio(8.8, 5.7, 128, 4, @intCast(rows)) };
+        return out;
+    }
+
+    pub fn drafter(d: *Draft) dr.Drafter {
+        return .{ .ptr = d, .vtable = &.{ .taps = tapsFn, .facts = factsFn, .open = openFn, .absorb = absorbFn, .hold = holdFn, .held = heldFn, .release = releaseFn } };
+    }
+
+    fn of(p: *anyopaque) *Draft {
+        return @ptrCast(@alignCast(p));
+    }
+
+    fn tapsFn(p: *anyopaque) []const u32 {
+        const d = of(p);
+        return d.cfg.taps[0..d.cfg.n_taps];
+    }
+
+    fn factsFn(p: *anyopaque) dr.Facts {
+        const d = of(p);
+        return .{
+            .depth = d.cfg.block,
+            .step_ms = d.price.pass_ms / @as(f64, @floatFromInt(d.cfg.block)),
+            .prior = &prior,
+            .plain_guard = true,
+            .batched = false,
+            .stream_bytes = d.price.stream_bytes,
+            .window_costs = d.costs,
+            .lane_costs = d.costs,
+        };
+    }
+
+    fn openFn(p: *anyopaque, s: *lanes.Stream) anyerror!void {
+        const d = of(p);
+        if (d.streams.contains(s)) return error.StreamOpen;
+        try d.streams.put(d.gpa, s, .{});
+    }
+
+    /// The engine slot of an opened stream: the target's pass has begun by the time the draft is asked for anything.
+    fn slotOf(d: *Draft, s: *const lanes.Stream) !u32 {
+        if (!d.streams.contains(@constCast(s))) return error.UnknownStream;
+        const l = d.lanes.lanes.get(s) orelse return error.UnknownStream;
+        return l.slot;
+    }
+
+    fn absorbFn(p: *anyopaque, items: []const dr.Absorb) anyerror!void {
+        const d = of(p);
+        for (items) |it| {
+            const f = it.features;
+            if (f.space != .device or f.dtype != .bf16 or f.rows == 0) return error.UnsupportedFeatures;
+            if (it.rows != null) return error.TreesNotBuilt; // verify windows here are chains: a kept prefix
+            if (f.row_bytes != d.cfg.fcIn() * 2 or f.offset % f.row_bytes != 0) return error.UnsupportedFeatures;
+            const slot = try d.slotOf(it.stream);
+            try d.lanes.x.bind(slot);
+            try d.lanes.x.absorb(@intCast(it.start), f.rows, @intCast(f.offset / f.row_bytes));
+            d.stats.absorbs += 1;
+            d.stats.absorbed_rows += f.rows;
+        }
+    }
+
+    fn holdFn(p: *anyopaque, items: []const dr.Hold) anyerror!void {
+        const d = of(p);
+        for (items) |it| {
+            if (it.lanes != null) return error.TreesNotBuilt;
+            if (it.depth == 0 or it.depth > d.cfg.block or it.position == 0) return error.BadHold;
+            const slot = try d.slotOf(it.stream);
+            const st = d.streams.getPtr(it.stream).?;
+            try d.lanes.x.bind(slot);
+            try d.lanes.x.draftPass(it.pending, @intCast(it.position - 1));
+            st.fresh = true;
+            st.n = it.depth;
+            d.stats.passes += 1;
+        }
+    }
+
+    fn heldFn(p: *anyopaque, streams: []const *lanes.Stream, out: []const []u32) anyerror!void {
+        const d = of(p);
+        for (streams, out) |s, o| {
+            const st = d.streams.getPtr(s) orelse return error.UnknownStream;
+            if (o.len > st.n) return error.TooFewDrafts;
+            if (st.fresh) {
+                try d.lanes.x.bind(try d.slotOf(s));
+                var r: ops.DraftResult = .{};
+                try d.lanes.x.e.draftResult(&r);
+                st.tokens = r.tokens;
+                st.conf = r.conf;
+                st.fresh = false;
+            }
+            for (o, st.tokens[0..o.len]) |*t, v| t.* = if (v >= 0) @intCast(v) else (s.pending orelse 0);
+        }
+    }
+
+    fn releaseFn(p: *anyopaque, s: *lanes.Stream) void {
+        const d = of(p);
+        if (d.streams.remove(s)) { // the stream's own count of drafts offered and kept (every kind of draft, copies too)
+            d.stats.drafted += s.drafted;
+            d.stats.accepted += s.accepted;
+        }
+    }
+};
+
+test "the draft's prior has one entry a drafted level and falls" {
+    try std.testing.expectEqual(@as(usize, dc.flash.block), prior.len);
+    for (prior[1..], prior[0 .. prior.len - 1]) |a, b| try std.testing.expect(a < b);
+}
+
+test "window costs grow with the rows by the plan's byte model and start at one step" {
+    const c = try Draft.windowCosts(std.testing.allocator, 33.0);
+    defer std.testing.allocator.free(c);
+    try std.testing.expectEqual(@as(usize, iface.window_rows), c.len);
+    try std.testing.expectEqual(@as(u32, 1), c[0].width);
+    try std.testing.expectApproxEqAbs(@as(f64, 33.0), c[0].ms, 1e-9);
+    try std.testing.expect(c[7].ms > 3.3 * 33.0 and c[7].ms < 3.5 * 33.0);
+}
diff --git a/zig/src/families/minimax_m3/dspark_engine_test.zig b/zig/src/families/minimax_m3/dspark_engine_test.zig
new file mode 100644
index 0000000..6bd6fbb
--- /dev/null
+++ b/zig/src/families/minimax_m3/dspark_engine_test.zig
@@ -0,0 +1,261 @@
+//! Host tests of the dspark draft in the engine: drafted replies equal plain decode, both ranks absorb and draft alike.
+const std = @import("std");
+const lanes = @import("lanes");
+const iface = @import("iface.zig");
+const fakes = @import("engine_fake.zig");
+const dd = @import("dspark_drafter.zig");
+const dc = @import("dspark_config.zig");
+const engine = @import("engine.zig");
+
+const gpa = std.testing.allocator;
+const World = fakes.World;
+const be = lanes.backend;
+
+const Case = struct { prompt: []const u32, max_new: u32 = 60, sampling: ?lanes.Sampling = null, history_len: u32 = 0 };
+
+fn tokens(n: usize, salt: u32) ![]u32 {
+    const p = try gpa.alloc(u32, n);
+    for (p, 0..) |*t, i| t.* = @intCast((i * 7 + salt) % 90);
+    return p;
+}
+
+/// The cases through the lane core on `b`; every case's emitted tokens.
+fn drive(b: be.Backend, facts: lanes.Model, cases: []const Case) ![][]u32 {
+    var cfg = try lanes.Config.init(gpa, facts, iface.window_rows, 15);
+    defer cfg.deinit(gpa);
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, b, clock.clock());
+    defer core.deinit();
+    const streams = try gpa.alloc(lanes.Stream, cases.len);
+    defer gpa.free(streams);
+    const proposers = try gpa.alloc(lanes.SuffixLookup, cases.len);
+    defer gpa.free(proposers);
+    for (cases, streams, proposers) |c, *s, *p| {
+        p.* = try lanes.SuffixLookup.init(gpa, .{ .min_match = 5 });
+        s.* = try lanes.Stream.init(gpa, .{ .id = "s", .prompt = c.prompt, .max_new = c.max_new, .eos = &.{96}, .sampling = c.sampling, .proposer = p.proposer(), .history_len = c.history_len });
+    }
+    defer for (streams, proposers) |*s, *p| {
+        s.deinit(gpa);
+        p.deinit();
+    };
+    for (streams) |*s| try core.addStream(s);
+    while (core.activeCount() > 0) try core.step();
+    const out = try gpa.alloc([]u32, cases.len);
+    for (out, streams) |*o, *s| o.* = try gpa.dupe(u32, s.emitted());
+    return out;
+}
+
+fn free(runs: [][]u32) void {
+    for (runs) |r| gpa.free(r);
+    gpa.free(runs);
+}
+
+fn plain(facts: lanes.Model, cases: []const Case) ![][]u32 {
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    return drive(target.backend(), facts, cases);
+}
+
+fn expectSame(want: [][]u32, got: [][]u32) !void {
+    try std.testing.expectEqual(want.len, got.len);
+    for (want, got) |a, b| try std.testing.expectEqualSlices(u32, a, b);
+}
+
+/// The world's lanes backend behind the draft adapter and the core's Drafted wrapper.
+const Setup = struct {
+    draft: *dd.Draft,
+    wrapped: lanes.drafted.Drafted,
+
+    fn init(w: *World) !Setup {
+        const d = try dd.Draft.init(gpa, &w.lanes, dc.flash, .{});
+        errdefer d.deinit();
+        return .{ .draft = d, .wrapped = try lanes.drafted.Drafted.init(gpa, w.lanes.backend(), d.drafter()) };
+    }
+
+    fn deinit(s: *Setup) void {
+        s.wrapped.deinit();
+        s.draft.deinit();
+    }
+};
+
+fn runDrafted(w: *World, cases: []const Case) ![][]u32 {
+    var s = try Setup.init(w);
+    defer s.deinit();
+    const facts = s.wrapped.facts(w.lanes.facts());
+    return drive(s.wrapped.backend(), facts, cases);
+}
+
+test "drafted decode equals plain decode, greedy and sampled, and the draft is right often enough to save forwards" {
+    const w = try World.createWith(gpa, 4000, 2, 160, true);
+    defer w.destroy();
+    const p1 = try tokens(300, 1);
+    defer gpa.free(p1);
+    const p2 = try tokens(2600, 2); // two chunks
+    defer gpa.free(p2);
+    const cases = [_]Case{
+        .{ .prompt = p1, .max_new = 80 },
+        .{ .prompt = p2, .max_new = 40, .sampling = .{ .seed = 7, .temperature = 0.8, .top_k = 20, .top_p = 0.9 } },
+    };
+    for (cases) |c| {
+        const want = try plain(w.lanes.facts(), &.{c});
+        defer free(want);
+        const runs_before = w.r0.runs.items.len;
+        const got = try runDrafted(w, &.{c});
+        defer free(got);
+        try expectSame(want, got);
+        try std.testing.expect(got[0].len > 0);
+        _ = runs_before;
+    }
+    try std.testing.expect(w.r0.fd.passes > 0 and w.r0.fd.absorbs > 0);
+    try std.testing.expectEqual(@as(usize, 0), w.r0.fd.gaps); // every absorb continued its ring
+    // the greedy case: the fake draft predicts the fake target exactly, so most forwards carry several accepted tokens
+    var wide: usize = 0;
+    for (w.r0.runs.items) |r| wide += @intFromBool(r.ids.len > 2);
+    try std.testing.expect(wide > 0);
+    try std.testing.expectEqual(@as(usize, 0), w.lanes.lanes.count());
+    try std.testing.expect(w.pg.pages.idle());
+}
+
+test "a draft that is often wrong costs acceptance and nothing else" {
+    const w = try World.createWith(gpa, 3000, 2, 120, true);
+    defer w.destroy();
+    w.r0.fd.wrong_every = 3;
+    w.r1.fd.wrong_every = 3;
+    const p = try tokens(500, 4);
+    defer gpa.free(p);
+    const cases = [_]Case{.{ .prompt = p, .max_new = 90 }};
+    const want = try plain(w.lanes.facts(), &cases);
+    defer free(want);
+    const got = try runDrafted(w, &cases);
+    defer free(got);
+    try expectSame(want, got);
+    try std.testing.expect(w.r0.fd.made > 0);
+}
+
+test "several streams in shared rounds draft and verify as each does alone" {
+    const w = try World.createWith(gpa, 3000, 4, 200, true);
+    defer w.destroy();
+    const p1 = try tokens(200, 3);
+    defer gpa.free(p1);
+    const p2 = try tokens(450, 4);
+    defer gpa.free(p2);
+    const p3 = try tokens(130, 5);
+    defer gpa.free(p3);
+    const cases = [_]Case{ .{ .prompt = p1, .max_new = 50 }, .{ .prompt = p2, .max_new = 40, .sampling = .{ .seed = 3, .temperature = 1.0 } }, .{ .prompt = p3, .max_new = 30 } };
+    const want = try plain(w.lanes.facts(), &cases);
+    defer free(want);
+    const got = try runDrafted(w, &cases);
+    defer free(got);
+    try expectSame(want, got);
+    try std.testing.expectEqual(@as(usize, 0), w.r0.fd.gaps);
+}
+
+test "rank 1 absorbs and drafts what rank 0 does, step for step" {
+    const w = try World.createWith(gpa, 3000, 3, 150, true);
+    defer w.destroy();
+    const p1 = try tokens(700, 6);
+    defer gpa.free(p1);
+    const p2 = try tokens(260, 9);
+    defer gpa.free(p2);
+    const cases = [_]Case{ .{ .prompt = p1, .max_new = 40 }, .{ .prompt = p2, .max_new = 40 } };
+    const got = try runDrafted(w, &cases);
+    defer free(got);
+    try std.testing.expect(w.tape.count(.absorb) > 0 and w.tape.count(.draft) > 0);
+    try w.replay();
+    try std.testing.expectEqual(w.r0.fd.absorbs, w.r1.fd.absorbs);
+    try std.testing.expectEqual(w.r0.fd.passes, w.r1.fd.passes);
+    try std.testing.expectEqualSlices(u32, w.r0.kv, w.r1.kv);
+    for (w.r0.fd.rings.items, w.r1.fd.rings.items) |a, b| {
+        try std.testing.expectEqual(a.lo, b.lo);
+        try std.testing.expectEqualSlices(u32, a.toks.items, b.toks.items);
+    }
+}
+
+test "the draft's taps must be the engine's: any other layers are refused before a forward" {
+    const w = try World.createWith(gpa, 1000, 1, 20, true);
+    defer w.destroy();
+    const b = w.lanes.backend();
+    try b.vtable.prepare_features.?(b.ptr, dc.flash.tapIds());
+    try std.testing.expectError(error.TapsMismatch, b.vtable.prepare_features.?(b.ptr, &.{ 1, 2, 3 }));
+    const w0 = try World.create(gpa, 1000, 1, 20);
+    defer w0.destroy();
+    const b0 = w0.lanes.backend();
+    try std.testing.expectError(error.TapsMismatch, b0.vtable.prepare_features.?(b0.ptr, dc.flash.tapIds())); // an engine that does not tap
+}
+
+test "a prompt's last row survives another stream's forward until its first draft" {
+    const w = try World.createWith(gpa, 3000, 2, 120, true);
+    defer w.destroy();
+    const a_ids = try tokens(300, 2);
+    defer gpa.free(a_ids);
+    const b_ids = try tokens(520, 8);
+    defer gpa.free(b_ids);
+    var a = try lanes.Stream.init(gpa, .{ .id = "a", .prompt = a_ids, .max_new = 20 });
+    defer a.deinit(gpa);
+    var b = try lanes.Stream.init(gpa, .{ .id = "b", .prompt = b_ids, .max_new = 20 });
+    defer b.deinit(gpa);
+    const t = w.lanes.backend();
+    try t.prefill(&a);
+    try t.prefill(&b); // another stream's whole prompt runs before a's first draft
+    const f = try t.features(&a, dc.flash.tapIds(), a_ids.len - 1, 1);
+    try std.testing.expectEqual(@as(u32, 1), f.rows);
+    const row = f.offset / f.row_bytes;
+    try std.testing.expectEqual(@as(u64, iface.tapWindowRow(0)), row);
+    const tr = w.r0.taps[row];
+    try std.testing.expectEqual(@as(u32, @intCast(a_ids.len - 1)), tr.pos);
+    try std.testing.expectEqual(a_ids[a_ids.len - 1], tr.tok);
+    t.release(&a);
+    t.release(&b);
+}
+
+test "the radix cache keeps the draft's ring with a prompt mark: a resumed turn drafts from the whole context" {
+    const w = try World.createWith(gpa, 4000, 3, 120, true);
+    defer w.destroy();
+    w.pg.limit(60, 8);
+    const base = try tokens(2700, 8);
+    defer gpa.free(base);
+    const turn2 = try gpa.alloc(u32, 3000);
+    defer gpa.free(turn2);
+    @memcpy(turn2[0..2700], base);
+    for (turn2[2700..], 0..) |*t, i| t.* = @intCast((i * 11 + 5) % 90);
+    const first = [_]Case{.{ .prompt = base, .max_new = 20, .history_len = 2700 }};
+    const second = [_]Case{.{ .prompt = turn2, .max_new = 40, .history_len = 2700 }};
+    const got1 = try runDrafted(w, &first);
+    defer free(got1);
+    try std.testing.expect(w.pg.cache.live >= 1);
+    try std.testing.expectEqual(@as(usize, 1), w.r0.fd.snaps.count()); // the mark's ring was saved on both ranks
+    const got2 = try runDrafted(w, &second);
+    defer free(got2);
+    try std.testing.expectEqual(@as(u64, 1), w.lanes.resumed);
+    const fresh = try plain(w.lanes.facts(), &second);
+    defer free(fresh);
+    try expectSame(fresh, got2);
+    try std.testing.expectEqual(@as(usize, 0), w.r0.fd.partial); // every pass saw the whole context, the restored prefix included
+    try std.testing.expect(w.pg.pages.idle());
+    try w.replay();
+    try std.testing.expectEqual(w.r0.fd.snaps.count(), w.r1.fd.snaps.count());
+    for (w.r0.fd.rings.items, w.r1.fd.rings.items) |a, b| try std.testing.expectEqualSlices(u32, a.toks.items, b.toks.items);
+}
+
+test "without a ring snapshot a resumed turn drafts from its resume point and still replies the same" {
+    const w = try World.createWith(gpa, 4000, 3, 120, true);
+    defer w.destroy();
+    w.pg.limit(60, 8);
+    w.pg.cache.ring = null; // the cache keeps no rings
+    const base = try tokens(2700, 8);
+    defer gpa.free(base);
+    const turn2 = try gpa.alloc(u32, 3000);
+    defer gpa.free(turn2);
+    @memcpy(turn2[0..2700], base);
+    for (turn2[2700..], 0..) |*t, i| t.* = @intCast((i * 11 + 5) % 90);
+    const first = [_]Case{.{ .prompt = base, .max_new = 20, .history_len = 2700 }};
+    const second = [_]Case{.{ .prompt = turn2, .max_new = 40, .history_len = 2700 }};
+    const got1 = try runDrafted(w, &first);
+    defer free(got1);
+    const got2 = try runDrafted(w, &second);
+    defer free(got2);
+    const fresh = try plain(w.lanes.facts(), &second);
+    defer free(fresh);
+    try expectSame(fresh, got2);
+    try std.testing.expect(w.r0.fd.partial > 0); // the passes had only the rows since the resume
+}
diff --git a/zig/src/families/minimax_m3/dspark_folder.zig b/zig/src/families/minimax_m3/dspark_folder.zig
new file mode 100644
index 0000000..6f1c51c
--- /dev/null
+++ b/zig/src/families/minimax_m3/dspark_folder.zig
@@ -0,0 +1,75 @@
+//! Where `--drafter` points: the checkpoint's own `dspark/` folder by default, else a folder holding the draft's files.
+const std = @import("std");
+
+/// The draft's folder inside the checkpoint (revision 0fbb6795 of the pack ships it there).
+pub const default_name = "dspark";
+
+/// Values that name the default.
+pub fn isDefault(value: []const u8) bool {
+    return value.len == 0 or std.mem.eql(u8, value, "auto") or std.mem.eql(u8, value, "dspark") or std.mem.eql(u8, value, "checkpoint");
+}
+
+pub const Error = error{NoDraft} || std.mem.Allocator.Error;
+
+fn hasConfig(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) bool {
+    const path = std.fs.path.join(gpa, &.{ dir, "config.json" }) catch return false;
+    defer gpa.free(path);
+    std.Io.Dir.cwd().access(io, path, .{}) catch return false;
+    return true;
+}
+
+/// The draft's folder (gpa-owned) for --drafter's value: the default name, a folder, or one inside the checkpoint.
+pub fn resolve(gpa: std.mem.Allocator, io: std.Io, checkpoint: []const u8, value: []const u8) Error![]u8 {
+    if (isDefault(value)) {
+        const path = try std.fs.path.join(gpa, &.{ checkpoint, default_name });
+        if (hasConfig(gpa, io, path)) return path;
+        gpa.free(path);
+        return error.NoDraft;
+    }
+    if (hasConfig(gpa, io, value)) return gpa.dupe(u8, value);
+    const inside = try std.fs.path.join(gpa, &.{ checkpoint, value });
+    if (hasConfig(gpa, io, inside)) return inside;
+    gpa.free(inside);
+    return error.NoDraft;
+}
+
+/// The words of a failed resolve.
+pub fn words(buf: []u8, checkpoint: []const u8, value: []const u8) []const u8 {
+    if (isDefault(value)) return std.fmt.bufPrint(buf, "--drafter: {s}/{s} holds no draft (config.json missing): this checkpoint revision ships none, or give --drafter the folder of a dspark draft", .{ checkpoint, default_name }) catch buf[0..0];
+    return std.fmt.bufPrint(buf, "--drafter: {s} holds no draft (no config.json there or in {s}/{s}); use --drafter dspark for the checkpoint's own", .{ value, checkpoint, value }) catch buf[0..0];
+}
+
+test "the default value names the checkpoint's dspark folder; a path or a name inside the checkpoint works too; nothing else does" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const root = try tmp.dir.realPathFileAlloc(io, ".", gpa);
+    defer gpa.free(root);
+    try tmp.dir.createDirPath(io, "ck/dspark");
+    try tmp.dir.createDirPath(io, "ck/other");
+    try tmp.dir.createDirPath(io, "elsewhere");
+    try tmp.dir.writeFile(io, .{ .sub_path = "ck/dspark/config.json", .data = "{}" });
+    try tmp.dir.writeFile(io, .{ .sub_path = "ck/other/config.json", .data = "{}" });
+    try tmp.dir.writeFile(io, .{ .sub_path = "elsewhere/config.json", .data = "{}" });
+    const ck = try std.fs.path.join(gpa, &.{ root, "ck" });
+    defer gpa.free(ck);
+    const elsewhere = try std.fs.path.join(gpa, &.{ root, "elsewhere" });
+    defer gpa.free(elsewhere);
+    for ([_][]const u8{ "", "auto", "dspark", "checkpoint" }) |v| {
+        const got = try resolve(gpa, io, ck, v);
+        defer gpa.free(got);
+        try std.testing.expect(std.mem.endsWith(u8, got, "ck/dspark"));
+    }
+    const own = try resolve(gpa, io, ck, elsewhere);
+    defer gpa.free(own);
+    try std.testing.expectEqualStrings(elsewhere, own);
+    const inside = try resolve(gpa, io, ck, "other");
+    defer gpa.free(inside);
+    try std.testing.expect(std.mem.endsWith(u8, inside, "ck/other"));
+    try std.testing.expectError(error.NoDraft, resolve(gpa, io, ck, "missing"));
+    try std.testing.expectError(error.NoDraft, resolve(gpa, io, elsewhere, "dspark")); // no dspark/ in that folder
+    var w: [400]u8 = undefined;
+    try std.testing.expect(std.mem.indexOf(u8, words(&w, "/m", "dspark"), "/m/dspark holds no draft") != null);
+    try std.testing.expect(std.mem.indexOf(u8, words(&w, "/m", "x/y"), "x/y holds no draft") != null);
+}
