+    for (0..2000) |_| {
+        const v = rng.floatNorm(f32) * 30;
+        const trunc: u16 = @truncate(@as(u32, @bitCast(v)) >> 16);
+        cut += @intFromBool(trunc != c.toBf16(v));
+        try testing.expect(@abs(c.fromBf16(c.toBf16(v)) - v) <= @abs(v) * 0x1p-8);
+    }
+    try testing.expect(cut > 500);
+}
