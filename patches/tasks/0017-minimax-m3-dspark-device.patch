+//! The dspark tap, add and norm kernels under the contract on CUDA.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const attn = @import("contract_attn.zig");
+const common = @import("contract_minimax_dspark_common.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const rows_ = contract.rows;
+const mr = core.minimax_ref;
+const ds = cuda.minimax_m3_dspark;
+const hidden = common.hidden;
+const eps32 = common.eps32;
+const eps = common.eps;
+const rot = common.rot;
+const theta = common.theta;
+const zeroDepth = common.zeroDepth;
+const bf = common.bf;
+const isNanBf = common.isNanBf;
+const nq = common.nq;
+const kvh = common.kvh;
+
+// ---- tap
+
+pub const tap_spec: c.Spec = .{
+    .name = "cuda minimax_m3_dspark tf_mm3_ds_tap",
+    .accum = .none,
+    .depth = zeroDepth,
+    .out = .raw,
+    .nan = .{ .stated = "a non-finite fp32 value keeps its class in bf16; the destination's other columns are untouched" },
+    // rows, hidden, tap slots; the destination row holds all slots
+    .served = &.{ .{ .rows = 7, .n = 6144, .k = 5 }, .{ .rows = 1, .n = 6144, .k = 5 }, .{ .rows = 64, .n = 6144, .k = 5 }, .{ .rows = 5, .n = 1000, .k = 2 } },
+    .sums = .{ .f16 = 0, .bf16 = 0, .why = "a tap rounds and copies; it sums nothing" },
+};
+
+pub const Tap = struct {
+    rig: rig_.Rig,
+    k: *const ds.Dspark,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    src: []f32 = &.{},
+    dev: [2]u64 = .{ 0, 0 },
+    msg: [160]u8 = undefined,
+
+    pub fn deinit(self: *Tap) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Tap) g.Kernel {
+        return .{ .spec = tap_spec, .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Tap);
+
+    fn slot(self: *const Tap) u32 {
+        return @intCast(self.shape.rows % self.shape.k);
+    }
+
+    pub fn prepare(self: *Tap, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.n == 0 or shape.k == 0) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        self.src = try a.alloc(f32, shape.rows * shape.n);
+        for (self.src) |*v| v.* = rng.floatNorm(f32) * 100;
+        if (fill == .nonfinite) {
+            self.src[0] = std.math.nan(f32);
+            if (shape.rows > 1) self.src[shape.n + 1] = std.math.inf(f32);
+            if (shape.rows > 2) self.src[2 * shape.n + shape.n - 1] = -std.math.inf(f32);
+        }
+        self.dev[0] = try self.rig.input(std.mem.sliceAsBytes(self.src));
+        self.dev[1] = try self.rig.output(shape.rows * shape.k * shape.n * 2);
+        return true;
+    }
+
+    pub fn run(self: *Tap) !void {
+        const s = self.shape;
+        try self.k.tap(self.rig.s, self.dev[0], self.dev[1], s.k * s.n, self.slot(), @intCast(s.n), @intCast(s.rows));
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Tap) usize {
+        return self.shape.rows * self.shape.k * self.shape.n;
+    }
+
+    pub fn reference(self: *Tap, want: []f64, mag: []f64) !void {
+        _ = self;
+        @memset(want, 0);
+        @memset(mag, 0);
+    }
+
+    /// Bits, not tolerances: the slot's columns are the fp32 values rounded to bf16, every other column is still the
+    pub fn check(self: *Tap, at: g.Gate) !?[]const u8 {
+        _ = at;
+        const s = self.shape;
+        const out = try self.rig.outputBytes();
+        const ld = s.k * s.n;
+        const lo = self.slot() * s.n;
+        for (0..s.rows) |r| for (0..ld) |col| {
+            const got = std.mem.readInt(u16, out[2 * (r * ld + col) ..][0..2], .little);
+            if (col >= lo and col < lo + s.n) {
+                const v = self.src[r * s.n + col - lo];
+                if (std.math.isNan(v)) {
+                    if (!isNanBf(got)) return "a NaN tap did not stay NaN";
+                } else if (got != c.toBf16(v)) return std.fmt.bufPrint(&self.msg, "row {d} column {d}: {x} where bf16 of the value is {x}", .{ r, col - lo, got, c.toBf16(v) }) catch "tap bits differ";
+            } else if (got != 0xffff) return "a tap wrote outside its slot's columns";
+        };
+        if (!try self.rig.intact()) return "the tap changed a buffer guard";
+        return null;
+    }
+};
+
+// ---- add
+
+pub const AddForm = enum { bf16, f32, bf16_zero };
+
+pub fn addSpec(f: AddForm) c.Spec {
+    return .{
+        .name = switch (f) {
+            .bf16 => "cuda minimax_m3_dspark tf_mm3_ds_add_bf16",
+            .f32 => "cuda minimax_m3_dspark tf_mm3_ds_add_f32",
+            .bf16_zero => "cuda minimax_m3_dspark tf_mm3_ds_add_bf16 (no first operand)",
+        },
+        .accum = .none,
+        .depth = zeroDepth,
+        .out = .f32,
+        .tiles = .{ .{}, .{ .size = 256, .step = 1, .min = 1 }, .{} },
+        .served = &.{ .{ .rows = 1, .n = 7 * hidden, .k = 1 }, .{ .rows = 1, .n = 1 << 20, .k = 1 }, .{ .rows = 1, .n = 1, .k = 1 }, .{ .rows = 1, .n = 1_000_003, .k = 1 } },
+        .sums = .{ .f16 = 0, .bf16 = 0, .why = "one fp32 add of two values, no sum of many" },
+    };
+}
+
+pub const Add = struct {
+    rig: rig_.Rig,
+    form: AddForm,
+    k: *const ds.Dspark,
+    arena: std.heap.ArenaAllocator,
+    n: usize = 0,
+    a: []f32 = &.{},
+    b: []f32 = &.{},
+    dev: [3]u64 = @splat(0),
+
+    pub fn deinit(self: *Add) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Add) g.Kernel {
+        return .{ .spec = addSpec(self.form), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Add);
+
+    pub fn prepare(self: *Add, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.n == 0) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const al = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.n = shape.n;
+        self.a = try al.alloc(f32, shape.n);
+        self.b = try al.alloc(f32, shape.n);
+        const bits = try al.alloc(u16, shape.n);
+        for (self.a, self.b, bits) |*x, *y, *h| {
+            x.* = if (self.form == .bf16_zero) 0 else rng.floatNorm(f32) * 50;
+            if (self.form == .f32) {
+                y.* = rng.floatNorm(f32) * 3;
+            } else {
+                h.* = bf(rng, 3);
+                y.* = c.fromBf16(h.*);
+            }
+        }
+        if (fill == .nonfinite) {
+            if (self.form == .bf16_zero) self.b[0] = std.math.nan(f32) else self.a[0] = std.math.nan(f32);
+            self.b[1 % shape.n] = std.math.inf(f32);
+            if (shape.n > 3 and self.form != .bf16_zero) {
+                self.a[2] = -std.math.inf(f32);
+                self.b[2] = std.math.inf(f32);
+            }
+            if (self.form != .f32) for (self.b, bits) |y, *h| {
+                h.* = c.toBf16(y);
+            };
+        }
+        self.dev[0] = if (self.form == .bf16_zero) 0 else try self.rig.input(std.mem.sliceAsBytes(self.a));
+        self.dev[1] = if (self.form == .f32) try self.rig.input(std.mem.sliceAsBytes(self.b)) else try self.rig.input(std.mem.sliceAsBytes(bits));
+        self.dev[2] = try self.rig.output(shape.n * 4);
+        return true;
+    }
+
+    pub fn run(self: *Add) !void {
+        try self.k.add(self.rig.s, self.dev[0], self.dev[1], self.form == .f32, self.dev[2], self.n);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Add) usize {
+        return self.n;
+    }
+
+    pub fn reference(self: *Add, want: []f64, mag: []f64) !void {
+        for (want, mag, self.a, self.b) |*w, *m, x, y| {
+            w.* = @as(f64, x) + y;
+            m.* = 0;
+        }
+    }
+};
+
+// ---- norm
+
+pub const NormForm = enum { bf16_gemma, f32_gemma, f32_plain };
+
+pub fn normDepth(s: c.Shape) usize {
+    return s.k / 256 + 1 + 5 + 7;
+}
+
+pub fn normSpec(f: NormForm) c.Spec {
+    return .{
+        .name = switch (f) {
+            .bf16_gemma => "cuda minimax_m3_dspark tf_mm3_ds_norm_bf16 (1 + w)",
+            .f32_gemma => "cuda minimax_m3_dspark tf_mm3_ds_norm_f32 (1 + w)",
+            .f32_plain => "cuda minimax_m3_dspark tf_mm3_ds_norm_f32 (w)",
+        },
+        .accum = .f32,
+        .depth = normDepth,
+        // div, sqrt, add, div, two products, the weight add
+        .ops = 7,
+        .out = .bf16,
+        .replaces = if (f == .f32_gemma) "tf_mm3_ds_norm_bf16" else null,
+        // rows are CTAs; the row is strided over 256 threads
+        .tiles = .{ .{}, .{}, .{ .size = 256, .step = 1, .min = 1 } },
+        .served = &.{ .{ .rows = 7, .n = hidden, .k = hidden }, .{ .rows = 1, .n = hidden, .k = hidden }, .{ .rows = 17, .n = hidden, .k = hidden }, .{ .rows = 2048, .n = 1024, .k = 1024 } },
+        .sums = .{ .f16 = 0, .bf16 = 0, .why = "a norm's sum of squares is not a dot the fp16 and bf16 accumulators can be made to miss" },
+    };
+}
+
+pub const Norm = struct {
+    rig: rig_.Rig,
+    form: NormForm,
+    k: *const ds.Dspark,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    x: []u16 = &.{},
+    w: []u16 = &.{},
+    dev: [3]u64 = @splat(0),
+    base: u64 = 0,
+
+    pub fn deinit(self: *Norm) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Norm) g.Kernel {
+        return .{ .spec = normSpec(self.form), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Norm);
+
+    fn gemma(self: *const Norm) bool {
+        return self.form != .f32_plain;
+    }
+
+    pub fn prepare(self: *Norm, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.k == 0) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        const k = shape.k;
+        self.x = try a.alloc(u16, shape.rows * k);
+        self.w = try a.alloc(u16, k);
+        for (self.w) |*v| v.* = bf(rng, 0.25);
+        for (self.x, 0..) |*v, i| v.* = c.toBf16((rng.float(f32) * 2 - 1) * (if (i % 64 == 7) @as(f32, 20) else 1));
+        if (fill == .stress) {
+            // gate 4: integer terms, squares exact in fp32 whatever the order
+            for (0..shape.rows) |r| for (0..k) |i| {
+                self.x[r * k + i] = c.toBf16(@floatFromInt(rng.intRangeAtMost(i32, -32, 32)));
+            };
+        } else if (fill == .nonfinite) {
+            const at = [_][2]usize{ .{ 0, k / 3 }, .{ 1, k / 2 }, .{ 2, k - 1 }, .{ 3, 0 }, .{ 3, k - 1 } };
+            const put = [_]f32{ std.math.nan(f32), std.math.inf(f32), -std.math.inf(f32), std.math.inf(f32), -std.math.inf(f32) };
+            for (at, put) |p, v| if (p[0] < shape.rows) {
+                self.x[p[0] * k + p[1]] = c.toBf16(v);
+            };
+        }
+        if (self.form == .bf16_gemma) {
+            self.dev[0] = try self.rig.input(std.mem.sliceAsBytes(self.x));
+        } else {
+            const xf = try a.alloc(f32, self.x.len);
+            for (xf, self.x) |*o, h| o.* = c.fromBf16(h);
+            self.dev[0] = try self.rig.input(std.mem.sliceAsBytes(xf));
+        }
+        self.dev[1] = try self.rig.input(std.mem.sliceAsBytes(self.w));
+        self.dev[2] = try self.rig.output(shape.rows * k * 2);
+        if (self.form == .f32_gemma) self.base = try self.rig.scratch(shape.rows * k * 2);
+        return true;
+    }
+
+    pub fn run(self: *Norm) !void {
+        const s = self.shape;
+        try self.k.norm(self.rig.s, self.dev[0], self.form != .bf16_gemma, self.dev[1], self.gemma(), self.dev[2], @intCast(s.rows), @intCast(s.k), eps32);
+        try self.rig.s.synchronize();
+    }
+
+    /// The bf16-input form on the same values.
+    pub fn replaced(self: *Norm) ![]const u8 {
+        const s = self.shape;
+        const xb = std.mem.sliceAsBytes(self.x);
+        const dev = try self.rig.scratch(xb.len);
+        const b: cuda.DeviceBuffer = .{ .d = self.rig.gpu.d, .ptr = dev, .len = xb.len };
+        try b.upload(0, xb);
+        try self.k.norm(self.rig.s, dev, false, self.dev[1], true, self.base, @intCast(s.rows), @intCast(s.k), eps32);
+        return self.rig.bytes(self.base, s.rows * s.k * 2);
+    }
+
+    pub fn count(self: *Norm) usize {
+        return self.shape.rows * self.shape.k;
+    }
+
+    fn row(self: *const Norm, r: usize, x: []f64, w: []f64) void {
+        const k = self.shape.k;
+        for (x, w, 0..) |*xv, *wv, i| {
+            xv.* = c.fromBf16(self.x[r * k + i]);
+            wv.* = c.fromBf16(self.w[i]);
+        }
+    }
+
+    pub fn reference(self: *Norm, want: []f64, mag: []f64) !void {
+        const k = self.shape.k;
+        const a = self.rig.gpu.gpa;
+        const buf = try a.alloc(f64, 2 * k);
+        defer a.free(buf);
+        for (0..self.shape.rows) |r| {
+            self.row(r, buf[0..k], buf[k..]);
+            mr.gemmaNorm(buf[0..k], buf[k..], eps, self.gemma(), want[r * k ..][0..k]);
+            for (mag[r * k ..][0..k], want[r * k ..][0..k]) |*m, y| m.* = @abs(y) / 2;
+        }
+    }
+
+    pub fn simulate(self: *Norm, acc: c.Accum, order: g.Order, out: []f64) !void {
+        const k = self.shape.k;
+        const a = self.rig.gpu.gpa;
+        const buf = try a.alloc(f64, 3 * k);
+        defer a.free(buf);
+        for (0..self.shape.rows) |r| {
+            self.row(r, buf[0..k], buf[k .. 2 * k]);
+            for (buf[2 * k ..][0..k], buf[0..k]) |*t, v| t.* = v * v;
+            const ss = rows_.sumIn(acc, order, buf[2 * k ..][0..k]);
+            const inv = 1 / @sqrt(ss / @as(f64, @floatFromInt(k)) + eps);
+            const add: f64 = if (self.gemma()) 1 else 0;
+            for (0..k) |i| out[r * k + i] = buf[i] * inv * (buf[k + i] + add);
+        }
+    }
+};
diff --git a/zig/tests/cuda/contract_minimax_dspark_search.zig b/zig/tests/cuda/contract_minimax_dspark_search.zig
new file mode 100644
index 0000000..84a45cc
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_dspark_search.zig
@@ -0,0 +1,364 @@
+//! The dspark top-C and Markov chain kernels under the contract on CUDA.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const attn = @import("contract_attn.zig");
+const common = @import("contract_minimax_dspark_common.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const rows_ = contract.rows;
+const mr = core.minimax_ref;
+const ds = cuda.minimax_m3_dspark;
+const hidden = common.hidden;
+const eps32 = common.eps32;
+const eps = common.eps;
+const rot = common.rot;
+const theta = common.theta;
+const zeroDepth = common.zeroDepth;
+const bf = common.bf;
+const isNanBf = common.isNanBf;
+const nq = common.nq;
+const kvh = common.kvh;
+
+// ---- top-C
+
+pub const slot_n = 782 * 128; // the largest rank slice of the 200,064-token vocabulary
+pub const pad = 64;
+pub const id0: u32 = slot_n;
+
+pub fn orderKey(v: f32) u32 {
+    if (std.math.isNan(v)) return 0;
+    var u: u32 = @bitCast(v);
+    if (u == 0x8000_0000) u = 0;
+    return if (u & 0x8000_0000 != 0) ~u else u | 0x8000_0000;
+}
+
+pub const topc_spec: c.Spec = .{
+    .name = "cuda minimax_m3_dspark tf_mm3_ds_topc",
+    .accum = .none,
+    .depth = zeroDepth,
+    .out = .raw,
+    .nan = .{ .stated = "a NaN ranks below every number; -0 equals +0; larger wins, ties go to the lower id; fewer than c valid pads {-inf, -1}" },
+    // rows, valid logits, candidates a row
+    .tiles = .{ .{}, .{ .size = 256, .step = 1, .min = 1 }, .{} },
+    .served = &.{ .{ .rows = 7, .n = slot_n, .k = 64 }, .{ .rows = 1, .n = 5000, .k = 64 }, .{ .rows = 16, .n = 3000, .k = 128 }, .{ .rows = 7, .n = 40, .k = 64 }, .{ .rows = 8, .n = slot_n - 128, .k = 1 } },
+    .sums = .{ .f16 = 0, .bf16 = 0, .why = "a selection compares and sums nothing" },
+};
+
+pub const TopC = struct {
+    rig: rig_.Rig,
+    k: *const ds.Dspark,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    logits: []f32 = &.{},
+    dev: [2]u64 = .{ 0, 0 },
+    msg: [200]u8 = undefined,
+
+    pub fn deinit(self: *TopC) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *TopC) g.Kernel {
+        return .{ .spec = topc_spec, .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(TopC);
+
+    fn ld(self: *const TopC) usize {
+        return self.shape.n + pad;
+    }
+
+    pub fn prepare(self: *TopC, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.rows > 16 or shape.n == 0 or shape.n > slot_n or shape.k == 0 or shape.k > 128) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        self.logits = try a.alloc(f32, shape.rows * self.ld());
+        const nan = std.math.nan(f32);
+        const inf = std.math.inf(f32);
+        for (0..shape.rows) |r| {
+            const row = self.logits[r * self.ld() ..][0..self.ld()];
+            @memset(row[shape.n..], inf); // decoys after the slice
+            for (row[0..shape.n], 0..) |*v, i| v.* = switch (r % 8) {
+                0 => rng.floatNorm(f32) * 3,
+                1 => @floatFromInt(rng.intRangeAtMost(i32, -3, 3)),
+                2 => 1.5,
+                3 => if (i % 5 == 0) nan else rng.floatNorm(f32),
+                4 => nan,
+                5 => if (i % 7 == 0) inf else if (i % 2 == 0) -0.0 else 0.0,
+                6 => -inf,
+                else => if (i + 1 == shape.n) 100 else if (i % 3 == 0) -0.0 else @as(f32, @floatFromInt(rng.intRangeAtMost(i32, -2, 2))),
+            };
+            if (fill == .nonfinite and r == 0) row[shape.n / 2] = inf;
+        }
+        self.dev[0] = try self.rig.input(std.mem.sliceAsBytes(self.logits));
+        self.dev[1] = try self.rig.output(shape.rows * shape.k * 8);
+        return true;
+    }
+
+    pub fn run(self: *TopC) !void {
+        const s = self.shape;
+        try self.k.topC(self.rig.s, self.dev[0], self.ld(), @intCast(s.n), id0, @intCast(s.rows), @intCast(s.k), self.dev[1]);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *TopC) usize {
+        return self.shape.rows * self.shape.k * 2;
+    }
+
+    pub fn reference(self: *TopC, want: []f64, mag: []f64) !void {
+        _ = self;
+        @memset(want, 0);
+        @memset(mag, 0);
+    }
+
+    const Less = struct {
+        row: []const f32,
+        fn before(ctx: @This(), a: u32, b: u32) bool {
+            const ka = orderKey(ctx.row[a]);
+            const kb = orderKey(ctx.row[b]);
+            return ka > kb or (ka == kb and a < b);
+        }
+    };
+
+    /// The oracle: every index sorted by (key desc, index asc), the first c.
+    pub fn check(self: *TopC, at: g.Gate) !?[]const u8 {
+        _ = at;
+        const s = self.shape;
+        const al = self.arena.allocator();
+        const out = try self.rig.outputBytes();
+        const idx = try al.alloc(u32, s.n);
+        defer al.free(idx);
+        for (0..s.rows) |r| {
+            const row = self.logits[r * self.ld() ..][0..s.n];
+            for (idx, 0..) |*x, i| x.* = @intCast(i);
+            std.mem.sort(u32, idx, Less{ .row = row }, Less.before);
+            for (0..s.k) |j| {
+                const o = (r * s.k + j) * 8;
+                const got_bits = std.mem.readInt(u32, out[o..][0..4], .little);
+                const got_id = std.mem.readInt(u32, out[o + 4 ..][0..4], .little);
+                if (j < s.n) {
+                    const want = row[idx[j]];
+                    if (got_id != id0 + idx[j]) return std.fmt.bufPrint(&self.msg, "row {d} rank {d}: id {d} where the sorted order gives {d}", .{ r, j, got_id, id0 + idx[j] }) catch "topc id differs";
+                    if (got_bits != @as(u32, @bitCast(want)) and !(std.math.isNan(want) and std.math.isNan(@as(f32, @bitCast(got_bits))))) return "a candidate's logit bits differ from its source";
+                } else if (got_bits != @as(u32, @bitCast(-std.math.inf(f32))) or got_id != 0xffff_ffff) return "padding is not {-inf, -1}";
+            }
+        }
+        if (!try self.rig.intact()) return "the top-C changed a buffer guard";
+        if (!std.mem.eql(u8, std.mem.sliceAsBytes(self.logits), try self.rig.inputBytes())) return "the top-C changed the logits";
+        return null;
+    }
+};
+
+// ---- Markov chain + confidence
+
+pub const vocab_t = 3000;
+pub const rank = 256;
+pub const cand = 64;
+
+pub const chain_spec: c.Spec = .{
+    .name = "cuda minimax_m3_dspark tf_mm3_ds_chain",
+    .accum = .none,
+    .depth = zeroDepth,
+    .out = .raw,
+    .nan = .{ .stated = "a NaN score loses to every number, an equal score goes to the lower id, no valid candidate gives token -1; a NaN input gives NaN confidence" },
+    // rows, candidates a rank, ranks
+    .served = &.{ .{ .rows = 7, .n = cand, .k = 2 }, .{ .rows = 7, .n = cand, .k = 1 }, .{ .rows = 16, .n = 8, .k = 2 }, .{ .rows = 1, .n = 3, .k = 2 } },
+    .sums = .{ .f16 = 0, .bf16 = 0, .why = "scores and confidence are checked against float64 with the fp32 chain's bound; no sums are declared" },
+};
+
+pub const Chain = struct {
+    rig: rig_.Rig,
+    k: *const ds.Dspark,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    cands: []u32 = &.{}, // [world][rows][cand] x {logit bits, id}
+    post: []u16 = &.{},
+    w1: []u16 = &.{},
+    w2: []u16 = &.{},
+    cw: []u16 = &.{},
+    cb: [1]u16 = .{0},
+    anchor: u32 = 17,
+    dev: [6]u64 = @splat(0),
+    out: u64 = 0,
+    msg: [240]u8 = undefined,
+
+    pub fn deinit(self: *Chain) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Chain) g.Kernel {
+        return .{ .spec = chain_spec, .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Chain);
+
+    fn ent(self: *const Chain, w: usize, r: usize, i: usize) *[2]u32 {
+        const s = self.shape;
+        return @ptrCast(self.cands[(((w * s.rows + r) * s.n) + i) * 2 ..][0..2]);
+    }
+
+    pub fn prepare(self: *Chain, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        const world = shape.k;
+        if (shape.rows == 0 or shape.rows > 16 or shape.n == 0 or world == 0 or world > 2 or world * shape.n > 256 or shape.n * world > vocab_t / 2) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        const rows = shape.rows;
+        self.cands = try a.alloc(u32, world * rows * shape.n * 2);
+        self.post = try a.alloc(u16, rows * hidden);
+        self.w1 = try a.alloc(u16, vocab_t * rank);
+        self.w2 = try a.alloc(u16, vocab_t * rank);
+        self.cw = try a.alloc(u16, hidden + rank);
+        for (self.w1) |*e| e.* = bf(rng, 0.25);
+        for (self.w2) |*e| e.* = bf(rng, 0.25);
+        for (self.post) |*e| e.* = bf(rng, 1);
+        for (self.cw) |*e| e.* = bf(rng, 0.02);
+        self.cb[0] = bf(rng, 0.5);
+        const perm = try a.alloc(u32, vocab_t);
+        for (0..world) |w| for (0..rows) |r| {
+            for (perm, 0..) |*p, i| p.* = @intCast(i);
+            rng.shuffle(u32, perm);
+            var m: usize = 0;
+            for (perm) |id| { // rank w's ids are its own half of the vocabulary
+                if (id / (vocab_t / 2) != w and world == 2) continue;
+                if (m == shape.n) break;
+                const e = self.ent(w, r, m);
+                e[0] = @bitCast(rng.floatNorm(f32) * 3);
+                e[1] = id;
+                m += 1;
+            }
+            // padding at the end of a rank's list; one row with no candidate at all
+            const invalid: usize = if (r % 3 == 2) @min(5, shape.n - 1) else 0;
+            for (shape.n - invalid..shape.n) |i| {
+                const e = self.ent(w, r, i);
+                e[0] = @bitCast(-std.math.inf(f32));
+                e[1] = 0xffff_ffff;
+            }
+            if (r == 4) for (0..shape.n) |i| {
+                const e = self.ent(w, r, i);
+                e[0] = @bitCast(-std.math.inf(f32));
+                e[1] = 0xffff_ffff;
+            };
+        };
+        // row 2: two candidates of rank 0 with equal scores that beat the rest: the lower id must win
+        if (rows > 2 and shape.n >= 8) {
+            const ea = self.ent(0, 2, 0);
+            const eb = self.ent(0, 2, 1);
+            @memcpy(self.w2[eb[1] * rank ..][0..rank], self.w2[ea[1] * rank ..][0..rank]);
+            ea[0] = @bitCast(@as(f32, 50));
+            eb[0] = @bitCast(@as(f32, 50));
+        }
+        if (fill == .nonfinite) {
+            self.ent(0, 0, 3)[0] = @bitCast(std.math.nan(f32));
+            if (rows > 1) self.ent(0, 1, 2)[0] = @bitCast(std.math.inf(f32));
+            if (rows > 3) self.post[3 * hidden + 11] = c.toBf16(std.math.nan(f32));
+        }
+        const bytes = [_][]const u8{ std.mem.sliceAsBytes(self.cands), std.mem.sliceAsBytes(self.post), std.mem.sliceAsBytes(self.w1), std.mem.sliceAsBytes(self.w2), std.mem.sliceAsBytes(self.cw), std.mem.sliceAsBytes(self.cb[0..]) };
+        for (bytes, &self.dev) |b, *p| p.* = try self.rig.input(b);
+        self.out = try self.rig.output(rows * 8);
+        return true;
+    }
+
+    pub fn run(self: *Chain) !void {
+        const s = self.shape;
+        const d = self.dev;
+        try self.k.chain(self.rig.s, .{ .hidden = hidden, .rank = rank, .cand = @intCast(s.n), .world = @intCast(s.k), .rows = @intCast(s.rows) }, self.anchor, d[0], d[1], d[2], d[3], d[4], d[5], self.out);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Chain) usize {
+        return self.shape.rows * 2;
+    }
+
+    pub fn reference(self: *Chain, want: []f64, mag: []f64) !void {
+        _ = self;
+        @memset(want, 0);
+        @memset(mag, 0);
+    }
+
+    fn bias(self: *const Chain, prev: usize, id: usize) f64 {
+        var s: f64 = 0;
+        for (self.w1[prev * rank ..][0..rank], self.w2[id * rank ..][0..rank]) |x, y| s += @as(f64, c.fromBf16(x)) * c.fromBf16(y);
+        return s;
+    }
+
+    /// Follows the kernel's own previous tokens: each token must score within the fp32 chain's error of the best, ties
+    pub fn check(self: *Chain, at: g.Gate) !?[]const u8 {
+        _ = at;
+        const s = self.shape;
+        const out = try self.rig.outputBytes();
+        var prev: usize = self.anchor;
+        for (0..s.rows) |r| {
+            const tok = std.mem.readInt(i32, out[8 * r ..][0..4], .little);
+            const conf: f32 = @bitCast(std.mem.readInt(u32, out[8 * r + 4 ..][0..4], .little));
+            // float64 scores of the valid candidates
+            var best_id: i64 = -1;
+            var best_z: f64 = std.math.nan(f64);
+            var low_id: i64 = -1;
+            var found: ?f64 = null;
+            for (0..s.k) |w| for (0..s.n) |i| {
+                const e = self.ent(w, r, i);
+                if (e[1] == 0xffff_ffff) continue;
+                const z = @as(f64, @as(f32, @bitCast(e[0]))) + self.bias(prev, e[1]);
+                const id: i64 = e[1];
+                if (low_id < 0 or id < low_id) low_id = id;
+                if (tok == id) found = z;
+                const better = if (std.math.isNan(z)) false else if (std.math.isNan(best_z)) true else z > best_z or (z == best_z and id < best_id);
+                if (better) {
+                    best_z = z;
+                    best_id = id;
+                }
+            };
+            if (low_id < 0) {
+                if (tok != -1) return "no valid candidate but the token is not -1";
+            } else if (std.math.isNan(best_z)) {
+                if (tok != low_id) return "every score is NaN: the lowest id must win";
+            } else {
+                const z = found orelse return std.fmt.bufPrint(&self.msg, "row {d}: token {d} is not a candidate", .{ r, tok }) catch "token is not a candidate";
+                const tol = 2e-4 * (1 + @abs(best_z));
+                if (!(z == best_z or z >= best_z - tol)) return std.fmt.bufPrint(&self.msg, "row {d}: token {d} scores {e} where the best scores {e}", .{ r, tok, z, best_z }) catch "token is not the best";
+                // an exact tie must go to the lower id
+                var ties: usize = 0;
+                for (0..s.k) |w| for (0..s.n) |i| {
+                    const e = self.ent(w, r, i);
+                    if (e[1] == 0xffff_ffff) continue;
+                    const zz = @as(f64, @as(f32, @bitCast(e[0]))) + self.bias(prev, e[1]);
+                    if (zz == best_z) ties += 1;
+                };
+                if (ties > 1 and tok != best_id) return "an exact tie did not go to the lower id";
+            }
+            // the confidence of this token's chain position uses the kernel's previous token
+            var sum: f64 = c.fromBf16(self.cb[0]);
+            var mg: f64 = 0;
+            for (0..hidden) |j| {
+                const t = @as(f64, c.fromBf16(self.post[r * hidden + j])) * c.fromBf16(self.cw[j]);
+                sum += t;
+                mg += @abs(t);
+            }
+            for (0..rank) |j| {
+                const t = @as(f64, c.fromBf16(self.w1[prev * rank + j])) * c.fromBf16(self.cw[hidden + j]);
+                sum += t;
+                mg += @abs(t);
+            }
+            const want = mr.sigmoid(sum);
+            if (std.math.isNan(want)) {
+                if (!std.math.isNan(conf)) return "a NaN input must give NaN confidence";
+            } else if (!(@abs(conf - want) <= 0.25 * 1e-5 * mg + 2e-6)) return std.fmt.bufPrint(&self.msg, "row {d}: confidence {e} where float64 gives {e}", .{ r, conf, want }) catch "confidence differs";
+            prev = if (tok < 0) self.anchor else @intCast(tok);
+        }
+        if (!try self.rig.intact()) return "the chain changed a buffer guard";
+        return null;
+    }
+};
