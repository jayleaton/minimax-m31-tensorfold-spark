diff --git a/zig/src/families/minimax_m3/backend.zig b/zig/src/families/minimax_m3/backend.zig
new file mode 100644
index 0000000..16527ef
--- /dev/null
+++ b/zig/src/families/minimax_m3/backend.zig
@@ -0,0 +1,318 @@
+//! MiniMax-M3.1-Flash's lane backend: slots over pooled pages, radix-cache resume, copy drafts, no vision.
+const std = @import("std");
+const lanes = @import("lanes");
+const iface = @import("iface.zig");
+const engine = @import("engine.zig");
+const follow = @import("follow.zig");
+const pages_mod = @import("pages.zig");
+const state = @import("state.zig");
+const pool = @import("pool.zig");
+
+const be = lanes.backend;
+
+/// First tokens a handle names.
+const ring = 1024;
+pub const window_rows = iface.window_rows;
+pub const max_rows = iface.window_rows;
+
+/// A stream's place in the backend: its slot, the pages and position of its lease, its prompt pass.
+pub const Lane = struct {
+    slot: u32,
+    st: state.Stream,
+    marks: []const u32 = &.{}, // where the pass keeps the prompt cache's prefix (rows, pages), from admit
+    adopted: ?iface.Resume = null, // rows already in adopted pages: only the pass's first chunk says so
+    pending_rows: ?usize = null, // the rows of the last verify, not yet committed
+    first: ?u64 = null,
+    fill: ?usize = null, // a prompt pass going a chunk at a time: where its next chunk starts
+    owner: *Lanes,
+    stream: *lanes.Stream,
+};
+
+/// Grammar words of a round's windows on the device, where rank 0's draw reads them; the host supplies the buffer.
+pub const Masks = struct {
+    ptr: *anyopaque,
+    put: *const fn (ptr: *anyopaque, row: usize, rows: usize, words: []const u32) anyerror!u64,
+};
+
+pub const Lanes = struct {
+    gpa: std.mem.Allocator,
+    x: follow.Leader,
+    pages: ?*pages_mod.Pages = null, // made by `attach`, after open
+    masks: ?Masks = null,
+    lanes: std.AutoHashMapUnmanaged(*const lanes.Stream, *Lane) = .empty,
+    drawn: [ring]u32 = undefined,
+    next: u64 = 0,
+    shared: u64 = 0, // forwards that held several streams' windows
+    resumed: u64 = 0, // prompt passes that started past row 0, from the prompt cache
+
+    pub fn deinit(self: *Lanes) void {
+        var it = self.lanes.valueIterator();
+        while (it.next()) |l| self.free(l.*);
+        self.lanes.deinit(self.gpa);
+    }
+
+    pub fn backend(self: *Lanes) be.Backend {
+        return .{ .ptr = self, .vtable = &vt };
+    }
+
+    const vt: be.Backend.VTable = .{
+        .prefill = prefillFn,
+        .prefill_step = prefillStepFn,
+        .first = firstFn,
+        .queue = queueFn,
+        .read = readFn,
+        .verify = verifyFn,
+        .keep = keepFn,
+        .draft = draftFn,
+        .release = releaseFn,
+        .reports_fill = true,
+    };
+
+    /// Round loop facts: copies up to the window and shared exact windows (Qwen3.5's facts for a model without a head).
+    pub fn facts(_: *const Lanes) lanes.Model {
+        return iface.laneFacts(window_rows, iface.shared_rows);
+    }
+
+    fn of(ptr: *anyopaque) *Lanes {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    fn take(self: *Lanes, token: u32) u64 {
+        const h = self.next;
+        self.drawn[h % ring] = token;
+        self.next += 1;
+        return h;
+    }
+
+    fn free(self: *Lanes, l: *Lane) void {
+        if (l.marks.len > 0) self.gpa.free(l.marks);
+        if (self.pages) |pg| pg.cache.end(&l.st, &pg.tables);
+        self.gpa.destroy(l);
+    }
+
+    /// The lowest slot no stream holds, within the block table's rows.
+    fn freeSlot(self: *const Lanes, slots: u32) ?u32 {
+        var slot: u32 = 0;
+        while (slot < slots) : (slot += 1) {
+            var it = self.lanes.valueIterator();
+            const taken = while (it.next()) |l| {
+                if (l.*.slot == slot) break true;
+            } else false;
+            if (!taken) return slot;
+        }
+        return null;
+    }
+
+    fn cancelled(ptr: ?*anyopaque) bool {
+        return @as(*lanes.Stream, @ptrCast(@alignCast(ptr.?))).isCancelled();
+    }
+
+    fn cancelOf(s: *lanes.Stream) ?iface.Cancel {
+        return if (s.cancel_check == null) null else .{ .ptr = s, .check = cancelled };
+    }
+
+    /// The pass's marks for the leader: the prompt cache keeps the prefix at each (`keptAt`).
+    fn marksOf(l: *Lane) ?iface.Marks {
+        return if (l.marks.len == 0) null else .{ .at = l.marks, .ctx = l, .call = keptAt };
+    }
+
+    /// The pass stands at `at` (a page multiple): the store keeps the prefix, the stream swaps pages, all ranks hear.
+    fn keptAt(ctx: *anyopaque, at: u32) void {
+        const l: *Lane = @ptrCast(@alignCast(ctx));
+        const self = l.owner;
+        const pg = self.pages orelse return;
+        var sink = pg.tables.sink(l.slot);
+        pg.cache.keep(&l.st, l.stream.prompt(), at, sink.table()) catch |err| return std.log.warn("prompt prefix not kept at {d}: {s}", .{ at, @errorName(err) });
+        const n = at / pool.page_tokens;
+        self.x.sendPages(0, l.st.lease.ids.items[0..n]) catch |err| std.log.warn("the other ranks' pages at {d}: {s}", .{ at, @errorName(err) });
+    }
+
+    // -- the vtable ---------------------------------------------------------------------------------------------
+
+    /// A request's admission and its lane: refusals come before any page or step is taken.
+    fn begin(self: *Lanes, s: *lanes.Stream) !*Lane {
+        if (s.images.len > 0) return error.VisionUnsupported;
+        const pg = self.pages orelse return error.NoPool;
+        const e = self.x.e;
+        const ids = s.prompt();
+        if (ids.len == 0 or ids.len + s.max_new + window_rows >= e.capacity) return error.PromptTooLong;
+        if (self.lanes.get(s)) |old| { // a second pass of the same stream starts over
+            self.release(s, old);
+        }
+        const slot = self.freeSlot(@intCast(pg.tables.slots)) orelse return error.LaneMemory;
+        const l = try self.gpa.create(Lane);
+        errdefer self.gpa.destroy(l);
+        l.* = .{ .slot = slot, .st = .{ .slot = slot }, .owner = self, .stream = s };
+        var sink = pg.tables.sink(slot);
+        l.marks = try pg.cache.admit(self.gpa, &l.st, ids, s.history_len, s.max_new, pg.window, sink.table(), pg.max_pages);
+        errdefer {
+            self.gpa.free(l.marks);
+            pg.cache.end(&l.st, &pg.tables);
+        }
+        // the resumed prefix is the lease's first pages and admit writes only the pages it took: write the whole row
+        try pg.tables.write(slot, l.st.lease.ids.items, 0);
+        try self.x.bind(slot);
+        try self.x.begin(s.sampling, l.st.lease.ids.items);
+        s.cached = l.st.pos;
+        l.fill = l.st.pos;
+        if (l.st.pos > 0) {
+            l.adopted = .{ .at = l.st.pos };
+            self.resumed += 1;
+        }
+        try self.lanes.put(self.gpa, s, l);
+        return l;
+    }
+
+    fn prefillFn(ptr: *anyopaque, s: *lanes.Stream) anyerror!void {
+        while (!try prefillStepFn(ptr, s)) {}
+    }
+
+    /// One chunk of the stream's prompt pass; true once the first token is drawn. A chunk ends at a mark or its rows.
+    fn prefillStepFn(ptr: *anyopaque, s: *lanes.Stream) anyerror!bool {
+        const self = of(ptr);
+        if (s.isCancelled()) return error.Cancelled;
+        const l = if (self.lanes.get(s)) |l| (if (l.fill != null) l else try self.begin(s)) else try self.begin(s);
+        try self.x.bind(l.slot);
+        const ids = s.prompt();
+        const at = l.fill.?;
+        const marks = marksOf(l);
+        const first = self.x.chunk(ids, at, l.adopted, cancelOf(s), marks) catch |err| {
+            l.fill = null; // the pass is over; the host releases the stream
+            return err;
+        };
+        l.adopted = null;
+        if (first) |t| {
+            l.first = self.take(t);
+            l.fill = null;
+            s.fill_at.store(@intCast(ids.len), .monotonic);
+            return true;
+        }
+        const to = engine.chunkEnd(at, ids.len, marks);
+        l.fill = to;
+        s.fill_at.store(@intCast(to), .monotonic);
+        return false;
+    }
+
+    fn firstFn(ptr: *anyopaque, s: *lanes.Stream, position: u64) anyerror!u64 {
+        const self = of(ptr);
+        if (position != s.prompt_len) return error.PositionMismatch;
+        const l = self.lanes.get(s) orelse return error.UnknownStream;
+        return l.first orelse error.NoFirstToken;
+    }
+
+    fn queueFn(_: *anyopaque, _: *lanes.Stream, _: be.Feed, _: u64) anyerror!u64 {
+        return error.NotPipelined;
+    }
+
+    fn readFn(ptr: *anyopaque, handle: u64) anyerror!u32 {
+        const self = of(ptr);
+        if (handle >= self.next or self.next - handle > ring) return error.NoSuchToken;
+        return self.drawn[handle % ring];
+    }
+
+    /// The stream's sequence bound, its last verify committed (`kept` rows, else all of them).
+    fn bind(self: *Lanes, s: *const lanes.Stream, kept: ?usize) !*Lane {
+        const l = self.lanes.get(s) orelse return error.UnknownStream;
+        try self.x.bind(l.slot);
+        if (l.pending_rows) |rows| try self.x.keep(kept orelse rows);
+        l.pending_rows = null;
+        return l;
+    }
+
+    /// Grammar words of rows [row, row + rows) of the round on the device; 0 for no grammar.
+    fn putBits(self: *Lanes, row: usize, rows: usize, words: []const u32) !u64 {
+        if (words.len == 0) return 0;
+        const m = self.masks orelse return error.StructuresUnsupported;
+        return m.put(m.ptr, row, rows, words);
+    }
+
+    /// A window's checks against the lane's position, and its ids: the pending token, then the host's drafts.
+    fn window(self: *Lanes, w: be.Window, ids: []u32) !struct { l: *Lane, rows: usize } {
+        if (w.parents != null) return error.TreesNotBuilt;
+        if (w.held > 0) return error.NoHeldDrafts; // no head holds drafts
+        const l = try self.bind(w.stream, null);
+        const rows = w.rows();
+        if (rows > max_rows) return error.WindowTooWide;
+        const pos = self.x.e.pos();
+        for (w.positions, 0..) |p, r| if (p != pos + 1 + r) return error.PositionMismatch;
+        ids[0] = w.pending;
+        @memcpy(ids[1..][0..w.tokens.len], w.tokens);
+        return .{ .l = l, .rows = rows };
+    }
+
+    /// Each window in its own forward on its stream's pages (the core sends one when no forward is shared).
+    fn verifyFn(ptr: *anyopaque, windows: []const be.Window, out: []be.Verified) anyerror!void {
+        const self = of(ptr);
+        if (windows.len > 1) return self.verifyShared(windows, out);
+        for (windows, out) |w, *o| {
+            var ids: [max_rows]u32 = undefined;
+            const got = try self.window(w, &ids);
+            var sampled: [max_rows]u32 = undefined;
+            const bits = try self.putBits(0, got.rows, w.masks); // before the step goes out: a refusal after it strands the ranks
+            try self.x.verify(ids[0..got.rows], sampled[0..got.rows], bits);
+            @memcpy(o.sampled[0..got.rows], sampled[0..got.rows]);
+            @memcpy(o.drafts[0..w.tokens.len], w.tokens);
+            got.l.pending_rows = got.rows;
+        }
+    }
+
+    /// A round's windows in one forward (Engine.verifyShared), each stream's rows on its own pages.
+    fn verifyShared(self: *Lanes, windows: []const be.Window, out: []be.Verified) !void {
+        if (windows.len > iface.max_shared) return error.WindowTooWide;
+        var parts: [iface.max_shared]iface.Part = undefined;
+        var ids: [iface.max_shared][max_rows]u32 = undefined;
+        var sampled: [iface.max_shared][max_rows]u32 = undefined;
+        var lane: [iface.max_shared]*Lane = undefined;
+        var row: usize = 0; // the windows' rows so far: each one's grammar rows start there
+        for (windows, 0..) |w, k| {
+            const got = try self.window(w, &ids[k]);
+            if (row + got.rows > iface.shared_rows) return error.WindowTooWide;
+            const bits = try self.putBits(row, got.rows, w.masks);
+            parts[k] = .{ .slot = got.l.slot, .ids = ids[k][0..got.rows], .out = sampled[k][0..got.rows], .bits = bits };
+            lane[k] = got.l;
+            row += got.rows;
+        }
+        try self.x.verifyShared(parts[0..windows.len]);
+        self.shared += 1;
+        for (out[0..windows.len], parts[0..windows.len], lane[0..windows.len], windows) |*o, p, l, w| {
+            @memcpy(o.sampled[0..p.ids.len], p.out);
+            @memcpy(o.drafts[0..w.tokens.len], w.tokens);
+            l.pending_rows = p.ids.len;
+        }
+    }
+
+    fn keepFn(ptr: *anyopaque, windows: []const be.Window, paths: []const []const u32) anyerror!void {
+        const self = of(ptr);
+        for (windows, paths) |w, path| {
+            if (path.len == 0) return error.EmptyPath;
+            for (path, 0..) |r, i| if (r != i) return error.TreesNotBuilt;
+            _ = try self.bind(w.stream, path.len);
+        }
+    }
+
+    /// The pack has no draft head: the core drafts by copies alone and never asks.
+    fn draftFn(_: *anyopaque, _: []const be.DraftRequest) anyerror!void {
+        return error.NoDraftHead;
+    }
+
+    /// The stream left the rounds: its slot is freed on every rank and its pages go back (the store keeps its prefix).
+    fn releaseFn(ptr: *anyopaque, s: *lanes.Stream) void {
+        const self = of(ptr);
+        const l = self.lanes.get(s) orelse return;
+        self.release(s, l);
+        if (self.lanes.count() == 0) self.x.idle() catch |err| if (err != error.RankLost) std.log.err("the other ranks' idle step: {s}", .{@errorName(err)});
+    }
+
+    fn release(self: *Lanes, s: *const lanes.Stream, l: *Lane) void {
+        _ = self.lanes.remove(s);
+        self.x.release(l.slot) catch |err| if (err != error.RankLost) std.log.err("releasing slot {d}: {s}", .{ l.slot, @errorName(err) });
+        self.free(l);
+    }
+};
+
+test "the vtable is a head-less backend: no drafts held, windows exact, stepped prompts" {
+    try std.testing.expect(Lanes.vt.prefill_step != null and Lanes.vt.first_masked == null and Lanes.vt.held == null);
+    try std.testing.expect(Lanes.vt.reports_fill);
+    const f = iface.laneFacts(window_rows, iface.shared_rows);
+    try std.testing.expect(!f.mtp and f.hidden_rows and f.streams_exact);
+}
diff --git a/zig/src/families/minimax_m3/backend_test.zig b/zig/src/families/minimax_m3/backend_test.zig
new file mode 100644
index 0000000..9f22b2a
--- /dev/null
+++ b/zig/src/families/minimax_m3/backend_test.zig
@@ -0,0 +1,229 @@
+//! Host tests of the lane backend against core/lanes/fake.zig: same tokens, shared rounds, the radix cache, admission.
+const std = @import("std");
+const lanes = @import("lanes");
+const iface = @import("iface.zig");
+const fakes = @import("engine_fake.zig");
+const backend = @import("backend.zig");
+const pool = @import("pool.zig");
+
+const gpa = std.testing.allocator;
+const World = fakes.World;
+const be = lanes.backend;
+
+const Case = struct { prompt: []const u32, max_new: u32 = 40, sampling: ?lanes.Sampling = null, history_len: u32 = 0 };
+
+fn tokens(n: usize, salt: u32) ![]u32 {
+    const p = try gpa.alloc(u32, n);
+    for (p, 0..) |*t, i| t.* = @intCast((i * 7 + salt) % 90);
+    return p;
+}
+
+/// Every case's emitted tokens when the cases run together through the lane core on `backend`.
+fn drive(b: be.Backend, facts: lanes.Model, cases: []const Case) ![][]u32 {
+    var cfg = try lanes.Config.init(gpa, facts, iface.window_rows, 15);
+    defer cfg.deinit(gpa);
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, b, clock.clock());
+    defer core.deinit();
+    const streams = try gpa.alloc(lanes.Stream, cases.len);
+    defer gpa.free(streams);
+    const proposers = try gpa.alloc(lanes.SuffixLookup, cases.len);
+    defer gpa.free(proposers);
+    for (cases, streams, proposers) |c, *s, *p| {
+        p.* = try lanes.SuffixLookup.init(gpa, .{ .min_match = 5 });
+        s.* = try lanes.Stream.init(gpa, .{ .id = "s", .prompt = c.prompt, .max_new = c.max_new, .eos = &.{96}, .sampling = c.sampling, .proposer = p.proposer(), .history_len = c.history_len });
+    }
+    defer for (streams, proposers) |*s, *p| {
+        s.deinit(gpa);
+        p.deinit();
+    };
+    for (streams) |*s| try core.addStream(s);
+    while (core.activeCount() > 0) try core.step();
+    const out = try gpa.alloc([]u32, cases.len);
+    for (out, streams) |*o, *s| o.* = try gpa.dupe(u32, s.emitted());
+    return out;
+}
+
+fn free(runs: [][]u32) void {
+    for (runs) |r| gpa.free(r);
+    gpa.free(runs);
+}
+
+/// The fake target on the same facts: what the reference backend emits for the cases.
+fn reference(facts: lanes.Model, cases: []const Case) ![][]u32 {
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    return drive(target.backend(), facts, cases);
+}
+
+fn expectSame(want: [][]u32, got: [][]u32) !void {
+    try std.testing.expectEqual(want.len, got.len);
+    for (want, got) |a, b| try std.testing.expectEqualSlices(u32, a, b);
+}
+
+test "streams through the lane core emit what the fake backend emits, greedy and sampled, rank 1 mirroring" {
+    const w = try World.create(gpa, 4000, 4, 160);
+    defer w.destroy();
+    const p1 = try tokens(300, 1);
+    defer gpa.free(p1);
+    const p2 = try tokens(2600, 2); // two chunks
+    defer gpa.free(p2);
+    const cases = [_]Case{
+        .{ .prompt = p1, .max_new = 60 },
+        .{ .prompt = p2, .max_new = 30, .sampling = .{ .seed = 7, .temperature = 0.8, .top_k = 20, .top_p = 0.9 } },
+    };
+    for (cases) |c| {
+        const want = try reference(w.lanes.facts(), &.{c});
+        defer free(want);
+        const got = try drive(w.lanes.backend(), w.lanes.facts(), &.{c});
+        defer free(got);
+        try expectSame(want, got);
+        try std.testing.expect(got[0].len > 0);
+    }
+    try std.testing.expectEqual(@as(usize, 0), w.lanes.lanes.count()); // released: slots free, pages back
+    try std.testing.expect(w.pg.pages.idle());
+    try w.replay();
+    try std.testing.expectEqualSlices(u32, w.r0.kv, w.r1.kv);
+    try std.testing.expectEqualSlices(i32, w.r0.table, w.r1.table);
+    try std.testing.expectEqual(w.r0.runs.items.len, w.r1.runs.items.len);
+}
+
+test "several streams in one round share a forward and still emit what each emits alone" {
+    const w = try World.create(gpa, 3000, 4, 200);
+    defer w.destroy();
+    const p1 = try tokens(200, 3);
+    defer gpa.free(p1);
+    const p2 = try tokens(450, 4);
+    defer gpa.free(p2);
+    const p3 = try tokens(130, 5);
+    defer gpa.free(p3);
+    const cases = [_]Case{ .{ .prompt = p1, .max_new = 50 }, .{ .prompt = p2, .max_new = 40, .sampling = .{ .seed = 3, .temperature = 1.0 } }, .{ .prompt = p3, .max_new = 30 } };
+    const want = try reference(w.lanes.facts(), &cases);
+    defer free(want);
+    const got = try drive(w.lanes.backend(), w.lanes.facts(), &cases);
+    defer free(got);
+    try expectSame(want, got);
+    try std.testing.expect(w.lanes.shared > 0);
+    var shared_runs: usize = 0;
+    for (w.r0.runs.items) |r| shared_runs += @intFromBool(r.kind == .shared);
+    try std.testing.expect(shared_runs > 0);
+    try w.replay();
+    try std.testing.expectEqualSlices(u32, w.r0.kv, w.r1.kv);
+}
+
+test "the radix cache: a later turn resumes from the kept pages, emits what a fresh pass emits, rank 1 swaps the same pages" {
+    const w = try World.create(gpa, 4000, 3, 120);
+    defer w.destroy();
+    w.pg.limit(60, 8);
+    const base = try tokens(2700, 8);
+    defer gpa.free(base);
+    const turn2 = try gpa.alloc(u32, 3000);
+    defer gpa.free(turn2);
+    @memcpy(turn2[0..2700], base);
+    for (turn2[2700..], 0..) |*t, i| t.* = @intCast((i * 11 + 5) % 90);
+    const first = [_]Case{.{ .prompt = base, .max_new = 20, .history_len = 2700 }};
+    const second = [_]Case{.{ .prompt = turn2, .max_new = 20, .history_len = 2700 }};
+    const got1 = try drive(w.lanes.backend(), w.lanes.facts(), &first);
+    defer free(got1);
+    const runs_before = w.r0.runs.items.len;
+    try std.testing.expect(w.pg.cache.live >= 1); // the pass kept a snapshot at its mark
+    var swapped: usize = 0;
+    for (w.tape.steps.items) |s| swapped += @intFromBool(s.h.kind == @backingInt(iface.Kind.keep) and s.h.flags & 1 != 0);
+    try std.testing.expectEqual(@as(usize, 1), swapped); // rank 1 heard the page swap
+    const got2 = try drive(w.lanes.backend(), w.lanes.facts(), &second);
+    defer free(got2);
+    try std.testing.expectEqual(@as(u64, 1), w.lanes.resumed);
+    try std.testing.expectEqual(@as(u32, 1), w.pg.cache.store.tree.counts.hits);
+    try std.testing.expectEqual(@as(u32, 2688), w.r0.runs.items[runs_before].starts[0]); // resumed at the kept mark's rows
+    const fresh = try reference(w.lanes.facts(), &second);
+    defer free(fresh);
+    try expectSame(fresh, got2);
+    try std.testing.expect(w.pg.pages.idle());
+    try w.replay();
+    try std.testing.expectEqualSlices(u32, w.r0.kv, w.r1.kv); // the follower's pages hold the same rows under the same ids
+    try std.testing.expectEqualSlices(i32, w.r0.table, w.r1.table);
+}
+
+test "admission: vision, a context past the budget, a pool too small and a table without a free row are refused untouched" {
+    const w = try World.create(gpa, 6000, 1, 20);
+    defer w.destroy();
+    const b = w.lanes.backend();
+    const sent = w.tape.steps.items.len;
+    const long = try tokens(5900, 1);
+    defer gpa.free(long);
+    const short = try tokens(500, 2);
+    defer gpa.free(short);
+    var vision = try lanes.Stream.init(gpa, .{ .id = "v", .prompt = short, .max_new = 10, .images = &.{.{ .pixels = &.{}, .gh = 1, .gw = 1, .at = 0, .tokens = 1 }} });
+    defer vision.deinit(gpa);
+    try std.testing.expectError(error.VisionUnsupported, b.prefill(&vision));
+    var big = try lanes.Stream.init(gpa, .{ .id = "b", .prompt = long, .max_new = 200 });
+    defer big.deinit(gpa);
+    try std.testing.expectError(error.PromptTooLong, b.prefill(&big));
+    const mid = try tokens(3000, 3); // 24 pages against a pool of 20
+    defer gpa.free(mid);
+    var pool_big = try lanes.Stream.init(gpa, .{ .id = "p", .prompt = mid, .max_new = 100 });
+    defer pool_big.deinit(gpa);
+    try std.testing.expectError(error.ContextTooLong, b.prefill(&pool_big));
+    try std.testing.expectEqual(sent, w.tape.steps.items.len); // no rank heard of any of them
+    try std.testing.expect(w.pg.pages.idle());
+    var a = try lanes.Stream.init(gpa, .{ .id = "a", .prompt = short, .max_new = 10 });
+    defer a.deinit(gpa);
+    try b.prefill(&a);
+    var again = try lanes.Stream.init(gpa, .{ .id = "c", .prompt = short, .max_new = 10 });
+    defer again.deinit(gpa);
+    try std.testing.expectError(error.LaneMemory, b.prefill(&again)); // one table row, taken
+    try std.testing.expectEqual(@as(usize, 1), w.lanes.lanes.count());
+    b.release(&a);
+    try std.testing.expect(w.pg.pages.idle());
+}
+
+test "a cancelled prompt pass frees its pages and its slot on both ranks" {
+    const w = try World.create(gpa, 6000, 2, 120);
+    defer w.destroy();
+    const ids = try tokens(5000, 7);
+    defer gpa.free(ids);
+    const Flag = struct {
+        n: usize = 0,
+        fn check(p: *anyopaque) bool {
+            const f: *@This() = @ptrCast(@alignCast(p));
+            f.n += 1;
+            return f.n > 3; // true from the third chunk's gate on
+        }
+    };
+    var flag: Flag = .{};
+    var s = try lanes.Stream.init(gpa, .{ .id = "x", .prompt = ids, .max_new = 10, .cancel_check = .{ .ptr = &flag, .check = Flag.check } });
+    defer s.deinit(gpa);
+    const b = w.lanes.backend();
+    try std.testing.expectError(error.Cancelled, b.prefill(&s));
+    b.release(&s);
+    try std.testing.expectEqual(@as(usize, 0), w.lanes.lanes.count());
+    try std.testing.expect(w.pg.pages.idle());
+    try w.replay();
+    try std.testing.expectEqual(@as(usize, 0), w.hooks1.failures);
+    for (w.r1.table) |e| try std.testing.expectEqual(@as(i32, -1), e); // the follower's row went back to -1
+}
+
+test "lane facts: exact windows over several streams, copy drafts only, no head" {
+    const w = try World.create(gpa, 1000, 1, 10);
+    defer w.destroy();
+    const f = w.lanes.facts();
+    try std.testing.expectEqual(iface.window_rows, f.exact_width);
+    try std.testing.expectEqual(iface.shared_rows, f.batch_rows);
+    try std.testing.expectEqual(iface.max_shared, f.max_streams);
+    try std.testing.expect(f.hidden_rows and f.streams_exact and f.context_copies and !f.mtp and !f.speculate);
+    var cfg = try lanes.Config.init(gpa, f, iface.window_rows, 15);
+    defer cfg.deinit(gpa);
+    try std.testing.expect(cfg.family_streams and !cfg.family_mtp);
+    try std.testing.expectEqual(iface.window_rows - 1, cfg.max_copy);
+}
+
+test "the rest of the contract: no pipelining, no head, no trees, handles expire" {
+    const w = try World.create(gpa, 1000, 1, 10);
+    defer w.destroy();
+    const b = w.lanes.backend();
+    var s: lanes.Stream = undefined;
+    try std.testing.expectError(error.NotPipelined, b.queue(&s, .{ .value = 1 }, 5));
+    try std.testing.expectError(error.NoDraftHead, b.draft(&.{}));
+    try std.testing.expectError(error.NoSuchToken, b.read(3));
+    try std.testing.expectEqual(@as(u32, 128), pool.page_tokens);
+}
