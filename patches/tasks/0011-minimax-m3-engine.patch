diff --git a/zig/src/families/minimax_m3/draw.zig b/zig/src/families/minimax_m3/draw.zig
new file mode 100644
index 0000000..2bca8ee
--- /dev/null
+++ b/zig/src/families/minimax_m3/draw.zig
@@ -0,0 +1,267 @@
+//! Token draws from the forward's gathered fp32 logits on rank 0's host, by the lane core's keyed rule; others do none.
+const std = @import("std");
+const ops = @import("engine_ops.zig");
+const shard = @import("shard.zig");
+const iface = @import("iface.zig");
+const gpu_rule = @import("lanes").gpu_rule;
+
+const Cand = gpu_rule.Cand;
+
+/// How the device's gathered rows reach the host: `out.len` bytes at device address `addr`, after the stream drained.
+pub const Fetch = struct {
+    ptr: *anyopaque,
+    call: *const fn (ptr: *anyopaque, addr: u64, out: []u8) anyerror!void,
+};
+
+/// Reusable memory of a draw: a whole row and the candidates' heap.
+pub const Scratch = struct {
+    row: []f32,
+    heap: []Cand,
+
+    pub fn init(gpa: std.mem.Allocator, vocab: usize) !Scratch {
+        const row = try gpa.alloc(f32, vocab);
+        errdefer gpa.free(row);
+        return .{ .row = row, .heap = try gpa.alloc(Cand, gpu_rule.candidates) };
+    }
+
+    pub fn deinit(s: *Scratch, gpa: std.mem.Allocator) void {
+        gpa.free(s.row);
+        gpa.free(s.heap);
+    }
+};
+
+/// A logit the draw cannot take: NaN or +inf (-inf is a masked token).
+fn bad(v: f32) bool {
+    return std.math.isNan(v) or v == std.math.inf(f32);
+}
+
+/// gpu_rule.sample's draw without sorting the whole vocabulary: the candidates come from a bounded heap.
+pub fn sample(s: *Scratch, logits: []const f32, rule: ?ops.Sampling, position: u32) !u32 {
+    for (logits) |v| if (bad(v)) return error.NonFiniteLogits;
+    const st = rule orelse {
+        const at = gpu_rule.argmax(logits);
+        return if (logits[at] == -std.math.inf(f32)) error.NoAllowedToken else at;
+    };
+    const r = gpu_rule.rule(st);
+    const cap: usize = if (r.top_k == 0 or r.top_k > gpu_rule.candidates) gpu_rule.candidates else r.top_k;
+    const n: usize = @min(@min(logits.len, gpu_rule.candidates), cap);
+    var m = -std.math.inf(f32);
+    for (logits) |l| m = @max(m, l * r.inv_t);
+    if (m == -std.math.inf(f32)) return error.NoAllowedToken;
+    var lanes: [1024]f32 = @splat(0.0);
+    var heap_n: usize = 0;
+    for (logits, 0..) |l, i| {
+        const c: Cand = .{ .v = l * r.inv_t, .i = @intCast(i) };
+        lanes[i % 1024] += @exp(c.v - m);
+        heapPush(s.heap[0..n], &heap_n, c);
+    }
+    const all = s.heap[0..heap_n];
+    std.mem.sort(Cand, all, {}, gpu_rule.better);
+    var norm = gpu_rule.lanesSum(&lanes);
+    if (r.top_k != 0) {
+        norm = 0.0;
+        for (all) |c| norm += @exp(c.v - m);
+    }
+    var keep: usize = all.len;
+    if (r.top_p > 0.0 and r.top_p < 1.0) {
+        var cum: f32 = 0.0;
+        for (all, 0..) |c, j| {
+            cum += @exp(c.v - m) / norm;
+            if (cum >= r.top_p) {
+                keep = j + 1;
+                break;
+            }
+        }
+    }
+    if (r.min_log > -std.math.inf(f32)) {
+        const floor = m + r.min_log;
+        var j: usize = 0;
+        while (j < keep and all[j].v >= floor) j += 1;
+        keep = j;
+    }
+    var best: usize = 0;
+    var best_score = -std.math.inf(f32);
+    for (all[0..keep], 0..) |c, t| {
+        const score = c.v - @log(-@log(gpu_rule.uniform24(st.seed, position, c.i)));
+        if (t == 0 or score > best_score) {
+            best = t;
+            best_score = score;
+        }
+    }
+    return all[best].i;
+}
+
+/// A min-heap on the kernel's candidate order (the worst candidate at the root) holding the best `heap.len`.
+fn heapPush(heap: []Cand, n: *usize, c: Cand) void {
+    if (n.* < heap.len) {
+        var i = n.*;
+        n.* += 1;
+        heap[i] = c;
+        while (i > 0) { // sift up while the child is worse than its parent
+            const p = (i - 1) / 2;
+            if (!gpu_rule.better({}, heap[p], heap[i])) break;
+            std.mem.swap(Cand, &heap[p], &heap[i]);
+            i = p;
+        }
+        return;
+    }
+    if (!gpu_rule.better({}, c, heap[0])) return;
+    heap[0] = c;
+    var i: usize = 0;
+    while (true) {
+        const l = 2 * i + 1;
+        const r = l + 1;
+        var w = i;
+        if (l < heap.len and gpu_rule.better({}, heap[w], heap[l])) w = l;
+        if (r < heap.len and gpu_rule.better({}, heap[w], heap[r])) w = r;
+        if (w == i) return;
+        std.mem.swap(Cand, &heap[w], &heap[i]);
+        i = w;
+    }
+}
+
+/// A row of grammar words (bit t % 32 of word t / 32: token t allowed) applied to a whole row; the rest become -inf.
+pub fn mask(row: []f32, words: []const u32) void {
+    for (row, 0..) |*v, t| {
+        if (words[t / 32] >> @intCast(t % 32) & 1 == 0) v.* = -std.math.inf(f32);
+    }
+}
+
+/// Rank 0's draw over the gathered logits `[rank][row][slot]` of the last pass; another rank's draw returns at once.
+pub const HostDrawer = struct {
+    gpa: std.mem.Allocator,
+    rank: usize,
+    spans: []shard.Span, // every rank's vocabulary span
+    slot: usize, // logits a rank's slot holds per row (the largest share)
+    vocab: usize,
+    fetch: Fetch,
+    scratch: Scratch,
+    gathered: []f32, // world * total * slot, for the largest pass
+
+    pub fn init(gpa: std.mem.Allocator, rank: usize, spans: []const shard.Span, vocab: usize, fetch: Fetch) !*HostDrawer {
+        const d = try gpa.create(HostDrawer);
+        errdefer gpa.destroy(d);
+        const own = try gpa.dupe(shard.Span, spans);
+        errdefer gpa.free(own);
+        var slot: usize = 0;
+        for (spans) |sp| slot = @max(slot, sp.len());
+        var scratch = try Scratch.init(gpa, vocab);
+        errdefer scratch.deinit(gpa);
+        const gathered: []f32 = if (rank == 0) try gpa.alloc(f32, spans.len * iface.shared_rows * slot) else &.{};
+        d.* = .{ .gpa = gpa, .rank = rank, .spans = own, .slot = slot, .vocab = vocab, .fetch = fetch, .scratch = scratch, .gathered = gathered };
+        return d;
+    }
+
+    pub fn deinit(d: *HostDrawer) void {
+        if (d.rank == 0) d.gpa.free(d.gathered);
+        d.scratch.deinit(d.gpa);
+        d.gpa.free(d.spans);
+        d.gpa.destroy(d);
+    }
+
+    pub fn drawer(d: *HostDrawer) ops.Drawer {
+        return .{ .ptr = d, .draw_fn = drawFn };
+    }
+
+    fn drawFn(ptr: *anyopaque, req: ops.Draw) anyerror!void {
+        const d: *HostDrawer = @ptrCast(@alignCast(ptr));
+        if (d.rank != 0 or req.rows == 0) return;
+        const world = d.spans.len;
+        if (req.total > iface.shared_rows or req.row0 + req.rows > req.total or req.out.len < req.rows or req.first == 0) return error.WindowTooWide;
+        const g = d.gathered[0 .. world * req.total * d.slot];
+        try d.fetch.call(d.fetch.ptr, req.base, std.mem.sliceAsBytes(g));
+        const words = (d.vocab + 31) / 32;
+        for (0..req.rows) |k| {
+            for (d.spans, 0..) |sp, q| @memcpy(d.scratch.row[sp.lo..sp.hi], g[(q * req.total + req.row0 + k) * d.slot ..][0..sp.len()]);
+            if (req.bits != 0) {
+                const all: [*]const u32 = @ptrFromInt(req.bits);
+                mask(d.scratch.row, all[k * words ..][0..words]);
+            }
+            req.out[k] = try sample(&d.scratch, d.scratch.row, req.rule, @intCast(req.first + k));
+        }
+    }
+};
+
+fn randomRow(r: std.Random, row: []f32, levels: u32) void {
+    const noise: f32 = if (levels > 1000) 1.0 else 0.0;
+    for (row) |*v| v.* = @as(f32, @floatFromInt(r.uintLessThan(u32, levels))) * 0.25 - 4.0 + r.float(f32) * noise;
+}
+
+test "the bounded-heap draw is the lane core's draw, with ties, every rule and masked tokens" {
+    const gpa = std.testing.allocator;
+    var prng = std.Random.DefaultPrng.init(42);
+    const r = prng.random();
+    const vocab = 4099;
+    var s = try Scratch.init(gpa, vocab);
+    defer s.deinit(gpa);
+    const row = try gpa.alloc(f32, vocab);
+    defer gpa.free(row);
+    const rules = [_]?ops.Sampling{
+        null,
+        .{ .seed = 1, .temperature = 0.8, .top_k = 20, .top_p = 0.95 },
+        .{ .seed = 2, .temperature = 1.0, .top_k = 0, .top_p = 1.0 },
+        .{ .seed = 3, .temperature = 0.3, .top_k = 1, .top_p = 0.5, .min_p = 0.05 },
+        .{ .seed = 4, .temperature = 1.5, .top_k = 5000, .top_p = 0.9, .min_p = 0.01 },
+    };
+    for (0..30) |case| {
+        randomRow(r, row, if (case % 2 == 0) 40 else 100_000); // many exact ties, then few
+        if (case % 3 == 0) for (row, 0..) |*v, t| {
+            if (t % 5 != 0) v.* = -std.math.inf(f32); // a grammar left every fifth token
+        };
+        for (rules) |rule| {
+            const pos: u32 = @intCast(100 + case);
+            const want = try gpu_rule.sample(gpa, row, rule, pos, null);
+            try std.testing.expectEqual(want, try sample(&s, row, rule, pos));
+        }
+    }
+}
+
+test "a non-finite logit is refused and a grammar keeps only its tokens" {
+    const gpa = std.testing.allocator;
+    var s = try Scratch.init(gpa, 64);
+    defer s.deinit(gpa);
+    const row = try gpa.alloc(f32, 64);
+    defer gpa.free(row);
+    @memset(row, 0);
+    row[7] = 5;
+    try std.testing.expectEqual(@as(u32, 7), try sample(&s, row, null, 1));
+    var words = [_]u32{ 1 << 3 | 1 << 8, 1 << 5 }; // tokens 3, 8 and 37 allowed
+    mask(row, &words);
+    try std.testing.expectEqual(@as(u32, 3), try sample(&s, row, null, 1)); // 7 is masked; ties go to the lowest id
+    var none = [_]u32{ 0, 0 };
+    mask(row, &none);
+    try std.testing.expectError(error.NoAllowedToken, sample(&s, row, null, 1));
+    try std.testing.expectError(error.NoAllowedToken, sample(&s, row, .{ .seed = 1, .temperature = 1 }, 1));
+    row[0] = std.math.nan(f32);
+    try std.testing.expectError(error.NonFiniteLogits, sample(&s, row, null, 1));
+}
+
+test "rank 0 draws from the gathered slots of every rank, the other rank draws nothing" {
+    const gpa = std.testing.allocator;
+    const spans = [_]shard.Span{ .{ .lo = 0, .hi = 6 }, .{ .lo = 6, .hi = 10 } }; // slot 6: the second rank pads two
+    const Dev = struct {
+        data: [2 * 3 * 6]f32 = @splat(0), // [rank][row][slot] for three rows
+        fn fetch(p: *anyopaque, addr: u64, out: []u8) anyerror!void {
+            const self: *@This() = @ptrCast(@alignCast(p));
+            try std.testing.expectEqual(@as(u64, 0xabc), addr);
+            @memcpy(out, std.mem.sliceAsBytes(self.data[0 .. out.len / 4]));
+        }
+    };
+    var dev: Dev = .{};
+    dev.data[(0 * 3 + 1) * 6 + 2] = 9; // rank 0, row 1: token 2 wins
+    dev.data[(1 * 3 + 2) * 6 + 3] = 9; // rank 1, row 2: token 6 + 3 = 9 wins
+    const f: Fetch = .{ .ptr = &dev, .call = Dev.fetch };
+    const d0 = try HostDrawer.init(gpa, 0, &spans, 10, f);
+    defer d0.deinit();
+    var out: [2]u32 = undefined;
+    try d0.drawer().draw(.{ .base = 0xabc, .total = 3, .row0 = 1, .rows = 2, .first = 50, .rule = null, .bits = 0, .out = &out });
+    try std.testing.expectEqualSlices(u32, &.{ 2, 9 }, &out);
+    const d1 = try HostDrawer.init(gpa, 1, &spans, 10, f);
+    defer d1.deinit();
+    out = .{ 77, 77 };
+    try d1.drawer().draw(.{ .base = 0xabc, .total = 3, .row0 = 1, .rows = 2, .first = 50, .rule = null, .bits = 0, .out = &out });
+    try std.testing.expectEqualSlices(u32, &.{ 77, 77 }, &out);
+    var words = [_]u32{ 1 << 9, 1 << 9 }; // only token 9 allowed in either row
+    try d0.drawer().draw(.{ .base = 0xabc, .total = 3, .row0 = 0, .rows = 2, .first = 50, .rule = null, .bits = @intFromPtr(&words), .out = &out });
+    try std.testing.expectEqualSlices(u32, &.{ 9, 9 }, &out);
+}
diff --git a/zig/src/families/minimax_m3/engine.zig b/zig/src/families/minimax_m3/engine.zig
new file mode 100644
index 0000000..ad8191e
--- /dev/null
+++ b/zig/src/families/minimax_m3/engine.zig
@@ -0,0 +1,317 @@
+//! One TP rank's MiniMax-M3.1-Flash engine: slots over the pooled KV pages, chunked prompts, windows and draws.
+const std = @import("std");
+const cuda = @import("cuda");
+const iface = @import("iface.zig");
+const pool = @import("pool.zig");
+const ops_ = @import("engine_ops.zig");
+
+pub const Sampling = iface.Sampling;
+pub const Part = iface.Part;
+pub const Resume = iface.Resume;
+pub const Marks = iface.Marks;
+pub const Cancel = iface.Cancel;
+pub const prefill_rows = iface.prefill_rows;
+pub const window_rows = iface.window_rows;
+pub const shared_rows = iface.shared_rows;
+pub const max_shared = iface.max_shared;
+
+/// The request's rule as the engine runs it: null (or temperature 0) decodes greedily.
+pub fn check(s: ?Sampling) ?Sampling {
+    const x = s orelse return null;
+    return if (x.temperature > 0) x else null;
+}
+
+/// A stream's sequence on the engine: how it draws, the committed rows, and the rows its last window left uncommitted.
+pub const Seq = struct { sampling: ?Sampling = null, pos: usize = 0, pending: usize = 0 };
+
+/// Everything an engine runs on; engine_dev.zig fills it from the device, the host tests from fakes.
+pub const Parts = struct {
+    ops: ops_.Ops,
+    device: ops_.Device,
+    comm: ops_.Comm,
+    drawer: ops_.Drawer,
+    capacity: usize,
+    page_bytes: u64,
+    checkpoint_digest: [32]u8 = @splat(0),
+    stream: ?cuda.Stream = null, // the engine's stream (the host opens the RoCE gather on it)
+    group: ?*cuda.tp_group.Group = null, // the group the forward holds: the host's RoCE small gather goes into it
+    close: ?Closer = null,
+};
+
+/// Frees what an engine's parts own (device buffers, the communicator, the forward's buffers) at `deinit`.
+pub const Closer = struct { ptr: *anyopaque, call: *const fn (ptr: *anyopaque) void };
+
+/// Where a prompt pass's chunk starting at `start` of a `len`-id prompt ends: a chunk's rows, or the next mark.
+pub fn chunkEnd(start: usize, len: usize, marks: ?Marks) usize {
+    var end = @min(len, start + prefill_rows);
+    if (marks) |m| for (m.at) |at| {
+        if (at > start and at < end) {
+            end = at;
+            break;
+        }
+    };
+    return end;
+}
+
+pub const Engine = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    p: Parts,
+    rank: usize,
+    world: usize,
+    capacity: usize,
+    max_pages: usize,
+    seqs: std.ArrayList(Seq) = .empty,
+    slot: u32 = 0,
+    view: ?ops_.PoolView = null,
+    last_rows: [3]usize = @splat(0), // rows of the last pass of each kind: the gathered logits' rank stride
+    checkpoint_digest: [32]u8,
+
+    /// The engine over `parts` with the one sequence a block table starts with (slot 0); `attach` makes the pool.
+    pub fn make(gpa: std.mem.Allocator, io: std.Io, parts: Parts) !*Engine {
+        const e = try gpa.create(Engine);
+        errdefer gpa.destroy(e);
+        e.* = .{ .gpa = gpa, .io = io, .p = parts, .rank = parts.comm.rank, .world = parts.comm.world, .capacity = parts.capacity, .max_pages = iface.maxPages(parts.capacity), .checkpoint_digest = parts.checkpoint_digest };
+        try e.seqs.append(gpa, .{});
+        return e;
+    }
+
+    /// The host opened the RoCE small gather on its group: the forward and the failure check use it from now on.
+    pub fn setGroup(e: *Engine, g: *const cuda.tp_group.Group) void {
+        if (e.p.group) |own| own.fast = g.fast;
+    }
+
+    /// Rank 0's `Tables.upload`: its block-table pushes reach the device on the engine's stream.
+    pub fn uploadHook(e: *Engine) pool.Upload {
+        return .{ .ctx = e, .call = uploadFn };
+    }
+
+    fn uploadFn(ctx: *anyopaque, slot: u32, from: usize, entries: []const i32) anyerror!void {
+        const e: *Engine = @ptrCast(@alignCast(ctx));
+        return e.upload(slot, from, entries);
+    }
+
+    /// The production constructor (iface.conformsEngine's `init`): weights, agreed fingerprint, forward, device.
+    pub const init = @import("engine_dev.zig").init;
+
+    pub fn deinit(e: *Engine) void {
+        e.p.ops.sync() catch {};
+        if (e.p.close) |c| c.call(c.ptr);
+        e.seqs.deinit(e.gpa);
+        e.gpa.destroy(e);
+    }
+
+    /// The pool of `slots` streams and `pages` pages, made now on this rank (rank 0 tells the others first).
+    pub fn attach(e: *Engine, slots: u32, pages: usize) !void {
+        const view = try e.p.device.vtable.attach(e.p.device.ptr, slots, pages, e.max_pages, e.p.page_bytes);
+        try e.p.ops.attach(view);
+        e.view = view;
+        while (e.seqs.items.len < slots) try e.seqs.append(e.gpa, .{});
+    }
+
+    /// `entries` of `slot`'s table row from entry `from` to the device (also rank 0's `Tables.upload`).
+    pub fn upload(e: *Engine, slot: u32, from: usize, entries: []const i32) !void {
+        return e.p.device.vtable.upload(e.p.device.ptr, slot, from, entries);
+    }
+
+    /// Page ids `ids` at entry `from` of `slot`'s table row, as rank 0 decided them.
+    pub fn setPages(e: *Engine, slot: u32, from: usize, ids: []const u32) !void {
+        if (from + ids.len > e.max_pages) return error.TableFull;
+        var buf: [256]i32 = undefined;
+        var at: usize = 0;
+        while (at < ids.len) {
+            const n = @min(buf.len, ids.len - at);
+            for (buf[0..n], ids[at..][0..n]) |*d, id| d.* = @intCast(id);
+            try e.upload(slot, from + at, buf[0..n]);
+            at += n;
+        }
+    }
+
+    /// Slot `slot`'s table row back to -1.
+    pub fn clearRow(e: *Engine, slot: u32) !void {
+        const row = try e.gpa.alloc(i32, e.max_pages);
+        defer e.gpa.free(row);
+        @memset(row, -1);
+        try e.upload(slot, 0, row);
+    }
+
+    /// Binds slot `slot` for the steps that follow.
+    pub fn bind(e: *Engine, slot: u32) !void {
+        if (slot >= e.seqs.items.len) return error.BadSlot;
+        e.slot = slot;
+    }
+
+    /// Frees slot `slot`'s sequence (its pages are rank 0's to return) and clears its table row.
+    pub fn release(e: *Engine, slot: u32) void {
+        if (slot >= e.seqs.items.len) return;
+        e.seqs.items[slot] = .{};
+        if (e.view != null) e.clearRow(slot) catch |err| std.log.err("clearing slot {d}'s block table: {s}", .{ slot, @errorName(err) });
+    }
+
+    /// Bytes a stream holds beyond its pages: its block-table row.
+    pub fn seqBytes(e: *const Engine) u64 {
+        return pool.Dims.tableBytes(e.max_pages);
+    }
+
+    fn cur(e: *Engine) *Seq {
+        return &e.seqs.items[e.slot];
+    }
+
+    /// The committed length of the bound sequence: the pending token sits here, row r of a window draws pos + 1 + r.
+    pub fn pos(e: *const Engine) usize {
+        return e.seqs.items[e.slot].pos;
+    }
+
+    /// A follower's begin (no image rows exist here to clear).
+    pub fn beginFollowing(e: *Engine, sampling: ?Sampling) !void {
+        return e.begin(sampling);
+    }
+
+    /// A fresh sequence on the bound slot with `sampling` (null or temperature 0: greedy).
+    pub fn begin(e: *Engine, sampling: ?Sampling) !void {
+        e.cur().* = .{ .sampling = check(sampling) };
+    }
+
+    /// The whole prompt in chunks (a mark cuts one), then the first token; `from` resumes adopted pages.
+    pub fn prefill(e: *Engine, ids: []const u32, from: ?Resume, cancel: ?Cancel, marks: ?Marks) !u32 {
+        var start = try e.prefillStart(ids.len, from);
+        while (true) {
+            const end = chunkEnd(start, ids.len, marks);
+            if (try e.prefillChunk(ids[start..end], start, ids.len, if (start == (if (from) |r| r.at else 0)) from else null, cancel, marks)) |first| return first;
+            start = end;
+        }
+    }
+
+    /// Where a prompt pass of `len` ids starts: 0, or the rows already in the adopted pages.
+    fn prefillStart(e: *Engine, len: usize, from: ?Resume) !usize {
+        if (len == 0 or len + window_rows >= e.capacity) return error.PromptTooLong;
+        const r = from orelse return 0;
+        if (r.at == 0 or r.at >= len or r.at % pool.page_tokens != 0) return error.BadResume;
+        return r.at;
+    }
+
+    /// One chunk `part` = ids[start..] of a `len`-id prompt; the first token once it ends the prompt, else null.
+    pub fn prefillChunk(e: *Engine, part: []const u32, start: usize, len: usize, from: ?Resume, cancel: ?Cancel, marks: ?Marks) !?u32 {
+        const begun = try e.prefillStart(len, from);
+        if (from != null) {
+            if (begun != start) return error.BadChunk;
+            e.cur().pos = start; // the rows before it are in the adopted pages
+        }
+        const rows = part.len;
+        const s = e.cur();
+        if (start >= len or start % pool.page_tokens != 0 or rows == 0 or rows > prefill_rows or start + rows > len) return error.BadChunk;
+        if (start + rows < len and rows % pool.page_tokens != 0) return error.BadChunk; // the next chunk starts on a page
+        if (s.pos != start) return error.BadChunk;
+        if (marks) |m| if (start > 0 and std.mem.indexOfScalar(u32, m.at, @intCast(start)) != null) m.call(m.ctx, @intCast(start));
+        try e.gate(cancel);
+        const segs = [1]iface.Seg{.{ .slot = e.slot, .row0 = 0, .rows = @intCast(rows) }};
+        try e.p.ops.run(.{ .kind = .prompt, .ids = part, .segs = &segs, .starts = &.{@intCast(start)}, .head = start + rows == len });
+        s.pos = start + rows;
+        if (start + rows < len) return null;
+        var t: [1]u32 = undefined;
+        e.last_rows[@backingInt(ops_.Rows.prompt)] = 1; // only the last row of the chunk goes through the head
+        try e.drawPass(.prompt, 0, 1, len, 0, &t);
+        return t[0];
+    }
+
+    /// The chunk gate on every rank: rank 0's cancel decides for all, so no rank enters a forward the others skip.
+    pub fn gate(e: *Engine, cancel: ?Cancel) !void {
+        const mine: f64 = if (cancel) |c| @floatFromInt(@intFromBool(c.check(c.ptr))) else 0;
+        if (try e.p.comm.maxF64(mine) > 0) return error.Cancelled;
+    }
+
+    /// A verify window: `ids` (pending token, then drafts) at the committed position; `out[r]` drawn at pos + 1 + r.
+    pub fn verify(e: *Engine, ids: []const u32, out: []u32, bits: u64) !void {
+        if (ids.len == 0 or ids.len > window_rows or out.len < ids.len) return error.WindowTooWide;
+        const s = e.cur();
+        if (s.pos + ids.len >= e.capacity) return error.ContextFull;
+        const segs = [1]iface.Seg{.{ .slot = e.slot, .row0 = 0, .rows = @intCast(ids.len) }};
+        try e.p.ops.run(.{ .kind = .window, .ids = ids, .segs = &segs, .starts = &.{@intCast(s.pos)} });
+        s.pending = ids.len;
+        e.last_rows[@backingInt(ops_.Rows.window)] = ids.len;
+        try e.drawPass(.window, 0, ids.len, s.pos + 1, bits, out);
+    }
+
+    /// Several streams' windows in one forward: row ops are shared, attention reads each stream's own pages.
+    pub fn verifyShared(e: *Engine, parts: []const Part) !void {
+        if (parts.len == 0 or parts.len > max_shared) return error.WindowTooWide;
+        var segs: [max_shared]iface.Seg = undefined;
+        var starts: [max_shared]u32 = undefined;
+        var ids: [shared_rows]u32 = undefined;
+        var rows: usize = 0;
+        for (parts, 0..) |p, i| {
+            if (p.ids.len == 0 or p.ids.len > window_rows or rows + p.ids.len > shared_rows or p.out.len < p.ids.len) return error.WindowTooWide;
+            for (parts[0..i]) |q| if (q.slot == p.slot) return error.SlotTwice;
+            if (p.slot >= e.seqs.items.len) return error.BadSlot;
+            const s = e.seqs.items[p.slot];
+            if (s.pos + p.ids.len >= e.capacity) return error.ContextFull;
+            segs[i] = .{ .slot = p.slot, .row0 = @intCast(rows), .rows = @intCast(p.ids.len) };
+            starts[i] = @intCast(s.pos);
+            @memcpy(ids[rows..][0..p.ids.len], p.ids);
+            rows += p.ids.len;
+        }
+        try e.p.ops.run(.{ .kind = .shared, .ids = ids[0..rows], .segs = segs[0..parts.len], .starts = starts[0..parts.len] });
+        e.last_rows[@backingInt(ops_.Rows.shared)] = rows;
+        for (parts, segs[0..parts.len]) |p, g| {
+            try e.bind(p.slot);
+            e.cur().pending = p.ids.len;
+            try e.drawPass(.shared, g.row0, g.rows, e.cur().pos + 1, p.bits, p.out);
+        }
+    }
+
+    /// Commits the first `n` rows of the last window (the rest were rejected drafts; their KV rows are overwritten).
+    pub fn keep(e: *Engine, n: usize) !void {
+        const s = e.cur();
+        if (n > s.pending) return error.BadKeep;
+        s.pos += n;
+        s.pending = 0;
+    }
+
+    /// Rows [row0, row0 + rows) of the last pass of `kind` drawn at positions first, first + 1, ... (rank 0 draws).
+    fn drawPass(e: *Engine, kind: ops_.Rows, row0: usize, rows: usize, first: u64, bits: u64, out: []u32) !void {
+        if (rows == 0) return;
+        const base = e.p.ops.logits(kind);
+        try e.p.drawer.draw(.{ .base = base, .total = e.last_rows[@backingInt(kind)], .row0 = row0, .rows = rows, .first = first, .rule = e.cur().sampling, .bits = bits, .out = out });
+        return e.checkGathers(); // the draw read rows the forward's gathers made
+    }
+
+    /// The contract's draw: `rows` gathered rows at `logits` (a whole pass) drawn at positions first, first + 1, ...
+    pub fn draw(e: *Engine, logits: u64, rows: usize, first: u64, bits: u64, out: []u32) !void {
+        if (rows == 0) return;
+        try e.p.drawer.draw(.{ .base = logits, .total = rows, .row0 = 0, .rows = rows, .first = first, .rule = e.cur().sampling, .bits = bits, .out = out });
+        return e.checkGathers();
+    }
+
+    /// A failed RoCE gather's error, after a synchronize whose result read gathered rows.
+    pub fn checkGathers(e: *const Engine) !void {
+        return e.p.comm.check();
+    }
+
+    pub fn sync(e: *Engine) !void {
+        return e.p.ops.sync();
+    }
+};
+
+comptime {
+    iface.conformsEngine(Engine);
+}
+
+test "a chunk ends at the pass's chunk rows, at a mark, or at the prompt's end" {
+    try std.testing.expectEqual(@as(usize, 2048), chunkEnd(0, 5000, null));
+    try std.testing.expectEqual(@as(usize, 100), chunkEnd(0, 100, null));
+    const Hook = struct {
+        fn call(_: *anyopaque, _: u32) void {}
+    };
+    var x: u8 = 0;
+    const m: Marks = .{ .at = &.{ 512, 1024, 4096 }, .ctx = &x, .call = Hook.call };
+    try std.testing.expectEqual(@as(usize, 512), chunkEnd(0, 5000, m));
+    try std.testing.expectEqual(@as(usize, 1024), chunkEnd(512, 5000, m));
+    try std.testing.expectEqual(@as(usize, 3072), chunkEnd(1024, 5000, m));
+    try std.testing.expectEqual(@as(usize, 4096), chunkEnd(3072, 5000, m));
+    try std.testing.expectEqual(@as(usize, 5000), chunkEnd(4096, 5000, m));
+}
+
+test "temperature 0 is greedy" {
+    try std.testing.expectEqual(@as(?Sampling, null), check(.{ .seed = 1, .temperature = 0 }));
+    try std.testing.expect(check(.{ .seed = 1, .temperature = 0.5 }) != null);
+}
diff --git a/zig/src/families/minimax_m3/engine_dev.zig b/zig/src/families/minimax_m3/engine_dev.zig
new file mode 100644
index 0000000..ba74ab8
--- /dev/null
+++ b/zig/src/families/minimax_m3/engine_dev.zig
@@ -0,0 +1,388 @@
+//! The engine on the device: NCCL collectives, page arena, block table, control wire, `Engine.init` (never run).
+const std = @import("std");
+const cuda = @import("cuda");
+const iface = @import("iface.zig");
+const ops = @import("engine_ops.zig");
+const engine = @import("engine.zig");
+const follow = @import("follow.zig");
+const draw = @import("draw.zig");
+const ranks = @import("ranks.zig");
+const config = @import("config.zig");
+const shard = @import("shard.zig");
+const pool = @import("pool.zig");
+const load = @import("load.zig");
+const weights_device = @import("weights_device.zig");
+
+/// GLM's NCCL defaults, set when the environment leaves them unset: connect at init, no cuMem host buffers.
+pub const nccl_defaults = [_][2][:0]const u8{
+    .{ "NCCL_RUNTIME_CONNECT", "0" }, // every connection is registered at init, while memory is free
+    .{ "NCCL_CUMEM_HOST_ENABLE", "0" }, // cuMem host buffers wore out GB10's driver pool under load
+    .{ "NCCL_CUMEM_ENABLE", "0" },
+};
+
+/// Sets each default that `get` finds unset (setenv with overwrite 0, as GLM does).
+pub fn applyNcclDefaults(get: *const fn ([*:0]const u8) ?[*:0]const u8, set: *const fn ([*:0]const u8, [*:0]const u8) void) void {
+    for (nccl_defaults) |kv| if (get(kv[0].ptr) == null) set(kv[0].ptr, kv[1].ptr);
+}
+
+extern "c" fn setenv(name: [*:0]const u8, value: [*:0]const u8, overwrite: c_int) c_int;
+
+fn getenvC(name: [*:0]const u8) ?[*:0]const u8 {
+    return std.c.getenv(name);
+}
+
+fn setenvC(name: [*:0]const u8, value: [*:0]const u8) void {
+    _ = setenv(name, value, 0);
+}
+
+pub fn setNcclDefaults() void {
+    applyNcclDefaults(getenvC, setenvC);
+}
+
+/// Every peer's send/recv connected now, before the weights fill memory (connected on first use, ibv_reg_mr can fail).
+pub fn warmPeers(d: *const cuda.Driver, g: *const cuda.tp_group.Group) !void {
+    const bytes = 4 << 20; // a prompt piece's exchange: every channel a large send/recv takes
+    var buf = try cuda.DeviceBuffer.alloc(d, 2 * bytes * g.world);
+    defer buf.free();
+    var s = try cuda.Stream.init(d, false);
+    defer s.deinit();
+    try g.lib.check(g.lib.api.ncclGroupStart(), "ncclGroupStart");
+    const posted: anyerror!void = post: {
+        for (0..g.world) |peer| if (peer != g.rank) {
+            g.send(s, buf.ptr + peer * bytes, bytes, peer) catch |err| break :post err;
+            g.recv(s, buf.ptr + (g.world + peer) * bytes, bytes, peer) catch |err| break :post err;
+        };
+        break :post {};
+    };
+    try g.lib.check(g.lib.api.ncclGroupEnd(), "ncclGroupEnd"); // the group closes on every path
+    try posted;
+    try s.synchronize();
+}
+
+/// The collectives over NCCL on the engine's stream.
+pub const NcclComm = struct {
+    d: *const cuda.Driver,
+    lib: *const cuda.nccl.Library,
+    comm: cuda.nccl.Comm,
+    stream: cuda.Stream,
+    rank: usize,
+    world: usize,
+    one: cuda.DeviceBuffer, // one f64 every rank all-reduces to its maximum
+    group: *const cuda.tp_group.Group,
+
+    pub fn interface(c: *NcclComm) ops.Comm {
+        return .{ .ptr = c, .vtable = &.{ .max_f64 = maxF64, .gather_bytes = gatherBytes, .check = checkFn }, .rank = c.rank, .world = c.world };
+    }
+
+    fn of(ptr: *anyopaque) *NcclComm {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    fn maxF64(ptr: *anyopaque, v: f64) anyerror!f64 {
+        const c = of(ptr);
+        if (c.world == 1) return v;
+        var x = v;
+        try c.one.uploadAsync(0, std.mem.asBytes(&x), c.stream.handle);
+        try c.lib.check(c.lib.api.ncclAllReduce(c.one.ptr, c.one.ptr, 1, .f64, .max, c.comm, c.stream.handle), "ncclAllReduce");
+        try c.stream.synchronize();
+        try c.one.download(0, std.mem.asBytes(&x));
+        return x;
+    }
+
+    /// Every rank's `mine` in rank order, over one ncclAllGather of bytes (glm/cuda_ranks.zig's `gather`).
+    fn gatherBytes(ptr: *anyopaque, mine: []const u8, out: []u8) anyerror!void {
+        const c = of(ptr);
+        if (out.len != mine.len * c.world) return error.BadGather;
+        if (c.world == 1) return @memcpy(out, mine);
+        var dev = try cuda.DeviceBuffer.alloc(c.d, out.len);
+        defer dev.free();
+        try dev.uploadAsync(c.rank * mine.len, mine, c.stream.handle);
+        try c.lib.check(c.lib.api.ncclAllGather(dev.ptr + c.rank * mine.len, dev.ptr, mine.len, .u8, c.comm, c.stream.handle), "ncclAllGather");
+        try c.stream.synchronize();
+        try dev.download(0, out);
+    }
+
+    fn checkFn(ptr: *anyopaque) anyerror!void {
+        try of(ptr).group.check();
+    }
+};
+
+/// The fingerprint through the byte gather, for `ranks.agree`.
+pub fn gatherFingerprint(c: ops.Comm, mine: ranks.Fingerprint, out: []ranks.Fingerprint) anyerror!void {
+    try c.gatherBytes(std.mem.asBytes(&mine), std.mem.sliceAsBytes(out));
+}
+
+/// The ranks agree on what they run before any weight loads; any difference is error.RankMismatch on every rank.
+pub fn agreeFingerprints(gpa: std.mem.Allocator, c: ops.Comm, mine: ranks.Fingerprint) !void {
+    const all = try gpa.alloc(ranks.Fingerprint, c.world);
+    defer gpa.free(all);
+    try ranks.agree(c, gatherFingerprint, mine, all);
+}
+
+/// The page arena and the int32 block table on the device (iface decision M3).
+pub const DevicePool = struct {
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    arena: ?cuda.DeviceBuffer = null,
+    table: ?cuda.DeviceBuffer = null,
+    max_pages: usize = 0,
+
+    pub fn interface(p: *DevicePool) ops.Device {
+        return .{ .ptr = p, .vtable = &.{ .attach = attach, .upload = upload, .deinit = deinitFn } };
+    }
+
+    fn of(ptr: *anyopaque) *DevicePool {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    pub fn release(p: *DevicePool) void {
+        p.stream.synchronize() catch {};
+        if (p.arena) |*a| a.free();
+        if (p.table) |*t| t.free();
+        p.arena = null;
+        p.table = null;
+    }
+
+    fn attach(ptr: *anyopaque, slots: u32, pages: usize, max_pages: usize, page_bytes: u64) anyerror!ops.PoolView {
+        const p = of(ptr);
+        p.release();
+        var arena = try cuda.DeviceBuffer.alloc(p.d, @max(1, pages * page_bytes));
+        errdefer arena.free();
+        var table = try cuda.DeviceBuffer.alloc(p.d, @max(1, slots * max_pages * iface.decisions.table_entry_bytes));
+        errdefer table.free();
+        try table.fill32(0xFFFF_FFFF, p.stream.handle); // every entry -1
+        p.arena = arena;
+        p.table = table;
+        p.max_pages = max_pages;
+        return .{ .arena = arena.ptr, .page_bytes = page_bytes, .pages = pages, .table = table.ptr, .slots = slots, .max_pages = max_pages };
+    }
+
+    fn upload(ptr: *anyopaque, slot: u32, from: usize, entries: []const i32) anyerror!void {
+        const p = of(ptr);
+        const t = p.table orelse return error.NoPool;
+        const at = (@as(usize, slot) * p.max_pages + from) * iface.decisions.table_entry_bytes;
+        try t.uploadAsync(at, std.mem.sliceAsBytes(entries), p.stream.handle);
+    }
+
+    fn deinitFn(ptr: *anyopaque) void {
+        of(ptr).release();
+    }
+};
+
+/// The control link over ncclBroadcast on the engine's stream: a 64-byte header, then its ids.
+pub const NcclWire = struct {
+    lib: *const cuda.nccl.Library,
+    comm: cuda.nccl.Comm,
+    stream: cuda.Stream,
+    buf: cuda.DeviceBuffer,
+
+    pub fn init(d: *const cuda.Driver, lib: *const cuda.nccl.Library, comm: cuda.nccl.Comm, stream: cuda.Stream, ids: usize) !NcclWire {
+        return .{ .lib = lib, .comm = comm, .stream = stream, .buf = try cuda.DeviceBuffer.alloc(d, 64 + ids * 4) };
+    }
+
+    pub fn deinit(w: *NcclWire) void {
+        w.buf.free();
+    }
+
+    pub fn wire(w: *NcclWire) follow.Wire {
+        return .{ .ptr = w, .vtable = &.{ .send = send, .receive = receive } };
+    }
+
+    fn post(w: *NcclWire, offset: usize, bytes: usize) !void {
+        try w.lib.check(w.lib.api.ncclBroadcast(w.buf.ptr + offset, w.buf.ptr + offset, bytes, .u8, 0, w.comm, w.stream.handle), "ncclBroadcast");
+    }
+
+    /// Rank 0: enqueued on the stream and not waited for; the stream orders the next step's upload after it.
+    fn send(ptr: *anyopaque, h: *const iface.Header, ids: []const u32) anyerror!void {
+        const w: *NcclWire = @ptrCast(@alignCast(ptr));
+        if (64 + ids.len * 4 > w.buf.len) return error.TooManyIds;
+        try w.buf.uploadAsync(0, std.mem.asBytes(h), w.stream.handle);
+        try w.post(0, 64);
+        if (ids.len == 0) return;
+        try w.buf.uploadAsync(64, std.mem.sliceAsBytes(ids), w.stream.handle);
+        try w.post(64, ids.len * 4);
+    }
+
+    fn receive(ptr: *anyopaque, out: []u32) anyerror!iface.Header {
+        const w: *NcclWire = @ptrCast(@alignCast(ptr));
+        try w.post(0, 64);
+        try w.stream.synchronize();
+        var h: iface.Header = undefined;
+        try w.buf.download(0, std.mem.asBytes(&h));
+        if (h.n > out.len or 64 + @as(usize, h.n) * 4 > w.buf.len) return error.TooManyIds;
+        if (h.n > 0) {
+            try w.post(64, @as(usize, h.n) * 4);
+            try w.stream.synchronize();
+            try w.buf.download(64, std.mem.sliceAsBytes(out[0..h.n]));
+        }
+        return h;
+    }
+};
+
+/// The device-to-host copy of a pass's gathered logits for rank 0's draw: the stream drains first.
+pub const Download = struct {
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+
+    pub fn fetch(x: *Download) draw.Fetch {
+        return .{ .ptr = x, .call = call };
+    }
+
+    fn call(ptr: *anyopaque, addr: u64, out: []u8) anyerror!void {
+        const x: *Download = @ptrCast(@alignCast(ptr));
+        try x.stream.synchronize();
+        try x.d.check(x.d.api.cuMemcpyDtoH_v2(out.ptr, addr, out.len), "cuMemcpyDtoH");
+    }
+};
+
+/// A round's grammar words in host memory, where rank 0's draw reads them (the address is the `bits` of a window).
+pub const Bits = struct {
+    gpa: std.mem.Allocator,
+    words: usize, // u32 words of one row
+    buf: []u32 = &.{},
+
+    pub fn interface(b: *Bits) @import("backend.zig").Masks {
+        return .{ .ptr = b, .put = put };
+    }
+
+    pub fn deinit(b: *Bits) void {
+        b.gpa.free(b.buf);
+    }
+
+    fn put(ptr: *anyopaque, row: usize, rows: usize, words: []const u32) anyerror!u64 {
+        const b: *Bits = @ptrCast(@alignCast(ptr));
+        if (words.len != rows * b.words or row + rows > iface.shared_rows) return error.InvalidGrammarMasks;
+        if (b.buf.len == 0) b.buf = try b.gpa.alloc(u32, iface.shared_rows * b.words);
+        @memcpy(b.buf[row * b.words ..][0..words.len], words);
+        return @intFromPtr(b.buf[row * b.words ..].ptr);
+    }
+};
+
+pub fn hashFile(gpa: std.mem.Allocator, io: std.Io, path: []const u8) ![32]u8 {
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 30));
+    defer gpa.free(bytes);
+    return ranks.hashBytes(bytes);
+}
+
+/// The liveness lines (cuda/tp_watch.zig) as the follower and the leader use them; `io` is the process's.
+pub fn hooksWith(io: *const std.Io) follow.Hooks {
+    return .{ .ctx = @constCast(io), .live = hookLive, .sleep = hookSleep, .wake = hookWake, .failed = hookFailed, .ended = hookEnded };
+}
+
+fn hookLive(_: *anyopaque) bool {
+    return cuda.tp_watch.open();
+}
+
+fn hookSleep(ctx: *anyopaque) void {
+    const io: *const std.Io = @ptrCast(@alignCast(ctx));
+    cuda.tp_watch.sleep(io.*);
+}
+
+fn hookWake(_: *anyopaque) void {
+    cuda.tp_watch.wake();
+}
+
+fn hookFailed(_: *anyopaque, name: []const u8) void {
+    cuda.tp_watch.fail(name);
+}
+
+fn hookEnded(_: *anyopaque) void {
+    cuda.tp_watch.ended();
+}
+
+/// What an engine owns on the device; `close` frees it in the order it was made.
+const Owner = struct {
+    gpa: std.mem.Allocator,
+    stream: cuda.Stream,
+    comm: NcclComm,
+    pool: DevicePool,
+    loaded: weights_device.Loaded,
+    cfg: config.Config,
+    group: cuda.tp_group.Group, // what the forward holds; the host copies its RoCE small gather in after open
+    forward: ops.Ops,
+    download: Download,
+    drawer: *draw.HostDrawer,
+
+    fn close(ptr: *anyopaque) void {
+        const o: *Owner = @ptrCast(@alignCast(ptr));
+        o.stream.synchronize() catch {};
+        o.drawer.deinit();
+        o.forward.vtable.deinit(o.forward.ptr);
+        o.pool.release();
+        o.comm.one.free();
+        o.loaded.deinit();
+        o.stream.deinit();
+        o.gpa.destroy(o);
+    }
+};
+
+/// Opens rank `rank` of `world` over `comm`: the ranks agree on what they run, then the weights and forward load.
+pub fn init(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, ctx: *const cuda.Context, checkpoint: []const u8, lib: *const cuda.nccl.Library, comm: cuda.nccl.Comm, rank: usize, world: usize, o: iface.EngineOptions) !*engine.Engine {
+    if (world > ranks.max_world) return error.TooManyRanks;
+    if (rank >= world) return error.NoRank;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ checkpoint, "config.json" }), a, .limited(1 << 24));
+    const quant_path = try std.fs.path.join(a, &.{ checkpoint, "quantization_config.json" });
+    const quant: [32]u8 = hashFile(a, io, quant_path) catch ranks.hashBytes("");
+    const c = try config.parse(gpa, text);
+    const share = try shard.Share.of(&c, rank, world);
+    const dims = try pool.Dims.of(&c, share);
+    var cat = try load.Catalog.open(gpa, io, checkpoint);
+    defer cat.deinit();
+    const digest = try weights_device.digest(gpa, &cat);
+    const own = try gpa.create(Owner);
+    errdefer gpa.destroy(own);
+    var stream = try cuda.Stream.init(d, false);
+    errdefer stream.deinit();
+    own.* = .{ .gpa = gpa, .stream = stream, .cfg = c, .comm = undefined, .pool = .{ .d = d, .stream = stream }, .loaded = undefined, .group = .{ .lib = lib.*, .comm = comm, .rank = rank, .world = world }, .forward = undefined, .download = .{ .d = d, .stream = stream }, .drawer = undefined };
+    var one = try cuda.DeviceBuffer.alloc(d, 8);
+    errdefer one.free();
+    own.comm = .{ .d = d, .lib = lib, .comm = comm, .stream = stream, .rank = rank, .world = world, .one = one, .group = &own.group };
+    const fp = ranks.Fingerprint.of(.{ .rank = rank, .world = world }, o.settings, o.capacity, ranks.hashBytes(text), quant, try hashFile(a, io, "/proc/self/exe"), digest);
+    try agreeFingerprints(gpa, own.comm.interface(), fp);
+    if (!ops.available()) return error.ForwardNotBuilt; // the weights are not read for a build that cannot run them
+    own.loaded = try weights_device.loadWeights(gpa, io, d, stream, checkpoint, &own.cfg, share, o.settings.layers);
+    errdefer own.loaded.deinit();
+    own.forward = try ops.openOps(.{ .gpa = gpa, .io = io, .d = d, .ctx = ctx, .stream = stream, .cfg = &own.cfg, .share = share, .weights = &own.loaded.weights, .settings = o.settings, .place = .{ .rank = rank, .world = world }, .capacity = o.capacity, .lib = lib, .comm = comm, .group = &own.group });
+    errdefer own.forward.vtable.deinit(own.forward.ptr);
+    const spans = try a.alloc(shard.Span, world);
+    for (spans, 0..) |*sp, q| sp.* = (try shard.Share.of(&c, q, world)).vocab;
+    own.drawer = try draw.HostDrawer.init(gpa, rank, spans, c.vocab, own.download.fetch());
+    errdefer own.drawer.deinit();
+    const e = try engine.Engine.make(gpa, io, .{
+        .ops = own.forward,
+        .device = own.pool.interface(),
+        .comm = own.comm.interface(),
+        .drawer = own.drawer.drawer(),
+        .capacity = o.capacity,
+        .page_bytes = dims.pageBytes(),
+        .checkpoint_digest = digest,
+        .stream = stream,
+        .group = &own.group,
+        .close = .{ .ptr = own, .call = Owner.close },
+    });
+    try stream.synchronize();
+    return e;
+}
+
+test "NCCL defaults are set only where the environment leaves them unset" {
+    const Env = struct {
+        var set_names: [3]?[:0]const u8 = .{ null, null, null };
+        var n: usize = 0;
+        fn get(name: [*:0]const u8) ?[*:0]const u8 {
+            if (std.mem.eql(u8, std.mem.span(name), "NCCL_CUMEM_ENABLE")) return "1"; // the operator chose
+            return null;
+        }
+        fn set(name: [*:0]const u8, value: [*:0]const u8) void {
+            std.testing.expectEqualStrings("0", std.mem.span(value)) catch unreachable;
+            set_names[n] = std.mem.span(name);
+            n += 1;
+        }
+    };
+    applyNcclDefaults(Env.get, Env.set);
+    try std.testing.expectEqual(@as(usize, 2), Env.n);
+    try std.testing.expectEqualStrings("NCCL_RUNTIME_CONNECT", Env.set_names[0].?);
+    try std.testing.expectEqualStrings("NCCL_CUMEM_HOST_ENABLE", Env.set_names[1].?);
+}
diff --git a/zig/src/families/minimax_m3/engine_fake.zig b/zig/src/families/minimax_m3/engine_fake.zig
new file mode 100644
index 0000000..8e9aa8f
--- /dev/null
+++ b/zig/src/families/minimax_m3/engine_fake.zig
@@ -0,0 +1,291 @@
+//! Recording fakes for the engine's tests: KV rows are the tokens, so a wrong page, slot or position changes the draw.
+const std = @import("std");
+const lanes = @import("lanes");
+const kv = @import("core").kv_pool;
+const iface = @import("iface.zig");
+const engine = @import("engine.zig");
+const ops = @import("engine_ops.zig");
+const follow = @import("follow.zig");
+const backend = @import("backend.zig");
+const pages_mod = @import("pages.zig");
+const pool = @import("pool.zig");
+
+const fake = lanes.fake;
+const none: u32 = 0xffff_ffff;
+
+pub const Run = struct { kind: ops.Rows, ids: []u32, segs: []iface.Seg, starts: []u32 };
+const RowRef = struct { slot: u32, pos: usize };
+
+/// One rank's device, forward and collectives, all recorded.
+pub const Rank = struct {
+    gpa: std.mem.Allocator,
+    rank: usize,
+    world: usize,
+    table: []i32 = &.{},
+    kv: []u32 = &.{},
+    slots: u32 = 0,
+    max_pages: usize = 0,
+    runs: std.ArrayList(Run) = .empty,
+    rows: [3]std.ArrayList(RowRef) = @splat(.empty),
+    draws: usize = 0,
+    syncs: usize = 0,
+    inject: std.ArrayList(f64) = .empty, // rank 0: peers' gate votes, taken in order (0 when empty)
+    results: std.ArrayList(f64) = .empty, // rank 0: the gate's answers, in order
+    heard: []const f64 = &.{}, // another rank: rank 0's answers, replayed in order
+    heard_at: usize = 0,
+    peers: []const []const u8 = &.{}, // gather: the other ranks' bytes, by rank (empty: the same as ours)
+    fail_run_at: ?usize = null, // the forward with this index fails (error.FakeKernel)
+
+    pub fn deinit(r: *Rank) void {
+        for (r.runs.items) |x| {
+            r.gpa.free(x.ids);
+            r.gpa.free(x.segs);
+            r.gpa.free(x.starts);
+        }
+        r.runs.deinit(r.gpa);
+        for (&r.rows) |*l| l.deinit(r.gpa);
+        r.inject.deinit(r.gpa);
+        r.results.deinit(r.gpa);
+        r.gpa.free(r.table);
+        r.gpa.free(r.kv);
+    }
+
+    pub fn parts(r: *Rank, capacity: usize) engine.Parts {
+        return .{
+            .ops = .{ .ptr = r, .vtable = &.{ .attach = attachOps, .run = run, .logits = logits, .sync = sync, .deinit = noDeinit } },
+            .device = .{ .ptr = r, .vtable = &.{ .attach = attach, .upload = upload, .deinit = noDeinit } },
+            .comm = .{ .ptr = r, .vtable = &.{ .max_f64 = maxF64, .gather_bytes = gather, .check = check }, .rank = r.rank, .world = r.world },
+            .drawer = .{ .ptr = r, .draw_fn = drawFn },
+            .capacity = capacity,
+            .page_bytes = 1 << 20,
+        };
+    }
+
+    fn of(p: *anyopaque) *Rank {
+        return @ptrCast(@alignCast(p));
+    }
+
+    fn noDeinit(_: *anyopaque) void {}
+
+    fn attach(p: *anyopaque, slots: u32, count: usize, max_pages: usize, _: u64) anyerror!ops.PoolView {
+        const r = of(p);
+        r.gpa.free(r.table);
+        r.gpa.free(r.kv);
+        r.table = try r.gpa.alloc(i32, @as(usize, slots) * max_pages);
+        @memset(r.table, -1);
+        r.kv = try r.gpa.alloc(u32, count * pool.page_tokens);
+        @memset(r.kv, none);
+        r.slots = slots;
+        r.max_pages = max_pages;
+        return .{ .arena = 0, .page_bytes = 1 << 20, .pages = count, .table = 0, .slots = slots, .max_pages = max_pages };
+    }
+
+    fn attachOps(_: *anyopaque, _: ops.PoolView) anyerror!void {}
+
+    fn upload(p: *anyopaque, slot: u32, from: usize, entries: []const i32) anyerror!void {
+        const r = of(p);
+        if (slot >= r.slots or from + entries.len > r.max_pages) return error.FakeTable;
+        @memcpy(r.table[@as(usize, slot) * r.max_pages + from ..][0..entries.len], entries);
+    }
+
+    fn pageOf(r: *const Rank, slot: u32, pos: usize) !usize {
+        const id = r.table[@as(usize, slot) * r.max_pages + pos / pool.page_tokens];
+        if (id < 0) return error.FakeNoPage;
+        return @as(usize, @intCast(id)) * pool.page_tokens + pos % pool.page_tokens;
+    }
+
+    fn run(p: *anyopaque, f: ops.Forward) anyerror!void {
+        const r = of(p);
+        if (r.fail_run_at) |n| if (n == r.runs.items.len) return error.FakeKernel;
+        try r.runs.append(r.gpa, .{ .kind = f.kind, .ids = try r.gpa.dupe(u32, f.ids), .segs = try r.gpa.dupe(iface.Seg, f.segs), .starts = try r.gpa.dupe(u32, f.starts) });
+        const list = &r.rows[@backingInt(f.kind)];
+        list.clearRetainingCapacity();
+        for (f.segs, f.starts) |g, start| {
+            for (0..g.rows) |k| {
+                const at = try r.pageOf(g.slot, start + k);
+                r.kv[at] = f.ids[g.row0 + k];
+                if (f.kind != .prompt or k + 1 == g.rows) try list.append(r.gpa, .{ .slot = g.slot, .pos = start + k });
+            }
+        }
+    }
+
+    fn logits(_: *anyopaque, kind: ops.Rows) u64 {
+        return (@as(u64, @backingInt(kind)) + 1) << 40;
+    }
+
+    fn sync(p: *anyopaque) anyerror!void {
+        of(p).syncs += 1;
+    }
+
+    fn maxF64(p: *anyopaque, v: f64) anyerror!f64 {
+        const r = of(p);
+        if (r.rank != 0) {
+            defer r.heard_at += 1;
+            return r.heard[r.heard_at];
+        }
+        const other: f64 = if (r.inject.items.len > 0) r.inject.orderedRemove(0) else 0;
+        const out = @max(v, other);
+        try r.results.append(r.gpa, out);
+        return out;
+    }
+
+    fn gather(p: *anyopaque, mine: []const u8, out: []u8) anyerror!void {
+        const r = of(p);
+        for (0..r.world) |q| {
+            const dst = out[q * mine.len ..][0..mine.len];
+            if (q == r.rank or q >= r.peers.len) @memcpy(dst, mine) else @memcpy(dst, r.peers[q]);
+        }
+    }
+
+    fn check(_: *anyopaque) anyerror!void {}
+
+    /// Rank 0 draws as the fake target does: from the tokens in the stream's pages, keyed by position.
+    fn drawFn(p: *anyopaque, d: ops.Draw) anyerror!void {
+        const r = of(p);
+        r.draws += 1;
+        if (r.rank != 0) return;
+        const kind = (d.base >> 40) - 1;
+        std.debug.assert(d.total == r.rows[@intCast(kind)].items.len);
+        for (0..d.rows) |k| {
+            const ref = r.rows[@intCast(kind)].items[d.row0 + k];
+            var history: [1 << 14]u32 = undefined;
+            for (0..ref.pos + 1) |q| history[q] = r.kv[try r.pageOf(ref.slot, q)];
+            d.out[k] = fake.next(history[0 .. ref.pos + 1], d.rule, d.first + k);
+        }
+    }
+};
+
+/// What a rank 0 sent, in order, for a rank 1 to replay.
+pub const Tape = struct {
+    gpa: std.mem.Allocator,
+    steps: std.ArrayList(struct { h: iface.Header, ids: []u32 }) = .empty,
+    cursor: usize = 0,
+    fail_at: ?usize = null, // the send with this index fails (error.WireBroken), as a lost peer's broadcast does
+
+    pub fn deinit(t: *Tape) void {
+        for (t.steps.items) |s| t.gpa.free(s.ids);
+        t.steps.deinit(t.gpa);
+    }
+
+    pub fn wire(t: *Tape) follow.Wire {
+        return .{ .ptr = t, .vtable = &.{ .send = send, .receive = receive } };
+    }
+
+    fn send(p: *anyopaque, h: *const iface.Header, ids: []const u32) anyerror!void {
+        const t: *Tape = @ptrCast(@alignCast(p));
+        if (t.fail_at) |n| if (n == t.steps.items.len) return error.WireBroken;
+        try t.steps.append(t.gpa, .{ .h = h.*, .ids = try t.gpa.dupe(u32, ids) });
+    }
+
+    fn receive(p: *anyopaque, buf: []u32) anyerror!iface.Header {
+        const t: *Tape = @ptrCast(@alignCast(p));
+        if (t.cursor >= t.steps.items.len) return error.TapeEnd;
+        const s = t.steps.items[t.cursor];
+        if (s.ids.len > buf.len) return error.TooManyIds;
+        @memcpy(buf[0..s.ids.len], s.ids);
+        t.cursor += 1;
+        return s.h;
+    }
+
+    pub fn count(t: *const Tape, kind: iface.Kind) usize {
+        var n: usize = 0;
+        for (t.steps.items) |s| n += @intFromBool(s.h.kind == @backingInt(kind));
+        return n;
+    }
+};
+
+/// The liveness lines as counters.
+pub const Hooks = struct {
+    on: bool = true,
+    sleeps: usize = 0,
+    wakes: usize = 0,
+    ended: usize = 0,
+    failed: [4][]const u8 = undefined,
+    failures: usize = 0,
+
+    pub fn hooks(h: *Hooks) follow.Hooks {
+        return .{ .ctx = h, .live = live, .sleep = sleep, .wake = wake, .failed = failed_, .ended = ended_ };
+    }
+
+    fn of(p: *anyopaque) *Hooks {
+        return @ptrCast(@alignCast(p));
+    }
+    fn live(p: *anyopaque) bool {
+        return of(p).on;
+    }
+    fn sleep(p: *anyopaque) void {
+        of(p).sleeps += 1;
+    }
+    fn wake(p: *anyopaque) void {
+        of(p).wakes += 1;
+    }
+    fn failed_(p: *anyopaque, name: []const u8) void {
+        const h = of(p);
+        if (h.failures < h.failed.len) h.failed[h.failures] = name;
+        h.failures += 1;
+    }
+    fn ended_(p: *anyopaque) void {
+        of(p).ended += 1;
+    }
+};
+
+/// Rank 0 with its lanes backend over the page state, and a rank 1 to replay the tape on (heap: it points at itself).
+pub const World = struct {
+    gpa: std.mem.Allocator,
+    r0: Rank,
+    r1: Rank,
+    e0: *engine.Engine,
+    e1: *engine.Engine,
+    tape: Tape,
+    hooks0: Hooks = .{},
+    hooks1: Hooks = .{},
+    link0: follow.Link,
+    link1: follow.Link,
+    pg: *pages_mod.Pages,
+    lanes: backend.Lanes,
+    bits: u64 = 0,
+
+    pub fn create(gpa: std.mem.Allocator, context: usize, slots: u32, count: usize) !*World {
+        const w = try gpa.create(World);
+        errdefer gpa.destroy(w);
+        const cap = std.mem.alignForward(usize, context + iface.window_rows, pool.page_tokens);
+        w.* = .{ .gpa = gpa, .r0 = .{ .gpa = gpa, .rank = 0, .world = 2 }, .r1 = .{ .gpa = gpa, .rank = 1, .world = 2 }, .e0 = undefined, .e1 = undefined, .tape = .{ .gpa = gpa }, .link0 = undefined, .link1 = undefined, .pg = undefined, .lanes = undefined };
+        w.e0 = try engine.Engine.make(gpa, std.testing.io, w.r0.parts(cap));
+        errdefer w.e0.deinit();
+        w.e1 = try engine.Engine.make(gpa, std.testing.io, w.r1.parts(cap));
+        errdefer w.e1.deinit();
+        w.link0 = try follow.Link.init(gpa, w.tape.wire(), w.hooks0.hooks(), cap);
+        errdefer w.link0.deinit();
+        w.link1 = try follow.Link.init(gpa, w.tape.wire(), w.hooks1.hooks(), cap);
+        errdefer w.link1.deinit();
+        const max_pages = iface.maxPages(cap);
+        const layout: kv.Layout = .{ .fixed_bytes = 4 * max_pages, .token_bytes = 1024, .page_tokens = pool.page_tokens, .snap_bytes = pool.snap_bytes, .all_paged = true };
+        w.pg = try pages_mod.Pages.create(gpa, layout, slots, count, max_pages, iface.window_rows);
+        errdefer w.pg.destroy();
+        w.pg.tables.upload = w.e0.uploadHook();
+        w.lanes = .{ .gpa = gpa, .x = .{ .e = w.e0, .link = &w.link0 }, .pages = w.pg };
+        w.link0.asleep = true;
+        try w.lanes.x.attach(slots, count);
+        return w;
+    }
+
+    pub fn destroy(w: *World) void {
+        w.lanes.deinit();
+        w.pg.destroy();
+        w.link0.deinit();
+        w.link1.deinit();
+        w.e0.deinit();
+        w.e1.deinit();
+        w.tape.deinit();
+        w.r0.deinit();
+        w.r1.deinit();
+        w.gpa.destroy(w);
+    }
+
+    /// Ends the tape and runs rank 1 over it; its gate answers are rank 0's.
+    pub fn replay(w: *World) !void {
+        try w.lanes.x.end();
+        w.r1.heard = w.r0.results.items;
+        try follow.follow(w.e1, &w.link1);
+    }
+};
diff --git a/zig/src/families/minimax_m3/engine_ops.zig b/zig/src/families/minimax_m3/engine_ops.zig
new file mode 100644
index 0000000..36aea4e
--- /dev/null
+++ b/zig/src/families/minimax_m3/engine_ops.zig
@@ -0,0 +1,139 @@
+//! The seam between the engine loop (engine, follow, backend) and the forward and prompt passes (forward, prefill).
+const std = @import("std");
+const cuda = @import("cuda");
+const iface = @import("iface.zig");
+const config = @import("config.zig");
+const shard = @import("shard.zig");
+const weights = @import("weights.zig");
+const ranks = @import("ranks.zig");
+
+pub const Sampling = iface.Sampling;
+
+/// Which forward buffer holds the logits of a pass; a prompt pass keeps only its last row, at row 0.
+pub const Rows = enum { prompt, window, shared };
+
+/// One forward: `ids` are every segment's rows in order, `starts[i]` segment i's first position; no `head`: no logits.
+pub const Forward = struct { kind: Rows, ids: []const u32, segs: []const iface.Seg, starts: []const u32, head: bool = true };
+
+/// The device pool a forward reads and writes: the page arena and the int32 block table (iface decision M3).
+pub const PoolView = struct { arena: u64, page_bytes: u64, pages: usize, table: u64, slots: u32, max_pages: usize };
+
+/// What the forward and prompt passes provide; all calls come from the engine thread, in step order on every rank.
+pub const Ops = struct {
+    ptr: *anyopaque,
+    vtable: *const VTable,
+
+    pub const VTable = struct {
+        /// The pool the engine allocated (again, when `attach` is called again); no forward is in flight.
+        attach: *const fn (ptr: *anyopaque, view: PoolView) anyerror!void,
+        /// Enqueues one forward on the engine's stream; the KV rows of its ids are written at their positions.
+        run: *const fn (ptr: *anyopaque, f: Forward) anyerror!void,
+        /// Device address of the fp32 logits of the last pass of `kind`, gathered on every rank: [rank][row][slot].
+        logits: *const fn (ptr: *anyopaque, kind: Rows) u64,
+        /// Waits for every enqueued forward.
+        sync: *const fn (ptr: *anyopaque) anyerror!void,
+        deinit: *const fn (ptr: *anyopaque) void,
+    };
+
+    pub fn attach(o: Ops, view: PoolView) !void {
+        return o.vtable.attach(o.ptr, view);
+    }
+    pub fn run(o: Ops, f: Forward) !void {
+        return o.vtable.run(o.ptr, f);
+    }
+    pub fn logits(o: Ops, kind: Rows) u64 {
+        return o.vtable.logits(o.ptr, kind);
+    }
+    pub fn sync(o: Ops) !void {
+        return o.vtable.sync(o.ptr);
+    }
+};
+
+/// The ranks' collectives (NCCL in engine_dev.zig): the engine never touches the library in its own logic.
+pub const Comm = struct {
+    ptr: *anyopaque,
+    vtable: *const VTable,
+    rank: usize,
+    world: usize,
+
+    pub const VTable = struct {
+        /// The ranks' maximum of `v`, on every rank.
+        max_f64: *const fn (ptr: *anyopaque, v: f64) anyerror!f64,
+        /// Every rank's `mine` (equal lengths) in `out`, in rank order.
+        gather_bytes: *const fn (ptr: *anyopaque, mine: []const u8, out: []u8) anyerror!void,
+        /// A failed small gather's error, after a synchronize that read one.
+        check: *const fn (ptr: *anyopaque) anyerror!void,
+    };
+
+    pub fn maxF64(c: Comm, v: f64) !f64 {
+        return c.vtable.max_f64(c.ptr, v);
+    }
+    pub fn gatherBytes(c: Comm, mine: []const u8, out: []u8) !void {
+        return c.vtable.gather_bytes(c.ptr, mine, out);
+    }
+    pub fn check(c: Comm) !void {
+        return c.vtable.check(c.ptr);
+    }
+};
+
+/// A draw of rows [row0, row0 + rows) of a `total`-row pass gathered at `base`; `bits`: host address of grammar words.
+pub const Draw = struct { base: u64, total: usize, row0: usize, rows: usize, first: u64, rule: ?Sampling, bits: u64, out: []u32 };
+
+/// The token draw: rank 0 alone draws (another rank's `out` stays untouched).
+pub const Drawer = struct {
+    ptr: *anyopaque,
+    draw_fn: *const fn (ptr: *anyopaque, d: Draw) anyerror!void,
+
+    pub fn draw(r: Drawer, d: Draw) !void {
+        return r.draw_fn(r.ptr, d);
+    }
+};
+
+/// The device block table and page arena, made at `attach` (engine_dev.zig); the host fakes it with an array.
+pub const Device = struct {
+    ptr: *anyopaque,
+    vtable: *const VTable,
+
+    pub const VTable = struct {
+        /// A fresh arena of `pages` pages and a table of `slots` rows of -1, replacing any earlier ones.
+        attach: *const fn (ptr: *anyopaque, slots: u32, pages: usize, max_pages: usize, page_bytes: u64) anyerror!PoolView,
+        /// `entries` written at entry `from` of `slot`'s table row.
+        upload: *const fn (ptr: *anyopaque, slot: u32, from: usize, entries: []const i32) anyerror!void,
+        deinit: *const fn (ptr: *anyopaque) void,
+    };
+};
+
+/// What `openOps` is given: the loaded weights of this rank and the handles a forward needs.
+pub const OpenArgs = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    d: *const cuda.Driver,
+    ctx: *const cuda.Context,
+    stream: cuda.Stream,
+    cfg: *const config.Config,
+    share: shard.Share,
+    weights: *const weights.Weights,
+    settings: ranks.Settings,
+    place: ranks.Place,
+    capacity: usize,
+    lib: *const cuda.nccl.Library,
+    comm: cuda.nccl.Comm,
+    /// The ranks' group over `lib` and `comm`; the host sets its RoCE small gather (`fast`) after `openOps`.
+    group: *const cuda.tp_group.Group,
+};
+
+/// Whether forward.zig and prefill.zig are in this tree. MERGE: becomes true when `openOps` below calls them.
+pub fn available() bool {
+    return false;
+}
+
+/// MERGE POINT with branch mm3-t8a: the body becomes `return forward.open(args);` (forward.zig builds the buffers).
+pub fn openOps(args: OpenArgs) !Ops {
+    _ = args;
+    return error.ForwardNotBuilt;
+}
+
+test "the pass kinds are the three buffers a forward owns" {
+    try std.testing.expectEqual(@as(usize, 2), @backingInt(Rows.shared));
+    try std.testing.expect(!available());
+}
diff --git a/zig/src/families/minimax_m3/engine_test.zig b/zig/src/families/minimax_m3/engine_test.zig
new file mode 100644
index 0000000..9e8773f
--- /dev/null
+++ b/zig/src/families/minimax_m3/engine_test.zig
@@ -0,0 +1,275 @@
+//! Host tests of the engine and its follower: chunking, resume, windows, cancellation, rank failure, fingerprints.
+const std = @import("std");
+const lanes = @import("lanes");
+const iface = @import("iface.zig");
+const engine = @import("engine.zig");
+const follow = @import("follow.zig");
+const fakes = @import("engine_fake.zig");
+const dev = @import("engine_dev.zig");
+const ranks = @import("ranks.zig");
+const pool = @import("pool.zig");
+
+const gpa = std.testing.allocator;
+const World = fakes.World;
+
+fn prompt(n: usize, salt: u32) ![]u32 {
+    const p = try gpa.alloc(u32, n);
+    for (p, 0..) |*t, i| t.* = @intCast((i * 7 + salt) % 90);
+    return p;
+}
+
+/// A lease for `slot` as the backend takes one: pages promised, covered and written to both tables by the leader.
+fn admit(w: *World, slot: u32, n: usize) !pool_state {
+    var st: pool_state = .{ .st = .{ .slot = slot } };
+    const ids = try prompt(n, 1);
+    defer gpa.free(ids);
+    var sink = w.pg.tables.sink(slot);
+    st.marks = try w.pg.cache.admit(gpa, &st.st, ids, 0, 16, w.pg.window, sink.table(), w.pg.max_pages);
+    try w.lanes.x.bind(slot);
+    try w.lanes.x.begin(null, st.st.lease.ids.items);
+    return st;
+}
+const pool_state = struct {
+    st: @import("state.zig").Stream,
+    marks: []const u32 = &.{},
+    fn done(s: *pool_state, w: *World) void {
+        gpa.free(s.marks);
+        w.pg.cache.end(&s.st, &w.pg.tables);
+    }
+};
+
+test "a prompt crosses in chunks of at most 2048 rows and rank 1 runs the same forwards on the same pages" {
+    const w = try World.create(gpa, 6000, 2, 120);
+    defer w.destroy();
+    const ids = try prompt(5000, 3);
+    defer gpa.free(ids);
+    var s = try admit(w, 0, ids.len);
+    defer s.done(w);
+    const first = try w.lanes.x.prefill(ids, null, null, null);
+    try std.testing.expectEqual(@as(usize, 3), w.r0.runs.items.len); // 2048 + 2048 + 904
+    var at: usize = 0;
+    for (w.r0.runs.items) |r| {
+        try std.testing.expectEqualSlices(u32, ids[at..][0..r.ids.len], r.ids);
+        try std.testing.expectEqual(@as(u32, @intCast(at)), r.starts[0]);
+        try std.testing.expect(r.ids.len <= iface.prefill_rows);
+        at += r.ids.len;
+    }
+    try std.testing.expectEqual(ids.len, at);
+    try std.testing.expectEqual(ids.len, w.e0.pos());
+    try std.testing.expectEqual(lanes.fake.next(ids, null, ids.len), first); // the token the target draws after the prompt
+    try w.replay();
+    try std.testing.expectEqual(w.r0.runs.items.len, w.r1.runs.items.len);
+    for (w.r0.runs.items, w.r1.runs.items) |a, b| {
+        try std.testing.expectEqualSlices(u32, a.ids, b.ids);
+        try std.testing.expectEqualSlices(u32, a.starts, b.starts);
+        try std.testing.expectEqualSlices(iface.Seg, a.segs, b.segs);
+    }
+    try std.testing.expectEqualSlices(u32, w.r0.kv, w.r1.kv);
+    try std.testing.expectEqualSlices(i32, w.r0.table, w.r1.table);
+    try std.testing.expectEqual(w.r0.draws, w.r1.draws); // the follower sent its span for every draw
+}
+
+test "chunk and resume equivalence: any cut of the prompt, and a pass resumed from adopted pages, give the same rows and token" {
+    const w = try World.create(gpa, 6000, 2, 120);
+    defer w.destroy();
+    const ids = try prompt(4096 + 300, 5);
+    defer gpa.free(ids);
+    var whole = try admit(w, 0, ids.len);
+    defer whole.done(w);
+    const want = try w.lanes.x.prefill(ids, null, null, null);
+    // a second slot whose first 2048 rows are the first slot's pages (adopted), then the rest in cuts at 512-row marks
+    var other = try admit(w, 1, ids.len);
+    defer other.done(w);
+    const cut = [_]u32{ 2560, 3072, 4096 };
+    var calls: usize = 0;
+    const Hook = struct {
+        fn call(ctx: *anyopaque, _: u32) void {
+            @as(*usize, @ptrCast(@alignCast(ctx))).* += 1;
+        }
+    };
+    // share the first 16 pages (2048 rows) the way a resume adopts them
+    for (0..16) |i| w.pg.pages.share(&other.st.lease, i, whole.st.lease.ids.items[i]);
+    try w.pg.tables.write(1, other.st.lease.ids.items, 0);
+    try w.lanes.x.bind(1);
+    try w.lanes.x.begin(null, other.st.lease.ids.items);
+    const got = try w.lanes.x.prefill(ids, .{ .at = 2048 }, null, .{ .at = &cut, .ctx = &calls, .call = Hook.call });
+    try std.testing.expectEqual(want, got);
+    try std.testing.expectEqual(@as(usize, 3), calls); // every mark in the pass was called, once, at a chunk start
+    var rows: usize = 2048;
+    var chunks: usize = 0;
+    for (w.r0.runs.items[3..]) |r| { // the second pass starts at the resume point and covers the rest, cut at the marks
+        try std.testing.expectEqual(@as(u32, @intCast(rows)), r.starts[0]);
+        rows += r.ids.len;
+        chunks += 1;
+    }
+    try std.testing.expectEqual(ids.len, rows);
+    try std.testing.expectEqual(@as(usize, 4), chunks); // 2048..2560..3072..4096..4396: a chunk ends at each mark
+    // the pages the resumed pass read are the first slot's, so its rows are bitwise the first slot's
+    try w.replay();
+    try std.testing.expectEqualSlices(u32, w.r0.kv, w.r1.kv);
+}
+
+test "a window verifies at the committed position, keep commits the accepted rows, and shared windows keep their own pages" {
+    const w = try World.create(gpa, 2000, 3, 60);
+    defer w.destroy();
+    const a_ids = try prompt(300, 2);
+    defer gpa.free(a_ids);
+    const b_ids = try prompt(700, 9);
+    defer gpa.free(b_ids);
+    var a = try admit(w, 0, a_ids.len);
+    defer a.done(w);
+    var b = try admit(w, 1, b_ids.len);
+    defer b.done(w);
+    try w.lanes.x.bind(0);
+    const fa = try w.lanes.x.prefill(a_ids, null, null, null);
+    try w.lanes.x.bind(1);
+    const fb = try w.lanes.x.prefill(b_ids, null, null, null);
+    var pa = [_]u32{ fa, 4, 5 };
+    var pb = [_]u32{ fb, 6 };
+    var oa: [3]u32 = undefined;
+    var ob: [2]u32 = undefined;
+    try w.lanes.x.verifyShared(&.{ .{ .slot = 0, .ids = &pa, .out = &oa }, .{ .slot = 1, .ids = &pb, .out = &ob } });
+    const shared = w.r0.runs.items[w.r0.runs.items.len - 1];
+    try std.testing.expectEqual(@import("engine_ops.zig").Rows.shared, shared.kind);
+    try std.testing.expectEqualSlices(u32, &.{ 300, 700 }, shared.starts);
+    try std.testing.expectEqual(@as(u32, 3), shared.segs[1].row0);
+    // row 0 of window a is drawn after prompt + fa: the target's own function of those tokens
+    var hist: [301]u32 = undefined;
+    @memcpy(hist[0..300], a_ids);
+    hist[300] = fa;
+    try std.testing.expectEqual(lanes.fake.next(&hist, null, 301), oa[0]);
+    try w.lanes.x.bind(0);
+    try w.lanes.x.keep(2); // two of three rows accepted
+    try std.testing.expectEqual(@as(usize, 302), w.e0.pos());
+    try w.lanes.x.bind(1);
+    try std.testing.expectEqual(@as(usize, 700), w.e0.pos()); // slot 1 was not committed
+    try std.testing.expectError(error.BadKeep, w.e0.keep(5));
+    var long: [iface.window_rows + 1]u32 = @splat(1);
+    var out: [iface.window_rows + 1]u32 = undefined;
+    try std.testing.expectError(error.WindowTooWide, w.e0.verify(&long, &out, 0));
+    try w.replay();
+    try std.testing.expectEqualSlices(u32, w.r0.kv, w.r1.kv);
+}
+
+test "cancellation at a chunk gate stops every rank before the same forward" {
+    const w = try World.create(gpa, 6000, 2, 120);
+    defer w.destroy();
+    const ids = try prompt(5000, 4);
+    defer gpa.free(ids);
+    var s = try admit(w, 0, ids.len);
+    defer s.done(w);
+    const Flag = struct {
+        calls: usize = 0,
+        fn check(p: ?*anyopaque) bool {
+            const f: *@This() = @ptrCast(@alignCast(p.?));
+            f.calls += 1;
+            return f.calls > 1; // the second chunk's gate sees it
+        }
+    };
+    var flag: Flag = .{};
+    try std.testing.expectError(error.Cancelled, w.lanes.x.prefill(ids, null, .{ .ptr = &flag, .check = Flag.check }, null));
+    try std.testing.expectEqual(@as(usize, 1), w.r0.runs.items.len);
+    try std.testing.expectEqualSlices(f64, &.{ 0, 1 }, w.r0.results.items);
+    try w.lanes.x.release(0);
+    try w.replay(); // the follower hears the same answers, skips the same forward, and goes on to the release
+    try std.testing.expectEqual(@as(usize, 1), w.r1.runs.items.len);
+    try std.testing.expectEqual(@as(usize, 1), w.tape.count(.release));
+    try std.testing.expectEqual(@as(usize, 0), w.hooks1.failures);
+}
+
+test "another rank's vote cancels this rank's chunk too" {
+    const w = try World.create(gpa, 3000, 2, 60);
+    defer w.destroy();
+    const ids = try prompt(2500, 6);
+    defer gpa.free(ids);
+    var s = try admit(w, 0, ids.len);
+    defer s.done(w);
+    try w.r0.inject.append(gpa, 1); // rank 1's gate says stop
+    try std.testing.expectError(error.Cancelled, w.lanes.x.prefill(ids, null, null, null));
+    try std.testing.expectEqual(@as(usize, 0), w.r0.runs.items.len);
+}
+
+test "a follower that fails tells the others and stops; rank 0 ends cleanly when the wire breaks" {
+    {
+        const w = try World.create(gpa, 3000, 2, 60);
+        defer w.destroy();
+        const ids = try prompt(500, 1);
+        defer gpa.free(ids);
+        var s = try admit(w, 0, ids.len);
+        defer s.done(w);
+        _ = try w.lanes.x.prefill(ids, null, null, null);
+        w.r1.fail_run_at = 0; // rank 1's kernel fails on its first forward
+        try std.testing.expectError(error.FakeKernel, w.replay());
+        try std.testing.expectEqual(@as(usize, 1), w.hooks1.failures);
+        try std.testing.expectEqualStrings("FakeKernel", w.hooks1.failed[0]);
+    }
+    {
+        const w = try World.create(gpa, 3000, 2, 60);
+        defer w.destroy();
+        const ids = try prompt(500, 1);
+        defer gpa.free(ids);
+        var s = try admit(w, 0, ids.len);
+        defer s.done(w);
+        w.tape.fail_at = w.tape.steps.items.len + 1; // the chunk goes out; the next send finds rank 1 gone
+        _ = try w.lanes.x.prefill(ids, null, null, null);
+        var window = [_]u32{ 1, 2 };
+        var out: [2]u32 = undefined;
+        try std.testing.expectError(error.RankLost, w.lanes.x.verify(&window, &out, 0));
+        try std.testing.expectEqual(@as(usize, 1), w.hooks0.failures);
+        try std.testing.expectEqualStrings("WireBroken", w.hooks0.failed[0]);
+        const sent = w.tape.steps.items.len;
+        try std.testing.expectError(error.RankLost, w.lanes.x.keep(1)); // refused without touching the wire
+        try std.testing.expectError(error.RankLost, w.lanes.x.release(0));
+        try w.lanes.x.end(); // nothing to send, nothing to wait for
+        try std.testing.expectEqual(sent, w.tape.steps.items.len);
+        try std.testing.expectEqual(@as(usize, 1), w.hooks0.failures);
+    }
+}
+
+test "rank 0 wakes the sleeping ranks once, and idles them only when no stream is left" {
+    const w = try World.create(gpa, 2000, 2, 40);
+    defer w.destroy();
+    try std.testing.expectEqual(@as(usize, 1), w.hooks0.wakes); // the attach step
+    try w.lanes.x.idle();
+    try w.lanes.x.idle(); // already asleep: no second step
+    try std.testing.expectEqual(@as(usize, 1), w.tape.count(.idle) - 1);
+    const ids = try prompt(200, 1);
+    defer gpa.free(ids);
+    var s = try admit(w, 0, ids.len);
+    defer s.done(w);
+    try std.testing.expectEqual(@as(usize, 2), w.hooks0.wakes);
+    try w.replay();
+    try std.testing.expectEqual(@as(usize, 2), w.hooks1.sleeps); // at its start and at the idle step
+}
+
+test "the ranks' fingerprints are gathered as bytes and a difference refuses on every rank" {
+    var r: fakes.Rank = .{ .gpa = gpa, .rank = 0, .world = 2 };
+    const set: ranks.Settings = .{};
+    const mine = ranks.Fingerprint.of(.{ .rank = 0, .world = 2 }, set, 4096, @splat(1), @splat(2), @splat(3), @splat(4));
+    var same = mine;
+    same.rank = 1;
+    r.peers = &.{ std.mem.asBytes(&mine), std.mem.asBytes(&same) };
+    const c = r.parts(4096).comm;
+    try dev.agreeFingerprints(gpa, c, mine);
+    var other = same;
+    other.weights = @splat(9);
+    r.peers = &.{ std.mem.asBytes(&mine), std.mem.asBytes(&other) };
+    try std.testing.expectError(error.RankMismatch, dev.agreeFingerprints(gpa, c, mine));
+}
+
+test "a prompt past the capacity or a chunk off the page grid is refused by the engine" {
+    const w = try World.create(gpa, 2000, 2, 40);
+    defer w.destroy();
+    var long: [2100]u32 = @splat(1);
+    try std.testing.expectError(error.PromptTooLong, w.e0.prefill(&long, null, null, null));
+    try std.testing.expectError(error.BadResume, w.e0.prefill(long[0..300], .{ .at = 100 }, null, null));
+    try std.testing.expectError(error.BadChunk, w.e0.prefillChunk(long[0..100], 0, 300, null, null, null)); // a middle chunk off a page
+    try std.testing.expectError(error.BadChunk, w.e0.prefillChunk(long[0..100], 128, 228, null, null, null)); // not at the position
+}
+
+test "the table row bytes and chunk grid are the contract's" {
+    const w = try World.create(gpa, 2000, 2, 40);
+    defer w.destroy();
+    try std.testing.expectEqual(@as(u64, 4 * iface.maxPages(w.e0.capacity)), w.e0.seqBytes());
+    try std.testing.expect(iface.prefill_rows % pool.page_tokens == 0);
+}
