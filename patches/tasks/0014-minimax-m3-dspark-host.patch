@@ -0,0 +1,286 @@
+//! test-minimax-dspark: the pack's header and config (fixtures) against the name map, the rank plan and the budget.
+const std = @import("std");
+// The float64 forward runs on a tiny random draft (dspark_model_test.zig): no test reads the 2.3 GB of weights.
+const core = @import("core");
+// A passing test shows the code agrees with ITSELF, never that the semantics match the upstream model.
+const mr = core.minimax_ref;
+const target = @import("config.zig");
+const shard = @import("shard.zig");
+const load = @import("load.zig");
+const dc = @import("dspark_config.zig");
+const dn = @import("dspark_names.zig");
+const dl = @import("dspark_load.zig");
+const ref = @import("dspark_ref.zig");
+const twin = @import("dspark_twin.zig");
+const budget = @import("budget.zig");
+const pool = @import("pool.zig");
+
+test {
+    _ = @import("dspark_model_test.zig");
+    _ = dc;
+    _ = dn;
+    _ = ref;
+    _ = budget;
+}
+
+const gpa = std.testing.allocator;
+
+// ---- the pack's real header: names, shapes, cuts -----------------------------------------------------------------
+
+const header_json = @embedFile("fixtures/dspark_header.json");
+const header_data_len: usize = 2_301_852_674; // model.safetensors.index.json total_size
+
+fn catalog() !load.Catalog {
+    var cat = load.Catalog.init(gpa);
+    errdefer cat.deinit();
+    try dl.addHeader(&cat, 0, header_json, header_data_len);
+    return cat;
+}
+
+fn catalogWith(from: []const u8, to: []const u8) !load.Catalog {
+    const json = try std.mem.replaceOwned(u8, gpa, header_json, from, to);
+    defer gpa.free(json);
+    try std.testing.expect(!std.mem.eql(u8, json, header_json));
+    var cat = load.Catalog.init(gpa);
+    errdefer cat.deinit();
+    try dl.addHeader(&cat, 0, json, header_data_len);
+    return cat;
+}
+
+test "the header has the 97 tensors the name map says, every one a role, nothing else" {
+    var cat = try catalog();
+    defer cat.deinit();
+    try std.testing.expectEqual(@as(usize, 97), cat.map.count());
+    var plain: usize = 0;
+    var lin: usize = 0;
+    var it = cat.map.iterator();
+    while (it.next()) |kv| {
+        const n = dn.parse(kv.key_ptr.*) orelse return error.UnknownTensor;
+        switch (n.what) {
+            .plain => |p| {
+                plain += 1;
+                try std.testing.expectEqual(st_bf16, kv.value_ptr.dtype);
+                _ = p;
+            },
+            .lin => |l| {
+                lin += 1;
+                try std.testing.expectEqual(if (l.part == .weight) core.safetensors.DType.f8_e4m3 else core.safetensors.DType.u8, kv.value_ptr.dtype);
+            },
+        }
+    }
+    try std.testing.expectEqual(@as(usize, 27), plain); // 7 global + 5 x 4 per layer
+    try std.testing.expectEqual(@as(usize, 70), lin); // 5 layers x 7 linears x (codes, scales)
+}
+const st_bf16 = core.safetensors.DType.bf16;
+
+fn share(rank: usize, world: usize) !shard.Share {
+    return shard.Share.of(&target.flash, rank, world);
+}
+
+test "the plan for one rank and for two: bytes equal the arithmetic of dspark_config" {
+    const c = dc.flash;
+    for ([_]usize{ 1, 2 }) |world| for (0..world) |rank| {
+        var cat = try catalog();
+        defer cat.deinit();
+        var plan = try dl.Plan.build(gpa, &cat, &c, try share(rank, world), .{});
+        defer plan.deinit();
+        const want = dc.rankWeights(&c, try share(rank, world), false);
+        try std.testing.expectEqual(want.total(), plan.slotBytes());
+        try std.testing.expectEqual(@as(usize, 35), plan.mats.len);
+        try std.testing.expectEqual(@as(usize, 27), plan.plain.len);
+        try std.testing.expectEqual(@as(usize, 0), plan.ignored);
+        // the item runs read exactly the slot bytes, none twice
+        var read: u64 = 0;
+        for (plan.items) |i| read += i.span.bytes();
+        try std.testing.expectEqual(plan.slotBytes(), read);
+    };
+}
+
+test "two ranks' runs tile every tensor exactly once; replicated tensors are read whole by both" {
+    const c = dc.flash;
+    var cat = try catalog();
+    defer cat.deinit();
+    var plans: [2]dl.Plan = undefined;
+    for (&plans, 0..) |*p, r| p.* = try dl.Plan.build(gpa, &cat, &c, try share(r, 2), .{});
+    defer for (&plans) |*p| p.deinit();
+    // each tensor's runs of both ranks sorted: cut tensors abut exactly, replicated ones are two whole copies
+    var by_base: std.AutoHashMapUnmanaged(u64, std.ArrayList([2]u64)) = .empty;
+    defer {
+        var vit = by_base.valueIterator();
+        while (vit.next()) |v| v.deinit(gpa);
+        by_base.deinit(gpa);
+    }
+    for (plans) |p| for (p.items) |i| {
+        const e = try by_base.getOrPut(gpa, i.base);
+        if (!e.found_existing) e.value_ptr.* = .empty;
+        for (0..i.span.count) |n| try e.value_ptr.append(gpa, .{ i.span.at(n), i.span.at(n) + i.span.len });
+    };
+    var it = cat.map.iterator();
+    while (it.next()) |kv| {
+        const runs = by_base.getPtr(kv.value_ptr.begin) orelse return error.TensorNotRead;
+        std.mem.sort([2]u64, runs.items, {}, struct {
+            fn less(_: void, a: [2]u64, b: [2]u64) bool {
+                return a[0] < b[0];
+            }
+        }.less);
+        const n = dn.parse(kv.key_ptr.*).?;
+        const whole = n.what == .plain and (n.what.plain != .fc or true); // plain tensors are replicated
+        if (whole) {
+            // two identical copies of [0, len)
+            try std.testing.expectEqual(@as(usize, 2), runs.items.len);
+            for (runs.items) |r| try std.testing.expectEqual([2]u64{ 0, kv.value_ptr.len }, r);
+        } else {
+            var at: u64 = 0;
+            for (runs.items) |r| {
+                try std.testing.expectEqual(at, r[0]);
+                at = r[1];
+            }
+            try std.testing.expectEqual(kv.value_ptr.len, at);
+        }
+    }
+}
+
+test "the cuts: q 4096 rows, kv 256, o and down input halves, gate/up 6144 rows; scales follow in 32s" {
+    const c = dc.flash;
+    var cat = try catalog();
+    defer cat.deinit();
+    var plan = try dl.Plan.build(gpa, &cat, &c, try share(1, 2), .{});
+    defer plan.deinit();
+    const want = [_]struct { p: dn.Lin, n: u32, k: u32 }{
+        .{ .p = .q, .n = 4096, .k = 6144 },
+        .{ .p = .k, .n = 256, .k = 6144 },
+        .{ .p = .v, .n = 256, .k = 6144 },
+        .{ .p = .o, .n = 6144, .k = 4096 },
+        .{ .p = .gate, .n = 6144, .k = 6144 },
+        .{ .p = .up, .n = 6144, .k = 6144 },
+        .{ .p = .down, .n = 6144, .k = 6144 },
+    };
+    for (want) |w| {
+        const m = plan.mat(w.p, 4).?;
+        try std.testing.expectEqual(w.n, m.n);
+        try std.testing.expectEqual(w.k, m.k);
+        try std.testing.expectEqual(@as(u64, w.n) * w.k, plan.slots[m.codes].bytes);
+        try std.testing.expectEqual(@as(u64, w.n) * w.k / 32, plan.slots[m.scales].bytes);
+    }
+    // rank 1's o_proj: columns [4096, 8192) of every row, 6144 runs a row apart (scale runs: 128 bytes)
+    var runs: usize = 0;
+    for (plan.items) |i| if (i.slot == plan.mat(.o, 0).?.codes) {
+        try std.testing.expectEqual(@as(u64, 4096), i.span.offset);
+        try std.testing.expectEqual(@as(u64, 4096), i.span.len);
+        try std.testing.expectEqual(@as(u64, 8192), i.span.stride);
+        try std.testing.expectEqual(@as(u64, 6144), i.span.count);
+        runs += 1;
+    };
+    try std.testing.expectEqual(@as(usize, 1), runs);
+    // the Markov tables whole by default, by the head's vocabulary units when asked
+    try std.testing.expectEqual(@as(u32, 200064), plan.tensor(.markov_w1, 0).?.rows);
+    var cut = try dl.Plan.build(gpa, &cat, &c, try share(1, 2), .{ .markov_cut = true });
+    defer cut.deinit();
+    try std.testing.expectEqual(@as(u32, 781 * 128), cut.tensor(.markov_w2, 0).?.rows);
+    // nothing is folded: the norms are stored as they are (the Gemma offset is an unverified switch)
+    for (plan.items) |i| try std.testing.expect(!i.fold);
+}
+
+test "a missing, misshaped, retyped or extra tensor refuses the plan" {
+    const c = dc.flash;
+    const s = try share(0, 2);
+    {
+        var cat = try catalogWith("language_model.model.dspark.fc.weight", "language_model.model.dspark.fx.weight");
+        defer cat.deinit();
+        try std.testing.expectError(error.MissingTensor, dl.Plan.build(gpa, &cat, &c, s, .{}));
+    }
+    {
+        // codes retyped to e5m2 (same size)
+        var cat = try catalogWith("layers.2.decoder_layer.mlp.up_proj.weight\":{\"dtype\":\"F8_E4M3\"", "layers.2.decoder_layer.mlp.up_proj.weight\":{\"dtype\":\"F8_E5M2\"");
+        defer cat.deinit();
+        try std.testing.expectError(error.MisshapedTensor, dl.Plan.build(gpa, &cat, &c, s, .{}));
+    }
+    {
+        // scales retyped to i8
+        var cat = try catalogWith("layers.4.decoder_layer.mlp.up_proj.weight_scale_inv\":{\"dtype\":\"U8\"", "layers.4.decoder_layer.mlp.up_proj.weight_scale_inv\":{\"dtype\":\"I8\"");
+        defer cat.deinit();
+        try std.testing.expectError(error.MisshapedTensor, dl.Plan.build(gpa, &cat, &c, s, .{}));
+    }
+    {
+        // a tensor of the draft's namespace no role names (the draft has no head of its own)
+        var cat = try catalog();
+        defer cat.deinit();
+        try cat.add("language_model.model.dspark.lm_head.weight", .{ .shard = 0, .dtype = .bf16, .rank = 1, .shape = .{ 1, 1, 1, 1, 1 }, .begin = 0, .len = 2 });
+        try std.testing.expectError(error.UnexpectedTensor, dl.Plan.build(gpa, &cat, &c, s, .{}));
+    }
+    {
+        // a tensor of another namespace is ignored, not refused
+        var cat = try catalog();
+        defer cat.deinit();
+        try cat.add("language_model.model.layers.0.input_layernorm.weight", .{ .shard = 0, .dtype = .bf16, .rank = 1, .shape = .{ 6144, 1, 1, 1, 1 }, .begin = 0, .len = 12288 });
+        var plan = try dl.Plan.build(gpa, &cat, &c, s, .{});
+        defer plan.deinit();
+        try std.testing.expectEqual(@as(usize, 1), plan.ignored);
+    }
+}
+
+// ---- the float8 decode against TensorFold's own codec ----------------------------------------------------------
+
+test "e4m3 and ue8m0 equal TensorFold's codec for every byte" {
+    const codec = core.exlr8.codec;
+    for (0..256) |i| {
+        const code: u8 = @intCast(i);
+        const mine = ref.e4m3(code);
+        const theirs: f64 = codec.e4m3Value(code);
+        if (std.math.isNan(theirs)) try std.testing.expect(std.math.isNan(mine)) else try std.testing.expectEqual(theirs, mine);
+        // exlr8_dense.zig dequantizes an mxfp8 scale as ldexp(1, byte - 127); the NaN byte is qmmf.cu's
+        if (i < 255) try std.testing.expectEqual(std.math.ldexp(@as(f64, 1), @as(i32, @intCast(i)) - 127), ref.ue8m0(code, 127));
+    }
+    try std.testing.expect(std.math.isNan(ref.ue8m0(255, 127)));
+}
+
+// ---- memory: what the draft adds to a rank's budget -----------------------------------------------------------------
+
+test "budget: the draft takes its weights and runtime before any KV and a ring a stream; the refusal names it" {
+    const c = dc.flash;
+    const s = try share(0, 2);
+    const dims = try pool.Dims.of(&target.flash, s);
+    const total: u64 = 119 * budget.GiB; // assumed GB10 memory; the real number is measured at start-up
+    const plain = try budget.tensorfold(total, null);
+    const cost = dc.cost(&c, s, 16, 2048, false);
+    const drafted = budget.withDraft(plain, cost);
+    var in: budget.Input = .{ .available = total, .weights = 91 * budget.GiB, .terms = plain };
+    var in_d = in;
+    in_d.terms = drafted;
+    const without = budget.check(dims, in, null).ok;
+    const with = budget.check(dims, in_d, null).ok;
+    // the draft costs weights + runtime + one stream's ring and scratch, which the pool gives up in whole pages
+    const spent = cost.weights + cost.runtime + cost.per_lane;
+    const lost = (without.pool_tokens - with.pool_tokens) * dims.tokenBytes();
+    // (whole pages, and the score chunk shrinks with the shorter context: a few pages of slack either way)
+    try std.testing.expect(@abs(@as(i64, @intCast(lost)) - @as(i64, @intCast(spent))) <= @as(i64, @intCast(3 * dims.pageBytes())));
+    try std.testing.expect(with.context < without.context);
+    try std.testing.expectEqual(spent, budget.draftBytes(drafted, 1));
+    try std.testing.expectEqual(@as(u64, 0), budget.draftBytes(plain, 4));
+    // a context that fit without the draft but not with it is refused with the draft named
+    in_d.weights = 106 * budget.GiB;
+    in.weights = 106 * budget.GiB;
+    const lone = budget.check(dims, in, null);
+    switch (lone) {
+        .ok => |cap| {
+            const asked = cap.context;
+            const verdict = budget.check(dims, in_d, asked);
+            if (verdict == .refused) {
+                const text = try budget.refusalText(gpa, verdict.refused);
+                defer gpa.free(text);
+                try std.testing.expect(std.mem.indexOf(u8, text, "the dspark draft takes") != null);
+                try std.testing.expect(std.mem.indexOf(u8, text, "serve without --drafter") != null);
+            } else return error.DraftCostNothing;
+        },
+        .refused => {},
+    }
+    // lanes: each extra stream adds its ring
+    var four = in_d;
+    four.lanes = 4;
+    try std.testing.expectEqual(cost.weights + cost.runtime + 4 * cost.per_lane, budget.draftBytes(four.terms, 4));
+}
+
+test "the draft's recipe-facing words" {
+    try std.testing.expect(std.mem.indexOf(u8, dc.drafter_refusal, "no MTP head") != null);
+    try std.testing.expect(std.mem.indexOf(u8, dc.drafter_refusal, "docs/dspark-plan.md") != null);
+}
diff --git a/zig/src/families/minimax_m3/dspark_twin.zig b/zig/src/families/minimax_m3/dspark_twin.zig
new file mode 100644
index 0000000..229c2de
--- /dev/null
+++ b/zig/src/families/minimax_m3/dspark_twin.zig
@@ -0,0 +1,252 @@
+//! Host twins of the draft's planned engine layout, each with planted mutants (like tests/minimax_*_twin.zig).
+const std = @import("std");
+// The K/V ring the engine would keep, the two-rank tensor-parallel block, and the per-rank candidate gather.
+const core = @import("core");
+// dspark_model_test.zig runs each clean twin against dspark_ref.zig and requires every mutant to be caught.
+const mr = core.minimax_ref;
+const ref = @import("dspark_ref.zig");
+
+// ---- the context ring ---------------------------------------------------------------------------------------------
+
+pub const RingMutant = enum {
+    none,
+    short_ring, // six rows too few: the oldest rows the window still sees are gone
+    rope_at_slot, // K rotated by the ring slot, not the token position
+    stale_slot, // a slot already written is never overwritten after the ring wraps
+    drop_last_absorb, // the newest absorbed row is not stored
+};
+
+/// The engine's per-stream context: the draft layers' K/V of the last `cap` positions at slot (position mod cap).
+pub const Ring = struct {
+    d: *const ref.Draft,
+    cap: usize,
+    k: [][]f64,
+    v: [][]f64,
+    end: usize = 0, // next position to absorb
+    m: RingMutant,
+
+    pub fn init(a: std.mem.Allocator, d: *const ref.Draft, cap: usize, m: RingMutant) !Ring {
+        const c = d.cfg;
+        const eff = if (m == .short_ring) cap - 6 else cap;
+        const k = try a.alloc([]f64, c.layers);
+        const v = try a.alloc([]f64, c.layers);
+        for (k, v) |*kk, *vv| {
+            kk.* = try a.alloc(f64, eff * c.kvw());
+            vv.* = try a.alloc(f64, eff * c.kvw());
+            @memset(kk.*, 0);
+            @memset(vv.*, 0);
+        }
+        return .{ .d = d, .cap = eff, .k = k, .v = v, .m = m };
+    }
+
+    /// Takes the tapped row of position `end` (positions are absorbed in order, as the verify keeps them).
+    pub fn absorb(r: *Ring, a: std.mem.Allocator, feats: []const f64, last: bool) !void {
+        const c = r.d.cfg;
+        const pos = r.end;
+        r.end += 1;
+        if (last and r.m == .drop_last_absorb) return;
+        const slot = pos % r.cap;
+        if (r.m == .stale_slot and pos >= r.cap) return;
+        const st = try a.alloc(f64, c.hidden);
+        defer a.free(st);
+        try ref.contextState(r.d, a, feats, st);
+        for (0..c.layers) |l| {
+            const rope_pos = if (r.m == .rope_at_slot) slot else pos;
+            try ref.contextKv(r.d, a, l, st, rope_pos, r.k[l][slot * c.kvw() ..][0..c.kvw()], r.v[l][slot * c.kvw() ..][0..c.kvw()]);
+        }
+    }
+
+    /// The valid rows as a Ctx in position order (what the attention kernel walks through the ring's slot list).
+    pub fn ctx(r: *const Ring, a: std.mem.Allocator) !ref.Ctx {
+        const c = r.d.cfg;
+        const n = @min(r.end, r.cap);
+        const first = r.end - n;
+        const cx = try ref.Ctx.alloc(a, c, first, n);
+        for (0..n) |j| {
+            const slot = (first + j) % r.cap;
+            for (0..c.layers) |l| {
+                @memcpy(cx.k[l][j * c.kvw() ..][0..c.kvw()], r.k[l][slot * c.kvw() ..][0..c.kvw()]);
+                @memcpy(cx.v[l][j * c.kvw() ..][0..c.kvw()], r.v[l][slot * c.kvw() ..][0..c.kvw()]);
+            }
+        }
+        return cx;
+    }
+};
+
+// ---- two-rank tensor parallel block -----------------------------------------------------------------------------
+
+pub const TpMutant = enum {
+    none,
+    drop_last_head, // the last rank's last query head is not computed
+    swap_kv_groups, // the last rank reads the first rank's kv group
+    ffn_overlap, // the last rank's FFN cut starts one row early
+    drop_exchange, // only rank 0's attention partial is added
+};
+
+/// blockForward as `world` ranks run it: kv groups, their query heads and FFN rows cut; partials added in rank order.
+pub fn blockForwardTp(d: *const ref.Draft, a: std.mem.Allocator, cx: *const ref.Ctx, anchor: usize, p: usize, world: usize, m: TpMutant) !ref.Block {
+    const c = d.cfg;
+    const sw = c.sw;
+    const hd = c.head_dim;
+    const kvw = c.kvw();
+    const nb = c.block;
+    const rep = c.rep();
+    const groups = c.n_kv / world;
+    const ffn_cut = c.ffn / world;
+    const h = try a.alloc(f64, nb * c.hidden);
+    for (0..nb) |i| {
+        const tok = if (i == 0) anchor else c.mask_token;
+        @memcpy(h[i * c.hidden ..][0..c.hidden], d.embed[tok * c.hidden ..][0..c.hidden]);
+    }
+    const x = try a.alloc(f64, c.hidden);
+    const scale = std.math.pow(f64, @floatFromInt(hd), -0.5);
+    for (d.layers, 0..) |ly, l| {
+        // attention: every rank computes its own heads for every row, then the partial o_proj sums are exchanged
+        const part = try a.alloc(f64, world * nb * c.hidden);
+        @memset(part, 0);
+        for (0..world) |r| {
+            var g0 = r * groups;
+            if (m == .swap_kv_groups and r == world - 1) g0 = 0;
+            const own_q0 = r * groups * rep; // the q heads this rank multiplies o_proj columns for
+            var nq = groups * rep;
+            if (m == .drop_last_head and r == world - 1) nq -= 1;
+            const q = try a.alloc(f64, nb * nq * hd);
+            const kb = try a.alloc(f64, nb * groups * hd);
+            const vb = try a.alloc(f64, nb * groups * hd);
+            for (0..nb) |i| {
+                ref.norm(c, h[i * c.hidden ..][0..c.hidden], ly.input_norm, sw.base.gemma_layer_norms, x);
+                const pos = if (sw.block_positions == .consecutive) p + i else p;
+                const qi = q[i * nq * hd ..][0 .. nq * hd];
+                ly.q.applyRows(own_q0 * hd, (own_q0 + nq) * hd, x, qi);
+                ly.k.applyRows(g0 * hd, (g0 + groups) * hd, x, kb[i * groups * hd ..][0 .. groups * hd]);
+                ly.v.applyRows(g0 * hd, (g0 + groups) * hd, x, vb[i * groups * hd ..][0 .. groups * hd]);
+                for ([_][]f64{ qi, kb[i * groups * hd ..][0 .. groups * hd], vb[i * groups * hd ..][0 .. groups * hd] }) |t| mr.roundAll(sw.base.bf16_proj_out, t);
+                ref.heads(c, qi, nq, ly.q_norm, pos);
+                ref.heads(c, kb[i * groups * hd ..][0 .. groups * hd], groups, ly.k_norm, pos);
+            }
+            const attn = try a.alloc(f64, nb * nq * hd);
+            for (0..nb) |i| {
+                const rp = if (sw.block_positions == .consecutive) p + i else p;
+                for (0..nq) |hh| {
+                    const g = hh / rep; // the rank-local kv group
+                    const qh = q[(i * nq + hh) * hd ..][0..hd];
+                    const total = cx.n + nb;
+                    const s = try a.alloc(f64, total);
+                    var best: f64 = -std.math.inf(f64);
+                    for (0..total) |j| {
+                        s[j] = -std.math.inf(f64);
+                        var key: []const f64 = undefined;
+                        if (j < cx.n) {
+                            if (!ref.sees(sw, c.window, cx.first + j, rp, p)) continue;
+                            key = cx.k[l][j * kvw + (g0 + g) * hd ..][0..hd];
+                        } else {
+                            const mm = j - cx.n;
+                            if (sw.block_attention == .causal and mm > i) continue;
+                            key = kb[mm * groups * hd + g * hd ..][0..hd];
+                        }
+                        var dot: f64 = 0;
+                        for (qh, key) |u, w| dot += u * w;
+                        s[j] = dot * scale;
+                        best = @max(best, s[j]);
+                    }
+                    var z: f64 = 0;
+                    const out = attn[(i * nq + hh) * hd ..][0..hd];
+                    @memset(out, 0);
+                    for (0..total) |j| {
+                        if (s[j] == -std.math.inf(f64)) continue;
+                        const w = @exp(s[j] - best);
+                        z += w;
+                        const val = if (j < cx.n) cx.v[l][j * kvw + (g0 + g) * hd ..][0..hd] else vb[(j - cx.n) * groups * hd + g * hd ..][0..hd];
+                        for (out, val) |*o, vv| o.* += w * vv;
+                    }
+                    for (out) |*o| o.* /= z;
+                }
+            }
+            mr.roundAll(sw.base.bf16_attn_out, attn);
+            for (0..nb) |i| ly.o.applyCols(own_q0 * hd, attn[i * nq * hd ..][0 .. nq * hd], part[(r * nb + i) * c.hidden ..][0..c.hidden]);
+        }
+        // exchange: partials added in rank order 0 then 1, every rank holds the same sum
+        for (0..nb) |i| {
+            const hi = h[i * c.hidden ..][0..c.hidden];
+            for (0..c.hidden) |e| {
+                var s: f64 = 0;
+                for (0..world) |r| {
+                    if (m == .drop_exchange and r != 0) continue;
+                    s += part[(r * nb + i) * c.hidden + e];
+                }
+                hi[e] = mr.round16(sw.base.bf16_residual, hi[e] + s);
+            }
+        }
+        // FFN
+        @memset(part, 0);
+        for (0..world) |r| {
+            var lo = r * ffn_cut;
+            if (m == .ffn_overlap and r == world - 1) lo -= 1;
+            const hi_row = (r + 1) * ffn_cut;
+            const g = try a.alloc(f64, hi_row - lo);
+            const u = try a.alloc(f64, hi_row - lo);
+            for (0..nb) |i| {
+                ref.norm(c, h[i * c.hidden ..][0..c.hidden], ly.post_norm, sw.base.gemma_layer_norms, x);
+                ly.gate.applyRows(lo, hi_row, x, g);
+                ly.up.applyRows(lo, hi_row, x, u);
+                for (g, u) |*gv, uv| gv.* = mr.round16(sw.base.bf16_act_out, mr.swigluoai(gv.*, uv, c.alpha, c.limit, sw.base));
+                ly.down.applyCols(lo, g, part[(r * nb + i) * c.hidden ..][0..c.hidden]);
+            }
+        }
+        for (0..nb) |i| {
+            const hi = h[i * c.hidden ..][0..c.hidden];
+            for (0..c.hidden) |e| {
+                var s: f64 = 0;
+                for (0..world) |r| s += part[(r * nb + i) * c.hidden + e];
+                hi[e] = mr.round16(sw.base.bf16_residual, hi[e] + s);
+            }
+        }
+    }
+    const post = try a.alloc(f64, nb * c.hidden);
+    for (0..nb) |i| ref.norm(c, h[i * c.hidden ..][0..c.hidden], d.final_norm, sw.gemma_final_norm, post[i * c.hidden ..][0..c.hidden]);
+    return .{ .pre = h, .post = post };
+}
+
+// ---- the head's per-rank candidates -----------------------------------------------------------------------------
+
+pub const GatherMutant = enum {
+    none,
+    drop_last_rank, // the last rank's candidates never arrive
+    ids_not_offset, // a rank's local candidate ids are not moved to global ids
+    first_lowest, // the merge keeps the first of equal values instead of the lowest id
+};
+
+/// One pick as the engine makes it: per-rank top `per` base logits gathered, Markov bias on the gathered ids only.
+pub fn gatherPick(d: *const ref.Draft, base: []const f64, prev: ?usize, world: usize, per: usize, m: GatherMutant, a: std.mem.Allocator) !usize {
+    const c = d.cfg;
+    const slice = c.vocab / world;
+    var ids: std.ArrayList(usize) = .empty;
+    defer ids.deinit(a);
+    for (0..world) |r| {
+        if (m == .drop_last_rank and r == world - 1) continue;
+        const lo = r * slice;
+        const taken = try a.alloc(bool, slice);
+        defer a.free(taken);
+        @memset(taken, false);
+        for (0..per) |_| {
+            var top: ?usize = null;
+            for (0..slice) |i| {
+                if (taken[i]) continue;
+                if (top == null or base[lo + i] > base[lo + top.?]) top = i;
+            }
+            taken[top.?] = true;
+            try ids.append(a, if (m == .ids_not_offset) top.? else lo + top.?);
+        }
+    }
+    var best: ?usize = null;
+    var bz: f64 = 0;
+    for (ids.items) |id| {
+        const z = base[id] + if (prev) |pv| ref.markovBias(d, pv, id) else 0;
+        const better = best == null or z > bz or (z == bz and m != .first_lowest and id < best.?);
+        if (better) {
+            best = id;
+            bz = z;
+        }
+    }
+    return best.?;
+}
