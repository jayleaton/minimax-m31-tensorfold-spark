+    umbrella.dependOn(&run.step);
+}
diff --git a/zig/src/families/minimax_m3/forward.zig b/zig/src/families/minimax_m3/forward.zig
new file mode 100644
index 0000000..d0e9477
--- /dev/null
+++ b/zig/src/families/minimax_m3/forward.zig
@@ -0,0 +1,112 @@
+//! MiniMax-M3.1-Flash's forward on CUDA (plan T8a): decode, verify and shared windows, prompt chunks; UNEXERCISED.
+const std = @import("std");
+const cuda = @import("cuda");
+const plan = @import("forward_plan.zig");
+const exec = @import("forward_exec.zig");
+const iface = @import("iface.zig");
+const weights = @import("weights.zig");
+const rows_cfg = @import("rows.zig");
+const Config = @import("config.zig").Config;
+const rk = cuda.minimax_m3_rows;
+
+pub const Geometry = plan.Geometry;
+pub const Modules = exec.Modules;
+pub const Buffers = exec.Buffers;
+pub const Link = exec.Link;
+pub const Pages = exec.Pages;
+pub const Head = plan.Head;
+pub const HeadMode = plan.HeadMode;
+pub const Error = error{ BadCall, BadCommit };
+
+/// One forward call: the ids of its rows and where they sit.
+pub const Call = struct {
+    ids: []const i32,
+    slot: u32 = 0, // one stream: its slot, the position of its first row
+    pos0: u32 = 0,
+    segs: []const iface.Seg = &.{}, // several streams' windows, rows in order (empty: one stream)
+    positions: []const i32 = &.{}, // shared: the position of every row
+    prompt: bool = false, // a prompt chunk: prompt kernels, one row of logits at most
+    head: Head = .all,
+    mode: HeadMode = .gather,
+};
+
+/// Where a call left the head: `rows` rows of logits ([rank][row][slot] fp32 once gathered) or (logit, id) pairs.
+pub const Out = struct { rows: u32, slot: u32, world: u32, picks: bool };
+
+fn maxOf(xs: []const i32) u32 {
+    var m: i32 = 0;
+    for (xs) |x| m = @max(m, x);
+    return @intCast(m);
+}
+
+pub const Forward = struct {
+    dev: exec.Device,
+    tab: []i32, // host copy of a shared window's per-row table offsets
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, st: cuda.Stream, m: *Modules, w: *const weights.Weights, g: *const Geometry, b: *Buffers, pages: Pages, link: ?Link) !Forward {
+        const c = g.cfg;
+        const o = try rows_cfg.opts(.{}, .{ .rot = c.rotary_dim, .theta = c.rope_theta, .eps = c.eps }, .folded, .folded, true);
+        return .{
+            .dev = .{ .d = d, .st = st, .m = m, .w = w, .g = g, .b = b, .pages = pages, .link = link, .opts = o },
+            .tab = try gpa.alloc(i32, iface.shared_rows),
+        };
+    }
+
+    pub fn deinit(f: *Forward, gpa: std.mem.Allocator) void {
+        gpa.free(f.tab);
+        f.* = undefined;
+    }
+
+    /// The call's Shape: rows, kind and the largest position the scoring grid must cover.
+    pub fn shape(c: Call) Error!plan.Shape {
+        const n: u32 = @intCast(c.ids.len);
+        const shared = c.segs.len > 0;
+        if (n == 0 or (shared and (c.prompt or c.positions.len != n))) return error.BadCall;
+        var rows: u32 = 0;
+        for (c.segs) |s| rows += s.rows;
+        if (shared and rows != n) return error.BadCall;
+        const last = if (shared) maxOf(c.positions) else c.pos0 + n - 1;
+        return .{ .rows = n, .prompt = c.prompt, .shared = shared, .max_pos = last, .head = c.head, .mode = c.mode };
+    }
+
+    /// The ids (and a shared window's positions and table offsets) go to the device; the ops are queued on the stream.
+    pub fn run(f: *Forward, c: Call) !Out {
+        const sh = try shape(c);
+        const dev = &f.dev;
+        const b = dev.b;
+        dev.pages.slot = c.slot;
+        dev.pages.pos0 = c.pos0;
+        try cuda.copy_source.enqueue(dev.d, b.ptr(.ids), std.mem.sliceAsBytes(c.ids), dev.st);
+        if (sh.shared) {
+            if (c.segs.len > iface.max_shared) return error.BadCall;
+            var segs: [iface.max_shared]rk.geom.Seg = undefined;
+            for (c.segs, segs[0..c.segs.len]) |s, *o| o.* = .{ .slot = s.slot, .rows = s.rows };
+            try dev.pages.mirror.setRows(dev.st, f.tab[0..sh.rows], segs[0..c.segs.len]);
+            try cuda.copy_source.enqueue(dev.d, b.ptr(.pos), std.mem.sliceAsBytes(c.positions), dev.st);
+        }
+        try plan.plan(dev.g, sh, dev);
+        return out(dev.g, sh);
+    }
+
+    /// Where `sh`'s head left its rows.
+    pub fn out(g: *const Geometry, sh: plan.Shape) Out {
+        const n: u32 = if (sh.head == .all) sh.rows else 1;
+        return .{ .rows = if (sh.head == .none) 0 else n, .slot = g.slot, .world = g.world, .picks = sh.mode == .picks };
+    }
+
+    /// The device address of the head's result for `o` (a call's `Out` carries the layout, not the address).
+    pub fn address(f: *const Forward, o: Out) u64 {
+        const id: plan.Buf = if (o.picks) (if (o.world > 1) .pairs_all else .pairs) else (if (o.world > 1) .hgather else .hlog);
+        return f.dev.b.ptr(id);
+    }
+
+    /// The next position after keeping `keep` of a window's rows (later rows are overwritten, no state rolls back).
+    pub fn commit(pos: usize, rows: usize, keep: usize, prompt: bool) Error!usize {
+        if (keep == 0 or keep > rows or (prompt and keep != rows)) return error.BadCommit;
+        return pos + keep;
+    }
+};
+
+test {
+    _ = @import("forward_test.zig");
+}
diff --git a/zig/src/families/minimax_m3/forward_exec.zig b/zig/src/families/minimax_m3/forward_exec.zig
new file mode 100644
index 0000000..33e8411
--- /dev/null
+++ b/zig/src/families/minimax_m3/forward_exec.zig
@@ -0,0 +1,312 @@
+//! The device half of a forward step: kernels, buffers and `Device.emit`; UNEXERCISED (compiled, never launched).
+const std = @import("std");
+const cuda = @import("cuda");
+const plan = @import("forward_plan.zig");
+const weights = @import("weights.zig");
+const ffn = @import("ffn.zig");
+const rows_cfg = @import("rows.zig");
+const sparse = cuda.minimax_m3_sparse;
+const rk = cuda.minimax_m3_rows;
+const Op = plan.Op;
+const Buf = plan.Buf;
+const Ref = plan.Ref;
+
+pub const Error = error{ NoIndexProjKernel, NoPickKernel, NoLink, BadOp };
+
+/// Every kernel module a step launches from.
+pub const Modules = struct {
+    dense: cuda.exl3.Dense,
+    experts: cuda.exl3_experts.Experts,
+    norms: cuda.norms.Norms,
+    embed: cuda.embed_rows.EmbedRows,
+    act: cuda.minimax_m3_act.MiniMaxAct,
+    rows: rk.Rows,
+    sparse: sparse.Sparse,
+    scatter: cuda.rank_scatter.RankScatter,
+
+    pub fn load(d: *const cuda.Driver) !Modules {
+        var m: Modules = undefined;
+        m.dense = try cuda.exl3.Dense.load(d);
+        errdefer m.dense.unload();
+        m.experts = try cuda.exl3_experts.Experts.load(d);
+        errdefer m.experts.unload();
+        m.norms = try cuda.norms.Norms.load(d);
+        errdefer m.norms.unload();
+        m.embed = try cuda.embed_rows.EmbedRows.load(d);
+        errdefer m.embed.unload();
+        m.act = try cuda.minimax_m3_act.MiniMaxAct.load(d);
+        errdefer m.act.unload();
+        m.rows = try rk.Rows.load(d);
+        errdefer m.rows.unload();
+        m.sparse = try sparse.Sparse.load(d);
+        errdefer m.sparse.unload();
+        m.scatter = try cuda.rank_scatter.RankScatter.load(d);
+        return m;
+    }
+
+    pub fn deinit(m: *Modules) void {
+        m.scatter.unload();
+        m.sparse.unload();
+        m.rows.unload();
+        m.act.unload();
+        m.embed.unload();
+        m.norms.unload();
+        m.experts.unload();
+        m.dense.unload();
+        m.* = undefined;
+    }
+};
+
+/// How the two ranks meet: the group's all-gather, and NCCL for the row-share form of a prompt chunk's sum.
+pub const Link = struct { group: *const cuda.tp_group.Group, lib: *const cuda.nccl.Library, comm: cuda.nccl.Comm };
+
+/// The routed experts' layer shape, for sizing the scratch before any weights exist.
+fn shapeLayer(g: *const plan.Geometry) cuda.exl3_experts.Layer {
+    return .{ .gate = 0, .up = 0, .down = 0, .gate_k2 = 0, .up_k2 = 0, .down_k2 = 0, .suh_g = 0, .suh_u = 0, .svh_g = 0, .svh_u = 0, .suh_d = 0, .svh_d = 0, .experts = g.experts, .dims = g.hidden, .width = g.moe_w, .codebook = .mul1 };
+}
+
+/// Rows of one rank's share of `rows` rows, at most (the padded slot of the share form).
+fn shareRows(rows: usize, world: usize) usize {
+    return (rows + world - 1) / world;
+}
+
+/// Buffers that are not rows of a step: scratch of the kernels and the exchange.
+pub const Extra = enum { experts, gathered, scatter, share, shares, bmax, sel, status };
+
+pub const Buffers = struct {
+    mem: [plan.bufs.len + std.enums.values(Extra).len]cuda.DeviceBuffer,
+    n: usize,
+    bm_stride: usize,
+
+    fn take(b: *Buffers, d: *const cuda.Driver, bytes: usize) !void {
+        b.mem[b.n] = try cuda.DeviceBuffer.alloc(d, bytes);
+        b.n += 1;
+    }
+
+    pub fn init(d: *const cuda.Driver, g: *const plan.Geometry, bm_stride: usize) !Buffers {
+        var b: Buffers = .{ .mem = undefined, .n = 0, .bm_stride = bm_stride };
+        errdefer b.deinit();
+        for (plan.bufs) |id| try b.take(d, g.rowBytes(id) * g.capacity(id));
+        const world: usize = g.world;
+        const slot_rows = shareRows(g.max_rows, world);
+        const experts = try cuda.exl3_experts.scratchBytes(shapeLayer(g), plan.expert_rows, g.topk);
+        const wide: usize = @min(g.max_rows, 128);
+        try b.take(d, experts);
+        try b.take(d, world * wide * g.hidden * 4);
+        try b.take(d, world * slot_rows * g.hidden * 4);
+        try b.take(d, slot_rows * g.hidden * 4);
+        try b.take(d, world * slot_rows * g.hidden * 4);
+        try b.take(d, @as(usize, g.max_rows) * g.kvh * bm_stride * 4);
+        try b.take(d, @as(usize, g.max_rows) * g.kvh * 16 * 4);
+        try b.take(d, 4);
+        return b;
+    }
+
+    pub fn deinit(b: *Buffers) void {
+        for (b.mem[0..b.n]) |*m| m.free();
+        b.n = 0;
+    }
+
+    pub fn ptr(b: *const Buffers, id: Buf) u64 {
+        return b.mem[@backingInt(id)].ptr;
+    }
+
+    pub fn extra(b: *const Buffers, e: Extra) *const cuda.DeviceBuffer {
+        return &b.mem[plan.bufs.len + @backingInt(e)];
+    }
+
+    pub fn scratch(b: *const Buffers) sparse.Scratch {
+        return .{ .bmax = b.extra(.bmax).ptr, .sel = b.extra(.sel).ptr, .bm_stride = b.bm_stride };
+    }
+};
+
+/// The pool the paged kernels address (the engine's arena), and where this call's block tables are.
+pub const Pages = struct { cache: rk.Cache, layer_bytes: u64, mirror: *rk.Mirror, slot: u32 = 0, pos0: u32 = 0 };
+
+pub const Device = struct {
+    d: *const cuda.Driver,
+    st: cuda.Stream,
+    m: *Modules,
+    w: *const weights.Weights,
+    g: *const plan.Geometry,
+    b: *Buffers,
+    pages: Pages,
+    link: ?Link,
+    opts: rk.Opts,
+    sw: ffn.Switches = .{},
+    shared: bool = false, // this call's rows carry their own positions and table offsets
+
+    fn at(dv: *const Device, r: Ref) u64 {
+        return dv.b.ptr(r.buf) + @as(u64, r.row) * dv.g.rowBytes(r.buf);
+    }
+
+    fn layer(dv: *const Device, l: u32) *const weights.Layer {
+        return &dv.w.layers[l];
+    }
+
+    fn paged(dv: *const Device, l: u32) !sparse.Paged {
+        var c = dv.pages.cache;
+        c.layer_off = @as(u64, l) * dv.pages.layer_bytes;
+        return if (dv.shared) dv.pages.mirror.shared(c) else try dv.pages.mirror.single(c, dv.pages.slot);
+    }
+
+    fn rowsOf(dv: *const Device, n: u32) sparse.Rows {
+        return if (dv.shared) .{ .n = n, .pos = dv.b.ptr(.pos) } else .{ .n = n, .pos0 = @intCast(dv.pages.pos0) };
+    }
+
+    fn zeroBytes(dv: *const Device, p: u64, bytes: usize) !void {
+        try dv.d.check(dv.d.api.cuMemsetD8Async(p, 0, bytes, dv.st.handle), "cuMemsetD8Async");
+    }
+
+    fn copy(dv: *const Device, dst: u64, src: u64, bytes: usize) !void {
+        try dv.d.check(dv.d.api.cuMemcpyDtoDAsync_v2(dst, src, bytes, dv.st.handle), "cuMemcpyDtoDAsync");
+    }
+
+    fn weightOf(dv: *const Device, w: plan.Lin, l: u32) cuda.exl3.Weight {
+        const ly = dv.layer(l);
+        return switch (w) {
+            .q => ly.q,
+            .k => ly.k,
+            .v => ly.v,
+            .o => ly.o,
+            .dense_gate => ly.ffn.dense.gate,
+            .dense_up => ly.ffn.dense.up,
+            .dense_down => ly.ffn.dense.down,
+            .shared_gate => ly.ffn.moe.shared.gate,
+            .shared_up => ly.ffn.moe.shared.up,
+            .shared_down => ly.ffn.moe.shared.down,
+            .head => dv.w.head,
+        };
+    }
+
+    fn normOf(dv: *const Device, n: plan.Norm, l: u32) u64 {
+        return switch (n) {
+            .input => dv.layer(l).input_ln,
+            .post => dv.layer(l).post_ln,
+            .final => dv.w.final_norm,
+        };
+    }
+
+    /// Launches one op on the stream.
+    pub fn emit(dv: *Device, op: Op) !void {
+        const s = dv.st;
+        const m = dv.m;
+        const hidden = dv.g.hidden;
+        switch (op) {
+            .stage => |o| {
+                dv.shared = o.shared;
+                try dv.zeroBytes(dv.b.extra(.status).ptr, 4);
+            },
+            .embed => |o| try m.embed.bf16(s, dv.b.ptr(.ids), dv.w.embed, dv.b.ptr(.emb), o.rows, hidden),
+            .zero => |o| try dv.zeroBytes(dv.b.ptr(o.buf), @as(usize, o.rows) * dv.g.rowBytes(o.buf)),
+            .norm_add => |o| {
+                const kind: cuda.norms.Kind = if (o.x_f32) .f32 else .bf16;
+                const wt = dv.normOf(o.norm, o.layer);
+                try m.norms.addRms(s, dv.at(o.x), kind, dv.b.ptr(.res), null, wt, dv.at(o.y), .bf16, o.rows, hidden, dv.g.cfg.eps);
+            },
+            .linear => |o| {
+                const w = dv.weightOf(o.w, o.layer);
+                const wide = o.w == .o or o.w == .dense_down or o.w == .shared_down or o.w == .head;
+                const ydt: cuda.exl3.DType = if (wide) .f32 else .bf16;
+                if (o.prompt) {
+                    try m.dense.prompt(s, w, dv.at(o.x), .bf16, o.rows, dv.at(o.y), ydt);
+                } else try m.dense.decode(s, w, dv.at(o.x), .bf16, o.rows, dv.at(o.y), ydt);
+            },
+            .index_proj => return error.NoIndexProjKernel,
+            .qk_rope => |o| try dv.qkRope(o.layer, o.rows),
+            .score => |o| {
+                const scale: f32 = @floatCast(std.math.pow(f64, 128, -0.5));
+                try m.sparse.score(s, dv.b.ptr(.iqn), dv.rowsOf(o.rows), try dv.paged(o.layer), dv.b.scratch(), o.max_pos, scale);
+            },
+            .select => |o| try m.sparse.select(s, dv.rowsOf(o.rows), dv.g.kvh, dv.b.scratch(), .{}),
+            .attend => |o| {
+                const scale: f32 = @floatCast(std.math.pow(f64, 128, -0.5));
+                try m.sparse.attend(s, dv.b.ptr(.qn), dv.rowsOf(o.rows), try dv.paged(o.layer), dv.b.scratch(), dv.b.ptr(.attn), scale);
+            },
+            .router => |o| try m.rows.routerLogits(s, rows_cfg.router, dv.b.ptr(.a), hidden, false, dv.layer(o.layer).ffn.moe.router, dv.b.ptr(.logits_r), o.rows),
+            .route => |o| {
+                const moe = dv.layer(o.layer).ffn.moe;
+                const rp = try ffn.routePlan(dv.sw);
+                try m.act.route(s, dv.b.ptr(.logits_r), moe.bias, rp.route, dv.b.ptr(.pick), dv.b.ptr(.wts), o.rows);
+            },
+            .experts => |o| {
+                const l = dv.layer(o.layer).ffn.moe.experts;
+                const sc = try cuda.exl3_experts.scratch(dv.b.extra(.experts).ptr, l, plan.expert_rows, dv.g.topk);
+                const x = dv.at(.{ .buf = .a, .row = o.row0 });
+                const pick = dv.at(.{ .buf = .pick, .row = o.row0 });
+                const wts = dv.at(.{ .buf = .wts, .row = o.row0 });
+                try m.experts.run(s, l, x, hidden, .bf16, pick, wts, o.rows, dv.at(.{ .buf = .routed, .row = o.row0 }), sc);
+            },
+            .swiglu => |o| {
+                const p = ffn.actParams(dv.sw);
+                const ld: usize = o.n;
+                try m.act.swigluoai(s, .bf16, dv.b.ptr(.gate), ld, dv.b.ptr(.up), ld, dv.b.ptr(.act), ld, o.rows, o.n, p);
+            },
+            .add2 => |o| {
+                // tf_rank_sum as a two-term fp32 add: peers slot 0 is `a`, own (rank 1) is `b`, one rounded add each
+                try m.scatter.rankSum(s, dv.b.ptr(o.a), dv.b.ptr(o.b), 2, 1, @as(usize, o.rows) * hidden, dv.b.ptr(o.out));
+            },
+            .exchange => |o| try dv.sum(o),
+            .logits_gather => |o| {
+                const link = dv.link orelse return error.NoLink;
+                const bytes = @as(usize, o.rows) * dv.g.slot * 4;
+                try link.group.allGather(s, dv.b.ptr(.hlog), dv.b.ptr(.hgather), bytes);
+            },
+            .local_pick, .pick_gather => return error.NoPickKernel,
+        }
+    }
+
+    fn qkRope(dv: *const Device, l: u32, n: u32) !void {
+        const ly = dv.layer(l);
+        const g = dv.g;
+        const heads: rk.Heads = .{ .nq = g.nq, .niq = g.niq, .kvh = g.kvh, .index_key = true };
+        const b = dv.b;
+        const in: rk.Inputs = .{
+            .q = b.ptr(.q),
+            .q_ld = g.q_w,
+            .k = b.ptr(.k),
+            .k_ld = g.kv_w,
+            .v = b.ptr(.v),
+            .v_ld = g.kv_w,
+            .iq = b.ptr(.iq_raw),
+            .iq_ld = g.iq_w,
+            .ik = b.ptr(.ik_raw),
+            .ik_ld = g.ik_w,
+        };
+        const nm: rk.Norms = .{ .q = ly.q_norm, .k = ly.k_norm, .iq = ly.index_q_norm, .ik = ly.index_k_norm };
+        const out: rk.Outputs = .{ .q = b.ptr(.qn), .q_ld = g.q_w, .iq = b.ptr(.iqn), .iq_ld = g.iq_w };
+        const pg = try dv.paged(l);
+        try dv.m.rows.qkRope(dv.st, heads, dv.opts, in, nm, out, dv.rowsOf(n), pg, @intCast(dv.pages.mirror.max_pages), b.extra(.status).ptr);
+    }
+
+    /// A block's partial sums added in rank order into `dst` on every rank, in tp.zig's gather or share form.
+    fn sum(dv: *const Device, o: anytype) !void {
+        const link = dv.link orelse return error.NoLink;
+        const g = dv.g;
+        const world: usize = g.world;
+        const rank: usize = g.rank;
+        const width: usize = g.hidden;
+        const rows: usize = o.rows;
+        if (o.form == .gather_sum) {
+            const slot = rows * width * 4;
+            try link.group.allGather(dv.st, dv.b.ptr(o.src), dv.b.extra(.gathered).ptr, slot);
+            return dv.m.scatter.rankSum(dv.st, dv.b.extra(.gathered).ptr, dv.b.ptr(o.src), world, rank, rows * width, dv.b.ptr(o.dst));
+        }
+        const slot = shareRows(rows, world) * width * 4;
+        try dv.m.scatter.run(link.lib, link.comm, world, rank, dv.st, dv.b.ptr(o.src), rows, width, dv.b.extra(.scatter).ptr, dv.b.extra(.share).ptr);
+        try link.group.allGather(dv.st, dv.b.extra(.share).ptr, dv.b.extra(.shares).ptr, slot);
+        for (0..world) |r| {
+            const rs = cuda.rank_scatter.share(rows, world, r);
+            const bytes = (rs[1] - rs[0]) * width * 4;
+            if (bytes > 0) try dv.copy(dv.b.ptr(o.dst) + rs[0] * width * 4, dv.b.extra(.shares).ptr + r * slot, bytes);
+        }
+    }
+
+    /// After the step: a launch that found no page for a row left bits in the status word.
+    pub fn status(dv: *const Device) !i32 {
+        var out: [4]u8 = undefined;
+        try dv.b.extra(.status).download(0, &out);
+        try dv.st.synchronize();
+        return std.mem.readInt(i32, &out, .little);
+    }
+};
diff --git a/zig/src/families/minimax_m3/forward_plan.zig b/zig/src/families/minimax_m3/forward_plan.zig
new file mode 100644
index 0000000..b57b0f1
--- /dev/null
+++ b/zig/src/families/minimax_m3/forward_plan.zig
@@ -0,0 +1,365 @@
+//! One MiniMax-M3.1-Flash forward step as data: a pure planner (no GPU) the executor and the tests share.
+const std = @import("std");
+const Config = @import("config.zig").Config;
+const shard = @import("shard.zig");
+const tp = @import("tp.zig");
+const iface = @import("iface.zig");
+
+pub const Error = error{ BadRows, TooManyRows, BadThin };
+
+/// Routed-expert rows one launch takes: its scratch is sized for them, a longer chunk runs in several calls.
+pub const expert_rows: u32 = 256;
+/// Most rows whose logits the head keeps at once (a decode or verify window; a prompt chunk keeps one row).
+pub const head_rows: u32 = 128;
+
+/// Device buffers a step's ops name; the executor maps each to an allocation (rows are the first index).
+pub const Buf = enum {
+    ids, // int32 token ids
+    pos, // int32 positions (a shared window's rows)
+    row_tab, // int32 table offsets (a shared window's rows)
+    emb, // bf16 embedding rows
+    res, // fp32 residual stream (decision R1: fp32, the T0 default has no rounding)
+    a, // bf16 normed input of the current block
+    q,
+    k,
+    v, // bf16 projections
+    iq_raw,
+    ik_raw, // fp16 index projections
+    qn,
+    iqn, // bf16 normed and rotated q and index q
+    attn, // bf16 attention output
+    part, // fp32 this rank's partial sum of a block
+    routed, // fp32 routed experts' output
+    shr, // fp32 shared expert's output
+    sum, // fp32 the ranks' partials added in rank order
+    gate,
+    up,
+    act, // bf16 dense and shared MLP rows
+    logits_r, // fp32 router logits
+    pick, // int32 routed picks
+    wts, // fp32 routed weights
+    hlog, // fp32 this rank's head logits
+    hgather, // fp32 every rank's head logits, [rank][row][slot]
+    pairs, // (logit, id) of this rank's best
+    pairs_all, // every rank's pair
+};
+
+pub const bufs = std.enums.values(Buf);
+
+/// A buffer and the first row an op reads or writes in it.
+pub const Ref = struct { buf: Buf, row: u32 = 0 };
+
+pub const Norm = enum { input, post, final };
+
+/// The matrices a `linear` op names (layer picks the record; head and the layer's dense or shared MLP are by kind).
+pub const Lin = enum { q, k, v, o, dense_gate, dense_up, dense_down, shared_gate, shared_up, shared_down, head };
+
+pub const Form = tp.Form;
+
+pub const Op = union(enum) {
+    stage: struct { rows: u32, shared: bool }, // ids, positions and row tables go to the device; status cleared
+    embed: struct { rows: u32 },
+    zero: struct { buf: Buf, rows: u32 },
+    norm_add: struct { x: Ref, x_f32: bool, norm: Norm, layer: u32, y: Ref, rows: u32 }, // res += x; y = rms(res) w
+    linear: struct { w: Lin, layer: u32, x: Ref, y: Ref, rows: u32, prompt: bool },
+    index_proj: struct { layer: u32, rows: u32 }, // fp16 weights: a -> iq_raw, ik_raw
+    qk_rope: struct { layer: u32, rows: u32 }, // norm + rope; q, index q to scratch; k, v, index key into pages
+    score: struct { layer: u32, rows: u32, max_pos: u32 },
+    select: struct { layer: u32, rows: u32 },
+    attend: struct { layer: u32, rows: u32 },
+    router: struct { layer: u32, rows: u32 }, // fp32 gate times a
+    route: struct { layer: u32, rows: u32 },
+    experts: struct { layer: u32, row0: u32, rows: u32 },
+    swiglu: struct { layer: u32, shared: bool, n: u32, rows: u32 }, // act = swigluoai(gate, up)
+    add2: struct { a: Buf, b: Buf, out: Buf, rows: u32 }, // out = a + b in fp32 (routed + shared)
+    exchange: struct { form: Form, site: tp.Site, src: Buf, dst: Buf, rows: u32 },
+    logits_gather: struct { rows: u32 },
+    local_pick: struct { rows: u32 },
+    pick_gather: struct { rows: u32 },
+};
+
+/// The kernels' classes, one per launch of the T0 model's order (see forward_test.zig).
+pub const Stage = enum {
+    stage,
+    embed,
+    zero,
+    norm_in,
+    proj_q,
+    proj_k,
+    proj_v,
+    index_proj,
+    qk_rope,
+    score,
+    select,
+    attend,
+    proj_o,
+    exchange_attn,
+    norm_post,
+    dense_gate,
+    dense_up,
+    dense_act,
+    dense_down,
+    router,
+    route,
+    experts,
+    shared_gate,
+    shared_up,
+    shared_act,
+    shared_down,
+    combine,
+    exchange_ffn,
+    norm_final,
+    head,
+    gather,
+    pick,
+};
+
+pub fn stageOf(op: Op) Stage {
+    return switch (op) {
+        .stage => .stage,
+        .embed => .embed,
+        .zero => .zero,
+        .norm_add => |o| switch (o.norm) {
+            .input => .norm_in,
+            .post => .norm_post,
+            .final => .norm_final,
+        },
+        .linear => |o| switch (o.w) {
+            .q => .proj_q,
+            .k => .proj_k,
+            .v => .proj_v,
+            .o => .proj_o,
+            .dense_gate => .dense_gate,
+            .dense_up => .dense_up,
+            .dense_down => .dense_down,
+            .shared_gate => .shared_gate,
+            .shared_up => .shared_up,
+            .shared_down => .shared_down,
+            .head => .head,
+        },
+        .index_proj => .index_proj,
+        .qk_rope => .qk_rope,
+        .score => .score,
+        .select => .select,
+        .attend => .attend,
+        .router => .router,
+        .route => .route,
+        .experts => .experts,
+        .swiglu => |o| if (o.shared) .shared_act else .dense_act,
+        .add2 => .combine,
+        .exchange => |o| if (o.site == .attn_out) .exchange_attn else .exchange_ffn,
+        .logits_gather, .pick_gather => .gather,
+        .local_pick => .pick,
+    };
+}
+
+/// The rank's widths: what each buffer holds per row and which matrices exist.
+pub const Geometry = struct {
+    cfg: *const Config,
+    hidden: u32,
+    layers: u32, // layers run (a thin model: the first ones)
+    world: u32,
+    rank: u32,
+    max_rows: u32,
+    nq: u32, // this rank's query heads, index heads, kv heads
+    niq: u32,
+    kvh: u32,
+    q_w: u32,
+    kv_w: u32,
+    iq_w: u32,
+    ik_w: u32,
+    dense_w: u32,
+    shared_w: u32,
+    moe_w: u32,
+    experts: u32,
+    topk: u32,
+    slot: u32, // logits a rank's gather slot holds (the largest share)
+    own_vocab: u32, // this rank's head rows
+    vocab_lo: u32, // first vocabulary id of this rank's rows
+
+    pub fn of(c: *const Config, s: shard.Share, layers: u32, max_rows: u32) !Geometry {
+        if (layers == 0 or layers > c.layers) return error.BadThin;
+        const lg = try tp.LogitsGather.of(c, s.world);
+        return .{
+            .cfg = c,
+            .hidden = c.hidden,
+            .layers = layers,
+            .world = @intCast(s.world),
+            .rank = @intCast(s.rank),
+            .max_rows = max_rows,
+            .nq = @intCast(s.q_heads.len()),
+            .niq = @intCast(s.index_heads.len()),
+            .kvh = @intCast(s.kv_heads.len()),
+            .q_w = @intCast(s.q_heads.len() * c.head_dim),
+            .kv_w = @intCast(s.kv_heads.len() * c.head_dim),
+            .iq_w = @intCast(s.index_heads.len() * c.index.dim),
+            .ik_w = c.index.dim,
+            .dense_w = @intCast(s.dense.len()),
+            .shared_w = @intCast(s.shared.len()),
+            .moe_w = @intCast(s.moe.len()),
+            .experts = c.experts,
+            .topk = c.topk,
+            .slot = @intCast(lg.slot),
+            .own_vocab = @intCast(s.vocab.len()),
+            .vocab_lo = @intCast(s.vocab.lo),
+        };
+    }
+
+    pub fn isMoe(g: *const Geometry, layer: u32) bool {
+        return g.cfg.isMoe(layer);
+    }
+
+    /// Rows a buffer holds at most: the ids and activations by `max_rows`, the head's by `head_rows`.
+    pub fn capacity(g: *const Geometry, b: Buf) u32 {
+        return switch (b) {
+            .hlog, .hgather, .pairs, .pairs_all => head_rows,
+            else => g.max_rows,
+        };
+    }
+
+    /// Bytes one row of `b` takes.
+    pub fn rowBytes(g: *const Geometry, b: Buf) usize {
+        const rows_w: usize = @max(g.dense_w, g.shared_w);
+        return switch (b) {
+            .ids, .pos, .row_tab => 4,
+            .emb, .a => g.hidden * 2,
+            .res, .part, .routed, .shr, .sum => g.hidden * 4,
+            .q, .qn, .attn => g.q_w * 2,
+            .k, .v => g.kv_w * 2,
+            .iq_raw, .iqn => g.iq_w * 2,
+            .ik_raw => g.ik_w * 2,
+            .gate, .up, .act => rows_w * 2,
+            .logits_r => g.experts * 4,
+            .pick, .wts => g.topk * 4,
+            .hlog => g.slot * 4,
+            .hgather => g.world * g.slot * 4,
+            .pairs => 8,
+            .pairs_all => g.world * 8,
+        };
+    }
+};
+
+/// What one call computes: its rows, how its streams sit in the batch and which rows the head reads.
+pub const Head = enum { all, last, none };
+pub const HeadMode = enum { gather, picks };
+
+pub const Shape = struct {
+    rows: u32,
+    prompt: bool = false, // a prompt chunk of one stream
+    shared: bool = false, // several streams' windows in one batch (positions and table offsets per row)
+    max_pos: u32 = 0, // the largest position among the rows
+    head: Head = .all,
+    mode: HeadMode = .gather,
+};
+
+pub fn check(g: *const Geometry, sh: Shape) Error!void {
+    if (sh.rows == 0) return error.BadRows;
+    if (sh.rows > g.max_rows) return error.TooManyRows;
+    if (sh.shared and (sh.prompt or sh.rows > iface.shared_rows)) return error.TooManyRows;
+    if (sh.head == .all and sh.rows > head_rows) return error.TooManyRows;
+}
+
+/// The shipped model's launches for `sh`, in order, into `sink.emit(op)`.
+pub fn plan(g: *const Geometry, sh: Shape, sink: anytype) !void {
+    try check(g, sh);
+    const n = sh.rows;
+    try sink.emit(.{ .stage = .{ .rows = n, .shared = sh.shared } });
+    try sink.emit(.{ .embed = .{ .rows = n } });
+    try sink.emit(.{ .zero = .{ .buf = .res, .rows = n } });
+    try sink.emit(.{ .norm_add = .{ .x = .{ .buf = .emb }, .x_f32 = false, .norm = .input, .layer = 0, .y = .{ .buf = .a }, .rows = n } });
+    var l: u32 = 0;
+    while (l < g.layers) : (l += 1) {
+        try attention(g, sh, l, sink);
+        try mlp(g, sh, l, sink);
+    }
+    try head(g, sh, sink);
+}
+
+fn lin(sink: anytype, w: Lin, l: u32, x: Ref, y: Ref, n: u32, prompt: bool) !void {
+    try sink.emit(.{ .linear = .{ .w = w, .layer = l, .x = x, .y = y, .rows = n, .prompt = prompt } });
+}
+
+/// The ranks' partial sums of a block: none on one rank, else the exchange; returns the buffer holding the sum.
+fn exchange(g: *const Geometry, sh: Shape, site: tp.Site, sink: anytype) !Buf {
+    if (g.world == 1) return .part;
+    try sink.emit(.{ .exchange = .{ .form = tp.formFor(sh.rows), .site = site, .src = .part, .dst = .sum, .rows = sh.rows } });
+    return .sum;
+}
+
+/// The Gemma norm after the sum: the next norm of the stream, the layer's own post norm or the final one.
+fn normAdd(sink: anytype, x: Buf, norm: Norm, layer: u32, n: u32) !void {
+    try sink.emit(.{ .norm_add = .{ .x = .{ .buf = x }, .x_f32 = true, .norm = norm, .layer = layer, .y = .{ .buf = .a }, .rows = n } });
+}
+
+fn attention(g: *const Geometry, sh: Shape, l: u32, sink: anytype) !void {
+    const n = sh.rows;
+    const a: Ref = .{ .buf = .a };
+    try lin(sink, .q, l, a, .{ .buf = .q }, n, sh.prompt);
+    try lin(sink, .k, l, a, .{ .buf = .k }, n, sh.prompt);
+    try lin(sink, .v, l, a, .{ .buf = .v }, n, sh.prompt);
+    try sink.emit(.{ .index_proj = .{ .layer = l, .rows = n } });
+    try sink.emit(.{ .qk_rope = .{ .layer = l, .rows = n } });
+    try sink.emit(.{ .score = .{ .layer = l, .rows = n, .max_pos = sh.max_pos } });
+    try sink.emit(.{ .select = .{ .layer = l, .rows = n } });
+    try sink.emit(.{ .attend = .{ .layer = l, .rows = n } });
+    try lin(sink, .o, l, .{ .buf = .attn }, .{ .buf = .part }, n, sh.prompt);
+    try normAdd(sink, try exchange(g, sh, .attn_out, sink), .post, l, n);
+}
+
+fn swiglu(sink: anytype, l: u32, n: u32, width: u32, shared: bool) !void {
+    try sink.emit(.{ .swiglu = .{ .layer = l, .shared = shared, .n = width, .rows = n } });
+}
+
+fn mlp(g: *const Geometry, sh: Shape, l: u32, sink: anytype) !void {
+    const n = sh.rows;
+    const a: Ref = .{ .buf = .a };
+    if (!g.isMoe(l)) {
+        try lin(sink, .dense_gate, l, a, .{ .buf = .gate }, n, sh.prompt);
+        try lin(sink, .dense_up, l, a, .{ .buf = .up }, n, sh.prompt);
+        try swiglu(sink, l, n, g.dense_w, false);
+        try lin(sink, .dense_down, l, .{ .buf = .act }, .{ .buf = .part }, n, sh.prompt);
+    } else {
+        try sink.emit(.{ .router = .{ .layer = l, .rows = n } });
+        try sink.emit(.{ .route = .{ .layer = l, .rows = n } });
+        var at: u32 = 0;
+        while (at < n) : (at += expert_rows) {
+            try sink.emit(.{ .experts = .{ .layer = l, .row0 = at, .rows = @min(expert_rows, n - at) } });
+        }
+        try lin(sink, .shared_gate, l, a, .{ .buf = .gate }, n, sh.prompt);
+        try lin(sink, .shared_up, l, a, .{ .buf = .up }, n, sh.prompt);
+        try swiglu(sink, l, n, g.shared_w, true);
+        try lin(sink, .shared_down, l, .{ .buf = .act }, .{ .buf = .shr }, n, sh.prompt);
+        try sink.emit(.{ .add2 = .{ .a = .routed, .b = .shr, .out = .part, .rows = n } });
+    }
+    const next: Norm = if (l + 1 < g.layers) .input else .final;
+    try normAdd(sink, try exchange(g, sh, .ffn_out, sink), next, if (next == .input) l + 1 else l, n);
+}
+
+/// The final norm ran at the end of the last layer; the head cuts this rank's rows and gathers or merges them.
+fn head(g: *const Geometry, sh: Shape, sink: anytype) !void {
+    if (sh.head == .none) return;
+    const n: u32 = if (sh.head == .all) sh.rows else 1;
+    const x: Ref = .{ .buf = .a, .row = if (sh.head == .all) 0 else sh.rows - 1 };
+    try lin(sink, .head, 0, x, .{ .buf = .hlog }, n, false);
+    switch (sh.mode) {
+        .gather => if (g.world > 1) try sink.emit(.{ .logits_gather = .{ .rows = n } }),
+        .picks => {
+            try sink.emit(.{ .local_pick = .{ .rows = n } });
+            if (g.world > 1) try sink.emit(.{ .pick_gather = .{ .rows = n } });
+        },
+    }
+}
+
+/// An op list for tests: owns the ops it was given.
+pub const Recorder = struct {
+    gpa: std.mem.Allocator,
+    ops: std.ArrayList(Op) = .empty,
+
+    pub fn emit(r: *Recorder, op: Op) !void {
+        try r.ops.append(r.gpa, op);
+    }
+
+    pub fn deinit(r: *Recorder) void {
+        r.ops.deinit(r.gpa);
+    }
+};
