+    try record(&g1, .{ .rows = 5 }, &r1);
+    try std.testing.expectEqual(r0.ops.items.len, r1.ops.items.len);
+    for (r0.ops.items, r1.ops.items) |x, y| try std.testing.expect(std.meta.eql(x, y));
+    var sites: std.ArrayList(tp.Site) = .empty;
