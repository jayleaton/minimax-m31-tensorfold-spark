+}
+
+test "the head: padded gather bytes match tp.LogitsGather, or a pick merge" {
+    const a = std.testing.allocator;
+    const g = try geometry(0, 2, 3, 128);
+    const lg = try tp.LogitsGather.of(flash, 2);
