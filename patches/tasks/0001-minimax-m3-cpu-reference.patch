diff --git a/zig/src/families/minimax_m3/ref.zig b/zig/src/families/minimax_m3/ref.zig
new file mode 100644
index 0000000..a710149
--- /dev/null
+++ b/zig/src/families/minimax_m3/ref.zig
@@ -0,0 +1,241 @@
+//! MiniMax-M3.1-Flash on the CPU in float64: a full layer, a small model and the head (engine-port-plan.md T0).
+const std = @import("std");
+const core = @import("core");
+const mr = core.minimax_ref;
+
+pub const Switches = mr.Switches;
+
+/// The text model's shape; the defaults are the real checkpoint's, tests shrink hidden, experts and the block count.
+pub const Config = struct {
+    hidden: usize = 6144,
+    n_q: usize = 64,
+    n_kv: usize = 4,
+    head_dim: usize = 128,
+    rot_dim: usize = 64,
+    rope_theta: f64 = 1e7,
+    eps: f64 = 1e-6,
+    /// Index heads: one per kv head, all scoring the one shared index key (index head g selects for kv head g).
+    n_index: usize = 4,
+    block: usize = 128,
+    topk_blocks: usize = 16,
+    n_experts: usize = 128,
+    experts_topk: usize = 4,
+    routed_scale: f64 = 2.0,
+    alpha: f64 = 1.702,
+    limit: f64 = 7.0,
+    sw: Switches = .{},
+
+    pub fn rep(c: Config) usize {
+        return c.n_q / c.n_kv;
+    }
+};
+
+/// y = x W for W stored [k][n] row-major, the layout exl3_format.dequantize writes.
+pub const Linear = struct {
+    k: usize,
+    n: usize,
+    w: []const f64,
+
+    pub fn apply(l: Linear, x: []const f64, out: []f64) void {
+        @memset(out[0..l.n], 0);
+        for (x[0..l.k], 0..) |xv, i| {
+            const row = l.w[i * l.n ..][0..l.n];
+            for (out[0..l.n], row) |*o, wv| o.* += xv * wv;
+        }
+    }
+};
+
+/// A gated MLP: w1, w3 are [hidden][inter], w2 [inter][hidden]; dense and shared MLPs: gate_proj is w1, up_proj w3.
+pub const Mlp = struct {
+    w1: Linear,
+    w3: Linear,
+    w2: Linear,
+
+    /// out = w2 swigluoai(gate, up); `routed` applies Switches.w1_is_gate, dense and shared MLPs never swap.
+    pub fn apply(m: Mlp, c: Config, x: []const f64, routed: bool, a: std.mem.Allocator, out: []f64) !void {
+        const n = m.w1.n;
+        const p = try a.alloc(f64, 2 * n);
+        m.w1.apply(x, p[0..n]);
+        m.w3.apply(x, p[n..]);
+        const swap = routed and !c.sw.w1_is_gate;
+        for (0..n) |i| {
+            const g, const u = if (swap) .{ p[n + i], p[i] } else .{ p[i], p[n + i] };
+            p[i] = mr.round16(c.sw.bf16_act_out, mr.swigluoai(g, u, c.alpha, c.limit, c.sw));
+        }
+        m.w2.apply(p[0..n], out);
+    }
+};
+
+pub const Moe = struct {
+    gate: Linear,
+    bias: []const f64,
+    experts: []const Mlp,
+    shared: Mlp,
+};
+
+pub const Ffn = union(enum) { dense: Mlp, moe: Moe };
+
+pub const Layer = struct {
+    input_norm: []const f64,
+    post_norm: []const f64,
+    q: Linear,
+    k: Linear,
+    v: Linear,
+    o: Linear,
+    q_norm: []const f64,
+    k_norm: []const f64,
+    index_q: Linear,
+    index_k: Linear,
+    index_q_norm: []const f64,
+    index_k_norm: []const f64,
+    ffn: Ffn,
+};
+
+pub const Model = struct {
+    cfg: Config,
+    embed: []const f64,
+    layers: []const Layer,
+    final_norm: []const f64,
+    head: Linear,
+};
+
+/// One layer's K, V ([kv head][pos][d]) and index-key (IK [pos][d]) history, `cap` positions.
+pub const LayerCache = struct {
+    k: []f64,
+    v: []f64,
+    ik: []f64,
+    cap: usize,
+};
+
+pub const Cache = struct {
+    layers: []LayerCache,
+
+    pub fn init(a: std.mem.Allocator, c: Config, n_layers: usize, cap: usize) !Cache {
+        const ls = try a.alloc(LayerCache, n_layers);
+        for (ls) |*l| l.* = .{
+            .k = try a.alloc(f64, c.n_kv * cap * c.head_dim),
+            .v = try a.alloc(f64, c.n_kv * cap * c.head_dim),
+            .ik = try a.alloc(f64, cap * c.head_dim),
+            .cap = cap,
+        };
+        return .{ .layers = ls };
+    }
+};
+
+fn norm(c: Config, x: []const f64, w: []const f64, gemma: bool, out: []f64) void {
+    mr.gemmaNorm(x, w, c.eps, gemma, out);
+    mr.roundAll(c.sw.bf16_norm_out, out);
+}
+
+fn heads(c: Config, x: []f64, n: usize, w: []const f64, gemma: bool, pos: ?usize) void {
+    const d = c.head_dim;
+    var t: [512]f64 = undefined;
+    for (0..n) |h| {
+        const s = x[h * d ..][0..d];
+        norm(c, s, w, gemma, t[0..d]);
+        @memcpy(s, t[0..d]);
+        if (pos) |p| mr.rope(s, c.rot_dim, p, c.rope_theta, c.sw.rope_layout);
+        mr.roundAll(c.sw.bf16_rope_out, s);
+    }
+}
+
+/// The attention half of a layer for the token at `pos`: h += o_proj(sparse attention(norm(h))), cache appended.
+pub fn attention(c: Config, ly: Layer, lc: *LayerCache, h: []f64, pos: usize, a: std.mem.Allocator) !void {
+    const d = c.head_dim;
+    const x = try a.alloc(f64, c.hidden);
+    norm(c, h, ly.input_norm, c.sw.gemma_layer_norms, x);
+    const q = try a.alloc(f64, c.n_q * d);
+    const k = try a.alloc(f64, c.n_kv * d);
+    const v = try a.alloc(f64, c.n_kv * d);
+    ly.q.apply(x, q);
+    ly.k.apply(x, k);
+    ly.v.apply(x, v);
+    for ([_][]f64{ q, k, v }) |t| mr.roundAll(c.sw.bf16_proj_out, t);
+    heads(c, q, c.n_q, ly.q_norm, c.sw.gemma_qk_norms, pos);
+    heads(c, k, c.n_kv, ly.k_norm, c.sw.gemma_qk_norms, pos);
+    const iq = try a.alloc(f64, c.n_index * d);
+    const ik = try a.alloc(f64, d);
+    mr.roundFp16(c.sw.fp16_index_input, x);
+    ly.index_q.apply(x, iq);
+    ly.index_k.apply(x, ik);
+    mr.roundAll(c.sw.bf16_proj_out, iq);
+    mr.roundAll(c.sw.bf16_proj_out, ik);
+    heads(c, iq, c.n_index, ly.index_q_norm, c.sw.gemma_index_norms, if (c.sw.index_rope) pos else null);
+    heads(c, ik, 1, ly.index_k_norm, c.sw.gemma_index_norms, if (c.sw.index_rope) pos else null);
+    for (0..c.n_kv) |g| {
+        @memcpy(lc.k[(g * lc.cap + pos) * d ..][0..d], k[g * d ..][0..d]);
+        @memcpy(lc.v[(g * lc.cap + pos) * d ..][0..d], v[g * d ..][0..d]);
+    }
+    @memcpy(lc.ik[pos * d ..][0..d], ik);
+    const bs = try a.alloc(f64, pos / c.block + 1);
+    const ids = try a.alloc(usize, c.topk_blocks);
+    const scratch = try a.alloc(f64, bs.len);
+    const keys = try a.alloc(usize, c.topk_blocks * c.block);
+    const ao = try a.alloc(f64, c.n_q * d);
+    const rep = c.rep();
+    for (0..c.n_kv) |g| {
+        _ = mr.blockScores(iq[g * d ..][0..d], lc.ik, pos, d, std.math.pow(f64, @floatFromInt(d), -0.5), c.block, bs);
+        const n = mr.selectBlocks(bs, pos / c.block, c.topk_blocks, c.sw, scratch, ids);
+        const base = g * lc.cap * d;
+        mr.attendBlocks(q[g * rep * d ..][0 .. rep * d], lc.k[base..][0 .. lc.cap * d], lc.v[base..][0 .. lc.cap * d], ids[0..n], pos, c.block, d, rep, keys, ao[g * rep * d ..][0 .. rep * d]);
+    }
+    mr.roundAll(c.sw.bf16_attn_out, ao);
+    const o = try a.alloc(f64, c.hidden);
+    ly.o.apply(ao, o);
+    for (h, o) |*hv, ov| hv.* = mr.round16(c.sw.bf16_residual, hv.* + ov);
+}
+
+/// The feed-forward half: h += ffn(norm(h)); dense MLP, or routed experts plus the shared expert.
+pub fn feedForward(c: Config, ly: Layer, h: []f64, a: std.mem.Allocator) !void {
+    const m = try a.alloc(f64, c.hidden);
+    norm(c, h, ly.post_norm, c.sw.gemma_layer_norms, m);
+    const f = try a.alloc(f64, c.hidden);
+    switch (ly.ffn) {
+        .dense => |mlp| try mlp.apply(c, m, false, a, f),
+        .moe => |moe| {
+            const logits = try a.alloc(f64, c.n_experts);
+            moe.gate.apply(m, logits);
+            const ids = try a.alloc(usize, c.experts_topk);
+            const w = try a.alloc(f64, c.experts_topk);
+            mr.routerPick(logits, moe.bias, c.routed_scale, c.sw, try a.alloc(f64, c.n_experts), ids, w);
+            @memset(f, 0);
+            const y = try a.alloc(f64, c.hidden);
+            for (ids, w) |e, we| {
+                try moe.experts[e].apply(c, m, true, a, y);
+                for (f, y) |*o, yv| o.* += we * yv;
+            }
+            try moe.shared.apply(c, m, false, a, y);
+            const t = mr.totalScale(c.sw, c.routed_scale);
+            for (f, y) |*o, yv| o.* = (o.* + yv) * t;
+        },
+    }
+    for (h, f) |*hv, fv| hv.* = mr.round16(c.sw.bf16_residual, hv.* + fv);
+}
+
+/// One whole layer for the token at `pos` (h in and out); `a` is scratch the caller may reset afterwards.
+pub fn layerStep(c: Config, ly: Layer, lc: *LayerCache, h: []f64, pos: usize, a: std.mem.Allocator) !void {
+    try attention(c, ly, lc, h, pos, a);
+    try feedForward(c, ly, h, a);
+}
+
+/// The head: logits = (gemma_norm(h, model.norm)) lm_head, as the engine's final fp32 logits.
+pub fn head(m: Model, h: []const f64, a: std.mem.Allocator, logits: []f64) !void {
+    const n = try a.alloc(f64, m.cfg.hidden);
+    norm(m.cfg, h, m.final_norm, m.cfg.sw.gemma_layer_norms, n);
+    m.head.apply(n, logits);
+}
+
+/// The model on one token at `pos` against its cache: embedding, every layer, the head into `logits`.
+pub fn step(m: Model, cache: Cache, token: usize, pos: usize, logits: []f64, gpa: std.mem.Allocator) !void {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const h = try a.dupe(f64, m.embed[token * m.cfg.hidden ..][0..m.cfg.hidden]);
+    for (m.layers, cache.layers) |ly, *lc| try layerStep(m.cfg, ly, lc, h, pos, a);
+    try head(m, h, a, logits);
+}
+
+/// Every token in order; the last token's logits are left in `logits`.
+pub fn run(m: Model, cache: Cache, tokens: []const usize, logits: []f64, gpa: std.mem.Allocator) !void {
+    for (tokens, 0..) |t, pos| try step(m, cache, t, pos, logits, gpa);
+}
diff --git a/zig/tests/minimax_ref_model_tests.zig b/zig/tests/minimax_ref_model_tests.zig
new file mode 100644
index 0000000..9dc6dfe
--- /dev/null
+++ b/zig/tests/minimax_ref_model_tests.zig
@@ -0,0 +1,312 @@
+//! MiniMax-M3.1-Flash float64 reference: layers and a 2-layer model on synthetic EXL3 weights, boundaries, switches.
+const std = @import("std");
+const core = @import("core");
+const ref = @import("minimax_ref");
+const synth = @import("minimax_ref_synth.zig");
+const mr = core.minimax_ref;
+
+const expect = std.testing.expect;
+
+fn arena() std.heap.ArenaAllocator {
+    return std.heap.ArenaAllocator.init(std.heap.page_allocator);
+}
+
+fn small(sw: ref.Switches) ref.Config {
+    var c = synth.tiny(sw);
+    c.block = 16;
+    c.topk_blocks = 3;
+    return c;
+}
+
+fn run(a: std.mem.Allocator, c: ref.Config, o: synth.Options, toks: []const usize) ![]f64 {
+    return synth.trace(a, try synth.model(a, c, o), toks, o.vocab);
+}
+
+test "EXL3 mul1 linears at 3, 4, 5 and 6 bits dequantize to finite, distinct, nonzero matrices" {
+    var ar = arena();
+    defer ar.deinit();
+    var g = synth.gen(ar.allocator(), 4);
+    var prev: ?ref.Linear = null;
+    for ([_]u16{ 6, 8, 10, 12 }) |halves| {
+        const l = try g.exl3Linear(halves, 128, 128, 1);
+        var sum: f64 = 0;
+        for (l.w) |v| {
+            try expect(std.math.isFinite(v));
+            sum += v * v;
+        }
+        try expect(sum > 1e-3);
+        if (prev) |p| try expect(synth.maxDiff(p.w, l.w) > 0);
+        prev = l;
+        var y: [128]f64 = undefined;
+        var x: [128]f64 = @splat(0);
+        x[5] = 2;
+        l.apply(&x, &y);
+        for (y, 0..) |v, j| try std.testing.expectApproxEqAbs(2 * l.w[5 * 128 + j], v, 1e-15);
+    }
+}
+
+test "model: deterministic, finite, and causal (a later token never changes an earlier position's logits)" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const c = small(.{});
+    const toks = try synth.tokens(a, 40, 128, 2);
+    const x = try run(a, c, .{}, toks);
+    const y = try run(a, c, .{}, toks);
+    try std.testing.expectEqualSlices(f64, x, y);
+    for (x) |v| try expect(std.math.isFinite(v));
+    var other = try a.dupe(usize, toks);
+    other[39] = (other[39] + 1) % 128;
+    const z = try run(a, c, .{}, other);
+    try std.testing.expectEqualSlices(f64, x[0 .. 39 * 128], z[0 .. 39 * 128]);
+    try expect(synth.maxDiff(x[39 * 128 ..], z[39 * 128 ..]) > 1e-6);
+}
+
+test "block boundary: pos 127 is dense with one block, pos 128 and 129 leave the older block out when topk = 1" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const toks = try synth.tokens(a, 131, 128, 6);
+    var one = synth.tiny(.{});
+    one.topk_blocks = 1;
+    var two = one;
+    two.topk_blocks = 2;
+    var wide = one;
+    wide.topk_blocks = 16;
+    const x1 = try run(a, one, .{}, toks);
+    const x2 = try run(a, two, .{}, toks);
+    const x16 = try run(a, wide, .{}, toks);
+    try std.testing.expectEqualSlices(f64, x2, x16);
+    try std.testing.expectEqualSlices(f64, x1[0 .. 128 * 128], x2[0 .. 128 * 128]);
+    for ([_]usize{ 128, 129, 130 }) |p| try expect(synth.maxDiff(x1[p * 128 ..][0..128], x2[p * 128 ..][0..128]) > 1e-6);
+}
+
+test "partial last block and more blocks than topk: the model runs on 70 tokens of 16-key blocks (5 blocks, topk 3)" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const toks = try synth.tokens(a, 70, 128, 8);
+    const sparse = try run(a, small(.{}), .{}, toks);
+    var dense = small(.{});
+    dense.topk_blocks = 16;
+    const full = try run(a, dense, .{}, toks);
+    try std.testing.expectEqualSlices(f64, sparse[0 .. 48 * 128], full[0 .. 48 * 128]);
+    try expect(synth.maxDiff(sparse[69 * 128 ..], full[69 * 128 ..]) > 1e-9);
+}
+
+fn proj(l: ref.Linear, x: []const f64, out: []f64) void {
+    for (0..l.n) |j| {
+        var s: f64 = 0;
+        for (0..l.k) |i| s += x[i] * l.w[i * l.n + j];
+        out[j] = s;
+    }
+}
+
+fn headNorm(w: []const f64, v: []f64, pos: ?usize, c: ref.Config) void {
+    var t: [128]f64 = undefined;
+    for (0..v.len / 128) |h| {
+        mr.gemmaNorm(v[h * 128 ..][0..128], w, c.eps, true, &t);
+        if (pos) |p| mr.rope(&t, c.rot_dim, p, c.rope_theta, c.sw.rope_layout);
+        @memcpy(v[h * 128 ..][0..128], &t);
+    }
+}
+
+const Scores = struct {
+    s: []const f64,
+    fn lt(self: @This(), x: usize, y: usize) bool {
+        return if (self.s[x] != self.s[y]) self.s[x] > self.s[y] else x < y;
+    }
+};
+
+/// Layer 0's attention at the last position, re-derived from the embeddings alone with sorted brute-force selection.
+fn oracle(a: std.mem.Allocator, m: ref.Model, toks: []const usize) ![]f64 {
+    const c = m.cfg;
+    const ly = m.layers[0];
+    const n = toks.len;
+    const p = n - 1;
+    const ks = try a.alloc(f64, n * 256);
+    const vs = try a.alloc(f64, n * 256);
+    const iks = try a.alloc(f64, n * 128);
+    var q: [512]f64 = undefined;
+    var iq: [256]f64 = undefined;
+    for (toks, 0..) |t, j| {
+        var x: [128]f64 = undefined;
+        mr.gemmaNorm(m.embed[t * 128 ..][0..128], ly.input_norm, c.eps, true, &x);
+        proj(ly.k, &x, ks[j * 256 ..][0..256]);
+        proj(ly.v, &x, vs[j * 256 ..][0..256]);
+        proj(ly.index_k, &x, iks[j * 128 ..][0..128]);
+        headNorm(ly.k_norm, ks[j * 256 ..][0..256], j, c);
+        headNorm(ly.index_k_norm, iks[j * 128 ..][0..128], j, c);
+        if (j == p) {
+            proj(ly.q, &x, &q);
+            proj(ly.index_q, &x, &iq);
+            headNorm(ly.q_norm, &q, p, c);
+            headNorm(ly.index_q_norm, &iq, p, c);
+        }
+    }
+    const ao = try a.alloc(f64, 512);
+    for (0..c.n_kv) |g| {
+        const nb = p / c.block + 1;
+        const sc = try a.alloc(f64, nb);
+        for (sc, 0..) |*b, bi| {
+            b.* = -std.math.inf(f64);
+            for (bi * c.block..@min(bi * c.block + c.block, p + 1)) |j| {
+                var s: f64 = 0;
+                for (0..128) |e| s += iq[g * 128 + e] * iks[j * 128 + e];
+                b.* = @max(b.*, s / @sqrt(128.0));
+            }
+        }
+        sc[nb - 1] = std.math.inf(f64);
+        const order = try a.alloc(usize, nb);
+        for (order, 0..) |*o, i| o.* = i;
+        std.mem.sort(usize, order, Scores{ .s = sc }, Scores.lt);
+        const take = @min(nb, c.topk_blocks);
+        std.mem.sort(usize, order[0..take], {}, std.sort.asc(usize));
+        for (g * 2..g * 2 + 2) |h| {
+            var sm = try a.alloc(f64, n);
+            var cnt: usize = 0;
+            var mx: f64 = -std.math.inf(f64);
+            for (order[0..take]) |b| for (b * c.block..@min(b * c.block + c.block, p + 1)) |j| {
+                var s: f64 = 0;
+                for (0..128) |e| s += q[h * 128 + e] * ks[j * 256 + g * 128 + e];
+                sm[j] = s / @sqrt(128.0);
+                mx = @max(mx, sm[j]);
+                cnt += 1;
+            };
+            var z: f64 = 0;
+            @memset(ao[h * 128 ..][0..128], 0);
+            for (order[0..take]) |b| for (b * c.block..@min(b * c.block + c.block, p + 1)) |j| {
+                const w = @exp(sm[j] - mx);
+                z += w;
+                for (0..128) |e| ao[h * 128 + e] += w * vs[j * 256 + g * 128 + e];
+            };
+            for (ao[h * 128 ..][0..128]) |*v| v.* /= z;
+        }
+    }
+    const h = try a.dupe(f64, m.embed[toks[p] * 128 ..][0..128]);
+    var o: [128]f64 = undefined;
+    proj(ly.o, ao, &o);
+    for (h, o) |*x, y| x.* += y;
+    return h;
+}
+
+fn checkOracle(c: ref.Config, n: usize) !void {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const m = try synth.model(a, c, .{});
+    const toks = try synth.tokens(a, n, 128, 12);
+    const lc = (try ref.Cache.init(a, c, 1, n)).layers;
+    var h: [128]f64 = undefined;
+    for (toks, 0..) |t, pos| {
+        @memcpy(&h, m.embed[t * 128 ..][0..128]);
+        try ref.attention(c, m.layers[0], &lc[0], &h, pos, a);
+    }
+    const want = try oracle(a, m, toks);
+    for (want, h) |p, q| try std.testing.expectApproxEqAbs(p, q, 1e-12);
+}
+
+test "layer attention equals a from-scratch brute-force derivation (70 tokens x 16-key blocks; 130 tokens x 128-key blocks)" {
+    try checkOracle(small(.{}), 70);
+    var c = synth.tiny(.{});
+    c.topk_blocks = 1;
+    try checkOracle(c, 130);
+    try checkOracle(c, 129);
+    try checkOracle(c, 128);
+}
+
+const Case = struct { name: []const u8, sw: ref.Switches };
+
+test "every UNVERIFIED switch changes the model's output (default vs the other branch)" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const toks = try synth.tokens(a, 70, 128, 21);
+    const base = try run(a, small(.{}), .{}, toks);
+    const cases = [_]Case{
+        .{ .name = "rope gptj", .sw = .{ .rope_layout = .gptj_interleaved } },
+        .{ .name = "index_rope off", .sw = .{ .index_rope = false } },
+        .{ .name = "init count 1", .sw = .{ .sparse_init_block = 1 } },
+        .{ .name = "init inclusive", .sw = .{ .init_mode = .inclusive } },
+        .{ .name = "local 0", .sw = .{ .sparse_local_block = 0 } },
+        .{ .name = "local window 2", .sw = .{ .local_mode = .trailing_window, .sparse_local_block = 2 } },
+        .{ .name = "w1 is up", .sw = .{ .w1_is_gate = false } },
+        .{ .name = "up_plus_one off", .sw = .{ .up_plus_one = false } },
+        .{ .name = "router scale only", .sw = .{ .router_norm = .scale_only } },
+        .{ .name = "router normalize only", .sw = .{ .router_norm = .normalize_only } },
+        .{ .name = "router bias in weights", .sw = .{ .router_weights_use_bias = true } },
+        .{ .name = "scale routed+shared", .sw = .{ .scale_on = .routed_plus_shared } },
+        .{ .name = "plain layer norms", .sw = .{ .gemma_layer_norms = false } },
+        .{ .name = "plain qk norms", .sw = .{ .gemma_qk_norms = false } },
+        .{ .name = "plain index norms", .sw = .{ .gemma_index_norms = false } },
+        .{ .name = "bf16 norm", .sw = .{ .bf16_norm_out = true } },
+        .{ .name = "bf16 proj", .sw = .{ .bf16_proj_out = true } },
+        .{ .name = "bf16 rope", .sw = .{ .bf16_rope_out = true } },
+        .{ .name = "bf16 attn", .sw = .{ .bf16_attn_out = true } },
+        .{ .name = "bf16 act", .sw = .{ .bf16_act_out = true } },
+        .{ .name = "bf16 residual", .sw = .{ .bf16_residual = true } },
+    };
+    for (cases) |cs| {
+        const x = try run(a, small(cs.sw), .{}, toks);
+        const d = synth.maxDiff(base, x);
+        std.testing.expect(d > 1e-9 and std.math.isFinite(d)) catch |e| {
+            std.debug.print("switch {s} did not change the output (diff {e})\n", .{ cs.name, d });
+            return e;
+        };
+    }
+}
+
+test "switches that need a special scenario: gate clamp (large activations) and the tie rule (all block scores equal)" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const toks = try synth.tokens(a, 20, 128, 5);
+    const big: synth.Options = .{ .gain = 60 };
+    const upper = try run(a, small(.{}), big, toks);
+    const sym = try run(a, small(.{ .gate_clamp = .symmetric }), big, toks);
+    try expect(synth.maxDiff(upper, sym) > 1e-9);
+    const flat: synth.Options = .{ .zero_index_q = true };
+    const long = try synth.tokens(a, 70, 128, 5);
+    const lo = try run(a, small(.{}), flat, long);
+    const hi = try run(a, small(.{ .tie = .higher_block }), flat, long);
+    try expect(synth.maxDiff(lo, hi) > 1e-9);
+    const again = try run(a, small(.{}), flat, long);
+    try std.testing.expectEqualSlices(f64, lo, again);
+}
+
+test "bf16 residual switch leaves the hidden state on the bf16 grid after attention and after the MoE FFN" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const m = try synth.model(a, small(.{ .bf16_residual = true }), .{});
+    const cache = try ref.Cache.init(a, m.cfg, 2, 4);
+    const h = try a.dupe(f64, m.embed[3 * 128 ..][0..128]);
+    try ref.attention(m.cfg, m.layers[1], &cache.layers[1], h, 0, a);
+    for (h) |v| try std.testing.expectEqual(core.bf16_round.bf16(v), v);
+    @memset(h, 0.3);
+    try ref.feedForward(m.cfg, m.layers[1], h, a);
+    for (h) |v| try std.testing.expectEqual(core.bf16_round.bf16(v), v);
+    var any = false;
+    for (h) |v| any = any or v != 0.3;
+    try expect(any);
+}
+
+test "fp16 index input changes the cached index keys (selection may not flip, the keys do)" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const m = try synth.model(a, small(.{}), .{});
+    var m16 = m;
+    m16.cfg.sw.fp16_index_input = true;
+    const toks = try synth.tokens(a, 5, 128, 3);
+    const c0 = try ref.Cache.init(a, m.cfg, 1, 5);
+    const c1 = try ref.Cache.init(a, m.cfg, 1, 5);
+    for (toks, 0..) |t, pos| {
+        const h0 = try a.dupe(f64, m.embed[t * 128 ..][0..128]);
+        const h1 = try a.dupe(f64, h0);
+        try ref.attention(m.cfg, m.layers[0], &c0.layers[0], h0[0..], pos, a);
+        try ref.attention(m16.cfg, m16.layers[0], &c1.layers[0], h1[0..], pos, a);
+    }
+    try expect(synth.maxDiff(c0.layers[0].ik, c1.layers[0].ik) > 1e-9);
+    try std.testing.expectEqualSlices(f64, c0.layers[0].v, c1.layers[0].v);
+}
diff --git a/zig/tests/minimax_ref_synth.zig b/zig/tests/minimax_ref_synth.zig
new file mode 100644
index 0000000..e4cd6d7
--- /dev/null
+++ b/zig/tests/minimax_ref_synth.zig
@@ -0,0 +1,129 @@
+//! Synthetic MiniMax weights for the CPU reference tests: random EXL3 mul1 trellises at 6 to 12 halves, plain tensors.
+const std = @import("std");
+const core = @import("core");
+const ref = @import("minimax_ref");
+const exl3 = core.exl3_format;
+
+pub const Options = struct {
+    seed: u64 = 1,
+    n_layers: usize = 2,
+    vocab: usize = 128,
+    /// Multiplies every MLP matrix (expert, shared, dense) so activations reach swigluoai's limit.
+    gain: f64 = 1,
+    /// Zero index_q_proj: every block score is exactly 0, so only the tie rule picks blocks.
+    zero_index_q: bool = false,
+};
+
+pub fn tiny(sw: ref.Switches) ref.Config {
+    return .{ .hidden = 128, .n_q = 4, .n_kv = 2, .n_index = 2, .topk_blocks = 2, .n_experts = 8, .experts_topk = 2, .sw = sw };
+}
+
+pub const Gen = struct {
+    a: std.mem.Allocator,
+    rng: std.Random.DefaultPrng,
+
+    fn uni(g: *Gen) f64 {
+        return g.rng.random().float(f64) * 2 - 1;
+    }
+
+    fn vec(g: *Gen, n: usize, scale: f64, bf16: bool) ![]f64 {
+        const v = try g.a.alloc(f64, n);
+        for (v) |*x| x.* = if (bf16) core.bf16_round.bf16(g.uni() * scale) else g.uni() * scale;
+        return v;
+    }
+
+    /// A plain matrix as the checkpoint stores fp16 (index) or fp32 (router) weights: fp16 rounded when `half`.
+    fn plain(g: *Gen, k: usize, n: usize, gain: f64, half: bool) !ref.Linear {
+        const w = try g.vec(k * n, gain * 1.7 / @sqrt(@as(f64, @floatFromInt(k))), false);
+        if (half) for (w) |*x| {
+            const h: f16 = @floatCast(x.*);
+            x.* = h;
+        };
+        return .{ .k = k, .n = n, .w = w };
+    }
+
+    /// An EXL3 mul1 matrix of `halves` (6, 8, 10, 12 = 3..6 bits) from random trellis words, suh and svh.
+    pub fn exl3Linear(g: *Gen, halves: u16, k: usize, n: usize, gain: f64) !ref.Linear {
+        const tiles_k = k / 16;
+        const tiles_n = n / 16;
+        const trellis = try g.a.alloc(i16, tiles_k * tiles_n * @as(usize, halves) * 8);
+        for (trellis) |*t| t.* = @bitCast(g.rng.random().int(u16));
+        const suh = try g.a.alloc(f16, k);
+        const svh = try g.a.alloc(f16, n);
+        for (suh) |*s| s.* = @floatCast(if (g.rng.random().boolean()) @as(f64, 1) else -1);
+        const amp = gain / @sqrt(@as(f64, @floatFromInt(k)));
+        for (svh) |*s| s.* = @floatCast((if (g.rng.random().boolean()) @as(f64, 1) else -1) * amp * (0.5 + g.rng.random().float(f64)));
+        const w = try g.a.alloc(f64, k * n);
+        const scratch = try g.a.alloc(f64, 2 * k * n);
+        exl3.dequantize(.{ .halves = halves }, .mul1, trellis, tiles_k, tiles_n, suh, svh, w, scratch);
+        return .{ .k = k, .n = n, .w = w };
+    }
+
+    fn mlp(g: *Gen, h: usize, inter: usize, halves: u16, gain: f64) !ref.Mlp {
+        return .{ .w1 = try g.exl3Linear(halves, h, inter, gain), .w3 = try g.exl3Linear(halves, h, inter, gain), .w2 = try g.exl3Linear(halves, inter, h, gain) };
+    }
+};
+
+pub fn gen(a: std.mem.Allocator, seed: u64) Gen {
+    return .{ .a = a, .rng = std.Random.DefaultPrng.init(seed) };
+}
+
+/// A model of `o.n_layers` layers: layer 0 dense (5-bit), the rest MoE (experts 3/4-bit alternating, shared 5-bit).
+pub fn model(a: std.mem.Allocator, c: ref.Config, o: Options) !ref.Model {
+    var g = Gen{ .a = a, .rng = std.Random.DefaultPrng.init(o.seed) };
+    const h = c.hidden;
+    const d = c.head_dim;
+    const layers = try a.alloc(ref.Layer, o.n_layers);
+    for (layers, 0..) |*ly, li| {
+        const experts = try a.alloc(ref.Mlp, if (li == 0) 0 else c.n_experts);
+        for (experts) |*e| e.* = try g.mlp(h, 128, if (li % 2 == 1) 8 else 6, o.gain);
+        ly.* = .{
+            .input_norm = try g.vec(h, 0.3, true),
+            .post_norm = try g.vec(h, 0.3, true),
+            .q = try g.exl3Linear(12, h, c.n_q * d, 1),
+            .k = try g.exl3Linear(12, h, c.n_kv * d, 1),
+            .v = try g.exl3Linear(12, h, c.n_kv * d, 1),
+            .o = try g.exl3Linear(12, c.n_q * d, h, 1),
+            .q_norm = try g.vec(d, 0.3, true),
+            .k_norm = try g.vec(d, 0.3, true),
+            .index_q = try g.plain(h, c.n_index * d, if (o.zero_index_q) 0 else 1, true),
+            .index_k = try g.plain(h, d, 1, true),
+            .index_q_norm = try g.vec(d, 0.3, true),
+            .index_k_norm = try g.vec(d, 0.3, true),
+            .ffn = if (li == 0) .{ .dense = try g.mlp(h, 256, 10, o.gain) } else .{ .moe = .{
+                .gate = try g.plain(h, c.n_experts, 1, false),
+                .bias = try g.vec(c.n_experts, 0.1, false),
+                .experts = experts,
+                .shared = try g.mlp(h, 128, 10, o.gain),
+            } },
+        };
+    }
+    return .{
+        .cfg = c,
+        .embed = try g.vec(o.vocab * h, 1, true),
+        .layers = layers,
+        .final_norm = try g.vec(h, 0.3, true),
+        .head = try g.exl3Linear(12, h, o.vocab, 1),
+    };
+}
+
+/// Logits after every position of `tokens`, [tokens.len][vocab].
+pub fn trace(a: std.mem.Allocator, m: ref.Model, toks: []const usize, vocab: usize) ![]f64 {
+    const cache = try ref.Cache.init(a, m.cfg, m.layers.len, toks.len);
+    const out = try a.alloc(f64, toks.len * vocab);
+    for (toks, 0..) |t, pos| try ref.step(m, cache, t, pos, out[pos * vocab ..][0..vocab], a);
+    return out;
+}
+
+pub fn maxDiff(x: []const f64, y: []const f64) f64 {
+    var m: f64 = 0;
+    for (x, y) |p, q| m = @max(m, @abs(p - q));
+    return m;
+}
+
+pub fn tokens(a: std.mem.Allocator, n: usize, vocab: usize, seed: u64) ![]usize {
+    var rng = std.Random.DefaultPrng.init(seed);
+    const t = try a.alloc(usize, n);
+    for (t) |*x| x.* = rng.random().uintLessThan(usize, vocab);
+    return t;
+}
