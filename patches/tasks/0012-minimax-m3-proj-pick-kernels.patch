+            try testing.expectEqual(w.threads, u.bound);
+            try testing.expect(u.regs * w.threads <= 65536);
+        }
+        m.* = rec;
+    }
+    try testing.expectEqual(@as(usize, 0), try registry.checkCuda(testing.allocator, &mine, true));
+    var over = mine[2];
+    over.launch.threads = 512;
