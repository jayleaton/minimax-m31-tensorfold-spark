diff --git a/zig/kernels/cuda/minimax_m3_attn.cu b/zig/kernels/cuda/minimax_m3_attn.cu
new file mode 100644
index 0000000..f7b1851
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_attn.cu
@@ -0,0 +1,127 @@
+// MiniMax-M3.1-Flash selected-block GQA attention (float64 reference: core/minimax_ref.zig attendBlocks).
+// One CTA per (row, kv head): the 16 query heads of the group share one K/V stream over the row's selected blocks, taken in
+// the select kernel's ascending order, 32 keys at a time with an online softmax. The key order, the 32-key tile and the
+// fp32 chains are fixed by the row's own selection alone, so a row's bits do not depend on the window width, on the other
+// rows of a call, or on whether the call is a decode window or a prompt chunk (pos null: pos0 + r).
+// Keys past the row's position are never read (an unwritten page may hold NaN) and a -1 entry ends the list.
+// Scores: sequential fp32 dot over d = 0..127, then times `scale`; softmax weights expf(s - m) in fp32; P.V in key order.
+#include "minimax_m3_sparse.cuh"
+
+using namespace tf_mm3;
+
+namespace {
+
+constexpr int TILE = 32;     // keys a step
+constexpr int KSTRIDE = 136; // K row stride in shared (bf16): 272 B, 16-byte aligned and not a bank multiple
+
+/// max that propagates a NaN (the float64 reference's softmax does).
+__device__ __forceinline__ float nmax(float a, float b) {
+    if (a != a) return a;
+    if (b != b) return b;
+    return a > b ? a : b;
+}
+
+__device__ __forceinline__ uint32_t pack2(float a, float b) {
+    __nv_bfloat162 v = __floats2bfloat162_rn(a, b);
+    return *reinterpret_cast<uint32_t*>(&v);
+}
+
+} // namespace
+
+extern "C" __global__ void __launch_bounds__(256) tf_mm3_attn(
+    const bf16* __restrict__ q,        // [rows, kvh * 16, 128] post norm and rotary
+    const int* __restrict__ sel,       // [rows, kvh, 16] ascending block ids, -1 padded
+    const int* __restrict__ pos,
+    int pos0,
+    const int* __restrict__ row_tab,
+    const int* __restrict__ tables,
+    const char* __restrict__ pool,
+    long long page_bytes, long long layer_off,
+    int kvh,
+    bf16* __restrict__ out,            // [rows, kvh * 16, 128]
+    float scale) {
+    const int r = blockIdx.x, g = blockIdx.y, t = threadIdx.x;
+    const int h = t >> 4, c = t & 15; // query head of the group, 8-dim slice of its output
+    const int p = row_pos(pos, pos0, r);
+    const int* tab = tables + row_table(row_tab, r);
+    const int* ids = sel + ((long long)r * kvh + g) * TOPK;
+    const long long head = ((long long)r * kvh + g) * GROUP + h;
+
+    __shared__ float sq[GROUP * D];
+    __shared__ __align__(16) bf16 sk[TILE * KSTRIDE];
+    __shared__ __align__(16) bf16 sv[TILE * D];
+    __shared__ float sp[GROUP * TILE];
+
+    {
+        const uint4 w = __ldg(reinterpret_cast<const uint4*>(q + head * D) + c);
+        float* d = sq + h * D + c * 8;
+        d[0] = lo(w.x); d[1] = hi(w.x); d[2] = lo(w.y); d[3] = hi(w.y);
+        d[4] = lo(w.z); d[5] = hi(w.z); d[6] = lo(w.w); d[7] = hi(w.w);
+    }
+    float o[8];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) o[i] = 0.f;
+    float m = -INFINITY, l = 0.f;
+
+    for (int s = 0; s < TOPK; ++s) {
+        const int b = ids[s];
+        if (b < 0) break;
+        const char* base = page_layer(pool, page_bytes, layer_off, __ldg(tab + b));
+        const bf16* kb = reinterpret_cast<const bf16*>(base) + kv_elem(kvh, 0, g, 0);
+        const bf16* vb = reinterpret_cast<const bf16*>(base) + kv_elem(kvh, 1, g, 0);
+        for (int k0 = 0; k0 < BLOCK; k0 += TILE) {
+            const int nvalid = min(TILE, p + 1 - (b * BLOCK + k0));
+            if (nvalid <= 0) break;
+            __syncthreads();
+            for (int i = t; i < TILE * 16; i += 256) {
+                const int row = i >> 4, vec = i & 15;
+                uint4 kw = make_uint4(0, 0, 0, 0), vw = kw;
+                if (row < nvalid) {
+                    kw = __ldg(reinterpret_cast<const uint4*>(kb + (long long)(k0 + row) * D) + vec);
+                    vw = __ldg(reinterpret_cast<const uint4*>(vb + (long long)(k0 + row) * D) + vec);
+                }
+                *reinterpret_cast<uint4*>(sk + row * KSTRIDE + vec * 8) = kw;
+                *reinterpret_cast<uint4*>(sv + row * D + vec * 8) = vw;
+            }
+            __syncthreads();
+            for (int u = 0; u < 2; ++u) {
+                const int j = c + 16 * u;
+                if (j >= nvalid) continue;
+                const float* qh = sq + h * D;
+                const uint32_t* kr = reinterpret_cast<const uint32_t*>(sk + j * KSTRIDE);
+                float a = 0.f;
+#pragma unroll 8
+                for (int e = 0; e < D / 2; ++e) {
+                    const uint32_t w = kr[e];
+                    a = __fadd_rn(a, __fmul_rn(qh[2 * e], lo(w)));
+                    a = __fadd_rn(a, __fmul_rn(qh[2 * e + 1], hi(w)));
+                }
+                sp[h * TILE + j] = __fmul_rn(a, scale);
+            }
+            __syncthreads();
+            float mt = sp[h * TILE];
+            for (int j = 1; j < nvalid; ++j) mt = nmax(mt, sp[h * TILE + j]);
+            const float mn = nmax(m, mt);
+            const float alpha = (m == -INFINITY) ? 0.f : expf(__fsub_rn(m, mn));
+            l = __fmul_rn(l, alpha);
+#pragma unroll
+            for (int i = 0; i < 8; ++i) o[i] = __fmul_rn(o[i], alpha);
+            for (int j = 0; j < nvalid; ++j) {
+                const float pj = expf(__fsub_rn(sp[h * TILE + j], mn));
+                l = __fadd_rn(l, pj);
+                const uint4 vw = *reinterpret_cast<const uint4*>(sv + j * D + c * 8);
+                o[0] = __fadd_rn(o[0], __fmul_rn(pj, lo(vw.x))); o[1] = __fadd_rn(o[1], __fmul_rn(pj, hi(vw.x)));
+                o[2] = __fadd_rn(o[2], __fmul_rn(pj, lo(vw.y))); o[3] = __fadd_rn(o[3], __fmul_rn(pj, hi(vw.y)));
+                o[4] = __fadd_rn(o[4], __fmul_rn(pj, lo(vw.z))); o[5] = __fadd_rn(o[5], __fmul_rn(pj, hi(vw.z)));
+                o[6] = __fadd_rn(o[6], __fmul_rn(pj, lo(vw.w))); o[7] = __fadd_rn(o[7], __fmul_rn(pj, hi(vw.w)));
+            }
+            m = mn;
+        }
+    }
+    uint4 w;
+    w.x = pack2(__fdiv_rn(o[0], l), __fdiv_rn(o[1], l));
+    w.y = pack2(__fdiv_rn(o[2], l), __fdiv_rn(o[3], l));
+    w.z = pack2(__fdiv_rn(o[4], l), __fdiv_rn(o[5], l));
+    w.w = pack2(__fdiv_rn(o[6], l), __fdiv_rn(o[7], l));
+    reinterpret_cast<uint4*>(out + head * D)[c] = w;
+}
diff --git a/zig/kernels/cuda/minimax_m3_index.cu b/zig/kernels/cuda/minimax_m3_index.cu
new file mode 100644
index 0000000..21496a3
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_index.cu
@@ -0,0 +1,48 @@
+// MiniMax-M3.1-Flash index scoring and per-128-key block maxima (float64 reference: core/minimax_ref.zig blockScores).
+//   s[j] = (iq[g] . IK[j]) * scale   for keys j <= pos of a row, fp32; bmax[r][g][b] = max over the block's valid keys.
+// One CTA per (block, index head g, row): 4 warps, a warp scores its keys one at a time with the 32 lanes split over the
+// 128 dims (4 each, fixed order) and a fixed xor tree, so a score's bits depend on nothing but its two vectors.
+// NaN rule (stated, matches the reference): fmax drops a NaN key score; a block whose keys are all NaN scores -inf.
+#include "minimax_m3_sparse.cuh"
+
+using namespace tf_mm3;
+
+extern "C" __global__ void __launch_bounds__(128) tf_mm3_index(
+    const bf16* __restrict__ iq,       // [rows, kvh, 128] post norm and rotary
+    const int* __restrict__ pos,       // [rows] or null (pos0 + r)
+    int pos0,
+    const int* __restrict__ row_tab,   // [rows] offsets into tables, or null
+    const int* __restrict__ tables,    // page ids by block
+    const char* __restrict__ pool,
+    long long page_bytes, long long layer_off,
+    int kvh,
+    float* __restrict__ bmax,          // [rows, kvh, bm_stride]
+    int bm_stride,
+    float scale) {
+    const int b = blockIdx.x, g = blockIdx.y, r = blockIdx.z;
+    const int p = row_pos(pos, pos0, r);
+    if (b > p / BLOCK) return;
+    const int page = __ldg(tables + row_table(row_tab, r) + b);
+    const char* base = page_layer(pool, page_bytes, layer_off, page);
+    const bf16* ik = reinterpret_cast<const bf16*>(base) + ik_elem(kvh, 0);
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const uint2 qw = __ldg(reinterpret_cast<const uint2*>(iq + ((long long)r * kvh + g) * D) + lane);
+    const float q0 = lo(qw.x), q1 = hi(qw.x), q2 = lo(qw.y), q3 = hi(qw.y);
+    const int valid = min(BLOCK, p + 1 - b * BLOCK);
+    float best = -INFINITY;
+    for (int j = warp; j < valid; j += 4) {
+        const uint2 kw = __ldg(reinterpret_cast<const uint2*>(ik + (long long)j * D) + lane);
+        float a = __fmul_rn(q0, lo(kw.x));
+        a = __fadd_rn(a, __fmul_rn(q1, hi(kw.x)));
+        a = __fadd_rn(a, __fmul_rn(q2, lo(kw.y)));
+        a = __fadd_rn(a, __fmul_rn(q3, hi(kw.y)));
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) a = __fadd_rn(a, __shfl_xor_sync(0xffffffffu, a, o));
+        best = fmaxf(best, __fmul_rn(a, scale));
+    }
+    __shared__ float part[4];
+    if (lane == 0) part[warp] = best;
+    __syncthreads();
+    if (threadIdx.x == 0)
+        bmax[((long long)r * kvh + g) * bm_stride + b] = fmaxf(fmaxf(part[0], part[1]), fmaxf(part[2], part[3]));
+}
diff --git a/zig/kernels/cuda/minimax_m3_select.cu b/zig/kernels/cuda/minimax_m3_select.cu
new file mode 100644
index 0000000..f701db5
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_select.cu
@@ -0,0 +1,81 @@
+// MiniMax-M3.1-Flash forced-block top-16 (float64 reference: core/minimax_ref.zig forced, topk, selectBlocks).
+// A row with nb = pos / 128 + 1 blocks attends all of them when nb <= 16, else the 16 best by (score desc, then block id
+// by the tie rule) with forced blocks scored +inf. The forcing rules and the tie rule are UNVERIFIED upstream semantics,
+// so they are launch parameters mirroring minimax_ref.Switches: init_n/init_inclusive (sparse_init_block count or
+// inclusive), local_n/local_trailing (sparse_local_block as "own block if > 0" or "trailing window of n"), higher_tie.
+// A NaN block score ranks as -inf (the reference's rule). Output: ascending block ids, -1 padded, per (row, kv head).
+#include "minimax_m3_sparse.cuh"
+
+using namespace tf_mm3;
+
+namespace {
+
+__device__ __forceinline__ bool forced(int b, int own, int init_n, int init_inclusive, int local_n, int local_trailing) {
+    const bool init = init_inclusive ? b <= init_n : b < init_n;
+    const bool local = local_trailing ? (b <= own && own - b < local_n) : (local_n > 0 && b == own);
+    return init || local;
+}
+
+/// True when (sa, ia) ranks strictly before (sb, ib): larger score, then the tie rule's block id.
+__device__ __forceinline__ bool before(float sa, int ia, float sb, int ib, int higher) {
+    return sa > sb || (sa == sb && (higher ? ia > ib : ia < ib));
+}
+
+} // namespace
+
+extern "C" __global__ void __launch_bounds__(256) tf_mm3_select(
+    const float* __restrict__ bmax,    // [rows, kvh, bm_stride]
+    const int* __restrict__ pos,
+    int pos0,
+    int* __restrict__ sel,             // [rows, kvh, 16]
+    int kvh, int bm_stride,
+    int init_n, int init_inclusive, int local_n, int local_trailing, int higher_tie) {
+    const int g = blockIdx.x, r = blockIdx.y;
+    const int p = row_pos(pos, pos0, r);
+    const int nb = p / BLOCK + 1, own = nb - 1;
+    int* out = sel + ((long long)r * kvh + g) * TOPK;
+    const int t = threadIdx.x;
+    if (nb <= TOPK) {
+        if (t < TOPK) out[t] = t < nb ? t : -1;
+        return;
+    }
+    const float* sc = bmax + ((long long)r * kvh + g) * bm_stride;
+    __shared__ float ws[8];
+    __shared__ int wi[8];
+    __shared__ int chosen[TOPK];
+    __shared__ float prev_s;
+    __shared__ int prev_i;
+    for (int k = 0; k < TOPK; ++k) {
+        float bs = -INFINITY;
+        int bi = -1;
+        for (int b = t; b < nb; b += 256) {
+            float s = forced(b, own, init_n, init_inclusive, local_n, local_trailing) ? INFINITY : __ldg(sc + b);
+            if (s != s) s = -INFINITY;
+            if (k > 0 && !before(prev_s, prev_i, s, b, higher_tie)) continue;
+            if (bi < 0 || before(s, b, bs, bi, higher_tie)) { bs = s; bi = b; }
+        }
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) {
+            const float os = __shfl_xor_sync(0xffffffffu, bs, o);
+            const int oi = __shfl_xor_sync(0xffffffffu, bi, o);
+            if (oi >= 0 && (bi < 0 || before(os, oi, bs, bi, higher_tie))) { bs = os; bi = oi; }
+        }
+        if ((t & 31) == 0) { ws[t >> 5] = bs; wi[t >> 5] = bi; }
+        __syncthreads();
+        if (t == 0) {
+            float s = ws[0];
+            int i = wi[0];
+            for (int w = 1; w < 8; ++w)
+                if (wi[w] >= 0 && (i < 0 || before(ws[w], wi[w], s, i, higher_tie))) { s = ws[w]; i = wi[w]; }
+            chosen[k] = i;
+            prev_s = s;
+            prev_i = i;
+        }
+        __syncthreads();
+    }
+    if (t < TOPK) {
+        int rank = 0;
+        for (int u = 0; u < TOPK; ++u) rank += chosen[u] < chosen[t];
+        out[rank] = chosen[t];
+    }
+}
diff --git a/zig/kernels/cuda/minimax_m3_sparse.cuh b/zig/kernels/cuda/minimax_m3_sparse.cuh
new file mode 100644
index 0000000..2462163
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_sparse.cuh
@@ -0,0 +1,49 @@
+// MiniMax-M3.1-Flash block-sparse attention: constants and paged addressing shared by minimax_m3_{index,select,attn}.cu.
+// Semantics: core/minimax_ref.zig (float64). Nothing here is copied from another project; written from the formulas in
+// the engine-port plan (section 2, T5).
+//
+// Page = 128 tokens = one selection block. Inside one page and one layer (head-major, bf16):
+//   K[kvh][128 tok][128] | V[kvh][128][128] | IK[128 tok][128]
+// A pool address is  base + page * page_bytes + layer_off + element offset * 2; the kernels take page ids from a block
+// table (tables[row_tab[r] + block]), never an address, so a pool may move or grow between launches.
+#pragma once
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+#include <math.h>
+#include <stdint.h>
+
+namespace tf_mm3 {
+
+constexpr int D = 128;     // head_dim and index_head_dim
+constexpr int BLOCK = 128; // keys a selection block (= tokens a page)
+constexpr int TOPK = 16;   // blocks a row attends (sparse_topk_blocks)
+constexpr int GROUP = 16;  // query heads a kv head (64 / 4)
+
+typedef __nv_bfloat16 bf16;
+
+__device__ __forceinline__ float bf(uint32_t half_bits) { return __uint_as_float(half_bits << 16); }
+__device__ __forceinline__ float lo(uint32_t w) { return __uint_as_float(w << 16); }
+__device__ __forceinline__ float hi(uint32_t w) { return __uint_as_float(w & 0xffff0000u); }
+
+constexpr long long K_ELEMS = (long long)BLOCK * D; // one head's block of K (or V)
+
+/// Element offset (bf16) of K (which 0) or V (which 1) head h, token t inside a page's layer region.
+__device__ __forceinline__ long long kv_elem(int kvh, int which, int h, int t) {
+    return ((long long)which * kvh + h) * K_ELEMS + (long long)t * D;
+}
+
+/// Element offset of index-key token t.
+__device__ __forceinline__ long long ik_elem(int kvh, int t) { return 2LL * kvh * K_ELEMS + (long long)t * D; }
+
+__device__ __forceinline__ const char* page_layer(const char* pool, long long page_bytes, long long layer_off, int page) {
+    return pool + (long long)page * page_bytes + layer_off;
+}
+
+/// A row's position: pos[r], or pos0 + r when pos is null (a prompt chunk of one stream).
+__device__ __forceinline__ int row_pos(const int* pos, int pos0, int r) { return pos ? __ldg(pos + r) : pos0 + r; }
+
+/// Offset of a row's block table in `tables` (row_tab null: one table for every row).
+__device__ __forceinline__ int row_table(const int* row_tab, int r) { return row_tab ? __ldg(row_tab + r) : 0; }
+
+} // namespace tf_mm3
