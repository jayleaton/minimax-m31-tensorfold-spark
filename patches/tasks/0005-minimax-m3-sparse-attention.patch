diff --git a/zig/src/cuda/minimax_m3_geom.zig b/zig/src/cuda/minimax_m3_geom.zig
new file mode 100644
index 0000000..5122d24
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_geom.zig
@@ -0,0 +1,120 @@
+//! MiniMax-M3.1-Flash sparse attention: paged cache addressing, launch geometry and memory sizing (std only, host-testable).
+//! Mirrors zig/kernels/cuda/minimax_m3_sparse.cuh; the engine-port plan (sections 2 and 5) gives the numbers.
+const std = @import("std");
+
+pub const d = 128; // head_dim and index_head_dim
+pub const block = 128; // keys a selection block = tokens a page
+pub const topk = 16; // blocks a row attends
+pub const group = 16; // query heads a kv head
+pub const bf16_bytes = 2;
+
+pub const index_threads = 128;
+pub const select_threads = 256;
+pub const attn_threads = 256;
+/// Static shared bytes the attention kernel declares: sq 8 KiB + sk 8.5 KiB + sv 8 KiB + sp 2 KiB (plus 1 KiB reserved).
+pub const attn_static_shared = (group * d + group * 32) * 4 + (32 * 136 + 32 * d) * bf16_bytes;
+/// Scores a block at 1 key a warp step: the index kernel's reduction tree (32 lanes, offsets 16..1) is fixed.
+pub const max_grid_z = 65535;
+
+/// One rank's cache: `kvh` local kv heads (2 of 4 on a two-rank split) and the layers it holds.
+pub const Pool = struct {
+    kvh: usize,
+    layers: usize,
+
+    /// Bytes one page holds for one layer: K and V for each local head, plus the shared index keys.
+    pub fn layerBytes(p: Pool) usize {
+        return block * (2 * p.kvh * d + d) * bf16_bytes;
+    }
+    pub fn pageBytes(p: Pool) usize {
+        return p.layers * p.layerBytes();
+    }
+    pub fn tokenBytes(p: Pool) usize {
+        return p.pageBytes() / block;
+    }
+    pub fn layerOff(p: Pool, layer: usize) usize {
+        return layer * p.layerBytes();
+    }
+    /// Byte offset from the pool base of K (which 0) or V (which 1), local head h, token t of a page, in a layer.
+    pub fn kv(p: Pool, page: usize, layer: usize, which: usize, h: usize, t: usize) usize {
+        return page * p.pageBytes() + p.layerOff(layer) + ((which * p.kvh + h) * block + t) * d * bf16_bytes;
+    }
+    pub fn ik(p: Pool, page: usize, layer: usize, t: usize) usize {
+        return page * p.pageBytes() + p.layerOff(layer) + (2 * p.kvh * block + t) * d * bf16_bytes;
+    }
+    pub fn pagesFor(tokens: usize) usize {
+        return (tokens + block - 1) / block;
+    }
+    /// Cache bytes of a stream holding `tokens` (whole pages).
+    pub fn bytesFor(p: Pool, tokens: usize) usize {
+        return pagesFor(tokens) * p.pageBytes();
+    }
+    /// Most tokens (a whole number of pages) that fit in `bytes`.
+    pub fn tokensFitting(p: Pool, bytes: usize) usize {
+        return bytes / p.pageBytes() * block;
+    }
+};
+
+/// Blocks a row at `pos` can see (the last is its own and may be partial).
+pub fn blocks(pos: usize) usize {
+    return pos / block + 1;
+}
+/// Valid keys of the row's own block (causal): pos % 128 + 1.
+pub fn ownKeys(pos: usize) usize {
+    return pos % block + 1;
+}
+/// Blocks a row attends: all when it has at most 16, else 16.
+pub fn selected(pos: usize) usize {
+    return @min(topk, blocks(pos));
+}
+/// Keys a row attends when its own block is among the selected (always so with the default forcing).
+pub fn keysAttended(pos: usize) usize {
+    return if (blocks(pos) <= topk) pos + 1 else (topk - 1) * block + ownKeys(pos);
+}
+/// 32-key steps the attention kernel runs for that row.
+pub fn attnSteps(pos: usize) usize {
+    const full = (selected(pos) - 1) * (block / 32);
+    return full + (ownKeys(pos) + 31) / 32;
+}
+
+pub const Launch = struct { grid: [3]u32, block: u32, dynamic_shared: u32 = 0 };
+
+/// Scoring: a CTA per (block, kv head, row); `max_pos` is the largest position of the rows.
+pub fn indexLaunch(rows: usize, kvh: usize, max_pos: usize) Launch {
+    return .{ .grid = .{ @intCast(blocks(max_pos)), @intCast(kvh), @intCast(rows) }, .block = index_threads };
+}
+pub fn selectLaunch(rows: usize, kvh: usize) Launch {
+    return .{ .grid = .{ @intCast(kvh), @intCast(rows), 1 }, .block = select_threads };
+}
+pub fn attnLaunch(rows: usize, kvh: usize) Launch {
+    return .{ .grid = .{ @intCast(rows), @intCast(kvh), 1 }, .block = attn_threads };
+}
+
+/// fp32 block maxima [rows, kvh, stride]; the stride is the block-table length (>= blocks(max_pos)).
+pub fn bmaxBytes(rows: usize, kvh: usize, stride: usize) usize {
+    return rows * kvh * stride * 4;
+}
+/// int32 selected-block lists [rows, kvh, 16].
+pub fn selBytes(rows: usize, kvh: usize) usize {
+    return rows * kvh * topk * 4;
+}
+/// IK bytes one scoring pass reads from the cache for a row at `pos` (one shared key head, 256 B a token).
+pub fn indexReadBytes(pos: usize) usize {
+    return (pos + 1) * d * bf16_bytes;
+}
+
+pub const LaunchError = error{ TooManyRows, KvHeads, Empty };
+
+pub fn check(rows: usize, kvh: usize) LaunchError!void {
+    if (rows == 0) return error.Empty;
+    if (rows > max_grid_z) return error.TooManyRows;
+    if (kvh == 0 or kvh > 4) return error.KvHeads;
+}
+
+/// The select kernel's launch arguments; the defaults are core/minimax_ref.zig's Switches defaults (UNVERIFIED upstream).
+pub const Rules = struct {
+    init_n: i32 = 0,
+    init_inclusive: bool = false,
+    local_n: i32 = 1,
+    local_trailing: bool = false,
+    higher_tie: bool = false,
+};
diff --git a/zig/src/cuda/minimax_m3_sparse.zig b/zig/src/cuda/minimax_m3_sparse.zig
new file mode 100644
index 0000000..6960301
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_sparse.zig
@@ -0,0 +1,142 @@
+//! MiniMax-M3.1-Flash block-sparse attention launches: index scoring + block maxima, forced-block top-16, selected-block
+//! GQA attention (zig/kernels/cuda/minimax_m3_{index,select,attn}.cu). K/V/IK live in 128-token pages addressed by page
+//! ids from block tables (geometry in minimax_m3_geom.zig). Decode rows come with positions; a prompt chunk is `pos == 0`
+//! and `pos0`. Never run on a GPU in this tree's history: see docs for what is checked.
+const std = @import("std");
+const kernels = @import("kernels.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+pub const geom = @import("minimax_m3_geom.zig");
+
+const Driver = @import("driver.zig").Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = stream_.Stream;
+
+/// The paged cache one launch reads: the pool's base, its page and layer strides, local kv heads and the block tables.
+pub const Paged = struct {
+    pool: u64,
+    page_bytes: u64,
+    layer_off: u64,
+    kvh: u32,
+    tables: u64,
+    /// int32 [rows] offsets into `tables`, or 0 when every row uses the table at its start (one stream).
+    row_tab: u64 = 0,
+};
+
+/// Rows of a call: device int32 positions [n], or 0 and `pos0` (rows pos0, pos0 + 1, ... of one stream).
+pub const Rows = struct { n: usize, pos: u64 = 0, pos0: i32 = 0 };
+
+pub const Scratch = struct {
+    /// fp32 [rows, kvh, bm_stride] and int32 [rows, kvh, 16] device buffers.
+    bmax: u64,
+    sel: u64,
+    bm_stride: usize,
+};
+
+pub const Sparse = struct {
+    index_mod: Module,
+    select_mod: Module,
+    attn_mod: Module,
+    index_fn: Function,
+    select_fn: Function,
+    attn_fn: Function,
+
+    pub fn load(d: *const Driver) !Sparse {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var im = try Module.load(d, kernels.minimax_m3_index);
+        errdefer im.unload();
+        var sm = try Module.load(d, kernels.minimax_m3_select);
+        errdefer sm.unload();
+        var am = try Module.load(d, kernels.minimax_m3_attn);
+        errdefer am.unload();
+        return .{
+            .index_mod = im,
+            .select_mod = sm,
+            .attn_mod = am,
+            .index_fn = try im.function("tf_mm3_index"),
+            .select_fn = try sm.function("tf_mm3_select"),
+            .attn_fn = try am.function("tf_mm3_attn"),
+        };
+    }
+
+    pub fn unload(s: *Sparse) void {
+        s.index_mod.unload();
+        s.select_mod.unload();
+        s.attn_mod.unload();
+    }
+
+    fn cfg(l: geom.Launch) launch_.Config {
+        return .{ .grid = .{ .x = l.grid[0], .y = l.grid[1], .z = l.grid[2] }, .block = .{ .x = l.block }, .shared = l.dynamic_shared };
+    }
+
+    /// iq [rows, kvh, 128] bf16 -> scratch.bmax; `max_pos` bounds the rows' positions (the grid's block count).
+    pub fn score(s: *const Sparse, st: Stream, iq: u64, rows: Rows, p: Paged, sc: Scratch, max_pos: usize, scale: f32) !void {
+        try geom.check(rows.n, p.kvh);
+        if (geom.blocks(max_pos) > sc.bm_stride) return error.TableTooShort;
+        var a: launch_.Args = .{};
+        a.add(iq);
+        a.add(rows.pos);
+        a.add(rows.pos0);
+        a.add(p.row_tab);
+        a.add(p.tables);
+        a.add(p.pool);
+        a.add(@as(i64, @intCast(p.page_bytes)));
+        a.add(@as(i64, @intCast(p.layer_off)));
+        a.add(@as(i32, @intCast(p.kvh)));
+        a.add(sc.bmax);
+        a.add(@as(i32, @intCast(sc.bm_stride)));
+        a.add(scale);
+        try launch_.launch(s.index_fn, cfg(geom.indexLaunch(rows.n, p.kvh, max_pos)), st, &a);
+    }
+
+    /// scratch.bmax -> scratch.sel: ascending block ids per (row, kv head), -1 padded, by the forcing and tie rules.
+    pub fn select(s: *const Sparse, st: Stream, rows: Rows, kvh: usize, sc: Scratch, rules: geom.Rules) !void {
+        try geom.check(rows.n, kvh);
+        var a: launch_.Args = .{};
+        a.add(sc.bmax);
+        a.add(rows.pos);
+        a.add(rows.pos0);
+        a.add(sc.sel);
+        a.add(@as(i32, @intCast(kvh)));
+        a.add(@as(i32, @intCast(sc.bm_stride)));
+        a.add(rules.init_n);
+        a.add(@as(i32, @intFromBool(rules.init_inclusive)));
+        a.add(rules.local_n);
+        a.add(@as(i32, @intFromBool(rules.local_trailing)));
+        a.add(@as(i32, @intFromBool(rules.higher_tie)));
+        try launch_.launch(s.select_fn, cfg(geom.selectLaunch(rows.n, kvh)), st, &a);
+    }
+
+    /// q [rows, kvh * 16, 128] bf16 and scratch.sel -> out [rows, kvh * 16, 128] bf16.
+    pub fn attend(s: *const Sparse, st: Stream, q: u64, rows: Rows, p: Paged, sc: Scratch, out: u64, scale: f32) !void {
+        try geom.check(rows.n, p.kvh);
+        var a: launch_.Args = .{};
+        a.add(q);
+        a.add(sc.sel);
+        a.add(rows.pos);
+        a.add(rows.pos0);
+        a.add(p.row_tab);
+        a.add(p.tables);
+        a.add(p.pool);
+        a.add(@as(i64, @intCast(p.page_bytes)));
+        a.add(@as(i64, @intCast(p.layer_off)));
+        a.add(@as(i32, @intCast(p.kvh)));
+        a.add(out);
+        a.add(scale);
+        try launch_.launch(s.attn_fn, cfg(geom.attnLaunch(rows.n, p.kvh)), st, &a);
+    }
+
+    /// The three launches of one layer's sparse attention, in order, on one stream.
+    pub fn run(s: *const Sparse, st: Stream, iq: u64, q: u64, rows: Rows, p: Paged, sc: Scratch, rules: geom.Rules, max_pos: usize, out: u64) !void {
+        const scale: f32 = @floatCast(std.math.pow(f64, geom.d, -0.5));
+        try s.score(st, iq, rows, p, sc, max_pos, scale);
+        try s.select(st, rows, p.kvh, sc, rules);
+        try s.attend(st, q, rows, p, sc, out, scale);
+    }
+};
+
+test {
+    _ = geom;
+}
