+    defer keep.deinit(gpa);
+    try keep.appendNTimes(gpa, true, base.slots.len);
+    for (base.plain) |t| if (t.role == .embed or (t.layer < keep_first or t.layer >= keep_first + keep_n)) {
+        keep.items[t.slot] = false;
