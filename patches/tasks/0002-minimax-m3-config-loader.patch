+//! Loader tests: the shipped config and trimmed index against the plan, and a synthetic checkpoint written by the test.
+const std = @import("std");
+const core = @import("core");
+const st = core.safetensors;
+const load = @import("load.zig");
+const config = @import("config.zig");
+const names = @import("names.zig");
+const shard = @import("shard.zig");
+
+const gpa = std.testing.allocator;
+const Config = config.Config;
+
+// ---- the shipped files: no shard is needed, the catalog comes from the shape table ----
+
+fn dtypeOf(text: []const u8) !st.DType {
+    const table = [_][2][]const u8{ .{ "torch.bfloat16", "BF16" }, .{ "torch.float16", "F16" }, .{ "torch.float32", "F32" }, .{ "torch.int16", "I16" }, .{ "torch.int32", "I32" } };
+    for (table) |t| if (std.mem.eql(u8, text, t[0])) return st.DType.parse(t[1]).?;
+    return error.UnknownDType;
+}
+
+fn ref(shard_no: usize, dtype: st.DType, shape: []const usize, at: *u64) load.Ref {
+    var r: load.Ref = .{ .shard = @intCast(shard_no), .dtype = dtype, .rank = @intCast(shape.len), .shape = @splat(1), .begin = at.*, .len = dtype.size() };
+    for (shape, 0..) |d, i| {
+        r.shape[i] = d;
+        r.len *= d;
+    }
+    at.* += r.len;
+    return r;
+}
+
+fn shardNumber(file: []const u8) !usize {
+    return (try std.fmt.parseInt(usize, file["model-".len..][0..5], 10)) - 1;
+}
+
+fn num(v: std.json.Value) usize {
+    return @intCast(v.integer);
+}
+
+/// The trimmed index's tensors, shaped from fixtures/tensor_shapes.json (EXL3 parts derive from [K, N, words]).
+fn fixtureCatalog() !load.Catalog {
+    const shapes = try std.json.parseFromSlice(std.json.Value, gpa, @embedFile("fixtures/tensor_shapes.json"), .{});
+    defer shapes.deinit();
+    const index = try std.json.parseFromSlice(std.json.Value, gpa, @embedFile("fixtures/model.safetensors.index.json"), .{});
+    defer index.deinit();
+    const groups = shapes.value.object.get("groups").?.object;
+    const plain = shapes.value.object.get("plain").?.object;
+    var cat = load.Catalog.init(gpa);
+    errdefer cat.deinit();
+    var at: u64 = 0;
+    var it = index.value.object.get("weight_map").?.object.iterator();
+    while (it.next()) |kv| {
+        const name = kv.key_ptr.*;
+        const n = try shardNumber(kv.value_ptr.string);
+        if (plain.get(name)) |p| {
+            var dims: [4]usize = undefined;
+            for (p.array.items[1..], 0..) |d, i| dims[i] = num(d);
+            try cat.add(name, ref(n, st.DType.parse(p.array.items[0].string).?, dims[0 .. p.array.items.len - 1], &at));
+        } else if (std.mem.endsWith(u8, name, ".e_score_correction_bias")) {
+            // absent from quantization_config.json; the index total_size implies 512 bytes: fp32 [128]
+            try cat.add(name, ref(n, .f32, &.{128}, &at));
+        } else {
+            const dot = std.mem.lastIndexOfScalar(u8, name, '.').?;
+            const g = (groups.get(name[0..dot]) orelse return error.UnknownFixtureTensor).array.items;
+            const k, const m, const words = .{ num(g[0]), num(g[1]), num(g[2]) };
+            const part = names.parse(name).?.what.part.part;
+            try cat.add(name, switch (part) {
+                .trellis => ref(n, .i16, &.{ k / 16, m / 16, words }, &at),
+                .suh => ref(n, .f16, &.{k}, &at),
+                .svh => ref(n, .f16, &.{m}, &at),
+                .mul1 => ref(n, .i32, &.{}, &at),
+            });
+        }
+    }
+    return cat;
+}
+
+const layers6 = [_]u16{ 0, 3, 17, 18, 46, 59 };
+
+fn flashConfig() !Config {
+    return config.parse(gpa, config.fixture);
+}
+
+fn halvesOf(plan: *const load.Plan, proj: names.Proj, layer: u32, expert: u32) u8 {
+    return plan.matrix(proj, layer, expert).?.halves;
+}
+
+/// What every plan owes: the item bytes fill the slots exactly (a folded norm is held as fp32).
+fn expectFilled(plan: *const load.Plan) !void {
+    var want: u64 = 0;
+    for (plan.items) |i| want += i.span.bytes() * @as(u64, if (i.fold) 2 else 1);
+    try std.testing.expectEqual(want, plan.slotBytes());
+    for (plan.items[1..], plan.items[0 .. plan.items.len - 1]) |b, a| try std.testing.expect(a.shard < b.shard or (a.shard == b.shard and a.base + a.span.offset <= b.base + b.span.offset));
+}
+
+test "the trimmed index has the section 1 counts and every name is a known role" {
+    var cat = try fixtureCatalog();
+    defer cat.deinit();
+    // embedding, final norm and head (6), a dense layer (36), five MoE layers of 1,574 (24 + 1,550)
+    try std.testing.expectEqual(@as(usize, 6 + 36 + 5 * 1574), cat.map.count());
+    var it = cat.map.keyIterator();
+    while (it.next()) |k| try std.testing.expect(names.parse(k.*) != null);
+}
+
+test "layers 0, 3, 17, 18, 46 and 59 plan with the section 1 bit table" {
+    const c = try flashConfig();
+    var cat = try fixtureCatalog();
+    defer cat.deinit();
+    var plan = try load.Plan.build(gpa, &cat, &c, try shard.Share.of(&c, 0, 1), .{ .layers = &layers6 });
+    defer plan.deinit();
+    try expectFilled(&plan);
+    // q, k, v, o in six layers, three dense matrices, 3 shared + 384 routed in five MoE layers, the head
+    try std.testing.expectEqual(@as(usize, 24 + 3 + 5 * (3 + 384) + 1), plan.matrices.len);
+    try std.testing.expectEqual(@as(usize, 5), plan.moe.len);
+    const experts = [_]struct { layer: u32, w1: u8, w3: u8, w2: u8 }{
+        .{ .layer = 3, .w1 = 8, .w3 = 8, .w2 = 8 },
+        .{ .layer = 17, .w1 = 8, .w3 = 8, .w2 = 6 }, // the one layer mixed within itself
+        .{ .layer = 18, .w1 = 6, .w3 = 6, .w2 = 6 },
+        .{ .layer = 46, .w1 = 8, .w3 = 8, .w2 = 8 },
+        .{ .layer = 59, .w1 = 8, .w3 = 8, .w2 = 8 },
+    };
+    for (experts) |x| {
+        const m = plan.moeLayer(x.layer).?;
+        for ([_]struct { load.MoeProj, u8 }{ .{ m.w1, x.w1 }, .{ m.w3, x.w3 }, .{ m.w2, x.w2 } }) |pair| {
+            try std.testing.expectEqual(@as(u32, 128), pair[0].histogram[pair[1]]); // all 128 experts at that K2
+            for (pair[0].halves) |h| try std.testing.expectEqual(@as(i32, pair[1]), h);
+        }
+        try std.testing.expectEqual(@as(u8, x.w1), halvesOf(&plan, .w1, x.layer, 127));
+    }
+    for (layers6) |l| for ([_]names.Proj{ .q, .k, .v, .o }) |p| try std.testing.expectEqual(@as(u8, 12), halvesOf(&plan, p, l, 0));
+    for ([_]names.Proj{ .dense_gate, .dense_up, .dense_down }) |p| try std.testing.expectEqual(@as(u8, 10), halvesOf(&plan, p, 0, 0));
+    for ([_]names.Proj{ .shared_gate, .shared_up, .shared_down }) |p| try std.testing.expectEqual(@as(u8, 10), halvesOf(&plan, p, 17, 0));
+    try std.testing.expectEqual(@as(u8, 12), halvesOf(&plan, .head, 0, 0));
+    // plain tensors: fp16 index projections and the fp32 router stay as they are, norms are folded to fp32
+    var folded: usize = 0;
+    for (plan.plain) |p| {
+        switch (p.role) {
+            .index_q_proj, .index_k_proj => try std.testing.expect(p.dtype == .f16 and !p.folded),
+            .router => try std.testing.expect(p.dtype == .f32 and !p.folded and p.rows == 128 and p.cols == 6144),
+            .embed => try std.testing.expect(p.dtype == .bf16 and !p.folded),
+            else => {},
+        }
+        if (p.role.isNorm()) {
+            try std.testing.expect(p.folded and p.dtype == .f32);
+            folded += 1;
+        }
+    }
+    try std.testing.expectEqual(@as(usize, 6 * 6 + 1), folded); // five norms a layer plus the final norm
+}
+
+test "TP2 cuts of the real shapes: the head 782/781 units, experts halved, replicated parts whole" {
+    const c = try flashConfig();
+    var cat = try fixtureCatalog();
+    defer cat.deinit();
+    var a = try load.Plan.build(gpa, &cat, &c, try shard.Share.of(&c, 0, 2), .{ .layers = &layers6 });
+    defer a.deinit();
+    var b = try load.Plan.build(gpa, &cat, &c, try shard.Share.of(&c, 1, 2), .{ .layers = &layers6 });
+    defer b.deinit();
+    try expectFilled(&a);
+    try expectFilled(&b);
+    const ha = a.matrix(.head, 0, 0).?;
+    const hb = b.matrix(.head, 0, 0).?;
+    try std.testing.expectEqual(@as(u32, 782 * 128), ha.n);
+    try std.testing.expectEqual(@as(u32, 781 * 128), hb.n);
+    try std.testing.expectEqual(@as(u64, 384 * 12504 * 192), a.slots[ha.trellis].bytes + b.slots[hb.trellis].bytes);
+    const m17 = b.moeLayer(17).?;
+    try std.testing.expectEqual(@as(u32, 1536), m17.w1.n);
+    try std.testing.expectEqual(@as(u32, 1536), m17.w2.k);
+    try std.testing.expectEqual(@as(u64, 128 * 384 * 96 * 128), b.slots[m17.w1.trellis_slot].bytes); // 4-bit: 128 B a tile
+    try std.testing.expectEqual(@as(u64, 128 * 96 * 384 * 96), b.slots[m17.w2.trellis_slot].bytes); // 3-bit down: 96 B a tile, K halved
+    try std.testing.expectEqual(@as(u64, 128 * 1536 * 2), b.slots[m17.w1.svh_slot].bytes);
+    try std.testing.expectEqual(@as(u64, 128 * 6144 * 2), b.slots[m17.w1.suh_slot].bytes);
+    for (a.plain, b.plain) |pa, pb| switch (pa.role) {
+        .index_q_proj => try std.testing.expect(pa.rows == 256 and pb.rows == 256), // two of four index heads each
+        .index_k_proj, .router, .embed => try std.testing.expectEqual(pa.rows, pb.rows),
+        else => {},
+    };
+}
+
+test "the loader names no mapping of the shards" {
+    const src = @embedFile("load.zig");
+    try std.testing.expect(std.mem.indexOf(u8, src, "MemoryMap") == null);
+    try std.testing.expect(std.mem.indexOf(u8, src, "openModel") == null);
+    try std.testing.expect(std.mem.indexOf(u8, src, "mmap") == null);
+}
+
+test "Gemma 1 + w is applied once, in fp32" {
+    const bf = [_]u8{ 0x80, 0x3F, 0x80, 0xBF, 0x00, 0x3F, 0x00, 0x00 }; // 1.0, -1.0, 0.5, 0.0
+    var out: [4]f32 = undefined;
+    try std.testing.expectEqualSlices(f32, &.{ 2.0, 0.0, 1.5, 1.0 }, load.foldGemma(&out, &bf));
+}
+
+// ---- the whole 89,832-tensor pack: only when its metadata is on disk (MM3_META_DIR) ----
+
+fn metaDir() ?[]const u8 {
+    const p = std.c.getenv("MM3_META_DIR") orelse return null;
+    return std.mem.span(p);
+}
+
+fn readMeta(io: std.Io, dir: []const u8, file: []const u8) ![]u8 {
+    const path = try std.fs.path.join(gpa, &.{ dir, file });
+    defer gpa.free(path);
+    return std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(64 << 20));
+}
+
+test "the full pack: 89,832 tensors, 22,309 groups, the per-layer bit table, TP2 totals" {
+    const dir = metaDir() orelse return error.SkipZigTest;
+    const io = std.testing.io;
+    const index_text = try readMeta(io, dir, "model.safetensors.index.json");
+    defer gpa.free(index_text);
+    const quant_text = try readMeta(io, dir, "quantization_config.json");
+    defer gpa.free(quant_text);
+    const index = try std.json.parseFromSlice(std.json.Value, gpa, index_text, .{});
+    defer index.deinit();
+    const quant = try std.json.parseFromSlice(std.json.Value, gpa, quant_text, .{});
+    defer quant.deinit();
+    const wm = index.value.object.get("weight_map").?.object;
+    var cat = load.Catalog.init(gpa);
+    defer cat.deinit();
+    var at: u64 = 0;
+    var from_quant: usize = 0;
+    var bytes: u64 = 0;
+    for (quant.value.object.get("tensor_storage").?.object.values()) |entry| {
+        var it = entry.object.get("stored_tensors").?.object.iterator();
+        while (it.next()) |kv| {
+            var dims: [4]usize = undefined;
+            const shape = kv.value_ptr.object.get("shape").?.array.items;
+            for (shape, 0..) |d, i| dims[i] = num(d);
+            const n = try shardNumber(wm.get(kv.key_ptr.*).?.string);
+            const dt = try dtypeOf(kv.value_ptr.object.get("dtype").?.string);
+            try cat.add(kv.key_ptr.*, ref(n, dt, dims[0..shape.len], &at));
+            try std.testing.expectEqual(num(kv.value_ptr.object.get("n_bytes").?), cat.get(kv.key_ptr.*).?.len);
+            bytes += cat.get(kv.key_ptr.*).?.len;
+            from_quant += 1;
+        }
+    }
+    try std.testing.expectEqual(@as(usize, 89775), from_quant);
+    // the 57 router biases are in the index only; the index' total_size is consistent with fp32 [128] each
+    var it = wm.iterator();
+    while (it.next()) |kv| if (cat.get(kv.key_ptr.*) == null) {
+        try std.testing.expect(std.mem.endsWith(u8, kv.key_ptr.*, ".e_score_correction_bias"));
+        try cat.add(kv.key_ptr.*, ref(try shardNumber(kv.value_ptr.string), .f32, &.{128}, &at));
+        bytes += 512;
+    };
+    try std.testing.expectEqual(@as(usize, 89832), cat.map.count());
+    try std.testing.expectEqual(@as(u64, @intCast(index.value.object.get("metadata").?.object.get("total_size").?.integer)), bytes);
+
+    const c = try flashConfig();
+    var whole = try load.Plan.build(gpa, &cat, &c, try shard.Share.of(&c, 0, 1), .{});
+    defer whole.deinit();
+    try std.testing.expectEqual(@as(usize, 22309), whole.matrices.len);
+    try std.testing.expectEqual(@as(usize, 0), whole.ignored);
+    try std.testing.expectEqual(@as(usize, 57), whole.moe.len);
+    for (whole.moe) |m| {
+        const l = m.layer;
+        const w1: u32 = if (l <= 16 or l >= 46) 8 else if (l == 17) 8 else 6;
+        const w2: u32 = if (l <= 16 or l >= 46) 8 else 6;
+        try std.testing.expectEqual(@as(u32, 128), m.w1.histogram[w1]);
+        try std.testing.expectEqual(@as(u32, 128), m.w3.histogram[w1]);
+        try std.testing.expectEqual(@as(u32, 128), m.w2.histogram[w2]);
+    }
+    var r0 = try load.Plan.build(gpa, &cat, &c, try shard.Share.of(&c, 0, 2), .{});
+    defer r0.deinit();
+    var r1 = try load.Plan.build(gpa, &cat, &c, try shard.Share.of(&c, 1, 2), .{});
+    defer r1.deinit();
+    try expectFilled(&r0);
+    try expectFilled(&r1);
+    // plan section 5: about 91 GiB a rank (the folded norms are fp32, so a hair more than the stored bytes)
+    const gib = 1024.0 * 1024.0 * 1024.0;
+    for ([_]*load.Plan{ &r0, &r1 }) |p| {
+        const g = @as(f64, @floatFromInt(p.slotBytes())) / gib;
+        try std.testing.expect(g > 89.0 and g < 93.0);
+    }
+}
diff --git a/zig/src/families/minimax_m3/names.zig b/zig/src/families/minimax_m3/names.zig
new file mode 100644
index 0000000..0125ac4
--- /dev/null
+++ b/zig/src/families/minimax_m3/names.zig
@@ -0,0 +1,233 @@
+//! MiniMax-M3.1-Flash's tensor names: the text model is `language_model.model.*`, the head `language_model.lm_head.*`.
+const std = @import("std");
+
+pub const lm = "language_model.model.";
+pub const head_prefix = "language_model.lm_head";
+pub const text_namespace = "language_model.";
+
+/// Every EXL3 matrix kind: each is a group of suh, svh, mul1 and trellis tensors.
+pub const Proj = enum {
+    q,
+    k,
+    v,
+    o,
+    dense_gate,
+    dense_up,
+    dense_down,
+    shared_gate,
+    shared_up,
+    shared_down,
+    w1, // routed expert gate (the SiLU side is unverified)
+    w3, // routed expert up
+    w2, // routed expert down
+    head,
+
+    pub fn isExpert(p: Proj) bool {
+        return p == .w1 or p == .w3 or p == .w2;
+    }
+
+    /// Which axis a tensor-parallel rank cuts: output columns (no reduction) or input rows (partial sums).
+    pub fn cut(p: Proj) Cut {
+        return switch (p) {
+            .o, .dense_down, .shared_down, .w2 => .row,
+            else => .col,
+        };
+    }
+
+    fn tail(p: Proj) []const u8 {
+        return switch (p) {
+            .q => "self_attn.q_proj",
+            .k => "self_attn.k_proj",
+            .v => "self_attn.v_proj",
+            .o => "self_attn.o_proj",
+            .dense_gate => "mlp.gate_proj",
+            .dense_up => "mlp.up_proj",
+            .dense_down => "mlp.down_proj",
+            .shared_gate => "block_sparse_moe.shared_experts.gate_proj",
+            .shared_up => "block_sparse_moe.shared_experts.up_proj",
+            .shared_down => "block_sparse_moe.shared_experts.down_proj",
+            .w1, .w3, .w2 => "",
+            .head => "",
+        };
+    }
+};
+
+pub const Cut = enum { col, row };
+
+pub const Part = enum { suh, svh, mul1, trellis };
+
+/// Tensors stored as they are (or with the Gemma fold): norms, the embedding, the fp16 index projections, the router.
+pub const Plain = enum {
+    embed,
+    final_norm,
+    input_ln,
+    post_ln,
+    q_norm,
+    k_norm,
+    index_q_proj,
+    index_k_proj,
+    index_q_norm,
+    index_k_norm,
+    router, // fp32 [experts, hidden]
+    router_bias, // e_score_correction_bias [experts]
+
+    pub fn isGlobal(p: Plain) bool {
+        return p == .embed or p == .final_norm;
+    }
+
+    /// RMS norm weights: stored as w, applied as 1 + w when use_gemma_norm is set.
+    pub fn isNorm(p: Plain) bool {
+        return switch (p) {
+            .final_norm, .input_ln, .post_ln, .q_norm, .k_norm, .index_q_norm, .index_k_norm => true,
+            else => false,
+        };
+    }
+
+    fn tail(p: Plain) []const u8 {
+        return switch (p) {
+            .embed => "embed_tokens.weight",
+            .final_norm => "norm.weight",
+            .input_ln => "input_layernorm.weight",
+            .post_ln => "post_attention_layernorm.weight",
+            .q_norm => "self_attn.q_norm.weight",
+            .k_norm => "self_attn.k_norm.weight",
+            .index_q_proj => "self_attn.index_q_proj.weight",
+            .index_k_proj => "self_attn.index_k_proj.weight",
+            .index_q_norm => "self_attn.index_q_norm.weight",
+            .index_k_norm => "self_attn.index_k_norm.weight",
+            .router => "block_sparse_moe.gate.weight",
+            .router_bias => "block_sparse_moe.e_score_correction_bias",
+        };
+    }
+};
+
+pub const max_name = 160;
+pub const Buf = [max_name]u8;
+
+/// A group's prefix: `layer` and `expert` are ignored where the matrix has none.
+pub fn group(buf: *Buf, p: Proj, layer: u32, expert: u32) []const u8 {
+    const r = switch (p) {
+        .head => std.fmt.bufPrint(buf, "{s}", .{head_prefix}),
+        .w1, .w3, .w2 => std.fmt.bufPrint(buf, lm ++ "layers.{d}.block_sparse_moe.experts.{d}.{s}", .{ layer, expert, @tagName(p) }),
+        else => std.fmt.bufPrint(buf, lm ++ "layers.{d}.{s}", .{ layer, p.tail() }),
+    };
+    return r catch unreachable; // the longest name is under 100 bytes
+}
+
+pub fn part(buf: *Buf, prefix: []const u8, which: Part) []const u8 {
+    return std.fmt.bufPrint(buf, "{s}.{s}", .{ prefix, @tagName(which) }) catch unreachable;
+}
+
+pub fn plain(buf: *Buf, p: Plain, layer: u32) []const u8 {
+    const r = if (p.isGlobal()) std.fmt.bufPrint(buf, lm ++ "{s}", .{p.tail()}) else std.fmt.bufPrint(buf, lm ++ "layers.{d}.{s}", .{ layer, p.tail() });
+    return r catch unreachable;
+}
+
+/// A tensor name taken apart.
+pub const Name = struct {
+    layer: u32 = 0,
+    expert: u32 = 0,
+    what: union(enum) { plain: Plain, part: struct { proj: Proj, part: Part } },
+};
+
+fn partOf(s: []const u8) ?Part {
+    return std.meta.stringToEnum(Part, s);
+}
+
+fn number(s: *[]const u8) ?u32 {
+    const end = std.mem.indexOfScalar(u8, s.*, '.') orelse return null;
+    if (end == 0 or end > 5 or (end > 1 and s.*[0] == '0')) return null; // no sign, no leading zero: one spelling per index
+    const n = std.fmt.parseInt(u32, s.*[0..end], 10) catch return null;
+    s.* = s.*[end + 1 ..];
+    return n;
+}
+
+/// The role of a checkpoint tensor name, or null for a name this family does not know.
+pub fn parse(name: []const u8) ?Name {
+    if (std.mem.startsWith(u8, name, head_prefix ++ ".")) {
+        const p = partOf(name[head_prefix.len + 1 ..]) orelse return null;
+        return .{ .what = .{ .part = .{ .proj = .head, .part = p } } };
+    }
+    if (!std.mem.startsWith(u8, name, lm)) return null;
+    var rest = name[lm.len..];
+    for ([_]Plain{ .embed, .final_norm }) |g| if (std.mem.eql(u8, rest, g.tail())) return .{ .what = .{ .plain = g } };
+    if (!std.mem.startsWith(u8, rest, "layers.")) return null;
+    rest = rest["layers.".len..];
+    var out: Name = .{ .what = undefined };
+    out.layer = number(&rest) orelse return null;
+    for (std.enums.values(Plain)) |p| {
+        if (!p.isGlobal() and std.mem.eql(u8, rest, p.tail())) return .{ .layer = out.layer, .what = .{ .plain = p } };
+    }
+    const experts = "block_sparse_moe.experts.";
+    if (std.mem.startsWith(u8, rest, experts)) {
+        rest = rest[experts.len..];
+        out.expert = number(&rest) orelse return null;
+        const dot = std.mem.indexOfScalar(u8, rest, '.') orelse return null;
+        const proj = std.meta.stringToEnum(Proj, rest[0..dot]) orelse return null;
+        if (!proj.isExpert()) return null;
+        out.what = .{ .part = .{ .proj = proj, .part = partOf(rest[dot + 1 ..]) orelse return null } };
+        return out;
+    }
+    for (std.enums.values(Proj)) |p| {
+        if (p.isExpert() or p == .head) continue;
+        const t = p.tail();
+        if (rest.len > t.len + 1 and std.mem.startsWith(u8, rest, t) and rest[t.len] == '.') {
+            out.what = .{ .part = .{ .proj = p, .part = partOf(rest[t.len + 1 ..]) orelse return null } };
+            return out;
+        }
+    }
+    return null;
+}
+
+test "names round-trip through parse for every role" {
+    var buf: Buf = undefined;
+    var buf2: Buf = undefined;
+    for (std.enums.values(Plain)) |p| {
+        const n = parse(plain(&buf, p, 17)).?;
+        try std.testing.expectEqual(p, n.what.plain);
+        try std.testing.expectEqual(@as(u32, if (p.isGlobal()) 0 else 17), n.layer);
+    }
+    for (std.enums.values(Proj)) |p| {
+        for (std.enums.values(Part)) |w| {
+            const prefix = group(&buf, p, 59, 127);
+            const n = parse(part(&buf2, prefix, w)).?;
+            try std.testing.expectEqual(p, n.what.part.proj);
+            try std.testing.expectEqual(w, n.what.part.part);
+            try std.testing.expectEqual(@as(u32, if (p == .head) 0 else 59), n.layer);
+            try std.testing.expectEqual(@as(u32, if (p.isExpert()) 127 else 0), n.expert);
+        }
+    }
+}
+
+test "the checkpoint's spellings" {
+    var buf: Buf = undefined;
+    try std.testing.expectEqualStrings("language_model.model.layers.3.block_sparse_moe.experts.5.w2", group(&buf, .w2, 3, 5));
+    try std.testing.expectEqualStrings("language_model.lm_head", group(&buf, .head, 9, 9));
+    try std.testing.expectEqualStrings("language_model.model.layers.0.mlp.down_proj", group(&buf, .dense_down, 0, 0));
+    try std.testing.expectEqualStrings("language_model.model.layers.4.block_sparse_moe.shared_experts.up_proj", group(&buf, .shared_up, 4, 0));
+    try std.testing.expectEqualStrings("language_model.model.norm.weight", plain(&buf, .final_norm, 5));
+    try std.testing.expectEqualStrings("language_model.model.layers.4.block_sparse_moe.e_score_correction_bias", plain(&buf, .router_bias, 4));
+}
+
+test "unknown, misspelled and non-canonical names are not roles" {
+    for ([_][]const u8{
+        "language_model.model.layers.3.self_attn.q_proj.bias", // EXL3 groups here carry no bias
+        "language_model.model.layers.03.self_attn.q_proj.suh",
+        "language_model.model.layers.3.block_sparse_moe.experts.x.w1.suh",
+        "language_model.model.layers.3.block_sparse_moe.experts.1.w4.suh",
+        "language_model.model.layers.3.block_sparse_moe.experts.1.w1",
+        "language_model.model.layers.3.self_attn.index_v_proj.weight",
+        "language_model.model.layers.3.self_attn.q_proj",
+        "language_model.lm_head.weight",
+        "language_model.mtp.0.eh_proj.weight",
+        "vision_tower.blocks.0.attn.qkv.weight",
+        "language_model.model.layers.3.",
+    }) |bad| try std.testing.expect(parse(bad) == null);
+}
+
+test "o, down and w2 cut input rows, everything else output columns" {
+    for (std.enums.values(Proj)) |p| {
+        const rows = p == .o or p == .dense_down or p == .shared_down or p == .w2;
+        try std.testing.expectEqual(if (rows) Cut.row else Cut.col, p.cut());
+    }
+}
diff --git a/zig/src/families/minimax_m3/shard.zig b/zig/src/families/minimax_m3/shard.zig
new file mode 100644
index 0000000..ba8c9b2
--- /dev/null
+++ b/zig/src/families/minimax_m3/shard.zig
@@ -0,0 +1,199 @@
+//! A TP rank's share of MiniMax-M3.1-Flash (plan section 5): whole kv groups, EXL3 and vocabulary cuts in 128s.
+const std = @import("std");
+const canon = @import("canon");
+const layout = @import("core").exl3_layout;
+const Config = @import("config.zig").Config;
+const names = @import("names.zig");
+
+/// Elements of an EXL3 width or of the vocabulary a rank takes whole: the Hadamard block.
+pub const unit = 128;
+
+pub const Span = struct {
+    lo: usize,
+    hi: usize,
+
+    pub fn len(s: Span) usize {
+        return s.hi - s.lo;
+    }
+};
+
+pub const Share = struct {
+    rank: usize,
+    world: usize,
+    kv_heads: Span, // kv heads; index head g selects for kv head g, so the index heads are the same span
+    q_heads: Span, // the query heads of those kv groups
+    index_heads: Span,
+    dense: Span, // dense MLP intermediate rows (layers before the first MoE layer)
+    moe: Span, // each routed expert's intermediate rows
+    shared: Span, // the shared expert's intermediate rows
+    vocab: Span, // the head's rows, in whole 128-row units
+
+    /// Rank `rank` of `world`; refused where any rank would be left without a head, a unit or a row.
+    pub fn of(c: *const Config, rank: usize, world: usize) !Share {
+        if (world == 0 or rank >= world) return error.BadRank;
+        const kv = try span(c.kv_heads, 1, rank, world);
+        return .{
+            .rank = rank,
+            .world = world,
+            .kv_heads = kv,
+            .q_heads = .{ .lo = kv.lo * c.group(), .hi = kv.hi * c.group() },
+            .index_heads = kv,
+            .dense = try span(c.dense_inter, unit, rank, world),
+            .moe = try span(c.moe_inter, unit, rank, world),
+            .shared = try span(c.shared_inter, unit, rank, world),
+            .vocab = try span(c.vocab, unit, rank, world),
+        };
+    }
+
+    /// The rank's slice of matrix `p` along its cut axis, in elements of that axis.
+    pub fn cut(s: Share, c: *const Config, p: names.Proj) Span {
+        return switch (p) {
+            .q, .o => scale(s.q_heads, c.head_dim),
+            .k, .v => scale(s.kv_heads, c.head_dim),
+            .dense_gate, .dense_up, .dense_down => s.dense,
+            .shared_gate, .shared_up, .shared_down => s.shared,
+            .w1, .w3, .w2 => s.moe,
+            .head => s.vocab,
+        };
+    }
+
+    /// The rows of the fp16 index query projection this rank scores with; the key projection is replicated.
+    pub fn indexRows(s: Share, c: *const Config) Span {
+        return scale(s.index_heads, c.index.dim);
+    }
+
+    /// The rank's slice of an EXL3 group: whole tiles, with `suh` or `svh` cut to match.
+    pub fn part(s: Share, c: *const Config, p: names.Proj, g: layout.Group) !layout.Part {
+        return cutGroup(g, p.cut(), s.cut(c, p));
+    }
+};
+
+fn scale(s: Span, by: usize) Span {
+    return .{ .lo = s.lo * by, .hi = s.hi * by };
+}
+
+/// Rank `rank`'s [lo, hi) of `total` elements in whole `per`s: largest-remainder shares, ties to the lower rank.
+fn span(total: usize, per: usize, rank: usize, world: usize) !Span {
+    if (total % per != 0 or world > 256) return error.BadSplit;
+    const ones: [256]u64 = @splat(1);
+    var out: [256]canon.Range = undefined;
+    canon.partition(@intCast(total / per), ones[0..world], out[0..world]);
+    const r = out[rank];
+    if (r.len() == 0) return error.EmptyShare;
+    return .{ .lo = r.begin * per, .hi = r.end * per };
+}
+
+/// `g`'s tiles [lo, hi) along `axis` (128-aligned elements): the trellis runs and the scale bytes to read.
+pub fn cutGroup(g: layout.Group, axis: names.Cut, s: Span) !layout.Part {
+    const whole = if (axis == .col) g.n() else g.k();
+    if (s.lo >= s.hi or s.hi > whole or s.lo % unit != 0 or s.hi % unit != 0) return error.SplitNotOnBlocks;
+    const lo: u64 = s.lo / 16;
+    const per: u64 = s.len() / 16;
+    var p: layout.Part = .{
+        .group = g,
+        .trellis = .{ .offset = 0, .len = g.trellisBytes() },
+        .suh = .{ .offset = 0, .len = 2 * @as(u64, g.k()) },
+        .svh = .{ .offset = 0, .len = 2 * @as(u64, g.n()) },
+    };
+    switch (axis) {
+        .row => { // K tiles lo..hi are whole rows of N tiles: one run
+            const row = @as(u64, g.n_tiles) * g.tileBytes();
+            p.group.k_tiles = @intCast(per);
+            p.trellis = .{ .offset = lo * row, .len = per * row };
+            p.suh = .{ .offset = 2 * 16 * lo, .len = 2 * 16 * per };
+        },
+        .col => { // this rank's N tiles are a run inside each of the K tile rows
+            p.group.n_tiles = @intCast(per);
+            p.trellis = .{ .offset = lo * g.tileBytes(), .len = per * g.tileBytes(), .stride = @as(u64, g.n_tiles) * g.tileBytes(), .count = g.k_tiles };
+            p.svh = .{ .offset = 2 * 16 * lo, .len = 2 * 16 * per };
+        },
+    }
+    return p;
+}
+
+test "TP2 splits the heads, widths and vocabulary as plan section 5 says" {
+    const c = &@import("config.zig").flash;
+    const r0 = try Share.of(c, 0, 2);
+    const r1 = try Share.of(c, 1, 2);
+    try std.testing.expectEqual(Span{ .lo = 0, .hi = 2 }, r0.kv_heads);
+    try std.testing.expectEqual(Span{ .lo = 2, .hi = 4 }, r1.kv_heads);
+    try std.testing.expectEqual(Span{ .lo = 0, .hi = 32 }, r0.q_heads);
+    try std.testing.expectEqual(Span{ .lo = 32, .hi = 64 }, r1.q_heads);
+    try std.testing.expectEqual(r1.kv_heads, r1.index_heads);
+    try std.testing.expectEqual(Span{ .lo = 256, .hi = 512 }, r1.indexRows(c));
+    try std.testing.expectEqual(Span{ .lo = 6144, .hi = 12288 }, r1.dense);
+    try std.testing.expectEqual(Span{ .lo = 1536, .hi = 3072 }, r1.moe);
+    try std.testing.expectEqual(Span{ .lo = 0, .hi = 1536 }, r0.shared);
+    // 1563 units of 128 rows: rank 0 takes the odd one
+    try std.testing.expectEqual(@as(usize, 782 * 128), r0.vocab.len());
+    try std.testing.expectEqual(@as(usize, 781 * 128), r1.vocab.len());
+    try std.testing.expectEqual(r0.vocab.hi, r1.vocab.lo);
+    try std.testing.expectEqual(c.vocab, r1.vocab.hi);
+    // q_proj and o_proj: 4096 of 8192 each; k and v: 256 of 512
+    try std.testing.expectEqual(Span{ .lo = 4096, .hi = 8192 }, r1.cut(c, .q));
+    try std.testing.expectEqual(Span{ .lo = 0, .hi = 4096 }, r0.cut(c, .o));
+    try std.testing.expectEqual(Span{ .lo = 256, .hi = 512 }, r1.cut(c, .v));
+}
+
+test "ranks that would be empty and ranks out of range are refused" {
+    const c = &@import("config.zig").flash;
+    try std.testing.expectError(error.BadRank, Share.of(c, 2, 2));
+    try std.testing.expectError(error.BadRank, Share.of(c, 0, 0));
+    // 4 kv heads: a fifth rank has none
+    try std.testing.expectError(error.EmptyShare, Share.of(c, 4, 5));
+    try std.testing.expectError(error.EmptyShare, Share.of(c, 4, 8));
+    try std.testing.expectError(error.BadSplit, Share.of(c, 0, 257));
+    // three ranks: uneven but whole groups, 2/1/1 kv heads
+    const t0 = try Share.of(c, 0, 3);
+    const t2 = try Share.of(c, 2, 3);
+    try std.testing.expectEqual(@as(usize, 32), t0.q_heads.len());
+    try std.testing.expectEqual(@as(usize, 16), t2.q_heads.len());
+    // a model whose MoE width has fewer 128-units than ranks
+    var small = c.*;
+    small.moe_inter = 128;
+    try std.testing.expectError(error.EmptyShare, Share.of(&small, 1, 2));
+    small.moe_inter = 100;
+    try std.testing.expectError(error.BadSplit, Share.of(&small, 0, 2));
+}
+
+test "group cuts agree with core's even cuts and keep the scales aligned" {
+    const c = &@import("config.zig").flash;
+    const q = try layout.Group.fromShape(&.{ 384, 512, 96 }); // q_proj: K 6144, N 8192, 6 bits
+    const o = try layout.Group.fromShape(&.{ 512, 384, 96 }); // o_proj: K 8192, N 6144
+    for ([_]usize{ 0, 1 }) |r| {
+        const s = try Share.of(c, r, 2);
+        const mine = try s.part(c, .q, q);
+        const theirs = try q.part(.col, @intCast(r), 2);
+        try std.testing.expectEqualDeep(theirs, mine);
+        try std.testing.expectEqualDeep(try o.part(.row, @intCast(r), 2), try s.part(c, .o, o));
+    }
+    const r1 = try (try Share.of(c, 1, 2)).part(c, .o, o);
+    try std.testing.expectEqual(@as(u64, 4096 * 2), r1.suh.len);
+    try std.testing.expectEqual(@as(u64, 4096 * 2), r1.suh.offset);
+    try std.testing.expectEqual(@as(u64, 6144 * 2), r1.svh.len); // the row cut keeps svh whole
+    try std.testing.expectEqual(@as(u32, 256), r1.group.k_tiles);
+}
+
+test "the head's odd unit count cuts at 128s that core's even split refuses" {
+    const c = &@import("config.zig").flash;
+    const head = try layout.Group.fromShape(&.{ 384, 12504, 96 });
+    try std.testing.expectError(error.SplitNotOnBlocks, head.part(.col, 0, 2)); // 1563 units are not even
+    const p0 = try (try Share.of(c, 0, 2)).part(c, .head, head);
+    const p1 = try (try Share.of(c, 1, 2)).part(c, .head, head);
+    try std.testing.expectEqual(@as(u32, 782 * 8), p0.group.n_tiles);
+    try std.testing.expectEqual(@as(u32, 781 * 8), p1.group.n_tiles);
+    try std.testing.expectEqual(p0.group.n_tiles * 16 * 2, p0.svh.len);
+    try std.testing.expectEqual(p0.svh.len, p1.svh.offset);
+    try std.testing.expectEqual(@as(u64, 384), p1.trellis.count);
+    // together the two runs cover each whole row of N tiles, back to back
+    try std.testing.expectEqual(head.tileBytes() * 12504, p0.trellis.len + p1.trellis.len);
+    try std.testing.expectEqual(p0.trellis.len, p1.trellis.offset);
+}
+
+test "cuts off the 128 grid or out of range are refused" {
+    const g = try layout.Group.fromShape(&.{ 16, 16, 64 }); // 256 x 256
+    try std.testing.expectError(error.SplitNotOnBlocks, cutGroup(g, .col, .{ .lo = 0, .hi = 100 }));
+    try std.testing.expectError(error.SplitNotOnBlocks, cutGroup(g, .row, .{ .lo = 128, .hi = 384 }));
+    try std.testing.expectError(error.SplitNotOnBlocks, cutGroup(g, .row, .{ .lo = 128, .hi = 128 }));
+    _ = try cutGroup(g, .col, .{ .lo = 128, .hi = 256 });
+}
