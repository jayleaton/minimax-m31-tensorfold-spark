diff --git a/zig/src/cuda/minimax_m3_rows.zig b/zig/src/cuda/minimax_m3_rows.zig
new file mode 100644
index 0000000..fcd5f0e
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_rows.zig
@@ -0,0 +1,215 @@
+//! MiniMax-M3.1-Flash row kernels (minimax_m3_rows.cu): norm and RoPE into paged K/V/IK, fp32 router, table mirror.
+const std = @import("std");
+const kernels = @import("kernels.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+const memory = @import("memory.zig");
+const sp = @import("minimax_m3_sparse.zig");
+pub const geom = @import("minimax_m3_rows_geom.zig");
+
+const Driver = @import("driver.zig").Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = stream_.Stream;
+
+/// Local head counts of a rank: query heads, index query heads, kv heads, and whether the index key is written.
+pub const Heads = struct { nq: u32 = 32, niq: u32 = 2, kvh: u32 = 2, index_key: bool = true };
+
+/// Norm and rotation arguments; `w_add` (q, k) and `w_add_index` are 1 for raw Gemma weights, 0 for the folded `1 + w`.
+pub const Opts = struct {
+    rot: u32 = 64,
+    theta: f64 = 1e7,
+    eps: f32 = 1e-6,
+    w_add: f32 = 0,
+    w_add_index: f32 = 0,
+    flags: geom.Flags = .{},
+};
+
+/// Device inputs: row-major projections at element strides; the index inputs are fp16 (or bf16 per `flags.index_fp16`).
+pub const Inputs = struct {
+    q: u64,
+    q_ld: usize,
+    k: u64,
+    k_ld: usize,
+    v: u64,
+    v_ld: usize,
+    iq: u64 = 0,
+    iq_ld: usize = 0,
+    ik: u64 = 0,
+    ik_ld: usize = 0,
+};
+
+/// fp32 [128] norm weights on the device; 0 when that norm is off.
+pub const Norms = struct { q: u64 = 0, k: u64 = 0, iq: u64 = 0, ik: u64 = 0 };
+
+/// bf16 scratch rows for q [rows, nq * 128] and the index query [rows, niq * 128].
+pub const Outputs = struct { q: u64, q_ld: usize, iq: u64 = 0, iq_ld: usize = 0 };
+
+pub const Router = struct { experts: u32 = 128, k: u32 = 6144 };
+
+pub const Rows = struct {
+    mod: Module,
+    rows_fn: Function,
+    bf16_fn: Function,
+    f32_fn: Function,
+
+    pub fn load(d: *const Driver) !Rows {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var m = try Module.load(d, kernels.minimax_m3_rows);
+        errdefer m.unload();
+        return .{
+            .mod = m,
+            .rows_fn = try m.function("tf_mm3_rows"),
+            .bf16_fn = try m.function("tf_mm3_router_bf16"),
+            .f32_fn = try m.function("tf_mm3_router_f32"),
+        };
+    }
+
+    pub fn unload(g: *Rows) void {
+        g.mod.unload();
+    }
+
+    fn cfg(l: geom.Launch) launch_.Config {
+        return .{ .grid = .{ .x = l.grid[0], .y = l.grid[1], .z = l.grid[2] }, .block = .{ .x = l.block } };
+    }
+
+    /// Norm and rotate the heads of `rows` into scratch and the pages `p` names; `status` (int32 or 0) gets bits.
+    pub fn qkRope(g: *const Rows, st: Stream, h: Heads, o: Opts, in: Inputs, nm: Norms, out: Outputs, rows: sp.Rows, p: sp.Paged, max_pages: u32, status: u64) !void {
+        const launch = try geom.rowsLaunch(rows.n);
+        if (p.kvh != h.kvh or h.nq == 0 or h.nq % h.kvh != 0) return error.Heads;
+        try geom.checkRows(o.rot, h.nq * geom.d, in.q_ld);
+        try geom.checkRows(o.rot, h.nq * geom.d, out.q_ld);
+        try geom.checkRows(o.rot, h.kvh * geom.d, in.k_ld);
+        try geom.checkRows(o.rot, h.kvh * geom.d, in.v_ld);
+        if (h.niq > 0) {
+            try geom.checkRows(o.rot, h.niq * geom.d, in.iq_ld);
+            try geom.checkRows(o.rot, h.niq * geom.d, out.iq_ld);
+            if (in.iq == 0 or out.iq == 0) return error.Heads;
+        }
+        if (h.index_key) try geom.checkRows(o.rot, geom.d, in.ik_ld);
+        if (h.index_key and in.ik == 0) return error.Heads;
+        const f = o.flags;
+        if ((f.norm_qk and (nm.q == 0 or nm.k == 0)) or (f.norm_index and ((h.niq > 0 and nm.iq == 0) or (h.index_key and nm.ik == 0)))) return error.Heads;
+        if (p.tables == 0 or p.pool == 0 or max_pages == 0) return error.Heads;
+        var a: launch_.Args = .{};
+        a.add(in.q);
+        a.add(@as(i64, @intCast(in.q_ld)));
+        a.add(in.k);
+        a.add(@as(i64, @intCast(in.k_ld)));
+        a.add(in.v);
+        a.add(@as(i64, @intCast(in.v_ld)));
+        a.add(in.iq);
+        a.add(@as(i64, @intCast(in.iq_ld)));
+        a.add(in.ik);
+        a.add(@as(i64, @intCast(in.ik_ld)));
+        for ([_]u64{ nm.q, nm.k, nm.iq, nm.ik }) |w| a.add(w);
+        a.add(out.q);
+        a.add(@as(i64, @intCast(out.q_ld)));
+        a.add(out.iq);
+        a.add(@as(i64, @intCast(out.iq_ld)));
+        a.add(rows.pos);
+        a.add(rows.pos0);
+        a.add(p.row_tab);
+        a.add(p.tables);
+        a.add(@as(i32, @intCast(max_pages)));
+        a.add(p.pool);
+        a.add(@as(i64, @intCast(p.page_bytes)));
+        a.add(@as(i64, @intCast(p.layer_off)));
+        a.add(@as(i32, @intCast(rows.n)));
+        a.add(@as(i32, @intCast(h.nq)));
+        a.add(@as(i32, @intCast(h.niq)));
+        a.add(@as(i32, @intCast(h.kvh)));
+        a.add(@as(i32, @intFromBool(h.index_key)));
+        a.add(f.bits());
+        a.add(@as(i32, @intCast(o.rot)));
+        a.add(o.eps);
+        a.add(o.w_add);
+        a.add(o.w_add_index);
+        a.add(o.theta);
+        a.add(status);
+        try launch_.launch(g.rows_fn, cfg(launch), st, &a);
+    }
+
+    /// logits [rows, experts] fp32 = x [rows, k] times w [experts, k] fp32; x bf16, or fp32 when `x_f32`.
+    pub fn routerLogits(g: *const Rows, st: Stream, r: Router, x: u64, x_ld: usize, x_f32: bool, w: u64, out: u64, rows: usize) !void {
+        const launch = try geom.routerLaunch(rows, r.experts);
+        try geom.checkRouter(r.k, x_ld);
+        if (x % 16 != 0 or w % 16 != 0 or x_ld % 4 != 0) return error.Heads;
+        var a: launch_.Args = .{};
+        a.add(x);
+        a.add(@as(i64, @intCast(x_ld)));
+        a.add(w);
+        a.add(out);
+        a.add(@as(i32, @intCast(rows)));
+        a.add(@as(i32, @intCast(r.experts)));
+        a.add(@as(i32, @intCast(r.k)));
+        try launch_.launch(if (x_f32) g.f32_fn else g.bf16_fn, cfg(launch), st, &a);
+    }
+};
+
+/// The pool the paged kernels address: base, page and layer strides, local kv heads.
+pub const Cache = struct { pool: u64, page_bytes: u64, layer_off: u64, kvh: u32 };
+
+/// Device copy of the block tables (int32 page ids, -1 padded, `max_pages` a slot) and the per-row offsets T5 reads.
+pub const Mirror = struct {
+    tables: memory.DeviceBuffer,
+    row_tab: memory.DeviceBuffer,
+    slots: usize,
+    max_pages: usize,
+    max_rows: usize,
+
+    pub fn init(d: *const Driver, slots: usize, max_pages: usize, max_rows: usize) !Mirror {
+        _ = try geom.entryOffset(slots, max_pages);
+        var t = try memory.DeviceBuffer.alloc(d, slots * max_pages * @sizeOf(i32));
+        errdefer t.free();
+        try t.fill32(0xffffffff, null);
+        const rt = try memory.DeviceBuffer.alloc(d, max_rows * @sizeOf(i32));
+        return .{ .tables = t, .row_tab = rt, .slots = slots, .max_pages = max_pages, .max_rows = max_rows };
+    }
+
+    pub fn deinit(m: *Mirror) void {
+        m.tables.free();
+        m.row_tab.free();
+    }
+
+    /// Entries [from, from + entries.len) of `slot`'s row, copied to the device once they have landed.
+    pub fn put(m: *Mirror, slot: usize, from: usize, entries: []const i32) !void {
+        const r = try geom.entryBytes(m.slots, m.max_pages, slot, from, entries.len);
+        try m.tables.upload(r.off, std.mem.sliceAsBytes(entries));
+    }
+
+    /// kv pool Tables' `Upload.call`: pass the Mirror as its ctx.
+    pub fn call(ctx: *anyopaque, slot: u32, from: usize, entries: []const i32) anyerror!void {
+        const m: *Mirror = @ptrCast(@alignCast(ctx));
+        try m.put(slot, from, entries);
+    }
+
+    /// The whole host table (`slots * max_pages` entries) in one copy, e.g. after a restore.
+    pub fn putAll(m: *Mirror, rows: []const i32) !void {
+        if (rows.len != m.slots * m.max_pages) return error.TableFull;
+        try m.tables.upload(0, std.mem.sliceAsBytes(rows));
+    }
+
+    /// The window's per-row offsets: `host` (one entry a row) is filled from `segs` and queued on `st`.
+    pub fn setRows(m: *Mirror, st: Stream, host: []i32, segs: []const geom.Seg) !void {
+        if (host.len == 0 or host.len > m.max_rows) return error.TooManyRows;
+        try geom.fillRowTab(host, segs, m.slots, m.max_pages);
+        try m.row_tab.uploadAsync(0, std.mem.sliceAsBytes(host), st.handle);
+    }
+
+    /// Several streams' rows in one call: every row reads the table at its own `row_tab` offset.
+    pub fn shared(m: *const Mirror, c: Cache) sp.Paged {
+        return .{ .pool = c.pool, .page_bytes = c.page_bytes, .layer_off = c.layer_off, .kvh = c.kvh, .tables = m.tables.ptr, .row_tab = m.row_tab.ptr };
+    }
+
+    /// One stream's rows (a prompt chunk): the table pointer is the slot's row and `row_tab` is 0.
+    pub fn single(m: *const Mirror, c: Cache, slot: usize) !sp.Paged {
+        const r = try geom.entryBytes(m.slots, m.max_pages, slot, 0, 0);
+        return .{ .pool = c.pool, .page_bytes = c.page_bytes, .layer_off = c.layer_off, .kvh = c.kvh, .tables = m.tables.ptr + r.off };
+    }
+};
+
+test {
+    _ = geom;
+}
diff --git a/zig/src/cuda/minimax_m3_rows_geom.zig b/zig/src/cuda/minimax_m3_rows_geom.zig
new file mode 100644
index 0000000..5115b47
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_rows_geom.zig
@@ -0,0 +1,142 @@
+//! MiniMax-M3.1-Flash row kernels: launch geometry, flag bits and block-table arithmetic (std only, host-testable).
+const std = @import("std");
+
+pub const d = 128; // head_dim and index_head_dim
+pub const block = 128; // tokens a page
+pub const rows_threads = 256; // 8 warps, a warp a head
+pub const rows_warps = 8;
+pub const router_warps = 4; // experts a block
+pub const router_rows = 4; // rows a warp
+pub const router_chunk = 128; // reduction length is a multiple: 32 lanes of 4 values
+pub const router_threads = router_warps * 32;
+pub const max_rot = 128;
+pub const max_rot_pairs = 64;
+pub const max_grid_y = 65535;
+
+/// Bits of the kernel's `flags` argument; the defaults are core/minimax_ref.zig's Switches defaults.
+pub const Flags = struct {
+    norm_qk: bool = true,
+    norm_index: bool = true,
+    index_rope: bool = true,
+    index_fp16: bool = true,
+    round_norm: bool = false,
+    gptj: bool = false,
+
+    pub fn bits(f: Flags) i32 {
+        var b: i32 = 0;
+        if (f.norm_qk) b |= 1;
+        if (f.norm_index) b |= 2;
+        if (f.index_rope) b |= 4;
+        if (f.index_fp16) b |= 8;
+        if (f.round_norm) b |= 16;
+        if (f.gptj) b |= 32;
+        return b;
+    }
+};
+
+/// Bits the kernel ORs into its status word.
+pub const status_no_page: i32 = 1;
+pub const status_past_table: i32 = 2;
+
+pub const Launch = struct { grid: [3]u32, block: u32 };
+
+pub const RowsError = error{ Empty, TooManyRows, BadRot, BadStride, Heads };
+
+/// Head slots a row works through: q, index q, k, v and the index key.
+pub fn slots(nq: usize, niq: usize, kvh: usize, has_ik: bool) usize {
+    return nq + niq + 2 * kvh + @intFromBool(has_ik);
+}
+
+/// One CTA a row; its warps take the slots in order.
+pub fn rowsLaunch(rows: usize) RowsError!Launch {
+    if (rows == 0) return error.Empty;
+    if (rows > std.math.maxInt(i32)) return error.TooManyRows;
+    return .{ .grid = .{ @intCast(rows), 1, 1 }, .block = rows_threads };
+}
+
+/// Rotation width must be even and fit the head; strides keep 8-byte vector loads and stores aligned.
+pub fn checkRows(rot: usize, width: usize, ld: usize) RowsError!void {
+    if (rot == 0 or rot % 2 != 0 or rot > max_rot) return error.BadRot;
+    if (width == 0 or width % d != 0 or ld < width or ld % 4 != 0) return error.BadStride;
+}
+
+pub fn routerLaunch(rows: usize, experts: usize) RowsError!Launch {
+    if (rows == 0 or experts == 0) return error.Empty;
+    const gy = (rows + router_rows - 1) / router_rows;
+    if (gy > max_grid_y) return error.TooManyRows;
+    return .{ .grid = .{ @intCast((experts + router_warps - 1) / router_warps), @intCast(gy), 1 }, .block = router_threads };
+}
+
+pub fn checkRouter(k: usize, x_ld: usize) RowsError!void {
+    if (k == 0 or k % router_chunk != 0 or x_ld < k or x_ld % 4 != 0) return error.BadStride;
+}
+
+pub const TableError = error{ BadSlot, TableFull, Overflow, NoPage, PastTable, Gap };
+
+/// Entry offset of a slot's table row inside the device copy: slot * max_pages, which must fit an int32.
+pub fn entryOffset(slot: usize, max_pages: usize) TableError!i32 {
+    const v = std.math.mul(usize, slot, max_pages) catch return error.Overflow;
+    if (v > std.math.maxInt(i32)) return error.Overflow;
+    return @intCast(v);
+}
+
+/// Byte range of entries [from, from + n) of a slot's row in the device copy.
+pub fn entryBytes(slots_n: usize, max_pages: usize, slot: usize, from: usize, n: usize) TableError!struct { off: usize, len: usize } {
+    if (slot >= slots_n) return error.BadSlot;
+    if (from > max_pages or n > max_pages - from) return error.TableFull;
+    _ = try entryOffset(slots_n, max_pages);
+    return .{ .off = (slot * max_pages + from) * @sizeOf(i32), .len = n * @sizeOf(i32) };
+}
+
+/// A stream's rows in a call: rows [row0, row0 + rows) belong to slot `slot`.
+pub const Seg = struct { slot: u32, rows: usize };
+
+/// row_tab for consecutive segments covering every row: each row's entry is its slot's offset.
+pub fn fillRowTab(out: []i32, segs: []const Seg, slots_n: usize, max_pages: usize) TableError!void {
+    var at: usize = 0;
+    for (segs) |s| {
+        if (s.slot >= slots_n) return error.BadSlot;
+        if (s.rows > out.len - at) return error.Gap;
+        const off = try entryOffset(s.slot, max_pages);
+        @memset(out[at..][0..s.rows], off);
+        at += s.rows;
+    }
+    if (at != out.len) return error.Gap;
+}
+
+/// The page the kernels read for position `pos` of the row whose table starts at entry `off` (the kernel's own lookup).
+pub fn pageOf(tables: []const i32, max_pages: usize, off: usize, pos: usize) TableError!u32 {
+    const b = pos / block;
+    if (b >= max_pages) return error.PastTable;
+    if (off + max_pages > tables.len) return error.TableFull;
+    const id = tables[off + b];
+    return if (id < 0) error.NoPage else @intCast(id);
+}
+
+/// Checks every row of a call before it launches: a page for the row's position. `row_tab` null: one table at entry 0.
+pub fn checkCall(tables: []const i32, max_pages: usize, row_tab: ?[]const i32, pos: ?[]const i32, pos0: i32, rows: usize) TableError!void {
+    for (0..rows) |r| {
+        const p: i32 = if (pos) |a| a[r] else pos0 + @as(i32, @intCast(r));
+        if (p < 0) continue;
+        const off: usize = if (row_tab) |t| @intCast(t[r]) else 0;
+        _ = try pageOf(tables, max_pages, off, @intCast(p));
+    }
+}
+
+/// Blocks (= pages) a stream with positions up to `pos` needs.
+pub fn pagesNeeded(pos: usize) usize {
+    return pos / block + 1;
+}
+
+test "launch geometry and flag bits" {
+    const l = try rowsLaunch(300);
+    try std.testing.expectEqual([3]u32{ 300, 1, 1 }, l.grid);
+    try std.testing.expectEqual(@as(u32, 256), l.block);
+    try std.testing.expectError(error.Empty, rowsLaunch(0));
+    const r = try routerLaunch(5, 128);
+    try std.testing.expectEqual([3]u32{ 32, 2, 1 }, r.grid);
+    try std.testing.expectEqual(@as(u32, 128), r.block);
+    try std.testing.expectEqual(@as(usize, 32 + 2 + 4 + 1), slots(32, 2, 2, true));
+    try std.testing.expectEqual(@as(i32, 1 | 2 | 4 | 8), (Flags{}).bits());
+    try std.testing.expectEqual(@as(i32, 16 | 32), (Flags{ .norm_qk = false, .norm_index = false, .index_rope = false, .index_fp16 = false, .round_norm = true, .gptj = true }).bits());
+}
