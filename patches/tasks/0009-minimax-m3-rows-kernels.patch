+        .{ .w_add = 1, .w_add_index = 1 },
+        .{ .flags = .{ .index_fp16 = false } },
+        .{ .flags = .{ .norm_qk = false, .norm_index = false } },
+    };
+    for (variants) |o| {
+        var f = try Fix.init(rng, 3, o.flags.index_fp16);
+        defer f.deinit();
+        if (o.w_add == 1) rawNorms(&f);
