+        .{ .launch = .{ .name = "minimax_m3_rows tf_mm3_router_f32", .symbol = "tf_mm3_router_f32", .image = "minimax_m3_rows", .threads = 128 }, .usage = .{ u(56, 0, 128), u(56, 0, 128), u(56, 0, 128), u(51, 0, 128), u(51, 0, 128) } },
