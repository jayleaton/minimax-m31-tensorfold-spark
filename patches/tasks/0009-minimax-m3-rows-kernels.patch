+    return .{
+        .{ .launch = .{ .name = "minimax_m3_rows tf_mm3_rows", .symbol = "tf_mm3_rows", .image = "minimax_m3_rows", .threads = 256 }, .usage = .{ u(48, 4608, 256), u(48, 4608, 256), u(48, 4608, 256), u(48, 4608, 256), u(48, 4608, 256) } },
