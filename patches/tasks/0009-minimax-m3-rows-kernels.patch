+//! MiniMax-M3.1-Flash row kernels' launch records: nvcc 13.0.88 cuobjdump, sm_80, 86, 89, 120, 121.
+const L = @import("limits.zig");
+
+fn u(regs: u32, static: u32, bound: u32) L.Usage {
