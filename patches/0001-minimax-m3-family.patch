+++ b/zig/src/families/minimax_m3/native.zig
@@ -0,0 +1,410 @@
+//! MiniMax-M3.1-Flash behind the native CUDA host (GLM's contract): `open` checks, joins the ranks, builds the engine.
+const std = @import("std");
+const cuda = @import("cuda");
+const kv = @import("core").kv_pool;
+const lanes = @import("lanes");
+const iface = @import("iface.zig");
+const ranks = @import("ranks.zig");
+const budget = @import("budget.zig");
+const config = @import("config.zig");
+const load = @import("load.zig");
+const pool = @import("pool.zig");
+const shard = @import("shard.zig");
+const pages = @import("pages.zig");
+const weights_device = @import("weights_device.zig");
+const engine = @import("engine.zig");
+const engine_dev = @import("engine_dev.zig");
+const follow = @import("follow.zig");
+const backend = @import("backend.zig");
+const dspark_config = @import("dspark_config.zig");
+const dspark_folder = @import("dspark_folder.zig");
+const dspark_drafter = @import("dspark_drafter.zig");
+
+pub const model_type = config.model_type;
+pub const formats: []const []const u8 = &.{"exl3"};
+// The plan says 65,536 to 131,072 tokens; the host's memory plan and `admission` decide what really fits.
+pub const default_context: i64 = 65536;
+pub const max_segments: u32 = 1;
+pub const prompt_rows: u32 = iface.prefill_rows;
+pub const window_rows: u32 = iface.window_rows;
+pub const explains_open = true;
+// --drafter takes the dspark draft (the checkpoint's own dspark/ folder, or a folder of one): there is no MTP head
+pub const takes_drafter = true;
+// Decision M2: the backend owns a radix prompt cache over the pool's pages, so the host builds no snapshot store.
+pub const owns_prompt_cache = iface.decisions.owns_prompt_cache;
+
+/// The server's reading of this rank's room after its load (the budget streams are admitted by); null if unreadable.
+pub const Room = struct { ctx: *anyopaque, read: *const fn (*anyopaque) ?u64 };
+
+pub const Options = struct {
+    context: usize,
+    drafts: bool, // read by the host; this family has no head, so it drafts by copies only
+    segments: usize = 1,
+    slide: bool = false,
+    lanes: u32 = 1,
+    lanes_fixed: bool = false,
+    room: ?Room = null,
+    grant: u64 = 0, // the host's room before the load, net of its reserve (0: unknown, budget unchecked); decision M10
+    kv8: bool = false, // --kv-cache fp8: K and V pages as e4m3 rows with an fp32 scale each; the index keys stay bf16 (docs/fp8-kv.md)
+    drafter: ?[]const u8 = null, // --drafter: the dspark draft ("dspark": the checkpoint's own folder, else a folder); every rank gets it
+    drafter_bits: u8 = 4, // --drafter-bits: read and ignored (the draft is mxfp8 as shipped)
+};
+
+/// The smallest room among the other ranks and whose it is.
+pub const Peer = struct { bytes: u64, rank: usize };
+
+pub const Loaded = struct {
+    backend: lanes.backend.Backend,
+    facts: lanes.Model,
+    rows: u32,
+    stream_bytes: usize = 0, // every stream is paged: its table row is the layout's fixed part
+    free_streams: u32 = iface.decisions.free_streams,
+    ctx: *anyopaque,
+    deinit: *const fn (*anyopaque) void,
+    layout: ?kv.Layout = null,
+    peer_room: ?Peer = null,
+};
+
+/// What `attach` builds on and `open` owns: the page state of rank 0 and, past `open`, its engine, link and lanes.
+pub const Owned = struct {
+    gpa: std.mem.Allocator,
+    layout: kv.Layout,
+    max_pages: usize,
+    window: u64 = window_rows,
+    pages: ?*pages.Pages = null,
+    up: bool = false, // the engine below exists (a test builds the page state alone)
+    group: cuda.tp_group.Group = undefined, // the ranks' communicator; two ranks add RoCE writes for the main stream
+    e: *engine.Engine = undefined,
+    wire: engine_dev.NcclWire = undefined,
+    link: follow.Link = undefined,
+    bits: engine_dev.Bits = undefined,
+    io: std.Io = undefined,
+    lanes: backend.Lanes = undefined,
+    draft_dir: ?[]u8 = null, // the dspark folder in use (gpa-owned), null: no draft
+    draft_cfg: dspark_config.Config = dspark_config.flash,
+    draft_stream_bytes: usize = 0, // device bytes a stream holds for the draft on a rank (ring and pass scratch)
+};
+
+/// Slots for `context` plus a verify window, whole pages: the longest sequence a stream holds.
+pub fn capacity(context: usize) usize {
+    return std.mem.alignForward(usize, context + window_rows, pool.page_tokens);
+}
+
+/// Bytes this rank's weights take, for the host's admission: the plan's exact slot bytes, else the whole checkpoint.
+pub fn weightShare(a: std.mem.Allocator, io: std.Io, dir: []const u8, total: u64) u64 {
+    const p = ranks.place(&ranks.environment) catch return total;
+    const path = std.fs.path.join(a, &.{ dir, "config.json" }) catch return total;
+    const text = std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(1 << 24)) catch return total;
+    const c = config.parse(a, text) catch return total;
+    var cat = load.Catalog.open(a, io, dir) catch return total;
+    defer cat.deinit();
+    var plan = load.Plan.build(a, &cat, &c, shard.Share.of(&c, p.rank, p.world) catch return total, .{}) catch return total;
+    defer plan.deinit();
+    return plan.slotBytes();
+}
+
+/// The pool behind the engine: `streams` paged sequences and `count` pages, made now (decision M1: all streams page).
+pub fn attach(p: *anyopaque, streams: u32, count: usize) !void {
+    const own: *Owned = @ptrCast(@alignCast(p));
+    if (own.pages) |old| {
+        own.lanes.pages = null;
+        old.destroy();
+        own.pages = null;
+    }
+    const made = try pages.Pages.create(own.gpa, own.layout, streams, count, own.max_pages, own.window);
+    errdefer made.destroy();
+    if (own.up) { // the arena and tables on every rank first, then rank 0's pushes reach its own device table
+        try own.lanes.x.attach(streams, count);
+        made.tables.upload = own.e.uploadHook();
+        own.lanes.pages = made;
+        try own.lanes.x.idle(); // no stream yet: the other ranks sleep on their lines until the first
+    }
+    own.pages = made;
+}
+
+/// The prompt cache's limits from the host's plan: pages and snapshot records (0 and 0: off).
+pub fn cache_limit(p: *anyopaque, count: usize, snaps: usize) void {
+    const own: *Owned = @ptrCast(@alignCast(p));
+    if (own.pages) |pg| pg.limit(count, snaps);
+}
+
+/// Whether a request's caches fit now (the lane host's admission, on its engine thread).
+pub fn fits(p: *anyopaque, prompt: u32, max_tokens: u32) bool {
+    const own: *Owned = @ptrCast(@alignCast(p));
+    return if (own.pages) |pg| pg.fits(prompt, max_tokens) else false;
+}
+
+/// The words of the last budget refusal (single-threaded start-up), for `explain`.
+var detail_buf: [1024]u8 = undefined;
+var detail_len: usize = 0;
+
+/// What the host-side checks of `open` conclude for this rank at `context`: its place, plan and the budget's verdict.
+pub const Admission = struct { place: ranks.Place, weights: u64, verdict: ?budget.Verdict, fingerprint_weights: [32]u8 };
+
+/// What the dspark draft adds to a rank's budget: weights, module, absorb chunk, ring snapshots, a ring a stream.
+pub fn draftCost(dcfg: *const dspark_config.Config, share: shard.Share) dspark_config.Cost {
+    var cost = dspark_config.cost(dcfg, share, window_rows, prompt_rows, false);
+    cost.runtime += @as(u64, backend.max_snaps) * dspark_config.ringBytes(dcfg, share, window_rows);
+    return cost;
+}
+
+pub fn admission(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, c: *const config.Config, p: ranks.Place, o: Options) !Admission {
+    return admissionWith(gpa, io, dir, c, p, o, null);
+}
+
+/// `admission` with the dspark draft's cost (spent before any KV) in the budget.
+pub fn admissionWith(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, c: *const config.Config, p: ranks.Place, o: Options, draft: ?dspark_config.Cost) !Admission {
+    var cat = try load.Catalog.open(gpa, io, dir);
+    defer cat.deinit();
+    const share = try shard.Share.of(c, p.rank, p.world);
+    var plan = try load.Plan.build(gpa, &cat, c, share, .{});
+    defer plan.deinit();
+    const dims = (try pool.Dims.of(c, share)).withKv8(o.kv8);
+    var out: Admission = .{ .place = p, .weights = plan.slotBytes(), .verdict = null, .fingerprint_weights = try weights_device.digest(gpa, &cat) };
+    if (o.grant == 0) return out;
+    const terms = if (draft) |dcost| budget.withDraft(budget.hosted(), dcost) else budget.hosted();
+    out.verdict = budget.check(dims, .{ .available = o.grant, .weights = out.weights, .terms = terms, .lanes = o.lanes, .lanes_fixed = o.lanes_fixed, .window = window_rows, .max_positions = c.max_positions }, o.context);
+    return out;
+}
+
+pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: ?[]const u8, o: Options) !Loaded {
+    _ = kernels; // our own kernels: a captured set is not used
+    const p = try ranks.admit(&ranks.environment);
+    var problem: []const u8 = "";
+    var set = ranks.Settings.read(&ranks.environment, &problem) catch |err| {
+        std.log.err("{s}", .{problem});
+        return err;
+    };
+    set.kv8 = o.kv8; // the ranks' fingerprint carries it: a rank started without --kv-cache fp8 stops the others
+    const path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+    defer gpa.free(path);
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 24));
+    defer gpa.free(text);
+    const c = try config.parse(gpa, text);
+    var draft_dir: ?[]u8 = null;
+    errdefer if (draft_dir) |dd| gpa.free(dd);
+    var draft_cfg: dspark_config.Config = dspark_config.flash;
+    var draft_cost: ?dspark_config.Cost = null;
+    if (o.drafter) |value| if (o.drafts) { // --no-drafts leaves the draft unloaded
+        draft_dir = dspark_folder.resolve(gpa, io, dir, value) catch |err| switch (err) {
+            error.NoDraft => return refuse(dspark_folder.words(&detail_buf, dir, value), error.DrafterRefused),
+            else => return err,
+        };
+        draft_cfg = try loadDraftConfig(gpa, io, draft_dir.?, &c, p);
+        draft_cost = draftCost(&draft_cfg, try shard.Share.of(&c, p.rank, p.world));
+    };
+    const a = try admissionWith(gpa, io, dir, &c, p, o, draft_cost);
+    if (a.verdict) |v| switch (v) {
+        .refused => |r| {
+            const words = std.fmt.bufPrint(&detail_buf, "{f}", .{r}) catch detail_buf[0..0];
+            detail_len = words.len;
+            return error.BudgetRefused;
+        },
+        .ok => |cap| std.log.info("minimax budget: {d} tokens a stream, {d} pages, {d:.2} GiB of KV room, {s} K/V (the host's plan has the last word)", .{ cap.context, cap.pages, @as(f64, @floatFromInt(cap.pool_bytes)) / (1 << 30), if (o.kv8) "fp8" else "bf16" }),
+    };
+    // the ranks' lines before NCCL (cuda/tp_watch.zig): a rank that fails, refuses or dies stops every rank
+    if (p.world > 1) try cuda.tp_watch.start(io, p.rank, p.world);
+    return openRank(gpa, io, ctx, dir, &c, o, p, set, draft_dir, draft_cfg) catch |err| {
+        cuda.tp_watch.fail(@errorName(err)); // the other ranks stop with this rank's error
+        return err;
+    };
+}
+
+/// `open` once the ranks' lines are up: NCCL, the engine and the link, then a follower's loop or rank 0's lanes.
+fn openRank(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, c: *const config.Config, o: Options, p: ranks.Place, set: ranks.Settings, draft_dir: ?[]u8, draft_cfg: dspark_config.Config) !Loaded {
+    const share = try shard.Share.of(c, p.rank, p.world);
+    const dims = (try pool.Dims.of(c, share)).withKv8(o.kv8);
+    const cap = capacity(o.context);
+    const own = try gpa.create(Owned);
+    errdefer gpa.destroy(own);
+    own.* = .{ .gpa = gpa, .layout = dims.layout(iface.maxPages(cap)), .max_pages = iface.maxPages(cap), .io = io, .draft_dir = draft_dir, .draft_cfg = draft_cfg };
+    errdefer if (own.draft_dir) |dd| gpa.free(dd);
+    engine_dev.setNcclDefaults();
+    var lib = try cuda.nccl.Library.open();
+    errdefer lib.close();
+    var id: cuda.nccl.UniqueId = undefined;
+    try lib.check(lib.api.ncclGetUniqueId(&id), "ncclGetUniqueId"); // NCCL_COMM_ID: the same id on every rank
+    var comm: cuda.nccl.Comm = null;
+    try lib.check(lib.api.ncclCommInitRank(&comm, @intCast(p.world), id, @intCast(p.rank)), "ncclCommInitRank");
+    own.group = .{ .lib = lib, .comm = comm, .rank = p.rank, .world = p.world };
+    errdefer _ = own.group.lib.api.ncclCommDestroy(own.group.comm);
+    if (p.world > 1) try engine_dev.warmPeers(ctx.d, &own.group);
+    own.e = try engine.Engine.init(gpa, io, ctx.d, ctx, dir, &own.group.lib, own.group.comm, p.rank, p.world, .{ .capacity = cap, .settings = set, .drafter = draft_dir });
+    errdefer own.e.deinit();
+    const stream = own.e.p.stream.?;
+    const roce_bytes = @as(usize, if (set.roce_kb == 0) 4096 else set.roce_kb) * 1024;
+    try own.group.openRoce(gpa, io, ctx.d, stream, roce_bytes); // both ranks bring it up or neither does
+    errdefer if (own.group.fast) |f| f.deinit();
+    own.e.setGroup(&own.group);
+    own.wire = try engine_dev.NcclWire.init(ctx.d, &own.group.lib, own.group.comm, stream, follow.Link.capacityFor(cap));
+    errdefer own.wire.deinit();
+    own.link = try follow.Link.init(gpa, own.wire.wire(), engine_dev.hooksWith(&own.io), cap);
+    errdefer own.link.deinit();
+    // Rank 0 admits by the smallest room of the ranks.
+    const rooms = try gpa.alloc(u64, p.world);
+    defer gpa.free(rooms);
+    const mine: u64 = if (o.room) |r| r.read(r.ctx) orelse 0 else std.math.maxInt(u64);
+    try own.e.p.comm.gatherBytes(std.mem.asBytes(&mine), std.mem.sliceAsBytes(rooms));
+    var peer: ?Peer = null;
+    for (rooms[1..], 1..) |r, q| if (peer == null or r < peer.?.bytes) {
+        peer = .{ .bytes = r, .rank = q };
+    };
+    // every rank loaded and agreed (the fingerprint) before the first step; the digest names what they agreed on
+    if (p.world > 1) try cuda.tp_watch.ready(io, own.e.checkpoint_digest);
+    if (p.rank != 0) { // a follower never serves: it runs rank 0's steps, then leaves the process
+        follow.follow(own.e, &own.link) catch |err| {
+            std.log.err("rank {d}: following rank 0 stopped ({s})", .{ p.rank, @errorName(err) });
+            std.c._exit(1); // follow told the other ranks; the stream may hold kernels waiting on a gone rank
+        };
+        std.log.info("rank {d}: rank 0 ended; leaving", .{p.rank});
+        std.process.exit(0);
+    }
+    own.link.asleep = cuda.tp_watch.open(); // the other ranks begin asleep (follow): the first step wakes them
+    own.bits = .{ .gpa = gpa, .words = (c.vocab + 31) / 32 };
+    own.lanes = .{ .gpa = gpa, .x = .{ .e = own.e, .link = &own.link }, .masks = own.bits.interface() };
+    if (own.draft_dir != null) {
+        own.draft_stream_bytes = @intCast(draftCost(&own.draft_cfg, share).per_lane);
+        own.lanes.tap_ids = own.draft_cfg.tapIds(); // the layers the forward taps for the draft
+        own.lanes.tap_hidden = own.draft_cfg.hidden;
+    }
+    own.up = true;
+    return .{
+        .backend = own.lanes.backend(),
+        .facts = own.lanes.facts(), // (with a draft: no copy branch beside a drafted window, which would be a tree)
+        .rows = window_rows,
+        .stream_bytes = 0, // every stream pages: its table row is the layout's fixed part
+        .free_streams = iface.decisions.free_streams,
+        .ctx = own,
+        .deinit = close,
+        .layout = own.layout,
+        .peer_room = peer,
+    };
+}
+
+fn close(ptr: *anyopaque) void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    own.lanes.stopped = true; // no snapshot step may follow the end step
+    own.lanes.x.end() catch {}; // the other ranks leave on the end step, so their lines close on purpose from here
+    own.lanes.deinit();
+    if (own.pages) |pg| pg.destroy();
+    own.link.deinit();
+    own.wire.deinit();
+    own.bits.deinit();
+    own.e.deinit();
+    own.group.close();
+    if (own.draft_dir) |dd| own.gpa.free(dd);
+    own.gpa.destroy(own);
+}
+
+/// The words of the last refusal at start-up, then the error: `explain` shows them.
+fn refuse(words: []const u8, err: anyerror) anyerror {
+    detail_len = words.len;
+    if (words.ptr != &detail_buf) @memcpy(detail_buf[0..words.len], words);
+    return err;
+}
+
+/// The draft's config.json in `dir`, parsed and checked against the model and the ranks; refusals in words.
+fn loadDraftConfig(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, c: *const config.Config, p: ranks.Place) !dspark_config.Config {
+    const path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+    defer gpa.free(path);
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 24));
+    defer gpa.free(text);
+    const dcfg = dspark_config.parse(gpa, text) catch |err| {
+        const words = std.fmt.bufPrint(&detail_buf, "--drafter: {s} is not a draft this engine runs ({s}): it takes the pack's DSparkMiniMaxDraftModel", .{ dir, @errorName(err) }) catch detail_buf[0..0];
+        return refuse(words, error.DrafterRefused);
+    };
+    if (dspark_config.admit(&dcfg, c, .{ .world = p.world, .window_rows = window_rows })) |why| return refuse(why.text(), error.DrafterRefused);
+    return dcfg;
+}
+
+/// --drafter on the lane host: the dspark draft (loaded with the engine on every rank) behind the core's Drafted.
+pub fn openDrafter(gpa: std.mem.Allocator, io: std.Io, p: *anyopaque, dir: []const u8, bits: u8) !struct { drafter: lanes.drafter.Drafter, ctx: *anyopaque, close: *const fn (*anyopaque) void, reserve: *const fn (*anyopaque, u32) anyerror!void } {
+    _ = io;
+    _ = dir; // the folder was resolved and loaded in `open`, on every rank
+    _ = bits;
+    const own: *Owned = @ptrCast(@alignCast(p));
+    if (own.draft_dir == null) return error.NoDraft;
+    const d = try dspark_drafter.Draft.init(gpa, &own.lanes, own.draft_cfg, .{ .stream_bytes = own.draft_stream_bytes });
+    return .{ .drafter = d.drafter(), .ctx = d, .close = closeDrafter, .reserve = reserveDrafter };
+}
+
+fn reserveDrafter(_: *anyopaque, _: u32) anyerror!void {} // the rings are made at `attach`, for the host's streams
+
+fn closeDrafter(p: *anyopaque) void {
+    const d: *dspark_drafter.Draft = @ptrCast(@alignCast(p));
+    d.deinit();
+}
+
+/// The server's words for this family's refusals.
+pub fn explain(_: ?*anyopaque, err: anyerror) ?[]const u8 {
+    inline for (@typeInfo(ranks.Error).error_set.error_names.?) |name| {
+        if (err == @field(anyerror, name)) return ranks.refusal(@field(ranks.Error, name));
+    }
+    return switch (err) {
+        error.EngineNotBuilt => "MiniMax-M3.1-Flash is registered and its checkpoint, ranks and memory budget were checked, but this build has no forward pass for it yet (the engine, prefill and lanes backend are not in this tree)",
+        error.ForwardNotBuilt => "MiniMax-M3.1-Flash's ranks agreed and its engine loop is built, but this build has no forward or prompt pass to run on it (forward.zig and prefill.zig are not in this tree)",
+        error.VisionUnsupported => "MiniMax-M3.1-Flash on CUDA is text only: this pack has no vision tower, send the request without images",
+        error.RankLost => "another rank of MiniMax-M3.1-Flash stopped: every rank ends, start them again",
+        error.BudgetRefused, error.DrafterRefused => detail_buf[0..detail_len],
+        error.RankMismatch => "the ranks' settings differ (each rank's log names the one): start them alike",
+        error.BadRank => "TF_MM3_WORLD is larger than the checkpoint can be cut for (4 kv heads, 128-unit widths)",
+        else => null,
+    };
+}
+
+comptime {
+    iface.conformsNative(@This());
+}
+
+test "capacity keeps a verify window past the context, in whole pages" {
+    try std.testing.expectEqual(@as(usize, 65664), capacity(65536));
+    try std.testing.expectEqual(@as(usize, 128), capacity(1));
+    try std.testing.expect(capacity(100000) % pool.page_tokens == 0 and capacity(100000) >= 100000 + window_rows);
+}
+
+test "attach makes the pool, fits asks it, the cache limit reaches the store, and a family without pages refuses" {
+    const gpa = std.testing.allocator;
+    const l: kv.Layout = .{ .fixed_bytes = 4096, .token_bytes = 1024, .page_tokens = pool.page_tokens, .snap_bytes = pool.snap_bytes, .all_paged = true };
+    var own: Owned = .{ .gpa = gpa, .layout = l, .max_pages = 64 };
+    try std.testing.expect(!fits(&own, 10, 10));
+    try attach(&own, 2, 100);
+    defer own.pages.?.destroy();
+    try std.testing.expect(fits(&own, 1000, 100));
+    try std.testing.expect(!fits(&own, 100 * 128, 0));
+    cache_limit(&own, 40, 8);
+    try attach(&own, 3, 50);
+    try std.testing.expectEqual(@as(usize, 50), own.pages.?.pages.total());
+}
+
+test "explain words every named refusal and leaves foreign errors to the host" {
+    try std.testing.expect(std.mem.indexOf(u8, explain(null, error.NoRank).?, "TF_MM3_RANK") != null);
+    try std.testing.expect(std.mem.indexOf(u8, explain(null, error.NoCommId).?, "NCCL_COMM_ID") != null);
+    try std.testing.expect(std.mem.indexOf(u8, explain(null, error.EngineNotBuilt).?, "no forward pass") != null);
+    try std.testing.expect(explain(null, error.OutOfMemory) == null);
+}
+
+test "the draft's cost: its weights, the module and absorb chunk with eight ring snapshots, and a ring a stream" {
+    const share = try shard.Share.of(&config.flash, 0, 2);
+    const base = dspark_config.cost(&dspark_config.flash, share, window_rows, prompt_rows, false);
+    const cost = draftCost(&dspark_config.flash, share);
+    try std.testing.expectEqual(base.weights, cost.weights);
+    try std.testing.expectEqual(base.per_lane, cost.per_lane);
+    try std.testing.expectEqual(base.runtime + 8 * 21_053_440, cost.runtime);
+    const terms = budget.withDraft(budget.hosted(), cost);
+    try std.testing.expectEqual(cost.weights + cost.runtime + 3 * cost.per_lane, budget.draftBytes(terms, 3));
+    try std.testing.expect(budget.draftBytes(budget.hosted(), 3) == 0);
+}
+
+test "a refused draft is worded for the server, and --drafter is taken" {
+    const words = "--drafter: nothing here";
+    try std.testing.expectEqual(@as(anyerror, error.DrafterRefused), refuse(words, error.DrafterRefused));
+    try std.testing.expectEqualStrings(words, explain(null, error.DrafterRefused).?);
+    try std.testing.expect(takes_drafter and @hasDecl(@This(), "openDrafter"));
+}
+
+test "the family's declarations are the ones the host reads" {
+    try std.testing.expectEqualStrings("minimax_m3_vl", model_type);
+    try std.testing.expectEqualStrings("exl3", formats[0]);
+    try std.testing.expect(owns_prompt_cache and explains_open);
+    try std.testing.expectEqual(@as(u32, 2048), prompt_rows);
+}
diff --git a/zig/src/families/minimax_m3/pages.zig b/zig/src/families/minimax_m3/pages.zig
new file mode 100644
index 0000000..663ce63
--- /dev/null
+++ b/zig/src/families/minimax_m3/pages.zig
@@ -0,0 +1,72 @@
+//! The host half of the engine's page state: page ids, the radix prompt cache, the block tables (device half: T8).
+const std = @import("std");
+const kv = @import("core").kv_pool;
+const pool = @import("pool.zig");
+const state = @import("state.zig");
+
+pub const Pages = struct {
+    gpa: std.mem.Allocator,
+    pages: kv.Pool,
+    cache: state.Cache,
+    tables: pool.Tables,
+    layout: kv.Layout,
+    max_pages: usize,
+    window: u64,
+
+    /// `streams` slots of at most `max_pages` pages over a pool of `count` pages; `window` rows past a reply.
+    pub fn create(gpa: std.mem.Allocator, layout: kv.Layout, streams: u32, count: usize, max_pages: usize, window: u64) !*Pages {
+        const p = try gpa.create(Pages);
+        errdefer gpa.destroy(p);
+        p.gpa = gpa;
+        p.layout = layout;
+        p.max_pages = max_pages;
+        p.window = window;
+        p.pages = try kv.Pool.init(gpa, count, layout.pageBytes());
+        errdefer p.pages.deinit();
+        p.tables = try pool.Tables.init(gpa, streams, max_pages);
+        errdefer p.tables.deinit();
+        try p.cache.init(gpa, &p.pages, layout, state.rules);
+        return p;
+    }
+
+    pub fn destroy(p: *Pages) void {
+        const gpa = p.gpa;
+        p.cache.deinit();
+        p.tables.deinit();
+        p.pages.deinit();
+        gpa.destroy(p);
+    }
+
+    /// Whether a request's prompt, reply and last window can be promised now (the store's idle pages counted).
+    pub fn fits(p: *Pages, prompt: u32, max_tokens: u32) bool {
+        const need = p.cache.need(prompt, max_tokens, p.window);
+        return need <= p.max_pages and need <= p.pages.total() and p.pages.fits(need);
+    }
+
+    /// The prompt cache may hold `count` pages (half the pool at most) and `snaps` records; 0 and 0 switches it off.
+    pub fn limit(p: *Pages, count: usize, snaps: usize) void {
+        p.cache.limit(@min(count, p.pages.total() / 2), snaps);
+    }
+};
+
+test "pages: the cache is limited to half the pool, a request that cannot fit is refused, and teardown is clean" {
+    const gpa = std.testing.allocator;
+    const l: kv.Layout = .{ .fixed_bytes = 4096, .token_bytes = 1024, .page_tokens = pool.page_tokens, .snap_bytes = pool.snap_bytes, .all_paged = true };
+    const p = try Pages.create(gpa, l, 2, 64, 32, 16);
+    defer p.destroy();
+    try std.testing.expect(p.fits(1000, 100)); // 9 pages
+    try std.testing.expect(!p.fits(4000, 200)); // 33 pages: past the table row
+    try std.testing.expect(!p.fits(70 * 128, 0)); // past the pool
+    p.limit(1000, 8);
+    try std.testing.expect(p.pages.idle());
+    var s: state.Stream = .{ .slot = 1 };
+    var sink = p.tables.sink(1);
+    const prompt: [3000]u32 = @splat(7);
+    const marks = try p.cache.admit(gpa, &s, &prompt, 0, 100, p.window, sink.table(), p.max_pages);
+    defer gpa.free(marks);
+    try std.testing.expectEqual(@as(usize, 25), s.lease.ids.items.len);
+    try std.testing.expectEqual(@as(?u32, s.lease.ids.items[3]), p.tables.page(1, 3));
+    p.cache.end(&s, &p.tables);
+    try std.testing.expect(p.pages.idle());
+    try std.testing.expectEqual(@as(?u32, null), p.tables.page(1, 3));
+}
diff --git a/zig/src/families/minimax_m3/pool.zig b/zig/src/families/minimax_m3/pool.zig
new file mode 100644
index 0000000..4eeb9c9
--- /dev/null
+++ b/zig/src/families/minimax_m3/pool.zig
@@ -0,0 +1,208 @@
+//! MiniMax-M3.1-Flash's paged KV on core/kv_pool.zig: a rank's page geometry, its Layout, and the attention block tables.
+//! One page is one selection block (128 keys), so the kernels address a block by its page id and nothing else.
+const std = @import("std");
+const kv = @import("core").kv_pool;
+const Config = @import("config.zig").Config;
+const shard = @import("shard.zig");
+
+/// Tokens a page holds: the sparse attention's block (`sparse_attention_config` block size, checked in `Dims.of`).
+pub const page_tokens: u32 = 128;
+/// bf16 K, V and IK; with `Dims.kv8` K and V are one byte a value (e4m3) beside an fp32 scale a row, IK stays bf16.
+const elem: u64 = 2;
+/// An fp8 K or V row's scale (one per token and kv head, fp32).
+pub const scale_bytes: u64 = 4;
+/// A kept prompt snapshot is a record of a position (the pages are the store's references): its nominal slot.
+pub const snap_bytes: u64 = 64;
+
+pub const Error = error{ BlockIsNotPage, TableFull, BadSlot };
+
+/// What a rank caches a token and layer: its kv heads' K and V, and the one shared index key head.
+pub const Dims = struct {
+    layers: u32,
+    kv_heads: u32, // this rank's
+    head_dim: u32,
+    index_dim: u32,
+    /// `--kv-cache fp8`: K and V as e4m3 rows with an fp32 scale each (docs/fp8-kv.md). Index keys stay bf16.
+    kv8: bool = false,
+
+    /// The same dims with the fp8 cache on or off.
+    pub fn withKv8(d: Dims, on: bool) Dims {
+        var r = d;
+        r.kv8 = on;
+        return r;
+    }
+
+    /// Rank `s.rank`'s dims. Index keys are replicated: every rank scores its own index heads over the whole IK.
+    pub fn of(c: *const Config, s: shard.Share) Error!Dims {
+        if (c.index.block != page_tokens) return error.BlockIsNotPage;
+        return .{ .layers = c.layers, .kv_heads = @intCast(s.kv_heads.len()), .head_dim = c.head_dim, .index_dim = c.index.dim };
+    }
+
+    /// Bytes a token adds in one layer: K and V of the rank's heads, then the index key (and fp8's two scales a head).
+    pub fn layerToken(d: Dims) u64 {
+        if (d.kv8) return 2 * @as(u64, d.kv_heads) * (d.head_dim + scale_bytes) + @as(u64, d.index_dim) * elem;
+        return (2 * @as(u64, d.kv_heads) * d.head_dim + d.index_dim) * elem;
+    }
+
+    /// Bytes a token adds across every layer (76,800 for the shipped model at two ranks; 47,040 with fp8 K and V).
+    pub fn tokenBytes(d: Dims) u64 {
+        return d.layerToken() * d.layers;
+    }
+
+    pub fn pageBytes(d: Dims) u64 {
+        return d.tokenBytes() * page_tokens;
+    }
+
+    /// Bytes of one stream's block-table row of `max_pages` entries.
+    pub fn tableBytes(max_pages: u64) u64 {
+        return max_pages * @sizeOf(i32);
+    }
+
+    /// The layout for streams of at most `max_pages` pages: the table row is their fixed part, every stream pages.
+    pub fn layout(d: Dims, max_pages: u64) kv.Layout {
+        return .{ .fixed_bytes = tableBytes(max_pages), .token_bytes = d.tokenBytes(), .page_tokens = page_tokens, .snap_bytes = snap_bytes, .all_paged = true };
+    }
+
+    /// Where things sit inside one page, per layer: `K[kvh][128 tok][head_dim]`, `V[kvh][128][head_dim]`, `IK[128][index_dim]`.
+    pub fn map(d: Dims) PageMap {
+        return .{ .d = d };
+    }
+};
+
+pub const PageMap = struct {
+    d: Dims,
+
+    fn layerBytes(m: PageMap) u64 {
+        return m.d.layerToken() * page_tokens;
+    }
+    fn valueBytes(m: PageMap) u64 {
+        return if (m.d.kv8) 1 else elem;
+    }
+    fn headBytes(m: PageMap) u64 {
+        return @as(u64, page_tokens) * m.d.head_dim * m.valueBytes();
+    }
+    fn kvBytes(m: PageMap) u64 {
+        return m.d.kv_heads * m.headBytes();
+    }
+
+    /// Byte offset of kv head `kvh`'s first key at `layer`; row `t` adds `t * head_dim * 2` (`* 1` with fp8).
+    pub fn k(m: PageMap, layer: u32, kvh: u32) u64 {
+        std.debug.assert(layer < m.d.layers and kvh < m.d.kv_heads);
+        return layer * m.layerBytes() + kvh * m.headBytes();
+    }
+
+    pub fn v(m: PageMap, layer: u32, kvh: u32) u64 {
+        std.debug.assert(layer < m.d.layers and kvh < m.d.kv_heads);
+        return layer * m.layerBytes() + m.kvBytes() + kvh * m.headBytes();
+    }
+
+    /// fp8 only: the 128 fp32 scales of K head `kvh` (row t's at `t * 4`) / of V head `kvh`, after the index keys.
+    pub fn kScale(m: PageMap, layer: u32, kvh: u32) u64 {
+        std.debug.assert(m.d.kv8 and layer < m.d.layers and kvh < m.d.kv_heads);
+        return layer * m.layerBytes() + 2 * m.kvBytes() + page_tokens * m.d.index_dim * elem + @as(u64, kvh) * page_tokens * scale_bytes;
+    }
+    pub fn vScale(m: PageMap, layer: u32, kvh: u32) u64 {
+        return m.kScale(layer, kvh) + @as(u64, m.d.kv_heads) * page_tokens * scale_bytes;
+    }
+
+    /// The block's index keys at `layer`: 128 rows of `index_dim`, contiguous.
+    pub fn ik(m: PageMap, layer: u32) u64 {
+        std.debug.assert(layer < m.d.layers);
+        return layer * m.layerBytes() + 2 * m.kvBytes();
+    }
+
+    /// Byte offset of a page's start in the pool's arena.
+    pub fn page(m: PageMap, id: u32) u64 {
+        return @as(u64, id) * m.d.pageBytes();
+    }
+};
+
+/// Page id and row in it of key position `pos`.
+pub fn locate(pos: u64) struct { block: usize, row: u32 } {
+    return .{ .block = @intCast(pos / page_tokens), .row = @intCast(pos % page_tokens) };
+}
+
+/// Pushes `[from, from + len)` of a slot's row to the device (null: the host mirror is the table, as in tests).
+pub const Upload = struct {
+    ctx: *anyopaque,
+    call: *const fn (ctx: *anyopaque, slot: u32, from: usize, entries: []const i32) anyerror!void,
+};
+
+/// The attention kernels' block tables: int32 page ids, one row of `max_pages` a slot, -1 past the stream's pages.
+/// Block `b` of a stream is page `row[b]`: selection lists (block indices) index straight into it.
+pub const Tables = struct {
+    gpa: std.mem.Allocator,
+    rows: []i32,
+    max_pages: usize,
+    slots: u32,
+    upload: ?Upload = null,
+
+    pub fn init(gpa: std.mem.Allocator, slots: u32, max_pages: usize) !Tables {
+        const rows = try gpa.alloc(i32, @as(usize, slots) * max_pages);
+        @memset(rows, -1);
+        return .{ .gpa = gpa, .rows = rows, .max_pages = max_pages, .slots = slots };
+    }
+
+    pub fn deinit(t: *Tables) void {
+        t.gpa.free(t.rows);
+        t.* = undefined;
+    }
+
+    pub fn row(t: *const Tables, slot: u32) []const i32 {
+        return t.rows[@as(usize, slot) * t.max_pages ..][0..t.max_pages];
+    }
+
+    /// The page holding key block `block` of `slot`; null past the stream's pages.
+    pub fn page(t: *const Tables, slot: u32, block: usize) ?u32 {
+        if (block >= t.max_pages) return null;
+        const id = t.row(slot)[block];
+        return if (id < 0) null else @intCast(id);
+    }
+
+    /// Writes `ids` at entry `from` of `slot`'s row; a failed upload leaves the row as it was.
+    pub fn write(t: *Tables, slot: u32, ids: []const u32, from: usize) anyerror!void {
+        if (slot >= t.slots) return error.BadSlot;
+        if (from + ids.len > t.max_pages) return error.TableFull;
+        const dst = t.rows[@as(usize, slot) * t.max_pages + from ..][0..ids.len];
+        var saved: [64]i32 = undefined;
+        const keep = if (ids.len <= saved.len) saved[0..ids.len] else try t.gpa.alloc(i32, ids.len);
+        defer if (ids.len > saved.len) t.gpa.free(keep);
+        @memcpy(keep, dst);
+        for (dst, ids) |*d, id| d.* = @intCast(id);
+        if (t.upload) |u| u.call(u.ctx, slot, from, dst) catch |e| {
+            @memcpy(dst, keep);
+            return e;
+        };
+    }
+
+    /// The slot's row back to -1 (its stream ended).
+    pub fn clear(t: *Tables, slot: u32) void {
+        @memset(t.rows[@as(usize, slot) * t.max_pages ..][0..t.max_pages], -1);
+    }
+
+    /// `kv.Table` for pool.cover: the slot's entries reach this row as pages are taken.
+    pub fn sink(t: *Tables, slot: u32) Sink {
+        return .{ .t = t, .slot = slot };
+    }
+
+    pub const Sink = struct {
+        t: *Tables,
+        slot: u32,
+
+        pub fn table(s: *Sink) kv.Table {
+            return .{ .ctx = s, .write = put };
+        }
+        fn put(ctx: *anyopaque, ids: []const u32, from: usize) anyerror!void {
+            const s: *Sink = @ptrCast(@alignCast(ctx));
+            // cover passes the whole table and `from`: write only the new entries
+            try s.t.write(s.slot, ids[from..], from);
+        }
+    };
+};
+
+test {
+    _ = @import("pool_test.zig");
+    _ = @import("budget.zig");
+    _ = @import("state.zig");
+    _ = @import("state_test.zig");
+}
diff --git a/zig/src/families/minimax_m3/pool_test.zig b/zig/src/families/minimax_m3/pool_test.zig
new file mode 100644
index 0000000..e2bf565
--- /dev/null
+++ b/zig/src/families/minimax_m3/pool_test.zig
@@ -0,0 +1,250 @@
+//! Page geometry, block tables and the memory budget on the shipped model's numbers (plan sections 2 and 5).
+const std = @import("std");
+const kv = @import("core").kv_pool;
+const config = @import("config.zig");
+const shard = @import("shard.zig");
+const pool = @import("pool.zig");
+const budget = @import("budget.zig");
+
+const gpa = std.testing.allocator;
+const expectEqual = std.testing.expectEqual;
+const expect = std.testing.expect;
+const GiB = budget.GiB;
+
+/// The real plan's slotBytes() of rank 0 and 1 (load_test.zig, the full pack's index: 91.0855 GiB and 91.0850 GiB).
+pub const weights_rank0: u64 = 97_801_819_136;
+pub const weights_rank1: u64 = 97_801_229_056;
+
+pub fn dims(rank: usize) !pool.Dims {
+    const c = config.flash;
+    return pool.Dims.of(&c, try shard.Share.of(&c, rank, 2));
+}
+
+test "a rank caches 76,800 bytes a token and a page is 9,830,400" {
+    for ([_]usize{ 0, 1 }) |r| {
+        const d = try dims(r);
+        try expectEqual(@as(u64, 76_800), d.tokenBytes());
+        try expectEqual(@as(u64, 9_830_400), d.pageBytes());
+        try expectEqual(@as(u64, 1280), d.layerToken()); // K 512 + V 512 + IK 256
+        const l = d.layout(1024);
+        try expectEqual(@as(u64, 76_800), l.token_bytes);
+        try expectEqual(@as(u32, 128), l.page_tokens);
+        try expectEqual(@as(u64, 4096), l.fixed_bytes); // the block-table row
+    }
+    // one rank alone caches all four kv heads
+    const c = config.flash;
+    const whole = try pool.Dims.of(&c, try shard.Share.of(&c, 0, 1));
+    try expectEqual(@as(u64, 138_240), whole.tokenBytes());
+}
+
+test "a selection block that is not a page is refused" {
+    var c = config.flash;
+    c.index.block = 64;
+    try std.testing.expectError(error.BlockIsNotPage, pool.Dims.of(&c, try shard.Share.of(&c, 0, 2)));
+}
+
+test "the page map tiles the page: K, V and IK of every layer, head-major, no gap and no overlap" {
+    const d = try dims(0);
+    const m = d.map();
+    const Region = struct { at: u64, len: u64 };
+    var regions: std.ArrayList(Region) = .empty;
+    defer regions.deinit(gpa);
+    const head = @as(u64, pool.page_tokens) * d.head_dim * 2;
+    for (0..d.layers) |layer| {
+        for (0..d.kv_heads) |h| {
+            try regions.append(gpa, .{ .at = m.k(@intCast(layer), @intCast(h)), .len = head });
+            try regions.append(gpa, .{ .at = m.v(@intCast(layer), @intCast(h)), .len = head });
+        }
+        try regions.append(gpa, .{ .at = m.ik(@intCast(layer)), .len = @as(u64, pool.page_tokens) * d.index_dim * 2 });
+    }
+    try expectEqual(@as(usize, 60 * 5), regions.items.len);
+    std.mem.sort(Region, regions.items, {}, struct {
+        fn less(_: void, a: Region, b: Region) bool {
+            return a.at < b.at;
+        }
+    }.less);
+    var end: u64 = 0;
+    for (regions.items) |r| {
+        try expectEqual(end, r.at);
+        end = r.at + r.len;
+    }
+    try expectEqual(d.pageBytes(), end);
+    // one block's keys of a head are contiguous: row t of head h starts t rows after its first
+    try expectEqual(m.k(7, 1) - m.k(7, 0), head);
+    try expectEqual(m.page(3), 3 * d.pageBytes());
+    const at = pool.locate(129);
+    try expectEqual(@as(usize, 1), at.block);
+    try expectEqual(@as(u32, 1), at.row);
+}
+
+test "block tables: page ids by block, -1 past the stream, a failed upload leaves the row as it was" {
+    var t = try pool.Tables.init(gpa, 2, 8);
+    defer t.deinit();
+    for (t.rows) |e| try expectEqual(@as(i32, -1), e);
+    try t.write(1, &.{ 9, 4, 17 }, 0);
+    try t.write(1, &.{5}, 3);
+    try expectEqual(@as(?u32, 9), t.page(1, 0));
+    try expectEqual(@as(?u32, 5), t.page(1, 3));
+    try expectEqual(@as(?u32, null), t.page(1, 4));
+    try expectEqual(@as(?u32, null), t.page(0, 0));
+    try expectEqual(@as(?u32, null), t.page(1, 8)); // past the row
+    try std.testing.expectError(error.TableFull, t.write(1, &.{ 1, 2, 3, 4, 5 }, 4));
+    try std.testing.expectError(error.BadSlot, t.write(2, &.{1}, 0));
+    const Fail = struct {
+        fn call(_: *anyopaque, _: u32, _: usize, _: []const i32) anyerror!void {
+            return error.UploadFailed;
+        }
+    };
+    var dummy: u8 = 0;
+    t.upload = .{ .ctx = &dummy, .call = Fail.call };
+    try std.testing.expectError(error.UploadFailed, t.write(1, &.{ 70, 71 }, 1));
+    try expectEqual(@as(?u32, 4), t.page(1, 1));
+    try expectEqual(@as(?u32, 17), t.page(1, 2));
+    t.clear(1);
+    try expectEqual(@as(?u32, null), t.page(1, 0));
+}
+
+test "the kernel's selection lists index the table: block b of a stream is page row[b]" {
+    var p = try kv.Pool.init(gpa, 16, 9_830_400);
+    defer p.deinit();
+    var t = try pool.Tables.init(gpa, 1, 16);
+    defer t.deinit();
+    var s = t.sink(0);
+    var l: kv.Lease = .{};
+    try p.promise(&l, 5);
+    try p.cover(&l, 3, s.table());
+    try p.cover(&l, 5, s.table()); // the second call writes entries 3 and 4 only
+    for (l.ids.items, 0..) |id, b| try expectEqual(@as(?u32, id), t.page(0, b));
+    try expectEqual(@as(?u32, null), t.page(0, 5));
+    p.finish(&l);
+    try expect(p.idle());
+}
+
+// ---- the budget ----------------------------------------------------------------------------------------------------
+
+fn input(avail_gib: f64, terms: budget.Terms) budget.Input {
+    return .{ .available = @intFromFloat(avail_gib * @as(f64, @floatFromInt(GiB))), .weights = weights_rank0, .terms = terms };
+}
+
+test "119 GiB, TensorFold's reserve: the largest context and pool" {
+    const d = try dims(0);
+    const total: u64 = 119 * GiB;
+    const terms = try budget.tensorfold(total, null);
+    try expectEqual(@as(u64, 119 * GiB / 10), terms.reserve);
+    const in = input(119, terms);
+    const v = budget.check(d, in, null);
+    const cap = v.ok;
+    // 119 - 11.9 - 91.0855 - 4.5 - 1.5 - score chunk (8192 x 2 x 1k blocks x 4 B = 64 MiB) leaves about 9.9 GiB
+    try expect(cap.context > 128 * 1024 and cap.context < 140_000);
+    try expectEqual(@as(u64, 0), (cap.context + in.window) % 128);
+    try expect(cap.pool_tokens >= cap.context + in.window);
+    try expect(cap.pool_bytes <= cap.room);
+    try expect(cap.room - cap.pool_bytes < 2 * d.pageBytes() + 4096); // nothing left on the table but a page
+    // the largest is the largest: one more row needs one more page, which the budget lacks
+    try expect(budget.check(d, in, cap.context).ok.context == cap.context);
+    const over = budget.check(d, in, cap.context + 1);
+    try expectEqual(budget.Reason.does_not_fit, over.refused.reason);
+    try expectEqual(cap.context, over.refused.largest);
+    try expectEqual(cap.pool_tokens, over.refused.largest_pool_tokens);
+    // the whole budget adds up
+    const spent = in.weights + terms.reserve + terms.runtime + cap.workspace + cap.pool_bytes;
+    try expect(spent <= in.available);
+    std.debug.print("\n[119 GiB tensorfold] context {d} pool {d} tokens {d:.3} GiB room {d:.3} GiB workspace {d:.3} GiB\n", .{ cap.context, cap.pool_tokens, @as(f64, @floatFromInt(cap.pool_bytes)) / GiB, @as(f64, @floatFromInt(cap.room)) / GiB, @as(f64, @floatFromInt(cap.workspace)) / GiB });
+}
+
+test "119 GiB under the DeepSeek sibling's floor conventions" {
+    const d = try dims(0);
+    const in = input(119, budget.dsv41());
+    const cap = budget.check(d, in, null).ok;
+    // 119 - 4 floor - 1 runtime - 4 workspace - 0.25 - 0.125 - 91.0855 leaves 18.5 GiB
+    try expect(cap.context > 240_000 and cap.context < 270_000);
+    std.debug.print("[119 GiB dsv41] context {d} pool {d} tokens {d:.3} GiB\n", .{ cap.context, cap.pool_tokens, @as(f64, @floatFromInt(cap.pool_bytes)) / GiB });
+}
+
+test "rank 1 has the same KV and 590 KiB less weights" {
+    const terms = try budget.tensorfold(119 * GiB, null);
+    var in = input(119, terms);
+    const a = budget.check(try dims(0), in, null).ok;
+    in.weights = weights_rank1;
+    const b = budget.check(try dims(1), in, null).ok;
+    try expect(b.pool_tokens >= a.pool_tokens);
+    try expect(b.pool_tokens - a.pool_tokens <= 2 * 128);
+}
+
+test "other budgets: the sizes the plan names, 64 and 128 GiB hosts" {
+    const d = try dims(0);
+    for ([_]f64{ 105, 110, 119, 124 }) |avail| {
+        const terms = try budget.tensorfold(@intFromFloat(avail * @as(f64, @floatFromInt(GiB))), null);
+        const v = budget.check(d, input(avail, terms), null);
+        switch (v) {
+            .ok => |c| std.debug.print("[{d} GiB tensorfold] context {d}\n", .{ avail, c.context }),
+            .refused => |r| std.debug.print("[{d} GiB tensorfold] refused {s}\n", .{ avail, @tagName(r.reason) }),
+        }
+    }
+}
+
+test "a declared 1,048,576 context cannot fit: the refusal names the largest that does" {
+    const d = try dims(0);
+    const in = input(119, try budget.tensorfold(119 * GiB, null));
+    const best = budget.check(d, in, null).ok;
+    const r = budget.check(d, in, 1 << 20).refused;
+    try expectEqual(budget.Reason.does_not_fit, r.reason);
+    try expectEqual(best.context, r.largest);
+    // 1 M rows are 75 GiB of KV (plan section 5): the text says so and what to set
+    try expect(r.need_bytes > 74 * GiB and r.need_bytes < 77 * GiB);
+    const text = try budget.refusalText(gpa, r);
+    defer gpa.free(text);
+    var want: [96]u8 = undefined;
+    try expect(std.mem.indexOf(u8, text, "CONTEXT=1048576") != null);
+    try expect(std.mem.indexOf(u8, text, try std.fmt.bufPrint(&want, "largest context that fits is {d} tokens", .{best.context})) != null);
+    try expect(std.mem.indexOf(u8, text, "76800 bytes a token") != null);
+    try expect(std.mem.indexOf(u8, text, "set CONTEXT to at most") != null);
+    // 65,536 and 131,072 are the contexts the plan advertises: the first fits, the second fits at 119 GiB
+    try expect(budget.check(d, in, 65_536) == .ok);
+    try expect(budget.check(d, in, 131_072) == .ok);
+}
+
+test "refusals: past the model, no room beside the weights, too many streams" {
+    const d = try dims(0);
+    const in = input(119, try budget.tensorfold(119 * GiB, null));
+    const beyond = budget.check(d, in, 2_000_000).refused;
+    try expectEqual(budget.Reason.beyond_model, beyond.reason);
+    {
+        const text = try budget.refusalText(gpa, beyond);
+        defer gpa.free(text);
+        try expect(std.mem.indexOf(u8, text, "past the model's 1048576 positions") != null);
+    }
+    var small = input(95, try budget.tensorfold(95 * GiB, null)); // weights 91.1 + reserve 9.5 > 95
+    const none = budget.check(d, small, null).refused;
+    try expectEqual(budget.Reason.no_room, none.reason);
+    try expectEqual(@as(u64, 0), none.largest);
+    {
+        const text = try budget.refusalText(gpa, budget.check(d, small, 4096).refused);
+        defer gpa.free(text);
+        try expect(std.mem.indexOf(u8, text, "leaves no KV room") != null);
+    }
+    small = input(119, try budget.tensorfold(119 * GiB, null));
+    small.lanes = 5000;
+    small.lanes_fixed = true;
+    try expectEqual(budget.Reason.too_many_lanes, budget.check(d, small, 8192).refused.reason);
+    // unfixed lanes serve fewer: the plan's pool still holds a page for each granted stream
+    small.lanes = 4;
+    small.lanes_fixed = false;
+    const cap = budget.check(d, small, null).ok;
+    try expect(cap.lanes >= 1 and cap.lanes <= 4);
+    try expect(cap.pages >= (cap.context + small.window) / 128 + cap.lanes - 1);
+}
+
+test "the reserve variable: a tenth and a 4 GiB floor, 2 GiB or more, never past the memory" {
+    try expectEqual(@as(u64, 12 * GiB), try budget.reserveBytes("", 120 * GiB));
+    try expectEqual(@as(u64, 4 * GiB), try budget.reserveBytes(null, 24 * GiB));
+    try expectEqual(@as(u64, 3 * GiB), try budget.reserveBytes("3", 120 * GiB));
+    try std.testing.expectError(error.BadReserve, budget.reserveBytes("1", 120 * GiB));
+    try std.testing.expectError(error.BadReserve, budget.reserveBytes("200", 120 * GiB));
+    try std.testing.expectError(error.BadReserve, budget.reserveBytes("x", 120 * GiB));
+    // a smaller reserve buys context
+    const d = try dims(0);
+    const big = budget.check(d, input(119, try budget.tensorfold(119 * GiB, "4")), null).ok;
+    const tenth = budget.check(d, input(119, try budget.tensorfold(119 * GiB, null)), null).ok;
+    try expect(big.context > tenth.context);
+}
diff --git a/zig/src/families/minimax_m3/prefill.zig b/zig/src/families/minimax_m3/prefill.zig
new file mode 100644
index 0000000..9fe3b34
--- /dev/null
+++ b/zig/src/families/minimax_m3/prefill.zig
@@ -0,0 +1,70 @@
+//! MiniMax-M3.1-Flash's prompt pass: page chunks, marks, a resume and the first token, over any engine `host`.
+const std = @import("std");
+const iface = @import("iface.zig");
+const pool = @import("pool.zig");
+const plan = @import("forward_plan.zig");
+
+pub const Error = error{ PromptTooLong, BadResume, BadChunk, Cancelled };
+
+pub fn cancelled(c: ?iface.Cancel) bool {
+    const k = c orelse return false;
+    return k.check(k.ptr);
+}
+
+/// Where a prompt pass of `len` ids starts: 0, or the page-multiple the adopted pages already hold.
+pub fn begin(len: usize, capacity: usize, from: ?iface.Resume) Error!usize {
+    if (len == 0 or len + iface.window_rows >= capacity) return error.PromptTooLong;
+    const r = from orelse return 0;
+    if (r.at == 0 or r.at >= len or r.at % pool.page_tokens != 0) return error.BadResume;
+    return r.at;
+}
+
+/// The end of the chunk that starts at `start`: a full chunk, the prompt's end, or the next mark inside it.
+pub fn chunkEnd(start: usize, len: usize, marks: ?iface.Marks) usize {
+    var end = @min(len, start + iface.prefill_rows);
+    if (marks) |m| for (m.at) |at| {
+        if (at > start and at < end) end = at;
+    };
+    return end;
+}
+
+/// The chunk boundaries of a pass, for tests and for a follower that wants them ahead.
+pub const Chunks = struct {
+    at: usize,
+    len: usize,
+    marks: ?iface.Marks = null,
+
+    pub fn next(c: *Chunks) ?struct { start: usize, end: usize } {
+        if (c.at >= c.len) return null;
+        const end = chunkEnd(c.at, c.len, c.marks);
+        defer c.at = end;
+        return .{ .start = c.at, .end = end };
+    }
+};
+
+/// One chunk of a `len`-id pass: `part` is its rows, plus the next id after a full chunk (GLM's follower sends it).
+pub fn prefillChunk(host: anytype, part: []const u32, start: usize, len: usize, from: ?iface.Resume, cancel: ?iface.Cancel, marks: ?iface.Marks) !?u32 {
+    if ((from != null or start == 0) and try begin(len, host.capacity(), from) != start) return error.BadChunk;
+    if (start >= len or start % pool.page_tokens != 0) return error.BadChunk;
+    const rows = if (start + part.len == len or part.len != iface.prefill_rows + 1) part.len else iface.prefill_rows;
+    if (rows == 0 or rows > iface.prefill_rows or start + rows > len) return error.BadChunk;
+    if (start + rows < len and rows % pool.page_tokens != 0) return error.BadChunk;
+    if (marks) |m| if (start > 0 and std.mem.indexOfScalar(u32, m.at, @intCast(start)) != null) m.call(m.ctx, @intCast(start));
+    try host.gate(cancel);
+    const last = start + rows == len;
+    const ids: []const i32 = @ptrCast(part[0..rows]);
+    try host.chunk(ids, start, if (last) plan.Head.last else plan.Head.none);
+    const first: ?u32 = if (last) try host.first(len) else null;
+    try host.advance(rows);
+    return first;
+}
+
+/// The whole prompt: from the resume point (or 0) to the end; returns the first token.
+pub fn prefill(host: anytype, ids: []const u32, from: ?iface.Resume, cancel: ?iface.Cancel, marks: ?iface.Marks) !u32 {
+    var start = try begin(ids.len, host.capacity(), from);
+    while (true) {
+        const end = chunkEnd(start, ids.len, marks);
+        if (try prefillChunk(host, ids[start..end], start, ids.len, null, cancel, marks)) |first| return first;
+        start = end;
+    }
+}
diff --git a/zig/src/families/minimax_m3/ranks.zig b/zig/src/families/minimax_m3/ranks.zig
new file mode 100644
index 0000000..61b6318
--- /dev/null
+++ b/zig/src/families/minimax_m3/ranks.zig
@@ -0,0 +1,322 @@
+//! Which rank this process is and whether every rank agrees on what it runs (plan T7; the contract is spelled out in the
+//! recipe's docs/rank-contract.md). TensorFold v1.1.2's CUDA build has no --tp/--rank/--master flags: a family reads its
+//! own environment, as GLM does (TF_GLM_RANK, TF_GLM_WORLD, NCCL_COMM_ID). This family reads TF_MM3_RANK, TF_MM3_WORLD and
+//! NCCL_COMM_ID. Everything here is host code: the fingerprint is carried by a gather the engine supplies (`agree`).
+const std = @import("std");
+const Sha256 = std.crypto.hash.sha2.Sha256;
+
+pub const rank_var = "TF_MM3_RANK";
+pub const world_var = "TF_MM3_WORLD";
+pub const layers_var = "TF_MM3_LAYERS";
+pub const roce_var = "TF_ROCE";
+pub const roce_cap_var = "TF_ROCE_MAX_KB";
+/// NCCL's own rendezvous variable: rank 0's IPv4 address and port, the same text on every rank.
+pub const comm_id_var = "NCCL_COMM_ID";
+
+/// The most ranks the family cuts for: it has 4 kv heads, and a rank without one is refused by `shard.Share.of`.
+pub const max_world = 4;
+
+pub const Error = error{
+    NoRank, // TF_MM3_RANK or TF_MM3_WORLD missing, not a number, or the rank is not inside the world
+    TooManyRanks,
+    NoCommId, // a world of 2 or more without NCCL_COMM_ID
+    BadCommId, // not IPv4:port, or a port whose successor (the liveness line's) is not a port
+    BadSetting,
+};
+
+/// An environment lookup: `environment` for the process, a fake in tests.
+pub const Get = *const fn ([:0]const u8) ?[]const u8;
+
+pub fn environment(name: [:0]const u8) ?[]const u8 {
+    return std.mem.span(std.c.getenv(name) orelse return null);
+}
+
+pub const Place = struct { rank: usize, world: usize };
+
+/// TF_MM3_RANK of TF_MM3_WORLD; both are required (a lone GPU says TF_MM3_WORLD=1 TF_MM3_RANK=0).
+pub fn place(get: Get) Error!Place {
+    const r = get(rank_var) orelse return error.NoRank;
+    const w = get(world_var) orelse return error.NoRank;
+    const p: Place = .{
+        .rank = std.fmt.parseInt(usize, r, 10) catch return error.NoRank,
+        .world = std.fmt.parseInt(usize, w, 10) catch return error.NoRank,
+    };
+    if (p.world < 1 or p.rank >= p.world) return error.NoRank;
+    if (p.world > max_world) return error.TooManyRanks;
+    return p;
+}
+
+/// Rank 0's address and port as NCCL_COMM_ID names them. The ranks' liveness lines (cuda/tp_watch.zig) listen on the port
+/// after it, so the largest usable port is 65534.
+pub const Rendezvous = struct { ip: [4]u8, port: u16 };
+
+pub fn rendezvous(text: []const u8) Error!Rendezvous {
+    const colon = std.mem.lastIndexOfScalar(u8, text, ':') orelse return error.BadCommId;
+    const port = std.fmt.parseInt(u16, text[colon + 1 ..], 10) catch return error.BadCommId;
+    if (port == 0 or port == 65535) return error.BadCommId;
+    var ip: [4]u8 = undefined;
+    var it = std.mem.splitScalar(u8, text[0..colon], '.');
+    for (&ip) |*b| b.* = std.fmt.parseInt(u8, it.next() orelse return error.BadCommId, 10) catch return error.BadCommId;
+    if (it.next() != null) return error.BadCommId;
+    return .{ .ip = ip, .port = port };
+}
+
+/// What `open` checks before it touches CUDA: the place, and for 2 ranks or more a usable NCCL_COMM_ID.
+pub fn admit(get: Get) Error!Place {
+    const p = try place(get);
+    if (p.world > 1) _ = try rendezvous(get(comm_id_var) orelse return error.NoCommId);
+    return p;
+}
+
+/// The refusal text for `err`, naming the variables to set (the server prints it; mirrors glm/cuda_native.zig).
+pub fn refusal(err: Error) []const u8 {
+    return switch (err) {
+        error.NoRank => "MiniMax-M3.1-Flash runs at TP over hosts: set TF_MM3_RANK and TF_MM3_WORLD on every host (WORLD 1: one GPU, with TF_MM3_LAYERS for a thin model)",
+        error.TooManyRanks => "MiniMax-M3.1-Flash has 4 kv heads and runs on at most 4 ranks: set TF_MM3_WORLD to 4 or fewer (the recipe uses 2)",
+        error.NoCommId => "MiniMax-M3.1-Flash's ranks meet over NCCL: with TF_MM3_WORLD 2 or more, set NCCL_COMM_ID to rank 0's address:port on every host",
+        error.BadCommId => "NCCL_COMM_ID is rank 0's IPv4 address and a port from 1 to 65534, as 192.0.2.1:29741 (the liveness line takes the next port)",
+        error.BadSetting => "a TF_MM3_* setting is not one of its choices",
+    };
+}
+
+/// Forward knobs read from the environment. Only the thin-model switch exists in v1; anything that changes the
+/// arithmetic must be here and in the fingerprint so both ranks are made to agree.
+pub const Settings = struct {
+    layers: u32 = 0, // TF_MM3_LAYERS: the first this many layers only, for one-GPU checks (0: all)
+    roce_kb: u32 = 4096, // TF_ROCE_MAX_KB, the small-gather RoCE path's cap in KiB; 0 when TF_ROCE=0 keeps every gather on NCCL
+    kv8: bool = false, // --kv-cache fp8 (native.Options.kv8): K and V pages as e4m3 rows with fp32 scales; set by `open`, not read here
+
+    pub fn read(get: Get, problem: *[]const u8) Error!Settings {
+        var s: Settings = .{};
+        if (get(layers_var)) |v| {
+            s.layers = std.fmt.parseInt(u32, v, 10) catch 0;
+            if (s.layers == 0) {
+                problem.* = "TF_MM3_LAYERS: the first how many layers, 1 or more";
+                return error.BadSetting;
+            }
+        }
+        if (get(roce_cap_var)) |v| {
+            s.roce_kb = std.fmt.parseInt(u32, v, 10) catch 0;
+            if (s.roce_kb == 0 or s.roce_kb > std.math.maxInt(u32) / 1024) {
+                problem.* = "TF_ROCE_MAX_KB: an integer from 1 through 4194303 KiB, or unset for 4096 KiB";
+                return error.BadSetting;
+            }
+        }
+        if (get(roce_var)) |v| if (std.mem.eql(u8, v, "0")) {
+            s.roce_kb = 0;
+        };
+        return s;
+    }
+};
+
+/// What every rank must agree on, as bytes the communicator carries.
+pub const Fingerprint = extern struct {
+    layout: u32 = 1, // this struct's version
+    world: u32,
+    rank: u32,
+    layers: u32, // TF_MM3_LAYERS (0: all)
+    reduce: u32 = 1, // tp.zig's reduction_version: the fp32 rank-order sum
+    roce: u32, // Settings.roce_kb: the ranks open the RoCE small-gather path together or not at all
+    kv8: u32 = 0, // Settings.kv8: the ranks' pages are one layout or the other, never mixed
+    reserved: u32 = 0, // keeps `capacity` 8-aligned without padding
+    capacity: u64, // tokens a sequence holds
+    config: [32]u8, // sha256 of config.json
+    quant: [32]u8, // sha256 of quantization_config.json: codebook, version, every matrix's bits
+    program: [32]u8, // sha256 of this executable
+    weights: [32]u8, // digest of the checkpoint's metadata and shard bytes (the engine's checkpoint digest)
+    draft: [32]u8 = @splat(0), // the dspark draft: sha256 of its config.json and its shard metadata; zeros without one
+
+    pub const Field = enum { layout, rank, world, layers, reduce, roce, kv8, capacity, config, quant, program, weights, draft };
+
+    pub fn of(p: Place, s: Settings, capacity: usize, config: [32]u8, quant: [32]u8, program: [32]u8, weights: [32]u8) Fingerprint {
+        return .{
+            .world = @intCast(p.world),
+            .rank = @intCast(p.rank),
+            .layers = s.layers,
+            .roce = s.roce_kb,
+            .kv8 = @intFromBool(s.kv8),
+            .capacity = capacity,
+            .config = config,
+            .quant = quant,
+            .program = program,
+            .weights = weights,
+        };
+    }
+};
+
+pub const Mismatch = struct { field: Fingerprint.Field, rank: usize };
+
+/// The first field where rank r's fingerprint differs from rank 0's (or r holds the wrong rank number), null when all agree.
+pub fn mismatch(all: []const Fingerprint) ?Mismatch {
+    for (all, 0..) |f, r| {
+        if (f.layout != all[0].layout) return .{ .field = .layout, .rank = r };
+        if (f.rank != r) return .{ .field = .rank, .rank = r };
+        if (f.world != all.len) return .{ .field = .world, .rank = r };
+        inline for (.{ "world", "layers", "reduce", "roce", "kv8", "capacity", "config", "quant", "program", "weights", "draft" }) |name| {
+            if (!std.mem.eql(u8, std.mem.asBytes(&@field(f, name)), std.mem.asBytes(&@field(all[0], name))))
+                return .{ .field = @field(Fingerprint.Field, name), .rank = r };
+        }
+    }
+    return null;
+}
+
+pub fn explain(f: Fingerprint.Field) []const u8 {
+    return switch (f) {
+        .layout => "a different build of this check",
+        .rank => "a rank number given twice or out of order",
+        .world => "the ranks were started with different world sizes",
+        .layers => "TF_MM3_LAYERS",
+        .reduce => "a different reduction order",
+        .roce => "TF_ROCE or TF_ROCE_MAX_KB",
+        .kv8 => "--kv-cache (one rank serves fp8 pages, another bf16)",
+        .capacity => "the sequence capacity (the context)",
+        .config => "config.json",
+        .quant => "quantization_config.json (codebook, version or bit widths)",
+        .program => "the executable",
+        .weights => "checkpoint metadata or shard bytes",
+        .draft => "--drafter (the dspark draft's folder, config or shard bytes)",
+    };
+}
+
+pub fn hashBytes(bytes: []const u8) [32]u8 {
+    var out: [32]u8 = undefined;
+    Sha256.hash(bytes, &out, .{});
+    return out;
+}
+
+/// `gather` puts every rank's `mine` in `out` in rank order (an ncclAllGather of bytes, as glm/cuda_ranks.zig does it).
+/// Any disagreement is error.RankMismatch on every rank, printing what differs.
+pub fn agree(ctx: anytype, comptime gather: fn (@TypeOf(ctx), Fingerprint, []Fingerprint) anyerror!void, mine: Fingerprint, out: []Fingerprint) !void {
+    try gather(ctx, mine, out);
+    if (mismatch(out)) |m| {
+        std.debug.print("REFUSE rank settings: rank {d}'s {s} differs from rank 0's ({s})\n", .{ m.rank, @tagName(m.field), explain(m.field) });
+        return error.RankMismatch;
+    }
+}
+
+const Fake = struct {
+    var pairs: []const [2][]const u8 = &.{};
+    fn get(name: [:0]const u8) ?[]const u8 {
+        for (pairs) |p| if (std.mem.eql(u8, p[0], name)) return p[1];
+        return null;
+    }
+};
+
+test "the place: both variables, a rank inside its world, at most four ranks" {
+    Fake.pairs = &.{ .{ rank_var, "1" }, .{ world_var, "2" } };
+    try std.testing.expectEqual(Place{ .rank = 1, .world = 2 }, try place(&Fake.get));
+    Fake.pairs = &.{.{ rank_var, "1" }};
+    try std.testing.expectError(error.NoRank, place(&Fake.get));
+    Fake.pairs = &.{ .{ rank_var, "2" }, .{ world_var, "2" } };
+    try std.testing.expectError(error.NoRank, place(&Fake.get));
+    Fake.pairs = &.{ .{ rank_var, "x" }, .{ world_var, "2" } };
+    try std.testing.expectError(error.NoRank, place(&Fake.get));
+    Fake.pairs = &.{ .{ rank_var, "0" }, .{ world_var, "0" } };
+    try std.testing.expectError(error.NoRank, place(&Fake.get));
+    Fake.pairs = &.{ .{ rank_var, "0" }, .{ world_var, "5" } };
+    try std.testing.expectError(error.TooManyRanks, place(&Fake.get));
+    Fake.pairs = &.{ .{ rank_var, "0" }, .{ world_var, "1" } }; // one GPU needs no rendezvous
+    try std.testing.expectEqual(Place{ .rank = 0, .world = 1 }, try admit(&Fake.get));
+}
+
+test "two ranks need NCCL_COMM_ID as IPv4:port with room for the liveness port after it" {
+    Fake.pairs = &.{ .{ rank_var, "0" }, .{ world_var, "2" } };
+    try std.testing.expectError(error.NoCommId, admit(&Fake.get));
+    Fake.pairs = &.{ .{ rank_var, "0" }, .{ world_var, "2" }, .{ comm_id_var, "192.0.2.1:29741" } };
+    try std.testing.expectEqual(Place{ .rank = 0, .world = 2 }, try admit(&Fake.get));
+    try std.testing.expectEqual(Rendezvous{ .ip = .{ 192, 0, 2, 1 }, .port = 29741 }, try rendezvous("192.0.2.1:29741"));
+    const bad = [_][]const u8{ "192.0.2.1", "host:29741", "192.0.2:29741", "192.0.2.1.5:29741", "192.0.2.1:0", "192.0.2.1:65535", "192.0.2.256:1", "192.0.2.1:x" };
+    for (bad) |text| try std.testing.expectError(error.BadCommId, rendezvous(text));
+    Fake.pairs = &.{ .{ rank_var, "1" }, .{ world_var, "2" }, .{ comm_id_var, "192.0.2.1:65535" } };
+    try std.testing.expectError(error.BadCommId, admit(&Fake.get));
+}
+
+test "settings: TF_MM3_LAYERS is a count of 1 or more" {
+    var problem: []const u8 = "";
+    Fake.pairs = &.{};
+    try std.testing.expectEqual(@as(u32, 0), (try Settings.read(&Fake.get, &problem)).layers);
+    Fake.pairs = &.{.{ layers_var, "4" }};
+    try std.testing.expectEqual(@as(u32, 4), (try Settings.read(&Fake.get, &problem)).layers);
+    for ([_][]const u8{ "0", "abc", "-1" }) |v| {
+        Fake.pairs = &.{.{ layers_var, v }};
+        try std.testing.expectError(error.BadSetting, Settings.read(&Fake.get, &problem));
+    }
+    try std.testing.expectEqualStrings("TF_MM3_LAYERS: the first how many layers, 1 or more", problem);
+}
+
+fn fp(rank: usize) Fingerprint {
+    const h: [32]u8 = @splat(1);
+    return Fingerprint.of(.{ .rank = rank, .world = 2 }, .{}, 131072, hashBytes("config"), hashBytes("quant"), h, hashBytes("weights"));
+}
+
+test "settings: TF_ROCE=0 turns the RoCE path off and TF_ROCE_MAX_KB must be a usable cap, both agreed by the ranks" {
+    var problem: []const u8 = "";
+    Fake.pairs = &.{};
+    try std.testing.expectEqual(@as(u32, 4096), (try Settings.read(&Fake.get, &problem)).roce_kb);
+    Fake.pairs = &.{.{ roce_cap_var, "1024" }};
+    try std.testing.expectEqual(@as(u32, 1024), (try Settings.read(&Fake.get, &problem)).roce_kb);
+    Fake.pairs = &.{ .{ roce_var, "0" }, .{ roce_cap_var, "1024" } };
+    try std.testing.expectEqual(@as(u32, 0), (try Settings.read(&Fake.get, &problem)).roce_kb);
+    Fake.pairs = &.{.{ roce_cap_var, "0" }};
+    try std.testing.expectError(error.BadSetting, Settings.read(&Fake.get, &problem));
+    var all = [_]Fingerprint{ fp(0), Fingerprint.of(.{ .rank = 1, .world = 2 }, .{ .roce_kb = 0 }, 131072, hashBytes("config"), hashBytes("quant"), @splat(1), hashBytes("weights")) };
+    try std.testing.expectEqual(Mismatch{ .field = .roce, .rank = 1 }, mismatch(&all).?);
+}
+
+test "fingerprints: agreeing ranks pass; config, quantization, weights and the rest name the first difference" {
+    var all = [_]Fingerprint{ fp(0), fp(1) };
+    try std.testing.expect(mismatch(&all) == null);
+
+    all[1].config = hashBytes("another config");
+    try std.testing.expectEqual(Mismatch{ .field = .config, .rank = 1 }, mismatch(&all).?);
+    all[1] = fp(1);
+    all[1].quant = hashBytes("quantization with 5-bit shared experts");
+    try std.testing.expectEqual(Mismatch{ .field = .quant, .rank = 1 }, mismatch(&all).?);
+    all[1] = fp(1);
+    all[1].weights = hashBytes("a different shard set");
+    try std.testing.expectEqual(Mismatch{ .field = .weights, .rank = 1 }, mismatch(&all).?);
+    all[1] = fp(1);
+    all[1].program = @splat(2);
+    try std.testing.expectEqual(Mismatch{ .field = .program, .rank = 1 }, mismatch(&all).?);
+    all[1] = fp(1);
+    all[1].capacity = 65536;
+    try std.testing.expectEqual(Mismatch{ .field = .capacity, .rank = 1 }, mismatch(&all).?);
+    all[1] = Fingerprint.of(.{ .rank = 1, .world = 2 }, .{ .layers = 4 }, 131072, hashBytes("config"), hashBytes("quant"), @splat(1), hashBytes("weights"));
+    try std.testing.expectEqual(Mismatch{ .field = .layers, .rank = 1 }, mismatch(&all).?);
+    all[1] = fp(1);
+    all[1].reduce = 2;
+    try std.testing.expectEqual(Mismatch{ .field = .reduce, .rank = 1 }, mismatch(&all).?);
+    all[1] = fp(0); // the same rank number twice
+    try std.testing.expectEqual(Mismatch{ .field = .rank, .rank = 1 }, mismatch(&all).?);
+    all[1] = fp(1);
+    all[1].draft = hashBytes("a draft the other rank does not load");
+    try std.testing.expectEqual(Mismatch{ .field = .draft, .rank = 1 }, mismatch(&all).?);
+    all[1] = fp(1);
+    all[1].world = 3;
+    try std.testing.expectEqual(Mismatch{ .field = .world, .rank = 1 }, mismatch(&all).?);
+    // rank 0 is the reference: a rank 0 that differs makes rank 1 the one named
+    all[0].weights = hashBytes("x");
+    all[1] = fp(1);
+    try std.testing.expectEqual(Mismatch{ .field = .weights, .rank = 1 }, mismatch(&all).?);
+}
+
+const Wire = struct {
+    others: []const Fingerprint,
+    fn gather(w: Wire, mine: Fingerprint, out: []Fingerprint) anyerror!void {
+        for (out, 0..) |*o, r| o.* = if (r == mine.rank) mine else w.others[r];
+    }
+};
+
+test "agree refuses a mismatch on the rank that sees it and passes agreeing ranks" {
+    var out: [2]Fingerprint = undefined;
+    const good = [_]Fingerprint{ fp(0), fp(1) };
+    try agree(Wire{ .others = &good }, Wire.gather, fp(0), &out);
+    var odd = good;
+    odd[1].weights = hashBytes("other");
+    try std.testing.expectError(error.RankMismatch, agree(Wire{ .others = &odd }, Wire.gather, fp(0), &out));
+    try std.testing.expectError(error.RankMismatch, agree(Wire{ .others = &odd }, Wire.gather, odd[1], &out));
+}
+
+test "the fingerprint has no padding bytes to compare by accident" {
+    try std.testing.expectEqual(@as(usize, 4 * 8 + 8 + 160), @sizeOf(Fingerprint));
+}
diff --git a/zig/src/families/minimax_m3/ref.zig b/zig/src/families/minimax_m3/ref.zig
new file mode 100644
index 0000000..a710149
--- /dev/null
+++ b/zig/src/families/minimax_m3/ref.zig
@@ -0,0 +1,241 @@
+//! MiniMax-M3.1-Flash on the CPU in float64: a full layer, a small model and the head (engine-port-plan.md T0).
+const std = @import("std");
+const core = @import("core");
+const mr = core.minimax_ref;
+
+pub const Switches = mr.Switches;
+
+/// The text model's shape; the defaults are the real checkpoint's, tests shrink hidden, experts and the block count.
+pub const Config = struct {
+    hidden: usize = 6144,
+    n_q: usize = 64,
+    n_kv: usize = 4,
+    head_dim: usize = 128,
+    rot_dim: usize = 64,
+    rope_theta: f64 = 1e7,
+    eps: f64 = 1e-6,
+    /// Index heads: one per kv head, all scoring the one shared index key (index head g selects for kv head g).
+    n_index: usize = 4,
+    block: usize = 128,
+    topk_blocks: usize = 16,
+    n_experts: usize = 128,
+    experts_topk: usize = 4,
+    routed_scale: f64 = 2.0,
+    alpha: f64 = 1.702,
+    limit: f64 = 7.0,
+    sw: Switches = .{},
+
+    pub fn rep(c: Config) usize {
+        return c.n_q / c.n_kv;
+    }
+};
+
+/// y = x W for W stored [k][n] row-major, the layout exl3_format.dequantize writes.
+pub const Linear = struct {
+    k: usize,
+    n: usize,
+    w: []const f64,
+
+    pub fn apply(l: Linear, x: []const f64, out: []f64) void {
+        @memset(out[0..l.n], 0);
+        for (x[0..l.k], 0..) |xv, i| {
+            const row = l.w[i * l.n ..][0..l.n];
+            for (out[0..l.n], row) |*o, wv| o.* += xv * wv;
+        }
+    }
+};
+
+/// A gated MLP: w1, w3 are [hidden][inter], w2 [inter][hidden]; dense and shared MLPs: gate_proj is w1, up_proj w3.
+pub const Mlp = struct {
+    w1: Linear,
+    w3: Linear,
+    w2: Linear,
+
+    /// out = w2 swigluoai(gate, up); `routed` applies Switches.w1_is_gate, dense and shared MLPs never swap.
+    pub fn apply(m: Mlp, c: Config, x: []const f64, routed: bool, a: std.mem.Allocator, out: []f64) !void {
+        const n = m.w1.n;
+        const p = try a.alloc(f64, 2 * n);
+        m.w1.apply(x, p[0..n]);
+        m.w3.apply(x, p[n..]);
+        const swap = routed and !c.sw.w1_is_gate;
+        for (0..n) |i| {
+            const g, const u = if (swap) .{ p[n + i], p[i] } else .{ p[i], p[n + i] };
+            p[i] = mr.round16(c.sw.bf16_act_out, mr.swigluoai(g, u, c.alpha, c.limit, c.sw));
+        }
+        m.w2.apply(p[0..n], out);
+    }
+};
+
+pub const Moe = struct {
+    gate: Linear,
+    bias: []const f64,
+    experts: []const Mlp,
+    shared: Mlp,
+};
+
+pub const Ffn = union(enum) { dense: Mlp, moe: Moe };
+
+pub const Layer = struct {
+    input_norm: []const f64,
+    post_norm: []const f64,
+    q: Linear,
+    k: Linear,
+    v: Linear,
+    o: Linear,
+    q_norm: []const f64,
+    k_norm: []const f64,
+    index_q: Linear,
+    index_k: Linear,
+    index_q_norm: []const f64,
+    index_k_norm: []const f64,
+    ffn: Ffn,
+};
+
+pub const Model = struct {
+    cfg: Config,
+    embed: []const f64,
+    layers: []const Layer,
+    final_norm: []const f64,
+    head: Linear,
+};
+
+/// One layer's K, V ([kv head][pos][d]) and index-key (IK [pos][d]) history, `cap` positions.
+pub const LayerCache = struct {
+    k: []f64,
+    v: []f64,
+    ik: []f64,
+    cap: usize,
+};
+
+pub const Cache = struct {
+    layers: []LayerCache,
+
+    pub fn init(a: std.mem.Allocator, c: Config, n_layers: usize, cap: usize) !Cache {
+        const ls = try a.alloc(LayerCache, n_layers);
+        for (ls) |*l| l.* = .{
+            .k = try a.alloc(f64, c.n_kv * cap * c.head_dim),
+            .v = try a.alloc(f64, c.n_kv * cap * c.head_dim),
+            .ik = try a.alloc(f64, cap * c.head_dim),
+            .cap = cap,
+        };
+        return .{ .layers = ls };
+    }
+};
+
+fn norm(c: Config, x: []const f64, w: []const f64, gemma: bool, out: []f64) void {
+    mr.gemmaNorm(x, w, c.eps, gemma, out);
+    mr.roundAll(c.sw.bf16_norm_out, out);
+}
+
+fn heads(c: Config, x: []f64, n: usize, w: []const f64, gemma: bool, pos: ?usize) void {
+    const d = c.head_dim;
+    var t: [512]f64 = undefined;
+    for (0..n) |h| {
+        const s = x[h * d ..][0..d];
+        norm(c, s, w, gemma, t[0..d]);
+        @memcpy(s, t[0..d]);
+        if (pos) |p| mr.rope(s, c.rot_dim, p, c.rope_theta, c.sw.rope_layout);
+        mr.roundAll(c.sw.bf16_rope_out, s);
+    }
+}
+
+/// The attention half of a layer for the token at `pos`: h += o_proj(sparse attention(norm(h))), cache appended.
+pub fn attention(c: Config, ly: Layer, lc: *LayerCache, h: []f64, pos: usize, a: std.mem.Allocator) !void {
+    const d = c.head_dim;
+    const x = try a.alloc(f64, c.hidden);
+    norm(c, h, ly.input_norm, c.sw.gemma_layer_norms, x);
+    const q = try a.alloc(f64, c.n_q * d);
+    const k = try a.alloc(f64, c.n_kv * d);
+    const v = try a.alloc(f64, c.n_kv * d);
+    ly.q.apply(x, q);
+    ly.k.apply(x, k);
+    ly.v.apply(x, v);
+    for ([_][]f64{ q, k, v }) |t| mr.roundAll(c.sw.bf16_proj_out, t);
+    heads(c, q, c.n_q, ly.q_norm, c.sw.gemma_qk_norms, pos);
+    heads(c, k, c.n_kv, ly.k_norm, c.sw.gemma_qk_norms, pos);
+    const iq = try a.alloc(f64, c.n_index * d);
+    const ik = try a.alloc(f64, d);
+    mr.roundFp16(c.sw.fp16_index_input, x);
+    ly.index_q.apply(x, iq);
+    ly.index_k.apply(x, ik);
+    mr.roundAll(c.sw.bf16_proj_out, iq);
+    mr.roundAll(c.sw.bf16_proj_out, ik);
+    heads(c, iq, c.n_index, ly.index_q_norm, c.sw.gemma_index_norms, if (c.sw.index_rope) pos else null);
+    heads(c, ik, 1, ly.index_k_norm, c.sw.gemma_index_norms, if (c.sw.index_rope) pos else null);
+    for (0..c.n_kv) |g| {
+        @memcpy(lc.k[(g * lc.cap + pos) * d ..][0..d], k[g * d ..][0..d]);
+        @memcpy(lc.v[(g * lc.cap + pos) * d ..][0..d], v[g * d ..][0..d]);
+    }
+    @memcpy(lc.ik[pos * d ..][0..d], ik);
+    const bs = try a.alloc(f64, pos / c.block + 1);
+    const ids = try a.alloc(usize, c.topk_blocks);
+    const scratch = try a.alloc(f64, bs.len);
+    const keys = try a.alloc(usize, c.topk_blocks * c.block);
+    const ao = try a.alloc(f64, c.n_q * d);
+    const rep = c.rep();
+    for (0..c.n_kv) |g| {
+        _ = mr.blockScores(iq[g * d ..][0..d], lc.ik, pos, d, std.math.pow(f64, @floatFromInt(d), -0.5), c.block, bs);
+        const n = mr.selectBlocks(bs, pos / c.block, c.topk_blocks, c.sw, scratch, ids);
+        const base = g * lc.cap * d;
+        mr.attendBlocks(q[g * rep * d ..][0 .. rep * d], lc.k[base..][0 .. lc.cap * d], lc.v[base..][0 .. lc.cap * d], ids[0..n], pos, c.block, d, rep, keys, ao[g * rep * d ..][0 .. rep * d]);
+    }
+    mr.roundAll(c.sw.bf16_attn_out, ao);
+    const o = try a.alloc(f64, c.hidden);
+    ly.o.apply(ao, o);
+    for (h, o) |*hv, ov| hv.* = mr.round16(c.sw.bf16_residual, hv.* + ov);
+}
+
+/// The feed-forward half: h += ffn(norm(h)); dense MLP, or routed experts plus the shared expert.
+pub fn feedForward(c: Config, ly: Layer, h: []f64, a: std.mem.Allocator) !void {
+    const m = try a.alloc(f64, c.hidden);
+    norm(c, h, ly.post_norm, c.sw.gemma_layer_norms, m);
+    const f = try a.alloc(f64, c.hidden);
+    switch (ly.ffn) {
+        .dense => |mlp| try mlp.apply(c, m, false, a, f),
+        .moe => |moe| {
+            const logits = try a.alloc(f64, c.n_experts);
+            moe.gate.apply(m, logits);
+            const ids = try a.alloc(usize, c.experts_topk);
+            const w = try a.alloc(f64, c.experts_topk);
+            mr.routerPick(logits, moe.bias, c.routed_scale, c.sw, try a.alloc(f64, c.n_experts), ids, w);
+            @memset(f, 0);
+            const y = try a.alloc(f64, c.hidden);
+            for (ids, w) |e, we| {
+                try moe.experts[e].apply(c, m, true, a, y);
+                for (f, y) |*o, yv| o.* += we * yv;
+            }
+            try moe.shared.apply(c, m, false, a, y);
+            const t = mr.totalScale(c.sw, c.routed_scale);
+            for (f, y) |*o, yv| o.* = (o.* + yv) * t;
+        },
+    }
+    for (h, f) |*hv, fv| hv.* = mr.round16(c.sw.bf16_residual, hv.* + fv);
+}
+
+/// One whole layer for the token at `pos` (h in and out); `a` is scratch the caller may reset afterwards.
+pub fn layerStep(c: Config, ly: Layer, lc: *LayerCache, h: []f64, pos: usize, a: std.mem.Allocator) !void {
+    try attention(c, ly, lc, h, pos, a);
+    try feedForward(c, ly, h, a);
+}
+
+/// The head: logits = (gemma_norm(h, model.norm)) lm_head, as the engine's final fp32 logits.
+pub fn head(m: Model, h: []const f64, a: std.mem.Allocator, logits: []f64) !void {
+    const n = try a.alloc(f64, m.cfg.hidden);
+    norm(m.cfg, h, m.final_norm, m.cfg.sw.gemma_layer_norms, n);
+    m.head.apply(n, logits);
+}
+
+/// The model on one token at `pos` against its cache: embedding, every layer, the head into `logits`.
+pub fn step(m: Model, cache: Cache, token: usize, pos: usize, logits: []f64, gpa: std.mem.Allocator) !void {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const h = try a.dupe(f64, m.embed[token * m.cfg.hidden ..][0..m.cfg.hidden]);
+    for (m.layers, cache.layers) |ly, *lc| try layerStep(m.cfg, ly, lc, h, pos, a);
+    try head(m, h, a, logits);
+}
+
+/// Every token in order; the last token's logits are left in `logits`.
+pub fn run(m: Model, cache: Cache, tokens: []const usize, logits: []f64, gpa: std.mem.Allocator) !void {
+    for (tokens, 0..) |t, pos| try step(m, cache, t, pos, logits, gpa);
+}
diff --git a/zig/src/families/minimax_m3/rows.zig b/zig/src/families/minimax_m3/rows.zig
new file mode 100644
index 0000000..ea5149d
--- /dev/null
+++ b/zig/src/families/minimax_m3/rows.zig
@@ -0,0 +1,54 @@
+//! MiniMax-M3.1-Flash row kernels' wiring: the launch parameters the unverified T0 switches become. Host-testable.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const mr = core.minimax_ref;
+const rows = cuda.minimax_m3_rows;
+
+pub const Switches = mr.Switches;
+
+/// What the loader left in a norm tensor: raw Gemma `w` or the folded fp32 `1 + w` (Streamer.fold does the latter).
+pub const Stored = enum { raw, folded };
+
+pub const Rope = struct { rot: u32 = 64, theta: f64 = 1e7, eps: f32 = 1e-6 };
+
+pub const Error = error{FoldedPlain};
+
+fn add(gemma: bool, stored: Stored) Error!f32 {
+    if (gemma) return if (stored == .raw) 1 else 0;
+    return if (stored == .raw) 0 else error.FoldedPlain;
+}
+
+/// The kernel's arguments for a set of switches. Folded weights cannot give a plain (non-Gemma) norm back.
+pub fn opts(sw: Switches, r: Rope, qk: Stored, index: Stored, index_fp16: bool) Error!rows.Opts {
+    return .{
+        .rot = r.rot,
+        .theta = r.theta,
+        .eps = r.eps,
+        .w_add = try add(sw.gemma_qk_norms, qk),
+        .w_add_index = try add(sw.gemma_index_norms, index),
+        .flags = .{
+            .norm_qk = true,
+            .norm_index = true,
+            .index_rope = sw.index_rope,
+            .index_fp16 = index_fp16,
+            .round_norm = sw.bf16_norm_out,
+            .gptj = sw.rope_layout == .gptj_interleaved,
+        },
+    };
+}
+
+/// The router: 128 experts over the 6144 hidden values, fp32 weights, x bf16 (the fp32 form takes the cast hidden).
+pub const router: rows.Router = .{ .experts = 128, .k = 6144 };
+
+test "switches become flags and weight offsets" {
+    const o = try opts(.{}, .{}, .folded, .folded, true);
+    try std.testing.expectEqual(@as(f32, 0), o.w_add);
+    try std.testing.expectEqual(@as(i32, 1 | 2 | 4 | 8), o.flags.bits());
+    const raw = try opts(.{ .rope_layout = .gptj_interleaved, .index_rope = false, .bf16_norm_out = true }, .{}, .raw, .raw, false);
+    try std.testing.expectEqual(@as(f32, 1), raw.w_add_index);
+    try std.testing.expectEqual(@as(i32, 1 | 2 | 16 | 32), raw.flags.bits());
+    try std.testing.expectError(error.FoldedPlain, opts(.{ .gemma_qk_norms = false }, .{}, .folded, .folded, true));
+    const plain = try opts(.{ .gemma_index_norms = false }, .{}, .folded, .raw, true);
+    try std.testing.expectEqual(@as(f32, 0), plain.w_add_index);
+}
diff --git a/zig/src/families/minimax_m3/shard.zig b/zig/src/families/minimax_m3/shard.zig
new file mode 100644
index 0000000..ba8c9b2
--- /dev/null
+++ b/zig/src/families/minimax_m3/shard.zig
@@ -0,0 +1,199 @@
+//! A TP rank's share of MiniMax-M3.1-Flash (plan section 5): whole kv groups, EXL3 and vocabulary cuts in 128s.
+const std = @import("std");
+const canon = @import("canon");
+const layout = @import("core").exl3_layout;
+const Config = @import("config.zig").Config;
+const names = @import("names.zig");
+
+/// Elements of an EXL3 width or of the vocabulary a rank takes whole: the Hadamard block.
+pub const unit = 128;
+
+pub const Span = struct {
+    lo: usize,
+    hi: usize,
+
+    pub fn len(s: Span) usize {
+        return s.hi - s.lo;
+    }
+};
+
+pub const Share = struct {
+    rank: usize,
+    world: usize,
+    kv_heads: Span, // kv heads; index head g selects for kv head g, so the index heads are the same span
+    q_heads: Span, // the query heads of those kv groups
+    index_heads: Span,
+    dense: Span, // dense MLP intermediate rows (layers before the first MoE layer)
+    moe: Span, // each routed expert's intermediate rows
+    shared: Span, // the shared expert's intermediate rows
+    vocab: Span, // the head's rows, in whole 128-row units
+
+    /// Rank `rank` of `world`; refused where any rank would be left without a head, a unit or a row.
+    pub fn of(c: *const Config, rank: usize, world: usize) !Share {
+        if (world == 0 or rank >= world) return error.BadRank;
+        const kv = try span(c.kv_heads, 1, rank, world);
+        return .{
+            .rank = rank,
+            .world = world,
+            .kv_heads = kv,
+            .q_heads = .{ .lo = kv.lo * c.group(), .hi = kv.hi * c.group() },
+            .index_heads = kv,
+            .dense = try span(c.dense_inter, unit, rank, world),
+            .moe = try span(c.moe_inter, unit, rank, world),
+            .shared = try span(c.shared_inter, unit, rank, world),
+            .vocab = try span(c.vocab, unit, rank, world),
+        };
+    }
+
+    /// The rank's slice of matrix `p` along its cut axis, in elements of that axis.
+    pub fn cut(s: Share, c: *const Config, p: names.Proj) Span {
+        return switch (p) {
+            .q, .o => scale(s.q_heads, c.head_dim),
+            .k, .v => scale(s.kv_heads, c.head_dim),
+            .dense_gate, .dense_up, .dense_down => s.dense,
+            .shared_gate, .shared_up, .shared_down => s.shared,
+            .w1, .w3, .w2 => s.moe,
+            .head => s.vocab,
+        };
+    }
+
+    /// The rows of the fp16 index query projection this rank scores with; the key projection is replicated.
+    pub fn indexRows(s: Share, c: *const Config) Span {
+        return scale(s.index_heads, c.index.dim);
+    }
+
+    /// The rank's slice of an EXL3 group: whole tiles, with `suh` or `svh` cut to match.
+    pub fn part(s: Share, c: *const Config, p: names.Proj, g: layout.Group) !layout.Part {
+        return cutGroup(g, p.cut(), s.cut(c, p));
+    }
+};
+
+fn scale(s: Span, by: usize) Span {
+    return .{ .lo = s.lo * by, .hi = s.hi * by };
+}
+
+/// Rank `rank`'s [lo, hi) of `total` elements in whole `per`s: largest-remainder shares, ties to the lower rank.
+fn span(total: usize, per: usize, rank: usize, world: usize) !Span {
+    if (total % per != 0 or world > 256) return error.BadSplit;
+    const ones: [256]u64 = @splat(1);
+    var out: [256]canon.Range = undefined;
+    canon.partition(@intCast(total / per), ones[0..world], out[0..world]);
+    const r = out[rank];
+    if (r.len() == 0) return error.EmptyShare;
+    return .{ .lo = r.begin * per, .hi = r.end * per };
+}
+
+/// `g`'s tiles [lo, hi) along `axis` (128-aligned elements): the trellis runs and the scale bytes to read.
+pub fn cutGroup(g: layout.Group, axis: names.Cut, s: Span) !layout.Part {
+    const whole = if (axis == .col) g.n() else g.k();
+    if (s.lo >= s.hi or s.hi > whole or s.lo % unit != 0 or s.hi % unit != 0) return error.SplitNotOnBlocks;
+    const lo: u64 = s.lo / 16;
+    const per: u64 = s.len() / 16;
+    var p: layout.Part = .{
+        .group = g,
+        .trellis = .{ .offset = 0, .len = g.trellisBytes() },
+        .suh = .{ .offset = 0, .len = 2 * @as(u64, g.k()) },
+        .svh = .{ .offset = 0, .len = 2 * @as(u64, g.n()) },
+    };
+    switch (axis) {
+        .row => { // K tiles lo..hi are whole rows of N tiles: one run
+            const row = @as(u64, g.n_tiles) * g.tileBytes();
+            p.group.k_tiles = @intCast(per);
+            p.trellis = .{ .offset = lo * row, .len = per * row };
+            p.suh = .{ .offset = 2 * 16 * lo, .len = 2 * 16 * per };
+        },
+        .col => { // this rank's N tiles are a run inside each of the K tile rows
+            p.group.n_tiles = @intCast(per);
+            p.trellis = .{ .offset = lo * g.tileBytes(), .len = per * g.tileBytes(), .stride = @as(u64, g.n_tiles) * g.tileBytes(), .count = g.k_tiles };
+            p.svh = .{ .offset = 2 * 16 * lo, .len = 2 * 16 * per };
+        },
+    }
+    return p;
+}
+
+test "TP2 splits the heads, widths and vocabulary as plan section 5 says" {
+    const c = &@import("config.zig").flash;
+    const r0 = try Share.of(c, 0, 2);
+    const r1 = try Share.of(c, 1, 2);
+    try std.testing.expectEqual(Span{ .lo = 0, .hi = 2 }, r0.kv_heads);
+    try std.testing.expectEqual(Span{ .lo = 2, .hi = 4 }, r1.kv_heads);
+    try std.testing.expectEqual(Span{ .lo = 0, .hi = 32 }, r0.q_heads);
+    try std.testing.expectEqual(Span{ .lo = 32, .hi = 64 }, r1.q_heads);
+    try std.testing.expectEqual(r1.kv_heads, r1.index_heads);
+    try std.testing.expectEqual(Span{ .lo = 256, .hi = 512 }, r1.indexRows(c));
+    try std.testing.expectEqual(Span{ .lo = 6144, .hi = 12288 }, r1.dense);
+    try std.testing.expectEqual(Span{ .lo = 1536, .hi = 3072 }, r1.moe);
+    try std.testing.expectEqual(Span{ .lo = 0, .hi = 1536 }, r0.shared);
+    // 1563 units of 128 rows: rank 0 takes the odd one
+    try std.testing.expectEqual(@as(usize, 782 * 128), r0.vocab.len());
+    try std.testing.expectEqual(@as(usize, 781 * 128), r1.vocab.len());
+    try std.testing.expectEqual(r0.vocab.hi, r1.vocab.lo);
+    try std.testing.expectEqual(c.vocab, r1.vocab.hi);
+    // q_proj and o_proj: 4096 of 8192 each; k and v: 256 of 512
+    try std.testing.expectEqual(Span{ .lo = 4096, .hi = 8192 }, r1.cut(c, .q));
+    try std.testing.expectEqual(Span{ .lo = 0, .hi = 4096 }, r0.cut(c, .o));
+    try std.testing.expectEqual(Span{ .lo = 256, .hi = 512 }, r1.cut(c, .v));
+}
+
+test "ranks that would be empty and ranks out of range are refused" {
+    const c = &@import("config.zig").flash;
+    try std.testing.expectError(error.BadRank, Share.of(c, 2, 2));
+    try std.testing.expectError(error.BadRank, Share.of(c, 0, 0));
+    // 4 kv heads: a fifth rank has none
+    try std.testing.expectError(error.EmptyShare, Share.of(c, 4, 5));
+    try std.testing.expectError(error.EmptyShare, Share.of(c, 4, 8));
+    try std.testing.expectError(error.BadSplit, Share.of(c, 0, 257));
+    // three ranks: uneven but whole groups, 2/1/1 kv heads
+    const t0 = try Share.of(c, 0, 3);
+    const t2 = try Share.of(c, 2, 3);
+    try std.testing.expectEqual(@as(usize, 32), t0.q_heads.len());
+    try std.testing.expectEqual(@as(usize, 16), t2.q_heads.len());
+    // a model whose MoE width has fewer 128-units than ranks
+    var small = c.*;
+    small.moe_inter = 128;
+    try std.testing.expectError(error.EmptyShare, Share.of(&small, 1, 2));
+    small.moe_inter = 100;
+    try std.testing.expectError(error.BadSplit, Share.of(&small, 0, 2));
+}
+
+test "group cuts agree with core's even cuts and keep the scales aligned" {
+    const c = &@import("config.zig").flash;
+    const q = try layout.Group.fromShape(&.{ 384, 512, 96 }); // q_proj: K 6144, N 8192, 6 bits
+    const o = try layout.Group.fromShape(&.{ 512, 384, 96 }); // o_proj: K 8192, N 6144
+    for ([_]usize{ 0, 1 }) |r| {
+        const s = try Share.of(c, r, 2);
+        const mine = try s.part(c, .q, q);
+        const theirs = try q.part(.col, @intCast(r), 2);
+        try std.testing.expectEqualDeep(theirs, mine);
+        try std.testing.expectEqualDeep(try o.part(.row, @intCast(r), 2), try s.part(c, .o, o));
+    }
+    const r1 = try (try Share.of(c, 1, 2)).part(c, .o, o);
+    try std.testing.expectEqual(@as(u64, 4096 * 2), r1.suh.len);
+    try std.testing.expectEqual(@as(u64, 4096 * 2), r1.suh.offset);
+    try std.testing.expectEqual(@as(u64, 6144 * 2), r1.svh.len); // the row cut keeps svh whole
+    try std.testing.expectEqual(@as(u32, 256), r1.group.k_tiles);
+}
+
+test "the head's odd unit count cuts at 128s that core's even split refuses" {
+    const c = &@import("config.zig").flash;
+    const head = try layout.Group.fromShape(&.{ 384, 12504, 96 });
+    try std.testing.expectError(error.SplitNotOnBlocks, head.part(.col, 0, 2)); // 1563 units are not even
+    const p0 = try (try Share.of(c, 0, 2)).part(c, .head, head);
+    const p1 = try (try Share.of(c, 1, 2)).part(c, .head, head);
+    try std.testing.expectEqual(@as(u32, 782 * 8), p0.group.n_tiles);
+    try std.testing.expectEqual(@as(u32, 781 * 8), p1.group.n_tiles);
+    try std.testing.expectEqual(p0.group.n_tiles * 16 * 2, p0.svh.len);
+    try std.testing.expectEqual(p0.svh.len, p1.svh.offset);
+    try std.testing.expectEqual(@as(u64, 384), p1.trellis.count);
+    // together the two runs cover each whole row of N tiles, back to back
+    try std.testing.expectEqual(head.tileBytes() * 12504, p0.trellis.len + p1.trellis.len);
+    try std.testing.expectEqual(p0.trellis.len, p1.trellis.offset);
+}
+
+test "cuts off the 128 grid or out of range are refused" {
+    const g = try layout.Group.fromShape(&.{ 16, 16, 64 }); // 256 x 256
+    try std.testing.expectError(error.SplitNotOnBlocks, cutGroup(g, .col, .{ .lo = 0, .hi = 100 }));
+    try std.testing.expectError(error.SplitNotOnBlocks, cutGroup(g, .row, .{ .lo = 128, .hi = 384 }));
+    try std.testing.expectError(error.SplitNotOnBlocks, cutGroup(g, .row, .{ .lo = 128, .hi = 128 }));
+    _ = try cutGroup(g, .col, .{ .lo = 128, .hi = 256 });
+}
diff --git a/zig/src/families/minimax_m3/state.zig b/zig/src/families/minimax_m3/state.zig
new file mode 100644
index 0000000..ecbe423
--- /dev/null
+++ b/zig/src/families/minimax_m3/state.zig
@@ -0,0 +1,169 @@
+//! MiniMax-M3.1-Flash's stream state and prompt cache on the page pool. Every layer is attention: a stream is its
+//! position and its pages, so a kept prompt snapshot is page references in the radix store plus a record of the
+//! position. Restoring one copies nothing; the resumed stream adopts the store's pages.
+const std = @import("std");
+const api = @import("engine_api");
+const kv = @import("core").kv_pool;
+const pool = @import("pool.zig");
+const radix = api.prompt_radix;
+
+pub const Error = error{ ContextTooLong, LaneMemory };
+
+/// Prompt-cache rules: one page is one block, so marks and resumes sit on 128 rows; a row's bits do not depend on
+/// its chunk (kernels are row-invariant), so the store is not `planned`.
+pub const rules: radix.Rules = .{ .page = pool.page_tokens, .min_gap = 1024, .min_prompt = 2048, .tail = true };
+
+/// A live stream: the lease (its page ids in token order, the block table's entries), its slot and rows filled.
+pub const Stream = struct {
+    lease: kv.Lease = .{},
+    slot: u32 = 0,
+    /// Rows whose K, V and IK are in the pages: the next row written is `pos`.
+    pos: u32 = 0,
+};
+
+/// What a kept snapshot is: the position, and with a dspark draft the id of its saved K/V ring.
+const Saved = struct { at: u32, ring: ?u32 = null };
+
+/// The dspark draft's ring snapshots: `save` may refuse (null: that snapshot keeps no ring).
+pub const RingHook = struct {
+    ctx: *anyopaque,
+    save: *const fn (ctx: *anyopaque, slot: u32, at: u32) ?u32,
+    restore: *const fn (ctx: *anyopaque, slot: u32, id: u32) void,
+    drop: *const fn (ctx: *anyopaque, id: u32) void,
+};
+
+/// The prompt cache over a pool: a radix store of page references and the snapshots' records.
+pub const Cache = struct {
+    gpa: std.mem.Allocator,
+    pages: *kv.Pool,
+    layout: kv.Layout,
+    store: radix.Store,
+    /// Snapshot records alive; zero at rest after `clear`.
+    live: usize = 0,
+    /// Fails the next restore or save (tests of the store's fallbacks).
+    fail_restore: bool = false,
+    /// The draft's ring snapshots (null: no draft).
+    ring: ?RingHook = null,
+
+    /// `self` must stay where it is: the pool's reclaim and the store's family point into it.
+    pub fn init(c: *Cache, gpa: std.mem.Allocator, pages: *kv.Pool, layout: kv.Layout, r: radix.Rules) !void {
+        c.* = .{ .gpa = gpa, .pages = pages, .layout = layout, .store = undefined };
+        c.store = try radix.Store.init(gpa, c.snapshots(), radix.pagesOf(kv.Pool, pages, pages.page_bytes), r);
+        pages.reclaim = .{ .ctx = &c.store, .call = reclaim };
+    }
+
+    pub fn deinit(c: *Cache) void {
+        c.clear();
+        c.store.deinit();
+        c.pages.reclaim = null;
+    }
+
+    /// The store may hold `pages` pages and `snaps` snapshots; 0 and 0 clears it.
+    pub fn limit(c: *Cache, pages: usize, snaps: usize) void {
+        c.store.limit(.{ .pages = pages, .snaps = snaps });
+    }
+
+    /// A half of the pool's pages and the plan's snapshot slots: kept pages are evicted when a stream asks for them.
+    pub fn limitTo(c: *Cache, snaps: usize) void {
+        c.limit(c.pages.total() / 2, snaps);
+    }
+
+    pub fn clear(c: *Cache) void {
+        c.limit(0, 0);
+    }
+
+    fn reclaim(ctx: *anyopaque, want: usize) bool {
+        const s: *radix.Store = @ptrCast(@alignCast(ctx));
+        return s.reclaim(want);
+    }
+
+    fn of(ptr: *anyopaque) *Cache {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    fn snapshots(c: *Cache) radix.Snapshots {
+        return .{ .ptr = c, .vtable = &.{ .bytes = bytes, .save = save, .restore = restore, .drop = drop } };
+    }
+
+    fn bytes(_: *anyopaque, _: u32) u64 {
+        return pool.snap_bytes;
+    }
+
+    fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!radix.Saved {
+        const c = of(ptr);
+        const rec = try c.gpa.create(Saved);
+        var ring: ?u32 = null;
+        if (c.ring) |h| if (owner) |o| {
+            ring = h.save(h.ctx, @as(*Stream, @ptrCast(@alignCast(o))).slot, at);
+        };
+        rec.* = .{ .at = at, .ring = ring };
+        c.live += 1;
+        return rec;
+    }
+
+    /// The stream continues at the snapshot's position; its pages come from the store (`begin` adopts them).
+    fn restore(ptr: *anyopaque, owner: ?*anyopaque, saved: radix.Saved) anyerror!void {
+        const c = of(ptr);
+        if (c.fail_restore) return error.RestoreFailed;
+        const rec: *Saved = @ptrCast(@alignCast(saved));
+        if (owner) |o| {
+            const st: *Stream = @ptrCast(@alignCast(o));
+            st.pos = rec.at;
+            if (c.ring) |h| if (rec.ring) |id| h.restore(h.ctx, st.slot, id);
+        }
+    }
+
+    fn drop(ptr: *anyopaque, saved: radix.Saved) void {
+        const c = of(ptr);
+        const rec: *Saved = @ptrCast(@alignCast(saved));
+        if (c.ring) |h| if (rec.ring) |id| h.drop(h.ctx, id);
+        c.gpa.destroy(rec);
+        c.live -= 1;
+    }
+
+    /// Pages a request reserves: prompt, reply and one last verify window.
+    pub fn need(c: *const Cache, prompt: usize, max_tokens: u64, window: u64) usize {
+        return c.layout.need(prompt, max_tokens, window);
+    }
+
+    /// Admits `s` as the backend does: resume the longest kept prefix (the stream's pages start as the store's), promise
+    /// the rest of its pages and take them into the block table. Returns the marks (rows, page multiples, ascending, in
+    /// `a`) where the pass should call `keep` as its prefill reaches them.
+    /// `LaneMemory`: the pool cannot promise the pages even after the store gave its idle pages back (the host requeues).
+    /// `ContextTooLong`: the request's pages pass the stream's block-table row or the whole pool (it can never run).
+    pub fn admit(c: *Cache, a: std.mem.Allocator, s: *Stream, prompt: []const u32, history: u32, max_new: u64, window: u64, table: ?kv.Table, max_pages: usize) ![]const u32 {
+        const want = c.need(prompt.len, max_new, window);
+        if (want > max_pages or want > c.pages.total()) return error.ContextTooLong;
+        var adopt: std.ArrayList(u32) = .empty;
+        defer adopt.deinit(c.gpa);
+        const plan = try c.store.begin(a, prompt, history, &.{}, s, &adopt);
+        errdefer a.free(plan.marks);
+        const l = &s.lease;
+        errdefer c.pages.finish(l);
+        try c.pages.adopt(l, adopt.items);
+        try c.pages.promise(l, want -| adopt.items.len);
+        try c.pages.cover(l, want, table);
+        s.pos = plan.from;
+        return plan.marks;
+    }
+
+    /// The pass has filled `at` rows (a mark): the store keeps a snapshot there, and the stream's leading pages become
+    /// the store's copies of the same tokens where it already held them. The block table is rewritten to match.
+    pub fn keep(c: *Cache, s: *Stream, prompt: []const u32, at: u32, table: ?kv.Table) !void {
+        const n = at / pool.page_tokens;
+        if (n == 0 or n > s.lease.ids.items.len) return;
+        const path = try c.gpa.alloc(u32, n);
+        defer c.gpa.free(path);
+        const kept = c.store.keep(prompt, at, s, s.lease.ids.items[0..n], path);
+        for (path[0..kept.shared], 0..) |id, i| c.pages.share(&s.lease, i, id);
+        if (kept.shared > 0) if (table) |t| try t.write(t.ctx, s.lease.ids.items[0..kept.shared], 0);
+    }
+
+    /// The stream ended (finished, cancelled, failed): its pages and promise go back; pages the store kept stay.
+    /// Its block-table row, if given, goes back to -1.
+    pub fn end(c: *Cache, s: *Stream, tables: ?*pool.Tables) void {
+        c.pages.finish(&s.lease);
+        if (tables) |t| t.clear(s.slot);
+        s.pos = 0;
+    }
+};
