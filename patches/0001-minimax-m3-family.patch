+test "reduction order: both ranks hold identical bits, and the rank-order sum differs from adding into the residual first" {
+    // 2^24: adding 1 or 2 to it rounds, so the order of the three terms shows in the bits
+    const h: f32 = 16777216.0;
+    const p0 = [_]f32{1};
+    const p1 = [_]f32{2};
+    // rank-order: gather both partials, then (p0 + p1) on each rank, then the residual
+    var s0: [1]f32 = undefined;
+    var s1: [1]f32 = undefined;
+    const gathered = [2]f32{ p0[0], p1[0] }; // the same buffer on both ranks
+    rankSum(&gathered, &p0, 2, 0, &s0);
+    rankSum(&gathered, &p1, 2, 1, &s1);
+    try std.testing.expectEqual(bits(s0[0]), bits(s1[0]));
+    const ordered0 = h + s0[0];
+    const ordered1 = h + s1[0];
+    try std.testing.expectEqual(bits(ordered0), bits(ordered1));
+    try std.testing.expectEqual(@as(f32, 16777220.0), ordered0);
+    // unordered alternative: each rank folds its own partial into the residual, then the peer's
+    const unordered0 = (h + p0[0]) + p1[0];
+    const unordered1 = (h + p1[0]) + p0[0];
+    try std.testing.expect(bits(unordered0) != bits(unordered1)); // the ranks disagree
+    try std.testing.expect(bits(unordered0) != bits(ordered0) or bits(unordered1) != bits(ordered1));
+    try std.testing.expectEqual(@as(f32, 16777218.0), unordered0);
+    try std.testing.expectEqual(@as(f32, 16777220.0), unordered1);
+}
+
+test "two terms commute, so for TP2 the order that matters is the sum before the residual; three terms need rank order" {
+    var prng = std.Random.DefaultPrng.init(11);
+    for (0..10_000) |_| {
+        const a: f32 = prng.random().floatNorm(f32) * 1e-3;
+        const b: f32 = prng.random().floatNorm(f32) * 1e6;
+        try std.testing.expectEqual(bits(a + b), bits(b + a));
+    }
+    // world 3: ranks that start from their own term (own, then the others) disagree; rank order does not
+    const t = [3]f32{ 16777216.0, 1.0, 1.0 };
+    var mine: [3]f32 = undefined;
+    for (0..3) |me| {
+        // the gathered buffer is the same on every rank; slot `me` is never read, own comes from the rank itself
+        var out: [1]f32 = undefined;
+        rankSum(&t, &.{t[me]}, 3, me, &out);
+        mine[me] = out[0];
+    }
+    try std.testing.expectEqual(bits(mine[0]), bits(mine[1]));
+    try std.testing.expectEqual(bits(mine[1]), bits(mine[2]));
+    // own-first rotation: rank 1 adds 1 + 1 + 2^24 = 16777218, rank 0 adds ((2^24 + 1) + 1) = 2^24
+    const rot0 = (t[0] + t[1]) + t[2];
+    const rot1 = (t[1] + t[2]) + t[0];
+    try std.testing.expect(bits(rot0) != bits(rot1));
+    try std.testing.expectEqual(bits(rot0), bits(mine[0]));
+}
+
+test "rank-order sums are identical on both ranks over random fp32 partials, in both collective forms" {
+    var prng = std.Random.DefaultPrng.init(3);
+    const rows = 7; // odd: the scatter shares are 4 and 3 rows
+    const width = 16;
+    const n = rows * width;
+    for (0..50) |_| {
+        var a: [n]f32 = undefined;
+        var b: [n]f32 = undefined;
+        for (&a, &b) |*x, *y| {
+            x.* = prng.random().floatNorm(f32) * 1e3;
+            y.* = prng.random().floatNorm(f32) * 1e-2 * @as(f32, @floatFromInt(prng.random().intRangeAtMost(u32, 1, 1 << 20)));
+        }
+        // gather_sum: the gathered buffer is [rank0 | rank1] on both ranks
+        var gathered: [2 * n]f32 = undefined;
+        @memcpy(gathered[0..n], &a);
+        @memcpy(gathered[n..], &b);
+        var r0: [n]f32 = undefined;
+        var r1: [n]f32 = undefined;
+        rankSum(&gathered, &a, 2, 0, &r0);
+        rankSum(&gathered, &b, 2, 1, &r1);
+        try std.testing.expectEqualSlices(u32, std.mem.bytesAsSlice(u32, std.mem.asBytes(&r0)), std.mem.bytesAsSlice(u32, std.mem.asBytes(&r1)));
+        // the device kernel with peers = the gathered buffer and own aliasing out gives the same bits
+        var inplace = a;
+        rankSum(&gathered, &inplace, 2, 0, &inplace);
+        try std.testing.expectEqualSlices(u32, std.mem.bytesAsSlice(u32, std.mem.asBytes(&r0)), std.mem.bytesAsSlice(u32, std.mem.asBytes(&inplace)));
+        // scatter_gather: shares summed apart, then concatenated, equals the whole-row sum
+        var sg: [n]f32 = undefined;
+        scatterGatherSum(2, &.{ &a, &b }, rows, width, &sg);
+        try std.testing.expectEqualSlices(u32, std.mem.bytesAsSlice(u32, std.mem.asBytes(&r0)), std.mem.bytesAsSlice(u32, std.mem.asBytes(&sg)));
+        // and a plain left-to-right host sum is what both are
+        for (0..n) |i| try std.testing.expectEqual(bits(a[i] + b[i]), bits(r0[i]));
+    }
+}
+
+test "row shares match rank_scatter.zig's and the form switches at the decode window" {
+    for ([_]usize{ 0, 1, 7, 64, 2047, 2048 }) |rows| for (1..5) |world| {
+        var at: usize = 0;
+        for (0..world) |r| {
+            const s = rowShare(rows, world, r);
+            try std.testing.expectEqual(at, s[0]);
+            try std.testing.expectEqual(rows / world + @intFromBool(r < rows % world), s[1] - s[0]);
+            at = s[1];
+        }
+        try std.testing.expectEqual(rows, at);
+    };
+    try std.testing.expectEqual([2]usize{ 683, 1365 }, rowShare(2047, 3, 1));
+    try std.testing.expectEqual(Form.gather_sum, formFor(1));
+    try std.testing.expectEqual(Form.gather_sum, formFor(128));
+    try std.testing.expectEqual(Form.scatter_gather, formFor(129));
+}
diff --git a/zig/src/families/minimax_m3/weights.zig b/zig/src/families/minimax_m3/weights.zig
new file mode 100644
index 0000000..84cbfe4
--- /dev/null
+++ b/zig/src/families/minimax_m3/weights.zig
@@ -0,0 +1,254 @@
+//! A rank's weights as the kernels take them, described from load.Plan and each slot's device base; host only.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const load = @import("load.zig");
+const names = @import("names.zig");
+const ffn = @import("ffn.zig");
+const Config = @import("config.zig").Config;
+const exl3 = cuda.exl3;
+const st = core.safetensors;
+
+pub const Error = error{ MissingTensor, BadDtype, BadShape, BadLayer, OutOfMemory };
+
+pub const Dense = struct { gate: exl3.Weight, up: exl3.Weight, down: exl3.Weight };
+
+pub const Moe = struct {
+    router: u64, // fp32 [experts, hidden], as stored
+    bias: u64, // fp32 [experts], e_score_correction_bias
+    experts: cuda.exl3_experts.Layer,
+    shared: Dense,
+};
+
+pub const Ffn = union(enum) { dense: Dense, moe: Moe };
+
+/// One layer. Norm weights are fp32 `1 + w` (the Gemma fold ran in the streamer); index projections are fp16.
+pub const Layer = struct {
+    input_ln: u64 = 0,
+    post_ln: u64 = 0,
+    q_norm: u64 = 0,
+    k_norm: u64 = 0,
+    index_q_norm: u64 = 0,
+    index_k_norm: u64 = 0,
+    index_q_proj: u64 = 0, // fp16 [this rank's index heads * index dim, hidden]
+    index_k_proj: u64 = 0, // fp16 [index dim, hidden], replicated
+    q: exl3.Weight,
+    k: exl3.Weight,
+    v: exl3.Weight,
+    o: exl3.Weight,
+    ffn: Ffn,
+};
+
+pub const Weights = struct {
+    embed: u64 = 0, // bf16 [vocab, hidden], replicated
+    final_norm: u64 = 0,
+    head: exl3.Weight,
+    layers: []Layer,
+};
+
+/// One routed layer's per-expert tables as the experts kernel reads them, before they are on the device.
+pub const Tables = struct {
+    layer: u16,
+    gate: []u64, // w1: trellis pointer of each expert
+    up: []u64, // w3
+    down: []u64, // w2
+    gate_k2: []const i32, // 2 * bits of each expert's trellis
+    up_k2: []const i32,
+    down_k2: []const i32,
+};
+
+/// The device pointers of the six tables once uploaded, in `Tables` order.
+pub const TablePtrs = struct { gate: u64, up: u64, down: u64, gate_k2: u64, up_k2: u64, down_k2: u64 };
+
+pub const Described = struct { weights: Weights, tables: []Tables };
+
+/// The kernel's record of one dense matrix: slot base plus the matrix' byte offsets, strides for its rank-local shape.
+pub fn weight(m: load.Matrix, bases: []const u64) exl3.Weight {
+    const s = exl3.strides(m.k, m.n, m.halves, false);
+    return .{
+        .trellis = bases[m.trellis] + m.trellis_off,
+        .suh = bases[m.suh] + m.suh_off,
+        .svh = bases[m.svh] + m.svh_off,
+        .k = m.k,
+        .n = m.n,
+        .halves = m.halves,
+        .codebook = .mul1,
+        .stride_k = s.k,
+        .stride_nb = s.nb,
+    };
+}
+
+fn matrix(plan: *const load.Plan, bases: []const u64, proj: names.Proj, layer: u32) Error!exl3.Weight {
+    const m = plan.matrix(proj, layer, 0) orelse return error.MissingTensor;
+    return weight(m.*, bases);
+}
+
+/// The half-bit width every expert of all three projections shares, else 0 (layer 17's 4-bit w1/w3 with a 3-bit w2).
+pub fn uniformK2(m: *const load.MoeLayer) u32 {
+    var width: ?u32 = null;
+    for ([_]*const load.MoeProj{ &m.w1, &m.w3, &m.w2 }) |p| {
+        var seen: ?u32 = null;
+        for (p.histogram, 0..) |count, k2| {
+            if (count == 0) continue;
+            if (seen != null) return 0;
+            seen = @intCast(k2);
+        }
+        const only = seen orelse return 0;
+        if (width != null and width.? != only) return 0;
+        width = only;
+    }
+    return width orelse 0;
+}
+
+fn tables(a: std.mem.Allocator, m: *const load.MoeLayer, bases: []const u64) Error!Tables {
+    const n = m.w1.halves.len;
+    var out: Tables = .{ .layer = m.layer, .gate = undefined, .up = undefined, .down = undefined, .gate_k2 = m.w1.halves, .up_k2 = m.w3.halves, .down_k2 = m.w2.halves };
+    if (m.w3.halves.len != n or m.w2.halves.len != n) return error.BadShape;
+    inline for (.{ .{ "gate", &m.w1 }, .{ "up", &m.w3 }, .{ "down", &m.w2 } }) |pair| {
+        const p: *const load.MoeProj = pair[1];
+        const ptrs = try a.alloc(u64, n);
+        for (ptrs, p.trellis_off) |*d, off| d.* = bases[p.trellis_slot] + off;
+        @field(out, pair[0]) = ptrs;
+    }
+    return out;
+}
+
+fn moeLayer(a: std.mem.Allocator, plan: *const load.Plan, c: *const Config, bases: []const u64, l: u32, pending: *std.ArrayList(Tables)) Error!Moe {
+    const m = plan.moeLayer(l) orelse return error.MissingTensor;
+    if (m.w1.k != m.w3.k or m.w1.n != m.w3.n or m.w2.k != m.w1.n or m.w2.n != m.w1.k) return error.BadShape;
+    try pending.append(a, try tables(a, m, bases));
+    return .{
+        .router = 0,
+        .bias = 0,
+        .shared = .{
+            .gate = try matrix(plan, bases, .shared_gate, l),
+            .up = try matrix(plan, bases, .shared_up, l),
+            .down = try matrix(plan, bases, .shared_down, l),
+        },
+        .experts = .{
+            .gate = 0,
+            .up = 0,
+            .down = 0,
+            .gate_k2 = 0,
+            .up_k2 = 0,
+            .down_k2 = 0,
+            .suh_g = bases[m.w1.suh_slot],
+            .suh_u = bases[m.w3.suh_slot],
+            .svh_g = bases[m.w1.svh_slot],
+            .svh_u = bases[m.w3.svh_slot],
+            .suh_d = bases[m.w2.suh_slot],
+            .svh_d = bases[m.w2.svh_slot],
+            .experts = c.experts,
+            .dims = m.w1.k,
+            .width = m.w1.n,
+            .codebook = .mul1,
+            .uniform_k2 = uniformK2(m),
+            .shared_input = false, // decision M7: no check of the gate/up scales yet
+        },
+    };
+}
+
+/// `bases[slot]` is slot's device address. `layers` is how many layers the plan holds (a thin model: the first ones).
+pub fn describe(a: std.mem.Allocator, plan: *const load.Plan, c: *const Config, bases: []const u64, layers: usize) Error!Described {
+    if (bases.len != plan.slots.len or layers > c.layers) return error.BadLayer;
+    const out = try a.alloc(Layer, layers);
+    var pending: std.ArrayList(Tables) = .empty;
+    for (out, 0..) |*o, i| {
+        const l: u32 = @intCast(i);
+        o.* = .{
+            .q = try matrix(plan, bases, .q, l),
+            .k = try matrix(plan, bases, .k, l),
+            .v = try matrix(plan, bases, .v, l),
+            .o = try matrix(plan, bases, .o, l),
+            .ffn = if (c.isMoe(l)) .{ .moe = try moeLayer(a, plan, c, bases, l, &pending) } else .{ .dense = .{
+                .gate = try matrix(plan, bases, .dense_gate, l),
+                .up = try matrix(plan, bases, .dense_up, l),
+                .down = try matrix(plan, bases, .dense_down, l),
+            } },
+        };
+    }
+    var w: Weights = .{ .head = try matrix(plan, bases, .head, 0), .layers = out };
+    var seen_embed = false;
+    for (plan.plain) |p| {
+        const at = bases[p.slot];
+        try checkPlain(p);
+        switch (p.role) {
+            .embed => {
+                w.embed = at;
+                seen_embed = true;
+            },
+            .final_norm => w.final_norm = at,
+            else => {
+                if (p.layer >= layers) continue;
+                const o = &out[p.layer];
+                switch (p.role) {
+                    .input_ln => o.input_ln = at,
+                    .post_ln => o.post_ln = at,
+                    .q_norm => o.q_norm = at,
+                    .k_norm => o.k_norm = at,
+                    .index_q_norm => o.index_q_norm = at,
+                    .index_k_norm => o.index_k_norm = at,
+                    .index_q_proj => o.index_q_proj = at,
+                    .index_k_proj => o.index_k_proj = at,
+                    .router => if (o.ffn == .moe) {
+                        o.ffn.moe.router = at;
+                    } else return error.BadLayer,
+                    .router_bias => if (o.ffn == .moe) {
+                        o.ffn.moe.bias = at;
+                    } else return error.BadLayer,
+                    .embed, .final_norm => unreachable,
+                }
+            },
+        }
+    }
+    if (!seen_embed) return error.MissingTensor;
+    return .{ .weights = w, .tables = try pending.toOwnedSlice(a) };
+}
+
+/// The dtype each plain role must hold on the device: norms folded to fp32, index projections fp16, router fp32.
+pub fn checkPlain(p: load.PlainTensor) Error!void {
+    const want: st.DType = switch (p.role) {
+        .embed => .bf16,
+        .index_q_proj, .index_k_proj => .f16,
+        .router, .router_bias => .f32,
+        else => .f32,
+    };
+    if (p.dtype != want) return error.BadDtype;
+}
+
+/// Sets layer `t.layer`'s table pointers and applies decision M5's switches (which may swap gate and up).
+pub fn attachTables(w: *Weights, t: Tables, ptrs: TablePtrs, sw: ffn.Switches) void {
+    const e = &w.layers[t.layer].ffn.moe.experts;
+    e.gate = ptrs.gate;
+    e.up = ptrs.up;
+    e.down = ptrs.down;
+    e.gate_k2 = ptrs.gate_k2;
+    e.up_k2 = ptrs.up_k2;
+    e.down_k2 = ptrs.down_k2;
+    ffn.configureLayer(e, sw);
+}
+
+/// One buffer per routed layer holds its six tables: three int64 pointer tables, then three int32 width tables.
+pub fn packTables(a: std.mem.Allocator, t: Tables) Error![]u8 {
+    const n = t.gate.len;
+    const out = try a.alloc(u8, n * (3 * 8 + 3 * 4));
+    var at: usize = 0;
+    for ([_][]const u64{ t.gate, t.up, t.down }) |p| for (p) |v| {
+        std.mem.writeInt(u64, out[at..][0..8], v, .little);
+        at += 8;
+    };
+    for ([_][]const i32{ t.gate_k2, t.up_k2, t.down_k2 }) |p| for (p) |v| {
+        std.mem.writeInt(i32, out[at..][0..4], v, .little);
+        at += 4;
+    };
+    return out;
+}
+
+/// Where the six tables of `packTables` sit when the buffer starts at device address `base`, for `n` experts.
+pub fn tablePtrs(base: u64, n: usize) TablePtrs {
+    return .{ .gate = base, .up = base + 8 * n, .down = base + 16 * n, .gate_k2 = base + 24 * n, .up_k2 = base + 28 * n, .down_k2 = base + 32 * n };
+}
+
+test {
+    _ = @import("weights_test.zig");
+}
diff --git a/zig/src/families/minimax_m3/weights_device.zig b/zig/src/families/minimax_m3/weights_device.zig
new file mode 100644
index 0000000..38d5db1
--- /dev/null
+++ b/zig/src/families/minimax_m3/weights_device.zig
@@ -0,0 +1,137 @@
+//! A rank's weights on the device: a buffer per slot, direct I/O, page cache dropped per shard, a header digest.
+const std = @import("std");
+const cuda = @import("cuda");
+const load = @import("load.zig");
+const shard_ = @import("shard.zig");
+const weights = @import("weights.zig");
+const ffn = @import("ffn.zig");
+const Config = @import("config.zig").Config;
+const Sha256 = std.crypto.hash.sha2.Sha256;
+
+/// Bytes put between stream synchronizations: bounds the pinned staging the async copies hold.
+pub const sync_every: u64 = 256 << 20;
+
+/// sha256 over each tensor's name, shard, dtype, shape and byte range in name order; no data byte is read (NFS-safe).
+pub fn digest(gpa: std.mem.Allocator, cat: *const load.Catalog) ![32]u8 {
+    const keys = try gpa.alloc([]const u8, cat.map.count());
+    defer gpa.free(keys);
+    var it = cat.map.keyIterator();
+    for (keys) |*k| k.* = it.next().?.*;
+    std.mem.sort([]const u8, keys, {}, struct {
+        fn less(_: void, a: []const u8, b: []const u8) bool {
+            return std.mem.lessThan(u8, a, b);
+        }
+    }.less);
+    var h = Sha256.init(.{});
+    for (keys) |k| {
+        const r = cat.map.get(k).?;
+        h.update(k);
+        h.update(&.{0});
+        const fields = [_]u64{ r.shard, @intFromEnum(r.dtype), r.rank, r.begin, r.len };
+        for (fields) |f| h.update(std.mem.asBytes(&std.mem.nativeToLittle(u64, f)));
+        for (r.shape[0..r.rank]) |d| h.update(std.mem.asBytes(&std.mem.nativeToLittle(u64, d)));
+    }
+    return h.finalResult();
+}
+
+/// Streams `plan` through `sink`, calling `ended` after each shard's last run.
+pub fn feed(gpa: std.mem.Allocator, cat: *const load.Catalog, plan: *const load.Plan, sink: load.Sink, ended: ?load.ShardEnd) !void {
+    var s = try load.Streamer.init(gpa, cat, load.Streamer.default_chunk);
+    defer s.deinit();
+    s.ended = ended;
+    try s.run(plan, sink);
+}
+
+/// The shard-end hook that empties the page cache of the shard's file.
+pub const CacheDrop = struct {
+    cat: *const load.Catalog,
+
+    pub fn hook(d: *CacheDrop) load.ShardEnd {
+        return .{ .ctx = d, .call = call };
+    }
+
+    fn call(ctx: *anyopaque, shard: u16) void {
+        const d: *CacheDrop = @ptrCast(@alignCast(ctx));
+        d.cat.files.items[shard].dropCache();
+    }
+};
+
+/// The sink onto per-slot device buffers: async copies on `stream`, synchronized every `sync_every` bytes.
+const Upload = struct {
+    bufs: []const cuda.DeviceBuffer,
+    stream: cuda.Stream,
+    since: u64 = 0,
+
+    fn put(ctx: *anyopaque, slot: u32, offset: u64, bytes: []const u8) anyerror!void {
+        const u: *Upload = @ptrCast(@alignCast(ctx));
+        try u.bufs[slot].uploadAsync(@intCast(offset), bytes, u.stream.handle);
+        u.since += bytes.len;
+        if (u.since >= sync_every) {
+            try u.stream.synchronize();
+            u.since = 0;
+        }
+    }
+};
+
+pub const Loaded = struct {
+    arena: std.heap.ArenaAllocator,
+    bufs: []cuda.DeviceBuffer,
+    tables: []cuda.DeviceBuffer,
+    weights: weights.Weights,
+    digest: [32]u8,
+    bytes: u64, // device bytes of the slots
+
+    pub fn deinit(l: *Loaded) void {
+        for (l.bufs) |*b| b.free();
+        for (l.tables) |*b| b.free();
+        l.arena.deinit();
+        l.* = undefined;
+    }
+};
+
+/// Plans rank `share` (the first `layers` layers; 0: all), fills the slots, uploads the expert tables. UNEXERCISED.
+pub fn loadWeights(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, stream: cuda.Stream, dir: []const u8, c: *const Config, share: shard_.Share, layers: usize) !Loaded {
+    var cat = try load.Catalog.open(gpa, io, dir);
+    defer cat.deinit();
+    const sum = try digest(gpa, &cat);
+    var first: [64]u16 = undefined;
+    const subset: []const u16 = if (layers == 0 or layers >= c.layers) &.{} else blk: {
+        for (first[0..layers], 0..) |*f, i| f.* = @intCast(i);
+        break :blk first[0..layers];
+    };
+    var plan = try load.Plan.build(gpa, &cat, c, share, .{ .layers = subset });
+    defer plan.deinit();
+    var out: Loaded = .{ .arena = .init(gpa), .bufs = &.{}, .tables = &.{}, .weights = undefined, .digest = sum, .bytes = plan.slotBytes() };
+    errdefer out.arena.deinit();
+    const a = out.arena.allocator();
+    var made: std.ArrayList(cuda.DeviceBuffer) = .empty;
+    errdefer made.deinit(gpa);
+    errdefer for (made.items) |*b| b.free();
+    const bases = try a.alloc(u64, plan.slots.len);
+    for (plan.slots, bases) |s, *base| {
+        const b = try cuda.DeviceBuffer.alloc(d, @intCast(s.bytes));
+        try made.append(gpa, b);
+        base.* = b.ptr;
+    }
+    var up: Upload = .{ .bufs = made.items, .stream = stream };
+    var drop: CacheDrop = .{ .cat = &cat };
+    try feed(gpa, &cat, &plan, .{ .ctx = &up, .put = Upload.put }, drop.hook());
+    try stream.synchronize();
+    var described = try weights.describe(a, &plan, c, bases, if (layers == 0) c.layers else layers);
+    var tab: std.ArrayList(cuda.DeviceBuffer) = .empty;
+    errdefer tab.deinit(gpa);
+    errdefer for (tab.items) |*b| b.free();
+    for (described.tables) |t| {
+        const packed_ = try weights.packTables(gpa, t);
+        defer gpa.free(packed_);
+        const b = try cuda.DeviceBuffer.fromHost(d, packed_);
+        try tab.append(gpa, b);
+        weights.attachTables(&described.weights, t, weights.tablePtrs(b.ptr, t.gate.len), ffn.Switches{});
+    }
+    out.bufs = try a.dupe(cuda.DeviceBuffer, made.items);
+    out.tables = try a.dupe(cuda.DeviceBuffer, tab.items);
+    made.deinit(gpa);
+    tab.deinit(gpa);
+    out.weights = described.weights;
+    return out;
+}
diff --git a/zig/src/families/minimax_m3/weights_test.zig b/zig/src/families/minimax_m3/weights_test.zig
new file mode 100644
index 0000000..1ebf856
--- /dev/null
+++ b/zig/src/families/minimax_m3/weights_test.zig
@@ -0,0 +1,214 @@
+//! weights.zig and weights_device.zig on the synthetic mini checkpoint, with fake slot bases and sinks; no GPU.
+const std = @import("std");
+const load = @import("load.zig");
+const weights = @import("weights.zig");
+const device = @import("weights_device.zig");
+const shard = @import("shard.zig");
+const ffn = @import("ffn.zig");
+const synth = @import("load_synth_test.zig");
+const native = @import("native.zig");
+const budget = @import("budget.zig");
+
+const gpa = std.testing.allocator;
+const base0: u64 = 0x7000_0000_0000;
+
+fn fakeBases(plan: *const load.Plan, out: []u64) void {
+    for (plan.slots, out, 0..) |s, *b, i| b.* = base0 + i * 0x1_0000_0000 + (s.bytes & 0);
+}
+
+const Fixture = struct {
+    dir: synth.Dir,
+    cat: load.Catalog,
+    pack: synth.Pack,
+
+    fn init(io: std.Io, c: *const @import("config.zig").Config, mutate: bool) !Fixture {
+        var pack = synth.Pack.init();
+        errdefer pack.deinit();
+        try pack.all(c);
+        if (mutate) pack.ts.items[0].data[0] ^= 0xff;
+        var dir = try synth.Dir.init(io);
+        errdefer dir.deinit();
+        try synth.write(io, dir.tmp.dir, &pack, .{});
