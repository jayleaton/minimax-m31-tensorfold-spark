+const gpa = std.testing.allocator;
+
+// ---- the pack's real header: names, shapes, cuts -----------------------------------------------------------------
+
+const header_json = @embedFile("fixtures/dspark_header.json");
+const header_data_len: usize = 2_301_852_674; // model.safetensors.index.json total_size
+
+fn catalog() !load.Catalog {
+    var cat = load.Catalog.init(gpa);
+    errdefer cat.deinit();
+    try dl.addHeader(&cat, 0, header_json, header_data_len);
+    return cat;
+}
+
+fn catalogWith(from: []const u8, to: []const u8) !load.Catalog {
+    const json = try std.mem.replaceOwned(u8, gpa, header_json, from, to);
+    defer gpa.free(json);
+    try std.testing.expect(!std.mem.eql(u8, json, header_json));
+    var cat = load.Catalog.init(gpa);
+    errdefer cat.deinit();
+    try dl.addHeader(&cat, 0, json, header_data_len);
+    return cat;
+}
+
+test "the header has the 97 tensors the name map says, every one a role, nothing else" {
+    var cat = try catalog();
+    defer cat.deinit();
+    try std.testing.expectEqual(@as(usize, 97), cat.map.count());
+    var plain: usize = 0;
+    var lin: usize = 0;
+    var it = cat.map.iterator();
+    while (it.next()) |kv| {
+        const n = dn.parse(kv.key_ptr.*) orelse return error.UnknownTensor;
+        switch (n.what) {
+            .plain => |p| {
+                plain += 1;
+                try std.testing.expectEqual(st_bf16, kv.value_ptr.dtype);
+                _ = p;
+            },
+            .lin => |l| {
+                lin += 1;
+                try std.testing.expectEqual(if (l.part == .weight) core.safetensors.DType.f8_e4m3 else core.safetensors.DType.u8, kv.value_ptr.dtype);
+            },
+        }
+    }
+    try std.testing.expectEqual(@as(usize, 27), plain); // 7 global + 5 x 4 per layer
+    try std.testing.expectEqual(@as(usize, 70), lin); // 5 layers x 7 linears x (codes, scales)
+}
+const st_bf16 = core.safetensors.DType.bf16;
+
+fn share(rank: usize, world: usize) !shard.Share {
+    return shard.Share.of(&target.flash, rank, world);
+}
+
+test "the plan for one rank and for two: bytes equal the arithmetic of dspark_config" {
+    const c = dc.flash;
+    for ([_]usize{ 1, 2 }) |world| for (0..world) |rank| {
+        var cat = try catalog();
+        defer cat.deinit();
+        var plan = try dl.Plan.build(gpa, &cat, &c, try share(rank, world), .{});
+        defer plan.deinit();
+        const want = dc.rankWeights(&c, try share(rank, world), false);
+        try std.testing.expectEqual(want.total(), plan.slotBytes());
+        try std.testing.expectEqual(@as(usize, 35), plan.mats.len);
+        try std.testing.expectEqual(@as(usize, 27), plan.plain.len);
+        try std.testing.expectEqual(@as(usize, 0), plan.ignored);
+        // the item runs read exactly the slot bytes, none twice
+        var read: u64 = 0;
+        for (plan.items) |i| read += i.span.bytes();
+        try std.testing.expectEqual(plan.slotBytes(), read);
+    };
+}
+
+test "two ranks' runs tile every tensor exactly once; replicated tensors are read whole by both" {
+    const c = dc.flash;
+    var cat = try catalog();
+    defer cat.deinit();
+    var plans: [2]dl.Plan = undefined;
+    for (&plans, 0..) |*p, r| p.* = try dl.Plan.build(gpa, &cat, &c, try share(r, 2), .{});
+    defer for (&plans) |*p| p.deinit();
+    // each tensor's runs of both ranks sorted: cut tensors abut exactly, replicated ones are two whole copies
+    var by_base: std.AutoHashMapUnmanaged(u64, std.ArrayList([2]u64)) = .empty;
+    defer {
+        var vit = by_base.valueIterator();
+        while (vit.next()) |v| v.deinit(gpa);
+        by_base.deinit(gpa);
+    }
+    for (plans) |p| for (p.items) |i| {
+        const e = try by_base.getOrPut(gpa, i.base);
+        if (!e.found_existing) e.value_ptr.* = .empty;
+        for (0..i.span.count) |n| try e.value_ptr.append(gpa, .{ i.span.at(n), i.span.at(n) + i.span.len });
+    };
+    var it = cat.map.iterator();
+    while (it.next()) |kv| {
+        const runs = by_base.getPtr(kv.value_ptr.begin) orelse return error.TensorNotRead;
+        std.mem.sort([2]u64, runs.items, {}, struct {
+            fn less(_: void, a: [2]u64, b: [2]u64) bool {
+                return a[0] < b[0];
+            }
+        }.less);
+        const n = dn.parse(kv.key_ptr.*).?;
+        const whole = n.what == .plain and (n.what.plain != .fc or true); // plain tensors are replicated
+        if (whole) {
+            // two identical copies of [0, len)
+            try std.testing.expectEqual(@as(usize, 2), runs.items.len);
+            for (runs.items) |r| try std.testing.expectEqual([2]u64{ 0, kv.value_ptr.len }, r);
+        } else {
+            var at: u64 = 0;
+            for (runs.items) |r| {
+                try std.testing.expectEqual(at, r[0]);
+                at = r[1];
+            }
+            try std.testing.expectEqual(kv.value_ptr.len, at);
+        }
+    }
+}
+
+test "the cuts: q 4096 rows, kv 256, o and down input halves, gate/up 6144 rows; scales follow in 32s" {
+    const c = dc.flash;
+    var cat = try catalog();
+    defer cat.deinit();
+    var plan = try dl.Plan.build(gpa, &cat, &c, try share(1, 2), .{});
+    defer plan.deinit();
+    const want = [_]struct { p: dn.Lin, n: u32, k: u32 }{
+        .{ .p = .q, .n = 4096, .k = 6144 },
+        .{ .p = .k, .n = 256, .k = 6144 },
+        .{ .p = .v, .n = 256, .k = 6144 },
+        .{ .p = .o, .n = 6144, .k = 4096 },
+        .{ .p = .gate, .n = 6144, .k = 6144 },
+        .{ .p = .up, .n = 6144, .k = 6144 },
+        .{ .p = .down, .n = 6144, .k = 6144 },
+    };
+    for (want) |w| {
+        const m = plan.mat(w.p, 4).?;
+        try std.testing.expectEqual(w.n, m.n);
+        try std.testing.expectEqual(w.k, m.k);
+        try std.testing.expectEqual(@as(u64, w.n) * w.k, plan.slots[m.codes].bytes);
+        try std.testing.expectEqual(@as(u64, w.n) * w.k / 32, plan.slots[m.scales].bytes);
+    }
+    // rank 1's o_proj: columns [4096, 8192) of every row, 6144 runs a row apart (scale runs: 128 bytes)
+    var runs: usize = 0;
+    for (plan.items) |i| if (i.slot == plan.mat(.o, 0).?.codes) {
+        try std.testing.expectEqual(@as(u64, 4096), i.span.offset);
+        try std.testing.expectEqual(@as(u64, 4096), i.span.len);
+        try std.testing.expectEqual(@as(u64, 8192), i.span.stride);
+        try std.testing.expectEqual(@as(u64, 6144), i.span.count);
+        runs += 1;
+    };
+    try std.testing.expectEqual(@as(usize, 1), runs);
+    // the Markov tables whole by default, by the head's vocabulary units when asked
+    try std.testing.expectEqual(@as(u32, 200064), plan.tensor(.markov_w1, 0).?.rows);
+    var cut = try dl.Plan.build(gpa, &cat, &c, try share(1, 2), .{ .markov_cut = true });
+    defer cut.deinit();
+    try std.testing.expectEqual(@as(u32, 781 * 128), cut.tensor(.markov_w2, 0).?.rows);
+    // nothing is folded: the norms are stored as they are (the Gemma offset is an unverified switch)
+    for (plan.items) |i| try std.testing.expect(!i.fold);
+}
+
+test "a missing, misshaped, retyped or extra tensor refuses the plan" {
+    const c = dc.flash;
+    const s = try share(0, 2);
+    {
+        var cat = try catalogWith("language_model.model.dspark.fc.weight", "language_model.model.dspark.fx.weight");
+        defer cat.deinit();
+        try std.testing.expectError(error.MissingTensor, dl.Plan.build(gpa, &cat, &c, s, .{}));
+    }
+    {
+        // codes retyped to e5m2 (same size)
+        var cat = try catalogWith("layers.2.decoder_layer.mlp.up_proj.weight\":{\"dtype\":\"F8_E4M3\"", "layers.2.decoder_layer.mlp.up_proj.weight\":{\"dtype\":\"F8_E5M2\"");
+        defer cat.deinit();
+        try std.testing.expectError(error.MisshapedTensor, dl.Plan.build(gpa, &cat, &c, s, .{}));
+    }
+    {
+        // scales retyped to i8
+        var cat = try catalogWith("layers.4.decoder_layer.mlp.up_proj.weight_scale_inv\":{\"dtype\":\"U8\"", "layers.4.decoder_layer.mlp.up_proj.weight_scale_inv\":{\"dtype\":\"I8\"");
+        defer cat.deinit();
+        try std.testing.expectError(error.MisshapedTensor, dl.Plan.build(gpa, &cat, &c, s, .{}));
+    }
+    {
+        // a tensor of the draft's namespace no role names (the draft has no head of its own)
+        var cat = try catalog();
+        defer cat.deinit();
+        try cat.add("language_model.model.dspark.lm_head.weight", .{ .shard = 0, .dtype = .bf16, .rank = 1, .shape = .{ 1, 1, 1, 1, 1 }, .begin = 0, .len = 2 });
+        try std.testing.expectError(error.UnexpectedTensor, dl.Plan.build(gpa, &cat, &c, s, .{}));
+    }
+    {
+        // a tensor of another namespace is ignored, not refused
+        var cat = try catalog();
+        defer cat.deinit();
+        try cat.add("language_model.model.layers.0.input_layernorm.weight", .{ .shard = 0, .dtype = .bf16, .rank = 1, .shape = .{ 6144, 1, 1, 1, 1 }, .begin = 0, .len = 12288 });
+        var plan = try dl.Plan.build(gpa, &cat, &c, s, .{});
+        defer plan.deinit();
+        try std.testing.expectEqual(@as(usize, 1), plan.ignored);
+    }
+}
+
+// ---- the float8 decode against TensorFold's own codec ----------------------------------------------------------
+
+test "e4m3 and ue8m0 equal TensorFold's codec for every byte" {
+    const codec = core.exlr8.codec;
+    for (0..256) |i| {
+        const code: u8 = @intCast(i);
+        const mine = ref.e4m3(code);
+        const theirs: f64 = codec.e4m3Value(code);
+        if (std.math.isNan(theirs)) try std.testing.expect(std.math.isNan(mine)) else try std.testing.expectEqual(theirs, mine);
+        // exlr8_dense.zig dequantizes an mxfp8 scale as ldexp(1, byte - 127); the NaN byte is qmmf.cu's
+        if (i < 255) try std.testing.expectEqual(std.math.ldexp(@as(f64, 1), @as(i32, @intCast(i)) - 127), ref.ue8m0(code, 127));
+    }
+    try std.testing.expect(std.math.isNan(ref.ue8m0(255, 127)));
+}
+
+// ---- memory: what the draft adds to a rank's budget -----------------------------------------------------------------
+
+test "budget: the draft takes its weights and runtime before any KV and a ring a stream; the refusal names it" {
+    const c = dc.flash;
+    const s = try share(0, 2);
+    const dims = try pool.Dims.of(&target.flash, s);
+    const total: u64 = 119 * budget.GiB; // assumed GB10 memory; the real number is measured at start-up
+    const plain = try budget.tensorfold(total, null);
+    const cost = dc.cost(&c, s, 16, 2048, false);
+    const drafted = budget.withDraft(plain, cost);
+    var in: budget.Input = .{ .available = total, .weights = 91 * budget.GiB, .terms = plain };
+    var in_d = in;
+    in_d.terms = drafted;
+    const without = budget.check(dims, in, null).ok;
+    const with = budget.check(dims, in_d, null).ok;
+    // the draft costs weights + runtime + one stream's ring and scratch, which the pool gives up in whole pages
+    const spent = cost.weights + cost.runtime + cost.per_lane;
+    const lost = (without.pool_tokens - with.pool_tokens) * dims.tokenBytes();
+    // (whole pages, and the score chunk shrinks with the shorter context: a few pages of slack either way)
+    try std.testing.expect(@abs(@as(i64, @intCast(lost)) - @as(i64, @intCast(spent))) <= @as(i64, @intCast(3 * dims.pageBytes())));
+    try std.testing.expect(with.context < without.context);
+    try std.testing.expectEqual(spent, budget.draftBytes(drafted, 1));
+    try std.testing.expectEqual(@as(u64, 0), budget.draftBytes(plain, 4));
+    // a context that fit without the draft but not with it is refused with the draft named
+    in_d.weights = 106 * budget.GiB;
+    in.weights = 106 * budget.GiB;
+    const lone = budget.check(dims, in, null);
+    switch (lone) {
+        .ok => |cap| {
+            const asked = cap.context;
+            const verdict = budget.check(dims, in_d, asked);
+            if (verdict == .refused) {
+                const text = try budget.refusalText(gpa, verdict.refused);
+                defer gpa.free(text);
+                try std.testing.expect(std.mem.indexOf(u8, text, "the dspark draft takes") != null);
+                try std.testing.expect(std.mem.indexOf(u8, text, "serve without --drafter") != null);
+            } else return error.DraftCostNothing;
+        },
+        .refused => {},
+    }
+    // lanes: each extra stream adds its ring
+    var four = in_d;
+    four.lanes = 4;
+    try std.testing.expectEqual(cost.weights + cost.runtime + 4 * cost.per_lane, budget.draftBytes(four.terms, 4));
+}
diff --git a/zig/src/families/minimax_m3/dspark_twin.zig b/zig/src/families/minimax_m3/dspark_twin.zig
new file mode 100644
index 0000000..229c2de
--- /dev/null
+++ b/zig/src/families/minimax_m3/dspark_twin.zig
@@ -0,0 +1,252 @@
+//! Host twins of the draft's planned engine layout, each with planted mutants (like tests/minimax_*_twin.zig).
+const std = @import("std");
+// The K/V ring the engine would keep, the two-rank tensor-parallel block, and the per-rank candidate gather.
+const core = @import("core");
+// dspark_model_test.zig runs each clean twin against dspark_ref.zig and requires every mutant to be caught.
+const mr = core.minimax_ref;
+const ref = @import("dspark_ref.zig");
+
+// ---- the context ring ---------------------------------------------------------------------------------------------
+
+pub const RingMutant = enum {
+    none,
+    short_ring, // six rows too few: the oldest rows the window still sees are gone
+    rope_at_slot, // K rotated by the ring slot, not the token position
+    stale_slot, // a slot already written is never overwritten after the ring wraps
+    drop_last_absorb, // the newest absorbed row is not stored
+};
+
+/// The engine's per-stream context: the draft layers' K/V of the last `cap` positions at slot (position mod cap).
+pub const Ring = struct {
+    d: *const ref.Draft,
+    cap: usize,
+    k: [][]f64,
+    v: [][]f64,
+    end: usize = 0, // next position to absorb
+    m: RingMutant,
+
+    pub fn init(a: std.mem.Allocator, d: *const ref.Draft, cap: usize, m: RingMutant) !Ring {
+        const c = d.cfg;
+        const eff = if (m == .short_ring) cap - 6 else cap;
+        const k = try a.alloc([]f64, c.layers);
+        const v = try a.alloc([]f64, c.layers);
+        for (k, v) |*kk, *vv| {
+            kk.* = try a.alloc(f64, eff * c.kvw());
+            vv.* = try a.alloc(f64, eff * c.kvw());
+            @memset(kk.*, 0);
+            @memset(vv.*, 0);
+        }
+        return .{ .d = d, .cap = eff, .k = k, .v = v, .m = m };
+    }
+
+    /// Takes the tapped row of position `end` (positions are absorbed in order, as the verify keeps them).
+    pub fn absorb(r: *Ring, a: std.mem.Allocator, feats: []const f64, last: bool) !void {
+        const c = r.d.cfg;
+        const pos = r.end;
+        r.end += 1;
+        if (last and r.m == .drop_last_absorb) return;
+        const slot = pos % r.cap;
+        if (r.m == .stale_slot and pos >= r.cap) return;
+        const st = try a.alloc(f64, c.hidden);
+        defer a.free(st);
+        try ref.contextState(r.d, a, feats, st);
+        for (0..c.layers) |l| {
+            const rope_pos = if (r.m == .rope_at_slot) slot else pos;
+            try ref.contextKv(r.d, a, l, st, rope_pos, r.k[l][slot * c.kvw() ..][0..c.kvw()], r.v[l][slot * c.kvw() ..][0..c.kvw()]);
+        }
+    }
+
+    /// The valid rows as a Ctx in position order (what the attention kernel walks through the ring's slot list).
+    pub fn ctx(r: *const Ring, a: std.mem.Allocator) !ref.Ctx {
+        const c = r.d.cfg;
+        const n = @min(r.end, r.cap);
+        const first = r.end - n;
+        const cx = try ref.Ctx.alloc(a, c, first, n);
+        for (0..n) |j| {
+            const slot = (first + j) % r.cap;
+            for (0..c.layers) |l| {
+                @memcpy(cx.k[l][j * c.kvw() ..][0..c.kvw()], r.k[l][slot * c.kvw() ..][0..c.kvw()]);
+                @memcpy(cx.v[l][j * c.kvw() ..][0..c.kvw()], r.v[l][slot * c.kvw() ..][0..c.kvw()]);
+            }
+        }
+        return cx;
+    }
+};
+
+// ---- two-rank tensor parallel block -----------------------------------------------------------------------------
+
+pub const TpMutant = enum {
+    none,
+    drop_last_head, // the last rank's last query head is not computed
+    swap_kv_groups, // the last rank reads the first rank's kv group
+    ffn_overlap, // the last rank's FFN cut starts one row early
+    drop_exchange, // only rank 0's attention partial is added
+};
+
+/// blockForward as `world` ranks run it: kv groups, their query heads and FFN rows cut; partials added in rank order.
+pub fn blockForwardTp(d: *const ref.Draft, a: std.mem.Allocator, cx: *const ref.Ctx, anchor: usize, p: usize, world: usize, m: TpMutant) !ref.Block {
+    const c = d.cfg;
+    const sw = c.sw;
+    const hd = c.head_dim;
+    const kvw = c.kvw();
+    const nb = c.block;
+    const rep = c.rep();
+    const groups = c.n_kv / world;
+    const ffn_cut = c.ffn / world;
+    const h = try a.alloc(f64, nb * c.hidden);
+    for (0..nb) |i| {
+        const tok = if (i == 0) anchor else c.mask_token;
+        @memcpy(h[i * c.hidden ..][0..c.hidden], d.embed[tok * c.hidden ..][0..c.hidden]);
+    }
+    const x = try a.alloc(f64, c.hidden);
+    const scale = std.math.pow(f64, @floatFromInt(hd), -0.5);
+    for (d.layers, 0..) |ly, l| {
+        // attention: every rank computes its own heads for every row, then the partial o_proj sums are exchanged
+        const part = try a.alloc(f64, world * nb * c.hidden);
+        @memset(part, 0);
+        for (0..world) |r| {
+            var g0 = r * groups;
+            if (m == .swap_kv_groups and r == world - 1) g0 = 0;
+            const own_q0 = r * groups * rep; // the q heads this rank multiplies o_proj columns for
+            var nq = groups * rep;
+            if (m == .drop_last_head and r == world - 1) nq -= 1;
+            const q = try a.alloc(f64, nb * nq * hd);
+            const kb = try a.alloc(f64, nb * groups * hd);
+            const vb = try a.alloc(f64, nb * groups * hd);
+            for (0..nb) |i| {
+                ref.norm(c, h[i * c.hidden ..][0..c.hidden], ly.input_norm, sw.base.gemma_layer_norms, x);
+                const pos = if (sw.block_positions == .consecutive) p + i else p;
+                const qi = q[i * nq * hd ..][0 .. nq * hd];
+                ly.q.applyRows(own_q0 * hd, (own_q0 + nq) * hd, x, qi);
+                ly.k.applyRows(g0 * hd, (g0 + groups) * hd, x, kb[i * groups * hd ..][0 .. groups * hd]);
+                ly.v.applyRows(g0 * hd, (g0 + groups) * hd, x, vb[i * groups * hd ..][0 .. groups * hd]);
+                for ([_][]f64{ qi, kb[i * groups * hd ..][0 .. groups * hd], vb[i * groups * hd ..][0 .. groups * hd] }) |t| mr.roundAll(sw.base.bf16_proj_out, t);
+                ref.heads(c, qi, nq, ly.q_norm, pos);
+                ref.heads(c, kb[i * groups * hd ..][0 .. groups * hd], groups, ly.k_norm, pos);
+            }
+            const attn = try a.alloc(f64, nb * nq * hd);
+            for (0..nb) |i| {
+                const rp = if (sw.block_positions == .consecutive) p + i else p;
+                for (0..nq) |hh| {
+                    const g = hh / rep; // the rank-local kv group
+                    const qh = q[(i * nq + hh) * hd ..][0..hd];
+                    const total = cx.n + nb;
+                    const s = try a.alloc(f64, total);
+                    var best: f64 = -std.math.inf(f64);
+                    for (0..total) |j| {
+                        s[j] = -std.math.inf(f64);
+                        var key: []const f64 = undefined;
+                        if (j < cx.n) {
+                            if (!ref.sees(sw, c.window, cx.first + j, rp, p)) continue;
+                            key = cx.k[l][j * kvw + (g0 + g) * hd ..][0..hd];
+                        } else {
+                            const mm = j - cx.n;
+                            if (sw.block_attention == .causal and mm > i) continue;
+                            key = kb[mm * groups * hd + g * hd ..][0..hd];
+                        }
+                        var dot: f64 = 0;
+                        for (qh, key) |u, w| dot += u * w;
+                        s[j] = dot * scale;
+                        best = @max(best, s[j]);
+                    }
+                    var z: f64 = 0;
+                    const out = attn[(i * nq + hh) * hd ..][0..hd];
+                    @memset(out, 0);
+                    for (0..total) |j| {
+                        if (s[j] == -std.math.inf(f64)) continue;
+                        const w = @exp(s[j] - best);
+                        z += w;
+                        const val = if (j < cx.n) cx.v[l][j * kvw + (g0 + g) * hd ..][0..hd] else vb[(j - cx.n) * groups * hd + g * hd ..][0..hd];
+                        for (out, val) |*o, vv| o.* += w * vv;
+                    }
+                    for (out) |*o| o.* /= z;
+                }
+            }
+            mr.roundAll(sw.base.bf16_attn_out, attn);
+            for (0..nb) |i| ly.o.applyCols(own_q0 * hd, attn[i * nq * hd ..][0 .. nq * hd], part[(r * nb + i) * c.hidden ..][0..c.hidden]);
+        }
+        // exchange: partials added in rank order 0 then 1, every rank holds the same sum
+        for (0..nb) |i| {
+            const hi = h[i * c.hidden ..][0..c.hidden];
+            for (0..c.hidden) |e| {
+                var s: f64 = 0;
+                for (0..world) |r| {
+                    if (m == .drop_exchange and r != 0) continue;
+                    s += part[(r * nb + i) * c.hidden + e];
+                }
+                hi[e] = mr.round16(sw.base.bf16_residual, hi[e] + s);
+            }
+        }
+        // FFN
+        @memset(part, 0);
+        for (0..world) |r| {
+            var lo = r * ffn_cut;
+            if (m == .ffn_overlap and r == world - 1) lo -= 1;
+            const hi_row = (r + 1) * ffn_cut;
+            const g = try a.alloc(f64, hi_row - lo);
+            const u = try a.alloc(f64, hi_row - lo);
+            for (0..nb) |i| {
+                ref.norm(c, h[i * c.hidden ..][0..c.hidden], ly.post_norm, sw.base.gemma_layer_norms, x);
+                ly.gate.applyRows(lo, hi_row, x, g);
+                ly.up.applyRows(lo, hi_row, x, u);
+                for (g, u) |*gv, uv| gv.* = mr.round16(sw.base.bf16_act_out, mr.swigluoai(gv.*, uv, c.alpha, c.limit, sw.base));
+                ly.down.applyCols(lo, g, part[(r * nb + i) * c.hidden ..][0..c.hidden]);
+            }
+        }
+        for (0..nb) |i| {
+            const hi = h[i * c.hidden ..][0..c.hidden];
+            for (0..c.hidden) |e| {
+                var s: f64 = 0;
+                for (0..world) |r| s += part[(r * nb + i) * c.hidden + e];
+                hi[e] = mr.round16(sw.base.bf16_residual, hi[e] + s);
+            }
+        }
+    }
+    const post = try a.alloc(f64, nb * c.hidden);
+    for (0..nb) |i| ref.norm(c, h[i * c.hidden ..][0..c.hidden], d.final_norm, sw.gemma_final_norm, post[i * c.hidden ..][0..c.hidden]);
+    return .{ .pre = h, .post = post };
+}
+
+// ---- the head's per-rank candidates -----------------------------------------------------------------------------
+
+pub const GatherMutant = enum {
+    none,
+    drop_last_rank, // the last rank's candidates never arrive
+    ids_not_offset, // a rank's local candidate ids are not moved to global ids
+    first_lowest, // the merge keeps the first of equal values instead of the lowest id
+};
+
+/// One pick as the engine makes it: per-rank top `per` base logits gathered, Markov bias on the gathered ids only.
+pub fn gatherPick(d: *const ref.Draft, base: []const f64, prev: ?usize, world: usize, per: usize, m: GatherMutant, a: std.mem.Allocator) !usize {
+    const c = d.cfg;
+    const slice = c.vocab / world;
+    var ids: std.ArrayList(usize) = .empty;
+    defer ids.deinit(a);
+    for (0..world) |r| {
+        if (m == .drop_last_rank and r == world - 1) continue;
+        const lo = r * slice;
+        const taken = try a.alloc(bool, slice);
+        defer a.free(taken);
+        @memset(taken, false);
+        for (0..per) |_| {
+            var top: ?usize = null;
+            for (0..slice) |i| {
+                if (taken[i]) continue;
+                if (top == null or base[lo + i] > base[lo + top.?]) top = i;
+            }
+            taken[top.?] = true;
+            try ids.append(a, if (m == .ids_not_offset) top.? else lo + top.?);
+        }
+    }
+    var best: ?usize = null;
+    var bz: f64 = 0;
+    for (ids.items) |id| {
+        const z = base[id] + if (prev) |pv| ref.markovBias(d, pv, id) else 0;
+        const better = best == null or z > bz or (z == bz and m != .first_lowest and id < best.?);
+        if (better) {
+            best = id;
+            bz = z;
+        }
+    }
+    return best.?;
+}
diff --git a/zig/src/families/minimax_m3/dspark_weights.zig b/zig/src/families/minimax_m3/dspark_weights.zig
new file mode 100644
index 0000000..c99f800
--- /dev/null
+++ b/zig/src/families/minimax_m3/dspark_weights.zig
@@ -0,0 +1,208 @@
+//! The dspark draft's weights on one rank's device: the plan's slots streamed in, matrices and `fc` repacked for qmmf.
+const std = @import("std");
+const cuda = @import("cuda");
+const load = @import("load.zig");
+const shard = @import("shard.zig");
+const weights_device = @import("weights_device.zig");
+const dc = @import("dspark_config.zig");
+const dl = @import("dspark_load.zig");
+const dn = @import("dspark_names.zig");
+
+const qmmf = cuda.qmmf;
+const mxfp8 = cuda.mxfp8;
+
+/// One draft layer on this rank: its seven matrices packed for the lane matmul, its four small tensors as stored.
+pub const Layer = struct {
+    q: qmmf.Weight,
+    k: qmmf.Weight,
+    v: qmmf.Weight,
+    o: qmmf.Weight,
+    gate: qmmf.Weight,
+    up: qmmf.Weight,
+    down: qmmf.Weight,
+    input_ln: u64,
+    post_ln: u64,
+    q_norm: u64,
+    k_norm: u64,
+};
+
+pub const Model = struct {
+    gpa: std.mem.Allocator,
+    cfg: dc.Config,
+    layers: []Layer,
+    fc: qmmf.Weight,
+    hidden_norm: u64,
+    final_norm: u64,
+    markov_w1: u64,
+    markov_w2: u64,
+    conf_w: u64,
+    conf_b: u64,
+    bufs: []cuda.DeviceBuffer, // every allocation, for `deinit`
+    bytes: u64, // device bytes held
+
+    pub fn deinit(m: *Model) void {
+        for (m.bufs) |*b| b.free();
+        m.gpa.free(m.bufs);
+        m.gpa.free(m.layers);
+        m.* = undefined;
+    }
+
+    /// The matrix `proj` of layer `l`.
+    pub fn lin(m: *const Model, l: usize, p: dn.Lin) qmmf.Weight {
+        const ly = &m.layers[l];
+        return switch (p) {
+            .q => ly.q,
+            .k => ly.k,
+            .v => ly.v,
+            .o => ly.o,
+            .gate => ly.gate,
+            .up => ly.up,
+            .down => ly.down,
+        };
+    }
+};
+
+/// The sink onto per-slot device buffers (weights_device.zig's, which keeps its own private).
+const Upload = struct {
+    bufs: []const cuda.DeviceBuffer,
+    stream: cuda.Stream,
+    since: u64 = 0,
+
+    fn put(ctx: *anyopaque, slot: u32, offset: u64, bytes: []const u8) anyerror!void {
+        const u: *Upload = @ptrCast(@alignCast(ctx));
+        try u.bufs[slot].uploadAsync(@intCast(offset), bytes, u.stream.handle);
+        u.since += bytes.len;
+        if (u.since >= weights_device.sync_every) {
+            try u.stream.synchronize();
+            u.since = 0;
+        }
+    }
+};
+
+/// The load.Plan view of a draft plan: the streamer reads its slots and items (the draft has no EXL3 matrices).
+fn streamerPlan(p: *const dl.Plan) load.Plan {
+    return .{ .arena = std.heap.ArenaAllocator.init(std.heap.page_allocator), .share = p.share, .slots = p.slots, .items = p.items, .matrices = &.{}, .plain = &.{}, .moe = &.{}, .ignored = p.ignored };
+}
+
+/// Plans rank `share`'s part of the draft in `dir`, streams it to the device and repacks. `cat` is the draft folder's.
+pub fn loadModel(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, stream: cuda.Stream, dir: []const u8, cfg: *const dc.Config, share: shard.Share) !Model {
+    var cat = try load.Catalog.open(gpa, io, dir);
+    defer cat.deinit();
+    var plan = try dl.Plan.build(gpa, &cat, cfg, share, .{ .markov_cut = false });
+    defer plan.deinit();
+    const slots = try gpa.alloc(cuda.DeviceBuffer, plan.slots.len);
+    defer gpa.free(slots);
+    var made: usize = 0;
+    errdefer for (slots[0..made]) |*b| b.free();
+    for (plan.slots, slots) |s, *b| {
+        b.* = try cuda.DeviceBuffer.alloc(d, @intCast(s.bytes));
+        made += 1;
+    }
+    var up: Upload = .{ .bufs = slots, .stream = stream };
+    var drop: weights_device.CacheDrop = .{ .cat = &cat };
+    const sp = streamerPlan(&plan);
+    try weights_device.feed(gpa, &cat, &sp, .{ .ctx = &up, .put = Upload.put }, drop.hook());
+    try stream.synchronize();
+
+    // what stays: the bf16 tensors' slots; what is repacked: the matrices' (their raw slots are freed once packed)
+    var keep: std.ArrayList(cuda.DeviceBuffer) = .empty;
+    errdefer {
+        for (keep.items) |*b| b.free();
+        keep.deinit(gpa);
+    }
+    const raw_used = try gpa.alloc(bool, slots.len);
+    defer gpa.free(raw_used);
+    @memset(raw_used, false);
+
+    var out: Model = .{ .gpa = gpa, .cfg = cfg.*, .layers = &.{}, .fc = undefined, .hidden_norm = 0, .final_norm = 0, .markov_w1 = 0, .markov_w2 = 0, .conf_w = 0, .conf_b = 0, .bufs = &.{}, .bytes = 0 };
+    out.layers = try gpa.alloc(Layer, cfg.layers);
+    errdefer gpa.free(out.layers);
+
+    // plain tensors keep their slot buffers
+    const T = struct {
+        fn ptr(pl: *const dl.Plan, sl: []cuda.DeviceBuffer, used: []bool, role: dn.Plain, layer: u32) !u64 {
+            const t = pl.tensor(role, layer) orelse return error.MissingTensor;
+            used[t.slot] = true;
+            return sl[t.slot].ptr;
+        }
+    };
+    out.hidden_norm = try T.ptr(&plan, slots, raw_used, .hidden_norm, 0);
+    out.final_norm = try T.ptr(&plan, slots, raw_used, .final_norm, 0);
+    out.markov_w1 = try T.ptr(&plan, slots, raw_used, .markov_w1, 0);
+    out.markov_w2 = try T.ptr(&plan, slots, raw_used, .markov_w2, 0);
+    out.conf_w = try T.ptr(&plan, slots, raw_used, .conf_w, 0);
+    out.conf_b = try T.ptr(&plan, slots, raw_used, .conf_b, 0);
+    for (out.layers, 0..) |*ly, l| {
+        ly.input_ln = try T.ptr(&plan, slots, raw_used, .input_ln, @intCast(l));
+        ly.post_ln = try T.ptr(&plan, slots, raw_used, .post_ln, @intCast(l));
+        ly.q_norm = try T.ptr(&plan, slots, raw_used, .q_norm, @intCast(l));
+        ly.k_norm = try T.ptr(&plan, slots, raw_used, .k_norm, @intCast(l));
+    }
+
+    // fc: bf16 [hidden, n_taps x hidden] packed in the lane matmul's bf16 order
+    {
+        const t = plan.tensor(.fc, 0) orelse return error.MissingTensor;
+        const n: usize = t.rows;
+        const k: usize = t.cols;
+        const raw = try gpa.alloc(u16, n * k);
+        defer gpa.free(raw);
+        try slots[t.slot].download(0, std.mem.sliceAsBytes(raw));
+        const packed_ = try gpa.alloc(u16, mxfp8.padded(n) * k);
+        defer gpa.free(packed_);
+        qmmf.packBf16(packed_, raw, n, k);
+        const b = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(packed_));
+        try keep.append(gpa, b);
+        out.fc = .{ .mode = .bf16, .codes = b.ptr, .scales = 0, .n = @intCast(n), .k = @intCast(k), .npad = @intCast(mxfp8.padded(n)) };
+        raw_used[t.slot] = false;
+    }
+
+    // the mxfp8 matrices
+    for (out.layers, 0..) |*ly, l| {
+        inline for (.{ .{ "q", dn.Lin.q }, .{ "k", dn.Lin.k }, .{ "v", dn.Lin.v }, .{ "o", dn.Lin.o }, .{ "gate", dn.Lin.gate }, .{ "up", dn.Lin.up }, .{ "down", dn.Lin.down } }) |pair| {
+            const m = plan.mat(pair[1], @intCast(l)) orelse return error.MissingTensor;
+            const n: usize = m.n;
+            const k: usize = m.k;
+            if (k % qmmf.group != 0) return error.BadShape;
+            const codes = try gpa.alloc(u8, n * k);
+            defer gpa.free(codes);
+            const scales = try gpa.alloc(u8, n * (k / mxfp8.group));
+            defer gpa.free(scales);
+            try slots[m.codes].download(0, codes);
+            try slots[m.scales].download(0, scales);
+            const pc = try gpa.alloc(u8, mxfp8.padded(n) * k);
+            defer gpa.free(pc);
+            const ps = try gpa.alloc(u8, mxfp8.padded(n) * (k / mxfp8.group));
+            defer gpa.free(ps);
+            mxfp8.packCodes(pc, codes, n, k);
+            mxfp8.packScales(ps, scales, n, k);
+            const bc = try cuda.DeviceBuffer.fromHost(d, pc);
+            try keep.append(gpa, bc);
+            const bs = try cuda.DeviceBuffer.fromHost(d, ps);
+            try keep.append(gpa, bs);
+            @field(ly, pair[0]) = mxfp8.weight(bc.ptr, bs.ptr, n, k);
+        }
+    }
+    // the raw slots of matrices and fc are done with; the bf16 tensors' slots stay
+    try keep.ensureUnusedCapacity(gpa, slots.len);
+    made = 0;
+    for (slots, raw_used) |*b, used| {
+        if (used) keep.appendAssumeCapacity(b.*) else b.free();
+    }
+    var total: u64 = 0;
+    for (keep.items) |b| total += b.len;
+    out.bufs = try keep.toOwnedSlice(gpa);
+    out.bytes = total;
+    return out;
+}
+
+test "the packed forms: every matrix of a layer has the lane matmul's alignment" {
+    // n is a multiple of 128 (padded rows) and k of 64 for the shipped shapes, on both ranks
+    const c = dc.flash;
+    for ([_]usize{ 0, 1 }) |r| {
+        const s = try shard.Share.of(&@import("config.zig").flash, r, 2);
+        const q = s.q_heads.len() * c.head_dim;
+        const kv = s.kv_heads.len() * c.head_dim;
+        for ([_]usize{ q, kv, s.dense.len(), c.hidden }) |n| try std.testing.expectEqual(@as(usize, 0), n % 128);
+        for ([_]usize{ c.hidden, q, s.dense.len(), c.fcIn() }) |k| try std.testing.expectEqual(@as(usize, 0), k % qmmf.group);
+    }
+}
diff --git a/zig/src/families/minimax_m3/engine.zig b/zig/src/families/minimax_m3/engine.zig
new file mode 100644
index 0000000..3dfca19
--- /dev/null
+++ b/zig/src/families/minimax_m3/engine.zig
@@ -0,0 +1,362 @@
+//! One TP rank's MiniMax-M3.1-Flash engine: slots over the pooled KV pages, chunked prompts, windows and draws.
+const std = @import("std");
+const cuda = @import("cuda");
+const iface = @import("iface.zig");
+const pool = @import("pool.zig");
+const ops_ = @import("engine_ops.zig");
+
+pub const Sampling = iface.Sampling;
+pub const Part = iface.Part;
+pub const Resume = iface.Resume;
+pub const Marks = iface.Marks;
+pub const Cancel = iface.Cancel;
+
+/// A draft ring step: save the bound slot's ring as snapshot `id`, restore it, drop `id`, or empty the slot's ring.
+pub const SnapOp = enum(u32) { save = 1, restore = 2, drop = 3, reset = 4 };
+pub const prefill_rows = iface.prefill_rows;
+pub const window_rows = iface.window_rows;
+pub const shared_rows = iface.shared_rows;
+pub const max_shared = iface.max_shared;
+
+/// The request's rule as the engine runs it: null (or temperature 0) decodes greedily.
+pub fn check(s: ?Sampling) ?Sampling {
+    const x = s orelse return null;
+    return if (x.temperature > 0) x else null;
+}
+
+/// A stream's sequence on the engine: how it draws, the committed rows, and the rows its last window left uncommitted.
+pub const Seq = struct { sampling: ?Sampling = null, pos: usize = 0, pending: usize = 0 };
+
+/// Everything an engine runs on; engine_dev.zig fills it from the device, the host tests from fakes.
+pub const Parts = struct {
+    ops: ops_.Ops,
+    device: ops_.Device,
+    comm: ops_.Comm,
+    drawer: ops_.Drawer,
+    capacity: usize,
+    page_bytes: u64,
+    checkpoint_digest: [32]u8 = @splat(0),
+    stream: ?cuda.Stream = null, // the engine's stream (the host opens the RoCE gather on it)
+    group: ?*cuda.tp_group.Group = null, // the group the forward holds: the host's RoCE small gather goes into it
+    close: ?Closer = null,
+    draft: ?ops_.Draft = null, // the dspark draft (--drafter): its rings, block pass and results; the forward taps for it
+};
+
+/// Frees what an engine's parts own (device buffers, the communicator, the forward's buffers) at `deinit`.
+pub const Closer = struct { ptr: *anyopaque, call: *const fn (ptr: *anyopaque) void };
+
+/// Where a prompt pass's chunk starting at `start` of a `len`-id prompt ends: a chunk's rows, or the next mark.
+pub fn chunkEnd(start: usize, len: usize, marks: ?Marks) usize {
+    var end = @min(len, start + prefill_rows);
+    if (marks) |m| for (m.at) |at| {
+        if (at > start and at < end) {
+            end = at;
+            break;
+        }
+    };
+    return end;
+}
+
+pub const Engine = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    p: Parts,
+    rank: usize,
+    world: usize,
+    capacity: usize,
+    max_pages: usize,
+    seqs: std.ArrayList(Seq) = .empty,
+    slot: u32 = 0,
+    view: ?ops_.PoolView = null,
+    last_rows: [3]usize = @splat(0), // rows of the last pass of each kind: the gathered logits' rank stride
+    checkpoint_digest: [32]u8,
+
+    /// The engine over `parts` with the one sequence a block table starts with (slot 0); `attach` makes the pool.
+    pub fn make(gpa: std.mem.Allocator, io: std.Io, parts: Parts) !*Engine {
+        const e = try gpa.create(Engine);
+        errdefer gpa.destroy(e);
+        e.* = .{ .gpa = gpa, .io = io, .p = parts, .rank = parts.comm.rank, .world = parts.comm.world, .capacity = parts.capacity, .max_pages = iface.maxPages(parts.capacity), .checkpoint_digest = parts.checkpoint_digest };
+        try e.seqs.append(gpa, .{});
+        return e;
+    }
+
+    /// The host opened the RoCE small gather on its group: the forward and the failure check use it from now on.
+    pub fn setGroup(e: *Engine, g: *const cuda.tp_group.Group) void {
+        if (e.p.group) |own| own.fast = g.fast;
+    }
+
+    /// Rank 0's `Tables.upload`: its block-table pushes reach the device on the engine's stream.
+    pub fn uploadHook(e: *Engine) pool.Upload {
+        return .{ .ctx = e, .call = uploadFn };
+    }
+
+    fn uploadFn(ctx: *anyopaque, slot: u32, from: usize, entries: []const i32) anyerror!void {
+        const e: *Engine = @ptrCast(@alignCast(ctx));
+        return e.upload(slot, from, entries);
+    }
+
+    /// The production constructor (iface.conformsEngine's `init`): weights, agreed fingerprint, forward, device.
+    pub const init = @import("engine_dev.zig").init;
+
+    pub fn deinit(e: *Engine) void {
+        e.p.ops.sync() catch {};
+        if (e.p.close) |c| c.call(c.ptr);
+        e.seqs.deinit(e.gpa);
+        e.gpa.destroy(e);
+    }
+
+    /// The pool of `slots` streams and `pages` pages, made now on this rank (rank 0 tells the others first).
+    pub fn attach(e: *Engine, slots: u32, pages: usize) !void {
+        const view = try e.p.device.vtable.attach(e.p.device.ptr, slots, pages, e.max_pages, e.p.page_bytes);
+        try e.p.ops.attach(view);
+        if (e.p.draft) |d| try d.attach(slots);
+        e.view = view;
+        while (e.seqs.items.len < slots) try e.seqs.append(e.gpa, .{});
+    }
+
+    /// `entries` of `slot`'s table row from entry `from` to the device (also rank 0's `Tables.upload`).
+    pub fn upload(e: *Engine, slot: u32, from: usize, entries: []const i32) !void {
+        return e.p.device.vtable.upload(e.p.device.ptr, slot, from, entries);
+    }
+
+    /// Page ids `ids` at entry `from` of `slot`'s table row, as rank 0 decided them.
+    pub fn setPages(e: *Engine, slot: u32, from: usize, ids: []const u32) !void {
+        if (from + ids.len > e.max_pages) return error.TableFull;
+        var buf: [256]i32 = undefined;
+        var at: usize = 0;
+        while (at < ids.len) {
+            const n = @min(buf.len, ids.len - at);
+            for (buf[0..n], ids[at..][0..n]) |*d, id| d.* = @intCast(id);
+            try e.upload(slot, from + at, buf[0..n]);
+            at += n;
+        }
+    }
+
+    /// Slot `slot`'s table row back to -1.
+    pub fn clearRow(e: *Engine, slot: u32) !void {
+        const row = try e.gpa.alloc(i32, e.max_pages);
+        defer e.gpa.free(row);
+        @memset(row, -1);
+        try e.upload(slot, 0, row);
+    }
+
+    /// Binds slot `slot` for the steps that follow.
+    pub fn bind(e: *Engine, slot: u32) !void {
+        if (slot >= e.seqs.items.len) return error.BadSlot;
+        e.slot = slot;
+    }
+
+    /// Frees slot `slot`'s sequence (its pages are rank 0's to return) and clears its table row.
+    pub fn release(e: *Engine, slot: u32) void {
+        if (slot >= e.seqs.items.len) return;
+        e.seqs.items[slot] = .{};
+        if (e.p.draft) |d| if (e.view != null) d.begin(slot);
+        if (e.view != null) e.clearRow(slot) catch |err| std.log.err("clearing slot {d}'s block table: {s}", .{ slot, @errorName(err) });
+    }
+
+    /// Bytes a stream holds beyond its pages: its block-table row.
+    pub fn seqBytes(e: *const Engine) u64 {
+        return pool.Dims.tableBytes(e.max_pages);
+    }
+
+    fn cur(e: *Engine) *Seq {
+        return &e.seqs.items[e.slot];
+    }
+
+    /// The committed length of the bound sequence: the pending token sits here, row r of a window draws pos + 1 + r.
+    pub fn pos(e: *const Engine) usize {
+        return e.seqs.items[e.slot].pos;
+    }
+
+    /// A follower's begin (no image rows exist here to clear).
+    pub fn beginFollowing(e: *Engine, sampling: ?Sampling) !void {
+        return e.begin(sampling);
+    }
+
+    /// A fresh sequence on the bound slot with `sampling` (null or temperature 0: greedy).
+    pub fn begin(e: *Engine, sampling: ?Sampling) !void {
+        e.cur().* = .{ .sampling = check(sampling) };
+    }
+
+    /// The whole prompt in chunks (a mark cuts one), then the first token; `from` resumes adopted pages.
+    pub fn prefill(e: *Engine, ids: []const u32, from: ?Resume, cancel: ?Cancel, marks: ?Marks) !u32 {
+        var start = try e.prefillStart(ids.len, from);
+        while (true) {
+            const end = chunkEnd(start, ids.len, marks);
+            if (try e.prefillChunk(ids[start..end], start, ids.len, if (start == (if (from) |r| r.at else 0)) from else null, cancel, marks)) |first| return first;
+            start = end;
+        }
+    }
+
+    /// Where a prompt pass of `len` ids starts: 0, or the rows already in the adopted pages.
+    fn prefillStart(e: *Engine, len: usize, from: ?Resume) !usize {
+        if (len == 0 or len + window_rows >= e.capacity) return error.PromptTooLong;
+        const r = from orelse return 0;
+        if (r.at == 0 or r.at >= len or r.at % pool.page_tokens != 0) return error.BadResume;
+        return r.at;
+    }
+
+    /// One chunk `part` = ids[start..] of a `len`-id prompt; the first token once it ends the prompt, else null.
+    pub fn prefillChunk(e: *Engine, part: []const u32, start: usize, len: usize, from: ?Resume, cancel: ?Cancel, marks: ?Marks) !?u32 {
+        const begun = try e.prefillStart(len, from);
+        if (from != null) {
+            if (begun != start) return error.BadChunk;
+            e.cur().pos = start; // the rows before it are in the adopted pages
+        }
+        const rows = part.len;
+        const s = e.cur();
+        if (start >= len or start % pool.page_tokens != 0 or rows == 0 or rows > prefill_rows or start + rows > len) return error.BadChunk;
+        if (start + rows < len and rows % pool.page_tokens != 0) return error.BadChunk; // the next chunk starts on a page
+        if (s.pos != start) return error.BadChunk;
+        if (marks) |m| if (start > 0 and std.mem.indexOfScalar(u32, m.at, @intCast(start)) != null) m.call(m.ctx, @intCast(start));
+        try e.gate(cancel);
+        const segs = [1]iface.Seg{.{ .slot = e.slot, .row0 = 0, .rows = @intCast(rows) }};
+        try e.p.ops.run(.{ .kind = .prompt, .ids = part, .segs = &segs, .starts = &.{@intCast(start)}, .head = start + rows == len });
+        s.pos = start + rows;
+        if (start + rows < len) return null;
+        // the prompt's last row is what the first draft starts from: keep its tap where no other forward writes
+        if (e.p.draft != null) try e.p.ops.tapCopy(@intCast(rows - 1), iface.tapWindowRow(e.slot));
+        var t: [1]u32 = undefined;
+        e.last_rows[@backingInt(ops_.Rows.prompt)] = 1; // only the last row of the chunk goes through the head
+        try e.drawPass(.prompt, 0, 1, len, 0, &t);
+        return t[0];
+    }
+
+    /// The chunk gate on every rank: rank 0's cancel decides for all, so no rank enters a forward the others skip.
+    pub fn gate(e: *Engine, cancel: ?Cancel) !void {
+        const mine: f64 = if (cancel) |c| @floatFromInt(@intFromBool(c.check(c.ptr))) else 0;
+        if (try e.p.comm.maxF64(mine) > 0) return error.Cancelled;
+    }
+
+    /// A verify window: `ids` (pending token, then drafts) at the committed position; `out[r]` drawn at pos + 1 + r.
+    pub fn verify(e: *Engine, ids: []const u32, out: []u32, bits: u64) !void {
+        if (ids.len == 0 or ids.len > window_rows or out.len < ids.len) return error.WindowTooWide;
+        const s = e.cur();
+        if (s.pos + ids.len >= e.capacity) return error.ContextFull;
+        const segs = [1]iface.Seg{.{ .slot = e.slot, .row0 = 0, .rows = @intCast(ids.len) }};
+        try e.p.ops.run(.{ .kind = .window, .ids = ids, .segs = &segs, .starts = &.{@intCast(s.pos)} });
+        s.pending = ids.len;
+        e.last_rows[@backingInt(ops_.Rows.window)] = ids.len;
+        try e.drawPass(.window, 0, ids.len, s.pos + 1, bits, out);
+    }
+
+    /// Several streams' windows in one forward: row ops are shared, attention reads each stream's own pages.
+    pub fn verifyShared(e: *Engine, parts: []const Part) !void {
+        if (parts.len == 0 or parts.len > max_shared) return error.WindowTooWide;
+        var segs: [max_shared]iface.Seg = undefined;
+        var starts: [max_shared]u32 = undefined;
+        var ids: [shared_rows]u32 = undefined;
+        var rows: usize = 0;
+        for (parts, 0..) |p, i| {
+            if (p.ids.len == 0 or p.ids.len > window_rows or rows + p.ids.len > shared_rows or p.out.len < p.ids.len) return error.WindowTooWide;
+            for (parts[0..i]) |q| if (q.slot == p.slot) return error.SlotTwice;
+            if (p.slot >= e.seqs.items.len) return error.BadSlot;
+            const s = e.seqs.items[p.slot];
+            if (s.pos + p.ids.len >= e.capacity) return error.ContextFull;
+            segs[i] = .{ .slot = p.slot, .row0 = @intCast(rows), .rows = @intCast(p.ids.len) };
+            starts[i] = @intCast(s.pos);
+            @memcpy(ids[rows..][0..p.ids.len], p.ids);
+            rows += p.ids.len;
+        }
+        try e.p.ops.run(.{ .kind = .shared, .ids = ids[0..rows], .segs = segs[0..parts.len], .starts = starts[0..parts.len] });
+        e.last_rows[@backingInt(ops_.Rows.shared)] = rows;
+        for (parts, segs[0..parts.len]) |p, g| {
+            try e.bind(p.slot);
+            e.cur().pending = p.ids.len;
+            try e.drawPass(.shared, g.row0, g.rows, e.cur().pos + 1, p.bits, p.out);
+        }
+    }
+
+    /// Commits the first `n` rows of the last window (the rest were rejected drafts; their KV rows are overwritten).
+    pub fn keep(e: *Engine, n: usize) !void {
+        const s = e.cur();
+        if (n > s.pending) return error.BadKeep;
+        s.pos += n;
+        s.pending = 0;
+    }
+
+    /// Rows [row0, row0 + rows) of the last pass of `kind` drawn at positions first, first + 1, ... (rank 0 draws).
+    fn drawPass(e: *Engine, kind: ops_.Rows, row0: usize, rows: usize, first: u64, bits: u64, out: []u32) !void {
+        if (rows == 0) return;
+        const base = e.p.ops.logits(kind);
+        try e.p.drawer.draw(.{ .base = base, .total = e.last_rows[@backingInt(kind)], .row0 = row0, .rows = rows, .first = first, .rule = e.cur().sampling, .bits = bits, .out = out });
+        return e.checkGathers(); // the draw read rows the forward's gathers made
+    }
+
+    /// The contract's draw: `rows` gathered rows at `logits` (a whole pass) drawn at positions first, first + 1, ...
+    pub fn draw(e: *Engine, logits: u64, rows: usize, first: u64, bits: u64, out: []u32) !void {
+        if (rows == 0) return;
+        try e.p.drawer.draw(.{ .base = logits, .total = rows, .row0 = 0, .rows = rows, .first = first, .rule = e.cur().sampling, .bits = bits, .out = out });
+        return e.checkGathers();
+    }
+
+    /// A failed RoCE gather's error, after a synchronize whose result read gathered rows.
+    pub fn checkGathers(e: *const Engine) !void {
+        return e.p.comm.check();
+    }
+
+    pub fn sync(e: *Engine) !void {
+        return e.p.ops.sync();
+    }
+
+    /// Whether this engine runs the dspark draft (its forwards tap).
+    pub fn drafting(e: *const Engine) bool {
+        return e.p.draft != null;
+    }
+
+    /// The bound stream's positions start ... start + rows - 1 are tap rows [row, row + rows): into its draft ring.
+    pub fn absorb(e: *Engine, start: usize, rows: usize, row: usize) !void {
+        const d = e.p.draft orelse return error.NoDraft;
+        if (rows == 0 or start + rows > e.capacity or row + rows > iface.tapRows(@intCast(e.seqs.items.len))) return error.BadAbsorb;
+        try d.absorb(e.slot, @intCast(start), @intCast(rows), e.p.ops.tapsBase(), @intCast(row));
+    }
+
+    /// One block pass for the bound stream: `anchor` is its pending token at position `at` (the committed length).
+    pub fn draftPass(e: *Engine, anchor: u32, at: usize) !void {
+        const d = e.p.draft orelse return error.NoDraft;
+        if (at >= e.capacity) return error.ContextFull;
+        try d.pass(.{ .slot = e.slot, .anchor = anchor, .pos = @intCast(at) });
+    }
+
+    /// The bound stream's last pass, waited for.
+    pub fn draftResult(e: *Engine, out: *ops_.DraftResult) !void {
+        const d = e.p.draft orelse return error.NoDraft;
+        try d.result(e.slot, out);
+        return e.checkGathers();
+    }
+
+    /// The bound stream's ring saved as snapshot `id`, restored from it, or `id` dropped.
+    pub fn draftSnap(e: *Engine, what: SnapOp, id: u32) !void {
+        const d = e.p.draft orelse return;
+        switch (what) {
+            .save => try d.snapSave(e.slot, id),
+            .restore => try d.snapRestore(e.slot, id),
+            .drop => d.snapDrop(id),
+            .reset => d.begin(e.slot),
+        }
+    }
+};
+
+comptime {
+    iface.conformsEngine(Engine);
+}
+
+test "a chunk ends at the pass's chunk rows, at a mark, or at the prompt's end" {
+    try std.testing.expectEqual(@as(usize, 2048), chunkEnd(0, 5000, null));
+    try std.testing.expectEqual(@as(usize, 100), chunkEnd(0, 100, null));
+    const Hook = struct {
+        fn call(_: *anyopaque, _: u32) void {}
+    };
+    var x: u8 = 0;
+    const m: Marks = .{ .at = &.{ 512, 1024, 4096 }, .ctx = &x, .call = Hook.call };
+    try std.testing.expectEqual(@as(usize, 512), chunkEnd(0, 5000, m));
+    try std.testing.expectEqual(@as(usize, 1024), chunkEnd(512, 5000, m));
+    try std.testing.expectEqual(@as(usize, 3072), chunkEnd(1024, 5000, m));
+    try std.testing.expectEqual(@as(usize, 4096), chunkEnd(3072, 5000, m));
+    try std.testing.expectEqual(@as(usize, 5000), chunkEnd(4096, 5000, m));
+}
+
+test "temperature 0 is greedy" {
+    try std.testing.expectEqual(@as(?Sampling, null), check(.{ .seed = 1, .temperature = 0 }));
+    try std.testing.expect(check(.{ .seed = 1, .temperature = 0.5 }) != null);
+}
