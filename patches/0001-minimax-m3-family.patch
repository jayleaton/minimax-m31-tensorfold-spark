+//! MiniMax-M3.1-Flash row kernels under the contract on CUDA (run on spark2, GB10 sm_121).
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const rows_ = contract.rows;
+const Dense = contract.dense.Dense;
+const mr = core.minimax_ref;
+const rk = cuda.minimax_m3_rows;
+const geom = rk.geom;
+
+const experts = 128;
+const hidden = 6144;
+
+fn chain(s: c.Shape) usize {
+    return s.k / 128 + 3 + 5;
+}
+
+pub const Form = enum { bf16, f32 };
+
+pub fn routerSpec(f: Form) c.Spec {
+    return .{
+        .name = if (f == .bf16) "cuda minimax_m3_rows tf_mm3_router_bf16" else "cuda minimax_m3_rows tf_mm3_router_f32",
+        .accum = .f32,
+        .depth = chain,
+        .out = .f32,
+        .replaces = if (f == .f32) "tf_mm3_router_bf16" else null,
+        // 4 rows a warp, 4 experts a block, 128 values a step of the reduction
+        .tiles = .{ .{ .size = geom.router_rows }, .{ .size = geom.router_warps, .step = 1, .min = 1 }, .{ .size = geom.router_chunk, .step = geom.router_chunk, .min = geom.router_chunk } },
+        .served = &.{ .{ .rows = 1, .n = experts, .k = hidden }, .{ .rows = 5, .n = experts, .k = hidden }, .{ .rows = 17, .n = experts, .k = hidden }, .{ .rows = 64, .n = experts, .k = hidden } },
+    };
+}
+
+pub const Logits = struct {
+    rig: rig_.Rig,
+    form: Form,
+    k: *const rk.Rows,
+    d: ?Dense = null,
+    x: u64 = 0,
+    w: u64 = 0,
+    base: u64 = 0,
+    out: u64 = 0,
+
+    pub fn deinit(self: *Logits) void {
+        if (self.d) |d| d.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Logits) g.Kernel {
+        return .{ .spec = routerSpec(self.form), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Logits);
+
+    pub fn prepare(self: *Logits, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (self.d) |d| d.deinit();
+        self.d = null;
+        self.rig.reset();
+        if (shape.rows == 0 or shape.n == 0 or shape.k == 0 or shape.k % geom.router_chunk != 0) return false;
+        const a = self.rig.gpu.gpa;
+        const d = try Dense.init(a, shape, 1);
+        self.d = d;
+        d.fillX(fill, seed, 1);
+        const w = try a.alloc(f32, shape.n * shape.k);
+        defer a.free(w);
+        var prng = std.Random.DefaultPrng.init(seed ^ 0x6d6d3372);
+        const rng = prng.random();
+        const k = shape.k;
+        for (0..shape.n) |j| for (0..k) |i| {
+            // gate 4: integers mirrored into the second half, so fp32 sums are exact in any order
+            const v: f32 = if (fill != .stress) (rng.float(f32) - 0.5) * 0.1 else if (i < k / 2) @floatFromInt(1 + rng.uintLessThan(u32, 7)) else -w[j * k + i - k / 2];
+            w[j * k + i] = v;
+            d.w[j * k + i] = v;
+        };
+        if (self.form == .f32) {
+            const xf = try a.alloc(f32, d.x.len);
+            defer a.free(xf);
+            for (xf, d.x) |*o, h| o.* = c.fromBf16(h);
+            self.x = try self.rig.input(std.mem.sliceAsBytes(xf));
+        } else self.x = try self.rig.input(std.mem.sliceAsBytes(d.x));
+        self.w = try self.rig.input(std.mem.sliceAsBytes(w));
+        self.out = try self.rig.output(shape.rows * shape.n * 4);
+        if (self.form == .f32) self.base = try self.rig.scratch(shape.rows * shape.n * 4);
+        return true;
+    }
+
+    fn launch(self: *Logits, x_f32: bool, x: u64, out: u64) !void {
+        const sh = self.d.?.shape;
+        try self.k.routerLogits(self.rig.s, .{ .experts = @intCast(sh.n), .k = @intCast(sh.k) }, x, sh.k, x_f32, self.w, out, sh.rows);
+    }
+
+    pub fn run(self: *Logits) !void {
+        try self.launch(self.form == .f32, self.x, self.out);
+        try self.rig.s.synchronize();
+    }
+
+    /// The bf16 form on the same values.
+    pub fn replaced(self: *Logits) ![]const u8 {
+        const d = self.d.?;
+        const xb = try self.rig.gpu.gpa.alloc(u8, d.x.len * 2);
+        defer self.rig.gpu.gpa.free(xb);
+        @memcpy(xb, std.mem.sliceAsBytes(d.x));
+        const dev = try self.rig.scratch(xb.len);
+        const b: cuda.DeviceBuffer = .{ .d = self.rig.gpu.d, .ptr = dev, .len = xb.len };
+        try b.upload(0, xb);
+        try self.launch(false, dev, self.base);
+        return self.rig.bytes(self.base, self.count() * 4);
+    }
+
+    pub fn count(self: *Logits) usize {
+        return self.d.?.outputs();
+    }
+
+    pub fn reference(self: *Logits, want: []f64, mag: []f64) !void {
+        return self.d.?.reference(want, mag);
+    }
+
+    pub fn simulate(self: *Logits, acc: c.Accum, order: g.Order, out: []f64) !void {
+        return self.d.?.simulate(acc, order, out);
+    }
+};
+
+const nq = 32;
+const niq = 2;
+const kvh = 2;
+
+/// The test pool: one layer of the bf16 layout, or of the fp8 layout (K and V as e4m3 rows with an fp32 scale each).
+fn poolOf(kv8: bool) cuda.minimax_m3_sparse.geom.Pool {
+    return .{ .kvh = kvh, .layers = 1, .kv8 = kv8 };
+}
+
+/// A decode window (positions given) or a prompt chunk (positions k, k + 1, ...); `kv8` writes the fp8 pool.
+pub const Cfg = struct { name: []const u8, prompt: bool, kv8: bool = false };
+
+pub const cfgs = [_]Cfg{
+    .{ .name = "cuda minimax_m3_rows tf_mm3_rows decode, 32 q + 2 index heads, 2 kv heads, paged", .prompt = false },
+    .{ .name = "cuda minimax_m3_rows tf_mm3_rows prompt chunk, 32 q + 2 index heads, 2 kv heads, paged", .prompt = true },
+    .{ .name = "cuda minimax_m3_rows tf_mm3_rows decode, fp8 K/V pages (kv8), 32 q + 2 index heads, 2 kv heads, paged", .prompt = false, .kv8 = true },
+    .{ .name = "cuda minimax_m3_rows tf_mm3_rows prompt chunk, fp8 K/V pages (kv8), 32 q + 2 index heads, 2 kv heads, paged", .prompt = true, .kv8 = true },
+};
+
+fn normDepth(_: c.Shape) usize {
+    return 4 + 5 + 3;
+}
+
+pub fn rowsSpec(f: Cfg) c.Spec {
+    return .{
+        .name = f.name,
+        .accum = .f32,
+        .depth = normDepth,
+        // div, sqrt, add, div, two products, the rotation's three, the weight add
+        .ops = 14,
+        .out = .bf16,
+        // rows, q heads, and the positions' bound (the last row's position + 1): edges at a page boundary
+        .tiles = .{ .{}, .{}, .{ .size = geom.block, .min = 1 } },
+        .served = &.{ .{ .rows = 8, .n = nq, .k = 3000 }, .{ .rows = 5, .n = nq, .k = 129 }, .{ .rows = 16, .n = nq, .k = 128 }, .{ .rows = 6, .n = nq, .k = 1_000_003 } },
+        .sums = .{ .f16 = 0, .bf16 = 0, .why = "a norm's sum of squares is not a dot the fp16 and bf16 accumulators can be made to miss" },
+    };
+}
+
+pub const Writer = struct {
+    rig: rig_.Rig,
+    f: Cfg,
+    k: *const rk.Rows,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    arena: std.heap.ArenaAllocator,
+    pos: []i32 = &.{},
+    table: []i32 = &.{},
+    /// Decode: row r's table starts at r * blocks, so rows at one position own distinct pages; none for a prompt chunk.
+    row_tab: []i32 = &.{},
+    blocks: usize = 0,
+    q: []u16 = &.{},
+    kk: []u16 = &.{},
+    vv: []u16 = &.{},
+    iq: []u16 = &.{},
+    ik: []u16 = &.{},
+    w: [4][128]f32 = undefined,
+    dev: [13]u64 = @splat(0),
+    pages: usize = 0,
+
+    pub fn deinit(self: *Writer) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Writer) g.Kernel {
+        return .{ .spec = rowsSpec(self.f), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Writer);
+
+    fn fp16(v: f32) u16 {
+        const h: f16 = @floatCast(v);
+        return @bitCast(h);
+    }
+
+    fn fp16v(h: u16) f32 {
+        const x: f16 = @bitCast(h);
+        return x;
+    }
+
+    pub fn prepare(self: *Writer, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.n != nq or shape.rows == 0 or shape.k == 0 or shape.k + shape.rows > 1_100_000) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        const n = shape.rows;
+        self.pos = try a.alloc(i32, n);
+        for (self.pos, 0..) |*p, i| p.* = @intCast(if (self.f.prompt) shape.k + i else if (i == n - 1) shape.k - 1 else (i * 7919) % shape.k);
+        // Prompt chunk: one stream, shuffled page ids. Decode: a stream a row (row_tab), as positions repeat at k 1.
+        var lo: usize = std.math.maxInt(usize);
+        var hi: usize = 0;
+        for (self.pos) |p| {
+            lo = @min(lo, @as(usize, @intCast(p)) / geom.block);
+            hi = @max(hi, @as(usize, @intCast(p)) / geom.block);
+        }
+        const blocks = hi + 1;
+        self.blocks = blocks;
+        if (self.f.prompt) {
+            self.pages = (hi - lo + 1) + 2;
+            self.table = try a.alloc(i32, blocks);
+            self.row_tab = &.{};
+            @memset(self.table, -1);
+            const perm = try a.alloc(i32, self.pages);
+            for (perm, 0..) |*x, i| x.* = @intCast(i);
+            rng.shuffle(i32, perm);
+            for (lo..blocks) |b| self.table[b] = perm[b - lo];
+        } else {
+            self.pages = n + 2;
+            self.table = try a.alloc(i32, n * blocks);
+            self.row_tab = try a.alloc(i32, n);
+            @memset(self.table, -1);
+            const perm = try a.alloc(i32, self.pages);
+            for (perm, 0..) |*x, i| x.* = @intCast(i);
+            rng.shuffle(i32, perm);
+            for (self.pos, self.row_tab, 0..) |p, *t, r| {
+                t.* = @intCast(r * blocks);
+                self.table[r * blocks + @as(usize, @intCast(p)) / geom.block] = perm[r];
+            }
+        }
+        // x in [-4, 4); gate 4 (stress) uses small integers so the sum of squares is exact
+        inline for (.{ .{ "q", n * nq * 128 }, .{ "kk", n * kvh * 128 }, .{ "vv", n * kvh * 128 } }) |p| {
+            @field(self, p[0]) = try a.alloc(u16, p[1]);
+            for (@field(self, p[0])) |*e| e.* = c.toBf16(if (fill == .stress) @as(f32, @floatFromInt(rng.intRangeAtMost(i32, -3, 3))) else (rng.float(f32) - 0.5) * 8);
+        }
+        self.iq = try a.alloc(u16, n * niq * 128);
+        self.ik = try a.alloc(u16, n * 128);
+        for (self.iq) |*e| e.* = fp16(if (fill == .stress) @as(f32, @floatFromInt(rng.intRangeAtMost(i32, -3, 3))) else (rng.float(f32) - 0.5) * 8);
+        for (self.ik) |*e| e.* = fp16(if (fill == .stress) @as(f32, @floatFromInt(rng.intRangeAtMost(i32, -3, 3))) else (rng.float(f32) - 0.5) * 8);
+        for (&self.w) |*row| {
+            for (row) |*e| e.* = 1 + (rng.float(f32) - 0.5);
+        }
+        if (fill == .nonfinite) {
+            self.q[5] = c.toBf16(std.math.nan(f32));
+            if (n > 1) self.q[(1 * nq + 3) * 128 + 70] = c.toBf16(std.math.inf(f32));
+            if (n > 2) self.iq[(2 * niq + 1) * 128 + 9] = 0x7c00;
+        }
+        const lay = poolOf(self.f.kv8).pageBytes();
+        self.dev[0] = try self.rig.input(std.mem.sliceAsBytes(self.q));
+        self.dev[1] = try self.rig.input(std.mem.sliceAsBytes(self.kk));
+        self.dev[2] = try self.rig.input(std.mem.sliceAsBytes(self.vv));
+        self.dev[3] = try self.rig.input(std.mem.sliceAsBytes(self.iq));
+        self.dev[4] = try self.rig.input(std.mem.sliceAsBytes(self.ik));
+        self.dev[5] = try self.rig.input(std.mem.sliceAsBytes(self.w[0..]));
+        self.dev[6] = try self.rig.input(std.mem.sliceAsBytes(self.table));
+        self.dev[7] = try self.rig.input(std.mem.sliceAsBytes(self.pos));
+        self.dev[8] = try self.rig.output(self.q.len * 2);
+        self.dev[9] = try self.rig.output(self.iq.len * 2);
+        self.dev[10] = try self.rig.scratch(self.pages * lay);
+        self.dev[11] = try self.rig.scratch(4);
+        self.dev[12] = if (self.f.prompt) 0 else try self.rig.input(std.mem.sliceAsBytes(self.row_tab));
+        return true;
+    }
+
+    fn opts(self: *const Writer) rk.Opts {
+        return .{ .flags = .{ .kv8 = self.f.kv8 } };
+    }
+
+    pub fn run(self: *Writer) !void {
+        const n = self.shape.rows;
+        const rows: cuda.minimax_m3_sparse.Rows = if (self.f.prompt) .{ .n = n, .pos0 = self.pos[0] } else .{ .n = n, .pos = self.dev[7] };
+        const p: cuda.minimax_m3_sparse.Paged = .{ .pool = self.dev[10], .page_bytes = poolOf(self.f.kv8).pageBytes(), .layer_off = 0, .kvh = kvh, .tables = self.dev[6], .row_tab = self.dev[12], .kv8 = self.f.kv8 };
+        const status = self.dev[11];
+        const in: rk.Inputs = .{ .q = self.dev[0], .q_ld = nq * 128, .k = self.dev[1], .k_ld = kvh * 128, .v = self.dev[2], .v_ld = kvh * 128, .iq = self.dev[3], .iq_ld = niq * 128, .ik = self.dev[4], .ik_ld = 128 };
+        const nm: rk.Norms = .{ .q = self.dev[5], .k = self.dev[5] + 512, .iq = self.dev[5] + 1024, .ik = self.dev[5] + 1536 };
+        const out: rk.Outputs = .{ .q = self.dev[8], .q_ld = nq * 128, .iq = self.dev[9], .iq_ld = niq * 128 };
+        try self.k.qkRope(self.rig.s, .{}, self.opts(), in, nm, out, rows, p, @intCast(self.blocks), status);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Writer) usize {
+        return self.q.len + self.iq.len;
+    }
+
+    /// Row r's head i of the q scratch (kind 0) or the index query (kind 1): float64 norm, rotation, terms' magnitude.
+    fn head(self: *const Writer, kind: usize, r: usize, i: usize, y: *[128]f64, m: *[128]f64) void {
+        const p: usize = @intCast(self.pos[r]);
+        const src = if (kind == 0) self.q[(r * nq + i) * 128 ..][0..128] else self.iq[(r * niq + i) * 128 ..][0..128];
+        var x: [128]f64 = undefined;
+        var w: [128]f64 = undefined;
+        for (&x, &w, src, self.w[kind * 2][0..]) |*o, *ww, s, wv| {
+            o.* = if (kind == 0) c.fromBf16(s) else fp16v(s);
+            ww.* = wv;
+        }
+        var n: [128]f64 = undefined;
+        mr.gemmaNorm(&x, &w, 1e-6, false, &n);
+        y.* = n;
+        mr.rope(y, 64, p, 1e7, .neox_half);
+        for (m, n, 0..) |*o, v, d| o.* = if (d < 32) @abs(n[d]) + @abs(n[d + 32]) else if (d < 64) @abs(n[d]) + @abs(n[d - 32]) else @abs(v);
+    }
+
+    /// The scratch outputs if each norm's sum of squares (the kernel's only sums) ran in `acc` in `order`.
+    pub fn simulate(self: *Writer, acc: c.Accum, order: g.Order, out: []f64) !void {
+        for (0..self.shape.rows) |r| {
+            for (0..nq + niq) |h| {
+                const kind: usize = if (h < nq) 0 else 1;
+                const i = if (h < nq) h else h - nq;
+                const p: usize = @intCast(self.pos[r]);
+                const src = if (kind == 0) self.q[(r * nq + i) * 128 ..][0..128] else self.iq[(r * niq + i) * 128 ..][0..128];
+                var x: [128]f64 = undefined;
+                var sq: [128]f64 = undefined;
+                for (&x, &sq, src) |*o, *t, s| {
+                    o.* = if (kind == 0) c.fromBf16(s) else fp16v(s);
+                    t.* = o.* * o.*;
+                }
+                const ss = rows_.sumIn(acc, order, &sq);
+                const inv = 1 / @sqrt(ss / 128 + 1e-6);
+                var y: [128]f64 = undefined;
+                for (&y, x, self.w[kind * 2][0..]) |*o, v, wv| o.* = v * inv * wv;
+                mr.rope(&y, 64, p, 1e7, .neox_half);
+                const at = if (kind == 0) (r * nq + i) * 128 else self.q.len + (r * niq + i) * 128;
+                @memcpy(out[at..][0..128], &y);
+            }
+        }
+    }
+
+    pub fn reference(self: *Writer, want: []f64, mag: []f64) !void {
+        var y: [128]f64 = undefined;
+        var m: [128]f64 = undefined;
+        for (0..self.shape.rows) |r| {
+            for (0..nq) |i| {
+                self.head(0, r, i, &y, &m);
+                @memcpy(want[(r * nq + i) * 128 ..][0..128], &y);
+                @memcpy(mag[(r * nq + i) * 128 ..][0..128], &m);
+            }
+            for (0..niq) |i| {
+                self.head(1, r, i, &y, &m);
+                @memcpy(want[self.q.len + (r * niq + i) * 128 ..][0..128], &y);
+                @memcpy(mag[self.q.len + (r * niq + i) * 128 ..][0..128], &m);
+            }
+        }
+    }
+
+    /// The pool holds each row's K, V (exactly) and IK in its page, every other byte zero, and no status bit is set.
+    pub fn check(self: *Writer, at: g.Gate) !?[]const u8 {
+        _ = at;
+        if (!try self.rig.intact()) return "the writer changed a buffer guard";
+        const st = try self.rig.bytes(self.dev[11], 4);
+        if (std.mem.readInt(u32, st[0..4], .little) != 0) return "the writer reported a missing page";
+        if (self.f.kv8) return self.checkKv8();
+        const pool = poolOf(false);
+        const bytes = try self.rig.bytes(self.dev[10], self.pages * pool.pageBytes());
+        const cells = try self.arena.allocator().alloc(u16, bytes.len / 2);
+        @memcpy(std.mem.sliceAsBytes(cells), bytes);
+        var touched = try self.arena.allocator().alloc(bool, cells.len);
+        @memset(touched, false);
+        for (0..self.shape.rows) |r| {
+            const p: usize = @intCast(self.pos[r]);
+            const page: usize = @intCast(self.table[(if (self.f.prompt) 0 else r * self.blocks) + p / geom.block]);
+            const t = p % geom.block;
+            for (0..kvh) |h| {
+                const k0 = pool.kv(page, 0, 0, h, t) / 2;
+                const v0 = pool.kv(page, 0, 1, h, t) / 2;
+                @memset(touched[k0..][0..128], true);
+                @memset(touched[v0..][0..128], true);
+                if (!std.mem.eql(u16, cells[v0..][0..128], self.vv[(r * kvh + h) * 128 ..][0..128])) return "v was not stored as it came";
+                if (!self.rowNear(cells[k0..][0..128], self.kk[(r * kvh + h) * 128 ..][0..128], false, 1, p)) return "k differs from the float64 norm and rotation";
+            }
+            const ik0 = pool.ik(page, 0, t) / 2;
+            @memset(touched[ik0..][0..128], true);
+            if (!self.rowNear(cells[ik0..][0..128], self.ik[r * 128 ..][0..128], true, 3, p)) return "the index key differs from the float64 norm and rotation";
+        }
+        for (cells, touched) |v, t| if (!t and v != 0) return "the writer wrote outside the rows' token slots";
+        return null;
+    }
+
+    /// The fp8 pool: v exactly as the host rule gives it, k within e4m3's half step of the float64 norm and rope.
+    fn checkKv8(self: *Writer) !?[]const u8 {
+        const pool = poolOf(true);
+        const bytes = try self.rig.bytes(self.dev[10], self.pages * pool.pageBytes());
+        var touched = try self.arena.allocator().alloc(bool, bytes.len);
+        @memset(touched, false);
+        for (0..self.shape.rows) |r| {
+            const p: usize = @intCast(self.pos[r]);
+            const page: usize = @intCast(self.table[(if (self.f.prompt) 0 else r * self.blocks) + p / geom.block]);
+            const t = p % geom.block;
+            for (0..kvh) |h| {
+                const k0 = pool.kv(page, 0, 0, h, t);
+                const v0 = pool.kv(page, 0, 1, h, t);
+                const ks0 = pool.scale(page, 0, 0, h, t);
+                const vs0 = pool.scale(page, 0, 1, h, t);
+                @memset(touched[k0..][0..128], true);
+                @memset(touched[v0..][0..128], true);
+                @memset(touched[ks0..][0..4], true);
+                @memset(touched[vs0..][0..4], true);
+                var v32: [128]f32 = undefined;
+                for (&v32, self.vv[(r * kvh + h) * 128 ..][0..128]) |*o, s| o.* = c.fromBf16(s);
+                var want: [128]u8 = undefined;
+                const want_scale = mr.quantRowF32(&v32, &want);
+                if (!std.mem.eql(u8, bytes[v0..][0..128], &want)) return "v was not stored as the e4m3 row of its bf16 value";
+                if (std.mem.readInt(u32, bytes[vs0..][0..4], .little) != @as(u32, @bitCast(want_scale))) return "v's scale is not amax / 448";
+                const ks: f32 = @bitCast(std.mem.readInt(u32, bytes[ks0..][0..4], .little));
+                if (!self.keyNear(bytes[k0..][0..128], ks, self.kk[(r * kvh + h) * 128 ..][0..128], p)) return "k differs from the float64 norm and rotation beyond e4m3's half step";
+            }
+            const ik0 = pool.ik(page, 0, t);
+            @memset(touched[ik0..][0..256], true);
+            var cells: [128]u16 = undefined;
+            @memcpy(std.mem.sliceAsBytes(&cells), bytes[ik0..][0..256]);
+            if (!self.rowNear(&cells, self.ik[r * 128 ..][0..128], true, 3, p)) return "the index key differs from the float64 norm and rotation";
+        }
+        for (bytes, touched) |v, t| if (!t and v != 0) return "the writer wrote outside the rows' token slots";
+        return null;
+    }
+
+    /// A stored key row (codes and scale) against the float64 norm and rotation of `src`.
+    fn keyNear(self: *const Writer, codes: []const u8, scale: f32, src: []const u16, p: usize) bool {
+        var x: [128]f64 = undefined;
+        var w: [128]f64 = undefined;
+        for (&x, &w, src, self.w[1][0..]) |*o, *ww, s, wv| {
+            o.* = c.fromBf16(s);
+            ww.* = wv;
+        }
+        var y: [128]f64 = undefined;
+        mr.gemmaNorm(&x, &w, 1e-6, false, &y);
+        mr.rope(&y, 64, p, 1e7, .neox_half);
+        var amax: f64 = 0;
+        for (y) |v| amax = @max(amax, @abs(v));
+        if (!std.math.isFinite(scale) or !(@abs(@as(f64, scale) - amax / 448) <= amax / 448 * 0x1p-6 + 1e-30)) return false;
+        for (codes, y) |code, want| {
+            const v = mr.e4m3Value(code) * @as(f64, scale);
+            // half an e4m3 step (2^-4 relative, 2^-10 scales below), the bf16 rounding and the norm's error
+            if (!(@abs(v - want) <= @abs(want) * (0x1p-4 + 0x1p-7) + @as(f64, scale) * 0x1p-9 + 1e-4)) return false;
+        }
+        return true;
+    }
+
+    fn rowNear(self: *const Writer, got: []const u16, src: []const u16, fp: bool, wi: usize, p: usize) bool {
+        var x: [128]f64 = undefined;
+        var w: [128]f64 = undefined;
+        for (&x, &w, src, self.w[wi][0..]) |*o, *ww, s, wv| {
+            o.* = if (fp) fp16v(s) else c.fromBf16(s);
+            ww.* = wv;
+        }
+        var y: [128]f64 = undefined;
+        mr.gemmaNorm(&x, &w, 1e-6, false, &y);
+        mr.rope(&y, 64, p, 1e7, .neox_half);
+        for (got, y) |h, want| {
+            const v: f64 = c.fromBf16(h);
+            if (!(@abs(v - want) <= @abs(want) * 0x1p-7 + 1e-4)) return false;
+        }
+        return true;
+    }
+};
+
+test "the writer's served shapes fit the launch and the router's are multiples of its chunk" {
+    for (rowsSpec(cfgs[0]).served) |s| {
+        _ = try geom.rowsLaunch(s.rows);
+        try geom.checkRows(64, s.n * 128, s.n * 128);
+    }
+    for (routerSpec(.bf16).served) |s| {
+        _ = try geom.routerLaunch(s.rows, s.n);
+        try geom.checkRouter(s.k, s.k);
+    }
+    try std.testing.expectEqual(@as(?[]const u8, "tf_mm3_router_bf16"), routerSpec(.f32).replaces);
+}
diff --git a/zig/tests/cuda/contract_minimax_sparse.zig b/zig/tests/cuda/contract_minimax_sparse.zig
new file mode 100644
index 0000000..2f1ed4b
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_sparse.zig
@@ -0,0 +1,495 @@
+//! MiniMax-M3.1-Flash block-sparse attention under the contract on CUDA: the forced-block top-16 against
+//! core/minimax_ref.zig selectBlocks (a stated, exact rule) and the selected-block GQA attention against attention_ref, head by head,
+//! over paged K/V (page ids from a shuffled block table, the other layer and unwritten tokens poisoned with NaN).
+//! Compile-checked only so far: no GPU has run these. The planted controls for these kernels are the host mutants in
+//! zig/tests/minimax_sparse_tests.zig; no contract_controls.cu kernel exists for them yet.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const attn = @import("contract_attn.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const mr = core.minimax_ref;
+const sp = cuda.minimax_m3_sparse;
+const geom = sp.geom;
+
+/// Local kv heads, layers in the test pool, and the layer read (the other is NaN).
+const kvh = 2;
+const layers = 2;
+const layer = 1;
+/// The bf16 pool: the host's shadow of every cell, and the device pool unless the config is fp8.
+const pool: geom.Pool = .{ .kvh = kvh, .layers = layers };
+/// The fp8 pool the device reads when `Cfg.kv8` (docs/fp8-kv.md): e4m3 K/V rows with an fp32 scale each.
+const pool8: geom.Pool = .{ .kvh = kvh, .layers = layers, .kv8 = true };
+
+fn zero(_: c.Shape) usize {
+    return 0;
+}
+
+pub const Variant = struct { name: []const u8, sw: mr.Switches };
+
+pub const variants = [_]Variant{
+    .{ .name = "cuda minimax_m3 tf_mm3_select, own block forced, ties to the lower block", .sw = .{} },
+    .{ .name = "cuda minimax_m3 tf_mm3_select, init block 0 inclusive, trailing window 2, ties to the higher block", .sw = .{ .sparse_init_block = 0, .init_mode = .inclusive, .sparse_local_block = 2, .local_mode = .trailing_window, .tie = .higher_block } },
+};
+
+pub fn rulesOf(sw: mr.Switches) geom.Rules {
+    return .{
+        .init_n = @intCast(sw.sparse_init_block),
+        .init_inclusive = sw.init_mode == .inclusive,
+        .local_n = @intCast(sw.sparse_local_block),
+        .local_trailing = sw.local_mode == .trailing_window,
+        .higher_tie = sw.tie == .higher_block,
+    };
+}
+
+pub fn selectSpec(v: Variant) c.Spec {
+    return .{
+        .name = v.name,
+        .accum = .none,
+        .depth = zero,
+        .out = .raw,
+        .nan = .{ .stated = "a NaN block score ranks as -inf, as minimax_ref.topk; forced blocks are +inf; ties by the switch's block order" },
+        // rows = query rows, n = blocks of the first row (its position's block + 1), k unused
+        .tiles = .{ .{}, .{ .size = geom.topk }, .{} },
+        .served = &.{
+            .{ .rows = 8, .n = 17, .k = 0 },
+            .{ .rows = 1, .n = 1024, .k = 0 },
+            .{ .rows = 4, .n = 16, .k = 0 },
+            .{ .rows = 3, .n = 3, .k = 0 },
+            .{ .rows = 2, .n = 2, .k = 0 },
+        },
+    };
+}
+
+pub const Select = struct {
+    rig: rig_.Rig,
+    f: *const sp.Sparse,
+    v: Variant,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    bm: std.ArrayList(f32) = .empty,
+    pos: std.ArrayList(i32) = .empty,
+    want: std.ArrayList(i32) = .empty,
+    ptr: [3]u64 = @splat(0),
+
+    pub fn deinit(self: *Select) void {
+        const a = self.rig.gpu.gpa;
+        self.bm.deinit(a);
+        self.pos.deinit(a);
+        self.want.deinit(a);
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Select) g.Kernel {
+        return .{ .spec = selectSpec(self.v), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Select);
+
+    /// Row r's block count: the first row's, one fewer for odd rows (never below 1).
+    fn blocksOf(self: *const Select, r: usize) usize {
+        return @max(1, self.shape.n - (r % 2) * @min(1, self.shape.n - 1));
+    }
+
+    pub fn prepare(self: *Select, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.n == 0 or shape.n > 4096) return false;
+        self.rig.reset();
+        const a = self.rig.gpu.gpa;
+        self.shape = shape;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        const rows = shape.rows;
+        const stride = shape.n;
+        try self.bm.resize(a, rows * kvh * stride);
+        try self.pos.resize(a, rows);
+        try self.want.resize(a, rows * kvh * geom.topk);
+        // small integer scores make ties on both sides of the cut
+        for (self.bm.items) |*x| x.* = @floatFromInt(@as(i32, @intCast(rng.uintLessThan(u32, 9))) - 4);
+        if (fill == .nonfinite) {
+            const special = [_]f32{ std.math.nan(f32), std.math.inf(f32), -std.math.inf(f32), -0.0, 0.0 };
+            for (self.bm.items, 0..) |*x, i| if (i % 7 == 3) {
+                x.* = special[(i / 7) % special.len];
+            };
+        }
+        var scratch: [4096]f64 = undefined;
+        var wide: [4096]f64 = undefined;
+        var rids: [geom.topk]usize = undefined;
+        for (0..rows) |r| {
+            const nb = self.blocksOf(r);
+            self.pos.items[r] = @intCast((nb - 1) * geom.block + (r * 37) % geom.block);
+            for (0..kvh) |h| {
+                const row = self.bm.items[(r * kvh + h) * stride ..][0..nb];
+                for (wide[0..nb], row) |*d, s| d.* = s;
+                const cnt = mr.selectBlocks(wide[0..nb], nb - 1, geom.topk, self.v.sw, &scratch, &rids);
+                const out = self.want.items[(r * kvh + h) * geom.topk ..][0..geom.topk];
+                for (out, 0..) |*o, i| o.* = if (i < cnt) @intCast(rids[i]) else -1;
+            }
+        }
+        self.ptr[0] = try self.rig.input(std.mem.sliceAsBytes(self.bm.items));
+        self.ptr[1] = try self.rig.input(std.mem.sliceAsBytes(self.pos.items));
+        self.ptr[2] = try self.rig.output(self.want.items.len * 4);
+        return true;
+    }
+
+    pub fn run(self: *Select) !void {
+        const sc: sp.Scratch = .{ .bmax = self.ptr[0], .sel = self.ptr[2], .bm_stride = self.shape.n };
+        try self.f.select(self.rig.s, .{ .n = self.shape.rows, .pos = self.ptr[1] }, kvh, sc, rulesOf(self.v.sw));
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Select) usize {
+        return self.want.items.len * 4;
+    }
+
+    pub fn reference(self: *Select, want: []f64, mag: []f64) !void {
+        for (want, mag, std.mem.sliceAsBytes(self.want.items)) |*w, *m, byte| {
+            w.* = @floatFromInt(byte);
+            m.* = 0;
+        }
+    }
+
+    pub fn check(self: *Select, at: g.Gate) !?[]const u8 {
+        _ = at;
+        if (!try self.rig.intact()) return "selection changed a buffer guard";
+        const inputs = try self.rig.inputBytes();
+        const bm = std.mem.sliceAsBytes(self.bm.items);
+        const pos = std.mem.sliceAsBytes(self.pos.items);
+        if (inputs.len != bm.len + pos.len or !std.mem.eql(u8, bm, inputs[0..bm.len]) or !std.mem.eql(u8, pos, inputs[bm.len..])) return "selection changed its scores or positions";
+        const got = try self.rig.outputBytes();
+        return if (std.mem.eql(u8, std.mem.sliceAsBytes(self.want.items), got)) null else "selected block ids differ from minimax_ref.selectBlocks (ascending, -1 padded)";
+    }
+};
+
+/// A decode window (positions given) or a prompt chunk (positions k, k + 1, ...).
+pub const Cfg = struct { name: []const u8, prompt: bool, kv8: bool = false };
+
+pub const cfgs = [_]Cfg{
+    .{ .name = "cuda minimax_m3 tf_mm3_attn decode, 32 q heads over 2 kv heads, paged", .prompt = false },
+    .{ .name = "cuda minimax_m3 tf_mm3_attn prompt chunk, 32 q heads over 2 kv heads, paged", .prompt = true },
+    .{ .name = "cuda minimax_m3 tf_mm3_attn decode, fp8 K/V pages (kv8), 32 q heads over 2 kv heads, paged", .prompt = false, .kv8 = true },
+    .{ .name = "cuda minimax_m3 tf_mm3_attn prompt chunk, fp8 K/V pages (kv8), 32 q heads over 2 kv heads, paged", .prompt = true, .kv8 = true },
+};
+
+fn keyChain(s: c.Shape) usize {
+    return @min(s.k, geom.topk * geom.block) + 32 + 32;
+}
+
+pub fn attnSpec(f: Cfg) c.Spec {
+    return .{
+        .name = f.name,
+        .accum = .f32,
+        .depth = keyChain,
+        // the fp8 reader scales the dot and the weight: two more fp32 roundings in a score and one in a weight
+        .ops = if (f.kv8) 3 else 1,
+        .out = .bf16,
+        // rows, the 32 query heads, and the positions' bound (the last row's position + 1): edges at a block boundary
+        .tiles = .{ .{}, .{}, .{ .size = geom.block, .min = 1 } },
+        .served = &.{ .{ .rows = 16, .n = 32, .k = 3000 }, .{ .rows = 4, .n = 32, .k = 2048 }, .{ .rows = 2, .n = 32, .k = 129 }, .{ .rows = 8, .n = 32, .k = 128 } },
+        .sums = .{ .why = attn.why },
+    };
+}
+
+/// attn.mirrored with e4m3-exact values and a +-448 in every row (scale 1); the 1 residue pairs are integers 9..16.
+fn mirrored8(rng: std.Random, out: []f32, e: usize) void {
+    const h = out.len / 2;
+    for (0..h) |i| {
+        const v: f32 = if (i < 8) @floatFromInt(9 + rng.uintLessThan(u32, 8)) else @floatCast(mr.e4m3Value(@intCast(0x10 + rng.uintLessThan(u32, 0x6f))));
+        out[i] = v;
+        out[h + i] = (if (i < 8) @as(f32, 1) else 0) - v;
+    }
+    if (out.len % 2 == 1) out[out.len - 1] = 0;
+    if (e >= 8) for (out, 0..) |*y, i| {
+        if (i % 120 == e - 8) y.* = if (i % 2 == 0) 448 else -448;
+    };
+}
+
+pub const Attn = struct {
+    rig: rig_.Rig,
+    f: Cfg,
+    s: *const sp.Sparse,
+    r: ?attn.Ref = null,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    pos: std.ArrayList(i32) = .empty,
+    sel: std.ArrayList(i32) = .empty,
+    table: std.ArrayList(i32) = .empty,
+    q: std.ArrayList(u16) = .empty,
+    cache: std.ArrayList(u16) = .empty,
+    /// fp8 only: the pool bytes the device reads, and the float64 value each bf16 cell of `cache` decodes to.
+    img: std.ArrayList(u8) = .empty,
+    dec: std.ArrayList(f64) = .empty,
+    dev: [5]u64 = @splat(0),
+    out: u64 = 0,
+    blocks_max: usize = 0,
+
+    pub fn deinit(self: *Attn) void {
+        const a = self.rig.gpu.gpa;
+        if (self.r) |*r| r.deinit();
+        inline for (.{ "pos", "sel", "table", "q", "cache", "img", "dec" }) |n| @field(self, n).deinit(a);
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Attn) g.Kernel {
+        return .{ .spec = attnSpec(self.f), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Attn);
+
+    fn posOf(self: *const Attn, r: usize) usize {
+        return @intCast(self.pos.items[r]);
+    }
+
+    fn cell(self: *Attn, page: usize, which: usize, h: usize, t: usize, e: usize) *u16 {
+        return &self.cache.items[(pool.kv(page, layer, which, h, t) >> 1) + e];
+    }
+
+    fn rowOf(self: *Attn, page: usize, which: usize, h: usize, t: usize) []u16 {
+        return self.cache.items[pool.kv(page, layer, which, h, t) >> 1 ..][0..geom.d];
+    }
+
+    pub fn prepare(self: *Attn, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.n != kvh * geom.group or shape.rows == 0 or shape.k == 0 or shape.k + shape.rows > 8192) return false;
+        self.rig.reset();
+        const a = self.rig.gpu.gpa;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        const n = shape.rows;
+        // positions: a decode window's spread over [0, k), the last at k - 1 (stress: all there); a prompt chunk's k + i
+        try self.pos.resize(a, n);
+        for (self.pos.items, 0..) |*p, i| p.* = @intCast(if (self.f.prompt) shape.k + i else if (fill == .stress or i == n - 1) shape.k - 1 else (i * 7919) % shape.k);
+        var top: usize = 0;
+        for (self.pos.items) |p| top = @max(top, @as(usize, @intCast(p)));
+        const nb = geom.blocks(top);
+        self.blocks_max = nb;
+        // the pool's pages in a shuffled order; the table maps block -> page id
+        const pages = nb + 3;
+        try self.table.resize(a, nb);
+        var perm = try a.alloc(i32, pages);
+        defer a.free(perm);
+        for (perm, 0..) |*x, i| x.* = @intCast(i);
+        rng.shuffle(i32, perm);
+        @memcpy(self.table.items, perm[0..nb]);
+        // the cache: the other layer and every token not yet written are NaN, the read layer random
+        try self.cache.resize(a, pages * pool.pageBytes() / 2);
+        @memset(self.cache.items, c.toBf16(std.math.nan(f32)));
+        for (0..nb) |b| for (0..geom.block) |t| {
+            const page: usize = @intCast(self.table.items[b]);
+            if (b * geom.block + t > top) continue;
+            for (0..2) |w| for (0..kvh) |h| for (0..geom.d) |e| {
+                self.cell(page, w, h, t, e).* = attn.normal(rng);
+            };
+            const ik = (pool.ik(page, layer, t) >> 1);
+            @memset(self.cache.items[ik..][0..geom.d], 0);
+        };
+        // selected lists: every block when a row has at most 16, else its own block and 15 others; ascending, -1 padded
+        try self.sel.resize(a, n * kvh * geom.topk);
+        for (0..n) |r| for (0..kvh) |h| {
+            const own = geom.blocks(self.posOf(r)) - 1;
+            const out = self.sel.items[(r * kvh + h) * geom.topk ..][0..geom.topk];
+            @memset(out, -1);
+            if (own + 1 <= geom.topk) {
+                for (out[0 .. own + 1], 0..) |*o, i| o.* = @intCast(i);
+            } else {
+                var chosen: [geom.topk]i32 = undefined;
+                chosen[0] = @intCast(own);
+                var m: usize = 1;
+                while (m < geom.topk) {
+                    const cand: i32 = @intCast(rng.uintLessThan(usize, own));
+                    if (std.mem.indexOfScalar(i32, chosen[0..m], cand) == null) {
+                        chosen[m] = cand;
+                        m += 1;
+                    }
+                }
+                std.mem.sort(i32, &chosen, {}, std.sort.asc(i32));
+                @memcpy(out, &chosen);
+            }
+        };
+        try self.q.resize(a, n * shape.n * geom.d);
+        for (self.q.items) |*e| e.* = attn.normal(rng);
+        if (self.r) |*r| r.deinit();
+        self.r = null;
+        self.r = try attn.Ref.init(a, geom.d, geom.topk * geom.block);
+        switch (fill) {
+            .random => {},
+            .nonfinite => self.plant(),
+            .stress => try self.stress(rng),
+        }
+        if (self.f.kv8) try self.quantize(nb);
+        const poolb = if (self.f.kv8) self.img.items else std.mem.sliceAsBytes(self.cache.items);
+        for ([_][]const u8{ std.mem.sliceAsBytes(self.q.items), std.mem.sliceAsBytes(self.sel.items), std.mem.sliceAsBytes(self.pos.items), std.mem.sliceAsBytes(self.table.items), poolb }, &self.dev) |bytes, *p| p.* = try self.rig.input(bytes);
+        self.out = try self.rig.output(n * shape.n * geom.d * 2);
+        return true;
+    }
+
+    /// The fp8 pool image from the bf16 cells by the host rule, every other byte NaN; `dec` is what cells read back as.
+    fn quantize(self: *Attn, nb: usize) !void {
+        const a = self.rig.gpu.gpa;
+        try self.img.resize(a, self.cache.items.len * 2 / pool.pageBytes() * pool8.pageBytes());
+        @memset(self.img.items, 0xff);
+        try self.dec.resize(a, self.cache.items.len);
+        @memset(self.dec.items, std.math.nan(f64));
+        var top: usize = 0;
+        for (self.pos.items) |p| top = @max(top, @as(usize, @intCast(p)));
+        for (0..nb) |b| for (0..geom.block) |t| {
+            const page: usize = @intCast(self.table.items[b]);
+            if (b * geom.block + t > top) continue;
+            for (0..2) |w| for (0..kvh) |h| {
+                var x: [geom.d]f32 = undefined;
+                for (&x, 0..) |*o, e| o.* = c.fromBf16(self.cell(page, w, h, t, e).*);
+                const at = pool8.kv(page, layer, w, h, t);
+                const sc = mr.quantRowF32(&x, self.img.items[at..][0..geom.d]);
+                std.mem.writeInt(u32, self.img.items[pool8.scale(page, layer, w, h, t)..][0..4], @bitCast(sc), .little);
+                for (0..geom.d) |e| self.dec.items[(pool.kv(page, layer, w, h, t) >> 1) + e] = mr.e4m3Value(self.img.items[at + e]) * @as(f64, sc);
+            };
+        };
+    }
+
+    /// Row r's key list for kv head h: the tokens of its selected blocks up to its position, as (block, token).
+    fn key(self: *const Attn, r: usize, h: usize, i: usize) struct { b: usize, t: usize } {
+        const ids = self.sel.items[(r * kvh + h) * geom.topk ..][0..geom.topk];
+        const p = self.posOf(r);
+        var left = i;
+        for (ids) |b| {
+            if (b < 0) break;
+            const bb: usize = @intCast(b);
+            const valid = @min(geom.block, p + 1 - bb * geom.block);
+            if (left < valid) return .{ .b = bb, .t = left };
+            left -= valid;
+        }
+        unreachable;
+    }
+
+    fn keysOf(self: *const Attn, r: usize) usize {
+        const p = self.posOf(r);
+        var n: usize = 0;
+        for (self.sel.items[(r * kvh) * geom.topk ..][0..geom.topk]) |b| {
+            if (b < 0) break;
+            n += @min(geom.block, p + 1 - @as(usize, @intCast(b)) * geom.block);
+        }
+        return n;
+    }
+
+    /// NaN query; +inf / -inf values in one column; a NaN key; +inf at the first key.
+    fn plant(self: *Attn) void {
+        const n = self.shape.rows;
+        const nan = c.toBf16(std.math.nan(f32));
+        const inf = c.toBf16(std.math.inf(f32));
+        const ninf = c.toBf16(-std.math.inf(f32));
+        self.q.items[3] = nan;
+        if (self.f.kv8) {
+            // a bad value poisons its whole row: plant at the last rows' own keys
+            const l = n - 1;
+            const kv = self.key(l, 0, self.keysOf(l) - 1);
+            self.cell(@intCast(self.table.items[kv.b]), 1, 0, kv.t, 7).* = inf;
+            if (n > 2) {
+                const kk = self.key(l - 1, 1, self.keysOf(l - 1) - 1);
+                self.cell(@intCast(self.table.items[kk.b]), 0, 1, kk.t, 9).* = nan;
+            }
+            return;
+        }
+        const k0 = self.key(0, 0, self.keysOf(0) - 1);
+        self.cell(@intCast(self.table.items[k0.b]), 1, 0, k0.t, 7).* = inf;
+        if (n > 1) {
+            const k1 = self.key(1, 1, self.keysOf(1) - 1);
+            self.cell(@intCast(self.table.items[k1.b]), 1, 1, k1.t, 9).* = ninf;
+        }
+        if (n > 3) {
+            const k3 = self.key(3, 0, 0);
+            self.cell(@intCast(self.table.items[k3.b]), 0, 0, k3.t, 0).* = nan;
+        }
+        if (n > 4) {
+            const k4 = self.key(4, 1, 0);
+            self.cell(@intCast(self.table.items[k4.b]), 1, 1, k4.t, 13).* = inf;
+        }
+    }
+
+    /// Gate 4: every key alike (p = 1), values mirrored over the keys row 0 sees, 0 elsewhere. All rows share one list.
+    fn stress(self: *Attn, rng: std.Random) !void {
+        const n = self.shape.rows;
+        // one list for every row: row 0's
+        for (1..n) |r| @memcpy(self.sel.items[r * kvh * geom.topk ..][0 .. kvh * geom.topk], self.sel.items[0 .. kvh * geom.topk]);
+        const a = self.rig.gpu.gpa;
+        const key0 = try a.alloc(u16, kvh * geom.d);
+        defer a.free(key0);
+        for (key0) |*e| e.* = attn.normal(rng);
+        for (self.table.items) |pg| for (0..geom.block) |t| for (0..kvh) |h| {
+            @memcpy(self.rowOf(@intCast(pg), 0, h, t), key0[h * geom.d ..][0..geom.d]);
+            @memset(self.rowOf(@intCast(pg), 1, h, t), 0);
+        };
+        const nk = self.keysOf(0);
+        const col = try a.alloc(f32, nk);
+        defer a.free(col);
+        for (0..kvh) |h| for (0..geom.d) |e| {
+            if (self.f.kv8) mirrored8(rng, col, e) else attn.mirrored(rng, col);
+            for (col, 0..) |y, i| {
+                const k = self.key(0, h, i);
+                self.cell(@intCast(self.table.items[k.b]), 1, h, k.t, e).* = c.toBf16(y);
+            }
+        };
+        // a row's own-block tokens past row 0's are zero values with equal keys: p = 1 each, V = 0
+    }
+
+    fn paged(self: *const Attn) sp.Paged {
+        const dev = if (self.f.kv8) pool8 else pool;
+        return .{ .pool = self.dev[4], .page_bytes = dev.pageBytes(), .layer_off = dev.layerOff(layer), .kvh = kvh, .tables = self.dev[3], .kv8 = self.f.kv8 };
+    }
+
+    pub fn run(self: *Attn) !void {
+        const n = self.shape.rows;
+        const rows: sp.Rows = if (self.f.prompt) .{ .n = n, .pos0 = @intCast(self.shape.k) } else .{ .n = n, .pos = self.dev[2] };
+        const sc: sp.Scratch = .{ .bmax = 0, .sel = self.dev[1], .bm_stride = 0 };
+        const scale32: f32 = @floatCast(self.scale());
+        try self.s.attend(self.rig.s, self.dev[0], rows, self.paged(), sc, self.out, scale32);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Attn) usize {
+        return self.shape.rows * self.shape.n * geom.d;
+    }
+
+    /// Output head i (row i / 32, head i % 32): the keys of the row's selected blocks up to its position.
+    pub fn load(self: *Attn, i: usize, hd: *attn.Head) !void {
+        const r = i / self.shape.n;
+        const head = i % self.shape.n;
+        const h = head / geom.group;
+        for (hd.q, 0..) |*x, e| x.* = c.fromBf16(self.q.items[i * geom.d + e]);
+        const nk = self.keysOf(r);
+        for (0..nk) |j| {
+            const k = self.key(r, h, j);
+            const page: usize = @intCast(self.table.items[k.b]);
+            for (0..geom.d) |e| {
+                if (self.f.kv8) {
+                    hd.k[j * geom.d + e] = self.dec.items[(pool.kv(page, layer, 0, h, k.t) >> 1) + e];
+                    hd.v[j * geom.d + e] = self.dec.items[(pool.kv(page, layer, 1, h, k.t) >> 1) + e];
+                } else {
+                    hd.k[j * geom.d + e] = c.fromBf16(self.cell(page, 0, h, k.t, e).*);
+                    hd.v[j * geom.d + e] = c.fromBf16(self.cell(page, 1, h, k.t, e).*);
+                }
+            }
+        }
+        hd.n = nk;
+    }
+
+    fn heads(self: *Attn) usize {
+        return self.shape.rows * self.shape.n;
+    }
+
+    fn scale(_: *const Attn) f64 {
+        return std.math.pow(f64, geom.d, -0.5);
+    }
+
+    pub fn check(self: *Attn, gate: g.Gate) !?[]const u8 {
+        return self.r.?.check(self, self.heads(), self.scale(), try self.rig.outputBytes(), gate);
+    }
+
+    pub fn reference(self: *Attn, want: []f64, mag: []f64) !void {
+        return self.r.?.reference(self, self.heads(), self.scale(), want, mag);
+    }
+
+    pub fn simulate(self: *Attn, acc: c.Accum, order: g.Order, out: []f64) !void {
+        return self.r.?.simulate(self, self.heads(), self.scale(), acc, order, out);
+    }
+};
