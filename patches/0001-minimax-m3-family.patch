+//! The dspark top-C and Markov chain kernels under the contract on CUDA.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const attn = @import("contract_attn.zig");
+const common = @import("contract_minimax_dspark_common.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const rows_ = contract.rows;
+const mr = core.minimax_ref;
+const ds = cuda.minimax_m3_dspark;
+const hidden = common.hidden;
+const eps32 = common.eps32;
+const eps = common.eps;
+const rot = common.rot;
+const theta = common.theta;
+const zeroDepth = common.zeroDepth;
+const bf = common.bf;
+const isNanBf = common.isNanBf;
+const nq = common.nq;
+const kvh = common.kvh;
+
+// ---- top-C
+
+pub const slot_n = 782 * 128; // the largest rank slice of the 200,064-token vocabulary
+pub const pad = 64;
+pub const id0: u32 = slot_n;
+
+pub fn orderKey(v: f32) u32 {
+    if (std.math.isNan(v)) return 0;
+    var u: u32 = @bitCast(v);
+    if (u == 0x8000_0000) u = 0;
+    return if (u & 0x8000_0000 != 0) ~u else u | 0x8000_0000;
+}
+
+pub const topc_spec: c.Spec = .{
+    .name = "cuda minimax_m3_dspark tf_mm3_ds_topc",
+    .accum = .none,
+    .depth = zeroDepth,
+    .out = .raw,
+    .nan = .{ .stated = "a NaN ranks below every number; -0 equals +0; larger wins, ties go to the lower id; fewer than c valid pads {-inf, -1}" },
+    // rows, valid logits, candidates a row
+    .tiles = .{ .{}, .{ .size = 256, .step = 1, .min = 1 }, .{} },
+    .served = &.{ .{ .rows = 7, .n = slot_n, .k = 64 }, .{ .rows = 1, .n = 5000, .k = 64 }, .{ .rows = 16, .n = 3000, .k = 128 }, .{ .rows = 7, .n = 40, .k = 64 }, .{ .rows = 8, .n = slot_n - 128, .k = 1 } },
+    .sums = .{ .f16 = 0, .bf16 = 0, .why = "a selection compares and sums nothing" },
+};
+
+pub const TopC = struct {
+    rig: rig_.Rig,
+    k: *const ds.Dspark,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    logits: []f32 = &.{},
+    dev: [2]u64 = .{ 0, 0 },
+    msg: [200]u8 = undefined,
+
+    pub fn deinit(self: *TopC) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *TopC) g.Kernel {
+        return .{ .spec = topc_spec, .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(TopC);
+
+    fn ld(self: *const TopC) usize {
+        return self.shape.n + pad;
+    }
+
+    pub fn prepare(self: *TopC, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.rows > 16 or shape.n == 0 or shape.n > slot_n or shape.k == 0 or shape.k > 128) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        self.logits = try a.alloc(f32, shape.rows * self.ld());
+        const nan = std.math.nan(f32);
+        const inf = std.math.inf(f32);
+        for (0..shape.rows) |r| {
+            const row = self.logits[r * self.ld() ..][0..self.ld()];
+            @memset(row[shape.n..], inf); // decoys after the slice
+            for (row[0..shape.n], 0..) |*v, i| v.* = switch (r % 8) {
+                0 => rng.floatNorm(f32) * 3,
+                1 => @floatFromInt(rng.intRangeAtMost(i32, -3, 3)),
+                2 => 1.5,
+                3 => if (i % 5 == 0) nan else rng.floatNorm(f32),
+                4 => nan,
+                5 => if (i % 7 == 0) inf else if (i % 2 == 0) -0.0 else 0.0,
+                6 => -inf,
+                else => if (i + 1 == shape.n) 100 else if (i % 3 == 0) -0.0 else @as(f32, @floatFromInt(rng.intRangeAtMost(i32, -2, 2))),
+            };
+            if (fill == .nonfinite and r == 0) row[shape.n / 2] = inf;
+        }
+        self.dev[0] = try self.rig.input(std.mem.sliceAsBytes(self.logits));
+        self.dev[1] = try self.rig.output(shape.rows * shape.k * 8);
+        return true;
+    }
+
+    pub fn run(self: *TopC) !void {
+        const s = self.shape;
+        try self.k.topC(self.rig.s, self.dev[0], self.ld(), @intCast(s.n), id0, @intCast(s.rows), @intCast(s.k), self.dev[1]);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *TopC) usize {
+        return self.shape.rows * self.shape.k * 2;
+    }
+
+    pub fn reference(self: *TopC, want: []f64, mag: []f64) !void {
+        _ = self;
+        @memset(want, 0);
+        @memset(mag, 0);
+    }
+
+    const Less = struct {
+        row: []const f32,
+        fn before(ctx: @This(), a: u32, b: u32) bool {
+            const ka = orderKey(ctx.row[a]);
+            const kb = orderKey(ctx.row[b]);
+            return ka > kb or (ka == kb and a < b);
+        }
+    };
+
+    /// The oracle: every index sorted by (key desc, index asc), the first c.
+    pub fn check(self: *TopC, at: g.Gate) !?[]const u8 {
+        _ = at;
+        const s = self.shape;
+        const al = self.arena.allocator();
+        const out = try self.rig.outputBytes();
+        const idx = try al.alloc(u32, s.n);
+        defer al.free(idx);
+        for (0..s.rows) |r| {
+            const row = self.logits[r * self.ld() ..][0..s.n];
+            for (idx, 0..) |*x, i| x.* = @intCast(i);
+            std.mem.sort(u32, idx, Less{ .row = row }, Less.before);
+            for (0..s.k) |j| {
+                const o = (r * s.k + j) * 8;
+                const got_bits = std.mem.readInt(u32, out[o..][0..4], .little);
+                const got_id = std.mem.readInt(u32, out[o + 4 ..][0..4], .little);
+                if (j < s.n) {
+                    const want = row[idx[j]];
+                    if (got_id != id0 + idx[j]) return std.fmt.bufPrint(&self.msg, "row {d} rank {d}: id {d} where the sorted order gives {d}", .{ r, j, got_id, id0 + idx[j] }) catch "topc id differs";
+                    if (got_bits != @as(u32, @bitCast(want)) and !(std.math.isNan(want) and std.math.isNan(@as(f32, @bitCast(got_bits))))) return "a candidate's logit bits differ from its source";
+                } else if (got_bits != @as(u32, @bitCast(-std.math.inf(f32))) or got_id != 0xffff_ffff) return "padding is not {-inf, -1}";
+            }
+        }
+        if (!try self.rig.intact()) return "the top-C changed a buffer guard";
+        if (!std.mem.eql(u8, std.mem.sliceAsBytes(self.logits), try self.rig.inputBytes())) return "the top-C changed the logits";
+        return null;
+    }
+};
+
+// ---- Markov chain + confidence
+
+pub const vocab_t = 3000;
+pub const rank = 256;
+pub const cand = 64;
+
+pub const chain_spec: c.Spec = .{
+    .name = "cuda minimax_m3_dspark tf_mm3_ds_chain",
+    .accum = .none,
+    .depth = zeroDepth,
+    .out = .raw,
+    .nan = .{ .stated = "a NaN score loses to every number, an equal score goes to the lower id, no valid candidate gives token -1; a NaN input gives NaN confidence" },
+    // rows, candidates a rank, ranks
+    .served = &.{ .{ .rows = 7, .n = cand, .k = 2 }, .{ .rows = 7, .n = cand, .k = 1 }, .{ .rows = 16, .n = 8, .k = 2 }, .{ .rows = 1, .n = 3, .k = 2 } },
+    .sums = .{ .f16 = 0, .bf16 = 0, .why = "scores and confidence are checked against float64 with the fp32 chain's bound; no sums are declared" },
+};
+
+pub const Chain = struct {
+    rig: rig_.Rig,
+    k: *const ds.Dspark,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    cands: []u32 = &.{}, // [world][rows][cand] x {logit bits, id}
+    post: []u16 = &.{},
+    w1: []u16 = &.{},
+    w2: []u16 = &.{},
+    cw: []u16 = &.{},
+    cb: [1]u16 = .{0},
+    anchor: u32 = 17,
+    dev: [6]u64 = @splat(0),
+    out: u64 = 0,
+    msg: [240]u8 = undefined,
+
+    pub fn deinit(self: *Chain) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Chain) g.Kernel {
+        return .{ .spec = chain_spec, .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Chain);
+
+    fn ent(self: *const Chain, w: usize, r: usize, i: usize) *[2]u32 {
+        const s = self.shape;
+        return @ptrCast(self.cands[(((w * s.rows + r) * s.n) + i) * 2 ..][0..2]);
+    }
+
+    pub fn prepare(self: *Chain, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        const world = shape.k;
+        if (shape.rows == 0 or shape.rows > 16 or shape.n == 0 or world == 0 or world > 2 or world * shape.n > 256 or shape.n * world > vocab_t / 2) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        const rows = shape.rows;
+        self.cands = try a.alloc(u32, world * rows * shape.n * 2);
+        self.post = try a.alloc(u16, rows * hidden);
+        self.w1 = try a.alloc(u16, vocab_t * rank);
+        self.w2 = try a.alloc(u16, vocab_t * rank);
+        self.cw = try a.alloc(u16, hidden + rank);
+        for (self.w1) |*e| e.* = bf(rng, 0.25);
+        for (self.w2) |*e| e.* = bf(rng, 0.25);
+        for (self.post) |*e| e.* = bf(rng, 1);
+        for (self.cw) |*e| e.* = bf(rng, 0.02);
+        self.cb[0] = bf(rng, 0.5);
+        const perm = try a.alloc(u32, vocab_t);
+        for (0..world) |w| for (0..rows) |r| {
+            for (perm, 0..) |*p, i| p.* = @intCast(i);
+            rng.shuffle(u32, perm);
+            var m: usize = 0;
+            for (perm) |id| { // rank w's ids are its own half of the vocabulary
+                if (id / (vocab_t / 2) != w and world == 2) continue;
+                if (m == shape.n) break;
+                const e = self.ent(w, r, m);
+                e[0] = @bitCast(rng.floatNorm(f32) * 3);
+                e[1] = id;
+                m += 1;
+            }
+            // padding at the end of a rank's list; one row with no candidate at all
+            const invalid: usize = if (r % 3 == 2) @min(5, shape.n - 1) else 0;
+            for (shape.n - invalid..shape.n) |i| {
+                const e = self.ent(w, r, i);
+                e[0] = @bitCast(-std.math.inf(f32));
+                e[1] = 0xffff_ffff;
+            }
+            if (r == 4) for (0..shape.n) |i| {
+                const e = self.ent(w, r, i);
+                e[0] = @bitCast(-std.math.inf(f32));
+                e[1] = 0xffff_ffff;
+            };
+        };
+        // row 2: two candidates of rank 0 with equal scores that beat the rest: the lower id must win
+        if (rows > 2 and shape.n >= 8) {
+            const ea = self.ent(0, 2, 0);
+            const eb = self.ent(0, 2, 1);
+            @memcpy(self.w2[eb[1] * rank ..][0..rank], self.w2[ea[1] * rank ..][0..rank]);
+            ea[0] = @bitCast(@as(f32, 50));
+            eb[0] = @bitCast(@as(f32, 50));
+        }
+        if (fill == .nonfinite) {
+            self.ent(0, 0, 3)[0] = @bitCast(std.math.nan(f32));
+            if (rows > 1) self.ent(0, 1, 2)[0] = @bitCast(std.math.inf(f32));
+            if (rows > 3) self.post[3 * hidden + 11] = c.toBf16(std.math.nan(f32));
+        }
+        const bytes = [_][]const u8{ std.mem.sliceAsBytes(self.cands), std.mem.sliceAsBytes(self.post), std.mem.sliceAsBytes(self.w1), std.mem.sliceAsBytes(self.w2), std.mem.sliceAsBytes(self.cw), std.mem.sliceAsBytes(self.cb[0..]) };
+        for (bytes, &self.dev) |b, *p| p.* = try self.rig.input(b);
+        self.out = try self.rig.output(rows * 8);
+        return true;
+    }
+
+    pub fn run(self: *Chain) !void {
+        const s = self.shape;
+        const d = self.dev;
+        try self.k.chain(self.rig.s, .{ .hidden = hidden, .rank = rank, .cand = @intCast(s.n), .world = @intCast(s.k), .rows = @intCast(s.rows) }, self.anchor, d[0], d[1], d[2], d[3], d[4], d[5], self.out);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Chain) usize {
+        return self.shape.rows * 2;
+    }
+
+    pub fn reference(self: *Chain, want: []f64, mag: []f64) !void {
+        _ = self;
+        @memset(want, 0);
+        @memset(mag, 0);
+    }
+
+    fn bias(self: *const Chain, prev: usize, id: usize) f64 {
+        var s: f64 = 0;
+        for (self.w1[prev * rank ..][0..rank], self.w2[id * rank ..][0..rank]) |x, y| s += @as(f64, c.fromBf16(x)) * c.fromBf16(y);
+        return s;
+    }
+
+    /// Follows the kernel's own previous tokens: each token must score within the fp32 chain's error of the best, ties
+    pub fn check(self: *Chain, at: g.Gate) !?[]const u8 {
+        _ = at;
+        const s = self.shape;
+        const out = try self.rig.outputBytes();
+        var prev: usize = self.anchor;
+        for (0..s.rows) |r| {
+            const tok = std.mem.readInt(i32, out[8 * r ..][0..4], .little);
+            const conf: f32 = @bitCast(std.mem.readInt(u32, out[8 * r + 4 ..][0..4], .little));
+            // float64 scores of the valid candidates
+            var best_id: i64 = -1;
+            var best_z: f64 = std.math.nan(f64);
+            var low_id: i64 = -1;
+            var found: ?f64 = null;
+            for (0..s.k) |w| for (0..s.n) |i| {
+                const e = self.ent(w, r, i);
+                if (e[1] == 0xffff_ffff) continue;
+                const z = @as(f64, @as(f32, @bitCast(e[0]))) + self.bias(prev, e[1]);
+                const id: i64 = e[1];
+                if (low_id < 0 or id < low_id) low_id = id;
+                if (tok == id) found = z;
+                const better = if (std.math.isNan(z)) false else if (std.math.isNan(best_z)) true else z > best_z or (z == best_z and id < best_id);
+                if (better) {
+                    best_z = z;
+                    best_id = id;
+                }
+            };
+            if (low_id < 0) {
+                if (tok != -1) return "no valid candidate but the token is not -1";
+            } else if (std.math.isNan(best_z)) {
+                if (tok != low_id) return "every score is NaN: the lowest id must win";
+            } else {
+                const z = found orelse return std.fmt.bufPrint(&self.msg, "row {d}: token {d} is not a candidate", .{ r, tok }) catch "token is not a candidate";
+                const tol = 2e-4 * (1 + @abs(best_z));
+                if (!(z == best_z or z >= best_z - tol)) return std.fmt.bufPrint(&self.msg, "row {d}: token {d} scores {e} where the best scores {e}", .{ r, tok, z, best_z }) catch "token is not the best";
+                // an exact tie must go to the lower id
+                var ties: usize = 0;
+                for (0..s.k) |w| for (0..s.n) |i| {
+                    const e = self.ent(w, r, i);
+                    if (e[1] == 0xffff_ffff) continue;
+                    const zz = @as(f64, @as(f32, @bitCast(e[0]))) + self.bias(prev, e[1]);
+                    if (zz == best_z) ties += 1;
+                };
+                if (ties > 1 and tok != best_id) return "an exact tie did not go to the lower id";
+            }
+            // the confidence of this token's chain position uses the kernel's previous token
+            var sum: f64 = c.fromBf16(self.cb[0]);
+            var mg: f64 = 0;
+            for (0..hidden) |j| {
+                const t = @as(f64, c.fromBf16(self.post[r * hidden + j])) * c.fromBf16(self.cw[j]);
+                sum += t;
+                mg += @abs(t);
+            }
+            for (0..rank) |j| {
+                const t = @as(f64, c.fromBf16(self.w1[prev * rank + j])) * c.fromBf16(self.cw[hidden + j]);
+                sum += t;
+                mg += @abs(t);
+            }
+            const want = mr.sigmoid(sum);
+            if (std.math.isNan(want)) {
+                if (!std.math.isNan(conf)) return "a NaN input must give NaN confidence";
+            } else if (!(@abs(conf - want) <= 0.25 * 1e-5 * mg + 2e-6)) return std.fmt.bufPrint(&self.msg, "row {d}: confidence {e} where float64 gives {e}", .{ r, conf, want }) catch "confidence differs";
+            prev = if (tok < 0) self.anchor else @intCast(tok);
+        }
+        if (!try self.rig.intact()) return "the chain changed a buffer guard";
+        return null;
+    }
+};
diff --git a/zig/tests/cuda/contract_minimax_proj.zig b/zig/tests/cuda/contract_minimax_proj.zig
new file mode 100644
index 0000000..07b2a15
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_proj.zig
@@ -0,0 +1,323 @@
+//! MiniMax-M3.1-Flash fp16 index projection and pick under the contract on CUDA, float64 references.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const Dense = contract.dense.Dense;
+const px = cuda.minimax_m3_proj;
+
+const hidden = 6144;
+const iq_w = 256; // a rank's two index heads
+const ik_w = 128;
+
+fn chain(s: c.Shape) usize {
+    return s.k / 128 + 3 + 5;
+}
+
+/// bf16 or fp32 input to an fp16 or bf16 output; the fp32 form must equal the bf16 form's bits.
+pub const Form = enum { bf16_f16, f32_f16, bf16_bf16 };
+
+pub fn projSpec(f: Form) c.Spec {
+    return .{
+        .name = switch (f) {
+            .bf16_f16 => "cuda minimax_m3_proj tf_mm3_proj_bf16 (fp16 out)",
+            .f32_f16 => "cuda minimax_m3_proj tf_mm3_proj_f32 (fp16 out)",
+            .bf16_bf16 => "cuda minimax_m3_proj tf_mm3_proj_bf16 (bf16 out)",
+        },
+        .accum = .f32,
+        .depth = chain,
+        .out = if (f == .bf16_bf16) .bf16 else .f16,
+        .replaces = if (f == .f32_f16) "tf_mm3_proj_bf16" else null,
+        // 4 rows a warp, 4 outputs a block, 128 values a step of the reduction
+        .tiles = .{ .{ .size = px.row_group }, .{ .size = px.warps, .step = 1, .min = 1 }, .{ .size = px.chunk, .step = px.chunk, .min = px.chunk } },
+        .served = &.{
+            .{ .rows = 1, .n = iq_w + ik_w, .k = hidden },
+            .{ .rows = 5, .n = iq_w + ik_w, .k = hidden },
+            .{ .rows = 17, .n = iq_w + ik_w, .k = hidden },
+            .{ .rows = 64, .n = iq_w + ik_w, .k = hidden },
+            .{ .rows = 1, .n = iq_w, .k = hidden },
+        },
+    };
+}
+
+fn half(h: u16) f32 {
+    const v: f16 = @bitCast(h);
+    return v;
+}
+
+fn fp16(v: f32) u16 {
+    const h: f16 = @floatCast(v);
+    return @bitCast(h);
+}
+
+/// n outputs: the first (n + 1) / 2 are the query matrix, the rest the key matrix (n = 1: the key part is empty).
+pub const Proj = struct {
+    rig: rig_.Rig,
+    form: Form,
+    k: *const px.Proj,
+    d: ?Dense = null,
+    x: u64 = 0,
+    w: u64 = 0,
+    base: u64 = 0,
+    out: u64 = 0,
+
+    pub fn deinit(self: *Proj) void {
+        if (self.d) |d| d.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Proj) g.Kernel {
+        return .{ .spec = projSpec(self.form), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Proj);
+
+    pub fn prepare(self: *Proj, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (self.d) |d| d.deinit();
+        self.d = null;
+        self.rig.reset();
+        if (shape.rows == 0 or shape.n == 0 or shape.k == 0 or shape.k % px.chunk != 0) return false;
+        const a = self.rig.gpu.gpa;
+        const d = try Dense.init(a, shape, 1);
+        self.d = d;
+        d.fillX(fill, seed, 1);
+        const w = try a.alloc(u16, shape.n * shape.k);
+        defer a.free(w);
+        var prng = std.Random.DefaultPrng.init(seed ^ 0x6d6d3370);
+        const rng = prng.random();
+        const k = shape.k;
+        for (0..shape.n) |j| for (0..k) |i| {
+            // gate 4: integers mirrored into the second half, so fp32 sums are exact in any order
+            const v: f32 = if (fill != .stress) (rng.float(f32) - 0.5) * 0.1 else if (i < k / 2) @floatFromInt(1 + rng.uintLessThan(u32, 7)) else -half(w[j * k + i - k / 2]);
+            w[j * k + i] = fp16(v);
+            d.w[j * k + i] = half(w[j * k + i]);
+        };
+        if (self.form == .f32_f16) {
+            const xf = try a.alloc(f32, d.x.len);
+            defer a.free(xf);
+            for (xf, d.x) |*o, h| o.* = c.fromBf16(h);
+            self.x = try self.rig.input(std.mem.sliceAsBytes(xf));
+        } else self.x = try self.rig.input(std.mem.sliceAsBytes(d.x));
+        self.w = try self.rig.input(std.mem.sliceAsBytes(w));
+        self.out = try self.rig.output(shape.rows * shape.n * 2);
+        if (self.form == .f32_f16) self.base = try self.rig.scratch(shape.rows * shape.n * 2);
+        return true;
+    }
+
+    fn launch(self: *Proj, x_f32: bool, x: u64, out: u64) !void {
+        const sh = self.d.?.shape;
+        const n0 = (sh.n + 1) / 2;
+        const n1 = sh.n - n0;
+        const a: px.Part = .{ .w = self.w, .n = @intCast(n0), .out = out, .out_ld = sh.n };
+        const b: px.Part = .{ .w = self.w + n0 * sh.k * 2, .n = @intCast(n1), .out = out + n0 * 2, .out_ld = sh.n };
+        try self.k.project(self.rig.s, x, sh.k, x_f32, @intCast(sh.k), a, b, sh.rows, if (self.form == .bf16_bf16) .bf16 else .f16);
+    }
+
+    pub fn run(self: *Proj) !void {
+        try self.launch(self.form == .f32_f16, self.x, self.out);
+        try self.rig.s.synchronize();
+    }
+
+    /// The bf16-input form on the same values.
+    pub fn replaced(self: *Proj) ![]const u8 {
+        const d = self.d.?;
+        const xb = std.mem.sliceAsBytes(d.x);
+        const dev = try self.rig.scratch(xb.len);
+        const b: cuda.DeviceBuffer = .{ .d = self.rig.gpu.d, .ptr = dev, .len = xb.len };
+        try b.upload(0, xb);
+        try self.launch(false, dev, self.base);
+        return self.rig.bytes(self.base, self.count() * 2);
+    }
+
+    pub fn count(self: *Proj) usize {
+        return self.d.?.outputs();
+    }
+
+    pub fn reference(self: *Proj, want: []f64, mag: []f64) !void {
+        return self.d.?.reference(want, mag);
+    }
+
+    pub fn simulate(self: *Proj, acc: c.Accum, order: g.Order, out: []f64) !void {
+        return self.d.?.simulate(acc, order, out);
+    }
+};
+
+pub const pick_spec: c.Spec = .{
+    .name = "cuda minimax_m3_proj tf_mm3_pick",
+    .accum = .none,
+    .depth = pickDepth,
+    .out = .f32,
+    .nan = .{ .stated = "a NaN logit ranks last; all NaN picks the lowest id; larger logit wins, ties go to the lowest id" },
+    // a row a CTA; 256 threads stride the slice, so the edges are the thread count and its neighbours
+    .tiles = .{ .{}, .{}, .{ .size = px.pick_threads, .step = 1, .min = 1 } },
+    .served = &.{
+        .{ .rows = 1, .n = 1, .k = pick_slot },
+        .{ .rows = 5, .n = 1, .k = pick_slot },
+        .{ .rows = 128, .n = 1, .k = pick_slot },
+        .{ .rows = 1, .n = 1, .k = pick_slot - 128 },
+    },
+    .sums = .{ .f16 = 0, .bf16 = 0, .why = "a pick compares and sums nothing" },
+};
+
+fn pickDepth(_: c.Shape) usize {
+    return 1;
+}
+
+const pick_slot = 782 * 128; // the largest rank slice of the 200,064-token vocabulary
+const pick_pad = 64; // decoy logits after the slice in every row
+const pick_id0: u32 = 782 * 128; // rank 1's first id
+
+pub const Pick = struct {
+    rig: rig_.Rig,
+    k: *const px.Proj,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    logits: []f32 = &.{},
+    input: u64 = 0,
+    output: u64 = 0,
+    probe: u64 = 0,
+
+    pub fn deinit(self: *Pick) void {
+        self.rig.gpu.gpa.free(self.logits);
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Pick) g.Kernel {
+        return .{ .spec = pick_spec, .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Pick);
+
+    fn ld(self: *const Pick) usize {
+        return self.shape.k + pick_pad;
+    }
+
+    /// Row patterns by r % 8 (random, ties, NaNs, infinities, the maximum last); the padding is +inf, a decoy.
+    pub fn prepare(self: *Pick, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.rows > 128 or shape.n != 1 or shape.k == 0 or shape.k > pick_slot) return false;
+        self.rig.reset();
+        const a = self.rig.gpu.gpa;
+        a.free(self.logits);
+        self.logits = &.{};
+        self.shape = shape;
+        self.logits = try a.alloc(f32, shape.rows * self.ld());
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        const k = shape.k;
+        const nan = std.math.nan(f32);
+        for (0..shape.rows) |r| {
+            const row = self.logits[r * self.ld() ..][0..self.ld()];
+            @memset(row[k..], std.math.inf(f32));
+            for (row[0..k], 0..) |*v, i| v.* = switch (r % 8) {
+                0 => rng.floatNorm(f32) * 3,
+                1 => @floatFromInt(rng.intRangeAtMost(i32, -3, 3)),
+                2 => 1.5,
+                3 => if (i % 5 == 0) nan else rng.floatNorm(f32),
+                4 => nan,
+                5 => if (i == k / 3 or i == k - 1) std.math.inf(f32) else -std.math.inf(f32),
+                6 => -std.math.inf(f32),
+                else => if (i + 1 == k) 100 else rng.floatNorm(f32),
+            };
+            if (fill == .stress) @memset(row[0..k], 0); // ties everywhere: id 0
+        }
+        self.input = try self.rig.input(std.mem.sliceAsBytes(self.logits));
+        self.output = try self.rig.output(self.count() * 4);
+        self.probe = try self.rig.scratch(8);
+        return true;
+    }
+
+    fn launch(self: *Pick, logits: u64, out: u64, rows: usize) !void {
+        try self.k.pick(self.rig.s, logits, self.ld(), @intCast(self.shape.k), pick_id0, rows, out);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn run(self: *Pick) !void {
+        try self.launch(self.input, self.output, self.shape.rows);
+    }
+
+    pub fn count(self: *Pick) usize {
+        return self.shape.rows * 2;
+    }
+
+    const Best = struct { logit: f32, id: u32 };
+
+    /// The oracle: a linear scan with the stated order.
+    fn expected(row: []const f32) Best {
+        var best: Best = .{ .logit = row[0], .id = 0 };
+        for (row[1..], 1..) |v, i| {
+            const better = if (std.math.isNan(v)) false else if (std.math.isNan(best.logit)) true else v > best.logit;
+            if (better) best = .{ .logit = v, .id = @intCast(i) };
+        }
+        return .{ .logit = best.logit, .id = pick_id0 + best.id };
+    }
+
+    pub fn reference(self: *Pick, want: []f64, mag: []f64) !void {
+        for (0..self.shape.rows) |r| {
+            const e = expected(self.logits[r * self.ld() ..][0..self.shape.k]);
+            want[2 * r] = e.logit;
+            want[2 * r + 1] = @as(f32, @bitCast(e.id));
+            mag[2 * r] = 0;
+            mag[2 * r + 1] = 0;
+        }
+    }
+
+    /// Bits, not tolerances: the winning logit's bits (any NaN for an all-NaN row), its id, the guards, the inputs.
+    pub fn check(self: *Pick, at: g.Gate) !?[]const u8 {
+        const a = self.rig.gpu.gpa;
+        const actual = try a.dupe(u8, try self.rig.outputBytes());
+        defer a.free(actual);
+        for (0..self.shape.rows) |r| {
+            const e = expected(self.logits[r * self.ld() ..][0..self.shape.k]);
+            const got_bits = std.mem.readInt(u32, actual[8 * r ..][0..4], .little);
+            const got_id = std.mem.readInt(u32, actual[8 * r + 4 ..][0..4], .little);
+            const got: f32 = @bitCast(got_bits);
+            if (std.math.isNan(e.logit)) {
+                if (!std.math.isNan(got)) return "an all-NaN row did not return NaN";
+            } else if (got_bits != @as(u32, @bitCast(e.logit))) return "the winning logit's bits differ from the scan's";
+            if (got_id != e.id) return "the winning id differs from the lowest-id scan";
+            if (at == .shapes) {
+                try self.launch(self.input + r * self.ld() * 4, self.probe, 1);
+                if (!std.mem.eql(u8, actual[8 * r ..][0..8], try self.rig.bytes(self.probe, 8))) return "a batched row differs from the same row picked alone";
+            }
+        }
+        if (!try self.rig.intact()) return "the pick changed a buffer guard";
+        if (!std.mem.eql(u8, std.mem.sliceAsBytes(self.logits), try self.rig.inputBytes())) return "the pick changed the logits";
+        return null;
+    }
+};
+
+/// tf-cuda-test mm3-proj-contract: these kernels alone through gates 1 to 4.
+pub fn run(gpu: @import("check.zig").Gpu) !void {
+    const check = @import("check.zig");
+    const a = gpu.gpa;
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var k = try px.Proj.load(gpu.d);
+    defer k.unload();
+    var projs: [3]Proj = undefined;
+    for (std.enums.values(Form), &projs) |f, *x| x.* = .{ .rig = .{ .gpu = gpu, .s = s }, .form = f, .k = &k };
+    defer for (&projs) |*x| x.deinit();
+    var pick: Pick = .{ .rig = .{ .gpu = gpu, .s = s }, .k = &k };
+    defer pick.deinit();
+    var kernels: std.ArrayList(g.Kernel) = .empty;
+    defer kernels.deinit(a);
+    for (&projs) |*x| try kernels.append(a, x.kernel());
+    try kernels.append(a, pick.kernel());
+    var t: g.Tally = .{};
+    try g.runAll(a, kernels.items, 0x6d33, &t);
+    std.debug.print("SUMMARY mm3-proj-contract {d} kernels: {d} pass gates 1-4, {d} fail, {d} known findings\n", .{ t.kernels, t.passed, t.failed, t.known });
+    try check.expect(t.failed == 0, "mm3-proj-contract: {d} gate failures", .{t.failed});
+}
+
+test "the served shapes fit the launches, and the pick's slice is rank 0's largest share" {
+    for (projSpec(.bf16_f16).served) |s| {
+        _ = try px.projLaunch(s.rows, s.n);
+        try px.checkProj(s.k, s.k);
+    }
+    for (pick_spec.served) |s| _ = try px.pickLaunch(s.rows, s.k, s.k + pick_pad);
+    try std.testing.expectEqual(@as(usize, 100_096), pick_slot);
+    try std.testing.expectEqual(@as(?[]const u8, "tf_mm3_proj_bf16"), projSpec(.f32_f16).replaces);
+}
