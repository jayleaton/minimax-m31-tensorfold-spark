+//! MiniMax-M3.1-Flash row kernels, host only: table mirror arithmetic, paged addressing, host twins, mutants, records.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const pool_mod = @import("mm3_pool");
+const plan = @import("mm3_plan");
+const twin = @import("minimax_rows_twin.zig");
+
+const mr = core.minimax_ref;
+const c = core.contract.spec;
+const g = cuda.minimax_m3_rows.geom;
+const geom = cuda.minimax_m3_sparse.geom;
+const testing = std.testing;
+const registry = core.contract.registry;
+
+test {
+    _ = plan;
+    _ = cuda.minimax_m3_rows;
+}
+
+fn must(ok: bool, src: std.builtin.SourceLocation) !void {
+    if (!ok) {
+        std.debug.print("expected true at line {d}\n", .{src.line});
+        return error.TestExpectedTrue;
+    }
+}
+
+fn bf16v(rng: std.Random, n: usize, sd: f32) ![]f32 {
+    const v = try testing.allocator.alloc(f32, n);
+    for (v) |*x| x.* = c.fromBf16(c.toBf16(rng.floatNorm(f32) * sd));
+    return v;
+}
+
+fn fp16v(rng: std.Random, n: usize, sd: f32) ![]f32 {
+    const v = try testing.allocator.alloc(f32, n);
+    for (v) |*x| {
+        const h: f16 = @floatCast(rng.floatNorm(f32) * sd);
+        x.* = h;
+    }
+    return v;
+}
+
+fn weights(rng: std.Random) [128]f32 {
+    var w: [128]f32 = undefined;
+    for (&w) |*x| x.* = 1 + rng.floatNorm(f32) * 0.3;
+    return w;
+}
+
+test "block table offsets: slot * max_pages entries, int32 overflow refused" {
+    try testing.expectEqual(@as(i32, 0), try g.entryOffset(0, 1024));
+    try testing.expectEqual(@as(i32, 3 * 1024), try g.entryOffset(3, 1024));
+    try testing.expectEqual(@as(i32, std.math.maxInt(i32)), try g.entryOffset(std.math.maxInt(i32), 1));
+    try testing.expectError(error.Overflow, g.entryOffset(1 << 20, 1 << 12));
+    try testing.expectError(error.Overflow, g.entryOffset(std.math.maxInt(usize), 2));
+    const r = try g.entryBytes(4, 1024, 2, 10, 5);
+    try testing.expectEqual(@as(usize, (2 * 1024 + 10) * 4), r.off);
+    try testing.expectEqual(@as(usize, 20), r.len);
+    try testing.expectError(error.BadSlot, g.entryBytes(4, 1024, 4, 0, 1));
+    try testing.expectError(error.TableFull, g.entryBytes(4, 1024, 0, 1020, 5));
+    _ = try g.entryBytes(4, 1024, 3, 1020, 4);
+}
+
+test "row_tab: segments tile the rows, gaps and bad slots are refused" {
+    var out: [7]i32 = undefined;
+    try g.fillRowTab(&out, &.{ .{ .slot = 2, .rows = 3 }, .{ .slot = 0, .rows = 1 }, .{ .slot = 1, .rows = 3 } }, 3, 64);
+    try testing.expectEqualSlices(i32, &.{ 128, 128, 128, 0, 64, 64, 64 }, &out);
+    try testing.expectError(error.Gap, g.fillRowTab(&out, &.{.{ .slot = 0, .rows = 6 }}, 3, 64));
+    try testing.expectError(error.Gap, g.fillRowTab(&out, &.{ .{ .slot = 0, .rows = 4 }, .{ .slot = 1, .rows = 4 } }, 3, 64));
+    try testing.expectError(error.BadSlot, g.fillRowTab(&out, &.{.{ .slot = 3, .rows = 7 }}, 3, 64));
+}
+
+/// A device copy kept as bytes, written through the same ranges Mirror.put uses.
+const FakeDevice = struct {
+    bytes: []u8,
+    slots: usize,
+    max_pages: usize,
+    fail: bool = false,
+
+    fn call(ctx: *anyopaque, slot: u32, from: usize, entries: []const i32) anyerror!void {
+        const self: *FakeDevice = @ptrCast(@alignCast(ctx));
+        const r = try g.entryBytes(self.slots, self.max_pages, slot, from, entries.len);
+        if (self.fail) return error.UploadFailed;
+        @memcpy(self.bytes[r.off..][0..r.len], std.mem.sliceAsBytes(entries));
+    }
+};
+
+test "the byte ranges keep a device copy equal to the host Tables, through writes, a failed upload and a clear" {
+    const slots = 3;
+    const max_pages = 40;
+    var t = try pool_mod.Tables.init(testing.allocator, slots, max_pages);
+    defer t.deinit();
+    const bytes = try testing.allocator.alloc(u8, slots * max_pages * 4);
+    defer testing.allocator.free(bytes);
+    @memset(bytes, 0xff);
+    var dev: FakeDevice = .{ .bytes = bytes, .slots = slots, .max_pages = max_pages };
+    t.upload = .{ .ctx = &dev, .call = FakeDevice.call };
+    try t.write(1, &.{ 70, 71, 72 }, 0);
+    try t.write(2, &.{ 5, 9 }, 0);
+    try t.write(1, &.{ 73, 74 }, 3);
+    try testing.expectEqualSlices(u8, std.mem.sliceAsBytes(t.rows), bytes);
+    dev.fail = true;
+    try testing.expectError(error.UploadFailed, t.write(2, &.{ 11, 12 }, 2));
+    try testing.expectEqualSlices(u8, std.mem.sliceAsBytes(t.rows), bytes);
+    dev.fail = false;
+    try testing.expectError(error.TableFull, t.write(0, &.{ 1, 2 }, 39));
+    // a restore pushes whole rows, then the device agrees with every slot's entries
+    for (0..slots) |s| try FakeDevice.call(&dev, @intCast(s), 0, t.row(@intCast(s)));
+    try testing.expectEqualSlices(u8, std.mem.sliceAsBytes(t.rows), bytes);
+}
+
+test "row_tab offsets index the real Tables: tables[row_tab[r] + pos / 128] is the page Tables.page names" {
+    const max_pages = 40;
+    var t = try pool_mod.Tables.init(testing.allocator, 4, max_pages);
+    defer t.deinit();
+    try t.write(0, &.{ 4, 5, 6 }, 0);
+    try t.write(1, &.{ 20, 21 }, 0);
+    try t.write(3, &.{ 31, 30, 29, 28 }, 0);
+    var rt: [9]i32 = undefined;
+    try g.fillRowTab(&rt, &.{ .{ .slot = 3, .rows = 4 }, .{ .slot = 0, .rows = 2 }, .{ .slot = 1, .rows = 3 } }, 4, max_pages);
+    const pos = [_]i32{ 0, 127, 128, 511, 300, 5, 255, 200, 129 };
+    try g.checkCall(t.rows, max_pages, &rt, &pos, 0, 9);
+    for (rt, pos, 0..) |off, p, r| {
+        const slot: u32 = @intCast(@divExact(off, max_pages));
+        const want = t.page(slot, @intCast(@divTrunc(p, 128))).?;
+        try testing.expectEqual(want, try g.pageOf(t.rows, max_pages, @intCast(off), @intCast(p)));
+        _ = r;
+    }
+    // slot 1 owns two pages: its row at position 256 has no page, and positions past the row are another error
+    try testing.expectError(error.NoPage, g.checkCall(t.rows, max_pages, &rt, &.{ 0, 0, 0, 0, 0, 0, 0, 0, 256 }, 0, 9));
+    try testing.expectError(error.PastTable, g.pageOf(t.rows, max_pages, 0, max_pages * 128));
+    // a prompt chunk of one stream: no row_tab, the table pointer is the slot's row (entry offset slot * max_pages)
+    const slot3 = t.rows[3 * max_pages ..];
+    try g.checkCall(slot3, max_pages, null, null, 384, 100);
+    try testing.expectError(error.NoPage, g.checkCall(slot3, max_pages, null, null, 384, 129));
+    // padded rows (negative positions) are skipped
+    try g.checkCall(t.rows, max_pages, null, &.{ -1, 5 }, 0, 2);
+    try testing.expectEqual(@as(usize, 1), g.pagesNeeded(127));
+    try testing.expectEqual(@as(usize, 2), g.pagesNeeded(128));
+}
+
+test "kernel addressing equals the pool's page map and the T5 geometry for every (page, layer, K/V/IK, head, token)" {
+    const kvh = 2;
+    const layers = 3;
+    const gp: geom.Pool = .{ .kvh = kvh, .layers = layers };
+    const dims: pool_mod.Dims = .{ .layers = layers, .kv_heads = kvh, .head_dim = 128, .index_dim = 128 };
+    const map = dims.map();
+    try testing.expectEqual(@as(u64, gp.pageBytes()), dims.pageBytes());
+    for ([_]usize{ 0, 1, 6 }) |page| for (0..layers) |ly| for ([_]usize{ 0, 1, 77, 127 }) |t| {
+        for (0..kvh) |h| {
+            const k = page * gp.pageBytes() + gp.layerOff(ly) + twin.elem(kvh, 0, h, t) * 2;
+            const v = page * gp.pageBytes() + gp.layerOff(ly) + twin.elem(kvh, 1, h, t) * 2;
+            try testing.expectEqual(gp.kv(page, ly, 0, h, t), k);
+            try testing.expectEqual(gp.kv(page, ly, 1, h, t), v);
+            try testing.expectEqual(map.page(@intCast(page)) + map.k(@intCast(ly), @intCast(h)) + t * 256, k);
+            try testing.expectEqual(map.page(@intCast(page)) + map.v(@intCast(ly), @intCast(h)) + t * 256, v);
+        }
+        const ik = page * gp.pageBytes() + gp.layerOff(ly) + twin.ikElem(kvh, t) * 2;
+        try testing.expectEqual(gp.ik(page, ly, t), ik);
+        try testing.expectEqual(map.page(@intCast(page)) + map.ik(@intCast(ly)) + t * 256, ik);
+    };
+}
+
+var tol_rel: f64 = 0x1p-8;
+
+fn near(got: u16, want: f64) bool {
+    const v: f64 = c.fromBf16(got);
+    return @abs(v - want) <= @abs(want) * tol_rel + 2e-5;
+}
+
+/// The float64 reference of one head: Gemma norm with weight w + add (if on), bf16 rounding (if asked), partial RoPE.
+fn refHead(x: []const f32, w: []const f32, norm_on: bool, add: f64, rope_on: bool, pos: usize, o: twin.Opts) [128]f64 {
+    var xs: [128]f64 = undefined;
+    for (&xs, x[0..128]) |*d, s| d.* = s;
+    if (norm_on) {
+        var ws: [128]f64 = undefined;
+        for (&ws, w[0..128]) |*d, v| d.* = v + add;
+        mr.gemmaNorm(&xs, &ws, o.eps, false, &xs);
+        mr.roundAll(o.flags.round_norm, &xs);
+    }
+    if (rope_on) mr.rope(&xs, o.rot, pos, o.theta, if (o.flags.gptj) .gptj_interleaved else .neox_half);
+    return xs;
+}
+
+const fx_kvh = 2;
+const fx_pages = 6;
+const n_pages = 9;
+const fx_layers = 2;
+const layer = 1;
+const pool_geom: geom.Pool = .{ .kvh = fx_kvh, .layers = fx_layers };
+
+/// Random inputs for `rows` rows of a rank (32 q, 2 index, 2 kv heads), a shuffled table and a NaN-poisoned pool.
+const Fix = struct {
+    rows: usize,
+    h: twin.Heads = .{},
+    q: []f32,
+    k: []f32,
+    v: []f32,
+    iq: []f32,
+    ik: []f32,
+    nm: twin.Norms,
+    pool: []u16,
+    tables: []i32,
+    q_out: []u16,
+    iq_out: []u16,
+
+    fn init(rng: std.Random, rows: usize, index_fp16: bool) !Fix {
+        const a = testing.allocator;
+        const h: twin.Heads = .{};
+        const pool = try a.alloc(u16, n_pages * pool_geom.pageBytes() / 2);
+        @memset(pool, c.toBf16(std.math.nan(f32)));
+        const tables = try a.alloc(i32, 2 * fx_pages);
+        @memset(tables, -1);
+        var perm: [n_pages]i32 = undefined;
+        for (&perm, 0..) |*x, i| x.* = @intCast(i);
+        rng.shuffle(i32, &perm);
+        @memcpy(tables[fx_pages .. fx_pages + 5], perm[0..5]);
+        @memcpy(tables[0..3], perm[5..8]);
+        const mk = if (index_fp16) &fp16v else &bf16v;
+        return .{
+            .rows = rows,
+            .q = try bf16v(rng, rows * h.nq * 128, 2),
+            .k = try bf16v(rng, rows * fx_kvh * 128, 2),
+            .v = try bf16v(rng, rows * fx_kvh * 128, 2),
+            .iq = try mk(rng, rows * h.niq * 128, 2),
+            .ik = try mk(rng, rows * 128, 2),
+            .nm = .{ .q = weights(rng), .k = weights(rng), .iq = weights(rng), .ik = weights(rng) },
+            .pool = pool,
+            .tables = tables,
+            .q_out = try a.alloc(u16, rows * h.nq * 128),
+            .iq_out = try a.alloc(u16, rows * h.niq * 128),
+        };
+    }
+
+    fn deinit(f: *Fix) void {
+        inline for (.{ "q", "k", "v", "iq", "ik", "pool", "tables", "q_out", "iq_out" }) |n| testing.allocator.free(@field(f, n));
+    }
+
+    fn target(f: *Fix, row_tab: ?[]const i32, pos: ?[]const i32, pos0: i32) twin.Target {
+        return .{ .q = f.q_out, .iq = f.iq_out, .pool = f.pool, .tables = f.tables, .max_pages = fx_pages, .row_tab = row_tab, .pos = pos, .pos0 = pos0, .page_bytes = pool_geom.pageBytes(), .layer_off = pool_geom.layerOff(layer) };
+    }
+
+    fn inputs(f: *const Fix) twin.Inputs {
+        return .{ .q = f.q, .k = f.k, .v = f.v, .iq = f.iq, .ik = f.ik };
+    }
+
+    /// The pool's row for (page id, K/V, head, token).
+    fn cell(f: *const Fix, page: usize, which: usize, head: usize, t: usize) []const u16 {
+        return f.pool[pool_geom.kv(page, layer, which, head, t) / 2 ..][0..128];
+    }
+
+    fn ikCell(f: *const Fix, page: usize, t: usize) []const u16 {
+        return f.pool[pool_geom.ik(page, layer, t) / 2 ..][0..128];
+    }
+};
+
+fn expectRow(got: []const u16, want: [128]f64) !void {
+    for (got, want) |x, y| try testing.expect(near(x, y));
+}
+
+/// Every output of a call against the float64 reference: scratch q and iq, and K, V and IK in their pages.
+fn checkCall(f: *const Fix, o: twin.Opts, pos: []const i32, row_tab: ?[]const i32) !void {
+    const fl = o.flags;
+    tol_rel = if (fl.round_norm) 0x1p-6 else 0x1p-8; // a value near a bf16 rounding boundary may round either way in the middle
+    defer tol_rel = 0x1p-8;
+    for (0..f.rows) |r| {
+        const p: usize = @intCast(pos[r]);
+        const off: usize = if (row_tab) |t| @intCast(t[r]) else 0;
+        const page: usize = @intCast(f.tables[off + p / 128]);
+        for (0..f.h.nq) |i| try expectRow(f.q_out[(r * f.h.nq + i) * 128 ..][0..128], refHead(f.q[(r * f.h.nq + i) * 128 ..], &f.nm.q, fl.norm_qk, o.w_add, true, p, o));
+        for (0..f.h.niq) |i| try expectRow(f.iq_out[(r * f.h.niq + i) * 128 ..][0..128], refHead(f.iq[(r * f.h.niq + i) * 128 ..], &f.nm.iq, fl.norm_index, o.w_add_index, fl.index_rope, p, o));
+        for (0..fx_kvh) |i| {
+            try expectRow(f.cell(page, 0, i, p % 128), refHead(f.k[(r * fx_kvh + i) * 128 ..], &f.nm.k, fl.norm_qk, o.w_add, true, p, o));
+            for (f.cell(page, 1, i, p % 128), f.v[(r * fx_kvh + i) * 128 ..][0..128]) |x, y| try testing.expectEqual(c.toBf16(y), x);
+        }
+        try expectRow(f.ikCell(page, p % 128), refHead(f.ik[r * 128 ..], &f.nm.ik, fl.norm_index, o.w_add_index, fl.index_rope, p, o));
+    }
+}
+
+fn okCall(f: *const Fix, o: twin.Opts, pos: []const i32, row_tab: ?[]const i32) bool {
+    checkCall(f, o, pos, row_tab) catch return false;
+    return true;
+}
+
+test "a decode window across a page edge and a prompt chunk: every output matches the float64 reference" {
+    var prng = std.Random.DefaultPrng.init(21);
+    const rng = prng.random();
+    // slot 0 (table row 0) holds 3 pages, slot 1 (row at entry 6) holds 5; the window mixes both streams
+    var f = try Fix.init(rng, 5, true);
+    defer f.deinit();
+    const pos = [_]i32{ 126, 127, 128, 129, 300 };
+    const row_tab = [_]i32{ 0, 0, 0, 0, fx_pages };
+    const o: twin.Opts = .{};
+    try testing.expectEqual(@as(i32, 0), twin.call(5, f.h, o, f.inputs(), &f.nm, f.target(&row_tab, &pos, 0), .none));
+    try checkCall(&f, o, &pos, &row_tab);
+    // a prompt chunk of slot 1: positions pos0 + r, one table, the same rows' bits as the window gave
+    var p = try Fix.init(rng, 5, true);
+    defer p.deinit();
+    try testing.expectEqual(@as(i32, 0), twin.call(5, p.h, o, p.inputs(), &p.nm, p.target(null, null, 125), .none));
+    try checkCall(&p, o, &.{ 125, 126, 127, 128, 129 }, null);
+}
+
+/// The weights as the loader would store them raw: the folded 1 + w minus 1, for a kernel that adds 1 itself.
+fn rawNorms(f: *Fix) void {
+    for (&f.nm.q, &f.nm.k, &f.nm.iq, &f.nm.ik) |*a, *b, *cc, *d| {
+        a.* -= 1;
+        b.* -= 1;
+        cc.* -= 1;
+        d.* -= 1;
+    }
+}
+
+test "the switches: GPT-J layout, no index rope, bf16 norm rounding, raw weights with the offset, bf16 index inputs" {
+    var prng = std.Random.DefaultPrng.init(22);
+    const rng = prng.random();
+    const variants = [_]twin.Opts{
+        .{ .flags = .{ .gptj = true } },
+        .{ .flags = .{ .index_rope = false } },
+        .{ .flags = .{ .round_norm = true } },
+        .{ .w_add = 1, .w_add_index = 1 },
+        .{ .flags = .{ .index_fp16 = false } },
+        .{ .flags = .{ .norm_qk = false, .norm_index = false } },
+    };
+    for (variants) |o| {
+        var f = try Fix.init(rng, 3, o.flags.index_fp16);
+        defer f.deinit();
+        if (o.w_add == 1) rawNorms(&f);
+        const pos = [_]i32{ 3, 130, 4 * 128 + 127 };
+        const rt = [_]i32{ fx_pages, fx_pages, fx_pages };
+        try testing.expectEqual(@as(i32, 0), twin.call(3, f.h, o, f.inputs(), &f.nm, f.target(&rt, &pos, 0), .none));
+        try checkCall(&f, o, &pos, &rt);
+    }
+}
+
+test "a row's bits do not depend on the window: alone, with neighbours, or at another row index" {
+    var prng = std.Random.DefaultPrng.init(23);
+    const rng = prng.random();
+    var f = try Fix.init(rng, 4, true);
+    defer f.deinit();
+    const o: twin.Opts = .{};
+    const pos = [_]i32{ 200, 7, 515, 129 };
+    const rt = [_]i32{ fx_pages, fx_pages, fx_pages, fx_pages };
+    _ = twin.call(4, f.h, o, f.inputs(), &f.nm, f.target(&rt, &pos, 0), .none);
+    const whole_q = try testing.allocator.dupe(u16, f.q_out);
+    defer testing.allocator.free(whole_q);
+    const whole_pool = try testing.allocator.dupe(u16, f.pool);
+    defer testing.allocator.free(whole_pool);
+    // row 2 alone: its inputs moved to row 0 of a one-row call
+    var one = f;
+    one.rows = 1;
+    one.q = f.q[2 * 32 * 128 ..][0 .. 32 * 128];
+    one.k = f.k[2 * fx_kvh * 128 ..][0 .. fx_kvh * 128];
+    one.v = f.v[2 * fx_kvh * 128 ..][0 .. fx_kvh * 128];
+    one.iq = f.iq[2 * 2 * 128 ..][0 .. 2 * 128];
+    one.ik = f.ik[2 * 128 ..][0..128];
+    one.q_out = try testing.allocator.alloc(u16, 32 * 128);
+    defer testing.allocator.free(one.q_out);
+    one.iq_out = try testing.allocator.alloc(u16, 2 * 128);
+    defer testing.allocator.free(one.iq_out);
+    one.pool = try testing.allocator.dupe(u16, f.pool);
+    defer testing.allocator.free(one.pool);
+    _ = twin.call(1, one.h, o, one.inputs(), &one.nm, one.target(&.{fx_pages}, &.{515}, 0), .none);
+    try testing.expectEqualSlices(u16, whole_q[2 * 32 * 128 ..][0 .. 32 * 128], one.q_out);
+    try testing.expectEqualSlices(u16, whole_pool, one.pool);
+}
+
+test "pages: a missing page or a position past the table sets the status bit and writes nothing to the pool" {
+    var prng = std.Random.DefaultPrng.init(24);
+    const rng = prng.random();
+    var f = try Fix.init(rng, 3, true);
+    defer f.deinit();
+    const poison = try testing.allocator.dupe(u16, f.pool);
+    defer testing.allocator.free(poison);
+    // slot 0 has pages for blocks 0..2: block 3 has none; block 6 is past the 6-entry row
+    const rt = [_]i32{ 0, 0, 0 };
+    const st = twin.call(3, f.h, .{}, f.inputs(), &f.nm, f.target(&rt, &.{ 3 * 128, 6 * 128, -1 }, 0), .none);
+    try testing.expectEqual(g.status_no_page | g.status_past_table, st);
+    try testing.expectEqualSlices(u16, poison, f.pool);
+    // q still lands for the rows with a position, and a padded row (-1) writes nothing at all
+    try expectRow(f.q_out[0..128], refHead(f.q[0..128], &f.nm.q, true, 0, true, 3 * 128, .{}));
+}
+
+test "writer mutants: each planted fault fails the reference check the real twin passes" {
+    var prng = std.Random.DefaultPrng.init(25);
+    const rng = prng.random();
+    const pos = [_]i32{ 1_000_003 % 640, 640 - 1, 130 };
+    const rt = [_]i32{ fx_pages, fx_pages, fx_pages };
+    for (std.enums.values(twin.Mutant)) |m| {
+        if (m == .split_by_rows or m == .reorder_chains or m == .f32_angle) continue;
+        var f = try Fix.init(rng, 3, true);
+        defer f.deinit();
+        var o: twin.Opts = .{};
+        if (m == .no_plus_one) {
+            o.w_add = 1;
+            o.w_add_index = 1;
+            rawNorms(&f);
+        }
+        _ = twin.call(3, f.h, o, f.inputs(), &f.nm, f.target(&rt, &pos, 0), m);
+        try testing.expectEqual(m == .none, okCall(&f, o, &pos, &rt));
+    }
+}
+
+test "rows aliasing one (page, slot) cannot all be checked: the check flags the planted alias, distinct streams pass" {
+    // The GPU contract once put 8 decode rows at position 0 behind one table: one slot, one survivor; see it.
+    var prng = std.Random.DefaultPrng.init(26);
+    const rng = prng.random();
+    const pos = [_]i32{ 0, 0 };
+    var f = try Fix.init(rng, 2, true);
+    defer f.deinit();
+    const alias = [_]i32{ 0, 0 };
+    _ = twin.call(2, f.h, .{}, f.inputs(), &f.nm, f.target(&alias, &pos, 0), .none);
+    try testing.expect(!okCall(&f, .{}, &pos, &alias));
+    // the same positions in two streams (two tables, two pages): each row's cells are its own
+    var h = try Fix.init(rng, 2, true);
+    defer h.deinit();
+    const own = [_]i32{ 0, fx_pages };
+    h.tables[fx_pages] = if (h.tables[0] == 0) 1 else 0;
+    _ = twin.call(2, h.h, .{}, h.inputs(), &h.nm, h.target(&own, &pos, 0), .none);
+    try testing.expect(okCall(&h, .{}, &pos, &own));
+}
+
+test "angles: float64 sincos rounded once; an fp32 angle is off by whole bf16 steps at a million positions" {
+    const pos = 1_048_573;
+    var worst: f64 = 0;
+    var worst_bad: f64 = 0;
+    for (0..32) |i| {
+        const inv = std.math.pow(f64, 1e7, -2 * @as(f64, @floatFromInt(i)) / 64);
+        const ang = @as(f64, pos) * inv;
+        const good = twin.angle(pos, i, 64, 1e7, .none);
+        const bad = twin.angle(pos, i, 64, 1e7, .f32_angle);
+        worst = @max(worst, @abs(@as(f64, good[0]) - @cos(ang)), @abs(@as(f64, good[1]) - @sin(ang)));
+        worst_bad = @max(worst_bad, @abs(@as(f64, bad[0]) - @cos(ang)), @abs(@as(f64, bad[1]) - @sin(ang)));
+    }
+    try testing.expect(worst < 1e-7);
+    try testing.expect(worst_bad > 1e-3);
+}
+
+const hidden = 6144;
+const experts = 128;
+
+/// tf_mm3_router_* over a call: every (row, expert) is its own fixed-order dot, whichever tile it falls in.
+fn routerCall(x: []const f32, w: []const f32, rows: usize, m: twin.Mutant, out: []f32) void {
+    for (0..rows) |r| for (0..experts) |e| {
+        out[r * experts + e] = twin.router(x[r * hidden ..][0..hidden], w[e * hidden ..][0..hidden], hidden, rows, m);
+    };
+}
+
+fn wide(a: std.mem.Allocator, v: []const f32) ![]f64 {
+    const o = try a.alloc(f64, v.len);
+    for (o, v) |*d, s| d.* = s;
+    return o;
+}
+
+test "router: fp32 logits track the float64 dot within the fp32 chain bound, for 1 to 17 rows" {
+    var prng = std.Random.DefaultPrng.init(31);
+    const rng = prng.random();
+    const x = try bf16v(rng, 17 * hidden, 1.5);
+    defer testing.allocator.free(x);
+    const w = try testing.allocator.alloc(f32, experts * hidden);
+    defer testing.allocator.free(w);
+    for (w) |*v| v.* = rng.floatNorm(f32) * 0.03;
+    const out = try testing.allocator.alloc(f32, 17 * experts);
+    defer testing.allocator.free(out);
+    routerCall(x, w, 17, .none, out);
+    // depth: 48 fma steps a lane chain, the 4-chain sum and the 5-level tree
+    const u: f64 = 0x1p-24;
+    for (0..17) |r| for (0..experts) |e| {
+        var sum: f64 = 0;
+        var mag: f64 = 0;
+        for (x[r * hidden ..][0..hidden], w[e * hidden ..][0..hidden]) |a, b| {
+            sum += @as(f64, a) * b;
+            mag += @abs(@as(f64, a) * b);
+        }
+        try testing.expect(@abs(out[r * experts + e] - sum) <= c.gamma(48 + 3 + 5, u) * mag);
+    };
+}
+
+test "router: a row's bits are the same in a call of 1, 3, 4, 5 or 17 rows; a split-K by row count is caught" {
+    var prng = std.Random.DefaultPrng.init(32);
+    const rng = prng.random();
+    const x = try bf16v(rng, 17 * hidden, 2);
+    defer testing.allocator.free(x);
+    const w = try testing.allocator.alloc(f32, experts * hidden);
+    defer testing.allocator.free(w);
+    for (w) |*v| v.* = rng.floatNorm(f32) * 0.05;
+    const full = try testing.allocator.alloc(f32, 17 * experts);
+    defer testing.allocator.free(full);
+    routerCall(x, w, 17, .none, full);
+    var part: [17 * experts]f32 = undefined;
+    for ([_]usize{ 1, 3, 4, 5 }) |n| {
+        routerCall(x[0 .. n * hidden], w, n, .none, part[0 .. n * experts]);
+        try testing.expectEqualSlices(f32, full[0 .. n * experts], part[0 .. n * experts]);
+    }
+    // the same rows through a tail window: row 16 alone equals row 16 of 17
+    routerCall(x[16 * hidden ..], w, 1, .none, part[0..experts]);
+    try testing.expectEqualSlices(f32, full[16 * experts ..][0..experts], part[0..experts]);
+    // the planted faults: a depth that follows the row count, and another order of the lane chains
+    routerCall(x, w, 17, .split_by_rows, &part);
+    var one: [experts]f32 = undefined;
+    routerCall(x[0..hidden], w, 1, .split_by_rows, &one);
+    try testing.expect(!std.mem.eql(f32, part[0..experts], one[0..]));
+    routerCall(x, w, 17, .reorder_chains, &part);
+    try testing.expect(!std.mem.eql(f32, full[0 .. 17 * experts], part[0 .. 17 * experts]));
+}
+
+test "router: NaN and infinities reach the logit as float64 arithmetic gives them" {
+    var prng = std.Random.DefaultPrng.init(33);
+    const rng = prng.random();
+    const x = try bf16v(rng, 4 * hidden, 1);
+    defer testing.allocator.free(x);
+    const w = try testing.allocator.alloc(f32, experts * hidden);
+    defer testing.allocator.free(w);
+    for (w) |*v| v.* = rng.floatNorm(f32) * 0.05;
+    x[0 * hidden + 77] = std.math.nan(f32);
+    x[1 * hidden + 5000] = std.math.inf(f32);
+    x[2 * hidden + 6143] = -std.math.inf(f32);
+    x[2 * hidden + 3] = std.math.inf(f32);
+    const out = try testing.allocator.alloc(f32, 4 * experts);
+    defer testing.allocator.free(out);
+    routerCall(x, w, 4, .none, out);
+    for (0..4) |r| {
+        const xr = try wide(testing.allocator, x[r * hidden ..][0..hidden]);
+        defer testing.allocator.free(xr);
+        for (0..experts) |e| {
+            var sum: f64 = 0;
+            for (xr, w[e * hidden ..][0..hidden]) |a, b| sum += a * b;
+            try testing.expectEqual(c.classOf(sum), c.classOf(out[r * experts + e]));
+        }
+    }
+}
+
+test "gate 5: the three launches are registered, match the geometry, and fit every chip" {
+    const want = [_]struct { sym: []const u8, threads: u32, static: u32 }{
+        .{ .sym = "tf_mm3_rows", .threads = g.rows_threads, .static = 4608 },
+        .{ .sym = "tf_mm3_router_bf16", .threads = g.router_threads, .static = 0 },
+        .{ .sym = "tf_mm3_router_f32", .threads = g.router_threads, .static = 0 },
+    };
+    var mine: [3]registry.CudaRecord = undefined;
+    for (want, &mine) |w, *m| {
+        const rec = for (registry.cuda) |r| {
+            if (std.mem.eql(u8, r.launch.symbol, w.sym)) break r;
+        } else return error.RecordMissing;
+        try testing.expectEqualStrings("minimax_m3_rows", rec.launch.image);
+        try testing.expectEqual(w.threads, rec.launch.threads);
+        try testing.expectEqual(@as(u32, 0), rec.launch.dynamic);
+        for (rec.usage) |u| {
+            try testing.expectEqual(w.static, u.static);
+            try testing.expectEqual(w.threads, u.bound);
+            try testing.expect(u.regs * w.threads <= 65536);
+        }
+        m.* = rec;
+    }
+    try testing.expectEqual(@as(usize, 0), try registry.checkCuda(testing.allocator, &mine, true));
+    // shared bytes the writer declares: 64 cos/sin pairs of fp32 plus 8 staged heads of 128 fp32
+    try testing.expectEqual(@as(u32, 2 * 64 * 4 + 8 * 128 * 4), mine_static());
+    // a planted control: the same launch asking for more threads than its bound must be reported
+    var over = mine[0];
+    over.launch.threads = 512;
+    try testing.expect(try registry.checkCuda(testing.allocator, &.{over}, true) > 0);
+}
+
+fn mine_static() u32 {
+    return 2 * g.max_rot_pairs * 4 + g.rows_warps * g.d * 4;
+}
diff --git a/zig/tests/minimax_rows_twin.zig b/zig/tests/minimax_rows_twin.zig
new file mode 100644
index 0000000..0b0b8a7
--- /dev/null
+++ b/zig/tests/minimax_rows_twin.zig
@@ -0,0 +1,191 @@
+//! Host twins of minimax_m3_rows.cu: the same fp32 operation order (fma only in the router) and planted mutants.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+
+const geom = cuda.minimax_m3_rows.geom;
+const c = core.contract.spec;
+
+pub const Mutant = enum {
+    none,
+    /// The weight offset is ignored: raw weights are used as if they were the folded 1 + w.
+    no_plus_one,
+    /// RoPE pairs (2i, 2i + 1) where the switch says (i, i + rot/2).
+    wrong_layout,
+    /// RoPE covers all 128 dims instead of the first 64.
+    rope_all_dims,
+    /// The rotation runs before the norm.
+    rope_first,
+    /// The angle is computed in fp32.
+    f32_angle,
+    /// K goes to the next token slot of its page.
+    next_slot,
+    /// The router's chunk count follows the row count (a split-K whose depth depends on the call).
+    split_by_rows,
+    /// The router's four lane chains are summed in a different order.
+    reorder_chains,
+};
+
+pub const Opts = struct {
+    rot: usize = 64,
+    theta: f64 = 1e7,
+    eps: f32 = 1e-6,
+    w_add: f32 = 0,
+    w_add_index: f32 = 0,
+    flags: geom.Flags = .{},
+};
+
+fn tree(v: *[32]f32) f32 {
+    var o: usize = 16;
+    while (o > 0) : (o >>= 1) {
+        var next: [32]f32 = undefined;
+        for (&next, 0..) |*n, l| n.* = v[l] + v[l ^ o];
+        v.* = next;
+    }
+    return v[0];
+}
+
+/// The kernel's norm of one head: lane l squares its 4 values in order, then the xor tree; y = (x * inv) * (w + add).
+pub fn norm(x: *[128]f32, w: *const [128]f32, o: Opts, add: f32) void {
+    var lane: [32]f32 = undefined;
+    for (&lane, 0..) |*s, l| {
+        var a = x[4 * l] * x[4 * l];
+        a = a + x[4 * l + 1] * x[4 * l + 1];
+        a = a + x[4 * l + 2] * x[4 * l + 2];
+        a = a + x[4 * l + 3] * x[4 * l + 3];
+        s.* = a;
+    }
+    const ss = tree(&lane);
+    const inv: f32 = 1.0 / @sqrt(ss / 128.0 + o.eps);
+    for (x, w) |*v, wv| v.* = v.* * inv * (wv + add);
+    if (o.flags.round_norm) for (x) |*v| {
+        v.* = c.fromBf16(c.toBf16(v.*));
+    };
+}
+
+/// The cos and sin of pair i at `pos`: float64 angle and sincos rounded once to fp32 (the mutant rounds the angle).
+pub fn angle(pos: i32, i: usize, rot: usize, theta: f64, m: Mutant) [2]f32 {
+    const inv = std.math.pow(f64, theta, -2 * @as(f64, @floatFromInt(i)) / @as(f64, @floatFromInt(rot)));
+    var ang: f64 = @as(f64, @floatFromInt(pos)) * inv;
+    if (m == .f32_angle) ang = @as(f32, @floatCast(ang));
+    return .{ @floatCast(@cos(ang)), @floatCast(@sin(ang)) };
+}
+
+/// The kernel's `rotated` for every dim of a staged head.
+pub fn rope(x: *[128]f32, pos: i32, rot: usize, theta: f64, gptj: bool, m: Mutant) void {
+    var out = x.*;
+    const r = if (m == .rope_all_dims) 128 else rot;
+    const g = if (m == .wrong_layout) !gptj else gptj;
+    const half = r / 2;
+    for (0..r) |d| {
+        const i = if (g) d >> 1 else if (d < half) d else d - half;
+        const ia = if (g) 2 * i else i;
+        const ib = if (g) ia + 1 else i + half;
+        const cs = angle(pos, i, r, theta, m);
+        const a = x[ia];
+        const b = x[ib];
+        const first = if (g) d & 1 == 0 else d < half;
+        out[d] = if (first) a * cs[0] - b * cs[1] else b * cs[0] + a * cs[1];
+    }
+    x.* = out;
+}
+
+pub const Heads = struct { nq: usize = 32, niq: usize = 2, kvh: usize = 2, ik: bool = true };
+
+/// Per-head weights, fp32 [128] each.
+pub const Norms = struct { q: [128]f32, k: [128]f32, iq: [128]f32, ik: [128]f32 };
+
+/// The projections of the rows of a call as exact fp32 values (bf16, or fp16 for the index heads), [rows][width].
+pub const Inputs = struct { q: []const f32, k: []const f32, v: []const f32, iq: []const f32, ik: []const f32 };
+
+/// Where a call writes: bf16 bit scratch for q and iq, the pool as bf16 bits, and the tables.
+pub const Target = struct {
+    q: []u16,
+    iq: []u16,
+    pool: []u16,
+    tables: []const i32,
+    max_pages: usize,
+    row_tab: ?[]const i32,
+    pos: ?[]const i32,
+    pos0: i32,
+    page_bytes: usize,
+    layer_off: usize,
+};
+
+/// One head: norm (if on), rotation (if on), bf16 bits out.
+fn head(src: []const f32, w: *const [128]f32, on_norm: bool, add: f32, on_rope: bool, pos: i32, o: Opts, m: Mutant, out: *[128]u16) void {
+    var x: [128]f32 = undefined;
+    @memcpy(&x, src[0..128]);
+    if (m == .rope_first and on_rope) rope(&x, pos, o.rot, o.theta, o.flags.gptj, .none);
+    if (on_norm) norm(&x, w, o, if (m == .no_plus_one) 0 else add);
+    if (m != .rope_first and on_rope) rope(&x, pos, o.rot, o.theta, o.flags.gptj, m);
+    for (out, x) |*b, v| b.* = c.toBf16(v);
+}
+
+/// tf_mm3_rows over `rows` rows; returns the status word.
+pub fn call(rows: usize, h: Heads, o: Opts, in: Inputs, nm: *const Norms, t: Target, m: Mutant) i32 {
+    var status: i32 = 0;
+    const f = o.flags;
+    for (0..rows) |r| {
+        const p: i32 = if (t.pos) |a| a[r] else t.pos0 + @as(i32, @intCast(r));
+        if (p < 0) continue;
+        const blk: usize = @intCast(@divTrunc(p, 128));
+        const tok: usize = @intCast(@mod(p, 128));
+        const off: usize = if (t.row_tab) |a| @intCast(a[r]) else 0;
+        var page: i64 = -1;
+        if (blk < t.max_pages) page = t.tables[off + blk] else status |= geom.status_past_table;
+        if (blk < t.max_pages and page < 0) status |= geom.status_no_page;
+        const base: usize = if (page >= 0) (@as(usize, @intCast(page)) * t.page_bytes + t.layer_off) / 2 else 0;
+        var buf: [128]u16 = undefined;
+        for (0..h.nq) |i| {
+            head(in.q[(r * h.nq + i) * 128 ..], &nm.q, f.norm_qk, o.w_add, true, p, o, m, &buf);
+            @memcpy(t.q[(r * h.nq + i) * 128 ..][0..128], &buf);
+        }
+        for (0..h.niq) |i| {
+            head(in.iq[(r * h.niq + i) * 128 ..], &nm.iq, f.norm_index, o.w_add_index, f.index_rope, p, o, m, &buf);
+            @memcpy(t.iq[(r * h.niq + i) * 128 ..][0..128], &buf);
+        }
+        if (page < 0) continue;
+        const kvh = h.kvh;
+        for (0..kvh) |i| {
+            head(in.k[(r * kvh + i) * 128 ..], &nm.k, f.norm_qk, o.w_add, true, p, o, m, &buf);
+            const tk = if (m == .next_slot) (tok + 1) % 128 else tok;
+            @memcpy(t.pool[base + elem(kvh, 0, i, tk) ..][0..128], &buf);
+            for (0..128) |e| buf[e] = c.toBf16(in.v[(r * kvh + i) * 128 + e]);
+            @memcpy(t.pool[base + elem(kvh, 1, i, tok) ..][0..128], &buf);
+        }
+        if (h.ik) {
+            head(in.ik[r * 128 ..], &nm.ik, f.norm_index, o.w_add_index, f.index_rope, p, o, m, &buf);
+            @memcpy(t.pool[base + ikElem(kvh, tok) ..][0..128], &buf);
+        }
+    }
+    return status;
+}
+
+/// minimax_m3_sparse.cuh kv_elem and ik_elem, in bf16 elements.
+pub fn elem(kvh: usize, which: usize, h: usize, t: usize) usize {
+    return (which * kvh + h) * 128 * 128 + t * 128;
+}
+
+pub fn ikElem(kvh: usize, t: usize) usize {
+    return 2 * kvh * 128 * 128 + t * 128;
+}
+
+/// One router output as the kernel sums it: lane fma chains over chunks l + 32 j, then the 4 chains, then the tree.
+pub fn router(x: []const f32, w: []const f32, k: usize, rows_in_call: usize, m: Mutant) f32 {
+    var lane: [32]f32 = undefined;
+    const slices: usize = if (m == .split_by_rows) @max(1, @min(rows_in_call, 4)) else 1;
+    for (&lane, 0..) |*s, l| {
+        var acc: [4]f32 = @splat(0);
+        var j: usize = 0;
+        while (j < k / 128) : (j += 1) {
+            const at = 4 * (l + 32 * j);
+            for (0..4) |i| {
+                const slot = if (slices > 1) (j % slices) % 4 else i;
+                acc[slot] = @mulAdd(f32, x[at + i], w[at + i], acc[slot]);
+            }
+        }
+        s.* = if (m == .reorder_chains) (acc[0] + acc[2]) + (acc[1] + acc[3]) else (acc[0] + acc[1]) + (acc[2] + acc[3]);
+    }
+    return tree(&lane);
+}
diff --git a/zig/tests/minimax_sparse_tests.zig b/zig/tests/minimax_sparse_tests.zig
new file mode 100644
index 0000000..dfb7b56
--- /dev/null
+++ b/zig/tests/minimax_sparse_tests.zig
@@ -0,0 +1,415 @@
+//! MiniMax-M3.1-Flash sparse attention, host only: paged addressing, launch and memory arithmetic at block boundaries, the
+//! kernels' host twins against the float64 reference (core/minimax_ref.zig), planted controls, and the gate-5 launch records.
+//! No GPU ran any of this: the CUDA kernels are compile-checked only.
+const std = @import("std");
+const core = @import("core");
+const geom = @import("mm3_geom");
+const twin = @import("minimax_sparse_twin.zig");
+
+const mr = core.minimax_ref;
+const bf = core.bf16_round;
+const testing = std.testing;
+const registry = core.contract.registry;
+
+const gib: usize = 1 << 30;
+const boundary = [_]usize{ 127, 128, 129, 2047, 2048, 2049, 131071 };
+
+test "token bytes: 76,800 a rank for 2 of 4 kv heads over 60 layers, 2,304 a layer for all 4" {
+    const rank: geom.Pool = .{ .kvh = 2, .layers = 60 };
+    try testing.expectEqual(@as(usize, 76_800), rank.tokenBytes());
+    try testing.expectEqual(@as(usize, 9_830_400), rank.pageBytes());
+    try testing.expectEqual(@as(usize, 163_840), rank.layerBytes());
+    const full: geom.Pool = .{ .kvh = 4, .layers = 1 };
+    try testing.expectEqual(@as(usize, 2304), full.tokenBytes());
+}
+
+test "plan section 5: cache sizes and the tokens a 9 to 10 GiB budget holds" {
+    const rank: geom.Pool = .{ .kvh = 2, .layers = 60 };
+    // 32k = 2.34 GiB, 128k = 9.375 GiB, 256k = 18.75 GiB, 1M = 75 GiB
+    try testing.expectEqual(@as(usize, 32768 * 76_800), rank.bytesFor(32768));
+    try testing.expectEqual(@as(usize, 131072 * 76_800), rank.bytesFor(131072));
+    try testing.expectEqual(@as(usize, 9 * gib + gib * 3 / 8), rank.bytesFor(131072));
+    try testing.expectEqual(@as(usize, 75 * gib), rank.bytesFor(1 << 20));
+    try testing.expectEqual(@as(usize, 983 * 128), rank.tokensFitting(9 * gib)); // 125,824
+    try testing.expectEqual(@as(usize, 1092 * 128), rank.tokensFitting(10 * gib)); // 139,776
+    try testing.expect(rank.tokensFitting(9 * gib) < 131072 and rank.tokensFitting(10 * gib) > 131072);
+    try testing.expectEqual(@as(usize, 1), geom.Pool.pagesFor(1));
+    try testing.expectEqual(@as(usize, 1), geom.Pool.pagesFor(128));
+    try testing.expectEqual(@as(usize, 2), geom.Pool.pagesFor(129));
+    try testing.expectEqual(@as(usize, 128 * 76_800), rank.bytesFor(1));
+}
+
+test "plan sections 4-T5 and 5: scratch sizes and the IK bytes scoring reads each token" {
+    try testing.expectEqual(@as(usize, 134_217_728), geom.bmaxBytes(8192, 4, 1024)); // 128 MiB at 128k, all 4 heads
+    try testing.expectEqual(@as(usize, 67_108_864), geom.bmaxBytes(8192, 2, 1024)); // a rank's 2 heads
+    try testing.expectEqual(@as(usize, 8192 * 2 * 16 * 4), geom.selBytes(8192, 2));
+    try testing.expectEqual(@as(usize, 32 << 20), geom.indexReadBytes(131071)); // 32 MiB a layer
+    try testing.expectEqual(@as(usize, 60 * (32 << 20)), 60 * geom.indexReadBytes(131071)); // 1.875 GiB a token
+    try testing.expectEqual(@as(usize, 256), geom.indexReadBytes(0));
+}
+
+test "paged addressing: every (page, layer, K/V/IK, head, token) row is a distinct, gapless 256-byte row of the pool" {
+    const p: geom.Pool = .{ .kvh = 2, .layers = 3 };
+    const pages = 3;
+    const rows = pages * p.pageBytes() / 256;
+    const seen = try testing.allocator.alloc(bool, rows);
+    defer testing.allocator.free(seen);
+    @memset(seen, false);
+    for (0..pages) |pg| for (0..p.layers) |ly| for (0..128) |t| {
+        for (0..2) |w| for (0..p.kvh) |h| mark(seen, p.kv(pg, ly, w, h, t));
+        mark(seen, p.ik(pg, ly, t));
+    };
+    for (seen) |s| try testing.expect(s);
+    try testing.expectEqual(@as(usize, p.layerBytes()), p.layerOff(1));
+    // the three planes of a layer are contiguous: K heads, V heads, IK
+    try testing.expectEqual(p.kv(0, 0, 0, 0, 0) + 2 * 128 * 256, p.kv(0, 0, 1, 0, 0));
+    try testing.expectEqual(p.kv(0, 0, 1, 0, 0) + 2 * 128 * 256, p.ik(0, 0, 0));
+}
+
+fn mark(seen: []bool, byte: usize) void {
+    std.debug.assert(byte % 256 == 0);
+    std.debug.assert(!seen[byte / 256]);
+    seen[byte / 256] = true;
+}
+
+test "block boundaries: blocks, own-block keys, selected blocks, keys attended, steps and launch grids" {
+    const want = [_]struct { nb: usize, own: usize, sel: usize, keys: usize, steps: usize }{
+        .{ .nb = 1, .own = 128, .sel = 1, .keys = 128, .steps = 4 }, // 127: block 0 full
+        .{ .nb = 2, .own = 1, .sel = 2, .keys = 129, .steps = 5 }, // 128: block 1 holds one key
+        .{ .nb = 2, .own = 2, .sel = 2, .keys = 130, .steps = 5 },
+        .{ .nb = 16, .own = 128, .sel = 16, .keys = 2048, .steps = 64 }, // 2047: the last dense row
+        .{ .nb = 17, .own = 1, .sel = 16, .keys = 1921, .steps = 61 }, // 2048: the first row that selects
+        .{ .nb = 17, .own = 2, .sel = 16, .keys = 1922, .steps = 61 },
+        .{ .nb = 1024, .own = 128, .sel = 16, .keys = 2048, .steps = 64 }, // 128k - 1
+    };
+    for (boundary, want) |pos, w| {
+        try testing.expectEqual(w.nb, geom.blocks(pos));
+        try testing.expectEqual(w.own, geom.ownKeys(pos));
+        try testing.expectEqual(w.sel, geom.selected(pos));
+        try testing.expectEqual(w.keys, geom.keysAttended(pos));
+        try testing.expectEqual(w.steps, geom.attnSteps(pos));
+        const il = geom.indexLaunch(3, 2, pos);
+        try testing.expectEqual([3]u32{ @intCast(w.nb), 2, 3 }, il.grid);
+        try testing.expectEqual(@as(u32, 128), il.block);
+    }
+    const sl = geom.selectLaunch(5, 2);
+    try testing.expectEqual([3]u32{ 2, 5, 1 }, sl.grid);
+    try testing.expectEqual(@as(u32, 256), sl.block);
+    const al = geom.attnLaunch(5, 2);
+    try testing.expectEqual([3]u32{ 5, 2, 1 }, al.grid);
+    try testing.expectEqual(@as(u32, 256), al.block);
+    try testing.expectError(error.TooManyRows, geom.check(65536, 2));
+    try testing.expectError(error.Empty, geom.check(0, 2));
+    try geom.check(8192, 4);
+    // the scoring grid covers a window's furthest row: the block count is the max over its rows
+    try testing.expectEqual(@as(u32, 2), geom.indexLaunch(2, 4, 128).grid[0]);
+}
+
+fn bf16v(rng: std.Random, n: usize, sd: f32) ![]f32 {
+    const v = try testing.allocator.alloc(f32, n);
+    for (v) |*x| x.* = bf.round32(rng.floatNorm(f32) * sd);
+    return v;
+}
+
+fn widen(x: []const f32) ![]f64 {
+    const o = try testing.allocator.alloc(f64, x.len);
+    for (o, x) |*d, s| d.* = s;
+    return o;
+}
+
+const scale64 = 0.08838834764831845; // 128^-0.5
+const scale32: f32 = @floatCast(scale64);
+
+fn rulesOf(sw: mr.Switches) geom.Rules {
+    return .{
+        .init_n = @intCast(sw.sparse_init_block),
+        .init_inclusive = sw.init_mode == .inclusive,
+        .local_n = @intCast(sw.sparse_local_block),
+        .local_trailing = sw.local_mode == .trailing_window,
+        .higher_tie = sw.tie == .higher_block,
+    };
+}
+
+/// Scores, selects and attends one row at `pos` with the twins, and checks every stage against float64.
+fn row(pos: usize, seed: u64, compact: bool) !void {
+    var prng = std.Random.DefaultPrng.init(seed);
+    const rng = prng.random();
+    const n = pos + 1;
+    const iq = try bf16v(rng, 128, 1);
+    defer testing.allocator.free(iq);
+    const ik = try bf16v(rng, n * 128, 1);
+    defer testing.allocator.free(ik);
+    const iq64 = try widen(iq);
+    defer testing.allocator.free(iq64);
+    const ik64 = try widen(ik);
+    defer testing.allocator.free(ik64);
+    const nb = geom.blocks(pos);
+    const t_bm = try testing.allocator.alloc(f32, nb);
+    defer testing.allocator.free(t_bm);
+    const r_bm = try testing.allocator.alloc(f64, nb);
+    defer testing.allocator.free(r_bm);
+    try testing.expectEqual(nb, twin.blockMax(iq, ik, pos, scale32, .none, t_bm));
+    try testing.expectEqual(nb, mr.blockScores(iq64, ik64, pos, 128, scale64, 128, r_bm));
+    for (t_bm, r_bm) |t, r| try testing.expectApproxEqAbs(r, @as(f64, t), 1e-5 * (1 + @abs(r)));
+
+    // select on the twin's own fp32 maxima so the tie order is comparable bit for bit
+    const sw: mr.Switches = .{};
+    var ids: [geom.topk]i32 = undefined;
+    twin.select(t_bm, pos, rulesOf(sw), .none, &ids);
+    const tb64 = try widen(t_bm);
+    defer testing.allocator.free(tb64);
+    var scratch: [1024]f64 = undefined;
+    var rids: [geom.topk]usize = undefined;
+    const cnt = mr.selectBlocks(tb64, nb - 1, geom.topk, sw, &scratch, &rids);
+    try testing.expectEqual(geom.selected(pos), cnt);
+    for (0..cnt) |i| try testing.expectEqual(@as(i32, @intCast(rids[i])), ids[i]);
+    for (ids[cnt..]) |x| try testing.expectEqual(@as(i32, -1), x);
+    try testing.expectEqual(@as(i32, @intCast(nb - 1)), ids[cnt - 1]); // the own block is selected, and is the last
+
+    // attention over the selected keys
+    const q = try bf16v(rng, geom.group * 128, 1);
+    defer testing.allocator.free(q);
+    const q64 = try widen(q);
+    defer testing.allocator.free(q64);
+    var keys: [geom.topk * 128]usize = undefined;
+    var o64: [geom.group * 128]f64 = undefined;
+    var o32: [geom.group * 128]f32 = undefined;
+    if (!compact) {
+        const kk = try bf16v(rng, n * 128, 1);
+        defer testing.allocator.free(kk);
+        const vv = try bf16v(rng, n * 128, 1);
+        defer testing.allocator.free(vv);
+        const k64 = try widen(kk);
+        defer testing.allocator.free(k64);
+        const v64 = try widen(vv);
+        defer testing.allocator.free(v64);
+        mr.attendBlocks(q64, k64, v64, rids[0..cnt], pos, 128, 128, geom.group, &keys, &o64);
+        twin.attend(q, kk, vv, ids[0..cnt], pos, scale32, .none, &o32);
+        try closeBf16(&o64, &o32);
+        // fixed split: the same row alone, again, and padded with -1 entries gives the same bits
+        var again: [geom.group * 128]f32 = undefined;
+        twin.attend(q, kk, vv, &ids, pos, scale32, .none, &again);
+        try testing.expectEqualSlices(f32, &o32, &again);
+    } else {
+        // 128k - 1: only the 16 selected blocks matter; gather them in order and attend at the compacted position
+        const kk = try bf16v(rng, geom.topk * 128 * 128, 1);
+        defer testing.allocator.free(kk);
+        const vv = try bf16v(rng, geom.topk * 128 * 128, 1);
+        defer testing.allocator.free(vv);
+        const k64 = try widen(kk);
+        defer testing.allocator.free(k64);
+        const v64 = try widen(vv);
+        defer testing.allocator.free(v64);
+        const cpos = (geom.topk - 1) * 128 + pos % 128;
+        var cids: [geom.topk]i32 = undefined;
+        var crids: [geom.topk]usize = undefined;
+        for (&cids, &crids, 0..) |*c, *r, i| {
+            c.* = @intCast(i);
+            r.* = i;
+        }
+        mr.attendBlocks(q64, k64, v64, &crids, cpos, 128, 128, geom.group, &keys, &o64);
+        twin.attend(q, kk, vv, &cids, cpos, scale32, .none, &o32);
+        try closeBf16(&o64, &o32);
+    }
+}
+
+fn closeBf16(want: []const f64, got: []const f32) !void {
+    var big: f64 = 0;
+    for (want) |w| big = @max(big, @abs(w));
+    for (want, got) |w, g| try testing.expectApproxEqAbs(w, @as(f64, g), 0.01 * big + 1e-6);
+}
+
+test "twins of index, select and attention match float64 at pos 127, 128, 129, 2047, 2048, 2049" {
+    for (boundary[0..6], 0..) |pos, i| try row(pos, 100 + i, false);
+}
+
+test "twins match float64 at pos 131071 (1024 blocks): scores and selection on the whole cache, attention on the selected blocks" {
+    try row(131071, 7, true);
+}
+
+test "select twin equals the reference for every forcing, local and tie switch over tie-heavy, NaN and infinite scores" {
+    var prng = std.Random.DefaultPrng.init(55);
+    const rng = prng.random();
+    var scratch: [1024]f64 = undefined;
+    var trials: usize = 0;
+    for ([_]mr.InitBlocks{ .count, .inclusive }) |im| for ([_]mr.LocalBlocks{ .own_block_if_positive, .trailing_window }) |lm| {
+        for ([_]mr.Tie{ .lower_block, .higher_block }) |tie| for (0..3) |init_n| for (0..4) |local_n| {
+            const sw: mr.Switches = .{ .init_mode = im, .local_mode = lm, .tie = tie, .sparse_init_block = init_n, .sparse_local_block = local_n };
+            for (0..40) |_| {
+                const nb = 17 + rng.uintLessThan(usize, 90);
+                const pos = (nb - 1) * 128 + rng.uintLessThan(usize, 128);
+                var bm: [128]f32 = undefined;
+                const palette = [_]f32{ -1, 0, 0.5, 0.5, 1, 1, 2, nan32, inf32, -inf32 };
+                for (bm[0..nb]) |*x| x.* = palette[rng.uintLessThan(usize, palette.len)];
+                var got: [geom.topk]i32 = undefined;
+                twin.select(bm[0..nb], pos, rulesOf(sw), .none, &got);
+                var b64: [128]f64 = undefined;
+                for (b64[0..nb], bm[0..nb]) |*d, s| d.* = s;
+                var rids: [geom.topk]usize = undefined;
+                _ = mr.selectBlocks(b64[0..nb], nb - 1, geom.topk, sw, &scratch, &rids);
+                for (rids, got) |a, b| try testing.expectEqual(@as(i32, @intCast(a)), b);
+                for (got[1..], got[0 .. got.len - 1]) |a, b| try testing.expect(a > b); // strictly ascending
+                trials += 1;
+            }
+        };
+    };
+    try testing.expectEqual(@as(usize, 2 * 2 * 2 * 3 * 4 * 40), trials);
+}
+
+const nan32 = std.math.nan(f32);
+const inf32 = std.math.inf(f32);
+
+test "forcing semantics are launch parameters: block 0 forced by inclusive init, own block off when local is 0" {
+    var bm: [20]f32 = undefined;
+    for (&bm, 0..) |*x, i| x.* = @floatFromInt(i); // block 19 (own) scores highest, block 0 lowest
+    var out: [geom.topk]i32 = undefined;
+    const pos = 19 * 128 + 5;
+    twin.select(&bm, pos, .{}, .none, &out); // default: no init, own forced: 4..19
+    try testing.expectEqual(@as(i32, 4), out[0]);
+    twin.select(&bm, pos, .{ .init_n = 0, .init_inclusive = true }, .none, &out); // block 0 forced: 0, 5..19
+    try testing.expectEqual(@as(i32, 0), out[0]);
+    try testing.expectEqual(@as(i32, 5), out[1]);
+    bm[19] = -5; // own block scores lowest: forced when local_n > 0, dropped when 0
+    twin.select(&bm, pos, .{}, .none, &out);
+    try testing.expectEqual(@as(i32, 19), out[15]);
+    twin.select(&bm, pos, .{ .local_n = 0 }, .none, &out);
+    try testing.expect(out[15] != 19);
+}
+
+fn must(ok: bool, src: std.builtin.SourceLocation) !void {
+    if (!ok) {
+        std.debug.print("control check failed at line {d}\n", .{src.line});
+        return error.TestUnexpectedResult;
+    }
+}
+
+fn padded(head: []const i32) [geom.topk]i32 {
+    var o: [geom.topk]i32 = @splat(-1);
+    @memcpy(o[0..head.len], head);
+    return o;
+}
+
+fn differs(a: []const i32, b: []const i32) bool {
+    return !std.mem.eql(i32, a, b);
+}
+
+test "planted controls: each mutant is caught by the check that the real twin passes" {
+    var prng = std.Random.DefaultPrng.init(9);
+    const rng = prng.random();
+    var scratch: [1024]f64 = undefined;
+    // no_forcing and tie_flipped: caught against the reference on tie-heavy rows; the real twin never differs
+    var caught = [_]bool{ false, false };
+    for (0..400) |_| {
+        const nb = 17 + rng.uintLessThan(usize, 30);
+        const pos = (nb - 1) * 128 + rng.uintLessThan(usize, 128);
+        var bm: [64]f32 = undefined;
+        for (bm[0..nb]) |*x| x.* = @floatFromInt(rng.uintLessThan(u8, 4)); // ties; the own block rarely wins on score
+        var b64: [64]f64 = undefined;
+        for (b64[0..nb], bm[0..nb]) |*d, s| d.* = s;
+        var rids: [geom.topk]usize = undefined;
+        _ = mr.selectBlocks(b64[0..nb], nb - 1, geom.topk, .{}, &scratch, &rids);
+        var want: [geom.topk]i32 = undefined;
+        for (&want, rids) |*w, r| w.* = @intCast(r);
+        var got: [geom.topk]i32 = undefined;
+        twin.select(bm[0..nb], pos, .{}, .none, &got);
+        try must(!differs(&want, &got), @src());
+        twin.select(bm[0..nb], pos, .{}, .no_forcing, &got);
+        caught[0] = caught[0] or differs(&want, &got);
+        twin.select(bm[0..nb], pos, .{}, .tie_flipped, &got);
+        caught[1] = caught[1] or differs(&want, &got);
+    }
+    try must(caught[0] and caught[1], @src());
+
+    // drop_tail: pos 128 puts one key in block 1; dropping it turns a finite maximum into -inf
+    const ik = try bf16v(rng, 129 * 128, 1);
+    defer testing.allocator.free(ik);
+    const iq = try bf16v(rng, 128, 1);
+    defer testing.allocator.free(iq);
+    var good: [2]f32 = undefined;
+    var bad: [2]f32 = undefined;
+    _ = twin.blockMax(iq, ik, 128, scale32, .none, &good);
+    _ = twin.blockMax(iq, ik, 128, scale32, .drop_tail, &bad);
+    try must(std.math.isFinite(good[1]) and bad[1] == -inf32, @src());
+
+    // nan_poison: one NaN key in block 0; fmax drops it (the reference's rule), the mutant yields NaN
+    ik[5 * 128 + 3] = nan32;
+    _ = twin.blockMax(iq, ik, 127, scale32, .none, good[0..1]);
+    _ = twin.blockMax(iq, ik, 127, scale32, .nan_poison, bad[0..1]);
+    try must(std.math.isFinite(good[0]) and std.math.isNan(bad[0]), @src());
+    var i64s: [128 * 128]f64 = undefined;
+    for (&i64s, ik[0 .. 128 * 128]) |*d, s| d.* = s;
+    var q64: [128]f64 = undefined;
+    for (&q64, iq) |*d, s| d.* = s;
+    var r0: [1]f64 = undefined;
+    _ = mr.blockScores(&q64, &i64s, 127, 128, scale64, 128, &r0);
+    try must(std.math.isFinite(r0[0]), @src());
+
+    // window_split: a 16-key tile for short rows changes bits; the fixed 32-key twin repeats exactly
+    const pos = 4 * 128 + 9;
+    const k = try bf16v(rng, (pos + 1) * 128, 1);
+    defer testing.allocator.free(k);
+    const v = try bf16v(rng, (pos + 1) * 128, 1);
+    defer testing.allocator.free(v);
+    const q = try bf16v(rng, geom.group * 128, 1);
+    defer testing.allocator.free(q);
+    const ids = padded(&.{ 0, 1, 2, 3, 4 });
+    var a: [geom.group * 128]f32 = undefined;
+    var b: [geom.group * 128]f32 = undefined;
+    var c: [geom.group * 128]f32 = undefined;
+    twin.attendRaw(q, k, v, &ids, pos, scale32, .none, &a);
+    twin.attendRaw(q, k, v, &ids, pos, scale32, .none, &b);
+    twin.attendRaw(q, k, v, &ids, pos, scale32, .window_split, &c);
+    try testing.expectEqualSlices(f32, &a, &b);
+    try must(!std.mem.eql(f32, &a, &c), @src());
+}
+
+test "attention propagates a NaN query like the float64 reference" {
+    var prng = std.Random.DefaultPrng.init(3);
+    const rng = prng.random();
+    const pos = 300;
+    const k = try bf16v(rng, (pos + 1) * 128, 1);
+    defer testing.allocator.free(k);
+    const v = try bf16v(rng, (pos + 1) * 128, 1);
