+}
+
+test "NaN and infinity: the whole row reads back NaN, a clean neighbour is untouched" {
+    for ([_]f32{ nan32, inf32, -inf32 }) |bad| {
+        var x: [128]f32 = undefined;
+        var prng = std.Random.DefaultPrng.init(4);
+        randomRow(prng.random(), 1, &x);
+        x[77] = bad;
+        var c: [128]u8 = undefined;
+        const s = twin.quantRow(&x, .none, 0, &c);
+        try testing.expect(std.math.isNan(s));
+        try testing.expectEqualSlices(u8, &@as([128]u8, @splat(0)), &c);
+        var dec: [128]f64 = undefined;
+        mr.dequantRow(&c, s, &dec);
+        for (dec) |d| try testing.expect(std.math.isNan(d));
+        var x64: [128]f64 = undefined;
+        for (&x64, x) |*d, v| d.* = v;
+        var c64: [128]u8 = undefined;
+        try testing.expect(std.math.isNan(mr.quantRow(&x64, &c64)));
+        try testing.expectEqualSlices(u8, &c, &c64);
+    }
+}
+
+const nan32 = std.math.nan(f32);
+const inf32 = std.math.inf(f32);
+
+test "a row's bits do not depend on the window: 1, 3 or 16 rows in a call give the same codes and scales" {
+    var prng = std.Random.DefaultPrng.init(5);
+    const rng = prng.random();
+    var rows: [16][128]f32 = undefined;
+    for (&rows, 0..) |*r, i| randomRow(rng, 0.25 * @as(f32, @floatFromInt(1 + i * i)), r);
+    var alone_c: [16][128]u8 = undefined;
+    var alone_s: [16]f32 = undefined;
+    for (rows, &alone_c, &alone_s) |r, *c, *s| s.* = twin.quantRow(&r, .none, 0, c);
+    for ([_]usize{ 1, 3, 16 }) |w| {
+        var at: usize = 0;
+        while (at < 16) : (at += w) {
+            const n = @min(w, 16 - at);
+            var c: [16][128]u8 = undefined;
+            var s: [16]f32 = undefined;
+            twin.quantWindow(rows[at..][0..n], .none, c[0..n], s[0..n]);
+            for (0..n) |i| {
+                try testing.expectEqualSlices(u8, &alone_c[at + i], &c[i]);
+                try testing.expectEqual(alone_s[at + i], s[i]);
+            }
+        }
+    }
+    // control: scaling by the window's amax makes a row depend on its neighbours
+    var c: [16][128]u8 = undefined;
+    var s: [16]f32 = undefined;
+    twin.quantWindow(&rows, .batch_amax, &c, &s);
+    try must(s[0] != alone_s[0], @src());
+}
+
+test "planted controls on the quantizer: each mutant breaks the rule and the checks see it" {
+    var prng = std.Random.DefaultPrng.init(6);
+    const rng = prng.random();
+    // ties: amax 448 gives scale 1 and inv 1, so 1.0625 and 1.1875 are exact ties
+    var x: [128]f32 = @splat(0);
+    x[0] = 448;
+    x[1] = 1.0625;
+    x[2] = 1.1875;
+    x[3] = -1.0625;
+    x[4] = 2.4;
+    var good: [128]u8 = undefined;
+    var bad: [128]u8 = undefined;
+    _ = twin.quantRow(&x, .none, 0, &good);
+    try testing.expectEqual(@as(u8, 0x38), good[1]);
+    try testing.expectEqual(@as(u8, 0x3a), good[2]);
+    _ = twin.quantRow(&x, .ties_up, 0, &bad);
+    try must(bad[1] == 0x39 and bad[2] == good[2], @src()); // the second tie is odd below, even above: both rules agree
+    _ = twin.quantRow(&x, .truncate, 0, &bad);
+    try must(bad[4] != good[4] or bad[1] != good[1], @src()); // 2.4 sits above 2.25 and below 2.5: truncation keeps 2.25 ...
+    try testing.expect(mr.e4m3Value(good[4]) == 2.5); // ... the nearest is 2.5
+    try testing.expect(mr.e4m3Value(bad[4]) == 2.25);
+    // the reference scale catches a wrong maximum; the poison rule catches an ignored NaN
+    var r: [128]f32 = undefined;
+    randomRow(rng, 1, &r);
+    const s_ok = twin.quantRow(&r, .none, 0, &good);
+    try must(twin.quantRow(&r, .wrong_max, 0, &bad) != s_ok, @src());
+    r[10] = nan32;
+    try must(std.math.isNan(twin.quantRow(&r, .none, 0, &good)), @src());
+    try must(!std.math.isNan(twin.quantRow(&r, .nan_ignored, 0, &bad)), @src());
+    r[10] = inf32;
+    try must(!std.math.isNan(twin.quantRow(&r, .nan_ignored, 0, &bad)), @src());
+    // the scale floor: a denormal row without it saturates every nonzero value and turns zeros into NaN codes
+    var t: [128]f32 = @splat(0);
+    t[7] = 1e-40;
+    _ = twin.quantRow(&t, .none, 0, &good);
+    _ = twin.quantRow(&t, .no_floor, 0, &bad);
+    try must(!std.mem.eql(u8, &good, &bad), @src());
+    // k from its bf16 rounding: fp32 inputs that bf16 moves across a rounding midpoint change a code
+    var moved = false;
+    for (0..40) |_| {
+        var o: [128]f32 = undefined;
+        for (&o) |*v| v.* = rng.floatNorm(f32);
+        _ = twin.quantKey(&o, .none, 0, &good);
+        _ = twin.quantKey(&o, .k_unrounded, 0, &bad);
+        moved = moved or !std.mem.eql(u8, &good, &bad);
+    }
+    try must(moved, @src());
+}
+
+fn idsFor(pos: usize, out: *[geom.topk]i32) []const i32 {
+    @memset(out, -1);
+    const nb = geom.blocks(pos);
+    const n = @min(nb, geom.topk);
+    for (out[0..n], 0..) |*o, i| o.* = @intCast(nb - n + i);
+    return out[0..n];
+}
+
+const Case = struct {
+    q: []f32,
+    k: []f32,
+    v: []f32,
+    kc: []u8,
+    vc: []u8,
+    ks: []f32,
+    vs: []f32,
+    n: usize,
+
+    fn init(rng: std.Random, pos: usize) !Case {
+        const n = pos + 1;
+        const a = testing.allocator;
+        var c: Case = .{ .q = try bf16v(rng, 16 * 128, 1), .k = try bf16v(rng, n * 128, 1), .v = try bf16v(rng, n * 128, 1), .kc = try a.alloc(u8, n * 128), .vc = try a.alloc(u8, n * 128), .ks = try a.alloc(f32, n), .vs = try a.alloc(f32, n), .n = n };
+        c.requant();
+        return c;
+    }
+
+    fn requant(c: *Case) void {
+        for (0..c.n) |j| {
+            c.ks[j] = twin.quantRow(c.k[j * 128 ..][0..128], .none, 0, c.kc[j * 128 ..][0..128]);
+            c.vs[j] = twin.quantRow(c.v[j * 128 ..][0..128], .none, 0, c.vc[j * 128 ..][0..128]);
+        }
+    }
+
+    fn deinit(c: Case) void {
+        const a = testing.allocator;
+        a.free(c.q);
+        a.free(c.k);
+        a.free(c.v);
+        a.free(c.kc);
+        a.free(c.vc);
+        a.free(c.ks);
+        a.free(c.vs);
+    }
+};
+
+/// The float64 attention over exactly the values the twin's codes and scales dequantize to.
+fn attendDecoded(c: Case, rids: []const usize, pos: usize, out: []f64) !void {
+    const a = testing.allocator;
+    const q64 = try widen(c.q);
+    defer a.free(q64);
+    const kd = try a.alloc(f64, c.n * 128);
+    defer a.free(kd);
+    const vd = try a.alloc(f64, c.n * 128);
+    defer a.free(vd);
+    for (0..c.n) |j| {
+        mr.dequantRow(c.kc[j * 128 ..][0..128], c.ks[j], kd[j * 128 ..][0..128]);
+        mr.dequantRow(c.vc[j * 128 ..][0..128], c.vs[j], vd[j * 128 ..][0..128]);
+    }
+    var keys: [geom.topk * 128]usize = undefined;
+    mr.attendBlocks(q64, kd, vd, rids, pos, 128, 128, 16, &keys, out);
+}
+
+fn maxAbs(x: []const f64) f64 {
+    var m: f64 = 0;
+    for (x) |v| m = @max(m, @abs(v));
+    return m;
+}
+
+fn rmsRel(want: []const f64, got: []const f32) f64 {
+    var num: f64 = 0;
+    var den: f64 = 0;
+    for (want, got) |a, b| {
+        num += (a - b) * (a - b);
+        den += a * a;
+    }
+    return @sqrt(num / den);
+}
+
+fn worstDiff(want: []const f64, got: []const f32) f64 {
+    var w: f64 = 0;
+    for (want, got) |a, b| w = @max(w, if (std.math.isNan(a) and std.math.isNan(b)) 0 else @abs(a - b));
+    return w;
+}
+
+test "attention over fp8 K/V: the twin follows the float64 reference, and the fp8 error against bf16 K/V is bounded" {
+    var prng = std.Random.DefaultPrng.init(7);
+    const rng = prng.random();
+    var worst_vs_bf16: f64 = 0;
+    var worst_rms: f64 = 0;
+    for ([_]usize{ 127, 128, 129, 2047, 2048, 2049 }) |pos| {
+        const c = try Case.init(rng, pos);
+        defer c.deinit();
+        var idb: [geom.topk]i32 = undefined;
+        const ids = idsFor(pos, &idb);
+        var rids: [geom.topk]usize = undefined;
+        for (rids[0..ids.len], ids) |*r, i| r.* = @intCast(i);
+        const q64 = try widen(c.q);
+        defer testing.allocator.free(q64);
+        const k64 = try widen(c.k);
+        defer testing.allocator.free(k64);
+        const v64 = try widen(c.v);
+        defer testing.allocator.free(v64);
+        const kq = try testing.allocator.alloc(f64, c.n * 128);
+        defer testing.allocator.free(kq);
+        const vq = try testing.allocator.alloc(f64, c.n * 128);
+        defer testing.allocator.free(vq);
+        var keys: [geom.topk * 128]usize = undefined;
+        var want8: [16 * 128]f64 = undefined;
+        var want16: [16 * 128]f64 = undefined;
+        mr.attendBlocksKv8(q64, k64, v64, rids[0..ids.len], pos, 128, 128, 16, &keys, kq, vq, &want8);
+        mr.attendBlocks(q64, k64, v64, rids[0..ids.len], pos, 128, 128, 16, &keys, &want16);
+        var got: [16 * 128]f32 = undefined;
+        twin.attend(c.q, c.kc, c.ks, c.vc, c.vs, ids, pos, scale32, .none, false, &got);
+        const big = maxAbs(&want8);
+        // over the twin's own codes the float64 attention differs only by fp32 order and where the scale is applied
+        var same: [16 * 128]f64 = undefined;
+        try attendDecoded(c, rids[0..ids.len], pos, &same);
+        try testing.expect(worstDiff(&same, &got) <= 2e-4 * big + 1e-9);
+        // against the float64 reference that quantizes by itself: exact ties in x / scale go the other way, 4 in 10,000
+        try testing.expect(worstDiff(&want8, &got) <= 1e-2 * big);
+        worst_vs_bf16 = @max(worst_vs_bf16, worstDiff(&want16, &got) / maxAbs(&want16));
+        worst_rms = @max(worst_rms, rmsRel(&want16, &got));
+        // padding with more -1 entries, again: the same bits
+        var again: [16 * 128]f32 = undefined;
+        twin.attend(c.q, c.kc, c.ks, c.vc, c.vs, &idb, pos, scale32, .none, false, &again);
+        try testing.expectEqualSlices(f32, &got, &again);
+    }
+    std.debug.print("kv8 attention vs bf16 K/V, random N(0,1) rows, 6 positions: worst element error {d:.4} of the output's largest value, worst relative rms {d:.4}\n", .{ worst_vs_bf16, worst_rms });
+    try testing.expect(worst_vs_bf16 < 0.1 and worst_rms < 0.06); // 3 mantissa bits: a few percent per element, never more
+}
+
+test "planted controls on the attention twin: a missing or misplaced scale, or a window-dependent tile, is caught" {
+    var prng = std.Random.DefaultPrng.init(8);
+    const rng = prng.random();
+    const pos = 4 * 128 + 9;
+    const c = try Case.init(rng, pos);
+    defer c.deinit();
+    var idb: [geom.topk]i32 = undefined;
+    const ids = idsFor(pos, &idb);
+    var rids: [geom.topk]usize = undefined;
+    for (rids[0..ids.len], ids) |*r, i| r.* = @intCast(i);
+    var want: [16 * 128]f64 = undefined;
+    try attendDecoded(c, rids[0..ids.len], pos, &want);
+    const big = maxAbs(&want);
+    var out: [16 * 128]f32 = undefined;
+    twin.attend(c.q, c.kc, c.ks, c.vc, c.vs, ids, pos, scale32, .none, false, &out);
+    try testing.expect(worstDiff(&want, &out) <= 2e-4 * big);
+    for ([_]twin.Mutant{ .k_scale_missing, .v_scale_missing, .v_scale_on_sum }) |m| {
+        twin.attend(c.q, c.kc, c.ks, c.vc, c.vs, ids, pos, scale32, m, false, &out);
+        try must(worstDiff(&want, &out) > 0.05 * big, @src());
+    }
+    // window_split: the 16-key tile changes fp32 bits for a short row; the fixed 32-key twin repeats exactly
+    var a: [16 * 128]f32 = undefined;
+    var b: [16 * 128]f32 = undefined;
+    var s: [16 * 128]f32 = undefined;
+    twin.attend(c.q, c.kc, c.ks, c.vc, c.vs, ids, pos, scale32, .none, false, &a);
+    twin.attend(c.q, c.kc, c.ks, c.vc, c.vs, ids, pos, scale32, .none, false, &b);
+    twin.attend(c.q, c.kc, c.ks, c.vc, c.vs, ids, pos, scale32, .window_split, false, &s);
+    try testing.expectEqualSlices(f32, &a, &b);
+    try must(!std.mem.eql(f32, &a, &s), @src());
+}
+
+test "a NaN or infinity in a key or value row turns that head's output NaN through its scale; other rows' heads stay finite" {
+    var prng = std.Random.DefaultPrng.init(9);
+    const rng = prng.random();
+    const pos = 300;
+    var c = try Case.init(rng, pos);
+    defer c.deinit();
+    var idb: [geom.topk]i32 = undefined;
+    const ids = idsFor(pos, &idb);
+    var out: [16 * 128]f32 = undefined;
+    twin.attend(c.q, c.kc, c.ks, c.vc, c.vs, ids, pos, scale32, .none, false, &out);
+    for (out) |x| try testing.expect(std.math.isFinite(x));
+    // a poisoned key: every head's score for it is NaN, so every head is NaN (as with a NaN key in bf16)
+    c.k[5 * 128 + 3] = nan32;
+    c.requant();
+    twin.attend(c.q, c.kc, c.ks, c.vc, c.vs, ids, pos, scale32, .none, false, &out);
+    for (out) |x| try testing.expect(std.math.isNan(x));
+    // a poisoned value row: its weight times a NaN scale makes every output dim NaN (bf16 would poison only dim 9)
+    c.k[5 * 128 + 3] = 0.5;
+    c.v[7 * 128 + 9] = inf32;
+    c.requant();
+    twin.attend(c.q, c.kc, c.ks, c.vc, c.vs, ids, pos, scale32, .none, false, &out);
+    for (out) |x| try testing.expect(std.math.isNan(x));
+    // a bad key row beyond the row's position is never read
+    c.v[7 * 128 + 9] = 0.5;
+    c.k[(pos + 1 - 1) * 128] = 1;
+    c.requant();
+    var dup = try Case.init(rng, pos + 40);
+    defer dup.deinit();
+    @memcpy(dup.q, c.q);
+    @memcpy(dup.kc[0 .. c.n * 128], c.kc);
+    @memcpy(dup.vc[0 .. c.n * 128], c.vc);
+    @memcpy(dup.ks[0..c.n], c.ks);
+    @memcpy(dup.vs[0..c.n], c.vs);
+    var a: [16 * 128]f32 = undefined;
+    twin.attend(c.q, c.kc, c.ks, c.vc, c.vs, ids, pos, scale32, .none, false, &out);
+    twin.attend(dup.q, dup.kc, dup.ks, dup.vc, dup.vs, ids, pos, scale32, .none, false, &a);
+    try testing.expectEqualSlices(f32, &out, &a);
+}
diff --git a/zig/tests/minimax_kv8_twin.zig b/zig/tests/minimax_kv8_twin.zig
new file mode 100644
index 0000000..eaa92e9
--- /dev/null
+++ b/zig/tests/minimax_kv8_twin.zig
@@ -0,0 +1,143 @@
+//! Host twins of quant_row8 and tf_mm3_attn's kv8 mode (docs/fp8-kv.md), in the kernels' fp32 order, with mutants.
+const std = @import("std");
+const core = @import("core");
+
+const mr = core.minimax_ref;
+const bf = core.bf16_round;
+const inf32 = std.math.inf(f32);
+const nan32 = std.math.nan(f32);
+
+pub const Mutant = enum {
+    none,
+    /// Codes round toward zero instead of to nearest even.
+    truncate,
+    /// A tie goes up (away from zero) instead of to the even code.
+    ties_up,
+    /// The scale divides by 240, not 448 (the e4m3fnuz maximum).
+    wrong_max,
+    /// A NaN or infinity does not poison its row: the row is scaled by its finite maximum.
+    nan_ignored,
+    /// The scale's 2^-126 floor is missing: a tiny row's inverse overflows.
+    no_floor,
+    /// The scale is taken over the whole window of rows, not the row (a row's bits would depend on its neighbours).
+    batch_amax,
+    /// The key is quantized from its fp32 value, not from the bf16 the bf16 cache would hold.
+    k_unrounded,
+    /// The key's scale is not applied to its score.
+    k_scale_missing,
+    /// The value's scale is not applied to its weight.
+    v_scale_missing,
+    /// The value's scale multiplies the softmax sum l as well (it must not).
+    v_scale_on_sum,
+    /// The attention's key tile depends on how many keys the row sees.
+    window_split,
+};
+
+/// Code of |a| by the chosen rounding; mutants change the rule, `none` is mr.e4m3Code's.
+fn code(x: f32, m: Mutant) u8 {
+    if (m != .truncate and m != .ties_up) return mr.e4m3Code(@as(f64, x));
+    if (std.math.isNan(x)) return 0x7f;
+    const sign: u8 = if (std.math.signbit(x)) 0x80 else 0;
+    const a: f64 = @abs(x);
+    if (a >= 448) return sign | 0x7e;
+    var i: u8 = 0;
+    while (i < 0x7e and mr.e4m3Value(i + 1) <= a) i += 1;
+    if (m == .truncate or i == 0x7e) return sign | i;
+    const mid = (mr.e4m3Value(i) + mr.e4m3Value(i + 1)) / 2;
+    return sign | (if (a >= mid) i + 1 else i);
+}
+
+/// quant_row8 for a row of 128 fp32 values: writes the codes, returns the scale (`window_amax` is for `.batch_amax`).
+pub fn quantRow(x: []const f32, m: Mutant, window_amax: f32, codes: []u8) f32 {
+    var amax: f32 = 0;
+    var bad = false;
+    for (x) |v| {
+        if (!std.math.isFinite(v)) bad = true else amax = @max(amax, @abs(v));
+    }
+    if (m == .batch_amax) amax = @max(amax, window_amax);
+    if (bad and m != .nan_ignored) {
+        @memset(codes, 0);
+        return nan32;
+    }
+    const top: f32 = if (m == .wrong_max) 240.0 else 448.0;
+    var inv: f32 = 1;
+    var scale: f32 = 1;
+    if (amax > 0) {
+        inv = top / amax;
+        scale = amax / top;
+        if (scale < 0x1p-126 and m != .no_floor) {
+            scale = 0x1p-126;
+            inv = 1.0 / scale;
+        }
+    }
+    for (codes, x) |*c, v| c.* = code(if (std.math.isFinite(v)) v * inv else v, m);
+    return scale;
+}
+
+/// A key as the writer stores it: the normed and rotated fp32 value rounded to bf16, then quantized.
+pub fn quantKey(o: []const f32, m: Mutant, window_amax: f32, codes: []u8) f32 {
+    var r: [128]f32 = undefined;
+    for (&r, o) |*d, v| d.* = if (m == .k_unrounded) v else bf.round32(v);
+    return quantRow(&r, m, window_amax, codes);
+}
+
+/// The rows a launch writes: each quantized alone (the kernel's rule) or, as a mutant, by the window's amax.
+pub fn quantWindow(rows: []const [128]f32, m: Mutant, codes: [][128]u8, scales: []f32) void {
+    var wmax: f32 = 0;
+    for (rows) |r| for (r) |v| {
+        if (std.math.isFinite(v)) wmax = @max(wmax, @abs(v));
+    };
+    for (rows, codes, scales) |r, *c, *s| s.* = quantRow(&r, m, wmax, c);
+}
+
+fn widen(c: u8) f32 {
+    return @floatCast(mr.e4m3Value(c));
+}
+
+fn nmax(a: f32, b: f32) f32 {
+    return if (std.math.isNan(a)) a else if (std.math.isNan(b)) b else if (a > b) a else b;
+}
+
+/// tf_mm3_attn in kv8 mode for one (row, kv head): q [16][128], codes kc, vc [pos + 1][128], scales ks, vs, ids.
+pub fn attend(q: []const f32, kc: []const u8, ks: []const f32, vc: []const u8, vs: []const f32, ids: []const i32, pos: usize, scale: f32, m: Mutant, round: bool, out: []f32) void {
+    for (0..16) |h| {
+        var o: [128]f32 = @splat(0);
+        var mx: f32 = -inf32;
+        var l: f32 = 0;
+        var seen: usize = 0;
+        for (ids) |b| if (b >= 0) {
+            seen += 128;
+        };
+        const tile: usize = if (m == .window_split and seen < 1024) 16 else 32;
+        for (ids) |b| {
+            if (b < 0) break;
+            var k0: usize = 0;
+            while (k0 < 128) : (k0 += tile) {
+                const first = @as(usize, @intCast(b)) * 128 + k0;
+                if (first > pos) break;
+                const nvalid = @min(tile, pos + 1 - first);
+                var sc: [32]f32 = undefined;
+                for (0..nvalid) |j| {
+                    var a: f32 = 0;
+                    for (0..128) |e| a = a + q[h * 128 + e] * widen(kc[(first + j) * 128 + e]);
+                    if (m != .k_scale_missing) a = a * ks[first + j];
+                    sc[j] = a * scale;
+                }
+                var mt = sc[0];
+                for (sc[1..nvalid]) |s| mt = nmax(mt, s);
+                const mn = nmax(mx, mt);
+                const alpha: f32 = if (mx == -inf32) 0 else @exp(mx - mn);
+                l = l * alpha;
+                for (&o) |*x| x.* = x.* * alpha;
+                for (0..nvalid) |j| {
+                    const p = @exp(sc[j] - mn);
+                    l = l + (if (m == .v_scale_on_sum) p * vs[first + j] else p);
+                    const ps = if (m == .v_scale_missing) p else p * vs[first + j];
+                    for (&o, 0..) |*x, e| x.* = x.* + ps * widen(vc[(first + j) * 128 + e]);
+                }
+                mx = mn;
+            }
+        }
+        for (0..128) |e| out[h * 128 + e] = if (round) bf.round32(o[e] / l) else o[e] / l;
+    }
+}
diff --git a/zig/tests/minimax_proj_tests.zig b/zig/tests/minimax_proj_tests.zig
new file mode 100644
index 0000000..2bdf766
--- /dev/null
+++ b/zig/tests/minimax_proj_tests.zig
@@ -0,0 +1,283 @@
+//! MiniMax-M3.1-Flash fp16 index projection and per-rank pick, host only: twins, mutants, merge rule, records.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const tp = @import("mm3_tp");
+const twin = @import("minimax_proj_twin.zig");
+
+const c = core.contract.spec;
+const px = cuda.minimax_m3_proj;
+const testing = std.testing;
+const registry = core.contract.registry;
+
+const hidden = 6144;
+const iq_w = 256; // this rank's two index heads
+const ik_w = 128;
+
+test {
+    _ = px;
+}
+
+fn bf16v(rng: std.Random, n: usize, sd: f32) ![]f32 {
+    const v = try testing.allocator.alloc(f32, n);
+    for (v) |*x| x.* = c.fromBf16(c.toBf16(rng.floatNorm(f32) * sd));
+    return v;
+}
+
+fn fp16v(rng: std.Random, n: usize, sd: f32) ![]f32 {
+    const v = try testing.allocator.alloc(f32, n);
+    for (v) |*x| {
+        const h: f16 = @floatCast(rng.floatNorm(f32) * sd);
+        x.* = h;
+    }
+    return v;
+}
+
+fn fromBits(ot: twin.OutType, b: u16) f64 {
+    return switch (ot) {
+        .f16 => @as(f16, @bitCast(b)),
+        .bf16 => c.fromBf16(b),
+    };
+}
+
+/// The projection of `rows` rows through `n` outputs, as the kernel's call computes it.
+fn call(x: []const f32, w: []const f32, rows: usize, n: usize, ot: twin.OutType, m: twin.Mutant, out: []u16) void {
+    for (0..rows) |r| for (0..n) |e| {
+        out[r * n + e] = twin.proj(x[r * hidden ..][0..hidden], w[e * hidden ..][0..hidden], hidden, rows, ot, m);
+    };
+}
+
+fn dot(x: []const f32, w: []const f32) struct { sum: f64, mag: f64 } {
+    var s: f64 = 0;
+    var a: f64 = 0;
+    for (x, w) |p, q| {
+        s += @as(f64, p) * q;
+        a += @abs(@as(f64, p) * q);
+    }
+    return .{ .sum = s, .mag = a };
+}
+
+test "products of bf16 and fp16 values are exact in fp32, so the fma only rounds the sums" {
+    var prng = std.Random.DefaultPrng.init(41);
+    const rng = prng.random();
+    for (0..20000) |_| {
+        const a = c.fromBf16(c.toBf16(rng.floatNorm(f32) * 3));
+        const hw: f16 = @floatCast(rng.floatNorm(f32) * 0.2);
+        const b: f32 = hw;
+        try testing.expectEqual(@as(f64, a) * b, @as(f64, a * b));
+    }
+}
+
+test "fp32 sums track the float64 dot within the chain bound, rows 1 to 17, fp16 and bf16 outputs, both matrices" {
+    var prng = std.Random.DefaultPrng.init(42);
+    const rng = prng.random();
+    const x = try bf16v(rng, 17 * hidden, 1.5);
+    defer testing.allocator.free(x);
+    const w = try fp16v(rng, iq_w * hidden, 0.03);
+    defer testing.allocator.free(w);
+    const out = try testing.allocator.alloc(u16, 17 * iq_w);
+    defer testing.allocator.free(out);
+    inline for (.{ twin.OutType.f16, twin.OutType.bf16 }) |ot| {
+        call(x, w, 17, iq_w, ot, .none, out);
+        const unit: f64 = if (ot == .f16) 0x1p-11 else 0x1p-8;
+        for (0..17) |r| for (0..iq_w) |e| {
+            const d = dot(x[r * hidden ..][0..hidden], w[e * hidden ..][0..hidden]);
+            // 48 fma steps a lane chain, the 4-chain sum, the 5-level tree, then the one rounding to the output
+            const work = c.gamma(48 + 3 + 5, 0x1p-24) * d.mag;
+            const got = fromBits(ot, out[r * iq_w + e]);
+            try testing.expect(@abs(got - d.sum) <= work + unit * (@abs(d.sum) + work) + (if (ot == .f16) 0x1p-24 else 0x1p-133));
+        };
+    }
+}
+
+test "a row's fp32 sum is the same in a call of 1, 3, 4, 5 or 17 rows and at any row index; the planted faults are caught" {
+    var prng = std.Random.DefaultPrng.init(43);
+    const rng = prng.random();
+    const x = try bf16v(rng, 17 * hidden, 2);
+    defer testing.allocator.free(x);
+    const w = try fp16v(rng, ik_w * hidden, 0.05);
+    defer testing.allocator.free(w);
+    // the sums, before the output's rounding hides their last 13 bits
+    var full: [17 * ik_w]f32 = undefined;
+    var part: [17 * ik_w]f32 = undefined;
+    sums(x, w, 17, .none, &full);
+    for ([_]usize{ 1, 3, 4, 5 }) |n| {
+        sums(x[0 .. n * hidden], w, n, .none, part[0 .. n * ik_w]);
+        try testing.expectEqualSlices(f32, full[0 .. n * ik_w], part[0 .. n * ik_w]);
+    }
+    sums(x[16 * hidden ..], w, 1, .none, part[0..ik_w]);
+    try testing.expectEqualSlices(f32, full[16 * ik_w ..][0..ik_w], part[0..ik_w]);
+    // a depth that follows the row count: row 0 of 17 differs from row 0 alone
+    var one: [ik_w]f32 = undefined;
+    sums(x, w, 17, .split_by_rows, &part);
+    sums(x[0..hidden], w, 1, .split_by_rows, &one);
+    try testing.expect(!std.mem.eql(f32, part[0..ik_w], &one));
+    // the other faults change the sums of a call that the real order leaves alone
+    for ([_]twin.Mutant{ .reorder_chains, .drops_tail, .half_accum }) |bad| {
+        sums(x, w, 17, bad, &part);
+        try testing.expect(!std.mem.eql(f32, &full, &part));
+    }
+    // rounding to the wrong type changes the output bits
+    var bits: [17 * ik_w]u16 = undefined;
+    var wrong: [17 * ik_w]u16 = undefined;
+    call(x, w, 17, ik_w, .f16, .none, &bits);
+    call(x, w, 17, ik_w, .f16, .wrong_out, &wrong);
+    try testing.expect(!std.mem.eql(u16, &bits, &wrong));
+}
+
+fn sums(x: []const f32, w: []const f32, rows: usize, m: twin.Mutant, out: []f32) void {
+    for (0..rows) |r| for (0..ik_w) |e| {
+        out[r * ik_w + e] = twin.projSum(x[r * hidden ..][0..hidden], w[e * hidden ..][0..hidden], hidden, rows, m);
+    };
+}
+
+test "integer inputs sum exactly in any order: the kernel's order equals float64, half accumulation and a dropped tail do not" {
+    var prng = std.Random.DefaultPrng.init(44);
+    const rng = prng.random();
+    const x = try testing.allocator.alloc(f32, 3 * hidden);
+    defer testing.allocator.free(x);
+    const w = try testing.allocator.alloc(f32, 8 * hidden);
+    defer testing.allocator.free(w);
+    // gate 4's shape: multiples mirrored into the second half, partial sums near 2^20, the result small
+    for (0..3) |r| for (0..hidden / 2) |i| {
+        const v: f32 = @floatFromInt(1 + rng.uintLessThan(u32, 32));
+        x[r * hidden + i] = v;
+        x[r * hidden + hidden / 2 + i] = v + if (i < 8) @as(f32, 1) else 0;
+    };
+    for (0..8) |e| for (0..hidden / 2) |i| {
+        const v: f32 = @floatFromInt(1 + rng.uintLessThan(u32, 7));
+        w[e * hidden + i] = v;
+        w[e * hidden + hidden / 2 + i] = -v;
+    };
+    var out: [3 * 8]u16 = undefined;
+    call(x, w, 3, 8, .bf16, .none, &out);
+    for (0..3) |r| for (0..8) |e| {
+        const d = dot(x[r * hidden ..][0..hidden], w[e * hidden ..][0..hidden]);
+        try testing.expectEqual(c.toBf16(@floatCast(d.sum)), out[r * 8 + e]);
+    };
+    for ([_]twin.Mutant{ .half_accum, .drops_tail }) |bad| {
+        var got: [3 * 8]u16 = undefined;
+        call(x, w, 3, 8, .bf16, bad, &got);
+        try testing.expect(!std.mem.eql(u16, &out, &got));
+    }
+}
+
+test "NaN and infinities reach the output as float64 arithmetic gives them" {
+    var prng = std.Random.DefaultPrng.init(45);
+    const rng = prng.random();
+    const x = try bf16v(rng, 4 * hidden, 1);
+    defer testing.allocator.free(x);
+    const w = try fp16v(rng, 16 * hidden, 0.05);
+    defer testing.allocator.free(w);
+    x[0 * hidden + 77] = std.math.nan(f32);
+    x[1 * hidden + 5000] = std.math.inf(f32);
+    x[2 * hidden + 6143] = -std.math.inf(f32);
+    x[2 * hidden + 3] = std.math.inf(f32);
+    var out: [4 * 16]u16 = undefined;
+    call(x, w, 4, 16, .f16, .none, &out);
+    for (0..4) |r| for (0..16) |e| {
+        const d = dot(x[r * hidden ..][0..hidden], w[e * hidden ..][0..hidden]);
+        try testing.expectEqual(c.classOf(d.sum), c.classOf(fromBits(.f16, out[r * 16 + e])));
+    };
+}
+
+test "pick: the slice's best, ties to the lowest id, the vocabulary id is id0 plus the index, padding is never read" {
+    var prng = std.Random.DefaultPrng.init(46);
+    const rng = prng.random();
+    var row: [3000]f32 = undefined;
+    for (0..200) |t| {
+        const n = 1 + rng.uintLessThan(usize, 2999);
+        for (&row) |*v| v.* = @floatFromInt(rng.intRangeAtMost(i32, -4, 4)); // many ties
+        for (row[n..]) |*v| v.* = 1000; // padding that would win
+        const id0: u32 = 782 * 128 * @as(u32, @intCast(t % 2));
+        const got = twin.pick(&row, n, id0, .none);
+        var best: usize = 0;
+        for (row[0..n], 0..) |v, i| if (v > row[best]) {
+            best = i;
+        };
+        try testing.expectEqual(row[best], got.logit);
+        try testing.expectEqual(id0 + @as(u32, @intCast(best)), got.id);
+        for ([_]twin.Mutant{ .forgets_id0, .scans_padding }) |bad| {
+            const w = twin.pick(&row, n, id0 + 1, bad);
+            try testing.expect(w.id != id0 + 1 + @as(u32, @intCast(best)) or w.logit != got.logit);
+        }
+    }
+}
+
+test "pick: two ranks' picks merge to the argmax of the whole vocabulary, as tp.mergePicks gives it" {
+    var prng = std.Random.DefaultPrng.init(47);
+    const rng = prng.random();
+    const split = [2][2]usize{ .{ 0, 384 }, .{ 384, 640 } }; // 5 units of 128 over 2 ranks: 3 and 2 (shard.Share)
+    var logits: [640]f32 = undefined;
+    for (0..300) |_| {
+        for (&logits) |*x| x.* = @floatFromInt(rng.intRangeAtMost(i32, -3, 3));
+        var picks: [2]tp.Pick = undefined;
+        for (0..2) |r| {
+            const lo = split[r][0];
+            const hi = split[r][1];
+            var row: [400]f32 = @splat(7777); // padded slot
+            @memcpy(row[0 .. hi - lo], logits[lo..hi]);
+            const p = twin.pick(&row, hi - lo, @intCast(lo), .none);
+            picks[r] = .{ .logit = p.logit, .id = p.id };
+        }
+        const merged = tp.mergePicks(&picks);
+        const mx = std.mem.max(f32, &logits);
+        try testing.expectEqual(mx, merged.logit);
+        try testing.expectEqual(@as(u32, @intCast(std.mem.indexOfScalar(f32, &logits, mx).?)), merged.id);
+    }
+}
+
+test "pick: NaN ranks last, an all-NaN row goes to its lowest id, and the planted faults are caught" {
+    const nan = std.math.nan(f32);
+    var row: [1000]f32 = undefined;
+    for (&row, 0..) |*v, i| v.* = @floatFromInt(@as(i32, @intCast(i % 7)) - 3);
+    row[0] = nan;
+    row[5] = nan;
+    const got = twin.pick(&row, 1000, 100, .none);
+    try testing.expectEqual(@as(f32, 3), got.logit);
+    try testing.expectEqual(@as(u32, 100 + 6), got.id); // the first 3 is at index 6
+    // a NaN at the lowest index stays under the older comparison, a NaN-wins pick returns it
+    try testing.expect(std.math.isNan(twin.pick(&row, 1000, 100, .nan_wins).logit));
+    try testing.expect(std.math.isNan(twin.pick(&row, 1000, 100, .nan_first_stays).logit));
+    // the tie rule: the highest id wins under the planted fault
+    try testing.expect(twin.pick(&row, 1000, 100, .ties_to_last).id != got.id);
+    @memset(&row, nan);
+    const all = twin.pick(&row, 700, 5, .none);
+    try testing.expect(std.math.isNan(all.logit));
+    try testing.expectEqual(@as(u32, 5), all.id);
+    // fewer logits than threads: the idle threads never win
+    const small = twin.pick(&[_]f32{ -5, -2, -9 }, 3, 40, .none);
+    try testing.expectEqual(@as(f32, -2), small.logit);
+    try testing.expectEqual(@as(u32, 41), small.id);
+    // the host merge ranks NaN last too, in either order
+    const fin: tp.Pick = .{ .logit = -8, .id = 700 };
+    try testing.expectEqual(fin, tp.mergePicks(&.{ .{ .logit = nan, .id = 3 }, fin }));
+    try testing.expectEqual(fin, tp.mergePicks(&.{ fin, .{ .logit = nan, .id = 3 } }));
+}
+
+test "gate 5: the three launches are registered, match the geometry, and fit every chip" {
+    const want = [_]struct { sym: []const u8, threads: u32, static: u32 }{
+        .{ .sym = "tf_mm3_proj_bf16", .threads = px.threads, .static = 0 },
+        .{ .sym = "tf_mm3_proj_f32", .threads = px.threads, .static = 0 },
+        .{ .sym = "tf_mm3_pick", .threads = px.pick_threads, .static = 2 * (px.pick_threads / 32) * 4 },
+    };
+    var mine: [3]registry.CudaRecord = undefined;
+    for (want, &mine) |w, *m| {
+        const rec = for (registry.cuda) |r| {
+            if (std.mem.eql(u8, r.launch.symbol, w.sym)) break r;
+        } else return error.RecordMissing;
+        try testing.expectEqualStrings("minimax_m3_proj", rec.launch.image);
+        try testing.expectEqual(w.threads, rec.launch.threads);
+        try testing.expectEqual(@as(u32, 0), rec.launch.dynamic);
+        for (rec.usage) |u| {
+            try testing.expectEqual(w.static, u.static);
+            try testing.expectEqual(w.threads, u.bound);
+            try testing.expect(u.regs * w.threads <= 65536);
+        }
+        m.* = rec;
+    }
+    try testing.expectEqual(@as(usize, 0), try registry.checkCuda(testing.allocator, &mine, true));
+    var over = mine[2];
+    over.launch.threads = 512;
+    try testing.expect(try registry.checkCuda(testing.allocator, &.{over}, true) > 0);
+}
diff --git a/zig/tests/minimax_proj_twin.zig b/zig/tests/minimax_proj_twin.zig
new file mode 100644
index 0000000..256a069
--- /dev/null
+++ b/zig/tests/minimax_proj_twin.zig
@@ -0,0 +1,126 @@
+//! Host twins of minimax_m3_proj.cu: the same fp32 operation order of the projection and the pick, with mutants.
+const std = @import("std");
+const core = @import("core");
+
+const c = core.contract.spec;
+
+pub const Mutant = enum {
+    none,
+    /// The projection's chain assignment follows the row count (a split-K whose depth depends on the call).
+    split_by_rows,
+    /// The four lane chains are summed in a different order.
+    reorder_chains,
+    /// The result is rounded to bf16 although fp16 was asked.
+    wrong_out,
+    /// The last chunk of the reduction is not read.
+    drops_tail,
+    /// The chains accumulate in fp16.
+    half_accum,
+    /// The pick: equal logits go to the higher id.
+    ties_to_last,
+    /// The pick: a NaN beats every number.
+    nan_wins,
+    /// The pick: the id is the index in the slice, not the vocabulary id.
+    forgets_id0,
+    /// The pick: the padding after the slice is scanned too.
+    scans_padding,
+    /// The pick: the first NaN a lane sees stays (the comparison tp.zig had before it ranked NaN last).
+    nan_first_stays,
+};
+
+fn tree(v: *[32]f32) f32 {
+    var o: usize = 16;
+    while (o > 0) : (o >>= 1) {
+        var next: [32]f32 = undefined;
+        for (&next, 0..) |*n, l| n.* = v[l] + v[l ^ o];
+        v.* = next;
+    }
+    return v[0];
+}
+
+pub const OutType = enum { f16, bf16 };
+
+/// One output's fp32 sum as the kernel forms it: x exact bf16 or fp32 values, w exact fp16 values.
+pub fn projSum(x: []const f32, w: []const f32, k: usize, rows_in_call: usize, m: Mutant) f32 {
+    var lane: [32]f32 = undefined;
+    const slices: usize = if (m == .split_by_rows) @max(1, @min(rows_in_call, 4)) else 1;
+    const chunks = if (m == .drops_tail) k / 128 - 1 else k / 128;
+    for (&lane, 0..) |*s, l| {
+        var acc: [4]f32 = @splat(0);
+        var j: usize = 0;
+        while (j < chunks) : (j += 1) {
+            const at = 4 * (l + 32 * j);
+            for (0..4) |i| {
+                const slot = if (slices > 1) (j % slices) % 4 else i;
+                if (m == .half_accum) {
+                    const h: f16 = @floatCast(@mulAdd(f32, x[at + i], w[at + i], acc[slot]));
+                    acc[slot] = h;
+                } else acc[slot] = @mulAdd(f32, x[at + i], w[at + i], acc[slot]);
+            }
+        }
+        s.* = if (m == .reorder_chains) (acc[0] + acc[2]) + (acc[1] + acc[3]) else (acc[0] + acc[1]) + (acc[2] + acc[3]);
+    }
+    return tree(&lane);
+}
+
+/// The bits of the sum's single rounding to fp16 or bf16 (the planted `wrong_out` rounds to the other).
+pub fn proj(x: []const f32, w: []const f32, k: usize, rows_in_call: usize, ot: OutType, m: Mutant) u16 {
+    const sum = projSum(x, w, k, rows_in_call, m);
+    const to_bf = (ot == .bf16) != (m == .wrong_out);
+    if (to_bf) return c.toBf16(sum);
+    const h: f16 = @floatCast(sum);
+    return @bitCast(h);
+}
+
+pub const Pick = struct { logit: f32, id: u32 };
+
+/// The kernel's order: true when (bv, bi) beats (av, ai).
+fn beats(bv: f32, bi: u32, av: f32, ai: u32, m: Mutant) bool {
+    const an = std.math.isNan(av);
+    const bn = std.math.isNan(bv);
+    if (m == .nan_wins) {
+        if (bn) return !an or bi < ai;
+        if (an) return false;
+    } else if (m == .nan_first_stays) {
+        if (an or bn) return false;
+    } else {
+        if (an and bn) return bi < ai;
+        if (bn) return false;
+        if (an) return true;
+    }
+    if (m == .ties_to_last) return bv > av or (bv == av and bi > ai);
+    return bv > av or (bv == av and bi < ai);
+}
+
+/// tf_mm3_pick on one padded row: 256 threads stride the slice, a warp's lanes meet in an xor tree, then the warps.
+pub fn pick(row: []const f32, n: usize, id0: u32, m: Mutant) Pick {
+    const nan = std.math.nan(f32);
+    const scan = if (m == .scans_padding) row.len else n;
+    var t: [256]Pick = undefined;
+    for (&t, 0..) |*p, th| {
+        p.* = .{ .logit = nan, .id = std.math.maxInt(i32) };
+        var i = th;
+        while (i < scan) : (i += 256) {
+            if (beats(row[i], @intCast(i), p.logit, p.id, m)) p.* = .{ .logit = row[i], .id = @intCast(i) };
+        }
+    }
+    var warp: [8]Pick = undefined;
+    for (&warp, 0..) |*w, wi| {
+        var lanes: [32]Pick = t[wi * 32 ..][0..32].*;
+        var o: usize = 16;
+        while (o > 0) : (o >>= 1) {
+            var next = lanes;
+            for (&next, 0..) |*p, l| {
+                const other = lanes[l ^ o];
+                if (beats(other.logit, other.id, p.logit, p.id, m)) p.* = other;
+            }
+            lanes = next;
+        }
+        w.* = lanes[0];
+    }
+    var best = warp[0];
+    for (warp[1..]) |p| if (beats(p.logit, p.id, best.logit, best.id, m)) {
+        best = p;
+    };
+    return .{ .logit = best.logit, .id = if (m == .forgets_id0) best.id else id0 + best.id };
+}
diff --git a/zig/tests/minimax_ref_model_tests.zig b/zig/tests/minimax_ref_model_tests.zig
new file mode 100644
index 0000000..9dc6dfe
--- /dev/null
+++ b/zig/tests/minimax_ref_model_tests.zig
@@ -0,0 +1,312 @@
+//! MiniMax-M3.1-Flash float64 reference: layers and a 2-layer model on synthetic EXL3 weights, boundaries, switches.
+const std = @import("std");
+const core = @import("core");
+const ref = @import("minimax_ref");
+const synth = @import("minimax_ref_synth.zig");
+const mr = core.minimax_ref;
+
+const expect = std.testing.expect;
+
+fn arena() std.heap.ArenaAllocator {
+    return std.heap.ArenaAllocator.init(std.heap.page_allocator);
+}
+
+fn small(sw: ref.Switches) ref.Config {
+    var c = synth.tiny(sw);
+    c.block = 16;
+    c.topk_blocks = 3;
+    return c;
+}
+
+fn run(a: std.mem.Allocator, c: ref.Config, o: synth.Options, toks: []const usize) ![]f64 {
+    return synth.trace(a, try synth.model(a, c, o), toks, o.vocab);
+}
+
+test "EXL3 mul1 linears at 3, 4, 5 and 6 bits dequantize to finite, distinct, nonzero matrices" {
+    var ar = arena();
+    defer ar.deinit();
+    var g = synth.gen(ar.allocator(), 4);
+    var prev: ?ref.Linear = null;
+    for ([_]u16{ 6, 8, 10, 12 }) |halves| {
+        const l = try g.exl3Linear(halves, 128, 128, 1);
+        var sum: f64 = 0;
+        for (l.w) |v| {
+            try expect(std.math.isFinite(v));
+            sum += v * v;
+        }
+        try expect(sum > 1e-3);
+        if (prev) |p| try expect(synth.maxDiff(p.w, l.w) > 0);
+        prev = l;
+        var y: [128]f64 = undefined;
+        var x: [128]f64 = @splat(0);
+        x[5] = 2;
+        l.apply(&x, &y);
+        for (y, 0..) |v, j| try std.testing.expectApproxEqAbs(2 * l.w[5 * 128 + j], v, 1e-15);
+    }
+}
+
+test "model: deterministic, finite, and causal (a later token never changes an earlier position's logits)" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const c = small(.{});
+    const toks = try synth.tokens(a, 40, 128, 2);
+    const x = try run(a, c, .{}, toks);
+    const y = try run(a, c, .{}, toks);
+    try std.testing.expectEqualSlices(f64, x, y);
+    for (x) |v| try expect(std.math.isFinite(v));
+    var other = try a.dupe(usize, toks);
+    other[39] = (other[39] + 1) % 128;
+    const z = try run(a, c, .{}, other);
+    try std.testing.expectEqualSlices(f64, x[0 .. 39 * 128], z[0 .. 39 * 128]);
+    try expect(synth.maxDiff(x[39 * 128 ..], z[39 * 128 ..]) > 1e-6);
+}
+
+test "block boundary: pos 127 is dense with one block, pos 128 and 129 leave the older block out when topk = 1" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const toks = try synth.tokens(a, 131, 128, 6);
+    var one = synth.tiny(.{});
+    one.topk_blocks = 1;
+    var two = one;
+    two.topk_blocks = 2;
+    var wide = one;
+    wide.topk_blocks = 16;
+    const x1 = try run(a, one, .{}, toks);
+    const x2 = try run(a, two, .{}, toks);
+    const x16 = try run(a, wide, .{}, toks);
+    try std.testing.expectEqualSlices(f64, x2, x16);
+    try std.testing.expectEqualSlices(f64, x1[0 .. 128 * 128], x2[0 .. 128 * 128]);
+    for ([_]usize{ 128, 129, 130 }) |p| try expect(synth.maxDiff(x1[p * 128 ..][0..128], x2[p * 128 ..][0..128]) > 1e-6);
+}
+
+test "partial last block and more blocks than topk: the model runs on 70 tokens of 16-key blocks (5 blocks, topk 3)" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const toks = try synth.tokens(a, 70, 128, 8);
+    const sparse = try run(a, small(.{}), .{}, toks);
+    var dense = small(.{});
+    dense.topk_blocks = 16;
+    const full = try run(a, dense, .{}, toks);
+    try std.testing.expectEqualSlices(f64, sparse[0 .. 48 * 128], full[0 .. 48 * 128]);
+    try expect(synth.maxDiff(sparse[69 * 128 ..], full[69 * 128 ..]) > 1e-9);
+}
+
+fn proj(l: ref.Linear, x: []const f64, out: []f64) void {
+    for (0..l.n) |j| {
+        var s: f64 = 0;
+        for (0..l.k) |i| s += x[i] * l.w[i * l.n + j];
+        out[j] = s;
+    }
+}
+
+fn headNorm(w: []const f64, v: []f64, pos: ?usize, c: ref.Config) void {
+    var t: [128]f64 = undefined;
+    for (0..v.len / 128) |h| {
+        mr.gemmaNorm(v[h * 128 ..][0..128], w, c.eps, true, &t);
+        if (pos) |p| mr.rope(&t, c.rot_dim, p, c.rope_theta, c.sw.rope_layout);
+        @memcpy(v[h * 128 ..][0..128], &t);
+    }
+}
+
+const Scores = struct {
+    s: []const f64,
+    fn lt(self: @This(), x: usize, y: usize) bool {
+        return if (self.s[x] != self.s[y]) self.s[x] > self.s[y] else x < y;
+    }
+};
+
+/// Layer 0's attention at the last position, re-derived from the embeddings alone with sorted brute-force selection.
+fn oracle(a: std.mem.Allocator, m: ref.Model, toks: []const usize) ![]f64 {
+    const c = m.cfg;
+    const ly = m.layers[0];
+    const n = toks.len;
+    const p = n - 1;
+    const ks = try a.alloc(f64, n * 256);
+    const vs = try a.alloc(f64, n * 256);
+    const iks = try a.alloc(f64, n * 128);
+    var q: [512]f64 = undefined;
+    var iq: [256]f64 = undefined;
+    for (toks, 0..) |t, j| {
+        var x: [128]f64 = undefined;
+        mr.gemmaNorm(m.embed[t * 128 ..][0..128], ly.input_norm, c.eps, true, &x);
+        proj(ly.k, &x, ks[j * 256 ..][0..256]);
+        proj(ly.v, &x, vs[j * 256 ..][0..256]);
+        proj(ly.index_k, &x, iks[j * 128 ..][0..128]);
+        headNorm(ly.k_norm, ks[j * 256 ..][0..256], j, c);
+        headNorm(ly.index_k_norm, iks[j * 128 ..][0..128], j, c);
+        if (j == p) {
+            proj(ly.q, &x, &q);
+            proj(ly.index_q, &x, &iq);
+            headNorm(ly.q_norm, &q, p, c);
+            headNorm(ly.index_q_norm, &iq, p, c);
+        }
+    }
+    const ao = try a.alloc(f64, 512);
+    for (0..c.n_kv) |g| {
+        const nb = p / c.block + 1;
+        const sc = try a.alloc(f64, nb);
+        for (sc, 0..) |*b, bi| {
+            b.* = -std.math.inf(f64);
+            for (bi * c.block..@min(bi * c.block + c.block, p + 1)) |j| {
+                var s: f64 = 0;
+                for (0..128) |e| s += iq[g * 128 + e] * iks[j * 128 + e];
+                b.* = @max(b.*, s / @sqrt(128.0));
+            }
+        }
+        sc[nb - 1] = std.math.inf(f64);
+        const order = try a.alloc(usize, nb);
+        for (order, 0..) |*o, i| o.* = i;
+        std.mem.sort(usize, order, Scores{ .s = sc }, Scores.lt);
+        const take = @min(nb, c.topk_blocks);
+        std.mem.sort(usize, order[0..take], {}, std.sort.asc(usize));
+        for (g * 2..g * 2 + 2) |h| {
+            var sm = try a.alloc(f64, n);
+            var cnt: usize = 0;
+            var mx: f64 = -std.math.inf(f64);
+            for (order[0..take]) |b| for (b * c.block..@min(b * c.block + c.block, p + 1)) |j| {
+                var s: f64 = 0;
+                for (0..128) |e| s += q[h * 128 + e] * ks[j * 256 + g * 128 + e];
+                sm[j] = s / @sqrt(128.0);
+                mx = @max(mx, sm[j]);
+                cnt += 1;
+            };
+            var z: f64 = 0;
+            @memset(ao[h * 128 ..][0..128], 0);
+            for (order[0..take]) |b| for (b * c.block..@min(b * c.block + c.block, p + 1)) |j| {
+                const w = @exp(sm[j] - mx);
+                z += w;
+                for (0..128) |e| ao[h * 128 + e] += w * vs[j * 256 + g * 128 + e];
+            };
+            for (ao[h * 128 ..][0..128]) |*v| v.* /= z;
+        }
+    }
+    const h = try a.dupe(f64, m.embed[toks[p] * 128 ..][0..128]);
+    var o: [128]f64 = undefined;
+    proj(ly.o, ao, &o);
+    for (h, o) |*x, y| x.* += y;
+    return h;
+}
+
+fn checkOracle(c: ref.Config, n: usize) !void {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const m = try synth.model(a, c, .{});
+    const toks = try synth.tokens(a, n, 128, 12);
+    const lc = (try ref.Cache.init(a, c, 1, n)).layers;
+    var h: [128]f64 = undefined;
+    for (toks, 0..) |t, pos| {
+        @memcpy(&h, m.embed[t * 128 ..][0..128]);
+        try ref.attention(c, m.layers[0], &lc[0], &h, pos, a);
+    }
+    const want = try oracle(a, m, toks);
+    for (want, h) |p, q| try std.testing.expectApproxEqAbs(p, q, 1e-12);
+}
+
+test "layer attention equals a from-scratch brute-force derivation (70 tokens x 16-key blocks; 130 tokens x 128-key blocks)" {
+    try checkOracle(small(.{}), 70);
+    var c = synth.tiny(.{});
+    c.topk_blocks = 1;
+    try checkOracle(c, 130);
+    try checkOracle(c, 129);
+    try checkOracle(c, 128);
+}
+
+const Case = struct { name: []const u8, sw: ref.Switches };
+
+test "every UNVERIFIED switch changes the model's output (default vs the other branch)" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const toks = try synth.tokens(a, 70, 128, 21);
+    const base = try run(a, small(.{}), .{}, toks);
+    const cases = [_]Case{
+        .{ .name = "rope gptj", .sw = .{ .rope_layout = .gptj_interleaved } },
+        .{ .name = "index_rope off", .sw = .{ .index_rope = false } },
+        .{ .name = "init count 1", .sw = .{ .sparse_init_block = 1 } },
+        .{ .name = "init inclusive", .sw = .{ .init_mode = .inclusive } },
+        .{ .name = "local 0", .sw = .{ .sparse_local_block = 0 } },
+        .{ .name = "local window 2", .sw = .{ .local_mode = .trailing_window, .sparse_local_block = 2 } },
+        .{ .name = "w1 is up", .sw = .{ .w1_is_gate = false } },
+        .{ .name = "up_plus_one off", .sw = .{ .up_plus_one = false } },
+        .{ .name = "router scale only", .sw = .{ .router_norm = .scale_only } },
+        .{ .name = "router normalize only", .sw = .{ .router_norm = .normalize_only } },
+        .{ .name = "router bias in weights", .sw = .{ .router_weights_use_bias = true } },
+        .{ .name = "scale routed+shared", .sw = .{ .scale_on = .routed_plus_shared } },
+        .{ .name = "plain layer norms", .sw = .{ .gemma_layer_norms = false } },
+        .{ .name = "plain qk norms", .sw = .{ .gemma_qk_norms = false } },
+        .{ .name = "plain index norms", .sw = .{ .gemma_index_norms = false } },
+        .{ .name = "bf16 norm", .sw = .{ .bf16_norm_out = true } },
+        .{ .name = "bf16 proj", .sw = .{ .bf16_proj_out = true } },
+        .{ .name = "bf16 rope", .sw = .{ .bf16_rope_out = true } },
+        .{ .name = "bf16 attn", .sw = .{ .bf16_attn_out = true } },
+        .{ .name = "bf16 act", .sw = .{ .bf16_act_out = true } },
+        .{ .name = "bf16 residual", .sw = .{ .bf16_residual = true } },
+    };
+    for (cases) |cs| {
+        const x = try run(a, small(cs.sw), .{}, toks);
+        const d = synth.maxDiff(base, x);
+        std.testing.expect(d > 1e-9 and std.math.isFinite(d)) catch |e| {
+            std.debug.print("switch {s} did not change the output (diff {e})\n", .{ cs.name, d });
+            return e;
+        };
+    }
+}
+
+test "switches that need a special scenario: gate clamp (large activations) and the tie rule (all block scores equal)" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const toks = try synth.tokens(a, 20, 128, 5);
+    const big: synth.Options = .{ .gain = 60 };
+    const upper = try run(a, small(.{}), big, toks);
+    const sym = try run(a, small(.{ .gate_clamp = .symmetric }), big, toks);
+    try expect(synth.maxDiff(upper, sym) > 1e-9);
+    const flat: synth.Options = .{ .zero_index_q = true };
+    const long = try synth.tokens(a, 70, 128, 5);
+    const lo = try run(a, small(.{}), flat, long);
+    const hi = try run(a, small(.{ .tie = .higher_block }), flat, long);
+    try expect(synth.maxDiff(lo, hi) > 1e-9);
+    const again = try run(a, small(.{}), flat, long);
+    try std.testing.expectEqualSlices(f64, lo, again);
+}
+
+test "bf16 residual switch leaves the hidden state on the bf16 grid after attention and after the MoE FFN" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const m = try synth.model(a, small(.{ .bf16_residual = true }), .{});
+    const cache = try ref.Cache.init(a, m.cfg, 2, 4);
+    const h = try a.dupe(f64, m.embed[3 * 128 ..][0..128]);
+    try ref.attention(m.cfg, m.layers[1], &cache.layers[1], h, 0, a);
+    for (h) |v| try std.testing.expectEqual(core.bf16_round.bf16(v), v);
+    @memset(h, 0.3);
+    try ref.feedForward(m.cfg, m.layers[1], h, a);
+    for (h) |v| try std.testing.expectEqual(core.bf16_round.bf16(v), v);
+    var any = false;
+    for (h) |v| any = any or v != 0.3;
+    try expect(any);
+}
+
+test "fp16 index input changes the cached index keys (selection may not flip, the keys do)" {
+    var ar = arena();
+    defer ar.deinit();
+    const a = ar.allocator();
+    const m = try synth.model(a, small(.{}), .{});
+    var m16 = m;
+    m16.cfg.sw.fp16_index_input = true;
+    const toks = try synth.tokens(a, 5, 128, 3);
+    const c0 = try ref.Cache.init(a, m.cfg, 1, 5);
+    const c1 = try ref.Cache.init(a, m.cfg, 1, 5);
+    for (toks, 0..) |t, pos| {
+        const h0 = try a.dupe(f64, m.embed[t * 128 ..][0..128]);
+        const h1 = try a.dupe(f64, h0);
+        try ref.attention(m.cfg, m.layers[0], &c0.layers[0], h0[0..], pos, a);
+        try ref.attention(m16.cfg, m16.layers[0], &c1.layers[0], h1[0..], pos, a);
+    }
+    try expect(synth.maxDiff(c0.layers[0].ik, c1.layers[0].ik) > 1e-9);
+    try std.testing.expectEqualSlices(f64, c0.layers[0].v, c1.layers[0].v);
+}
