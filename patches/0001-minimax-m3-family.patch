+//! test-minimax-tp: MiniMax-M3.1-Flash's rank contract, collective plan, rank-order reduction and fingerprint on the host, no GPU.
+const std = @import("std");
+
+pub fn step(b: *std.Build, host: std.Build.ResolvedTarget, core: *std.Build.Module) *std.Build.Step {
+    const canon = b.createModule(.{ .root_source_file = b.path("zig/src/cluster/canon.zig"), .target = host, .optimize = .debug });
+    const imports: []const std.Build.Module.Import = &.{ .{ .name = "core", .module = core }, .{ .name = "canon", .module = canon } };
+    const s = b.step("test-minimax-tp", "MiniMax-M3.1-Flash rank contract, TP collectives, rank-order sums and rank fingerprint without a GPU");
+    for ([_][]const u8{ "tp.zig", "ranks.zig" }) |file| {
+        const m = b.createModule(.{
+            .root_source_file = b.path(b.fmt("zig/src/families/minimax_m3/{s}", .{file})),
+            .target = host,
+            .optimize = .debug,
+            .link_libc = true,
+            .imports = imports,
+        });
+        s.dependOn(&b.addRunArtifact(b.addTest(.{ .root_module = m })).step);
+    }
+    return s;
+}
diff --git a/zig/kernels/cuda/contract_controls.cu b/zig/kernels/cuda/contract_controls.cu
index afa625a..85683b0 100644
--- a/zig/kernels/cuda/contract_controls.cu
+++ b/zig/kernels/cuda/contract_controls.cu
@@ -135,3 +135,26 @@ TF_CTL_TAIL(tf_ctl_tail_drop_branch_out, tf_rms_tail::BRANCH_OUT)
 TF_CTL_TAIL(tf_ctl_tail_drop_sum, tf_rms_tail::SUM)
 TF_CTL_TAIL(tf_ctl_tail_drop_row, tf_rms_tail::ROW)
 #undef TF_CTL_TAIL
+
+// Gate 1 (mode 0) and gate 3 (mode 1): minimax_m3_act.cu's swigluoai bf16 rows with one fault each. Mode 0 clamps by
+// fminf/fmaxf, which hand back the limit for a NaN (the plan's "fminf drops NaN"), so a NaN input reads as a finite number.
+// Mode 1 is right at whole 256-value tiles and loses the last value of a row otherwise.
+#include "minimax_m3_act.cuh"
+
+extern "C" __global__ void __launch_bounds__(256) tf_ctl_mm3_act(const __nv_bfloat16* gate, const __nv_bfloat16* up,
+                                                                  __nv_bfloat16* out, int n, float alpha, float limit,
+                                                                  float up_bias, int mode) {
+    const int64_t r = blockIdx.x;
+    const int i = blockIdx.y * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    if (mode == 1 && n % 256 != 0 && i == n - 1) return;
+    float g = __bfloat162float(gate[r * n + i]);
+    float u = __bfloat162float(up[r * n + i]);
+    if (mode == 0) {
+        g = fminf(g, limit);
+        u = fminf(fmaxf(u, -limit), limit);
+        out[r * n + i] = __float2bfloat16_rn(tf_mm3::swigluoai(g, u, alpha, 0.f, up_bias, false));
+        return;
+    }
+    out[r * n + i] = __float2bfloat16_rn(tf_mm3::swigluoai(g, u, alpha, limit, up_bias, false));
+}
