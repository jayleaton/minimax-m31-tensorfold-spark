+//! The contract the MiniMax-M3.1-Flash engine, forward, prefill, backend, follower, weights and kernels share.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const pool = @import("pool.zig");
+const ranks = @import("ranks.zig");
+const sparse = cuda.minimax_m3_sparse;
+
+pub const Sampling = lanes.Sampling;
+pub const Paged = sparse.Paged;
+pub const Rows = sparse.Rows;
+pub const Scratch = sparse.Scratch;
+
+// M12: a prompt chunk, whole pages (GLM's fw.prefill_rows).
+pub const prefill_rows: u32 = 2048;
+// Rows of one verify window; UNVERIFIED on a GPU (widths 1, 2, 3, 16, 17, 64, 128 are its gate).
+pub const window_rows: u32 = 16;
+// Rows of one forward shared by several streams' windows (GLM: 32), and the streams in it.
+pub const shared_rows: u32 = 64;
+pub const max_shared: u32 = 16;
+// Widest forward any caller makes; the router, expert and sparse scratch are sized by it.
+pub const max_rows: u32 = prefill_rows;
+
+comptime {
+    if (prefill_rows % pool.page_tokens != 0) @compileError("a prompt chunk must be whole pages: marks and resumes sit on pages");
+    if (window_rows > shared_rows or shared_rows > prefill_rows) @compileError("window <= shared <= chunk");
+    if (max_shared * window_rows < shared_rows) @compileError("a shared forward must be fillable by max_shared windows");
+}
+
+/// The 13 mismatches of the GLM-reuse study, resolved; the prose is docs/interface-decisions.md.
+pub const decisions = struct {
+    // M1: every stream, the engine's own too, is a slot of the paged pool; no full-window sequence lives outside it.
+    pub const all_paged = true;
+    pub const free_streams: u32 = 0;
+    // M2: the backend owns a radix prompt cache over the pool's pages; the host builds no `pc.Store`.
+    pub const owns_prompt_cache = true;
+    // M3: one int32 device table of slots x max_pages entries; a window's row reads at slot * max_pages.
+    pub const table_entry_bytes: usize = 4;
+    // M5: the T0 Switches stay at their compile-time defaults; none is runtime-selectable, so none is fingerprinted.
+    pub const switches_runtime = false;
+    // M7: Layer.shared_input stays false (correct, slower) until a device-side check of the gate/up scales exists.
+    pub const shared_input = false;
+    // M11: TF_ROCE and TF_ROCE_MAX_KB are in Settings and in the fingerprint (ranks.zig).
+    pub const roce_in_fingerprint = true;
+    // M13: the head is cut in 128-row units; logits cross ranks in LogitsGather slots, greedy picks in mergePicks.
+    pub const head_unit: usize = 128;
+};
+
+// One stream's window of a shared verify: its slot, its ids and its drawn tokens (GLM's Part).
+pub const Part = struct { slot: u32, ids: []const u32, out: []u32, bits: u64 = 0 };
+// Where a prompt pass resumes: `at` rows already in the stream's adopted pages (a multiple of the page); no state id.
+pub const Resume = struct { at: usize };
+// Rank 0's marks in a prompt pass: `call` may keep the prefix at a mark (a page multiple).
+pub const Marks = struct { at: []const u32, ctx: *anyopaque, call: *const fn (ctx: *anyopaque, at: u32) void };
+pub const Cancel = struct { ptr: ?*anyopaque, check: *const fn (?*anyopaque) bool };
+// One stream's rows in a shared forward: rows [row0, row0 + rows) of the batch belong to `slot`.
+pub const Seg = struct { slot: u32, row0: u32, rows: u32 };
+
+// What `Engine.init` takes besides the device and the checkpoint.
+pub const EngineOptions = struct {
+    capacity: usize, // tokens a sequence holds (context + window_rows, whole pages)
+    settings: ranks.Settings,
+    slots: u32 = 1, // streams the block table has rows for; `attach` raises it to the planned streams
+    drafter: ?[]const u8 = null, // the dspark draft's folder (the same on every rank): its taps, weights and rings load with the engine
+};
+
+// M3: entry offset of `slot`'s row in the device table (`Paged.row_tab` holds one per batch row).
+pub fn tableOffset(slot: u32, max_pages: usize) i32 {
+    return @intCast(@as(usize, slot) * max_pages);
+}
+
+// Fills `out[row0 .. row0 + rows]` of every segment with that segment's table offset.
+pub fn rowTabs(out: []i32, segs: []const Seg, max_pages: usize) void {
+    for (segs) |s| @memset(out[s.row0..][0..s.rows], tableOffset(s.slot, max_pages));
+}
+
+// Pages a rank's table row holds: whole pages of the capacity.
+pub fn maxPages(capacity: usize) usize {
+    return (capacity + pool.page_tokens - 1) / pool.page_tokens;
+}
+
+// Bytes of the whole device table for `slots` streams (the layout's fixed part is one row of it, per stream).
+pub fn tableBytes(slots: usize, max_pages: usize) usize {
+    return slots * max_pages * decisions.table_entry_bytes;
+}
+
+pub const Kind = enum(u32) { begin = 1, prefill, chunk, verify, shared, keep, release, end, idle, absorb, draft, snap };
+
+// Tapped rows of the dspark draft: a chunk at rows [0, prefill_rows), a stream's last window at its slot's rows.
+pub fn tapWindowRow(slot: u32) u32 {
+    return prefill_rows + slot * window_rows;
+}
+
+// Rows the taps buffer holds for `slots` streams.
+pub fn tapRows(slots: u32) usize {
+    return @as(usize, prefill_rows) + @as(usize, slots) * window_rows;
+}
+
+// One step as it crosses: 64 bytes, then `n` u32 ids.
+pub const Header = extern struct {
+    kind: u32,
+    n: u32 = 0, // ids that follow
+    depth: u32 = 0, // chunk: where it starts; shared: its parts
+    flags: u32 = 0, // begin: sampled; verify, shared: whole rows
+    a: u64 = 0, // keep: rows; prefill, chunk: the rows resumed from the adopted pages
+    seed: u64 = 0, // begin: the sampling seed
+    temperature: f64 = 0,
+    top_p: f64 = 0,
+    min_p: f64 = 0,
+    top_k: u32 = 0, // begin: top_k; chunk: the prompt's length
+    slot: u32 = 0, // the stream's slot the step runs on
+
+    comptime {
+        std.debug.assert(@sizeOf(Header) == 64);
+    }
+};
+
+pub fn laneFacts(window: u32, verify: u32) lanes.Model {
+    return .{ .exact_width = window, .hidden_rows = true, .batch_rows = verify, .max_streams = max_shared, .streams_exact = true, .copy_match = 5, .context_copies = true, .lone_cost_tile = 16 };
+}
+
+// One method the backend, prefill and follower call; `conformsEngine` compares each against it.
+const Method = struct { name: []const u8, args: []const type, ret: type };
+
+fn methods(comptime E: type) []const Method {
+    const gpa = std.mem.Allocator;
+    return &[_]Method{
+        .{ .name = "init", .args = &.{ gpa, std.Io, *const cuda.Driver, *const cuda.Context, []const u8, *const cuda.nccl.Library, cuda.nccl.Comm, usize, usize, EngineOptions }, .ret = *E },
+        .{ .name = "deinit", .args = &.{*E}, .ret = void },
+        .{ .name = "bind", .args = &.{ *E, u32 }, .ret = void },
+        .{ .name = "release", .args = &.{ *E, u32 }, .ret = void },
+        .{ .name = "seqBytes", .args = &.{*const E}, .ret = u64 },
+        .{ .name = "pos", .args = &.{*const E}, .ret = usize },
+        .{ .name = "begin", .args = &.{ *E, ?Sampling }, .ret = void },
+        .{ .name = "beginFollowing", .args = &.{ *E, ?Sampling }, .ret = void },
+        .{ .name = "prefill", .args = &.{ *E, []const u32, ?Resume, ?Cancel, ?Marks }, .ret = u32 },
+        .{ .name = "prefillChunk", .args = &.{ *E, []const u32, usize, usize, ?Resume, ?Cancel, ?Marks }, .ret = ?u32 },
+        .{ .name = "gate", .args = &.{ *E, ?Cancel }, .ret = void },
+        .{ .name = "verify", .args = &.{ *E, []const u32, []u32, u64 }, .ret = void },
+        .{ .name = "verifyShared", .args = &.{ *E, []const Part }, .ret = void },
+        .{ .name = "keep", .args = &.{ *E, usize }, .ret = void },
+        .{ .name = "draw", .args = &.{ *E, u64, usize, u64, u64, []u32 }, .ret = void },
+        .{ .name = "checkGathers", .args = &.{*const E}, .ret = void },
+    };
+}
+
+fn payload(comptime R: type) type {
+    return if (@typeInfo(R) == .error_union) @typeInfo(R).error_union.payload else R;
+}
+
+// Compile error naming the first method of `E` whose parameters or result differ from the contract.
+pub fn conformsEngine(comptime E: type) void {
+    inline for (comptime methods(E)) |m| {
+        if (!@hasDecl(E, m.name)) @compileError("Engine lacks " ++ m.name);
+        const info = @typeInfo(@TypeOf(@field(E, m.name))).@"fn";
+        if (info.param_types.len != m.args.len) @compileError("Engine." ++ m.name ++ " takes a different number of parameters");
+        inline for (info.param_types, m.args) |p, want| {
+            if (p.? != want) @compileError("Engine." ++ m.name ++ " has a parameter of type " ++ @typeName(p.?) ++ ", the contract has " ++ @typeName(want));
+        }
+        if (payload(info.return_type.?) != m.ret) @compileError("Engine." ++ m.name ++ " returns " ++ @typeName(payload(info.return_type.?)) ++ ", the contract has " ++ @typeName(m.ret));
+    }
+}
+
+// What `native/cuda.zig` reads from this family's namespace (the `@hasDecl` surface); a compile error names the gap.
+pub fn conformsNative(comptime F: type) void {
+    inline for (.{ "model_type", "formats", "default_context", "max_segments", "Options", "Loaded", "open", "explain", "explains_open", "weightShare", "capacity", "attach", "fits", "window_rows", "owns_prompt_cache", "cache_limit" }) |name| {
+        if (!@hasDecl(F, name)) @compileError("the family namespace lacks " ++ name);
+    }
+    if (!@hasField(F.Options, "context") or !@hasField(F.Options, "grant") or !@hasField(F.Options, "lanes")) @compileError("Options needs context, grant, lanes");
+    inline for (.{ "backend", "facts", "rows", "stream_bytes", "free_streams", "ctx", "deinit", "layout" }) |name| {
+        if (!@hasField(F.Loaded, name)) @compileError("Loaded lacks " ++ name);
+    }
+}
+
+const Fake = struct {
+    pub fn init(_: std.mem.Allocator, _: std.Io, _: *const cuda.Driver, _: *const cuda.Context, _: []const u8, _: *const cuda.nccl.Library, _: cuda.nccl.Comm, _: usize, _: usize, _: EngineOptions) !*Fake {
+        return error.Unused;
+    }
+    pub fn deinit(_: *Fake) void {}
+    pub fn bind(_: *Fake, _: u32) !void {}
+    pub fn release(_: *Fake, _: u32) void {}
+    pub fn seqBytes(_: *const Fake) u64 {
+        return 0;
+    }
+    pub fn pos(_: *const Fake) usize {
+        return 0;
+    }
+    pub fn begin(_: *Fake, _: ?Sampling) !void {}
+    pub fn beginFollowing(_: *Fake, _: ?Sampling) !void {}
+    pub fn prefill(_: *Fake, _: []const u32, _: ?Resume, _: ?Cancel, _: ?Marks) !u32 {
+        return 0;
+    }
+    pub fn prefillChunk(_: *Fake, _: []const u32, _: usize, _: usize, _: ?Resume, _: ?Cancel, _: ?Marks) !?u32 {
+        return null;
+    }
+    pub fn gate(_: *Fake, _: ?Cancel) !void {}
+    pub fn verify(_: *Fake, _: []const u32, _: []u32, _: u64) !void {}
+    pub fn verifyShared(_: *Fake, _: []const Part) !void {}
+    pub fn keep(_: *Fake, _: usize) !void {}
+    pub fn draw(_: *Fake, _: u64, _: usize, _: u64, _: u64, _: []u32) !void {}
+    pub fn checkGathers(_: *const Fake) !void {}
+};
+
+test "an engine with every method of the contract conforms (a wrong one is a compile error, see the decls above)" {
+    conformsEngine(Fake);
+}
+
+test "the follower's header is the 64 bytes GLM's is, and its kinds start at 1" {
+    try std.testing.expectEqual(@as(usize, 64), @sizeOf(Header));
+    try std.testing.expectEqual(@as(u32, 1), @backingInt(Kind.begin));
+    try std.testing.expectEqual(@as(u32, 9), @backingInt(Kind.idle));
+    try std.testing.expectEqual(@as(u32, 12), @backingInt(Kind.snap));
+    try std.testing.expectEqual(@as(u32, 2048 + 3 * 16), tapWindowRow(3));
+    try std.testing.expectEqual(@as(usize, 2048 + 16), tapRows(1));
+}
+
+test "M3: a shared window's rows read their own slot's table row" {
+    var out = [_]i32{ -1, -1, -1, -1, -1, -1 };
+    rowTabs(&out, &.{ .{ .slot = 2, .row0 = 0, .rows = 3 }, .{ .slot = 0, .row0 = 3, .rows = 2 } }, 512);
+    try std.testing.expectEqualSlices(i32, &.{ 1024, 1024, 1024, 0, 0, -1 }, &out);
+    try std.testing.expectEqual(@as(usize, 513), maxPages(65536 + window_rows));
+    try std.testing.expectEqual(@as(usize, 3 * 512 * 4), tableBytes(3, 512));
+}
+
+test "M4: the layout's page is the geometry's page and its fixed part is one table row, per stream" {
+    const cfg = &@import("config.zig").flash;
+    const dims = try pool.Dims.of(cfg, try @import("shard.zig").Share.of(cfg, 0, 2));
+    const l = dims.layout(512);
+    try std.testing.expectEqual(dims.pageBytes(), l.pageBytes());
+    try std.testing.expectEqual(@as(u64, tableBytes(1, 512)), l.fixed_bytes);
+    try std.testing.expectEqual(@as(u64, 76_800), dims.tokenBytes());
+}
+
+test "M12/M1: widths nest and the lane facts keep windows exact over several streams" {
+    const f = laneFacts(window_rows, shared_rows);
+    try std.testing.expectEqual(window_rows, f.exact_width);
+    try std.testing.expectEqual(shared_rows, f.batch_rows);
+    try std.testing.expect(f.hidden_rows and f.streams_exact and !f.mtp);
+    try std.testing.expect(decisions.all_paged and decisions.free_streams == 0);
+}
diff --git a/zig/src/families/minimax_m3/kv8_test.zig b/zig/src/families/minimax_m3/kv8_test.zig
new file mode 100644
index 0000000..3163138
--- /dev/null
+++ b/zig/src/families/minimax_m3/kv8_test.zig
@@ -0,0 +1,125 @@
+//! The fp8 KV cache's family side on the shipped model's numbers (docs/fp8-kv.md): pages, map, budget, fingerprint.
+const std = @import("std");
+const kv = @import("core").kv_pool;
+const config = @import("config.zig");
+const shard = @import("shard.zig");
+const pool = @import("pool.zig");
+const budget = @import("budget.zig");
+const ranks = @import("ranks.zig");
+
+const expectEqual = std.testing.expectEqual;
+const expect = std.testing.expect;
+const GiB = budget.GiB;
+
+fn dims(rank: usize, kv8: bool) !pool.Dims {
+    const c = config.flash;
+    return (try pool.Dims.of(&c, try shard.Share.of(&c, rank, 2))).withKv8(kv8);
+}
+
+test "a rank caches 47,040 bytes a token with fp8 K/V and a page is 6,021,120; bf16 stays 76,800 and 9,830,400" {
+    for ([_]usize{ 0, 1 }) |r| {
+        const d = try dims(r, true);
+        try expectEqual(@as(u64, 784), d.layerToken()); // K 256 + V 256 + IK 256 + 4 scales of 4 bytes
+        try expectEqual(@as(u64, 47_040), d.tokenBytes());
+        try expectEqual(@as(u64, 6_021_120), d.pageBytes());
+        const l = d.layout(1024);
+        try expectEqual(@as(u64, 47_040), l.token_bytes);
+        try expectEqual(@as(u64, 4096), l.fixed_bytes); // the block-table row is the same
+        const b = try dims(r, false);
+        try expectEqual(@as(u64, 76_800), b.tokenBytes());
+        try expectEqual(@as(u64, 9_830_400), b.pageBytes());
+    }
+    // one rank alone caches all four kv heads
+    const c = config.flash;
+    const whole = (try pool.Dims.of(&c, try shard.Share.of(&c, 0, 1))).withKv8(true);
+    try expectEqual(@as(u64, 60 * (2 * 4 * (128 + 4) + 256)), whole.tokenBytes());
+}
+
+test "the fp8 page map tiles the page: K and V codes, IK, then the scales of every layer, no gap and no overlap" {
+    const d = try dims(0, true);
+    const m = d.map();
+    const page: usize = @intCast(d.pageBytes());
+    const seen = try std.testing.allocator.alloc(u8, page);
+    defer std.testing.allocator.free(seen);
+    @memset(seen, 0);
+    const head = @as(u64, pool.page_tokens) * d.head_dim; // one byte a value
+    const mark = struct {
+        fn at(s: []u8, off: u64, len: u64) void {
+            for (s[@intCast(off)..][0..@intCast(len)]) |*x| {
+                std.debug.assert(x.* == 0);
+                x.* = 1;
+            }
+        }
+    }.at;
+    for (0..d.layers) |layer| {
+        for (0..d.kv_heads) |h| {
+            mark(seen, m.k(@intCast(layer), @intCast(h)), head);
+            mark(seen, m.v(@intCast(layer), @intCast(h)), head);
+            mark(seen, m.kScale(@intCast(layer), @intCast(h)), pool.page_tokens * pool.scale_bytes);
+            mark(seen, m.vScale(@intCast(layer), @intCast(h)), pool.page_tokens * pool.scale_bytes);
+        }
+        mark(seen, m.ik(@intCast(layer)), @as(u64, pool.page_tokens) * d.index_dim * 2);
+    }
+    for (seen) |s| try expectEqual(@as(u8, 1), s);
+    // the order inside a layer: K heads, V heads, IK, K scales, V scales (the kernels' kv8_byte, ik_byte, scale8_byte)
+    try expectEqual(@as(u64, 0), m.k(0, 0));
+    try expectEqual(@as(u64, 2 * 16384), m.v(0, 0));
+    try expectEqual(@as(u64, 2 * 2 * 16384), m.ik(0));
+    try expectEqual(m.ik(0) + 32768, m.kScale(0, 0));
+    try expectEqual(m.k(1, 0), m.vScale(0, 1) + 512); // the next layer starts right after the last scale
+}
+
+test "the same memory holds 1.63 times the pages: the real rank budgets, 7.18 and 7.02 GiB of KV room" {
+    const bf = try dims(0, false);
+    const f8 = try dims(0, true);
+    const Row = struct { room_gib: f64, bf16_pages: usize, fp8_pages: usize };
+    const want = [_]Row{ .{ .room_gib = 7.18, .bf16_pages = 784, .fp8_pages = 1280 }, .{ .room_gib = 7.02, .bf16_pages = 766, .fp8_pages = 1251 } };
+    for (want) |w| {
+        const room: u64 = @intFromFloat(w.room_gib * @as(f64, @floatFromInt(GiB)));
+        // a layout without a stream table or cache, the pages that remain: room / page
+        const lb: kv.Layout = .{ .fixed_bytes = 0, .token_bytes = bf.tokenBytes(), .page_tokens = pool.page_tokens, .snap_bytes = pool.snap_bytes, .all_paged = true };
+        const lf: kv.Layout = .{ .fixed_bytes = 0, .token_bytes = f8.tokenBytes(), .page_tokens = pool.page_tokens, .snap_bytes = pool.snap_bytes, .all_paged = true };
+        const pb = try kv.plan(lb, .{ .room = room, .engine = 0, .lanes = 1 });
+        const pf = try kv.plan(lf, .{ .room = room, .engine = 0, .lanes = 1 });
+        try expectEqual(w.bf16_pages, pb.pages);
+        try expectEqual(w.fp8_pages, pf.pages);
+        std.debug.print("kv8 room {d:.2} GiB: bf16 {d} pages ({d} tokens), fp8 {d} pages ({d} tokens)\n", .{ w.room_gib, pb.pages, pb.pages * 128, pf.pages, pf.pages * 128 });
+    }
+    // the 784 pages the first rank was served are exactly 1280 fp8 pages of memory
+    try expectEqual(@as(u64, 784) * bf.pageBytes(), @as(u64, 1280) * f8.pageBytes());
+}
+
+test "the budget check admits a longer context with fp8 K/V in the same room, and names fp8 bytes in a refusal" {
+    const w = @import("pool_test.zig").weights_rank0;
+    const bf = try dims(0, false);
+    const f8 = try dims(0, true);
+    const in: budget.Input = .{ .available = 119 * GiB, .weights = w, .terms = try budget.tensorfold(119 * GiB, null), .lanes = 1, .window = pool.page_tokens, .max_positions = 1 << 20 };
+    const v16 = budget.check(bf, in, null).ok;
+    const v8 = budget.check(f8, in, null).ok;
+    try expect(v8.context > v16.context);
+    try expect(v8.pool_bytes <= v8.room and v16.pool_bytes <= v16.room);
+    try expect(@as(f64, @floatFromInt(v8.context)) > 1.6 * @as(f64, @floatFromInt(v16.context)) and @as(f64, @floatFromInt(v8.context)) < 1.7 * @as(f64, @floatFromInt(v16.context)));
+    std.debug.print("kv8 119 GiB host, TensorFold reserve: largest context bf16 {d}, fp8 {d}\n", .{ v16.context, v8.context });
+    // a context bf16 cannot hold fits with fp8; the refusal of a bigger one quotes 47,040 bytes a token
+    const over = budget.check(bf, in, v8.context);
+    try expect(over == .refused);
+    try expect(budget.check(f8, in, v8.context) == .ok);
+    const huge = budget.check(f8, in, 1 << 20);
+    try expect(huge == .refused);
+    try expectEqual(@as(u64, 47_040), huge.refused.token_bytes);
+}
+
+test "the ranks' fingerprint carries kv8: one rank on fp8 pages and the other on bf16 refuse each other" {
+    try expectEqual(false, (ranks.Settings{}).kv8);
+    const h = ranks.hashBytes("program");
+    const a = ranks.Fingerprint.of(.{ .rank = 0, .world = 2 }, .{ .kv8 = true }, 131072, ranks.hashBytes("c"), ranks.hashBytes("q"), h, ranks.hashBytes("w"));
+    var b = ranks.Fingerprint.of(.{ .rank = 1, .world = 2 }, .{ .kv8 = true }, 131072, ranks.hashBytes("c"), ranks.hashBytes("q"), h, ranks.hashBytes("w"));
+    var all = [_]ranks.Fingerprint{ a, b };
+    try expect(ranks.mismatch(&all) == null);
+    b = ranks.Fingerprint.of(.{ .rank = 1, .world = 2 }, .{}, 131072, ranks.hashBytes("c"), ranks.hashBytes("q"), h, ranks.hashBytes("w"));
+    all[1] = b;
+    const mm = ranks.mismatch(&all).?;
+    try expectEqual(ranks.Fingerprint.Field.kv8, mm.field);
+    try expectEqual(@as(usize, 1), mm.rank);
+    try expect(std.mem.indexOf(u8, ranks.explain(.kv8), "--kv-cache") != null);
+}
diff --git a/zig/src/families/minimax_m3/load.zig b/zig/src/families/minimax_m3/load.zig
new file mode 100644
index 0000000..d7459ec
--- /dev/null
+++ b/zig/src/families/minimax_m3/load.zig
@@ -0,0 +1,539 @@
+//! MiniMax-M3.1-Flash's checkpoint: header catalog, per-rank plan, direct-I/O stream; no shard is ever mapped.
+const std = @import("std");
+const builtin = @import("builtin");
+const core = @import("core");
+const st = core.safetensors;
+const dio = core.direct_io;
+const layout = core.exl3_layout;
+const Config = @import("config.zig").Config;
+const names = @import("names.zig");
+const shard = @import("shard.zig");
+
+comptime {
+    if (builtin.cpu.arch.endian() != .little) @compileError("tensor bytes are little-endian and are copied as they are");
+}
+
+/// The mul1 codebook marker's value: exl3_decode.cuh hard-codes this multiplier.
+pub const mul1_multiplier: u32 = 0x83DCD12D;
+
+/// Half-bit widths (2 * bits) the CUDA kernels were built and tested for: 3, 4, 5 and 6 bits.
+pub const allowed_halves = [_]u32{ 6, 8, 10, 12 };
+/// The head alone may also be 7 or 8 bits (the 3.06 bpw pack stores it at 8); the dense kernels run those widths.
+pub const head_halves = [_]u32{ 6, 8, 10, 12, 14, 16 };
+
+/// One stored tensor: where its bytes sit in which shard (absolute file offset) and what its header said.
+pub const Ref = struct {
+    shard: u16,
+    dtype: st.DType,
+    rank: u8,
+    shape: [st.max_rank]usize,
+    begin: u64,
+    len: u64,
+    used: bool = false,
+
+    pub fn is(r: Ref, dtype: st.DType, shape: []const usize) bool {
+        return r.dtype == dtype and r.rank == shape.len and std.mem.eql(usize, r.shape[0..r.rank], shape);
+    }
+
+    pub fn numel(r: Ref) usize {
+        var n: usize = 1;
+        for (r.shape[0..r.rank]) |d| n *= d;
+        return n;
+    }
+};
+
+/// Every tensor of a model folder by name, from the shard headers alone.
+pub const Catalog = struct {
+    gpa: std.mem.Allocator,
+    arena: std.heap.ArenaAllocator,
+    map: std.StringHashMapUnmanaged(Ref) = .empty,
+    files: std.ArrayList(dio.File) = .empty,
+
+    pub fn init(gpa: std.mem.Allocator) Catalog {
+        return .{ .gpa = gpa, .arena = .init(gpa) };
+    }
+
+    pub fn deinit(c: *Catalog) void {
+        for (c.files.items) |*f| f.close();
+        c.files.deinit(c.gpa);
+        c.map.deinit(c.gpa);
+        c.arena.deinit();
+        c.* = undefined;
+    }
+
+    /// Adds one tensor; a name seen twice (in one shard or two) is refused.
+    pub fn add(c: *Catalog, name: []const u8, ref: Ref) !void {
+        const got = try c.map.getOrPut(c.gpa, name);
+        if (got.found_existing) {
+            std.log.warn("tensor {s} is stored twice", .{name});
+            return error.DuplicateTensor;
+        }
+        errdefer _ = c.map.remove(name);
+        got.key_ptr.* = try c.arena.allocator().dupe(u8, name);
+        got.value_ptr.* = ref;
+    }
+
+    /// The model folder's shards (the index's, else every model*.safetensors), their headers read with direct I/O.
+    pub fn open(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !Catalog {
+        const paths = try core.checkpoint.shardFiles(gpa, io, dir);
+        defer core.checkpoint.freeShardFiles(gpa, paths);
+        var c = Catalog.init(gpa);
+        errdefer c.deinit();
+        const a = c.arena.allocator();
+        var base_names: std.ArrayList([]const u8) = .empty;
+        defer base_names.deinit(gpa);
+        for (paths, 0..) |path, i| {
+            if (i >= std.math.maxInt(u16)) return error.TooManyShards;
+            var plain = try std.Io.Dir.cwd().openFile(io, path, .{});
+            const size = plain.length(io) catch |e| {
+                plain.close(io);
+                return e;
+            };
+            plain.close(io);
+            var f = try dio.File.open(path);
+            try c.files.append(gpa, f);
+            try base_names.append(gpa, std.fs.path.basename(path));
+            const json = try readHeader(gpa, &f, size);
+            defer gpa.free(json.mem);
+            try uniqueKeys(gpa, json.text);
+            const data = 8 + json.text.len;
+            const header = try st.parseHeader(a, json.text, size - data);
+            for (header.keys(), header.values()) |name, e| try c.add(name, .{
+                .shard = @intCast(i),
+                .dtype = e.dtype,
+                .rank = e.rank,
+                .shape = e.shape,
+                .begin = data + e.begin,
+                .len = e.end - e.begin,
+            });
+        }
+        try c.crossCheckIndex(io, dir, base_names.items);
+        return c;
+    }
+
+    /// With an index.json present, its weight map and the headers must name the same tensors in the same shards.
+    fn crossCheckIndex(c: *Catalog, io: std.Io, dir: []const u8, shard_names: []const []const u8) !void {
+        const path = try std.fs.path.join(c.gpa, &.{ dir, "model.safetensors.index.json" });
+        defer c.gpa.free(path);
+        const text = std.Io.Dir.cwd().readFileAlloc(io, path, c.gpa, .limited(st.index.max_bytes)) catch |e| switch (e) {
+            error.FileNotFound => return,
+            else => return e,
+        };
+        defer c.gpa.free(text);
+        const parsed = try std.json.parseFromSlice(std.json.Value, c.gpa, text, .{});
+        defer parsed.deinit();
+        const wm = try st.index.weightMap(parsed.value);
+        if (wm.count() != c.map.count()) return error.IndexMismatch;
+        var it = wm.iterator();
+        while (it.next()) |kv| {
+            const r = c.map.get(kv.key_ptr.*) orelse return error.IndexMismatch;
+            if (!std.mem.eql(u8, shard_names[r.shard], kv.value_ptr.string)) return error.IndexMismatch;
+        }
+    }
+
+    pub fn get(c: *Catalog, name: []const u8) ?*Ref {
+        return c.map.getPtr(name);
+    }
+};
+
+const Header = struct { mem: dio.Buffer, text: []const u8 };
+
+/// The JSON header of a shard of `size` bytes, read through `f`'s direct I/O into an aligned buffer.
+fn readHeader(gpa: std.mem.Allocator, f: *dio.File, size: u64) !Header {
+    if (size < 8) return error.BadSafetensors;
+    const first = try gpa.alignedAlloc(u8, .fromByteUnits(dio.alignment), dio.span(0, 8));
+    defer gpa.free(first);
+    const n = try st.headerSize(std.mem.readInt(u64, (try f.read(first, 0, 8))[0..8], .little), size);
+    const mem = try gpa.alignedAlloc(u8, .fromByteUnits(dio.alignment), dio.span(8, n));
+    errdefer gpa.free(mem);
+    return .{ .mem = mem, .text = try f.read(mem, 8, n) };
+}
+
+/// A name twice in one header would let the parsed map keep either: count the top-level keys as written.
+fn uniqueKeys(gpa: std.mem.Allocator, json: []const u8) !void {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var scanner = std.json.Scanner.initCompleteInput(a, json);
+    var seen: std.StringHashMapUnmanaged(void) = .empty;
+    var depth: usize = 0;
+    while (true) {
+        const tok = try scanner.nextAlloc(a, .alloc_if_needed);
+        switch (tok) {
+            .object_begin, .array_begin => depth += 1,
+            .object_end, .array_end => depth -= 1,
+            .string, .allocated_string => |s| if (depth == 1) {
+                if ((try seen.getOrPut(a, s)).found_existing) return error.DuplicateTensor;
+            },
+            .end_of_document => return,
+            else => {},
+        }
+    }
+}
+
+/// A device allocation the plan asks for; the sink decides what backs it.
+pub const Slot = struct { bytes: u64 };
+
+/// Bytes `span` of one stored tensor (absolute file offset `base`), appended at `dst` of `slot`.
+pub const Item = struct {
+    shard: u16,
+    base: u64,
+    span: layout.Span,
+    slot: u32,
+    dst: u64,
+    fold: bool = false, // bf16 norm weights stored as fp32 1 + w (the destination holds 4-byte floats)
+
+    pub fn first(i: Item) u64 {
+        return i.base + i.span.offset;
+    }
+};
+
+/// One EXL3 matrix on this rank: its width, rank-local shape and where its parts land.
+pub const Matrix = struct {
+    proj: names.Proj,
+    layer: u16,
+    expert: u16,
+    halves: u8, // 2 * bits: the kernels' K2, from the trellis' last dim
+    k: u32, // rank-local input width
+    n: u32, // rank-local output width
+    trellis: u32, // slots (for a routed expert: the layer's stacked slot) and this matrix' byte offsets in them
+    suh: u32,
+    svh: u32,
+    trellis_off: u64,
+    suh_off: u64,
+    svh_off: u64,
+    marker_shard: u16,
+    marker_at: u64,
+};
+
+/// A plain tensor on this rank (fp16 index projections and fp32 router tensors as they are).
+pub const PlainTensor = struct {
+    role: names.Plain,
+    layer: u16,
+    slot: u32,
+    dtype: st.DType, // as held in the slot: fp32 where the Gemma fold ran
+    rows: u32,
+    cols: u32, // 1 for vectors
+    folded: bool,
+};
+
+/// One routed projection of a layer on this rank: the per-expert widths and pointer offsets, as the kernels take them.
+pub const MoeProj = struct {
+    halves: []i32, // [experts], 2 * bits of each expert's trellis
+    trellis_off: []u64, // [experts], byte offset of each expert's trellis in `trellis_slot` (pointer = base + offset)
+    trellis_slot: u32,
+    suh_slot: u32, // fp16 [experts, k]
+    svh_slot: u32, // fp16 [experts, n]
+    k: u32,
+    n: u32,
+    histogram: [17]u32, // experts at each K2
+};
+
+pub const MoeLayer = struct { layer: u16, w1: MoeProj, w3: MoeProj, w2: MoeProj };
+
+pub const Options = struct {
+    /// Only these layers (a slice that fits one GPU); empty means all, and then no tensor may be left over.
+    layers: []const u16 = &.{},
+};
+
+pub const Plan = struct {
+    arena: std.heap.ArenaAllocator,
+    share: shard.Share,
+    slots: []Slot,
+    items: []Item, // in (shard, offset) order
+    matrices: []Matrix,
+    plain: []PlainTensor,
+    moe: []MoeLayer,
+    ignored: usize, // tensors of other namespaces (a vision tower) left unread
+
+    pub fn deinit(p: *Plan) void {
+        p.arena.deinit();
+        p.* = undefined;
+    }
+
+    pub fn slotBytes(p: *const Plan) u64 {
+        var n: u64 = 0;
+        for (p.slots) |s| n += s.bytes;
+        return n;
+    }
+
+    pub fn moeLayer(p: *const Plan, layer: u32) ?*const MoeLayer {
+        for (p.moe) |*m| if (m.layer == layer) return m;
+        return null;
+    }
+
+    pub fn matrix(p: *const Plan, proj: names.Proj, layer: u32, expert: u32) ?*const Matrix {
+        for (p.matrices) |*m| if (m.proj == proj and m.layer == layer and m.expert == expert) return m;
+        return null;
+    }
+
+    pub fn build(gpa: std.mem.Allocator, cat: *Catalog, c: *const Config, share: shard.Share, opts: Options) !Plan {
+        var b: Builder = .{ .cat = cat, .c = c, .share = share, .a = undefined, .gemma = c.gemma_norm };
+        var arena = std.heap.ArenaAllocator.init(gpa);
+        errdefer arena.deinit();
+        b.a = arena.allocator();
+        var used = cat.map.valueIterator();
+        while (used.next()) |r| r.used = false;
+        try b.all(opts);
+        std.mem.sort(Item, b.items.items, {}, struct {
+            fn less(_: void, x: Item, y: Item) bool {
+                return if (x.shard != y.shard) x.shard < y.shard else x.first() < y.first();
+            }
+        }.less);
+        return .{
+            .arena = arena,
+            .share = share,
+            .slots = b.slots.items,
+            .items = b.items.items,
+            .matrices = b.matrices.items,
+            .plain = b.plain.items,
+            .moe = b.moe.items,
+            .ignored = try b.leftovers(opts),
+        };
+    }
+};
+
+const Builder = struct {
+    cat: *Catalog,
+    c: *const Config,
+    share: shard.Share,
+    a: std.mem.Allocator,
+    gemma: bool,
+    slots: std.ArrayList(Slot) = .empty,
+    items: std.ArrayList(Item) = .empty,
+    matrices: std.ArrayList(Matrix) = .empty,
+    plain: std.ArrayList(PlainTensor) = .empty,
+    moe: std.ArrayList(MoeLayer) = .empty,
+
+    fn slot(b: *Builder, bytes: u64) !u32 {
+        try b.slots.append(b.a, .{ .bytes = bytes });
+        return @intCast(b.slots.items.len - 1);
+    }
+
+    fn find(b: *Builder, name: []const u8) !*Ref {
+        const r = b.cat.get(name) orelse {
+            std.log.warn("checkpoint has no tensor {s}", .{name});
+            return error.MissingTensor;
+        };
+        r.used = true;
+        return r;
+    }
+
+    fn all(b: *Builder, opts: Options) !void {
+        const c = b.c;
+        try b.plainTensor(.embed, 0, &.{ c.vocab, c.hidden }, &.{.bf16}, null);
+        if (opts.layers.len == 0) {
+            for (0..c.layers) |l| try b.layer(@intCast(l));
+        } else for (opts.layers) |l| {
+            if (l >= c.layers) return error.BadLayer;
+            try b.layer(l);
+        }
+        try b.plainTensor(.final_norm, 0, &.{c.hidden}, &.{.bf16}, null);
+        try b.denseGroup(.head, 0, c.hidden, c.vocab);
+    }
+
+    fn layer(b: *Builder, l: u16) !void {
+        const c = b.c;
+        const q = c.heads * c.head_dim;
+        const kv = c.kv_heads * c.head_dim;
+        const ix = c.index;
+        try b.plainTensor(.input_ln, l, &.{c.hidden}, &.{.bf16}, null);
+        try b.plainTensor(.post_ln, l, &.{c.hidden}, &.{.bf16}, null);
+        try b.plainTensor(.q_norm, l, &.{c.head_dim}, &.{.bf16}, null);
+        try b.plainTensor(.k_norm, l, &.{c.head_dim}, &.{.bf16}, null);
+        try b.plainTensor(.index_q_proj, l, &.{ ix.heads * ix.dim, c.hidden }, &.{.f16}, b.share.indexRows(c));
+        try b.plainTensor(.index_k_proj, l, &.{ ix.dim, c.hidden }, &.{.f16}, null);
+        try b.plainTensor(.index_q_norm, l, &.{ix.dim}, &.{.bf16}, null);
+        try b.plainTensor(.index_k_norm, l, &.{ix.dim}, &.{.bf16}, null);
+        try b.denseGroup(.q, l, c.hidden, q);
+        try b.denseGroup(.k, l, c.hidden, kv);
+        try b.denseGroup(.v, l, c.hidden, kv);
+        try b.denseGroup(.o, l, q, c.hidden);
+        if (!c.isMoe(l)) {
+            try b.denseGroup(.dense_gate, l, c.hidden, c.dense_inter);
+            try b.denseGroup(.dense_up, l, c.hidden, c.dense_inter);
+            return b.denseGroup(.dense_down, l, c.dense_inter, c.hidden);
+        }
+        try b.plainTensor(.router, l, &.{ c.experts, c.hidden }, &.{.f32}, null);
+        try b.plainTensor(.router_bias, l, &.{c.experts}, &.{ .f32, .bf16 }, null);
+        try b.denseGroup(.shared_gate, l, c.hidden, c.shared_inter);
+        try b.denseGroup(.shared_up, l, c.hidden, c.shared_inter);
+        try b.denseGroup(.shared_down, l, c.shared_inter, c.hidden);
+        const w1 = try b.experts(.w1, l, c.hidden, c.moe_inter);
+        const w3 = try b.experts(.w3, l, c.hidden, c.moe_inter);
+        const w2 = try b.experts(.w2, l, c.moe_inter, c.hidden);
+        try b.moe.append(b.a, .{ .layer = l, .w1 = w1, .w3 = w3, .w2 = w2 });
+    }
+
+    fn plainTensor(b: *Builder, role: names.Plain, l: u16, shape: []const usize, dtypes: []const st.DType, rows: ?shard.Span) !void {
+        var buf: names.Buf = undefined;
+        const name = names.plain(&buf, role, l);
+        const r = try b.find(name);
+        var ok = false;
+        for (dtypes) |d| ok = ok or r.is(d, shape);
+        if (!ok) {
+            std.log.warn("{s}: {t} {any} is not the expected {any}", .{ name, r.dtype, r.shape[0..r.rank], shape });
+            return error.MisshapedTensor;
+        }
+        const cols: usize = if (shape.len > 1) shape[1] else 1;
+        const row_bytes = cols * r.dtype.size();
+        var offset: u64 = 0;
+        var len: u64 = r.len;
+        var n_rows: usize = shape[0];
+        if (rows) |s| {
+            offset = s.lo * row_bytes;
+            len = s.len() * row_bytes;
+            n_rows = s.len();
+        }
+        const fold = b.gemma and role.isNorm();
+        const held: st.DType = if (fold) .f32 else r.dtype;
+        const slot_id = try b.slot(len / r.dtype.size() * held.size());
+        try b.items.append(b.a, .{ .shard = r.shard, .base = r.begin, .span = .{ .offset = offset, .len = len }, .slot = slot_id, .dst = 0, .fold = fold });
+        try b.plain.append(b.a, .{ .role = role, .layer = l, .slot = slot_id, .dtype = held, .rows = @intCast(n_rows), .cols = @intCast(cols), .folded = fold });
+    }
+
+    const Admitted = struct { group: layout.Group, halves: u8, trellis: *Ref, suh: *Ref, svh: *Ref, marker: *Ref };
+
+    /// One group's four tensors: dtypes, shapes against the expected K x N, 128 alignment and an allowed width.
+    fn admit(b: *Builder, prefix: []const u8, proj: names.Proj, k: usize, n: usize) !Admitted {
+        var nb: [4]names.Buf = undefined;
+        const trellis = try b.find(names.part(&nb[0], prefix, .trellis));
+        const suh = try b.find(names.part(&nb[1], prefix, .suh));
+        const svh = try b.find(names.part(&nb[2], prefix, .svh));
+        const marker = try b.find(names.part(&nb[3], prefix, .mul1));
+        const bad = struct {
+            fn at(why: anyerror, p: []const u8, comptime fmt: []const u8, args: anytype) anyerror {
+                std.log.warn("{s}: " ++ fmt, .{p} ++ args);
+                return why;
+            }
+        }.at;
+        if (trellis.dtype != .i16 or trellis.rank != 3) return bad(error.BadTrellis, prefix, "trellis is {t} rank {d}, not int16 rank 3", .{ trellis.dtype, trellis.rank });
+        const words = trellis.shape[2];
+        if (words % 8 != 0 or words < 16 or words > 128) return bad(error.BadTrellis, prefix, "trellis last dim {d} is not 16 * bits", .{words});
+        const halves: u32 = @intCast(words / 8);
+        if (std.mem.indexOfScalar(u32, if (proj == .head) &head_halves else &allowed_halves, halves) == null) return bad(error.UnsupportedWidth, prefix, "{d} half-bits are not a width the kernels run", .{halves});
+        if (trellis.shape[0] * 16 % 128 != 0 or trellis.shape[1] * 16 % 128 != 0) return bad(error.NotAligned, prefix, "K {d} x N {d} is not 128-aligned", .{ trellis.shape[0] * 16, trellis.shape[1] * 16 });
+        if (trellis.shape[0] * 16 != k or trellis.shape[1] * 16 != n) return bad(error.MisshapedTensor, prefix, "trellis {any} is not K {d} x N {d}", .{ trellis.shape[0..3].*, k, n });
+        if (!suh.is(.f16, &.{k}) or !svh.is(.f16, &.{n})) return bad(error.MisshapedTensor, prefix, "scales are not fp16 [{d}] and [{d}]", .{ k, n });
+        if (marker.dtype != .i32 or marker.rank > 1 or marker.numel() != 1) return bad(error.MisshapedTensor, prefix, "mul1 marker is not one int32", .{});
+        if (proj == .head and halves != 2 * b.c.quant.head_bits) return bad(error.UnsupportedWidth, prefix, "head is {d} half-bits, head_bits says {d}", .{ halves, b.c.quant.head_bits });
+        return .{ .group = try layout.Group.fromShape(trellis.shape[0..3]), .halves = @intCast(halves), .trellis = trellis, .suh = suh, .svh = svh, .marker = marker };
+    }
+
+    fn denseGroup(b: *Builder, proj: names.Proj, l: u16, k: usize, n: usize) !void {
+        var buf: names.Buf = undefined;
+        const m = try b.admit(names.group(&buf, proj, l, 0), proj, k, n);
+        _ = try b.dense(m, proj, l, try b.share.part(b.c, proj, m.group));
+    }
+
+    /// A matrix with slots of its own for the rank's part of the trellis and scales.
+    fn dense(b: *Builder, m: Admitted, proj: names.Proj, l: u16, part: layout.Part) !void {
+        const t = try b.slot(part.trellis.bytes());
+        const su = try b.slot(part.suh.len);
+        const sv = try b.slot(part.svh.len);
+        try b.parts(m, part, .{ t, su, sv }, .{ 0, 0, 0 });
+        try b.matrices.append(b.a, Builder.describe(m, proj, l, part, .{ t, su, sv }, .{ 0, 0, 0 }));
+    }
+
+    fn parts(b: *Builder, m: Admitted, part: layout.Part, slot_ids: [3]u32, dst: [3]u64) !void {
+        const refs = [3]*Ref{ m.trellis, m.suh, m.svh };
+        const spans = [3]layout.Span{ part.trellis, part.suh, part.svh };
+        for (refs, spans, slot_ids, dst) |r, sp, s, d| try b.items.append(b.a, .{ .shard = r.shard, .base = r.begin, .span = sp, .slot = s, .dst = d });
+    }
+
+    fn describe(m: Admitted, proj: names.Proj, l: u32, part: layout.Part, s: [3]u32, off: [3]u64) Matrix {
+        return .{
+            .proj = proj,
+            .layer = @intCast(l),
+            .expert = 0,
+            .halves = m.halves,
+            .k = part.group.k(),
+            .n = part.group.n(),
+            .trellis = s[0],
+            .suh = s[1],
+            .svh = s[2],
+            .trellis_off = off[0],
+            .suh_off = off[1],
+            .svh_off = off[2],
+            .marker_shard = m.marker.shard,
+            .marker_at = m.marker.begin,
+        };
+    }
+
+    /// One routed projection of a layer: every expert's part stacked in three slots, widths and offsets per expert.
+    fn experts(b: *Builder, proj: names.Proj, l: u16, k: usize, n: usize) !MoeProj {
+        const e_n = b.c.experts;
+        const found = try b.a.alloc(Admitted, e_n);
+        const cuts = try b.a.alloc(layout.Part, e_n);
+        const halves = try b.a.alloc(i32, e_n);
+        var buf: names.Buf = undefined;
+        for (found, cuts, halves, 0..) |*f, *cut, *h, e| {
+            f.* = try b.admit(names.group(&buf, proj, l, @intCast(e)), proj, k, n);
+            cut.* = try b.share.part(b.c, proj, f.group);
+            h.* = f.halves;
+        }
+        var lay = try layout.Layout.of(b.a, cuts);
+        defer lay.deinit(b.a);
+        const suh_len = cuts[0].suh.len;
+        const svh_len = cuts[0].svh.len;
+        const t = try b.slot(lay.trellisBytes());
+        const su = try b.slot(suh_len * e_n);
+        const sv = try b.slot(svh_len * e_n);
+        const offs = try b.a.alloc(u64, e_n);
+        for (found, cuts, offs, 0..) |f, cut, *o, e| {
+            o.* = lay.byteOffset(e);
+            const dst = [3]u64{ o.*, e * suh_len, e * svh_len };
+            try b.parts(f, cut, .{ t, su, sv }, dst);
+            var mx = Builder.describe(f, proj, l, cut, .{ t, su, sv }, dst);
+            mx.expert = @intCast(e);
+            try b.matrices.append(b.a, mx);
+        }
+        return .{ .halves = halves, .trellis_off = offs, .trellis_slot = t, .suh_slot = su, .svh_slot = sv, .k = cuts[0].group.k(), .n = cuts[0].group.n(), .histogram = lay.histogram() };
+    }
+
+    /// Tensors no planned name took: a text-model name left over is a pack this plan does not understand.
+    fn leftovers(b: *Builder, opts: Options) !usize {
+        var ignored: usize = 0;
+        var it = b.cat.map.iterator();
+        while (it.next()) |kv| {
+            if (kv.value_ptr.used) continue;
+            if (opts.layers.len == 0 and std.mem.startsWith(u8, kv.key_ptr.*, names.text_namespace)) {
+                std.log.warn("unexpected tensor {s}", .{kv.key_ptr.*});
+                return error.UnexpectedTensor;
+            }
+            ignored += 1;
+        }
+        return ignored;
+    }
+};
+
+/// Where the streamed bytes go: a device allocation per slot, written at byte offsets.
+pub const Sink = struct {
+    ctx: *anyopaque,
+    put: *const fn (ctx: *anyopaque, slot: u32, offset: u64, bytes: []const u8) anyerror!void,
+};
+
+pub const ShardEnd = @import("stream.zig").ShardEnd;
+pub const Streamer = @import("stream.zig").Streamer;
+pub const StreamOptions = @import("stream.zig").Options;
+pub const StreamStats = @import("stream.zig").Stats;
+
+/// bf16 norm weights as fp32 `1 + w` (Gemma RMSNorm), summed once in fp32; the caller's `out` holds the result.
+pub fn foldGemma(out: []f32, bf16: []const u8) []f32 {
+    const n = bf16.len / 2;
+    for (out[0..n], 0..) |*o, i| {
+        const w: f32 = @bitCast(@as(u32, std.mem.readInt(u16, bf16[2 * i ..][0..2], .little)) << 16);
+        o.* = 1.0 + w;
+    }
+    return out[0..n];
+}
