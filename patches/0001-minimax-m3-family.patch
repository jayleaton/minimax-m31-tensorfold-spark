index 0000000..9649426
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_dspark.cu
@@ -0,0 +1,579 @@
+// MiniMax-M3.1-Flash dspark draft kernels: taps, residual add, Gemma norm, per-head norm + RoPE (block rows and the
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+#include <math.h>
+#include <stdint.h>
+
+namespace {
+
+typedef __nv_bfloat16 bf16;
+
+constexpr int D = 128;           // head_dim
+constexpr int WARPS = 8;
+constexpr int THREADS = WARPS * 32;
+constexpr int MAX_PAIRS = 64;    // rotary pairs (rot <= 128)
+constexpr int KEYS = 128;        // keys a block-attention CTA handles
+constexpr int KROW = 130;        // padded K tile row (bf16): 65 words, so lanes on consecutive keys hit distinct banks
+constexpr int PART = 132;        // floats of one partial: m, l, 2 pad, 128 acc
+constexpr int TOPC_THREADS = 256;
+constexpr int TOPC_MAX = 128;
+constexpr int CHAIN_THREADS = 256;
+constexpr int CHAIN_MAX_CAND = 256; // world * cand
+constexpr int CHAIN_MAX_ROWS = 16;
+
+__device__ __forceinline__ float lo16(uint32_t w) { return __uint_as_float(w << 16); }
+__device__ __forceinline__ float hi16(uint32_t w) { return __uint_as_float(w & 0xffff0000u); }
+__device__ __forceinline__ unsigned short bf_bits(float v) { return __bfloat16_as_ushort(__float2bfloat16_rn(v)); }
+__device__ __forceinline__ float4 widen4(uint2 w) { return make_float4(lo16(w.x), hi16(w.x), lo16(w.y), hi16(w.y)); }
+__device__ __forceinline__ uint2 pack4(float a, float b, float c, float d) {
+    return make_uint2((unsigned)bf_bits(a) | ((unsigned)bf_bits(b) << 16), (unsigned)bf_bits(c) | ((unsigned)bf_bits(d) << 16));
+}
+
+__device__ __forceinline__ float tree32(float a) {
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) a = __fadd_rn(a, __shfl_xor_sync(0xffffffffu, a, o));
+    return a;
+}
+
+// True when candidate (bv, bi) beats (av, ai): larger value wins, ties to the lower id, NaN last (a total order).
+__device__ __forceinline__ bool beats(float bv, int bi, float av, int ai) {
+    const bool an = av != av, bn = bv != bv;
+    if (an && bn) return bi < ai;
+    if (bn) return false;
+    if (an) return true;
+    return bv > av || (bv == av && bi < ai);
+}
+
+template <typename X> __device__ __forceinline__ float load1(const X* p);
+template <> __device__ __forceinline__ float load1<float>(const float* p) { return __ldg(p); }
+template <> __device__ __forceinline__ float load1<bf16>(const bf16* p) { return __bfloat162float(__ldg(p)); }
+
+} // namespace
+
+// ---- taps
+
+// dst[r * dst_ld + slot * hidden + i] = bf16(src[r * hidden + i]); a CTA a row.
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_ds_tap(const float* __restrict__ src, unsigned short* __restrict__ dst,
+                                                                   long long dst_ld, int slot, int hidden, int rows) {
+    const int r = blockIdx.x;
+    if (r >= rows) return;
+    const float* s = src + (long long)r * hidden;
+    unsigned short* d = dst + (long long)r * dst_ld + (long long)slot * hidden;
+    for (int i = threadIdx.x; i < hidden; i += THREADS) d[i] = bf_bits(__ldg(s + i));
+}
+
+// ---- residual add
+
+template <typename B>
+__device__ __forceinline__ void add_body(const float* a, const B* b, float* dst, long long n) {
+    const long long step = (long long)gridDim.x * blockDim.x;
+    for (long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x; i < n; i += step) {
+        const float x = a == nullptr ? 0.f : a[i];
+        dst[i] = __fadd_rn(x, load1<B>(b + i));
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_ds_add_bf16(const float* a, const bf16* __restrict__ b,
+                                                                        float* dst, long long n) {
+    add_body<bf16>(a, b, dst, n);
+}
+
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_ds_add_f32(const float* a, const float* __restrict__ b,
+                                                                       float* dst, long long n) {
+    add_body<float>(a, b, dst, n);
+}
+
+// ---- RMS norm
+
+// y = x * (1 / sqrt(mean(x^2) + eps)) * (w + 1 | w).
+template <typename X>
+__device__ __forceinline__ void norm_body(const X* __restrict__ x, const unsigned short* __restrict__ w, unsigned short* __restrict__ y,
+                                          int rows, int hidden, float eps, int gemma) {
+    __shared__ float part[WARPS];
+    const int r = blockIdx.x;
+    if (r >= rows) return;
+    const X* xr = x + (long long)r * hidden;
+    float ss = 0.f;
+    for (int i = threadIdx.x; i < hidden; i += THREADS) {
+        const float v = load1<X>(xr + i);
+        ss = __fadd_rn(ss, __fmul_rn(v, v));
+    }
+    ss = tree32(ss);
+    if ((threadIdx.x & 31) == 0) part[threadIdx.x >> 5] = ss;
+    __syncthreads();
+    float tot = part[0];
+    for (int i = 1; i < WARPS; ++i) tot = __fadd_rn(tot, part[i]);
+    const float inv = __fdiv_rn(1.f, __fsqrt_rn(__fadd_rn(__fdiv_rn(tot, (float)hidden), eps)));
+    const float add = gemma ? 1.f : 0.f;
+    unsigned short* yr = y + (long long)r * hidden;
+    for (int i = threadIdx.x; i < hidden; i += THREADS) {
+        const float wv = __uint_as_float((unsigned)__ldg(w + i) << 16);
+        yr[i] = bf_bits(__fmul_rn(__fmul_rn(load1<X>(xr + i), inv), __fadd_rn(wv, add)));
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_ds_norm_bf16(const bf16* __restrict__ x,
+                                                                         const unsigned short* __restrict__ w,
+                                                                         unsigned short* __restrict__ y, int rows, int hidden,
+                                                                         float eps, int gemma) {
+    norm_body<bf16>(x, w, y, rows, hidden, eps, gemma);
+}
+
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_ds_norm_f32(const float* __restrict__ x,
+                                                                        const unsigned short* __restrict__ w,
+                                                                        unsigned short* __restrict__ y, int rows, int hidden,
+                                                                        float eps, int gemma) {
+    norm_body<float>(x, w, y, rows, hidden, eps, gemma);
+}
+
+// ---- per-head norm + RoPE
+
+// Output dim d of the rotated head (neox_half): stage holds the normed head, cs the pair table.
+__device__ __forceinline__ float rotated(const float* stage, const float (*cs)[MAX_PAIRS], int d, int rot) {
+    const int half = rot >> 1;
+    const int i = d < half ? d : d - half;
+    const float a = stage[i], b = stage[i + half], c = cs[0][i], s = cs[1][i];
+    return d < half ? __fsub_rn(__fmul_rn(a, c), __fmul_rn(b, s)) : __fadd_rn(__fmul_rn(b, c), __fmul_rn(a, s));
+}
+
+// Row r of a block (outputs at row r) or of absorbed rows (K and V into ring slot (pos0 + r) % ring_rows
+__device__ __forceinline__ void heads_body(const bf16* q, const bf16* k, const bf16* v, const unsigned short* qw,
+                                           const unsigned short* kw, bf16* qn, bf16* kn, bf16* vn, int rows, int nq, int kvh,
+                                           int rot, float eps, int gemma, double theta, int pos0, int ring_rows) {
+    const int r = blockIdx.x;
+    if (r >= rows) return;
+    __shared__ float cs[2][MAX_PAIRS];
+    __shared__ float stage[WARPS][D];
+    const int p = pos0 + r;
+    const int half = rot >> 1;
+    if (threadIdx.x < half) {
+        double sn, cn;
+        sincos((double)p * pow(theta, -2.0 * (double)threadIdx.x / (double)rot), &sn, &cn);
+        cs[0][threadIdx.x] = (float)cn;
+        cs[1][threadIdx.x] = (float)sn;
+    }
+    __syncthreads();
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const long long out_row = ring_rows > 0 ? (long long)(p % ring_rows) : (long long)r;
+    const float add = gemma ? 1.f : 0.f;
+    const int total = nq + 2 * kvh;
+    for (int s = warp; s < total; s += WARPS) {
+        int kind = 0, h = s; // 0 q, 1 k, 2 v
+        if (s >= nq) { kind = 1; h = s - nq; }
+        if (s >= nq + kvh) { kind = 2; h = s - nq - kvh; }
+        const bf16* src = kind == 0 ? q + (long long)r * nq * D + h * D : kind == 1 ? k + (long long)r * kvh * D + h * D : v + (long long)r * kvh * D + h * D;
+        bf16* dst = kind == 0 ? qn + (long long)out_row * nq * D + h * D : kind == 1 ? kn + out_row * kvh * D + h * D : vn + out_row * kvh * D + h * D;
+        const uint2 raw = __ldg(reinterpret_cast<const uint2*>(src) + lane);
+        if (kind == 2) {
+            reinterpret_cast<uint2*>(dst)[lane] = raw;
+            continue;
+        }
+        float4 x = widen4(raw);
+        float ss = __fmul_rn(x.x, x.x);
+        ss = __fadd_rn(ss, __fmul_rn(x.y, x.y));
+        ss = __fadd_rn(ss, __fmul_rn(x.z, x.z));
+        ss = __fadd_rn(ss, __fmul_rn(x.w, x.w));
+        ss = tree32(ss);
+        const float inv = __fdiv_rn(1.f, __fsqrt_rn(__fadd_rn(__fdiv_rn(ss, 128.f), eps)));
+        const float4 wv = widen4(__ldg(reinterpret_cast<const uint2*>(kind == 0 ? qw : kw) + lane));
+        x.x = __fmul_rn(__fmul_rn(x.x, inv), __fadd_rn(wv.x, add));
+        x.y = __fmul_rn(__fmul_rn(x.y, inv), __fadd_rn(wv.y, add));
+        x.z = __fmul_rn(__fmul_rn(x.z, inv), __fadd_rn(wv.z, add));
+        x.w = __fmul_rn(__fmul_rn(x.w, inv), __fadd_rn(wv.w, add));
+        float* st = stage[warp];
+        st[4 * lane] = x.x;
+        st[4 * lane + 1] = x.y;
+        st[4 * lane + 2] = x.z;
+        st[4 * lane + 3] = x.w;
+        __syncwarp();
+        float o[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int d = 4 * lane + i;
+            o[i] = d < rot ? rotated(st, cs, d, rot) : st[d];
+        }
+        __syncwarp();
+        reinterpret_cast<uint2*>(dst)[lane] = pack4(o[0], o[1], o[2], o[3]);
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_ds_block_heads(
+    const bf16* __restrict__ q, const bf16* __restrict__ k, const bf16* __restrict__ v, const unsigned short* __restrict__ qw,
+    const unsigned short* __restrict__ kw, bf16* __restrict__ qn, bf16* __restrict__ kn, bf16* __restrict__ vn, int rows, int nq,
+    int kvh, int rot, float eps, int gemma, double theta, int pos0) {
+    heads_body(q, k, v, qw, kw, qn, kn, vn, rows, nq, kvh, rot, eps, gemma, theta, pos0, 0);
+}
+
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_ds_ring_put(
+    const bf16* __restrict__ k, const bf16* __restrict__ v, const unsigned short* __restrict__ kw, bf16* __restrict__ ring_k,
+    bf16* __restrict__ ring_v, int rows, int kvh, int rot, float eps, int gemma, double theta, int pos0, int ring_rows) {
+    heads_body(nullptr, k, v, nullptr, kw, nullptr, ring_k, ring_v, rows, 0, kvh, rot, eps, gemma, theta, pos0, ring_rows);
+}
+
+// ---- block attention
+
+// Flash-decoding split. A CTA is (kv head g, key chunk c): chunk c < chunks - 1 is context keys c0 + 128 c ..., the
+extern "C" __global__ void __launch_bounds__(THREADS) tf_mm3_ds_attn(
+    const bf16* __restrict__ qn, const bf16* __restrict__ ring_k, const bf16* __restrict__ ring_v, const bf16* __restrict__ kn,
+    const bf16* __restrict__ vn, float* __restrict__ part, int nq, int kvh, int ring_rows, int window, float scale, int rows, int p,
+    int lo, int c0, int chunks) {
+    extern __shared__ __align__(16) unsigned char smem[];
+    unsigned short* Ks = reinterpret_cast<unsigned short*>(smem);                       // [KEYS][KROW]
+    unsigned short* Vs = Ks + KEYS * KROW;                                              // [KEYS][D]
+    float* sq = reinterpret_cast<float*>(Vs + KEYS * D);                                // [WARPS][D]
+    float* sp = sq + WARPS * D;                                                         // [WARPS][KEYS]
+    const int g = blockIdx.x, c = blockIdx.y;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const bool block_chunk = c == chunks - 1;
+    const int rep = nq / kvh;
+    const int Q = rep * rows;
+    int kp0 = 0, nk = rows;
+    if (!block_chunk) {
+        kp0 = c0 + KEYS * c;
+        nk = min(KEYS, p - kp0);
+    }
+    // tiles: key j of the chunk is ring slot (kp0 + j) % ring_rows, or block row j
+    for (int idx = threadIdx.x; idx < KEYS * (D / 8); idx += THREADS) {
+        const int j = idx / (D / 8), part8 = idx % (D / 8);
+        uint4 kv4 = make_uint4(0, 0, 0, 0), vv4 = make_uint4(0, 0, 0, 0);
+        if (j < nk) {
+            long long off;
+            const bf16 *ks, *vs;
+            if (block_chunk) {
+                off = (long long)j * kvh * D + g * D + part8 * 8;
+                ks = kn;
+                vs = vn;
+            } else {
+                off = (long long)((kp0 + j) % ring_rows) * kvh * D + g * D + part8 * 8;
+                ks = ring_k;
+                vs = ring_v;
+            }
+            kv4 = __ldg(reinterpret_cast<const uint4*>(ks + off));
+            vv4 = __ldg(reinterpret_cast<const uint4*>(vs + off));
+        }
+        unsigned* kd = reinterpret_cast<unsigned*>(Ks + j * KROW + part8 * 8);
+        kd[0] = kv4.x;
+        kd[1] = kv4.y;
+        kd[2] = kv4.z;
+        kd[3] = kv4.w;
+        *reinterpret_cast<uint4*>(Vs + j * D + part8 * 8) = vv4;
+    }
+    __syncthreads();
+    float* qs = sq + warp * D;
+    float* ps = sp + warp * KEYS;
+    for (int ql = warp; ql < Q; ql += WARPS) {
+        const int row = ql / rep, head = g * rep + ql % rep;
+        const float4 qv = widen4(__ldg(reinterpret_cast<const uint2*>(qn + (long long)row * nq * D + head * D) + lane));
+        reinterpret_cast<float4*>(qs)[lane] = qv;
+        __syncwarp();
+        int lo_row = 0;
+        if (!block_chunk) {
+            const int w0 = p + row + 1 - window;
+            lo_row = max(lo, w0 > 0 ? w0 : 0);
+        }
+        float s[KEYS / 32];
+#pragma unroll
+        for (int i = 0; i < KEYS / 32; ++i) {
+            const int j = lane + 32 * i;
+            const bool ok = j < nk && (block_chunk || kp0 + j >= lo_row);
+            float acc = 0.f;
+            if (ok) {
+                const unsigned* kw = reinterpret_cast<const unsigned*>(Ks + j * KROW);
+#pragma unroll 8
+                for (int dp = 0; dp < D / 2; ++dp) {
+                    const unsigned w = kw[dp];
+                    acc = __fmaf_rn(qs[2 * dp], lo16(w), acc);
+                    acc = __fmaf_rn(qs[2 * dp + 1], hi16(w), acc);
+                }
+            }
+            s[i] = ok ? __fmul_rn(acc, scale) : -INFINITY;
+        }
+        float m = s[0];
+#pragma unroll
+        for (int i = 1; i < KEYS / 32; ++i) m = fmaxf(m, s[i]);
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) m = fmaxf(m, __shfl_xor_sync(0xffffffffu, m, o));
+        float l = 0.f;
+#pragma unroll
+        for (int i = 0; i < KEYS / 32; ++i) {
+            const float pj = s[i] == -INFINITY ? 0.f : expf(__fsub_rn(s[i], m));
+            ps[lane + 32 * i] = pj;
+            l = __fadd_rn(l, pj);
+        }
+        l = tree32(l);
+        __syncwarp();
+        float4 acc = make_float4(0.f, 0.f, 0.f, 0.f);
+        for (int j = 0; j < nk; ++j) {
+            const float pj = ps[j];
+            const float4 vv = widen4(*reinterpret_cast<const uint2*>(Vs + j * D + 4 * lane));
+            acc.x = __fmaf_rn(pj, vv.x, acc.x);
+            acc.y = __fmaf_rn(pj, vv.y, acc.y);
+            acc.z = __fmaf_rn(pj, vv.z, acc.z);
+            acc.w = __fmaf_rn(pj, vv.w, acc.w);
+        }
+        float* out = part + (((long long)g * chunks + c) * Q + ql) * PART;
+        if (lane == 0) {
+            out[0] = m;
+            out[1] = l;
+        }
+        reinterpret_cast<float4*>(out + 4)[lane] = acc;
+        __syncwarp();
+    }
+}
+
+// out[row][head][d] = sum_c w_c acc_c / sum_c w_c l_c with w_c = exp(m_c - max m)
+extern "C" __global__ void __launch_bounds__(D) tf_mm3_ds_attn_merge(const float* __restrict__ part, bf16* __restrict__ out, int nq,
+                                                                    int kvh, int rows, int chunks) {
+    const int rep = nq / kvh;
+    const int Q = rep * rows;
+    const int g = blockIdx.x / Q, ql = blockIdx.x % Q;
+    const int d = threadIdx.x;
+    const float* base = part + ((long long)g * chunks * Q + ql) * PART;
+    const long long stride = (long long)Q * PART;
+    float M = base[0];
+    for (int c = 1; c < chunks; ++c) M = fmaxf(M, base[c * stride]);
+    float num = 0.f, den = 0.f;
+    for (int c = 0; c < chunks; ++c) {
+        const float mc = base[c * stride];
+        const float w = mc == -INFINITY ? 0.f : expf(__fsub_rn(mc, M));
+        den = __fadd_rn(den, __fmul_rn(w, base[c * stride + 1]));
+        num = __fadd_rn(num, __fmul_rn(w, base[c * stride + 4 + d]));
+    }
+    const int row = ql / rep, head = g * rep + ql % rep;
+    out[(long long)row * nq * D + head * D + d] = __float2bfloat16_rn(__fdiv_rn(num, den));
+}
+
+// ---- top-C candidates
+
+namespace {
+
+// An order key: bigger is better; -0 equals +0; every NaN is the smallest key (0).
+__device__ __forceinline__ unsigned order_key(float v) {
+    if (v != v) return 0u;
+    unsigned u = __float_as_uint(v);
+    if (u == 0x80000000u) u = 0u;
+    return (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+}
+
+} // namespace
+
+// logits [rows][ld] f32 (first n valid); out [rows][c] pairs {f32 logit, i32 id}: the c best by (key desc, id asc), id
+extern "C" __global__ void __launch_bounds__(TOPC_THREADS) tf_mm3_ds_topc(const float* __restrict__ logits, long long ld, int n,
+                                                                         int id0, int c, unsigned* __restrict__ out) {
+    __shared__ unsigned hist[256];
+    __shared__ unsigned s_prefix, s_rem;
+    __shared__ unsigned gt_off[TOPC_THREADS + 1], eq_off[TOPC_THREADS + 1];
+    __shared__ unsigned long long cand[TOPC_MAX]; // (key << 32) | (0xffffffff - index): sorts descending
+    __shared__ unsigned s_need_eq;
+    const float* row = logits + (long long)blockIdx.x * ld;
+    unsigned* o = out + (long long)blockIdx.x * c * 2;
+    const int t = threadIdx.x;
+    const int want = min(c, n);
+    if (want > 0) {
+        if (t == 0) {
+            s_prefix = 0;
+            s_rem = (unsigned)want;
+        }
+        __syncthreads();
+        for (int pass = 0; pass < 4; ++pass) {
+            const int shift = 24 - 8 * pass;
+            hist[t] = 0;
+            __syncthreads();
+            const unsigned prefix = s_prefix;
+            const unsigned mask = pass == 0 ? 0u : (0xffffffffu << (32 - 8 * pass));
+            for (int i = t; i < n; i += TOPC_THREADS) {
+                const unsigned k = order_key(__ldg(row + i));
+                if ((k & mask) == prefix) atomicAdd(&hist[(k >> shift) & 255], 1u);
+            }
+            __syncthreads();
+            if (t == 0) {
+                unsigned rem = s_rem, acc = 0;
+                int b = 255;
+                for (; b > 0; --b) {
+                    if (acc + hist[b] >= rem) break;
+                    acc += hist[b];
+                }
+                s_prefix = prefix | ((unsigned)b << shift);
+                s_rem = rem - acc;
+            }
+            __syncthreads();
+        }
+        const unsigned T = s_prefix;
+        // slices
+        const int per = (n + TOPC_THREADS - 1) / TOPC_THREADS;
+        const int a = min(n, t * per), z = min(n, a + per);
+        unsigned ng = 0, ne = 0;
+        for (int i = a; i < z; ++i) {
+            const unsigned k = order_key(__ldg(row + i));
+            ng += k > T;
+            ne += k == T;
+        }
+        gt_off[t] = ng;
+        eq_off[t] = ne;
+        __syncthreads();
+        if (t == 0) {
+            unsigned sg = 0, se = 0;
+            for (int i = 0; i < TOPC_THREADS; ++i) {
+                const unsigned x = gt_off[i], y = eq_off[i];
+                gt_off[i] = sg;
+                eq_off[i] = se;
+                sg += x;
+                se += y;
+            }
+            s_need_eq = (unsigned)want - sg; // sg < want by the choice of T
+        }
+        __syncthreads();
+        unsigned pg = gt_off[t], pe = eq_off[t];
+        for (int i = a; i < z; ++i) {
+            const unsigned k = order_key(__ldg(row + i));
+            if (k > T) {
+                cand[pg++] = ((unsigned long long)k << 32) | (0xffffffffu - (unsigned)i);
+            } else if (k == T) {
+                if (pe < s_need_eq) cand[(want - s_need_eq) + pe] = ((unsigned long long)k << 32) | (0xffffffffu - (unsigned)i);
+                ++pe;
+            }
+        }
+    }
+    __syncthreads();
+    // bitonic sort of 128 slots, descending; empty slots are 0 (key 0 and index 0xffffffff would tie with a NaN: use
+    if (t < TOPC_MAX && t >= want) cand[t] = 0ull;
+    __syncthreads();
+    for (int kk = 2; kk <= TOPC_MAX; kk <<= 1) {
+        for (int j = kk >> 1; j > 0; j >>= 1) {
+            if (t < TOPC_MAX) {
+                const int ix = t ^ j;
+                if (ix > t) {
+                    const bool up = (t & kk) == 0; // descending overall
+                    const unsigned long long x = cand[t], y = cand[ix];
+                    if (up ? x < y : x > y) {
+                        cand[t] = y;
+                        cand[ix] = x;
+                    }
+                }
+            }
+            __syncthreads();
+        }
+    }
+    if (t < c) {
+        if (t < want) {
+            const unsigned long long e = cand[t];
+            const int i = (int)(0xffffffffu - (unsigned)(e & 0xffffffffu));
+            o[2 * t] = __float_as_uint(__ldg(row + i));
+            o[2 * t + 1] = (unsigned)(id0 + i);
+        } else {
+            o[2 * t] = __float_as_uint(-INFINITY);
+            o[2 * t + 1] = 0xffffffffu;
+        }
+    }
+}
+
+// ---- Markov chain + confidence
+
+// cands [world][rows][cand] {f32 logit, i32 id}; post bf16 [rows][hidden]; w1, w2 bf16 [vocab][rank]
+extern "C" __global__ void __launch_bounds__(CHAIN_THREADS) tf_mm3_ds_chain(
+    const unsigned* __restrict__ cands, const unsigned short* __restrict__ post, const unsigned short* __restrict__ w1,
+    const unsigned short* __restrict__ w2, const unsigned short* __restrict__ conf_w, const unsigned short* __restrict__ conf_b,
+    unsigned* __restrict__ out, int hidden, int rank, int cand, int world, int rows, unsigned anchor) {
+    __shared__ float hd[CHAIN_MAX_ROWS];
+    __shared__ float w1p[1024];
+    __shared__ float zs[CHAIN_MAX_CAND];
+    __shared__ int ids[CHAIN_MAX_CAND];
+    __shared__ int s_tok;
+    __shared__ float sv[WARPS];
+    __shared__ int si[WARPS];
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int ncand = world * cand;
+    // hidden part of every row's confidence: 4 fma chains a lane, (a0 + a1) + (a2 + a3), xor tree
+    for (int r = warp; r < rows; r += WARPS) {
+        float a0 = 0.f, a1 = 0.f, a2 = 0.f, a3 = 0.f;
+        for (int ch = 0; ch < hidden / 128; ++ch) {
+            const int at = 4 * (lane + 32 * ch);
+            const uint2 x = __ldg(reinterpret_cast<const uint2*>(post + (long long)r * hidden + at));
+            const uint2 w = __ldg(reinterpret_cast<const uint2*>(conf_w + at));
+            a0 = __fmaf_rn(lo16(x.x), lo16(w.x), a0);
+            a1 = __fmaf_rn(hi16(x.x), hi16(w.x), a1);
+            a2 = __fmaf_rn(lo16(x.y), lo16(w.y), a2);
+            a3 = __fmaf_rn(hi16(x.y), hi16(w.y), a3);
+        }
+        const float sum = tree32(__fadd_rn(__fadd_rn(a0, a1), __fadd_rn(a2, a3)));
+        if (lane == 0) hd[r] = sum;
+    }
+    for (int i = threadIdx.x; i < ncand; i += CHAIN_THREADS) ids[i] = -1;
+    __syncthreads();
+    unsigned prev = anchor;
+    const int per_lane = rank / 32; // rank dims a lane
+    for (int r = 0; r < rows; ++r) {
+        for (int i = threadIdx.x; i < rank; i += CHAIN_THREADS) w1p[i] = __uint_as_float((unsigned)__ldg(w1 + (long long)prev * rank + i) << 16);
+        for (int i = threadIdx.x; i < ncand; i += CHAIN_THREADS) {
+            const int wr = i / cand, k = i % cand;
+            const unsigned* e = cands + (((long long)wr * rows + r) * cand + k) * 2;
+            zs[i] = __uint_as_float(e[0]);
+            ids[i] = (int)e[1];
+        }
+        __syncthreads();
+        // z = base + dot(w2[id], w1[prev]); warps take candidates in turn, lane l owns dims l*per_lane ...
+        for (int i = warp; i < ncand; i += WARPS) {
+            const int id = ids[i];
+            float z = zs[i];
+            if (id >= 0) {
+                float a = 0.f;
+                const unsigned short* wr2 = w2 + (long long)id * rank + lane * per_lane;
+                for (int d = 0; d < per_lane; ++d) a = __fmaf_rn(__uint_as_float((unsigned)__ldg(wr2 + d) << 16), w1p[lane * per_lane + d], a);
+                a = tree32(a);
+                z = __fadd_rn(z, a);
+            }
+            if (lane == 0) zs[i] = z;
+        }
+        __syncthreads();
+        // best by the total order over the valid candidates
+        float bv = __int_as_float(0x7fc00000);
+        int bi = 0x7fffffff;
+        for (int i = threadIdx.x; i < ncand; i += CHAIN_THREADS) {
+            if (ids[i] >= 0 && beats(zs[i], ids[i], bv, bi)) {
+                bv = zs[i];
+                bi = ids[i];
+            }
+        }
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) {
+            const float ov = __shfl_xor_sync(0xffffffffu, bv, o);
+            const int oi = __shfl_xor_sync(0xffffffffu, bi, o);
+            if (beats(ov, oi, bv, bi)) {
+                bv = ov;
+                bi = oi;
+            }
+        }
+        if (lane == 0) {
+            sv[warp] = bv;
+            si[warp] = bi;
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            float v = sv[0];
+            int b = si[0];
+            for (int w = 1; w < WARPS; ++w) {
+                if (beats(sv[w], si[w], v, b)) {
+                    v = sv[w];
+                    b = si[w];
+                }
+            }
+            s_tok = b == 0x7fffffff ? -1 : b;
+        }
+        // confidence: the hidden part, then dot(w1[prev], conf_w[hidden ..]), then the bias
+        if (warp == 1) {
+            float a = 0.f;
+            const unsigned short* cw = conf_w + hidden + lane * per_lane;
+            for (int d = 0; d < per_lane; ++d) a = __fmaf_rn(w1p[lane * per_lane + d], __uint_as_float((unsigned)__ldg(cw + d) << 16), a);
+            a = tree32(a);
+            if (lane == 0) {
+                const float s = __fadd_rn(__fadd_rn(hd[r], a), __uint_as_float((unsigned)__ldg(conf_b) << 16));
+                out[2 * r + 1] = __float_as_uint(__fdiv_rn(1.f, __fadd_rn(1.f, expf(-s))));
+            }
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) out[2 * r] = (unsigned)s_tok;
+        prev = (unsigned)s_tok;
+        if (s_tok < 0) prev = anchor; // no candidate: the rest of the chain is empty anyway; keep indices valid
+        __syncthreads();
+    }
+}
diff --git a/zig/kernels/cuda/minimax_m3_index.cu b/zig/kernels/cuda/minimax_m3_index.cu
new file mode 100644
index 0000000..3843dfc
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_index.cu
@@ -0,0 +1,49 @@
+// MiniMax-M3.1-Flash index scoring and per-128-key block maxima (float64 reference: core/minimax_ref.zig blockScores).
+//   s[j] = (iq[g] . IK[j]) * scale   for keys j <= pos of a row, fp32; bmax[r][g][b] = max over the block's valid keys.
+// One CTA per (block, index head g, row): 4 warps, a warp scores its keys one at a time with the 32 lanes split over the
+// 128 dims (4 each, fixed order) and a fixed xor tree, so a score's bits depend on nothing but its two vectors.
+// NaN rule (stated, matches the reference): fmax drops a NaN key score; a block whose keys are all NaN scores -inf.
+#include "minimax_m3_sparse.cuh"
+
+using namespace tf_mm3;
+
+extern "C" __global__ void __launch_bounds__(128) tf_mm3_index(
+    const bf16* __restrict__ iq,       // [rows, kvh, 128] post norm and rotary
+    const int* __restrict__ pos,       // [rows] or null (pos0 + r)
+    int pos0,
+    const int* __restrict__ row_tab,   // [rows] offsets into tables, or null
+    const int* __restrict__ tables,    // page ids by block
+    const char* __restrict__ pool,
+    long long page_bytes, long long layer_off,
+    int kvh,
+    float* __restrict__ bmax,          // [rows, kvh, bm_stride]
+    int bm_stride,
+    float scale,
+    int kv8) {                         // 1: the pool is the fp8 layout (only where IK sits differs)
+    const int b = blockIdx.x, g = blockIdx.y, r = blockIdx.z;
+    const int p = row_pos(pos, pos0, r);
+    if (b > p / BLOCK) return;
+    const int page = __ldg(tables + row_table(row_tab, r) + b);
+    const char* base = page_layer(pool, page_bytes, layer_off, page);
+    const bf16* ik = reinterpret_cast<const bf16*>(base + ik_byte(kvh, kv8));
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const uint2 qw = __ldg(reinterpret_cast<const uint2*>(iq + ((long long)r * kvh + g) * D) + lane);
+    const float q0 = lo(qw.x), q1 = hi(qw.x), q2 = lo(qw.y), q3 = hi(qw.y);
+    const int valid = min(BLOCK, p + 1 - b * BLOCK);
+    float best = -INFINITY;
+    for (int j = warp; j < valid; j += 4) {
+        const uint2 kw = __ldg(reinterpret_cast<const uint2*>(ik + (long long)j * D) + lane);
+        float a = __fmul_rn(q0, lo(kw.x));
+        a = __fadd_rn(a, __fmul_rn(q1, hi(kw.x)));
+        a = __fadd_rn(a, __fmul_rn(q2, lo(kw.y)));
+        a = __fadd_rn(a, __fmul_rn(q3, hi(kw.y)));
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) a = __fadd_rn(a, __shfl_xor_sync(0xffffffffu, a, o));
+        best = fmaxf(best, __fmul_rn(a, scale));
+    }
+    __shared__ float part[4];
+    if (lane == 0) part[warp] = best;
+    __syncthreads();
+    if (threadIdx.x == 0)
+        bmax[((long long)r * kvh + g) * bm_stride + b] = fmaxf(fmaxf(part[0], part[1]), fmaxf(part[2], part[3]));
+}
diff --git a/zig/kernels/cuda/minimax_m3_proj.cu b/zig/kernels/cuda/minimax_m3_proj.cu
new file mode 100644
index 0000000..64744a3
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_proj.cu
@@ -0,0 +1,150 @@
+// MiniMax-M3.1-Flash fp16-weight index projection and the per-rank greedy pick; no third-party code.
+
+// tf_mm3_proj_{bf16,f32}: out[r][e] = sum_k w[e][k] * x[r][k] for the index query (n0 outputs) and the index key (n1).
+
+// Weights are fp16 (not quantized), x is the normed hidden state, bf16 or fp32; every product is exact in fp32.
+
+// A warp owns one output and up to 4 rows. Lane l sums chunks l, l + 32, ... of 4 values in four fp32 fma chains, then
+
+// (a0 + a1) + (a2 + a3), then a fixed xor tree 16 .. 1: the order never looks at the rows, the tile or the neighbours.
+
+// The fp32 sum is rounded once to fp16 or bf16 (launch parameter). NaN and infinities propagate as float64 does.
+
+// tf_mm3_pick: a CTA per row scans the rank's vocabulary slice of the padded logits and writes (logit, id).
+
+// Order: larger logit wins, equal logits go to the lower id, a NaN loses to every number (all NaN: the lowest id).
+
+// That is a total order, so any reduction tree gives the same pair.
+#include "minimax_m3_rows.cuh"
+
+using namespace tf_mm3;
+
+namespace {
+
+constexpr int PROJ_WARPS = 4;  // outputs a block
+constexpr int PROJ_ROWS = 4;   // rows a warp
+constexpr int PROJ_CHUNK = 128; // k is a multiple: 32 lanes x 4 values a step
+constexpr int PICK_THREADS = 256;
+
+__device__ __forceinline__ float tree32(float a) {
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) a = __fadd_rn(a, __shfl_xor_sync(0xffffffffu, a, o));
+    return a;
+}
+
+__device__ __forceinline__ float4 load_x(const bf16* p) { return widen4(__ldg(reinterpret_cast<const uint2*>(p))); }
+__device__ __forceinline__ float4 load_x(const float* p) { return __ldg(reinterpret_cast<const float4*>(p)); }
+
+template <typename X>
+__device__ __forceinline__ void proj_body(const X* __restrict__ x, long long x_ld, const unsigned short* __restrict__ w0,
+                                          int n0, unsigned short* __restrict__ o0, long long o0_ld,
+                                          const unsigned short* __restrict__ w1, int n1, unsigned short* __restrict__ o1,
+                                          long long o1_ld, int rows, int k, int out_bf16) {
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int e = blockIdx.x * PROJ_WARPS + warp;
+    if (e >= n0 + n1) return;
+    const bool second = e >= n0;
+    const int j = second ? e - n0 : e;
+    const unsigned short* we = (second ? w1 : w0) + (long long)j * k;
+    unsigned short* out = second ? o1 : o0;
+    const long long out_ld = second ? o1_ld : o0_ld;
+    const long long r0 = (long long)blockIdx.y * PROJ_ROWS;
+    float acc[PROJ_ROWS][4];
+#pragma unroll
+    for (int i = 0; i < PROJ_ROWS; ++i) acc[i][0] = acc[i][1] = acc[i][2] = acc[i][3] = 0.f;
+#pragma unroll 4
+    for (int c = 0; c < k / PROJ_CHUNK; ++c) {
+        const int at = 4 * (lane + 32 * c);
+        const float4 wv = widen4_half(__ldg(reinterpret_cast<const uint2*>(we + at)));
+#pragma unroll
+        for (int i = 0; i < PROJ_ROWS; ++i) {
+            if (r0 + i >= rows) continue;
+            const float4 xv = load_x(x + (r0 + i) * x_ld + at);
+            acc[i][0] = __fmaf_rn(xv.x, wv.x, acc[i][0]);
+            acc[i][1] = __fmaf_rn(xv.y, wv.y, acc[i][1]);
+            acc[i][2] = __fmaf_rn(xv.z, wv.z, acc[i][2]);
+            acc[i][3] = __fmaf_rn(xv.w, wv.w, acc[i][3]);
+        }
+    }
+#pragma unroll
+    for (int i = 0; i < PROJ_ROWS; ++i) {
+        const float sum = tree32(__fadd_rn(__fadd_rn(acc[i][0], acc[i][1]), __fadd_rn(acc[i][2], acc[i][3])));
+        if (lane == 0 && r0 + i < rows)
+            out[(r0 + i) * out_ld + j] = out_bf16 ? __bfloat16_as_ushort(__float2bfloat16_rn(sum))
+                                                  : __half_as_ushort(__float2half_rn(sum));
+    }
+}
+
+// True when candidate (bv, bi) beats (av, ai): a total order, NaN last, ties to the lower id.
+__device__ __forceinline__ bool beats(float bv, int bi, float av, int ai) {
+    const bool an = av != av, bn = bv != bv;
+    if (an && bn) return bi < ai;
+    if (bn) return false;
+    if (an) return true;
+    return bv > av || (bv == av && bi < ai);
+}
+
+} // namespace
+
+// x [rows, k] at x_ld elements a row; w0 fp16 [n0, k] -> o0 [rows, n0] at o0_ld; w1 [n1, k] -> o1 (n1 may be 0).
+
+// k a multiple of 128; x_ld a multiple of 4; outputs fp16 bits, or bf16 bits when out_bf16 is nonzero.
+extern "C" __global__ void __launch_bounds__(PROJ_WARPS * 32) tf_mm3_proj_bf16(
+    const bf16* __restrict__ x, long long x_ld, const unsigned short* __restrict__ w0, int n0, unsigned short* __restrict__ o0,
+    long long o0_ld, const unsigned short* __restrict__ w1, int n1, unsigned short* __restrict__ o1, long long o1_ld, int rows,
+    int k, int out_bf16) {
+    proj_body<bf16>(x, x_ld, w0, n0, o0, o0_ld, w1, n1, o1, o1_ld, rows, k, out_bf16);
+}
+
+// The same with an fp32 input: a bf16 hidden cast to fp32 gives the same bits as the bf16 form.
+extern "C" __global__ void __launch_bounds__(PROJ_WARPS * 32) tf_mm3_proj_f32(
+    const float* __restrict__ x, long long x_ld, const unsigned short* __restrict__ w0, int n0, unsigned short* __restrict__ o0,
+    long long o0_ld, const unsigned short* __restrict__ w1, int n1, unsigned short* __restrict__ o1, long long o1_ld, int rows,
+    int k, int out_bf16) {
+    proj_body<float>(x, x_ld, w0, n0, o0, o0_ld, w1, n1, o1, o1_ld, rows, k, out_bf16);
+}
+
+// logits fp32 [rows][ld] (the first n of a row are the rank's slice, the rest is padding); out [rows][2] words:
+
+// the winning logit's bits, then id0 + its index.
+extern "C" __global__ void __launch_bounds__(PICK_THREADS) tf_mm3_pick(const float* __restrict__ logits, long long ld,
+                                                                       int n, int id0, unsigned* __restrict__ out) {
+    __shared__ float sv[PICK_THREADS / 32];
+    __shared__ int si[PICK_THREADS / 32];
+    const float* row = logits + (long long)blockIdx.x * ld;
+    float bv = __int_as_float(0x7fc00000); // NaN: loses to everything
+    int bi = 0x7fffffff;
+    for (int i = threadIdx.x; i < n; i += PICK_THREADS) {
+        const float v = __ldg(row + i);
+        if (beats(v, i, bv, bi)) {
+            bv = v;
+            bi = i;
+        }
+    }
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) {
+        const float ov = __shfl_xor_sync(0xffffffffu, bv, o);
+        const int oi = __shfl_xor_sync(0xffffffffu, bi, o);
+        if (beats(ov, oi, bv, bi)) {
+            bv = ov;
+            bi = oi;
+        }
+    }
+    if ((threadIdx.x & 31) == 0) {
+        sv[threadIdx.x >> 5] = bv;
+        si[threadIdx.x >> 5] = bi;
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        float v = sv[0];
+        int i = si[0];
+        for (int w = 1; w < PICK_THREADS / 32; ++w) {
+            if (beats(sv[w], si[w], v, i)) {
+                v = sv[w];
+                i = si[w];
+            }
+        }
+        out[2 * blockIdx.x] = __float_as_uint(v);
+        out[2 * blockIdx.x + 1] = (unsigned)(id0 + i);
+    }
+}
diff --git a/zig/kernels/cuda/minimax_m3_rows.cu b/zig/kernels/cuda/minimax_m3_rows.cu
new file mode 100644
index 0000000..60906ce
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_rows.cu
@@ -0,0 +1,208 @@
+// MiniMax-M3.1-Flash row kernels from the engine-port plan (section 2, steps 3-6 and 11a); no third-party code.
+
+// tf_mm3_rows: per-head Gemma RMSNorm of q, k and index heads, partial RoPE; q, iq to scratch, k, v, ik to pages.
+
+// Reference: core/minimax_ref.zig gemmaNorm then rope. A CTA is a row, a head a warp: 4 values a lane, xor tree.
+
+// Rotation angles are float64 (pos * theta^(-2i/rot), sincos) rounded once to fp32: fp32 angles are off by 1e-2 at 1e6.
+
+// tf_mm3_router_*: fp32 logits[r][e] = sum_k w[e][k] * x[r][k]; a warp owns one expert and up to 4 rows.
+
+// Lane l sums chunks l, l + 32, ... in four fp32 fma chains, then (a0 + a1) + (a2 + a3), then a fixed xor tree 16 .. 1.
+
+// That order never looks at the row count, the tile or the neighbours: a row's logits are the same bits at any width.
+
+// NaN rule: none stated, arithmetic propagates NaN and infinities as the float64 reference does.
+
+// flags & ROWS_KV8 (off: the bf16 pool as before): k and v as quant_row8's e4m3 rows (docs/fp8-kv.md).
+#include "minimax_m3_rows.cuh"
+
+using namespace tf_mm3;
+
+namespace {
+
+__device__ __forceinline__ float tree32(float a) {
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) a = __fadd_rn(a, __shfl_xor_sync(0xffffffffu, a, o));
+    return a;
+}
+
+// Output dim d of the rotated head: stage holds the normed head, c and s the pair table.
+__device__ __forceinline__ float rotated(const float* stage, const float (*cs)[MAX_ROT_PAIRS], int d, int rot, bool gptj) {
+    const int half = rot >> 1;
+    int i, ia, ib;
+    if (gptj) {
+        i = d >> 1;
+        ia = 2 * i;
+        ib = ia + 1;
+    } else {
+        i = d < half ? d : d - half;
+        ia = i;
+        ib = i + half;
+    }
+    const float a = stage[ia], b = stage[ib], c = cs[0][i], s = cs[1][i];
+    const bool first = gptj ? (d & 1) == 0 : d < half;
+    return first ? __fsub_rn(__fmul_rn(a, c), __fmul_rn(b, s)) : __fadd_rn(__fmul_rn(b, c), __fmul_rn(a, s));
+}
+
+} // namespace
+
+extern "C" __global__ void __launch_bounds__(ROWS_THREADS) tf_mm3_rows(
+    const bf16* __restrict__ q_in, long long q_ld,         // [rows, nq * 128]
+    const bf16* __restrict__ k_in, long long k_ld,         // [rows, kvh * 128]
+    const bf16* __restrict__ v_in, long long v_ld,         // [rows, kvh * 128]
+    const unsigned short* __restrict__ iq_in, long long iq_ld,  // [rows, niq * 128], fp16 or bf16 bits
+    const unsigned short* __restrict__ ik_in, long long ik_ld,  // [rows, 128], fp16 or bf16 bits
+    const float* __restrict__ q_w, const float* __restrict__ k_w, const float* __restrict__ iq_w,
+    const float* __restrict__ ik_w,                        // [128] each, null when that norm is off
+    bf16* __restrict__ q_out, long long q_out_ld, bf16* __restrict__ iq_out, long long iq_out_ld,
+    const int* __restrict__ pos, int pos0,                 // [rows] or null (pos0 + r)
+    const int* __restrict__ row_tab, const int* __restrict__ tables, int max_pages,
+    char* pool, long long page_bytes, long long layer_off,
+    int rows, int nq, int niq, int kvh, int has_ik, int flags, int rot, float eps, float w_add, float w_add_index, double theta,
+    int* status) {
+    const int r = blockIdx.x;
+    if (r >= rows) return;
+    const int p = row_pos(pos, pos0, r);
+    if (p < 0) return;
+    __shared__ float cs[2][MAX_ROT_PAIRS];
+    __shared__ float stage[ROWS_WARPS][D];
+    const int half = rot >> 1;
+    const int blk = p / BLOCK;
+    const int page = blk < max_pages ? __ldg(tables + row_table(row_tab, r) + blk) : -1;
+    if (threadIdx.x == 0 && status != nullptr && page < 0) atomicOr(status, blk < max_pages ? ROWS_STATUS_NO_PAGE : ROWS_STATUS_PAST_TABLE);
+    if (threadIdx.x < half) {
+        double sn, cn;
+        sincos((double)p * pow(theta, -2.0 * (double)threadIdx.x / (double)rot), &sn, &cn);
+        cs[0][threadIdx.x] = (float)cn;
+        cs[1][threadIdx.x] = (float)sn;
+    }
+    __syncthreads();
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int t = p % BLOCK;
+    const bool gptj = (flags & ROWS_GPTJ) != 0;
+    const bool kv8 = (flags & ROWS_KV8) != 0;
+    const int total = nq + niq + 2 * kvh + (has_ik ? 1 : 0);
+    char* layer = page >= 0 ? pool + (long long)page * page_bytes + layer_off : nullptr;
+    for (int s = warp; s < total; s += ROWS_WARPS) {
+        int kind = 0, h = s;  // 0 q, 1 index q, 2 k, 3 v, 4 index key
+        if (s >= nq) { kind = 1; h = s - nq; }
+        if (s >= nq + niq) { kind = 2; h = s - nq - niq; }
+        if (s >= nq + niq + kvh) { kind = 3; h = s - nq - niq - kvh; }
+        if (s >= nq + niq + 2 * kvh) { kind = 4; h = 0; }
+        const unsigned short* src;
+        const float* w;
+        bool norm, rope, fp16 = false;
+        switch (kind) {
+        case 0: src = reinterpret_cast<const unsigned short*>(q_in + r * q_ld + h * D); w = q_w; norm = flags & ROWS_NORM_QK; rope = true; break;
+        case 1: src = iq_in + r * iq_ld + h * D; w = iq_w; norm = flags & ROWS_NORM_INDEX; rope = flags & ROWS_INDEX_ROPE; fp16 = flags & ROWS_INDEX_FP16; break;
+        case 2: src = reinterpret_cast<const unsigned short*>(k_in + r * k_ld + h * D); w = k_w; norm = flags & ROWS_NORM_QK; rope = true; break;
+        case 3: src = reinterpret_cast<const unsigned short*>(v_in + r * v_ld + h * D); w = nullptr; norm = false; rope = false; break;
+        default: src = ik_in + r * ik_ld; w = ik_w; norm = flags & ROWS_NORM_INDEX; rope = flags & ROWS_INDEX_ROPE; fp16 = flags & ROWS_INDEX_FP16; break;
+        }
+        const uint2 raw = __ldg(reinterpret_cast<const uint2*>(src) + lane);
+        if (kind == 3) {  // v is stored as it came (fp8: as its bf16 value's e4m3 row)
+            if (layer != nullptr) {
+                if (kv8) quant_row8(widen4(raw), reinterpret_cast<unsigned char*>(layer + kv8_byte(kvh, 1, h, t)),
+                                    reinterpret_cast<float*>(layer + scale8_byte(kvh, 1, h, t)), lane);
+                else reinterpret_cast<uint2*>(layer + kv_elem(kvh, 1, h, t) * 2)[lane] = raw;
+            }
+            continue;
+        }
+        float4 x = fp16 ? widen4_half(raw) : widen4(raw);
+        if (norm) {
+            float ss = __fmul_rn(x.x, x.x);
+            ss = __fadd_rn(ss, __fmul_rn(x.y, x.y));
+            ss = __fadd_rn(ss, __fmul_rn(x.z, x.z));
+            ss = __fadd_rn(ss, __fmul_rn(x.w, x.w));
+            ss = tree32(ss);
+            const float inv = __fdiv_rn(1.f, __fsqrt_rn(__fadd_rn(__fdiv_rn(ss, 128.f), eps)));
+            const float4 wv = __ldg(reinterpret_cast<const float4*>(w) + lane);
+            const float wa = (kind == 1 || kind == 4) ? w_add_index : w_add;
+            x.x = __fmul_rn(__fmul_rn(x.x, inv), __fadd_rn(wv.x, wa));
+            x.y = __fmul_rn(__fmul_rn(x.y, inv), __fadd_rn(wv.y, wa));
+            x.z = __fmul_rn(__fmul_rn(x.z, inv), __fadd_rn(wv.z, wa));
+            x.w = __fmul_rn(__fmul_rn(x.w, inv), __fadd_rn(wv.w, wa));
+            if (flags & ROWS_ROUND_NORM) x = make_float4(rn_bf16(x.x), rn_bf16(x.y), rn_bf16(x.z), rn_bf16(x.w));
+        }
+        float* st = stage[warp];
+        st[4 * lane] = x.x;
+        st[4 * lane + 1] = x.y;
+        st[4 * lane + 2] = x.z;
+        st[4 * lane + 3] = x.w;
+        __syncwarp();
+        float o[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int d = 4 * lane + i;
+            o[i] = (rope && d < rot) ? rotated(st, cs, d, rot, gptj) : st[d];
+        }
+        __syncwarp();
+        const uint2 packed = pack4(o[0], o[1], o[2], o[3]);
+        if (kind == 0) {
+            reinterpret_cast<uint2*>(q_out + r * q_out_ld + h * D)[lane] = packed;
+        } else if (kind == 1) {
+            reinterpret_cast<uint2*>(iq_out + r * iq_out_ld + h * D)[lane] = packed;
+        } else if (layer != nullptr) {
+            if (kind == 2 && kv8) {
+                quant_row8(make_float4(rn_bf16(o[0]), rn_bf16(o[1]), rn_bf16(o[2]), rn_bf16(o[3])),
+                           reinterpret_cast<unsigned char*>(layer + kv8_byte(kvh, 0, h, t)),
+                           reinterpret_cast<float*>(layer + scale8_byte(kvh, 0, h, t)), lane);
+            } else {
+                const long long byte = kind == 2 ? kv_elem(kvh, 0, h, t) * 2 : ik_byte(kvh, kv8) + (long long)t * D * 2;
+                reinterpret_cast<uint2*>(layer + byte)[lane] = packed;
+            }
+        }
+    }
+}
+
+namespace {
+
+__device__ __forceinline__ float4 load_x(const bf16* p) { return widen4(__ldg(reinterpret_cast<const uint2*>(p))); }
+__device__ __forceinline__ float4 load_x(const float* p) { return __ldg(reinterpret_cast<const float4*>(p)); }
+
+template <typename X>
+__device__ __forceinline__ void router_body(const X* __restrict__ x, long long x_ld, const float* __restrict__ w,
+                                            float* __restrict__ out, int rows, int ne, int k) {
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int e = blockIdx.x * ROUTER_WARPS + warp;
+    if (e >= ne) return;
+    const long long r0 = (long long)blockIdx.y * ROUTER_ROWS;
+    float acc[ROUTER_ROWS][4];
+#pragma unroll
+    for (int i = 0; i < ROUTER_ROWS; ++i) acc[i][0] = acc[i][1] = acc[i][2] = acc[i][3] = 0.f;
+    const float* we = w + (long long)e * k;
+#pragma unroll 4
+    for (int j = 0; j < k / ROUTER_CHUNK; ++j) {
+        const int c = 4 * (lane + 32 * j);
+        const float4 wv = __ldg(reinterpret_cast<const float4*>(we + c));
+#pragma unroll
+        for (int i = 0; i < ROUTER_ROWS; ++i) {
+            if (r0 + i >= rows) continue;
+            const float4 xv = load_x(x + (r0 + i) * x_ld + c);
+            acc[i][0] = __fmaf_rn(xv.x, wv.x, acc[i][0]);
+            acc[i][1] = __fmaf_rn(xv.y, wv.y, acc[i][1]);
+            acc[i][2] = __fmaf_rn(xv.z, wv.z, acc[i][2]);
+            acc[i][3] = __fmaf_rn(xv.w, wv.w, acc[i][3]);
+        }
+    }
+#pragma unroll
+    for (int i = 0; i < ROUTER_ROWS; ++i) {
+        const float sum = tree32(__fadd_rn(__fadd_rn(acc[i][0], acc[i][1]), __fadd_rn(acc[i][2], acc[i][3])));
+        if (lane == 0 && r0 + i < rows) out[(r0 + i) * ne + e] = sum;
+    }
+}
+
+} // namespace
+
+// x bf16 [rows, k] at x_ld elements a row, w fp32 [ne, k], out fp32 [rows, ne]; k a multiple of 128, x_ld of 4.
+extern "C" __global__ void __launch_bounds__(ROUTER_WARPS * 32) tf_mm3_router_bf16(
+    const bf16* __restrict__ x, long long x_ld, const float* __restrict__ w, float* __restrict__ out, int rows, int ne, int k) {
+    router_body<bf16>(x, x_ld, w, out, rows, ne, k);
+}
+
+// The same with an fp32 input: a bf16 hidden cast to fp32 gives the same bits as the bf16 form.
+extern "C" __global__ void __launch_bounds__(ROUTER_WARPS * 32) tf_mm3_router_f32(
+    const float* __restrict__ x, long long x_ld, const float* __restrict__ w, float* __restrict__ out, int rows, int ne, int k) {
+    router_body<float>(x, x_ld, w, out, rows, ne, k);
+}
diff --git a/zig/kernels/cuda/minimax_m3_rows.cuh b/zig/kernels/cuda/minimax_m3_rows.cuh
new file mode 100644
index 0000000..303b328
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_rows.cuh
@@ -0,0 +1,77 @@
+// MiniMax-M3.1-Flash row kernels: launch flags and helpers of minimax_m3_rows.cu, written from the engine-port plan.
+#pragma once
+
+#include "minimax_m3_sparse.cuh"
+
+#include <cuda_fp16.h>
+#include <cuda_fp8.h>
+#include <float.h>
+
+namespace tf_mm3 {
+
+// Bits of the flags argument of tf_mm3_rows: each unverified semantic of core/minimax_ref.zig Switches is one.
+constexpr int ROWS_NORM_QK = 1;      // Gemma-norm q and k per head (use_qk_norm, qk_norm_type per_head)
+constexpr int ROWS_NORM_INDEX = 2;   // Gemma-norm the index query heads and the index key
+constexpr int ROWS_INDEX_ROPE = 4;   // rotate the index query and key (Switches.index_rope)
+constexpr int ROWS_INDEX_FP16 = 8;   // the index projections' outputs are fp16 (else bf16)
+constexpr int ROWS_ROUND_NORM = 16;  // round the norm output to bf16 before the rotation (Switches.bf16_norm_out)
+constexpr int ROWS_GPTJ = 32;        // rotate (2i, 2i + 1) pairs (Switches.rope_layout gptj_interleaved); else (i, i + rot/2)
+constexpr int ROWS_KV8 = 64;         // the pool is the fp8 layout: k and v as e4m3 rows with an fp32 scale each (docs/fp8-kv.md)
+
+// Bits kernels may set in the optional status word.
+constexpr int ROWS_STATUS_NO_PAGE = 1;    // a row's block table entry was negative: its K/V/IK were not written
+constexpr int ROWS_STATUS_PAST_TABLE = 2; // a row's position is past its block table row
+
+constexpr int ROWS_WARPS = 8;
+constexpr int ROWS_THREADS = ROWS_WARPS * 32;
+constexpr int MAX_ROT_PAIRS = 64;
+
+constexpr int ROUTER_WARPS = 4;    // experts a block
+constexpr int ROUTER_ROWS = 4;     // rows a warp; a row's bits do not depend on how many share the warp
+constexpr int ROUTER_CHUNK = 128;  // k is a multiple: 32 lanes x 4 values a step
+
+__device__ __forceinline__ float rn_bf16(float v) { return __bfloat162float(__float2bfloat16_rn(v)); }
+
+__device__ __forceinline__ float4 widen4(uint2 w) { return make_float4(lo(w.x), hi(w.x), lo(w.y), hi(w.y)); }
+
+__device__ __forceinline__ float4 widen4_half(uint2 w) {
+    return make_float4(__half2float(__ushort_as_half(w.x & 0xffffu)), __half2float(__ushort_as_half(w.x >> 16)),
+                       __half2float(__ushort_as_half(w.y & 0xffffu)), __half2float(__ushort_as_half(w.y >> 16)));
+}
+
+__device__ __forceinline__ uint2 pack4(float a, float b, float c, float d) {
+    const unsigned x = (unsigned)__bfloat16_as_ushort(__float2bfloat16_rn(a)) |
+                       ((unsigned)__bfloat16_as_ushort(__float2bfloat16_rn(b)) << 16);
+    const unsigned y = (unsigned)__bfloat16_as_ushort(__float2bfloat16_rn(c)) |
+                       ((unsigned)__bfloat16_as_ushort(__float2bfloat16_rn(d)) << 16);
+    return make_uint2(x, y);
+}
+
+// A 128-value row (4 a lane, whole warp) as e4m3 codes and the fp32 scale amax / 448; a NaN or inf row: NaN scale.
+__device__ __forceinline__ void quant_row8(float4 x, unsigned char* codes, float* scale, int lane) {
+    const bool bad = !(fabsf(x.x) <= FLT_MAX) || !(fabsf(x.y) <= FLT_MAX) || !(fabsf(x.z) <= FLT_MAX) || !(fabsf(x.w) <= FLT_MAX);
+    const bool any_bad = __any_sync(0xffffffffu, bad);
+    float amax = fmaxf(fmaxf(fabsf(x.x), fabsf(x.y)), fmaxf(fabsf(x.z), fabsf(x.w)));
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, o));
+    float inv = 1.f, sc = 1.f;
+    if (amax > 0.f) {
+        inv = __fdiv_rn(448.f, amax);
+        sc = __fdiv_rn(amax, 448.f);
+        if (sc < 0x1p-126f) {
+            sc = 0x1p-126f;
+            inv = __fdiv_rn(1.f, sc);
+        }
+    }
+    unsigned w = 0;
+    if (!any_bad) {
+        w = (unsigned)__nv_cvt_float_to_fp8(__fmul_rn(x.x, inv), __NV_SATFINITE, __NV_E4M3) |
+            ((unsigned)__nv_cvt_float_to_fp8(__fmul_rn(x.y, inv), __NV_SATFINITE, __NV_E4M3) << 8) |
+            ((unsigned)__nv_cvt_float_to_fp8(__fmul_rn(x.z, inv), __NV_SATFINITE, __NV_E4M3) << 16) |
+            ((unsigned)__nv_cvt_float_to_fp8(__fmul_rn(x.w, inv), __NV_SATFINITE, __NV_E4M3) << 24);
+    }
+    reinterpret_cast<unsigned*>(codes)[lane] = w;
+    if (lane == 0) *scale = any_bad ? __int_as_float(0x7fc00000) : sc;
+}
+
+} // namespace tf_mm3
diff --git a/zig/kernels/cuda/minimax_m3_select.cu b/zig/kernels/cuda/minimax_m3_select.cu
new file mode 100644
index 0000000..f701db5
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_select.cu
@@ -0,0 +1,81 @@
+// MiniMax-M3.1-Flash forced-block top-16 (float64 reference: core/minimax_ref.zig forced, topk, selectBlocks).
+// A row with nb = pos / 128 + 1 blocks attends all of them when nb <= 16, else the 16 best by (score desc, then block id
+// by the tie rule) with forced blocks scored +inf. The forcing rules and the tie rule are UNVERIFIED upstream semantics,
+// so they are launch parameters mirroring minimax_ref.Switches: init_n/init_inclusive (sparse_init_block count or
+// inclusive), local_n/local_trailing (sparse_local_block as "own block if > 0" or "trailing window of n"), higher_tie.
+// A NaN block score ranks as -inf (the reference's rule). Output: ascending block ids, -1 padded, per (row, kv head).
+#include "minimax_m3_sparse.cuh"
+
+using namespace tf_mm3;
+
+namespace {
+
+__device__ __forceinline__ bool forced(int b, int own, int init_n, int init_inclusive, int local_n, int local_trailing) {
+    const bool init = init_inclusive ? b <= init_n : b < init_n;
+    const bool local = local_trailing ? (b <= own && own - b < local_n) : (local_n > 0 && b == own);
+    return init || local;
+}
+
+/// True when (sa, ia) ranks strictly before (sb, ib): larger score, then the tie rule's block id.
+__device__ __forceinline__ bool before(float sa, int ia, float sb, int ib, int higher) {
+    return sa > sb || (sa == sb && (higher ? ia > ib : ia < ib));
+}
+
+} // namespace
+
+extern "C" __global__ void __launch_bounds__(256) tf_mm3_select(
+    const float* __restrict__ bmax,    // [rows, kvh, bm_stride]
+    const int* __restrict__ pos,
+    int pos0,
+    int* __restrict__ sel,             // [rows, kvh, 16]
+    int kvh, int bm_stride,
+    int init_n, int init_inclusive, int local_n, int local_trailing, int higher_tie) {
+    const int g = blockIdx.x, r = blockIdx.y;
+    const int p = row_pos(pos, pos0, r);
+    const int nb = p / BLOCK + 1, own = nb - 1;
+    int* out = sel + ((long long)r * kvh + g) * TOPK;
+    const int t = threadIdx.x;
+    if (nb <= TOPK) {
+        if (t < TOPK) out[t] = t < nb ? t : -1;
+        return;
+    }
+    const float* sc = bmax + ((long long)r * kvh + g) * bm_stride;
+    __shared__ float ws[8];
+    __shared__ int wi[8];
+    __shared__ int chosen[TOPK];
+    __shared__ float prev_s;
+    __shared__ int prev_i;
+    for (int k = 0; k < TOPK; ++k) {
+        float bs = -INFINITY;
+        int bi = -1;
+        for (int b = t; b < nb; b += 256) {
+            float s = forced(b, own, init_n, init_inclusive, local_n, local_trailing) ? INFINITY : __ldg(sc + b);
+            if (s != s) s = -INFINITY;
+            if (k > 0 && !before(prev_s, prev_i, s, b, higher_tie)) continue;
+            if (bi < 0 || before(s, b, bs, bi, higher_tie)) { bs = s; bi = b; }
+        }
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) {
+            const float os = __shfl_xor_sync(0xffffffffu, bs, o);
+            const int oi = __shfl_xor_sync(0xffffffffu, bi, o);
+            if (oi >= 0 && (bi < 0 || before(os, oi, bs, bi, higher_tie))) { bs = os; bi = oi; }
+        }
+        if ((t & 31) == 0) { ws[t >> 5] = bs; wi[t >> 5] = bi; }
+        __syncthreads();
+        if (t == 0) {
+            float s = ws[0];
+            int i = wi[0];
+            for (int w = 1; w < 8; ++w)
+                if (wi[w] >= 0 && (i < 0 || before(ws[w], wi[w], s, i, higher_tie))) { s = ws[w]; i = wi[w]; }
+            chosen[k] = i;
+            prev_s = s;
+            prev_i = i;
+        }
+        __syncthreads();
+    }
+    if (t < TOPK) {
+        int rank = 0;
+        for (int u = 0; u < TOPK; ++u) rank += chosen[u] < chosen[t];
+        out[rank] = chosen[t];
+    }
+}
diff --git a/zig/kernels/cuda/minimax_m3_sparse.cuh b/zig/kernels/cuda/minimax_m3_sparse.cuh
new file mode 100644
index 0000000..2c5e575
--- /dev/null
+++ b/zig/kernels/cuda/minimax_m3_sparse.cuh
@@ -0,0 +1,64 @@
+// MiniMax-M3.1-Flash block-sparse attention: constants and paged addressing shared by minimax_m3_{index,select,attn}.cu.
+// Semantics: core/minimax_ref.zig (float64). Nothing here is copied from another project; written from the formulas in
+// the engine-port plan (section 2, T5).
+//
+// Page = 128 tokens = one selection block. Inside one page and one layer (head-major, bf16):
+//   K[kvh][128 tok][128] | V[kvh][128][128] | IK[128 tok][128]
+// A pool address is  base + page * page_bytes + layer_off + element offset * 2; the kernels take page ids from a block
+// table (tables[row_tab[r] + block]), never an address, so a pool may move or grow between launches.
+#pragma once
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+#include <math.h>
+#include <stdint.h>
+
+namespace tf_mm3 {
+
+constexpr int D = 128;     // head_dim and index_head_dim
+constexpr int BLOCK = 128; // keys a selection block (= tokens a page)
+constexpr int TOPK = 16;   // blocks a row attends (sparse_topk_blocks)
+constexpr int GROUP = 16;  // query heads a kv head (64 / 4)
+
+typedef __nv_bfloat16 bf16;
+
+__device__ __forceinline__ float bf(uint32_t half_bits) { return __uint_as_float(half_bits << 16); }
+__device__ __forceinline__ float lo(uint32_t w) { return __uint_as_float(w << 16); }
+__device__ __forceinline__ float hi(uint32_t w) { return __uint_as_float(w & 0xffff0000u); }
+
+constexpr long long K_ELEMS = (long long)BLOCK * D; // one head's block of K (or V)
+
+/// Element offset (bf16) of K (which 0) or V (which 1) head h, token t inside a page's layer region.
+__device__ __forceinline__ long long kv_elem(int kvh, int which, int h, int t) {
+    return ((long long)which * kvh + h) * K_ELEMS + (long long)t * D;
+}
+
+/// Element offset of index-key token t.
+__device__ __forceinline__ long long ik_elem(int kvh, int t) { return 2LL * kvh * K_ELEMS + (long long)t * D; }
+
+/// fp8 layout (kv8) of a layer: K8 [kvh][128][128] | V8 | IK bf16 [128][128] | K scales f32 [kvh][128] | V scales.
+
+/// fp8 layout, bytes inside a layer region: the e4m3 row of K (which 0) or V (which 1), head h, token t.
+__device__ __forceinline__ long long kv8_byte(int kvh, int which, int h, int t) {
+    return ((long long)which * kvh + h) * K_ELEMS + (long long)t * D;
+}
+
+/// Byte offset inside a layer region of the index keys (K and V take 2 bytes a value, fp8's 1; IK is bf16 in both).
+__device__ __forceinline__ long long ik_byte(int kvh, int kv8) { return 2LL * kvh * K_ELEMS * (kv8 ? 1 : 2); }
+
+/// fp8 layout: byte offset inside a layer region of the fp32 scale of the row kv8_byte names (after the 32 KiB of IK).
+__device__ __forceinline__ long long scale8_byte(int kvh, int which, int h, int t) {
+    return 2LL * kvh * K_ELEMS + K_ELEMS * 2 + (((long long)which * kvh + h) * BLOCK + t) * 4;
+}
+
+__device__ __forceinline__ const char* page_layer(const char* pool, long long page_bytes, long long layer_off, int page) {
+    return pool + (long long)page * page_bytes + layer_off;
+}
+
+/// A row's position: pos[r], or pos0 + r when pos is null (a prompt chunk of one stream).
+__device__ __forceinline__ int row_pos(const int* pos, int pos0, int r) { return pos ? __ldg(pos + r) : pos0 + r; }
+
+/// Offset of a row's block table in `tables` (row_tab null: one table for every row).
+__device__ __forceinline__ int row_table(const int* row_tab, int r) { return row_tab ? __ldg(row_tab + r) : 0; }
+
+} // namespace tf_mm3
diff --git a/zig/src/core/contract/minimax_m3_dspark_records.zig b/zig/src/core/contract/minimax_m3_dspark_records.zig
new file mode 100644
index 0000000..905993d
