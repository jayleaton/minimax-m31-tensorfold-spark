+test "per-expert widths and pointer offsets: layer 2 mixes 4/4/3 bits, layer 3 has one 4-bit expert among 3-bit" {
+    const io = std.testing.io;
+    const c = mini();
+    var pack = Pack.init();
+    defer pack.deinit();
