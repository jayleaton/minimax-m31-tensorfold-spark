diff --git a/zig/tests/cuda/contract_minimax_act.zig b/zig/tests/cuda/contract_minimax_act.zig
new file mode 100644
index 0000000..4585a0d
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_act.zig
@@ -0,0 +1,175 @@
+//! minimax_m3_act.cu's swigluoai under the contract on CUDA: float64 reference core/minimax_ref.zig `swigluoai`, NaN
+//! propagating as float64 does, and two planted controls (a clamp by fminf, which drops a NaN, and a lost tail value).
+//! Written for the GB10 run; nothing here has run on a GPU yet.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const mr = core.minimax_ref;
+const act = cuda.minimax_m3_act;
+
+pub const Which = enum { bf16, bf16_symmetric_no_bias, f32, ctl_fmin, ctl_tail };
+
+fn noSums(_: c.Shape) usize {
+    return 0;
+}
+
+/// expf (2 ulp), the add, the division and the products.
+const act_ops = 8;
+
+// Layers 0-2's dense MLP (12288) and the shared expert (3072), whole and cut in two for the two-rank split.
+const served = &[_]c.Shape{ .{ .rows = 1, .n = 3072, .k = 1 }, .{ .rows = 1, .n = 12288, .k = 1 }, .{ .rows = 17, .n = 1536, .k = 1 }, .{ .rows = 64, .n = 6144, .k = 1 } };
+const tile_n: c.Tile = .{ .size = 256, .step = 1, .min = 1 }; // one thread a value, 256 a block; the guard is the edge
+const tile_rows: c.Tile = .{ .size = 16 };
+
+pub fn spec(which: Which) c.Spec {
+    const name = switch (which) {
+        .bf16 => "cuda minimax_m3_act tf_mm3_swigluoai_bf16",
+        .bf16_symmetric_no_bias => "cuda minimax_m3_act tf_mm3_swigluoai_bf16 (symmetric gate clamp, no +1)",
+        .f32 => "cuda minimax_m3_act tf_mm3_swigluoai_f32",
+        .ctl_fmin => "control: swigluoai clamped by fminf",
+        .ctl_tail => "control: swigluoai losing a tail value",
+    };
+    return .{ .name = name, .accum = .none, .depth = noSums, .ops = act_ops, .out = .bf16, .tiles = .{ tile_rows, tile_n, .{} }, .served = served };
+}
+
+pub fn control(which: Which) ?g.Gate {
+    return switch (which) {
+        .ctl_fmin => .nonfinite,
+        .ctl_tail => .shapes,
+        else => null,
+    };
+}
+
+fn params(which: Which) act.Params {
+    return if (which == .bf16_symmetric_no_bias) .{ .symmetric_gate_clamp = true, .up_bias = 0 } else .{};
+}
+
+pub const Mm3Act = struct {
+    rig: rig_.Rig,
+    which: Which,
+    k: *const act.MiniMaxAct,
+    ctl: ?cuda.Function = null,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    gate: []f32 = &.{},
+    up: []f32 = &.{},
+    gate_ptr: u64 = 0,
+    up_ptr: u64 = 0,
+    out: u64 = 0,
+
+    pub fn deinit(self: *Mm3Act) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    const vt = g.hooks(Mm3Act);
+
+    pub fn kernel(self: *Mm3Act) g.Kernel {
+        return .{ .spec = spec(self.which), .ctx = self, .vt = &vt, .control = control(self.which) };
+    }
+
+    fn isF32(self: *const Mm3Act) bool {
+        return self.which == .f32;
+    }
+
+    pub fn prepare(self: *Mm3Act, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.n == 0) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        self.shape = shape;
+        const a = self.arena.allocator();
+        const n = shape.rows * shape.n;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.gate = try a.alloc(f32, n);
+        self.up = try a.alloc(f32, n);
+        // gates past +-7 (the clamp), a few huge ones; ups past +-7 on both sides
+        for (self.gate, self.up, 0..) |*gv, *uv, i| {
+            gv.* = (rng.float(f32) * 2 - 1) * (if (i % 17 == 3) @as(f32, 30) else 9);
+            uv.* = (rng.float(f32) * 2 - 1) * (if (i % 13 == 5) @as(f32, 20) else 8);
+        }
+        if (fill == .nonfinite) {
+            const w = shape.n;
+            const at = [_][2]usize{ .{ 0, w / 3 }, .{ 1, w / 2 }, .{ 2, w - 1 }, .{ 3, 0 }, .{ 3, w - 1 } };
+            const nan = std.math.nan(f32);
+            const inf = std.math.inf(f32);
+            // gate: NaN, +inf, -inf; up: row 3 holds +inf and -inf; one more NaN in an up
+            const put_g = [_]f32{ nan, inf, -inf, 1, 1 };
+            const put_u = [_]f32{ 1, 1, 1, inf, -inf };
+            for (at, put_g, put_u, 0..) |p, pg, pu, i| if (p[0] < shape.rows) {
+                self.gate[p[0] * w + p[1]] = pg;
+                self.up[p[0] * w + p[1]] = pu;
+                if (i == 0 and shape.rows > 4) self.up[4 * w + w / 4] = nan;
+            };
+        }
+        // the inputs are bf16 values (or fp32 in the f32 form), so the reference reads exactly what the kernel reads
+        if (!self.isF32()) {
+            for (self.gate) |*v| v.* = c.fromBf16(c.toBf16(v.*));
+            for (self.up) |*v| v.* = c.fromBf16(c.toBf16(v.*));
+            const gb = try a.alloc(u16, n);
+            const ub = try a.alloc(u16, n);
+            for (gb, self.gate) |*o, v| o.* = c.toBf16(v);
+            for (ub, self.up) |*o, v| o.* = c.toBf16(v);
+            self.gate_ptr = try self.rig.input(std.mem.sliceAsBytes(gb));
+            self.up_ptr = try self.rig.input(std.mem.sliceAsBytes(ub));
+        } else {
+            self.gate_ptr = try self.rig.input(std.mem.sliceAsBytes(self.gate));
+            self.up_ptr = try self.rig.input(std.mem.sliceAsBytes(self.up));
+        }
+        self.out = try self.rig.output(n * 2);
+        return true;
+    }
+
+    pub fn run(self: *Mm3Act) !void {
+        const s = self.rig.s;
+        const r = self.shape.rows;
+        const n = self.shape.n;
+        const p = params(self.which);
+        if (self.ctl) |f| {
+            var args: cuda.Args = .{};
+            args.add(self.gate_ptr);
+            args.add(self.up_ptr);
+            args.add(self.out);
+            args.add(@as(c_int, @intCast(n)));
+            args.add(p.alpha);
+            args.add(p.limit);
+            args.add(p.up_bias);
+            args.add(@as(c_int, if (self.which == .ctl_fmin) 0 else 1));
+            try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(r), .y = @intCast((n + 255) / 256), .z = 1 }, .block = .{ .x = 256 } }, s, &args);
+        } else {
+            try self.k.swigluoai(s, if (self.isF32()) .f32 else .bf16, self.gate_ptr, n, self.up_ptr, n, self.out, n, r, n, p);
+        }
+        try s.synchronize();
+    }
+
+    pub fn count(self: *Mm3Act) usize {
+        return self.shape.rows * self.shape.n;
+    }
+
+    /// Float64 swigluoai of the exact inputs, with the alpha the kernel is given (an fp32 value).
+    pub fn reference(self: *Mm3Act, want: []f64, mag: []f64) !void {
+        const p = params(self.which);
+        const sw: mr.Switches = .{ .gate_clamp = if (p.symmetric_gate_clamp) .symmetric else .upper_only, .up_plus_one = p.up_bias != 0 };
+        for (want, mag, self.gate, self.up) |*o, *m, gv, uv| {
+            o.* = mr.swigluoai(gv, uv, p.alpha, p.limit, sw);
+            m.* = @abs(o.*);
+        }
+    }
+};
+
+test "the controls are the two named faults, each at its gate" {
+    try std.testing.expectEqual(@as(?g.Gate, .nonfinite), control(.ctl_fmin));
+    try std.testing.expectEqual(@as(?g.Gate, .shapes), control(.ctl_tail));
+    for ([_]Which{ .bf16, .bf16_symmetric_no_bias, .f32 }) |w| try std.testing.expectEqual(@as(?g.Gate, null), control(w));
+}
+
+test "the served shapes sit inside the launch's limits and the dense widths are 128 multiples" {
+    for (served) |s| {
+        try std.testing.expectEqual(@as(usize, 0), s.n % 128);
+        try act.check(s.rows, s.n, s.n, s.n, s.n);
+    }
+}
diff --git a/zig/tests/cuda/contract_minimax_all.zig b/zig/tests/cuda/contract_minimax_all.zig
new file mode 100644
index 0000000..590ce2f
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_all.zig
@@ -0,0 +1,72 @@
+//! All MiniMax kernels (act, select, attn, rows, router, proj, pick) through gates 1-4; no controls, no limits.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const act_k = @import("contract_minimax_act.zig");
+const sparse_k = @import("contract_minimax_sparse.zig");
+const rows_k = @import("contract_minimax_rows.zig");
+const proj_k = @import("contract_minimax_proj.zig");
+const ds_k = @import("contract_minimax_dspark.zig");
+
+const g = core.contract.gates;
+
+pub fn run(gpu: @import("check.zig").Gpu) !void {
+    const check = @import("check.zig");
+    const a = gpu.gpa;
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var kernels: std.ArrayList(g.Kernel) = .empty;
+    defer kernels.deinit(a);
+
+    var act = try cuda.minimax_m3_act.MiniMaxAct.load(gpu.d);
+    defer act.unload();
+    var acts: [std.enums.values(act_k.Which).len]act_k.Mm3Act = undefined;
+    var n_acts: usize = 0;
+    for (std.enums.values(act_k.Which)) |w| {
+        if (act_k.control(w) != null) continue;
+        acts[n_acts] = .{ .rig = .{ .gpu = gpu, .s = s }, .which = w, .k = &act, .arena = .init(a) };
+        n_acts += 1;
+    }
+    defer for (acts[0..n_acts]) |*x| x.deinit();
+    for (acts[0..n_acts]) |*x| try kernels.append(a, x.kernel());
+
+    var sparse = try cuda.minimax_m3_sparse.Sparse.load(gpu.d);
+    defer sparse.unload();
+    var selects: [sparse_k.variants.len]sparse_k.Select = undefined;
+    for (sparse_k.variants, &selects) |v, *x| x.* = .{ .rig = .{ .gpu = gpu, .s = s }, .f = &sparse, .v = v };
+    defer for (&selects) |*x| x.deinit();
+    for (&selects) |*x| try kernels.append(a, x.kernel());
+    var attns: [sparse_k.cfgs.len]sparse_k.Attn = undefined;
+    for (sparse_k.cfgs, &attns) |f, *x| x.* = .{ .rig = .{ .gpu = gpu, .s = s }, .f = f, .s = &sparse };
+    defer for (&attns) |*x| x.deinit();
+    for (&attns) |*x| try kernels.append(a, x.kernel());
+
+    var rows = try cuda.minimax_m3_rows.Rows.load(gpu.d);
+    defer rows.unload();
+    var logits: [2]rows_k.Logits = undefined;
+    for (std.enums.values(rows_k.Form), &logits) |f, *x| x.* = .{ .rig = .{ .gpu = gpu, .s = s }, .form = f, .k = &rows };
+    defer for (&logits) |*x| x.deinit();
+    for (&logits) |*x| try kernels.append(a, x.kernel());
+    var writers: [rows_k.cfgs.len]rows_k.Writer = undefined;
+    for (rows_k.cfgs, &writers) |f, *x| x.* = .{ .rig = .{ .gpu = gpu, .s = s }, .f = f, .k = &rows, .arena = .init(a) };
+    defer for (&writers) |*x| x.deinit();
+    for (&writers) |*x| try kernels.append(a, x.kernel());
+
+    var proj = try cuda.minimax_m3_proj.Proj.load(gpu.d);
+    defer proj.unload();
+    var projs: [3]proj_k.Proj = undefined;
+    for (std.enums.values(proj_k.Form), &projs) |f, *x| x.* = .{ .rig = .{ .gpu = gpu, .s = s }, .form = f, .k = &proj };
+    defer for (&projs) |*x| x.deinit();
+    for (&projs) |*x| try kernels.append(a, x.kernel());
+    var pick: proj_k.Pick = .{ .rig = .{ .gpu = gpu, .s = s }, .k = &proj };
+    defer pick.deinit();
+    try kernels.append(a, pick.kernel());
+
+    var dspark = try ds_k.Holder.open(gpu, s, &kernels);
+    defer dspark.close();
+
+    var t: g.Tally = .{};
+    try g.runAll(a, kernels.items, 0x6d33, &t);
+    std.debug.print("SUMMARY mm3-contract {d} kernels: {d} pass gates 1-4, {d} fail, {d} known findings\n", .{ t.kernels, t.passed, t.failed, t.known });
+    try check.expect(t.failed == 0, "mm3-contract: {d} gate failures", .{t.failed});
+}
diff --git a/zig/tests/cuda/contract_minimax_dspark.zig b/zig/tests/cuda/contract_minimax_dspark.zig
new file mode 100644
index 0000000..b651f38
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_dspark.zig
@@ -0,0 +1,164 @@
+//! MiniMax-M3.1-Flash dspark draft kernels under the contract on CUDA: the set, the runner and the bench.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const common = @import("contract_minimax_dspark_common.zig");
+const rows = @import("contract_minimax_dspark_rows.zig");
+const heads = @import("contract_minimax_dspark_heads.zig");
+const attn_p = @import("contract_minimax_dspark_attn.zig");
+const search = @import("contract_minimax_dspark_search.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const ds = cuda.minimax_m3_dspark;
+
+const hidden = common.hidden;
+const nq = common.nq;
+const kvh = common.kvh;
+const Tap = rows.Tap;
+const Add = rows.Add;
+const AddForm = rows.AddForm;
+const Norm = rows.Norm;
+const NormForm = rows.NormForm;
+const normSpec = rows.normSpec;
+const Block = heads.Block;
+const Ring = heads.Ring;
+const Attn = attn_p.Attn;
+const attn_cfgs = attn_p.attn_cfgs;
+const attnSpec = attn_p.attnSpec;
+const ring_rows = attn_p.ring_rows;
+const base_pos = attn_p.base_pos;
+const TopC = search.TopC;
+const Chain = search.Chain;
+const topc_spec = search.topc_spec;
+const chain_spec = search.chain_spec;
+const slot_n = search.slot_n;
+const pad = search.pad;
+const cand = search.cand;
+const rank = search.rank;
+
+/// The writers of this file as harness kernels, owned by `Set` until `deinit`.
+pub const Set = struct {
+    taps: [1]Tap,
+    adds: [3]Add,
+    norms: [3]Norm,
+    blocks: [2]Block,
+    rings: [1]Ring,
+    attns: [attn_cfgs.len]Attn,
+    topcs: [1]TopC,
+    chains: [1]Chain,
+
+    pub fn init(self: *Set, gpu: @import("check.zig").Gpu, s: cuda.Stream, k: *const ds.Dspark) void {
+        const rig: rig_.Rig = .{ .gpu = gpu, .s = s };
+        const a = gpu.gpa;
+        self.taps[0] = .{ .rig = rig, .k = k, .arena = .init(a) };
+        for (std.enums.values(AddForm), &self.adds) |f, *x| x.* = .{ .rig = rig, .form = f, .k = k, .arena = .init(a) };
+        for (std.enums.values(NormForm), &self.norms) |f, *x| x.* = .{ .rig = rig, .form = f, .k = k, .arena = .init(a) };
+        for ([_]bool{ true, false }, &self.blocks) |f, *x| x.* = .{ .rig = rig, .gemma = f, .k = k, .arena = .init(a) };
+        self.rings[0] = .{ .rig = rig, .k = k, .arena = .init(a) };
+        for (attn_cfgs, &self.attns) |f, *x| x.* = .{ .rig = rig, .f = f, .k = k, .arena = .init(a) };
+        self.topcs[0] = .{ .rig = rig, .k = k, .arena = .init(a) };
+        self.chains[0] = .{ .rig = rig, .k = k, .arena = .init(a) };
+    }
+
+    pub fn deinit(self: *Set) void {
+        inline for (.{ "taps", "adds", "norms", "blocks", "rings", "attns", "topcs", "chains" }) |n| for (&@field(self, n)) |*x| x.deinit();
+    }
+
+    pub fn append(self: *Set, a: std.mem.Allocator, list: *std.ArrayList(g.Kernel)) !void {
+        inline for (.{ "taps", "adds", "norms", "blocks", "rings", "attns", "topcs", "chains" }) |n| for (&@field(self, n)) |*x| try list.append(a, x.kernel());
+    }
+};
+
+/// A loaded module and its writers, registered into a kernel list; the writers point into it, so it lives on the heap.
+pub const Holder = struct {
+    gpa: std.mem.Allocator,
+    k: *ds.Dspark,
+    set: *Set,
+
+    pub fn open(gpu: @import("check.zig").Gpu, s: cuda.Stream, list: *std.ArrayList(g.Kernel)) !Holder {
+        const a = gpu.gpa;
+        const k = try a.create(ds.Dspark);
+        errdefer a.destroy(k);
+        k.* = try ds.Dspark.load(gpu.d);
+        errdefer k.unload();
+        const set = try a.create(Set);
+        errdefer a.destroy(set);
+        set.init(gpu, s, k);
+        errdefer set.deinit();
+        try set.append(a, list);
+        return .{ .gpa = a, .k = k, .set = set };
+    }
+
+    pub fn close(h: *Holder) void {
+        h.set.deinit();
+        h.k.unload();
+        h.gpa.destroy(h.set);
+        h.gpa.destroy(h.k);
+    }
+};
+
+/// tf-cuda-test mm3-dspark-bench: milliseconds a launch of the shipped shapes takes (no contract).
+pub fn bench(gpu: @import("check.zig").Gpu) !void {
+    const check = @import("check.zig");
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var k = try ds.Dspark.load(gpu.d);
+    defer k.unload();
+    var set: Set = undefined;
+    set.init(gpu, s, &k);
+    defer set.deinit();
+    const runs = 50;
+    const Item = struct { name: []const u8, shape: c.Shape };
+    inline for (.{
+        .{ "attns", 0, Item{ .name = "tf_mm3_ds_attn 7 rows, 4096 context keys", .shape = .{ .rows = 7, .n = nq, .k = 4096 } } },
+        .{ "attns", 0, Item{ .name = "tf_mm3_ds_attn 7 rows, 1000 context keys", .shape = .{ .rows = 7, .n = nq, .k = 1000 } } },
+        .{ "topcs", 0, Item{ .name = "tf_mm3_ds_topc 7 rows, n 100096, c 64", .shape = .{ .rows = 7, .n = slot_n, .k = 64 } } },
+        .{ "chains", 0, Item{ .name = "tf_mm3_ds_chain 7 rows, 2 x 64 candidates", .shape = .{ .rows = 7, .n = cand, .k = 2 } } },
+        .{ "norms", 0, Item{ .name = "tf_mm3_ds_norm_bf16 7 rows", .shape = .{ .rows = 7, .n = hidden, .k = hidden } } },
+        .{ "norms", 0, Item{ .name = "tf_mm3_ds_norm_bf16 2048 rows of 6144", .shape = .{ .rows = 2048, .n = hidden, .k = hidden } } },
+        .{ "blocks", 0, Item{ .name = "tf_mm3_ds_block_heads 7 rows", .shape = .{ .rows = 7, .n = nq, .k = 3000 } } },
+        .{ "rings", 0, Item{ .name = "tf_mm3_ds_ring_put 16 rows", .shape = .{ .rows = 16, .n = kvh, .k = 5 } } },
+        .{ "taps", 0, Item{ .name = "tf_mm3_ds_tap 64 rows", .shape = .{ .rows = 64, .n = hidden, .k = 5 } } },
+    }) |it| {
+        const w = &@field(set, it[0])[it[1]];
+        if (!try w.prepare(it[2].shape, .random, 7)) return error.RefusedShape;
+        try w.run(); // warm
+        const t0 = check.now(gpu.io);
+        for (0..runs) |_| try w.run();
+        const ms = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6 / runs;
+        std.debug.print("BENCH {s}: {d:.4} ms a launch (incl. host sync)\n", .{ it[2].name, ms });
+    }
+}
+
+/// tf-cuda-test mm3-dspark-contract: these kernels alone through gates 1 to 4.
+pub fn run(gpu: @import("check.zig").Gpu) !void {
+    const check = @import("check.zig");
+    const a = gpu.gpa;
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var k = try ds.Dspark.load(gpu.d);
+    defer k.unload();
+    var set: Set = undefined;
+    set.init(gpu, s, &k);
+    defer set.deinit();
+    var kernels: std.ArrayList(g.Kernel) = .empty;
+    defer kernels.deinit(a);
+    try set.append(a, &kernels);
+    var t: g.Tally = .{};
+    try g.runAll(a, kernels.items, 0x6d34, &t);
+    std.debug.print("SUMMARY mm3-dspark-contract {d} kernels: {d} pass gates 1-4, {d} fail, {d} known findings\n", .{ t.kernels, t.passed, t.failed, t.known });
+    try check.expect(t.failed == 0, "mm3-dspark-contract: {d} gate failures", .{t.failed});
+}
+
+test "the served shapes fit the launches" {
+    for (normSpec(.bf16_gemma).served) |s| _ = try ds.rowLaunch(s.rows);
+    for (topc_spec.served) |s| _ = try ds.topcLaunch(s.rows, s.n, s.n + pad, s.k);
+    for (attnSpec(attn_cfgs[0]).served) |s| {
+        const a: ds.Attn = .{ .nq = nq, .kvh = kvh, .ring_rows = ring_rows, .window = 1 << 20, .scale = 1 };
+        _ = try ds.attnSplit(a, @intCast(s.rows), @intCast(s.k + base_pos), base_pos);
+    }
+    for (chain_spec.served) |s| try ds.checkChain(.{ .hidden = hidden, .rank = rank, .cand = @intCast(s.n), .world = @intCast(s.k), .rows = @intCast(s.rows) });
+    try std.testing.expectEqual(@as(usize, 100_096), slot_n);
+}
diff --git a/zig/tests/cuda/contract_minimax_dspark_attn.zig b/zig/tests/cuda/contract_minimax_dspark_attn.zig
new file mode 100644
index 0000000..31513ec
--- /dev/null
+++ b/zig/tests/cuda/contract_minimax_dspark_attn.zig
@@ -0,0 +1,239 @@
+//! The dspark block attention under the contract on CUDA.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const attn = @import("contract_attn.zig");
+const common = @import("contract_minimax_dspark_common.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const rows_ = contract.rows;
+const mr = core.minimax_ref;
+const ds = cuda.minimax_m3_dspark;
+const hidden = common.hidden;
+const eps32 = common.eps32;
+const eps = common.eps;
+const rot = common.rot;
+const theta = common.theta;
+const zeroDepth = common.zeroDepth;
+const bf = common.bf;
+const isNanBf = common.isNanBf;
+const nq = common.nq;
+const kvh = common.kvh;
+
+// ---- block attention
+
+pub const ring_rows = 4112;
+pub const group = nq / kvh; // 16 q heads a kv head
+pub const base_pos = 100;
+
+pub fn keyChain(s: c.Shape) usize {
+    return s.k + 16 + 32 + 32;
+}
+
+pub const AttnCfg = struct { name: []const u8, windowed: bool };
+
+pub const attn_cfgs = [_]AttnCfg{
+    .{ .name = "cuda minimax_m3_dspark tf_mm3_ds_attn, 32 q heads over 2 kv heads, whole context", .windowed = false },
+    .{ .name = "cuda minimax_m3_dspark tf_mm3_ds_attn, 32 q heads over 2 kv heads, 300-key window", .windowed = true },
+};
+
+pub fn attnSpec(f: AttnCfg) c.Spec {
+    return .{
+        .name = f.name,
+        // the windowed rows see different keys, so gate 4's identical-key construction needs the whole-context form
+        .accum = if (f.windowed) .none else .f32,
+        .depth = keyChain,
+        .ops = 1,
+        .out = .bf16,
+        // rows, the 32 query heads, and the context keys (edges at the 128-key chunk)
+        .tiles = .{ .{}, .{}, .{ .size = 128, .min = 0 } },
+        .served = &.{ .{ .rows = 7, .n = nq, .k = 4096 }, .{ .rows = 7, .n = nq, .k = 129 }, .{ .rows = 16, .n = nq, .k = 1000 }, .{ .rows = 1, .n = nq, .k = 0 }, .{ .rows = 7, .n = nq, .k = 4111 } },
+        .sums = .{ .why = attn.why },
+    };
+}
+
+pub const Attn = struct {
+    rig: rig_.Rig,
+    f: AttnCfg,
+    k: *const ds.Dspark,
+    arena: std.heap.ArenaAllocator,
+    r: ?attn.Ref = null,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    q: []u16 = &.{},
+    ring_k: []u16 = &.{},
+    ring_v: []u16 = &.{},
+    bk: []u16 = &.{},
+    bv: []u16 = &.{},
+    p: usize = 0,
+    lo: usize = 0,
+    window: usize = 0,
+    dev: [6]u64 = @splat(0),
+
+    pub fn deinit(self: *Attn) void {
+        if (self.r) |*r| r.deinit();
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Attn) g.Kernel {
+        return .{ .spec = attnSpec(self.f), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Attn);
+
+    fn lowest(self: *const Attn, row: usize) usize {
+        const w0 = if (self.p + row + 1 > self.window) self.p + row + 1 - self.window else 0;
+        return @max(self.lo, w0);
+    }
+
+    fn kvAt(self: *Attn, which: usize, kp: usize, grp: usize) []u16 {
+        const arr = if (which == 0) self.ring_k else self.ring_v;
+        return arr[((kp % ring_rows) * kvh + grp) * 128 ..][0..128];
+    }
+
+    pub fn prepare(self: *Attn, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.n != nq or shape.rows == 0 or shape.rows > 16 or shape.k > ring_rows) return false;
+        if (self.f.windowed and fill == .stress) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        const n = shape.rows;
+        if (self.f.windowed) {
+            self.p = shape.k;
+            self.lo = 0;
+            self.window = 300;
+        } else {
+            self.p = shape.k + base_pos;
+            self.lo = base_pos;
+            self.window = 1 << 20;
+        }
+        const first = @max(self.lo, if (self.p + 1 > self.window) self.p + 1 - self.window else 0);
+        const nan = c.toBf16(std.math.nan(f32));
+        self.ring_k = try a.alloc(u16, ring_rows * kvh * 128);
+        self.ring_v = try a.alloc(u16, ring_rows * kvh * 128);
+        @memset(self.ring_k, nan);
+        @memset(self.ring_v, nan);
+        for (first..self.p) |kp| for (0..kvh) |gq| {
+            for (self.kvAt(0, kp, gq)) |*e| e.* = attn.normal(rng);
+            for (self.kvAt(1, kp, gq)) |*e| e.* = attn.normal(rng);
+        };
+        self.q = try a.alloc(u16, n * nq * 128);
+        self.bk = try a.alloc(u16, n * kvh * 128);
+        self.bv = try a.alloc(u16, n * kvh * 128);
+        for (self.q) |*e| e.* = attn.normal(rng);
+        for (self.bk) |*e| e.* = attn.normal(rng);
+        for (self.bv) |*e| e.* = attn.normal(rng);
+        if (self.r) |*r| r.deinit();
+        self.r = null;
+        self.r = try attn.Ref.init(self.rig.gpu.gpa, 128, ring_rows + 16);
+        switch (fill) {
+            .random => {},
+            .nonfinite => self.plant(first),
+            .stress => try self.stress(rng, first),
+        }
+        const bytes = [_][]const u8{ std.mem.sliceAsBytes(self.q), std.mem.sliceAsBytes(self.ring_k), std.mem.sliceAsBytes(self.ring_v), std.mem.sliceAsBytes(self.bk), std.mem.sliceAsBytes(self.bv) };
+        for (bytes, self.dev[0..5]) |b, *p| p.* = try self.rig.input(b);
+        self.dev[5] = try self.rig.output(n * nq * 128 * 2);
+        return true;
+    }
+
+    /// NaN query; +inf and -inf values; a NaN key.
+    fn plant(self: *Attn, first: usize) void {
+        const n = self.shape.rows;
+        const nan = c.toBf16(std.math.nan(f32));
+        const inf = c.toBf16(std.math.inf(f32));
+        self.q[3] = nan;
+        if (self.p > first) self.kvAt(1, self.p - 1, 0)[7] = inf;
+        self.bv[(n - 1) * kvh * 128 + 128 + 9] = c.toBf16(-std.math.inf(f32));
+        if (n > 3) self.bk[0] = nan;
+    }
+
+    /// Gate 4: every key alike (p = 1), values mirrored over the keys all rows see, which are the same for every row.
+    fn stress(self: *Attn, rng: std.Random, first: usize) !void {
+        const al = self.arena.allocator();
+        const nctx = self.p - first;
+        const nk = nctx + self.shape.rows;
+        const key0 = try al.alloc(u16, kvh * 128);
+        for (key0) |*e| e.* = attn.normal(rng);
+        for (0..kvh) |gq| {
+            for (first..self.p) |kp| @memcpy(self.kvAt(0, kp, gq), key0[gq * 128 ..][0..128]);
+            for (0..self.shape.rows) |r| @memcpy(self.bk[(r * kvh + gq) * 128 ..][0..128], key0[gq * 128 ..][0..128]);
+        }
+        const col = try al.alloc(f32, nk);
+        for (0..kvh) |gq| for (0..128) |e| {
+            small(rng, col);
+            for (col, 0..) |y, i| {
+                const cell = if (i < nctx) &self.kvAt(1, first + i, gq)[e] else &self.bv[((i - nctx) * kvh + gq) * 128 + e];
+                cell.* = c.toBf16(y);
+            }
+        };
+    }
+
+    pub fn run(self: *Attn) !void {
+        const d = self.dev;
+        const a: ds.Attn = .{ .nq = nq, .kvh = kvh, .ring_rows = ring_rows, .window = @intCast(@min(self.window, 1 << 30)), .scale = @floatCast(self.scale()) };
+        try self.k.blockAttn(self.rig.s, a, d[0], d[1], d[2], d[3], d[4], d[5], @intCast(self.shape.rows), @intCast(self.p), @intCast(self.lo));
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Attn) usize {
+        return self.shape.rows * nq * 128;
+    }
+
+    fn scale(_: *const Attn) f64 {
+        return std.math.pow(f64, 128, -0.5);
+    }
+
+    /// Output head i (row i / 32, head i % 32): its row's visible context keys, then every block key.
+    pub fn load(self: *Attn, i: usize, hd: *attn.Head) !void {
+        const row = i / nq;
+        const head = i % nq;
+        const gq = head / group;
+        for (hd.q, 0..) |*x, e| x.* = c.fromBf16(self.q[i * 128 + e]);
+        var n: usize = 0;
+        for (self.lowest(row)..self.p) |kp| {
+            for (0..128) |e| {
+                hd.k[n * 128 + e] = c.fromBf16(self.kvAt(0, kp, gq)[e]);
+                hd.v[n * 128 + e] = c.fromBf16(self.kvAt(1, kp, gq)[e]);
+            }
+            n += 1;
+        }
+        for (0..self.shape.rows) |j| {
+            for (0..128) |e| {
+                hd.k[n * 128 + e] = c.fromBf16(self.bk[(j * kvh + gq) * 128 + e]);
+                hd.v[n * 128 + e] = c.fromBf16(self.bv[(j * kvh + gq) * 128 + e]);
+            }
+            n += 1;
+        }
+        hd.n = n;
+    }
+
+    pub fn check(self: *Attn, gate: g.Gate) !?[]const u8 {
+        return self.r.?.check(self, self.count() / 128, self.scale(), try self.rig.outputBytes(), gate);
+    }
+
+    pub fn reference(self: *Attn, want: []f64, mag: []f64) !void {
+        return self.r.?.reference(self, self.count() / 128, self.scale(), want, mag);
+    }
+
+    pub fn simulate(self: *Attn, acc: c.Accum, order: g.Order, out: []f64) !void {
+        return self.r.?.simulate(self, self.count() / 128, self.scale(), acc, order, out);
+    }
+};
+
+/// Gate 4's values: odd integers, every other one times 4, the second half cancelling the first; sums stay under 2^24.
+pub fn small(rng: std.Random, out: []f32) void {
+    const h = out.len / 2;
+    for (0..h) |i| {
+        const v: f32 = @floatFromInt((1 + 2 * rng.uintLessThan(u32, 128)) * @as(u32, if (i % 2 == 1) 4 else 1));
+        out[i] = v;
+        out[h + i] = (if (i < 8) @as(f32, 1) else 0) - v;
+    }
+    if (out.len % 2 == 1) out[out.len - 1] = 0;
+}
