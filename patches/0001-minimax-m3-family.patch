+    try std.testing.expectEqual(ref.TapSource{ .r = 59, .normed = false }, ref.tapSource(.{ .tap_site = .layer_input }, 59, 60));
+}
+
+test "the sliding window: a context row outside it cannot matter, one inside it does (per_row), and block rows see each other (bidirectional)" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const d = try tinyDraft(a, 3, .{}, .{});
+    const c = d.cfg;
+    const fnorm = try rnd(fixedRandom(), a, c.hidden, 0.3);
+    const p: usize = 12; // window 6: row 0 sees positions 7 .. 11, row 3 (position 15) sees 10 .. 11
+    const feats = try features(a, 9, c, &tap_ids, fake_layers, p, fnorm);
+    const base = try ref.blockForward(&d, a, &(try ref.buildCtx(&d, a, feats, 0, p)), 2, p);
+    const row = c.n_taps * c.hidden;
+    const old = try a.dupe(f64, feats);
+    for (old[3 * row ..][0..row]) |*v| v.* += 1.0; // position 3: outside every row's window
+    const same = try ref.blockForward(&d, a, &(try ref.buildCtx(&d, a, old, 0, p)), 2, p);
+    try std.testing.expectEqualSlices(f64, base.post, same.post);
+    const near = try a.dupe(f64, feats);
+    for (near[9 * row ..][0..row]) |*v| v.* += 1.0; // position 9: row 0 sees it (15 - ... 12 - 9 < 6)
+    const moved = try ref.blockForward(&d, a, &(try ref.buildCtx(&d, a, near, 0, p)), 2, p);
+    try std.testing.expect(maxDiff(base.post[0..c.hidden], moved.post[0..c.hidden]) > 1e-6);
+    // position 7 is inside row 0's window (12 - 7 = 5 < 6) but outside row 3's (15 - 7 = 8 >= 6)
+    const edge = try a.dupe(f64, feats);
+    for (edge[7 * row ..][0..row]) |*v| v.* += 1.0;
+    const e = try ref.blockForward(&d, a, &(try ref.buildCtx(&d, a, edge, 0, p)), 2, p);
+    try std.testing.expect(maxDiff(base.post[0..c.hidden], e.post[0..c.hidden]) > 1e-6);
+}
+
+test "causal block attention: a later block row cannot change an earlier one; bidirectional lets it" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]ref.BlockAttention{ .causal, .bidirectional }) |mode| {
+        var d = try tinyDraft(a, 4, .{}, .{ .block_attention = mode });
+        const c = d.cfg;
+        const fnorm = try rnd(fixedRandom(), a, c.hidden, 0.3);
+        const feats = try features(a, 9, c, &tap_ids, fake_layers, 8, fnorm);
+        const cx = try ref.buildCtx(&d, a, feats, 0, 8);
+        const one = try ref.blockForward(&d, a, &cx, 2, 8);
+        // rows 1.. start from the mask token's embedding: moving it moves row 0 only if the rows see each other
+        const e = @constCast(d.embed);
+        for (e[c.mask_token * c.hidden ..][0..c.hidden]) |*v| v.* += 0.5;
+        const two = try ref.blockForward(&d, a, &cx, 2, 8);
+        // row 0 (the anchor) reads rows 1.. only if the block is bidirectional
+        const moved = maxDiff(one.post[0..c.hidden], two.post[0..c.hidden]) > 1e-6;
+        try std.testing.expectEqual(mode == .bidirectional, moved);
+    }
+}
+
+test "contextKv: layer K is normed and rotated at the token's position, V is the plain projection" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const d = try tinyDraft(a, 8, .{}, .{});
+    const c = d.cfg;
+    const st = try rnd(fixedRandom(), a, c.hidden, 1.0);
+    const k = try a.alloc(f64, c.kvw());
+    const v = try a.alloc(f64, c.kvw());
+    try ref.contextKv(&d, a, 1, st, 7, k, v);
+    const want_v = try a.alloc(f64, c.kvw());
+    d.layers[1].v.apply(st, want_v);
+    try std.testing.expectEqualSlices(f64, want_v, v);
+    const want_k = try a.alloc(f64, c.kvw());
+    d.layers[1].k.apply(st, want_k);
+    for (0..c.n_kv) |g| {
+        const h = want_k[g * c.head_dim ..][0..c.head_dim];
+        var t: [16]f64 = undefined;
+        mr.gemmaNorm(h, d.layers[1].k_norm, c.eps, true, &t);
+        @memcpy(h, &t);
+        mr.rope(h, c.rot_dim, 7, c.rope_theta, .neox_half);
+    }
+    try std.testing.expect(maxDiff(want_k, k) < 1e-12);
+}
+
+// ---- the engine-layout twins and their mutants --------------------------------------------------------------------
+
+fn ringRun(a: std.mem.Allocator, sw: ref.Switches, cap_extra: usize, m: twin.RingMutant) !f64 {
+    const d = try tinyDraft(a, 31, .{}, sw);
+    const c = d.cfg;
+    const fnorm = try rnd(fixedRandom(), a, c.hidden, 0.3);
+    const total: usize = 16;
+    const feats = try features(a, 41, c, &tap_ids, fake_layers, total, fnorm);
+    const row = c.n_taps * c.hidden;
+    var ring = try twin.Ring.init(a, &d, c.window + cap_extra, m);
+    var worst: f64 = 0;
+    var next: usize = 0;
+    for ([_]usize{ 3, 7, 8, 13, 16 }) |p| { // pending positions: a step absorbs the kept rows, then drafts
+        while (next < p) : (next += 1) try ring.absorb(a, feats[next * row ..][0..row], next + 1 == p);
+        const cx_ref = try ref.buildCtx(&d, a, feats, 0, p);
+        const want = try ref.blockForward(&d, a, &cx_ref, 4, p);
+        const cx = try ring.ctx(a);
+        const got = try ref.blockForward(&d, a, &cx, 4, p);
+        worst = @max(worst, maxDiff(want.pre, got.pre));
+        worst = @max(worst, maxDiff(want.post, got.post));
+    }
+    return worst;
+}
+
+test "ring twin: the incremental K/V ring equals recomputing the context from features, at the window and with slack" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]ref.WindowRule{ .per_row, .context_tail }) |rule| {
+        // a ring of window + 4 (the engine keeps window + window_rows) and one of exactly the window match bit for bit
+        try std.testing.expectEqual(@as(f64, 0), try ringRun(a, .{ .window_rule = rule }, 4, .none));
+        try std.testing.expectEqual(@as(f64, 0), try ringRun(a, .{ .window_rule = rule }, 0, .none));
+    }
+}
+
+test "ring twin mutants: each planted fault is caught" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]ref.WindowRule{ .per_row, .context_tail }) |rule| {
+        for ([_]twin.RingMutant{ .short_ring, .rope_at_slot, .stale_slot, .drop_last_absorb }) |m| {
+            const worst = try ringRun(a, .{ .window_rule = rule }, 4, m);
+            if (worst <= 1e-6) {
+                std.debug.print("ring mutant {t} under {t} slipped through ({e})\n", .{ m, rule, worst });
+                return error.MutantSurvived;
+            }
+        }
+    }
+}
+
+fn tpRun(a: std.mem.Allocator, sw: ref.Switches, world: usize, m: twin.TpMutant) !f64 {
+    const d = try tinyDraft(a, 51, .{}, sw);
+    const c = d.cfg;
+    const fnorm = try rnd(fixedRandom(), a, c.hidden, 0.3);
+    const p: usize = 9;
+    const feats = try features(a, 61, c, &tap_ids, fake_layers, p, fnorm);
+    const cx = try ref.buildCtx(&d, a, feats, 0, p);
+    const want = try ref.blockForward(&d, a, &cx, 3, p);
+    const got = try twin.blockForwardTp(&d, a, &cx, 3, p, world, m);
+    return @max(maxDiff(want.pre, got.pre), maxDiff(want.post, got.post));
+}
+
+test "tp twin: one rank and two ranks (heads, kv groups, FFN rows cut; partial sums added in rank order) equal the reference" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]usize{ 1, 2 }) |world| {
+        try std.testing.expect(try tpRun(a, .{}, world, .none) < 1e-10);
+        try std.testing.expect(try tpRun(a, .{ .block_attention = .causal, .window_rule = .context_tail }, world, .none) < 1e-10);
+        try std.testing.expect(try tpRun(a, .{ .base = .{ .bf16_proj_out = true, .bf16_act_out = true } }, world, .none) < 1e-2);
+    }
+}
+
+test "tp twin mutants: each planted fault is caught" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]twin.TpMutant{ .drop_last_head, .swap_kv_groups, .ffn_overlap, .drop_exchange }) |m| {
+        const worst = try tpRun(a, .{}, 2, m);
+        if (worst <= 1e-6) {
+            std.debug.print("tp mutant {t} slipped through ({e})\n", .{ m, worst });
+            return error.MutantSurvived;
+        }
+    }
+}
+
+// ---- the Markov chain, the confidence head, the per-rank gather ---------------------------------------------------
+
+/// A draft over 8 tokens whose Markov head forces the chain prev -> sigma(prev), for hand-checkable drafts.
+fn chainDraft(a: std.mem.Allocator, sw: ref.Switches) !ref.Draft {
+    var d = try tinyDraft(a, 77, .{ .vocab = 8, .rank = 8, .markov_scale = 0 }, sw);
+    const sigma = [_]usize{ 3, 5, 0, 7, 1, 2, 6, 4 };
+    const w1 = try a.alloc(f64, 64);
+    const w2 = try a.alloc(f64, 64);
+    @memset(w1, 0);
+    @memset(w2, 0);
+    for (0..8) |prev| {
+        w1[prev * 8 + prev] = 1000; // bias(prev, id) = 1000 * w2[id][prev]
+        w2[sigma[prev] * 8 + prev] = 1; // ... which is 1000 for id = sigma(prev)
+    }
+    d.markov_w1 = w1;
+    d.markov_w2 = w2;
+    return d;
+}
+
+fn chainOf(a: std.mem.Allocator, d: *const ref.Draft, anchor: usize) ![]usize {
+    const c = d.cfg;
+    const fnorm = try rnd(fixedRandom(), a, c.hidden, 0.3);
+    const feats = try features(a, 81, c, &tap_ids, fake_layers, 5, fnorm);
+    const cx = try ref.buildCtx(d, a, feats, 0, 5);
+    const b = try ref.blockForward(d, a, &cx, anchor, 5);
+    const drafts = try a.alloc(usize, ref.draftCount(c.sw, c.block));
+    const conf = try a.alloc(f64, drafts.len);
+    try ref.chain(d, a, b, anchor, drafts, conf);
+    return drafts;
+}
+
+test "chain: a Markov head that forces prev -> sigma(prev) is followed from the anchor, whatever the base logits say" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const sigma = [_]usize{ 3, 5, 0, 7, 1, 2, 6, 4 };
+    const d = try chainDraft(a, .{});
+    for ([_]usize{ 0, 4, 6 }) |anchor| {
+        const got = try chainOf(a, &d, anchor);
+        var prev = anchor;
+        for (got) |t| {
+            try std.testing.expectEqual(sigma[prev], t);
+            prev = t;
+        }
+    }
+    // swapped tables: the bias is 1000 * w1[id][prev-th w2 column], which does not follow sigma
+    const swapped = try chainDraft(a, .{ .markov_swap = true });
+    const got = try chainOf(a, &swapped, 0);
+    var prev: usize = 0;
+    var follows = true;
+    for (got) |t| {
+        follows = follows and t == sigma[prev];
+        prev = t;
+    }
+    try std.testing.expect(!follows);
+    // no previous token for the first draft: it is the base argmax; the rest follow sigma
+    const none = try chainDraft(a, .{ .first_prev = .none });
+    const g = try chainOf(a, &none, 0);
+    try std.testing.expectEqual(sigma[g[0]], g[1]);
+    try std.testing.expectEqual(sigma[g[1]], g[2]);
+    // DFlash's rows: one draft fewer
+    const rows = try chainDraft(a, .{ .draft_rows = .rows_after_anchor });
+    try std.testing.expectEqual(@as(usize, 3), (try chainOf(a, &rows, 0)).len);
+}
+
+test "chain: candidates = the whole vocabulary equals the full vocabulary; a small candidate list stays inside the base top" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const full = try tinyDraft(a, 90, .{ .markov_scale = 2.0 }, .{});
+    var wide = try tinyDraft(a, 90, .{ .markov_scale = 2.0 }, .{ .markov_domain = .candidates });
+    wide.cfg.candidates = wide.cfg.vocab;
+    try std.testing.expectEqualSlices(usize, try chainOf(a, &full, 3), try chainOf(a, &wide, 3));
+    var narrow = try tinyDraft(a, 90, .{ .markov_scale = 2.0 }, .{ .markov_domain = .candidates });
+    narrow.cfg.candidates = 1;
+    var plain = try tinyDraft(a, 90, .{ .markov_scale = 0 }, .{});
+    // one candidate: every draft is its row's base argmax, which a zero Markov table also gives
+    try std.testing.expectEqualSlices(usize, try chainOf(a, &plain, 3), try chainOf(a, &narrow, 3));
+}
+
+test "confidence: sigmoid(w . [h ; markov_w1[prev]] + b), the logit when asked, no Markov part without a previous token" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var d = try tinyDraft(a, 5, .{}, .{ .aux_bf16 = false });
+    const c = d.cfg;
+    const z = try a.alloc(f64, c.hidden);
+    @memset(z, 0);
+    const w = try a.alloc(f64, c.hidden + c.rank);
+    @memset(w, 0);
+    d.conf_w = w;
+    d.conf_b = 0.75;
+    try std.testing.expectApproxEqAbs(mr.sigmoid(0.75), try ref.confidence(&d, a, z, z, 7), 1e-15);
+    // h = e0, w[0] = 2; markov part: w1[3] . w[hidden..]
+    z[0] = 1;
+    w[0] = 2;
+    for (w[c.hidden..], 0..) |*x, i| x.* = @floatFromInt(i + 1);
+    var want: f64 = 0.75 + 2.0;
+    try std.testing.expectApproxEqAbs(mr.sigmoid(want), try ref.confidence(&d, a, z, z, null), 1e-15);
+    for (d.markov_w1[3 * c.rank ..][0..c.rank], 0..) |x, i| want += x * @as(f64, @floatFromInt(i + 1));
+    try std.testing.expectApproxEqAbs(mr.sigmoid(want), try ref.confidence(&d, a, z, z, 3), 1e-12);
+    d.cfg.sw.conf_sigmoid = false;
+    try std.testing.expectApproxEqAbs(want, try ref.confidence(&d, a, z, z, 3), 1e-12);
+}
+
+test "confidence gate: the running product cuts earlier than each alone; the first `least` drafts always stay" {
+    const conf = [_]f64{ 0.9, 0.9, 0.9, 0.9 };
+    try std.testing.expectEqual(@as(usize, 3), ref.gateLen(.{}, &conf, 0.7, 0));
+    try std.testing.expectEqual(@as(usize, 4), ref.gateLen(.{ .conf_gate = .each }, &conf, 0.7, 0));
+    const cliff = [_]f64{ 0.9, 0.9, 0.5, 0.99 };
+    try std.testing.expectEqual(@as(usize, 2), ref.gateLen(.{}, &cliff, 0.6, 0));
+    try std.testing.expectEqual(@as(usize, 2), ref.gateLen(.{ .conf_gate = .each }, &cliff, 0.6, 0));
+    try std.testing.expectEqual(@as(usize, 2), ref.gateLen(.{}, &cliff, 0.85, 2));
+    try std.testing.expectEqual(@as(usize, 1), ref.gateLen(.{}, &cliff, 0.85, 0));
+}
+
+test "gather twin: per-rank candidate lists agree with the full argmax; planted mutants are caught" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const d = try tinyDraft(a, 123, .{ .vocab = 24, .rank = 4, .markov_scale = 1.0 }, .{});
+    var base: [24]f64 = undefined;
+    for (&base, 0..) |*b, i| b.* = @as(f64, @floatFromInt((i * 7) % 24)) * 0.1; // distinct
+    // make the true winner (base + bias) live in the last rank's slice and keep it inside its top 3
+    const prev: usize = 2;
+    var winner: usize = 12;
+    var bz: f64 = -1e9;
+    for (0..24) |id| {
+        const z = base[id] + ref.markovBias(&d, prev, id);
+        if (z > bz) {
+            bz = z;
+            winner = id;
+        }
+    }
+    // clean: with per = the slice, the gather is the whole vocabulary
+    try std.testing.expectEqual(winner, try twin.gatherPick(&d, &base, prev, 2, 12, .none, a));
+    // ... and the engine's narrow lists agree whenever the winner is in them: widen the winner's base so it is
+    var boosted = base;
+    boosted[winner] += 5;
+    var best: usize = 0;
+    var bb: f64 = -1e9;
+    for (0..24) |id| {
+        const z = boosted[id] + ref.markovBias(&d, prev, id);
+        if (z > bb) {
+            bb = z;
+            best = id;
+        }
+    }
+    try std.testing.expectEqual(best, try twin.gatherPick(&d, &boosted, prev, 2, 3, .none, a));
+    // mutants: dropping the last rank loses a winner living there; unshifted ids move the pick; a tie shows the rule
+    try std.testing.expect(best != try twin.gatherPick(&d, &boosted, prev, 2, 3, .ids_not_offset, a) or best < 12);
+    if (best >= 12) try std.testing.expect(best != try twin.gatherPick(&d, &boosted, prev, 2, 3, .drop_last_rank, a));
+    // an exact tie in z between a higher-base id listed first and a lower id: the lower id must win
+    var tie: [24]f64 = @splat(-100);
+    const hi_id: usize = 5;
+    const lo_id: usize = 2;
+    const bias_hi = ref.markovBias(&d, prev, hi_id);
+    const bias_lo = ref.markovBias(&d, prev, lo_id);
+    tie[hi_id] = 50 + (bias_lo - bias_hi) * 0 + 1; // z_hi = 51 + bias_hi
+    tie[lo_id] = tie[hi_id] + bias_hi - bias_lo; // z_lo = z_hi exactly (same sum, up to rounding)
+    const zhi = tie[hi_id] + bias_hi;
+    const zlo = tie[lo_id] + bias_lo;
+    if (zhi == zlo) {
+        try std.testing.expectEqual(lo_id, try twin.gatherPick(&d, &tie, prev, 2, 3, .none, a));
+        if (tie[hi_id] > tie[lo_id]) try std.testing.expectEqual(hi_id, try twin.gatherPick(&d, &tie, prev, 2, 3, .first_lowest, a));
+    }
+}
diff --git a/zig/src/families/minimax_m3/dspark_names.zig b/zig/src/families/minimax_m3/dspark_names.zig
new file mode 100644
index 0000000..7ca6813
--- /dev/null
+++ b/zig/src/families/minimax_m3/dspark_names.zig
@@ -0,0 +1,193 @@
+//! The draft's tensor names (VERIFIED from the pack's header): `language_model.model.dspark.` and its layers.
+const std = @import("std");
+// It has no embedding or head tensor: it must use the target's (UNVERIFIED).
+const names = @import("names.zig");
+
+pub const root = "language_model.model.dspark.";
+pub const Buf = names.Buf;
+pub const Cut = names.Cut;
+
+/// The seven linear layers of a draft layer: float8 codes `weight` [n, k] and a ue8m0 `weight_scale_inv` [n, k / 32].
+pub const Lin = enum {
+    q,
+    k,
+    v,
+    o,
+    gate,
+    up,
+    down,
+
+    fn tail(p: Lin) []const u8 {
+        return switch (p) {
+            .q => "self_attn.q_proj",
+            .k => "self_attn.k_proj",
+            .v => "self_attn.v_proj",
+            .o => "self_attn.o_proj",
+            .gate => "mlp.gate_proj",
+            .up => "mlp.up_proj",
+            .down => "mlp.down_proj",
+        };
+    }
+
+    /// The axis a tensor-parallel rank cuts, as the target's matrices are: o and down cut input rows (partial sums).
+    pub fn cut(p: Lin) Cut {
+        return switch (p) {
+            .o, .down => .row,
+            else => .col,
+        };
+    }
+};
+
+pub const Part = enum {
+    weight,
+    weight_scale_inv,
+
+    fn tail(p: Part) []const u8 {
+        return @tagName(p);
+    }
+};
+
+/// Tensors stored as bf16: the quantization_config ignores fc, the Markov tables and the confidence projection.
+pub const Plain = enum {
+    fc, // [hidden, taps x hidden]
+    hidden_norm, // [hidden]
+    final_norm, // [hidden]
+    markov_w1, // [vocab, rank]
+    markov_w2, // [vocab, rank]
+    conf_w, // [1, hidden + rank]
+    conf_b, // [1]
+    input_ln, // layer: [hidden]
+    post_ln,
+    q_norm, // layer: [head_dim]
+    k_norm,
+
+    pub fn isLayer(p: Plain) bool {
+        return switch (p) {
+            .input_ln, .post_ln, .q_norm, .k_norm => true,
+            else => false,
+        };
+    }
+
+    /// RMS norm weights (what a Gemma-style offset could apply to).
+    pub fn isNorm(p: Plain) bool {
+        return p.isLayer() or p == .hidden_norm or p == .final_norm;
+    }
+
+    fn tail(p: Plain) []const u8 {
+        return switch (p) {
+            .fc => "fc.weight",
+            .hidden_norm => "hidden_norm.weight",
+            .final_norm => "final_norm.weight",
+            .markov_w1 => "markov_head.markov_w1.weight",
+            .markov_w2 => "markov_head.markov_w2.weight",
+            .conf_w => "confidence_head.proj.weight",
+            .conf_b => "confidence_head.proj.bias",
+            .input_ln => "input_layernorm.weight",
+            .post_ln => "post_attention_layernorm.weight",
+            .q_norm => "self_attn.q_norm.weight",
+            .k_norm => "self_attn.k_norm.weight",
+        };
+    }
+};
+
+const layer_mid = "layers.{d}.decoder_layer.";
+
+pub fn lin(buf: *Buf, p: Lin, layer: u32, part: Part) []const u8 {
+    return std.fmt.bufPrint(buf, root ++ layer_mid ++ "{s}.{s}", .{ layer, p.tail(), part.tail() }) catch unreachable;
+}
+
+pub fn plain(buf: *Buf, p: Plain, layer: u32) []const u8 {
+    const r = if (p.isLayer()) std.fmt.bufPrint(buf, root ++ layer_mid ++ "{s}", .{ layer, p.tail() }) else std.fmt.bufPrint(buf, root ++ "{s}", .{p.tail()});
+    return r catch unreachable;
+}
+
+/// A tensor name taken apart.
+pub const Name = struct {
+    layer: u32 = 0,
+    what: union(enum) { plain: Plain, lin: struct { proj: Lin, part: Part } },
+};
+
+fn number(s: *[]const u8) ?u32 {
+    const end = std.mem.indexOfScalar(u8, s.*, '.') orelse return null;
+    if (end == 0 or end > 3 or (end > 1 and s.*[0] == '0')) return null; // one spelling per index
+    const n = std.fmt.parseInt(u32, s.*[0..end], 10) catch return null;
+    s.* = s.*[end + 1 ..];
+    return n;
+}
+
+/// The role of a checkpoint tensor name, or null for a name this family does not know.
+pub fn parse(name: []const u8) ?Name {
+    if (!std.mem.startsWith(u8, name, root)) return null;
+    var rest = name[root.len..];
+    for (std.enums.values(Plain)) |p| {
+        if (!p.isLayer() and std.mem.eql(u8, rest, p.tail())) return .{ .what = .{ .plain = p } };
+    }
+    const lead = "layers.";
+    if (!std.mem.startsWith(u8, rest, lead)) return null;
+    rest = rest[lead.len..];
+    var out: Name = .{ .what = undefined };
+    out.layer = number(&rest) orelse return null;
+    const mid = "decoder_layer.";
+    if (!std.mem.startsWith(u8, rest, mid)) return null;
+    rest = rest[mid.len..];
+    for (std.enums.values(Plain)) |p| {
+        if (p.isLayer() and std.mem.eql(u8, rest, p.tail())) {
+            out.what = .{ .plain = p };
+            return out;
+        }
+    }
+    for (std.enums.values(Lin)) |p| {
+        const t = p.tail();
+        if (rest.len > t.len + 1 and std.mem.startsWith(u8, rest, t) and rest[t.len] == '.') {
+            const part = std.meta.stringToEnum(Part, rest[t.len + 1 ..]) orelse return null;
+            out.what = .{ .lin = .{ .proj = p, .part = part } };
+            return out;
+        }
+    }
+    return null;
+}
+
+test "names round-trip through parse for every role" {
+    var b1: Buf = undefined;
+    for (std.enums.values(Plain)) |p| {
+        const n = parse(plain(&b1, p, 4)).?;
+        try std.testing.expectEqual(p, n.what.plain);
+        try std.testing.expectEqual(@as(u32, if (p.isLayer()) 4 else 0), n.layer);
+    }
+    for (std.enums.values(Lin)) |p| for (std.enums.values(Part)) |w| {
+        const n = parse(lin(&b1, p, 3, w)).?;
+        try std.testing.expectEqual(p, n.what.lin.proj);
+        try std.testing.expectEqual(w, n.what.lin.part);
+        try std.testing.expectEqual(@as(u32, 3), n.layer);
+    };
+}
+
+test "the checkpoint's spellings" {
+    var b: Buf = undefined;
+    try std.testing.expectEqualStrings("language_model.model.dspark.layers.2.decoder_layer.mlp.down_proj.weight_scale_inv", lin(&b, .down, 2, .weight_scale_inv));
+    try std.testing.expectEqualStrings("language_model.model.dspark.layers.0.decoder_layer.self_attn.q_norm.weight", plain(&b, .q_norm, 0));
+    try std.testing.expectEqualStrings("language_model.model.dspark.markov_head.markov_w2.weight", plain(&b, .markov_w2, 9));
+    try std.testing.expectEqualStrings("language_model.model.dspark.confidence_head.proj.bias", plain(&b, .conf_b, 9));
+    try std.testing.expectEqualStrings("language_model.model.dspark.fc.weight", plain(&b, .fc, 9));
+}
+
+test "unknown, misspelled and non-canonical names are not roles" {
+    for ([_][]const u8{
+        "language_model.model.layers.3.self_attn.q_proj.weight", // the target's namespace
+        "language_model.model.dspark.layers.03.decoder_layer.mlp.up_proj.weight",
+        "language_model.model.dspark.layers.0.decoder_layer.mlp.up_proj.bias",
+        "language_model.model.dspark.layers.0.decoder_layer.mlp.up_proj.weight_scale",
+        "language_model.model.dspark.layers.0.decoder_layer.self_attn.index_q_proj.weight",
+        "language_model.model.dspark.layers.0.input_layernorm.weight", // no decoder_layer
+        "language_model.model.dspark.embed_tokens.weight", // the draft carries no embedding
+        "language_model.model.dspark.lm_head.weight", // and no head
+        "language_model.model.dspark.markov_head.embed.weight", // DeepSeek's spelling, not this pack's
+        "language_model.model.dspark.layers.0.decoder_layer.",
+    }) |bad| try std.testing.expect(parse(bad) == null);
+}
+
+test "o and down cut input rows, everything else output columns" {
+    for (std.enums.values(Lin)) |p| {
+        try std.testing.expectEqual(if (p == .o or p == .down) Cut.row else Cut.col, p.cut());
+    }
+}
diff --git a/zig/src/families/minimax_m3/dspark_ref.zig b/zig/src/families/minimax_m3/dspark_ref.zig
new file mode 100644
index 0000000..424ddf0
--- /dev/null
+++ b/zig/src/families/minimax_m3/dspark_ref.zig
@@ -0,0 +1,539 @@
+//! The dspark draft on the CPU in float64: mxfp8 decode, taps, context state, a draft block, Markov chain, confidence.
+const std = @import("std");
+// The upstream modeling code was unavailable: every semantic not forced by a shape is a `Switches` field, UNVERIFIED.
+const core = @import("core");
+// Defaults follow what TensorFold ships (deepseek_v41 DSpark chain, qwen3_5 DFlash2 taps, fc and K/V ring).
+const mr = core.minimax_ref;
+
+// ---- mxfp8 ------------------------------------------------------------------------------------------------------
+
+/// float8 e4m3 (OCP "FN" form, bias 7, no infinities): 0x7F and 0xFF are NaN, exponent 0 is subnormal (m / 8 * 2^-6).
+pub fn e4m3(code: u8) f64 {
+    const sign: f64 = if (code & 0x80 != 0) -1 else 1;
+    const e: i32 = (code >> 3) & 0xF;
+    const m: f64 = @floatFromInt(code & 7);
+    if (e == 0xF and (code & 7) == 7) return std.math.nan(f64);
+    if (e == 0) return sign * m * 0x1p-9;
+    return sign * (1 + m / 8) * std.math.ldexp(@as(f64, 1), e - 7);
+}
+
+/// A ue8m0 scale byte: 2^(byte - bias), 255 is NaN. UNVERIFIED bias 127 (k_proj bytes sit at 114-118).
+pub fn ue8m0(b: u8, bias: i32) f64 {
+    if (b == 255) return std.math.nan(f64);
+    return std.math.ldexp(@as(f64, 1), @as(i32, b) - bias);
+}
+
+/// w[j][i] = e4m3(codes[j][i]) * ue8m0(scales[j][i / block]) for a [n, k] matrix.
+pub fn dequant(codes: []const u8, scales: []const u8, n: usize, k: usize, block: usize, bias: i32, out: []f64) void {
+    for (0..n) |j| for (0..k) |i| {
+        out[j * k + i] = e4m3(codes[j * k + i]) * ue8m0(scales[j * (k / block) + i / block], bias);
+    };
+}
+
+// ---- switches ---------------------------------------------------------------------------------------------------
+
+/// UNVERIFIED: which residual a tap of layer `id` reads: its output (HF hidden_states[id + 1]) or its input.
+pub const TapSite = enum { layer_output, layer_input };
+/// UNVERIFIED: fc's input is the taps side by side in config order; reversed is the planted alternative.
+pub const ConcatOrder = enum { listed, reversed };
+/// UNVERIFIED: sliding_window: per_row (seen iff rp - kp < window) or context_tail (the last `window` context rows).
+pub const WindowRule = enum { per_row, context_tail };
+/// UNVERIFIED: rows of the draft block see each other (DFlash/DSpark blocks are parallel) or only earlier rows.
+pub const BlockAttention = enum { bidirectional, causal };
+/// UNVERIFIED: block row i sits at position P + i (P: the pending token's), or every row at P.
+pub const BlockPositions = enum { consecutive, all_pending };
+/// UNVERIFIED: next_token_all_rows (row i gives the token at P + 1 + i, `block` drafts) or rows 1.. (DFlash).
+pub const DraftRows = enum { next_token_all_rows, rows_after_anchor };
+/// UNVERIFIED: the Markov bias is added over the whole vocabulary or only to the top `candidates` of the base logits.
+pub const MarkovDomain = enum { full_vocab, candidates };
+/// UNVERIFIED: the first draft's previous token is the anchor (pending token) or none (no bias, zero embedding).
+pub const FirstPrev = enum { anchor, none };
+/// UNVERIFIED: the confidence head reads the block's hidden row after final_norm or before it.
+pub const ConfInput = enum { post_final_norm, pre_final_norm };
+/// UNVERIFIED: how per-draft confidences cut a block: the running product, or each one alone.
+pub const ConfGate = enum { product, each };
+
+pub const Switches = struct {
+    /// Target-side switches the draft shares (rope layout, swigluoai, Gemma offsets, bf16 points): mr.Switches.
+    base: mr.Switches = .{},
+    tap_site: TapSite = .layer_output,
+    /// UNVERIFIED: the tap of the last layer is read after the model's final norm (HF's last hidden_states entry is).
+    last_tap_post_norm: bool = false,
+    /// UNVERIFIED: the taps reach fc as bf16 (the engine would store them so).
+    tap_bf16: bool = true,
+    concat_order: ConcatOrder = .listed,
+    /// UNVERIFIED: hidden_norm and final_norm use 1 + w (hidden_norm's mean is 0.05, final_norm's 0.41).
+    gemma_hidden_norm: bool = true,
+    gemma_final_norm: bool = true,
+    /// UNVERIFIED: the context state passes each layer's input_layernorm before that layer's k_proj and v_proj.
+    ctx_input_norm: bool = false,
+    window_rule: WindowRule = .per_row,
+    block_attention: BlockAttention = .bidirectional,
+    block_positions: BlockPositions = .consecutive,
+    draft_rows: DraftRows = .next_token_all_rows,
+    markov_domain: MarkovDomain = .full_vocab,
+    /// UNVERIFIED: bias(prev, id) = markov_w2[id] . markov_w1[prev]; true swaps the two tables.
+    markov_swap: bool = false,
+    first_prev: FirstPrev = .anchor,
+    conf_input: ConfInput = .post_final_norm,
+    /// UNVERIFIED: the confidence is sigmoid(w . [h ; markov_w1[prev]] + b); false returns the logit.
+    conf_sigmoid: bool = true,
+    conf_gate: ConfGate = .product,
+    /// UNVERIFIED: the auxiliary GEMMs (head logits, Markov, confidence) take bf16 inputs (dspark_aux_gemm_precision).
+    aux_bf16: bool = true,
+    /// UNVERIFIED: ue8m0 exponent bias.
+    scale_bias: i32 = 127,
+};
+
+/// The draft's draft count and the row giving draft i under the switch.
+pub fn draftCount(sw: Switches, block: usize) usize {
+    return switch (sw.draft_rows) {
+        .next_token_all_rows => block,
+        .rows_after_anchor => block - 1,
+    };
+}
+
+pub fn rowFor(sw: Switches, i: usize) usize {
+    return switch (sw.draft_rows) {
+        .next_token_all_rows => i,
+        .rows_after_anchor => i + 1,
+    };
+}
+
+pub const Config = struct {
+    hidden: usize = 6144,
+    n_q: usize = 64,
+    n_kv: usize = 4,
+    head_dim: usize = 128,
+    rot_dim: usize = 64,
+    rope_theta: f64 = 1e7,
+    eps: f64 = 1e-6,
+    ffn: usize = 12288,
+    layers: usize = 5,
+    n_taps: usize = 5,
+    window: usize = 4096,
+    block: usize = 7,
+    mask_token: usize = 200058,
+    rank: usize = 256,
+    vocab: usize = 200064,
+    candidates: usize = 64,
+    alpha: f64 = 1.702,
+    limit: f64 = 7.0,
+    sw: Switches = .{},
+
+    pub fn rep(c: Config) usize {
+        return c.n_q / c.n_kv;
+    }
+    pub fn kvw(c: Config) usize {
+        return c.n_kv * c.head_dim;
+    }
+};
+
+/// y = W x for W stored [n][k] row-major, the checkpoint's layout (the target's ref.Linear is [k][n]).
+pub const Dense = struct {
+    n: usize,
+    k: usize,
+    w: []const f64,
+
+    pub fn apply(d: Dense, x: []const f64, out: []f64) void {
+        d.applyRows(0, d.n, x, out);
+    }
+
+    /// Output rows [lo, hi) only.
+    pub fn applyRows(d: Dense, lo: usize, hi: usize, x: []const f64, out: []f64) void {
+        for (lo..hi) |j| {
+            var s: f64 = 0;
+            for (x[0..d.k], d.w[j * d.k ..][0..d.k]) |a, b| s += a * b;
+            out[j - lo] = s;
+        }
+    }
+
+    /// Inputs [lo, lo + x.len) only, all output rows: the partial sum of a row-cut layer.
+    pub fn applyCols(d: Dense, lo: usize, x: []const f64, out: []f64) void {
+        for (0..d.n) |j| {
+            var s: f64 = 0;
+            for (x, d.w[j * d.k + lo ..][0..x.len]) |a, b| s += a * b;
+            out[j] = s;
+        }
+    }
+};
+
+pub const Layer = struct {
+    input_norm: []const f64,
+    post_norm: []const f64,
+    q_norm: []const f64,
+    k_norm: []const f64,
+    q: Dense,
+    k: Dense,
+    v: Dense,
+    o: Dense,
+    gate: Dense,
+    up: Dense,
+    down: Dense,
+};
+
+pub const Draft = struct {
+    cfg: Config,
+    fc: Dense, // [hidden, n_taps x hidden]
+    hidden_norm: []const f64,
+    final_norm: []const f64,
+    layers: []const Layer,
+    markov_w1: []const f64, // [vocab][rank]
+    markov_w2: []const f64,
+    conf_w: []const f64, // [hidden + rank]
+    conf_b: f64,
+    /// The TARGET's embedding [vocab][hidden] and lm_head [vocab, hidden]: the draft has neither (UNVERIFIED reuse).
+    embed: []const f64,
+    head: Dense,
+};
+
+// ---- small pieces -----------------------------------------------------------------------------------------------
+
+pub fn norm(c: Config, x: []const f64, w: []const f64, gemma: bool, out: []f64) void {
+    mr.gemmaNorm(x, w, c.eps, gemma, out);
+    mr.roundAll(c.sw.base.bf16_norm_out, out);
+}
+
+/// Per-head norm then RoPE at `pos` (null: none) over `n` heads of x.
+pub fn heads(c: Config, x: []f64, n: usize, w: []const f64, pos: ?usize) void {
+    const d = c.head_dim;
+    var t: [256]f64 = undefined;
+    for (0..n) |h| {
+        const s = x[h * d ..][0..d];
+        norm(c, s, w, c.sw.base.gemma_qk_norms, t[0..d]);
+        @memcpy(s, t[0..d]);
+        if (pos) |p| mr.rope(s, c.rot_dim, p, c.rope_theta, c.sw.base.rope_layout);
+        mr.roundAll(c.sw.base.bf16_rope_out, s);
+    }
+}
+
+/// A target residual a tap reads: index r (0 = embeddings, r = output of layer r - 1), and whether final norm applies.
+pub const TapSource = struct { r: usize, normed: bool };
+
+pub fn tapSource(sw: Switches, id: usize, target_layers: usize) TapSource {
+    const r = switch (sw.tap_site) {
+        .layer_output => id + 1,
+        .layer_input => id,
+    };
+    return .{ .r = r, .normed = sw.last_tap_post_norm and r == target_layers };
+}
+
+/// One token's tapped row (n_taps x hidden, config order) from the target's residuals; bf16 rounding: contextState.
+pub fn tapRow(c: Config, ids: []const usize, target_layers: usize, resid: []const []const f64, target_final_norm: []const f64, target_gemma: bool, out: []f64) void {
+    for (ids, 0..) |id, t| {
+        const src = tapSource(c.sw, id, target_layers);
+        const dst = out[t * c.hidden ..][0..c.hidden];
+        if (src.normed) mr.gemmaNorm(resid[src.r], target_final_norm, c.eps, target_gemma, dst) else @memcpy(dst, resid[src.r][0..c.hidden]);
+    }
+}
+
+// ---- the context --------------------------------------------------------------------------------------------------
+
+/// The context state of one token: hidden_norm(fc(taps)). `taps` is n_taps x hidden in config order.
+pub fn contextState(d: *const Draft, a: std.mem.Allocator, taps: []const f64, out: []f64) !void {
+    const c = d.cfg;
+    const in = try a.alloc(f64, c.n_taps * c.hidden);
+    defer a.free(in);
+    for (0..c.n_taps) |t| {
+        const src = if (c.sw.concat_order == .listed) t else c.n_taps - 1 - t;
+        @memcpy(in[t * c.hidden ..][0..c.hidden], taps[src * c.hidden ..][0..c.hidden]);
+    }
+    mr.roundAll(c.sw.tap_bf16, in);
+    const y = try a.alloc(f64, c.hidden);
+    defer a.free(y);
+    d.fc.apply(in, y);
+    mr.roundAll(c.sw.base.bf16_proj_out, y);
+    norm(c, y, d.hidden_norm, c.sw.gemma_hidden_norm, out);
+}
+
+/// Layer `l`'s K (normed, rotated at `pos`) and V of one context token, all kv heads: [n_kv x head_dim] each.
+pub fn contextKv(d: *const Draft, a: std.mem.Allocator, l: usize, ctx_state: []const f64, pos: usize, k: []f64, v: []f64) !void {
+    const c = d.cfg;
+    const ly = d.layers[l];
+    var x = ctx_state;
+    var tmp: ?[]f64 = null;
+    defer if (tmp) |t| a.free(t);
+    if (c.sw.ctx_input_norm) {
+        tmp = try a.alloc(f64, c.hidden);
+        norm(c, ctx_state, ly.input_norm, c.sw.base.gemma_layer_norms, tmp.?);
+        x = tmp.?;
+    }
+    ly.k.apply(x, k);
+    ly.v.apply(x, v);
+    mr.roundAll(c.sw.base.bf16_proj_out, k);
+    mr.roundAll(c.sw.base.bf16_proj_out, v);
+    heads(c, k, c.n_kv, ly.k_norm, pos);
+}
+
+/// The context K/V of positions first .. first + n - 1, every layer: `k[l]` and `v[l]` are [n][kvw].
+pub const Ctx = struct {
+    first: usize,
+    n: usize,
+    k: [][]f64,
+    v: [][]f64,
+
+    pub fn alloc(a: std.mem.Allocator, c: Config, first: usize, n: usize) !Ctx {
+        const k = try a.alloc([]f64, c.layers);
+        const v = try a.alloc([]f64, c.layers);
+        for (k, v) |*kk, *vv| {
+            kk.* = try a.alloc(f64, n * c.kvw());
+            vv.* = try a.alloc(f64, n * c.kvw());
+        }
+        return .{ .first = first, .n = n, .k = k, .v = v };
+    }
+};
+
+/// The reference context: every row recomputed from its tapped features (`feats`: [n][n_taps x hidden]).
+pub fn buildCtx(d: *const Draft, a: std.mem.Allocator, feats: []const f64, first: usize, n: usize) !Ctx {
+    const c = d.cfg;
+    const cx = try Ctx.alloc(a, c, first, n);
+    const st = try a.alloc(f64, c.hidden);
+    defer a.free(st);
+    for (0..n) |j| {
+        try contextState(d, a, feats[j * c.n_taps * c.hidden ..][0 .. c.n_taps * c.hidden], st);
+        for (0..c.layers) |l| try contextKv(d, a, l, st, first + j, cx.k[l][j * c.kvw() ..][0..c.kvw()], cx.v[l][j * c.kvw() ..][0..c.kvw()]);
+    }
+    return cx;
+}
+
+// ---- one draft block ----------------------------------------------------------------------------------------------
+
+/// The block's hidden rows [block][hidden]: `pre` before final_norm, `post` after it.
+pub const Block = struct { pre: []f64, post: []f64 };
+
+/// Whether a key at position `kp` is seen by the row at `rp` (the pending token sits at `p`).
+pub fn sees(sw: Switches, window: usize, kp: usize, rp: usize, p: usize) bool {
+    return switch (sw.window_rule) {
+        .per_row => kp <= rp and rp - kp < window,
+        .context_tail => kp + window >= p,
+    };
+}
+
+/// The block for the pending token `anchor` at position `p`, over the context `cx` (positions first .. p - 1 at most).
+pub fn blockForward(d: *const Draft, a: std.mem.Allocator, cx: *const Ctx, anchor: usize, p: usize) !Block {
+    const c = d.cfg;
+    const sw = c.sw;
+    const hd = c.head_dim;
+    const kvw = c.kvw();
+    const nb = c.block;
+    const rep = c.rep();
+    if (cx.first + cx.n > p) return error.ContextPastPending;
+    const h = try a.alloc(f64, nb * c.hidden);
+    for (0..nb) |i| {
+        const tok = if (i == 0) anchor else c.mask_token;
+        @memcpy(h[i * c.hidden ..][0..c.hidden], d.embed[tok * c.hidden ..][0..c.hidden]);
+    }
+    const x = try a.alloc(f64, c.hidden);
+    defer a.free(x);
+    const scale = std.math.pow(f64, @floatFromInt(hd), -0.5);
+    for (d.layers, 0..) |ly, l| {
+        const q = try a.alloc(f64, nb * c.n_q * hd);
+        defer a.free(q);
+        const kb = try a.alloc(f64, nb * kvw);
+        defer a.free(kb);
+        const vb = try a.alloc(f64, nb * kvw);
+        defer a.free(vb);
+        for (0..nb) |i| {
+            norm(c, h[i * c.hidden ..][0..c.hidden], ly.input_norm, sw.base.gemma_layer_norms, x);
+            const qi = q[i * c.n_q * hd ..][0 .. c.n_q * hd];
+            const ki = kb[i * kvw ..][0..kvw];
+            const vi = vb[i * kvw ..][0..kvw];
+            ly.q.apply(x, qi);
+            ly.k.apply(x, ki);
+            ly.v.apply(x, vi);
+            for ([_][]f64{ qi, ki, vi }) |t| mr.roundAll(sw.base.bf16_proj_out, t);
+            const pos = switch (sw.block_positions) {
+                .consecutive => p + i,
+                .all_pending => p,
+            };
+            heads(c, qi, c.n_q, ly.q_norm, pos);
+            heads(c, ki, c.n_kv, ly.k_norm, pos);
+        }
+        const attn = try a.alloc(f64, nb * c.n_q * hd);
+        defer a.free(attn);
+        for (0..nb) |i| {
+            const rp = switch (sw.block_positions) {
+                .consecutive => p + i,
+                .all_pending => p,
+            };
+            for (0..c.n_q) |hh| {
+                const g = hh / rep;
+                const qh = q[(i * c.n_q + hh) * hd ..][0..hd];
+                const total = cx.n + nb;
+                const s = try a.alloc(f64, total);
+                defer a.free(s);
+                var best: f64 = -std.math.inf(f64);
+                for (0..total) |j| {
+                    s[j] = -std.math.inf(f64);
+                    var key: []const f64 = undefined;
+                    if (j < cx.n) {
+                        if (!sees(sw, c.window, cx.first + j, rp, p)) continue;
+                        key = cx.k[l][j * kvw + g * hd ..][0..hd];
+                    } else {
+                        const m = j - cx.n;
+                        if (sw.block_attention == .causal and m > i) continue;
+                        key = kb[m * kvw + g * hd ..][0..hd];
+                    }
+                    var dot: f64 = 0;
+                    for (qh, key) |u, w| dot += u * w;
+                    s[j] = dot * scale;
+                    best = @max(best, s[j]);
+                }
+                var z: f64 = 0;
+                const out = attn[(i * c.n_q + hh) * hd ..][0..hd];
+                @memset(out, 0);
+                for (0..total) |j| {
+                    if (s[j] == -std.math.inf(f64)) continue;
+                    const w = @exp(s[j] - best);
+                    z += w;
+                    const val = if (j < cx.n) cx.v[l][j * kvw + g * hd ..][0..hd] else vb[(j - cx.n) * kvw + g * hd ..][0..hd];
+                    for (out, val) |*o, vv| o.* += w * vv;
+                }
+                for (out) |*o| o.* /= z;
+            }
+        }
+        mr.roundAll(sw.base.bf16_attn_out, attn);
+        const o = try a.alloc(f64, c.hidden);
+        defer a.free(o);
+        const g = try a.alloc(f64, c.ffn);
+        defer a.free(g);
+        const u = try a.alloc(f64, c.ffn);
+        defer a.free(u);
+        const f = try a.alloc(f64, c.hidden);
+        defer a.free(f);
+        for (0..nb) |i| {
+            const hi = h[i * c.hidden ..][0..c.hidden];
+            ly.o.apply(attn[i * c.n_q * hd ..][0 .. c.n_q * hd], o);
+            for (hi, o) |*hv, ov| hv.* = mr.round16(sw.base.bf16_residual, hv.* + ov);
+            norm(c, hi, ly.post_norm, sw.base.gemma_layer_norms, x);
+            ly.gate.apply(x, g);
+            ly.up.apply(x, u);
+            for (g, u) |*gv, uv| gv.* = mr.round16(sw.base.bf16_act_out, mr.swigluoai(gv.*, uv, c.alpha, c.limit, sw.base));
+            ly.down.apply(g, f);
+            for (hi, f) |*hv, fv| hv.* = mr.round16(sw.base.bf16_residual, hv.* + fv);
+        }
+    }
+    const post = try a.alloc(f64, nb * c.hidden);
+    for (0..nb) |i| norm(c, h[i * c.hidden ..][0..c.hidden], d.final_norm, sw.gemma_final_norm, post[i * c.hidden ..][0..c.hidden]);
+    return .{ .pre = h, .post = post };
+}
+
+// ---- heads ------------------------------------------------------------------------------------------------------
+
+fn auxRound(c: Config, x: []f64) void {
+    mr.roundAll(c.sw.aux_bf16, x);
+}
+
+/// The target's head applied to a (final-normed) draft row: logits over the vocabulary.
+pub fn baseLogits(d: *const Draft, a: std.mem.Allocator, row: []const f64, out: []f64) !void {
+    const x = try a.dupe(f64, row);
+    defer a.free(x);
+    auxRound(d.cfg, x);
+    d.head.apply(x, out);
+}
+
+/// Markov bias of candidate `id` after `prev`: the two tables' rows dotted (vanilla head, no nonlinearity).
+pub fn markovBias(d: *const Draft, prev: usize, id: usize) f64 {
+    const r = d.cfg.rank;
+    const a1 = if (d.cfg.sw.markov_swap) d.markov_w2 else d.markov_w1;
+    const a2 = if (d.cfg.sw.markov_swap) d.markov_w1 else d.markov_w2;
+    var s: f64 = 0;
+    for (a1[prev * r ..][0..r], a2[id * r ..][0..r]) |x, y| s += x * y;
+    return s;
+}
+
+/// The confidence of the draft that follows `prev` (null: the first draft with first_prev = none) from the block's row.
+pub fn confidence(d: *const Draft, a: std.mem.Allocator, pre: []const f64, post: []const f64, prev: ?usize) !f64 {
+    const c = d.cfg;
+    const row = try a.dupe(f64, if (c.sw.conf_input == .post_final_norm) post else pre);
+    defer a.free(row);
+    auxRound(c, row);
+    var s: f64 = d.conf_b;
+    for (row, d.conf_w[0..c.hidden]) |x, w| s += x * w;
+    if (prev) |pv| for (d.markov_w1[pv * c.rank ..][0..c.rank], d.conf_w[c.hidden..][0..c.rank]) |x, w| {
+        s += x * w;
+    };
+    return if (c.sw.conf_sigmoid) mr.sigmoid(s) else s;
+}
+
+/// One pass's chain: draft i = argmax of base_i[id] + bias(prev_i, id), ties to the lower id; prev_0 is the anchor.
+pub fn chain(d: *const Draft, a: std.mem.Allocator, b: Block, anchor: usize, drafts: []usize, conf: []f64) !void {
+    const c = d.cfg;
+    std.debug.assert(drafts.len == draftCount(c.sw, c.block) and conf.len == drafts.len);
+    const base = try a.alloc(f64, c.vocab);
+    defer a.free(base);
+    const allowed = try a.alloc(bool, c.vocab);
+    defer a.free(allowed);
+    var prev: ?usize = if (c.sw.first_prev == .anchor) anchor else null;
+    for (drafts, conf, 0..) |*t, *q, i| {
+        const row = rowFor(c.sw, i);
+        try baseLogits(d, a, b.post[row * c.hidden ..][0..c.hidden], base);
+        @memset(allowed, c.sw.markov_domain == .full_vocab);
+        if (c.sw.markov_domain == .candidates) {
+            for (0..c.candidates) |_| {
+                var top: ?usize = null;
+                for (0..c.vocab) |id| {
+                    if (allowed[id]) continue;
+                    if (top == null or base[id] > base[top.?]) top = id;
+                }
+                allowed[top.?] = true;
+            }
+        }
+        var best: ?usize = null;
+        var bz: f64 = 0;
+        for (0..c.vocab) |id| {
+            if (!allowed[id]) continue;
+            const z = base[id] + if (prev) |pv| markovBias(d, pv, id) else 0;
+            if (best == null or z > bz) {
+                best = id;
+                bz = z;
+            }
+        }
+        q.* = try confidence(d, a, b.pre[row * c.hidden ..][0..c.hidden], b.post[row * c.hidden ..][0..c.hidden], prev);
+        t.* = best.?;
+        prev = t.*;
+    }
+}
+
+/// Drafts kept before the first whose confidence (running product, or alone) falls under `threshold`; at least `least`.
+pub fn gateLen(sw: Switches, conf: []const f64, threshold: f64, least: usize) usize {
+    var running: f64 = 1;
+    var n: usize = 0;
+    for (conf) |q| {
+        running *= q;
+        const v = if (sw.conf_gate == .product) running else q;
+        if (v < threshold and n >= least) break;
+        n += 1;
+    }
+    return n;
+}
+
+test "e4m3 and ue8m0 against hand values" {
+    try std.testing.expectEqual(@as(f64, 1), e4m3(0x38));
+    try std.testing.expectEqual(@as(f64, -1), e4m3(0xB8));
+    try std.testing.expectEqual(@as(f64, 448), e4m3(0x7E));
+    try std.testing.expectEqual(@as(f64, 0x1p-9), e4m3(0x01)); // smallest subnormal
+    try std.testing.expectEqual(@as(f64, 0x1p-6 * 7 / 8.0), e4m3(0x07));
+    try std.testing.expectEqual(@as(f64, 0x1p-6), e4m3(0x08)); // smallest normal
+    try std.testing.expectEqual(@as(f64, 1.5), e4m3(0x3C));
+    try std.testing.expect(std.math.isNan(e4m3(0x7F)) and std.math.isNan(e4m3(0xFF)));
+    try std.testing.expectEqual(@as(f64, 0), e4m3(0x00));
+    try std.testing.expectEqual(@as(f64, 1), ue8m0(127, 127));
+    try std.testing.expectEqual(@as(f64, 0x1p-12), ue8m0(115, 127));
+    try std.testing.expectEqual(@as(f64, 0x1p-13), ue8m0(115, 128)); // the bias is a switch
+    try std.testing.expect(std.math.isNan(ue8m0(255, 127)));
+}
+
+test "dequant: one scale per 32 inputs of a row" {
+    var codes: [2 * 64]u8 = @splat(0x38); // 1.0
+    codes[63] = 0xB8; // -1.0 in the last block of row 0
+    const scales = [_]u8{ 127, 128, 126, 127 }; // row 0: 1, 2; row 1: 0.5, 1
+    var w: [2 * 64]f64 = undefined;
+    dequant(&codes, &scales, 2, 64, 32, 127, &w);
+    try std.testing.expectEqual(@as(f64, 1), w[0]);
+    try std.testing.expectEqual(@as(f64, 1), w[31]);
+    try std.testing.expectEqual(@as(f64, 2), w[32]);
+    try std.testing.expectEqual(@as(f64, -2), w[63]);
+    try std.testing.expectEqual(@as(f64, 0.5), w[64]);
+    try std.testing.expectEqual(@as(f64, 1), w[127]);
+}
