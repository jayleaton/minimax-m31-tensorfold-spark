+//! The device half of a forward step: kernels, buffers and `Device.emit`; UNEXERCISED (compiled, never launched).
+const std = @import("std");
+const cuda = @import("cuda");
+const plan = @import("forward_plan.zig");
+const weights = @import("weights.zig");
+const ffn = @import("ffn.zig");
+const rows_cfg = @import("rows.zig");
+const iface = @import("iface.zig");
+const sparse = cuda.minimax_m3_sparse;
+const rk = cuda.minimax_m3_rows;
+const Op = plan.Op;
+const Buf = plan.Buf;
+const Ref = plan.Ref;
+
+pub const Error = error{ NoLink, BadOp };
+
+/// Every kernel module a step launches from.
+pub const Modules = struct {
+    dense: cuda.exl3.Dense,
+    experts: cuda.exl3_experts.Experts,
+    norms: cuda.norms.Norms,
+    embed: cuda.embed_rows.EmbedRows,
+    act: cuda.minimax_m3_act.MiniMaxAct,
+    rows: rk.Rows,
+    proj: cuda.minimax_m3_proj.Proj,
+    sparse: sparse.Sparse,
+    scatter: cuda.rank_scatter.RankScatter,
+    dspark: cuda.minimax_m3_dspark.Dspark,
+
+    pub fn load(d: *const cuda.Driver) !Modules {
+        var m: Modules = undefined;
+        m.dense = try cuda.exl3.Dense.load(d);
+        errdefer m.dense.unload();
+        m.experts = try cuda.exl3_experts.Experts.load(d);
+        errdefer m.experts.unload();
+        m.norms = try cuda.norms.Norms.load(d);
+        errdefer m.norms.unload();
+        m.embed = try cuda.embed_rows.EmbedRows.load(d);
+        errdefer m.embed.unload();
+        m.act = try cuda.minimax_m3_act.MiniMaxAct.load(d);
+        errdefer m.act.unload();
+        m.rows = try rk.Rows.load(d);
+        errdefer m.rows.unload();
+        m.proj = try cuda.minimax_m3_proj.Proj.load(d);
+        errdefer m.proj.unload();
+        m.sparse = try sparse.Sparse.load(d);
+        errdefer m.sparse.unload();
+        m.scatter = try cuda.rank_scatter.RankScatter.load(d);
+        errdefer m.scatter.unload();
+        m.dspark = try cuda.minimax_m3_dspark.Dspark.load(d);
+        return m;
+    }
+
+    pub fn deinit(m: *Modules) void {
+        m.dspark.unload();
+        m.scatter.unload();
+        m.sparse.unload();
+        m.proj.unload();
+        m.rows.unload();
+        m.act.unload();
+        m.embed.unload();
+        m.norms.unload();
+        m.experts.unload();
+        m.dense.unload();
+        m.* = undefined;
+    }
+};
+
+/// How the two ranks meet: the group's all-gather, and NCCL for the row-share form of a prompt chunk's sum.
+pub const Link = struct { group: *const cuda.tp_group.Group, lib: *const cuda.nccl.Library, comm: cuda.nccl.Comm };
+
+/// The routed experts' layer shape, for sizing the scratch before any weights exist.
+fn shapeLayer(g: *const plan.Geometry) cuda.exl3_experts.Layer {
+    return .{ .gate = 0, .up = 0, .down = 0, .gate_k2 = 0, .up_k2 = 0, .down_k2 = 0, .suh_g = 0, .suh_u = 0, .svh_g = 0, .svh_u = 0, .suh_d = 0, .svh_d = 0, .experts = g.experts, .dims = g.hidden, .width = g.moe_w, .codebook = .mul1 };
+}
+
+/// Rows of one rank's share of `rows` rows, at most (the padded slot of the share form).
+fn shareRows(rows: usize, world: usize) usize {
+    return (rows + world - 1) / world;
+}
+
+/// Buffers that are not rows of a step: scratch of the kernels and the exchange.
+pub const Extra = enum { experts, gathered, scatter, share, shares, bmax, sel, status };
+
+pub const Buffers = struct {
+    mem: [plan.bufs.len + std.enums.values(Extra).len]cuda.DeviceBuffer,
+    n: usize,
+    bm_stride: usize,
+
+    fn take(b: *Buffers, d: *const cuda.Driver, bytes: usize) !void {
+        b.mem[b.n] = try cuda.DeviceBuffer.alloc(d, bytes);
+        b.n += 1;
+    }
+
+    pub fn init(d: *const cuda.Driver, g: *const plan.Geometry, bm_stride: usize) !Buffers {
+        var b: Buffers = .{ .mem = undefined, .n = 0, .bm_stride = bm_stride };
+        errdefer b.deinit();
+        for (plan.bufs) |id| try b.take(d, g.rowBytes(id) * g.capacity(id));
+        const world: usize = g.world;
+        const slot_rows = shareRows(g.max_rows, world);
+        const experts = try cuda.exl3_experts.scratchBytes(shapeLayer(g), plan.expert_rows, g.topk);
+        const wide: usize = @min(g.max_rows, 128);
+        try b.take(d, experts);
+        try b.take(d, world * wide * g.hidden * 4);
+        try b.take(d, world * slot_rows * g.hidden * 4);
+        try b.take(d, slot_rows * g.hidden * 4);
+        try b.take(d, world * slot_rows * g.hidden * 4);
+        try b.take(d, @as(usize, g.max_rows) * g.kvh * bm_stride * 4);
+        try b.take(d, @as(usize, g.max_rows) * g.kvh * 16 * 4);
+        try b.take(d, 4);
+        return b;
+    }
+
+    pub fn deinit(b: *Buffers) void {
+        for (b.mem[0..b.n]) |*m| m.free();
+        b.n = 0;
+    }
+
+    pub fn ptr(b: *const Buffers, id: Buf) u64 {
+        return b.mem[@backingInt(id)].ptr;
+    }
+
+    pub fn extra(b: *const Buffers, e: Extra) *const cuda.DeviceBuffer {
+        return &b.mem[plan.bufs.len + @backingInt(e)];
+    }
+
+    pub fn scratch(b: *const Buffers) sparse.Scratch {
+        return .{ .bmax = b.extra(.bmax).ptr, .sel = b.extra(.sel).ptr, .bm_stride = b.bm_stride };
+    }
+};
+
+/// Where a call's tapped rows go: the taps buffer and the streams' rows of the call.
+pub const Taps = struct {
+    base: u64 = 0, // device address of row 0 of the taps buffer (0: the forward does not tap)
+    prompt: bool = false,
+    segs: [iface.max_shared]iface.Seg = undefined, // rows of each stream in the batch (res rows row0 ...)
+    n: u32 = 0,
+};
+
+/// The pool the paged kernels address (the engine's arena), and where this call's block tables are.
+pub const Pages = struct { cache: rk.Cache, layer_bytes: u64, mirror: *rk.Mirror, slot: u32 = 0, pos0: u32 = 0 };
+
+pub const Device = struct {
+    d: *const cuda.Driver,
+    st: cuda.Stream,
+    m: *Modules,
+    w: *const weights.Weights,
+    g: *const plan.Geometry,
+    b: *Buffers,
+    pages: Pages,
+    link: ?Link,
+    opts: rk.Opts,
+    sw: ffn.Switches = .{},
+    shared: bool = false, // this call's rows carry their own positions and table offsets
+    taps: Taps = .{},
+
+    fn at(dv: *const Device, r: Ref) u64 {
+        return dv.b.ptr(r.buf) + @as(u64, r.row) * dv.g.rowBytes(r.buf);
+    }
+
+    fn layer(dv: *const Device, l: u32) *const weights.Layer {
+        return &dv.w.layers[l];
+    }
+
+    fn paged(dv: *const Device, l: u32) !sparse.Paged {
+        var c = dv.pages.cache;
+        c.layer_off = @as(u64, l) * dv.pages.layer_bytes;
+        return if (dv.shared) dv.pages.mirror.shared(c) else try dv.pages.mirror.single(c, dv.pages.slot);
+    }
+
+    fn rowsOf(dv: *const Device, n: u32) sparse.Rows {
+        return if (dv.shared) .{ .n = n, .pos = dv.b.ptr(.pos) } else .{ .n = n, .pos0 = @intCast(dv.pages.pos0) };
+    }
+
+    fn zeroBytes(dv: *const Device, p: u64, bytes: usize) !void {
+        try dv.d.check(dv.d.api.cuMemsetD8Async(p, 0, bytes, dv.st.handle), "cuMemsetD8Async");
+    }
+
+    fn copy(dv: *const Device, dst: u64, src: u64, bytes: usize) !void {
+        try dv.d.check(dv.d.api.cuMemcpyDtoDAsync_v2(dst, src, bytes, dv.st.handle), "cuMemcpyDtoDAsync");
+    }
+
+    fn weightOf(dv: *const Device, w: plan.Lin, l: u32) cuda.exl3.Weight {
+        const ly = dv.layer(l);
+        return switch (w) {
+            .q => ly.q,
+            .k => ly.k,
+            .v => ly.v,
+            .o => ly.o,
+            .dense_gate => ly.ffn.dense.gate,
+            .dense_up => ly.ffn.dense.up,
+            .dense_down => ly.ffn.dense.down,
+            .shared_gate => ly.ffn.moe.shared.gate,
+            .shared_up => ly.ffn.moe.shared.up,
+            .shared_down => ly.ffn.moe.shared.down,
+            .head => dv.w.head,
+        };
+    }
+
+    fn normOf(dv: *const Device, n: plan.Norm, l: u32) u64 {
+        return switch (n) {
+            .input => dv.layer(l).input_ln,
+            .post => dv.layer(l).post_ln,
+            .final => dv.w.final_norm,
+        };
+    }
+
+    /// Launches one op on the stream.
+    pub fn emit(dv: *Device, op: Op) !void {
+        const s = dv.st;
+        const m = dv.m;
+        const hidden = dv.g.hidden;
+        switch (op) {
+            .stage => |o| {
+                dv.shared = o.shared;
+                try dv.zeroBytes(dv.b.extra(.status).ptr, 4);
+            },
+            .embed => |o| try m.embed.bf16(s, dv.b.ptr(.ids), dv.w.embed, dv.b.ptr(.emb), o.rows, hidden),
+            .zero => |o| try dv.zeroBytes(dv.b.ptr(o.buf), @as(usize, o.rows) * dv.g.rowBytes(o.buf)),
+            .norm_add => |o| {
+                const kind: cuda.norms.Kind = if (o.x_f32) .f32 else .bf16;
+                const wt = dv.normOf(o.norm, o.layer);
+                try m.norms.addRms(s, dv.at(o.x), kind, dv.b.ptr(.res), null, wt, dv.at(o.y), .bf16, o.rows, hidden, dv.g.cfg.eps);
+            },
+            .linear => |o| {
+                const w = dv.weightOf(o.w, o.layer);
+                const wide = o.w == .o or o.w == .dense_down or o.w == .shared_down or o.w == .head;
+                const ydt: cuda.exl3.DType = if (wide) .f32 else .bf16;
+                if (o.w == .head and o.rows > 1 and w.n != dv.g.slot) {
+                    // The kernel writes row r at stride w.n; the readers (gather, pick) use the largest rank's width.
+                    const xb = dv.g.rowBytes(o.x.buf);
+                    const yb = dv.g.rowBytes(o.y.buf);
+                    var r: u32 = 0;
+                    while (r < o.rows) : (r += 1) {
+                        try m.dense.decode(s, w, dv.at(o.x) + @as(u64, r) * xb, .bf16, 1, dv.at(o.y) + @as(u64, r) * yb, ydt);
+                    }
+                } else if (o.prompt) {
+                    try m.dense.prompt(s, w, dv.at(o.x), .bf16, o.rows, dv.at(o.y), ydt);
+                } else try m.dense.decode(s, w, dv.at(o.x), .bf16, o.rows, dv.at(o.y), ydt);
+            },
+            .index_proj => |o| {
+                const ly = dv.layer(o.layer);
+                const ot: cuda.minimax_m3_proj.OutType = if (dv.opts.flags.index_fp16) .f16 else .bf16;
+                const q: cuda.minimax_m3_proj.Part = .{ .w = ly.index_q_proj, .n = dv.g.iq_w, .out = dv.b.ptr(.iq_raw), .out_ld = dv.g.iq_w };
+                const k: cuda.minimax_m3_proj.Part = .{ .w = ly.index_k_proj, .n = dv.g.ik_w, .out = dv.b.ptr(.ik_raw), .out_ld = dv.g.ik_w };
+                try m.proj.project(s, dv.b.ptr(.a), hidden, false, hidden, q, k, o.rows, ot);
+            },
+            .qk_rope => |o| try dv.qkRope(o.layer, o.rows),
+            .score => |o| {
+                const scale: f32 = @floatCast(std.math.pow(f64, 128, -0.5));
+                try m.sparse.score(s, dv.b.ptr(.iqn), dv.rowsOf(o.rows), try dv.paged(o.layer), dv.b.scratch(), o.max_pos, scale);
+            },
+            .select => |o| try m.sparse.select(s, dv.rowsOf(o.rows), dv.g.kvh, dv.b.scratch(), .{}),
+            .attend => |o| {
+                const scale: f32 = @floatCast(std.math.pow(f64, 128, -0.5));
+                try m.sparse.attend(s, dv.b.ptr(.qn), dv.rowsOf(o.rows), try dv.paged(o.layer), dv.b.scratch(), dv.b.ptr(.attn), scale);
+            },
+            .router => |o| try m.rows.routerLogits(s, rows_cfg.router, dv.b.ptr(.a), hidden, false, dv.layer(o.layer).ffn.moe.router, dv.b.ptr(.logits_r), o.rows),
+            .route => |o| {
+                const moe = dv.layer(o.layer).ffn.moe;
+                const rp = try ffn.routePlan(dv.sw);
+                try m.act.route(s, dv.b.ptr(.logits_r), moe.bias, rp.route, dv.b.ptr(.pick), dv.b.ptr(.wts), o.rows);
+            },
+            .experts => |o| {
+                const l = dv.layer(o.layer).ffn.moe.experts;
+                const sc = try cuda.exl3_experts.scratch(dv.b.extra(.experts).ptr, l, plan.expert_rows, dv.g.topk);
+                const x = dv.at(.{ .buf = .a, .row = o.row0 });
+                const pick = dv.at(.{ .buf = .pick, .row = o.row0 });
+                const wts = dv.at(.{ .buf = .wts, .row = o.row0 });
+                try m.experts.run(s, l, x, hidden, .bf16, pick, wts, o.rows, dv.at(.{ .buf = .routed, .row = o.row0 }), sc);
+            },
+            .swiglu => |o| {
+                const p = ffn.actParams(dv.sw);
+                const ld: usize = o.n;
+                try m.act.swigluoai(s, .bf16, dv.b.ptr(.gate), ld, dv.b.ptr(.up), ld, dv.b.ptr(.act), ld, o.rows, o.n, p);
+            },
+            .add2 => |o| {
+                // tf_rank_sum as a two-term fp32 add: peers slot 0 is `a`, own (rank 1) is `b`, one rounded add each
+                try m.scatter.rankSum(s, dv.b.ptr(o.a), dv.b.ptr(o.b), 2, 1, @as(usize, o.rows) * hidden, dv.b.ptr(o.out));
+            },
+            .exchange => |o| try dv.sum(o),
+            .tap => |o| try dv.tap(o.slot, o.rows),
+            .logits_gather => |o| {
+                const link = dv.link orelse return error.NoLink;
+                const bytes = @as(usize, o.rows) * dv.g.slot * 4;
+                try link.group.allGather(s, dv.b.ptr(.hlog), dv.b.ptr(.hgather), bytes);
+            },
+            .local_pick => |o| try m.proj.pick(s, dv.b.ptr(.hlog), dv.g.slot, dv.g.own_vocab, dv.g.vocab_lo, o.rows, dv.b.ptr(.pairs)),
+            .pick_gather => |o| {
+                // [rank][row] pairs of (logit bits, id), the layout of the logits gather with a slot of one pair
+                const link = dv.link orelse return error.NoLink;
+                try link.group.allGather(s, dv.b.ptr(.pairs), dv.b.ptr(.pairs_all), @as(usize, o.rows) * 8);
+            },
+        }
+    }
+
+    fn qkRope(dv: *const Device, l: u32, n: u32) !void {
+        const ly = dv.layer(l);
+        const g = dv.g;
+        const heads: rk.Heads = .{ .nq = g.nq, .niq = g.niq, .kvh = g.kvh, .index_key = true };
+        const b = dv.b;
+        const in: rk.Inputs = .{
+            .q = b.ptr(.q),
+            .q_ld = g.q_w,
+            .k = b.ptr(.k),
+            .k_ld = g.kv_w,
+            .v = b.ptr(.v),
+            .v_ld = g.kv_w,
+            .iq = b.ptr(.iq_raw),
+            .iq_ld = g.iq_w,
+            .ik = b.ptr(.ik_raw),
+            .ik_ld = g.ik_w,
+        };
+        const nm: rk.Norms = .{ .q = ly.q_norm, .k = ly.k_norm, .iq = ly.index_q_norm, .ik = ly.index_k_norm };
+        const out: rk.Outputs = .{ .q = b.ptr(.qn), .q_ld = g.q_w, .iq = b.ptr(.iqn), .iq_ld = g.iq_w };
+        const pg = try dv.paged(l);
+        try dv.m.rows.qkRope(dv.st, heads, dv.opts, in, nm, out, dv.rowsOf(n), pg, @intCast(dv.pages.mirror.max_pages), b.extra(.status).ptr);
+    }
+
+    /// A block's partial sums added in rank order into `dst` on every rank, in tp.zig's gather or share form.
+    fn sum(dv: *const Device, o: anytype) !void {
+        const link = dv.link orelse return error.NoLink;
+        const g = dv.g;
+        const world: usize = g.world;
+        const rank: usize = g.rank;
+        const width: usize = g.hidden;
+        const rows: usize = o.rows;
+        if (o.form == .gather_sum) {
+            const slot = rows * width * 4;
+            try link.group.allGather(dv.st, dv.b.ptr(o.src), dv.b.extra(.gathered).ptr, slot);
+            return dv.m.scatter.rankSum(dv.st, dv.b.extra(.gathered).ptr, dv.b.ptr(o.src), world, rank, rows * width, dv.b.ptr(o.dst));
+        }
+        const slot = shareRows(rows, world) * width * 4;
+        try dv.m.scatter.run(link.lib, link.comm, world, rank, dv.st, dv.b.ptr(o.src), rows, width, dv.b.extra(.scatter).ptr, dv.b.extra(.share).ptr);
+        try link.group.allGather(dv.st, dv.b.extra(.share).ptr, dv.b.extra(.shares).ptr, slot);
+        for (0..world) |r| {
+            const rs = cuda.rank_scatter.share(rows, world, r);
+            const bytes = (rs[1] - rs[0]) * width * 4;
+            if (bytes > 0) try dv.copy(dv.b.ptr(o.dst) + rs[0] * width * 4, dv.b.extra(.shares).ptr + r * slot, bytes);
+        }
+    }
+
+    /// The tapped layer's output rows as bf16: a prompt chunk's into the chunk rows, a window's into its slot's rows.
+    fn tap(dv: *const Device, slot: u32, rows: u32) !void {
+        if (dv.taps.base == 0) return;
+        const hidden = dv.g.hidden;
+        const ld: usize = @as(usize, dv.g.n_taps) * hidden;
+        const res = dv.b.ptr(.res);
+        if (dv.taps.prompt) {
+            try dv.m.dspark.tap(dv.st, res, dv.taps.base, ld, slot, hidden, rows);
+            return;
+        }
+        for (dv.taps.segs[0..dv.taps.n]) |sg| {
+            const dst = dv.taps.base + @as(u64, iface.tapWindowRow(sg.slot)) * ld * 2;
+            try dv.m.dspark.tap(dv.st, res + @as(u64, sg.row0) * hidden * 4, dst, ld, slot, hidden, sg.rows);
+        }
+    }
+
+    /// After the step: a launch that found no page for a row left bits in the status word.
+    pub fn status(dv: *const Device) !i32 {
+        var out: [4]u8 = undefined;
+        try dv.b.extra(.status).download(0, &out);
+        try dv.st.synchronize();
+        return std.mem.readInt(i32, &out, .little);
+    }
+};
diff --git a/zig/src/families/minimax_m3/forward_ops.zig b/zig/src/families/minimax_m3/forward_ops.zig
new file mode 100644
index 0000000..1beccd4
--- /dev/null
+++ b/zig/src/families/minimax_m3/forward_ops.zig
@@ -0,0 +1,133 @@
+//! engine_ops.Ops over forward.zig (T8a): the pass kinds become `Call`s, the head's gathered fp32 rows are the logits.
+const std = @import("std");
+const cuda = @import("cuda");
+const iface = @import("iface.zig");
+const ops = @import("engine_ops.zig");
+const fw = @import("forward.zig");
+const plan = @import("forward_plan.zig");
+const pool = @import("pool.zig");
+const shard = @import("shard.zig");
+const rk = cuda.minimax_m3_rows;
+
+pub const Impl = struct {
+    gpa: std.mem.Allocator,
+    g: plan.Geometry,
+    m: fw.Modules,
+    b: fw.Buffers,
+    f: fw.Forward,
+    dims: pool.Dims,
+    mirror: ?rk.Mirror = null,
+    addr: [3]u64 = @splat(0), // where the last pass of each kind left its head
+    positions: [iface.shared_rows]i32 = undefined,
+    link: ?fw.Link = null,
+    args: ops.OpenArgs = undefined,
+    made: bool = false,
+    dims_slots: u32 = 0,
+    taps: ?cuda.DeviceBuffer = null, // the dspark draft's tapped rows (iface.tapRows(slots) of them), made at `attach`
+
+    pub fn open(a: ops.OpenArgs) !ops.Ops {
+        const self = try a.gpa.create(Impl);
+        errdefer a.gpa.destroy(self);
+        const layers: u32 = if (a.settings.layers > 0) a.settings.layers else a.cfg.layers;
+        self.* = .{ .gpa = a.gpa, .g = try plan.Geometry.of(a.cfg, a.share, layers, iface.max_rows), .m = try fw.Modules.load(a.d), .b = undefined, .f = undefined, .dims = (try pool.Dims.of(a.cfg, a.share)).withKv8(a.settings.kv8) };
+        errdefer self.m.deinit();
+        self.b = try fw.Buffers.init(a.d, &self.g, iface.maxPages(a.capacity));
+        errdefer self.b.deinit();
+        const link: ?fw.Link = if (a.place.world > 1) .{ .group = a.group, .lib = a.lib, .comm = a.comm } else null;
+        // the pages arrive at `attach`: the forward is made there, over the engine's arena and block table
+        self.f = undefined;
+        self.link = link;
+        self.args = a;
+        return .{ .ptr = self, .vtable = &.{ .attach = attach, .run = run, .logits = logits, .sync = sync, .deinit = deinit, .set_taps = setTaps, .taps_base = tapsBase, .tap_copy = tapCopy } };
+    }
+
+    fn of(p: *anyopaque) *Impl {
+        return @ptrCast(@alignCast(p));
+    }
+
+    fn attach(p: *anyopaque, view: ops.PoolView) anyerror!void {
+        const s = of(p);
+        const a = s.args;
+        if (s.made) {
+            s.f.deinit(s.gpa);
+            if (s.mirror) |*m| m.row_tab.free();
+        }
+        s.dims_slots = view.slots;
+        const tables: cuda.DeviceBuffer = .{ .d = a.d, .ptr = view.table, .len = view.slots * view.max_pages * 4, .borrowed = true };
+        var row_tab = try cuda.DeviceBuffer.alloc(a.d, iface.shared_rows * 4);
+        errdefer row_tab.free();
+        s.mirror = .{ .tables = tables, .row_tab = row_tab, .slots = view.slots, .max_pages = view.max_pages, .max_rows = iface.shared_rows };
+        const pages: fw.Pages = .{ .cache = .{ .pool = view.arena, .page_bytes = view.page_bytes, .layer_off = 0, .kvh = s.g.kvh, .kv8 = s.dims.kv8 }, .layer_bytes = s.dims.layerToken() * pool.page_tokens, .mirror = &s.mirror.? };
+        s.f = try fw.Forward.init(s.gpa, a.d, a.stream, &s.m, a.weights, &s.g, &s.b, pages, s.link);
+        s.made = true;
+        if (s.g.n_taps > 0) { // one row of the buffer = every tap's hidden state side by side, bf16
+            if (s.taps) |*t| t.free();
+            s.taps = null;
+            const row_bytes = @as(usize, s.g.n_taps) * s.g.hidden * 2;
+            s.taps = try cuda.DeviceBuffer.alloc(a.d, iface.tapRows(view.slots) * row_bytes);
+            s.f.dev.taps.base = s.taps.?.ptr;
+        }
+    }
+
+    /// The draft's layers: from the next `attach` on the forward copies those layers' outputs into the taps buffer.
+    fn setTaps(p: *anyopaque, ids: []const u32) anyerror!void {
+        const s = of(p);
+        if (ids.len == 0 or ids.len > plan.max_taps) return error.BadTaps;
+        for (ids, 0..) |id, i| {
+            if (id >= s.g.layers or (i > 0 and id <= ids[i - 1])) return error.BadTaps;
+            s.g.tap_ids[i] = id;
+        }
+        s.g.n_taps = @intCast(ids.len);
+    }
+
+    fn tapsBase(p: *anyopaque) u64 {
+        const s = of(p);
+        return if (s.taps) |t| t.ptr else 0;
+    }
+
+    fn tapCopy(p: *anyopaque, from: u32, to: u32) anyerror!void {
+        const s = of(p);
+        const t = s.taps orelse return error.BadTaps;
+        const row_bytes = @as(u64, s.g.n_taps) * s.g.hidden * 2;
+        if (from >= iface.tapRows(s.dims_slots) or to >= iface.tapRows(s.dims_slots)) return error.BadTaps;
+        try s.args.d.check(s.args.d.api.cuMemcpyDtoDAsync_v2(t.ptr + to * row_bytes, t.ptr + from * row_bytes, row_bytes, s.args.stream.handle), "cuMemcpyDtoDAsync");
+    }
+
+    fn run(p: *anyopaque, f: ops.Forward) anyerror!void {
+        const s = of(p);
+        if (!s.made) return error.NoPool;
+        const ids: []const i32 = @ptrCast(f.ids);
+        const head: plan.Head = if (!f.head) .none else if (f.kind == .prompt) .last else .all;
+        var call: fw.Call = .{ .ids = ids, .slot = f.segs[0].slot, .pos0 = f.starts[0], .prompt = f.kind == .prompt, .head = head };
+        if (f.kind == .shared) {
+            for (f.segs, f.starts) |g, start| for (0..g.rows) |k| {
+                s.positions[g.row0 + k] = @intCast(start + k);
+            };
+            call.segs = f.segs;
+            call.positions = s.positions[0..f.ids.len];
+        }
+        const out = try s.f.run(call);
+        s.addr[@backingInt(f.kind)] = if (head == .none) 0 else s.f.address(out);
+    }
+
+    fn logits(p: *anyopaque, kind: ops.Rows) u64 {
+        return of(p).addr[@backingInt(kind)];
+    }
+
+    fn sync(p: *anyopaque) anyerror!void {
+        const s = of(p);
+        try s.args.stream.synchronize();
+    }
+
+    fn deinit(p: *anyopaque) void {
+        const s = of(p);
+        if (s.made) {
+            s.f.deinit(s.gpa);
+            if (s.mirror) |*m| m.row_tab.free();
+        }
+        if (s.taps) |*t| t.free();
+        s.b.deinit();
+        s.m.deinit();
+        s.gpa.destroy(s);
+    }
+};
diff --git a/zig/src/families/minimax_m3/forward_plan.zig b/zig/src/families/minimax_m3/forward_plan.zig
new file mode 100644
index 0000000..ed9f7df
--- /dev/null
+++ b/zig/src/families/minimax_m3/forward_plan.zig
@@ -0,0 +1,381 @@
+//! One MiniMax-M3.1-Flash forward step as data: a pure planner (no GPU) the executor and the tests share.
+const std = @import("std");
+const Config = @import("config.zig").Config;
+const shard = @import("shard.zig");
+const tp = @import("tp.zig");
+const iface = @import("iface.zig");
+
+pub const Error = error{ BadRows, TooManyRows, BadThin };
+
+/// Routed-expert rows one launch takes: its scratch is sized for them, a longer chunk runs in several calls.
+pub const expert_rows: u32 = 256;
+/// Most rows whose logits the head keeps at once (a decode or verify window; a prompt chunk keeps one row).
+pub const head_rows: u32 = 128;
+
+/// Device buffers a step's ops name; the executor maps each to an allocation (rows are the first index).
+pub const Buf = enum {
+    ids, // int32 token ids
+    pos, // int32 positions (a shared window's rows)
+    row_tab, // int32 table offsets (a shared window's rows)
+    emb, // bf16 embedding rows
+    res, // fp32 residual stream (decision R1: fp32, the T0 default has no rounding)
+    a, // bf16 normed input of the current block
+    q,
+    k,
+    v, // bf16 projections
+    iq_raw,
+    ik_raw, // fp16 index projections
+    qn,
+    iqn, // bf16 normed and rotated q and index q
+    attn, // bf16 attention output
+    part, // fp32 this rank's partial sum of a block
+    routed, // fp32 routed experts' output
+    shr, // fp32 shared expert's output
+    sum, // fp32 the ranks' partials added in rank order
+    gate,
+    up,
+    act, // bf16 dense and shared MLP rows
+    logits_r, // fp32 router logits
+    pick, // int32 routed picks
+    wts, // fp32 routed weights
+    hlog, // fp32 this rank's head logits
+    hgather, // fp32 every rank's head logits, [rank][row][slot]
+    pairs, // (logit, id) of this rank's best
+    pairs_all, // every rank's pair
+};
+
+pub const bufs = std.enums.values(Buf);
+
+/// A buffer and the first row an op reads or writes in it.
+pub const Ref = struct { buf: Buf, row: u32 = 0 };
+
+pub const Norm = enum { input, post, final };
+
+/// The matrices a `linear` op names (layer picks the record; head and the layer's dense or shared MLP are by kind).
+pub const Lin = enum { q, k, v, o, dense_gate, dense_up, dense_down, shared_gate, shared_up, shared_down, head };
+
+pub const Form = tp.Form;
+
+pub const Op = union(enum) {
+    stage: struct { rows: u32, shared: bool }, // ids, positions and row tables go to the device; status cleared
+    embed: struct { rows: u32 },
+    zero: struct { buf: Buf, rows: u32 },
+    norm_add: struct { x: Ref, x_f32: bool, norm: Norm, layer: u32, y: Ref, rows: u32 }, // res += x; y = rms(res) w
+    linear: struct { w: Lin, layer: u32, x: Ref, y: Ref, rows: u32, prompt: bool },
+    index_proj: struct { layer: u32, rows: u32 }, // fp16 weights: a -> iq_raw, ik_raw
+    qk_rope: struct { layer: u32, rows: u32 }, // norm + rope; q, index q to scratch; k, v, index key into pages
+    score: struct { layer: u32, rows: u32, max_pos: u32 },
+    select: struct { layer: u32, rows: u32 },
+    attend: struct { layer: u32, rows: u32 },
+    router: struct { layer: u32, rows: u32 }, // fp32 gate times a
+    route: struct { layer: u32, rows: u32 },
+    experts: struct { layer: u32, row0: u32, rows: u32 },
+    swiglu: struct { layer: u32, shared: bool, n: u32, rows: u32 }, // act = swigluoai(gate, up)
+    add2: struct { a: Buf, b: Buf, out: Buf, rows: u32 }, // out = a + b in fp32 (routed + shared)
+    exchange: struct { form: Form, site: tp.Site, src: Buf, dst: Buf, rows: u32 },
+    tap: struct { slot: u32, rows: u32 }, // bf16 copy of res (the layer's output) into column slot `slot` of the taps buffer
+    logits_gather: struct { rows: u32 },
+    local_pick: struct { rows: u32 },
+    pick_gather: struct { rows: u32 },
+};
+
+/// The kernels' classes, one per launch of the T0 model's order (see forward_test.zig).
+pub const Stage = enum {
+    stage,
+    embed,
+    zero,
+    norm_in,
+    proj_q,
+    proj_k,
+    proj_v,
+    index_proj,
+    qk_rope,
+    score,
+    select,
+    attend,
+    proj_o,
+    exchange_attn,
+    norm_post,
+    dense_gate,
+    dense_up,
+    dense_act,
+    dense_down,
+    router,
+    route,
+    experts,
+    shared_gate,
+    shared_up,
+    shared_act,
+    shared_down,
+    combine,
+    exchange_ffn,
+    tap,
+    norm_final,
+    head,
+    gather,
+    pick,
+};
+
+pub fn stageOf(op: Op) Stage {
+    return switch (op) {
+        .stage => .stage,
+        .embed => .embed,
+        .zero => .zero,
+        .norm_add => |o| switch (o.norm) {
+            .input => .norm_in,
+            .post => .norm_post,
+            .final => .norm_final,
+        },
+        .linear => |o| switch (o.w) {
+            .q => .proj_q,
+            .k => .proj_k,
+            .v => .proj_v,
+            .o => .proj_o,
+            .dense_gate => .dense_gate,
+            .dense_up => .dense_up,
+            .dense_down => .dense_down,
+            .shared_gate => .shared_gate,
+            .shared_up => .shared_up,
+            .shared_down => .shared_down,
+            .head => .head,
+        },
+        .index_proj => .index_proj,
+        .qk_rope => .qk_rope,
+        .score => .score,
+        .select => .select,
+        .attend => .attend,
+        .router => .router,
+        .route => .route,
+        .experts => .experts,
+        .swiglu => |o| if (o.shared) .shared_act else .dense_act,
+        .add2 => .combine,
+        .exchange => |o| if (o.site == .attn_out) .exchange_attn else .exchange_ffn,
+        .tap => .tap,
+        .logits_gather, .pick_gather => .gather,
+        .local_pick => .pick,
+    };
+}
+
+/// Most layers the dspark draft may tap.
+pub const max_taps = 8;
+
+/// The rank's widths: what each buffer holds per row and which matrices exist.
+pub const Geometry = struct {
+    cfg: *const Config,
+    hidden: u32,
+    layers: u32, // layers run (a thin model: the first ones)
+    world: u32,
+    rank: u32,
+    max_rows: u32,
+    nq: u32, // this rank's query heads, index heads, kv heads
+    niq: u32,
+    kvh: u32,
+    q_w: u32,
+    kv_w: u32,
+    iq_w: u32,
+    ik_w: u32,
+    dense_w: u32,
+    shared_w: u32,
+    moe_w: u32,
+    experts: u32,
+    topk: u32,
+    slot: u32, // logits a rank's gather slot holds (the largest share)
+    own_vocab: u32, // this rank's head rows
+    vocab_lo: u32, // first vocabulary id of this rank's rows
+    tap_ids: [max_taps]u32 = @splat(0), // the dspark draft's layers (ascending) whose output rows are copied; none: no taps
+    n_taps: u32 = 0,
+
+    pub fn of(c: *const Config, s: shard.Share, layers: u32, max_rows: u32) !Geometry {
+        if (layers == 0 or layers > c.layers) return error.BadThin;
+        const lg = try tp.LogitsGather.of(c, s.world);
+        return .{
+            .cfg = c,
+            .hidden = c.hidden,
+            .layers = layers,
+            .world = @intCast(s.world),
+            .rank = @intCast(s.rank),
+            .max_rows = max_rows,
+            .nq = @intCast(s.q_heads.len()),
+            .niq = @intCast(s.index_heads.len()),
+            .kvh = @intCast(s.kv_heads.len()),
+            .q_w = @intCast(s.q_heads.len() * c.head_dim),
+            .kv_w = @intCast(s.kv_heads.len() * c.head_dim),
+            .iq_w = @intCast(s.index_heads.len() * c.index.dim),
+            .ik_w = c.index.dim,
+            .dense_w = @intCast(s.dense.len()),
+            .shared_w = @intCast(s.shared.len()),
+            .moe_w = @intCast(s.moe.len()),
+            .experts = c.experts,
+            .topk = c.topk,
+            .slot = @intCast(lg.slot),
+            .own_vocab = @intCast(s.vocab.len()),
+            .vocab_lo = @intCast(s.vocab.lo),
+        };
+    }
+
+    /// Which tap slot layer `layer` fills, if the draft reads it.
+    pub fn tapSlot(g: *const Geometry, layer: u32) ?u32 {
+        for (g.tap_ids[0..g.n_taps], 0..) |id, t| if (id == layer) return @intCast(t);
+        return null;
+    }
+
+    pub fn isMoe(g: *const Geometry, layer: u32) bool {
+        return g.cfg.isMoe(layer);
+    }
+
+    /// Rows a buffer holds at most: the ids and activations by `max_rows`, the head's by `head_rows`.
+    pub fn capacity(g: *const Geometry, b: Buf) u32 {
+        return switch (b) {
+            .hlog, .hgather, .pairs, .pairs_all => head_rows,
+            else => g.max_rows,
+        };
+    }
+
+    /// Bytes one row of `b` takes.
+    pub fn rowBytes(g: *const Geometry, b: Buf) usize {
+        const rows_w: usize = @max(g.dense_w, g.shared_w);
+        return switch (b) {
+            .ids, .pos, .row_tab => 4,
+            .emb, .a => g.hidden * 2,
+            .res, .part, .routed, .shr, .sum => g.hidden * 4,
+            .q, .qn, .attn => g.q_w * 2,
+            .k, .v => g.kv_w * 2,
+            .iq_raw, .iqn => g.iq_w * 2,
+            .ik_raw => g.ik_w * 2,
+            .gate, .up, .act => rows_w * 2,
+            .logits_r => g.experts * 4,
+            .pick, .wts => g.topk * 4,
+            .hlog => g.slot * 4,
+            .hgather => g.world * g.slot * 4,
+            .pairs => 8,
+            .pairs_all => g.world * 8,
+        };
+    }
+};
+
+/// What one call computes: its rows, how its streams sit in the batch and which rows the head reads.
+pub const Head = enum { all, last, none };
+pub const HeadMode = enum { gather, picks };
+
+pub const Shape = struct {
+    rows: u32,
+    prompt: bool = false, // a prompt chunk of one stream
+    shared: bool = false, // several streams' windows in one batch (positions and table offsets per row)
+    max_pos: u32 = 0, // the largest position among the rows
+    head: Head = .all,
+    mode: HeadMode = .gather,
+};
+
+pub fn check(g: *const Geometry, sh: Shape) Error!void {
+    if (sh.rows == 0) return error.BadRows;
+    if (sh.rows > g.max_rows) return error.TooManyRows;
+    if (sh.shared and (sh.prompt or sh.rows > iface.shared_rows)) return error.TooManyRows;
+    if (sh.head == .all and sh.rows > head_rows) return error.TooManyRows;
+}
+
+/// The shipped model's launches for `sh`, in order, into `sink.emit(op)`.
+pub fn plan(g: *const Geometry, sh: Shape, sink: anytype) !void {
+    try check(g, sh);
+    const n = sh.rows;
+    try sink.emit(.{ .stage = .{ .rows = n, .shared = sh.shared } });
+    try sink.emit(.{ .embed = .{ .rows = n } });
+    try sink.emit(.{ .zero = .{ .buf = .res, .rows = n } });
+    try sink.emit(.{ .norm_add = .{ .x = .{ .buf = .emb }, .x_f32 = false, .norm = .input, .layer = 0, .y = .{ .buf = .a }, .rows = n } });
+    var l: u32 = 0;
+    while (l < g.layers) : (l += 1) {
+        try attention(g, sh, l, sink);
+        try mlp(g, sh, l, sink);
+    }
+    try head(g, sh, sink);
+}
+
+fn lin(sink: anytype, w: Lin, l: u32, x: Ref, y: Ref, n: u32, prompt: bool) !void {
+    try sink.emit(.{ .linear = .{ .w = w, .layer = l, .x = x, .y = y, .rows = n, .prompt = prompt } });
+}
+
+/// The ranks' partial sums of a block: none on one rank, else the exchange; returns the buffer holding the sum.
+fn exchange(g: *const Geometry, sh: Shape, site: tp.Site, sink: anytype) !Buf {
+    if (g.world == 1) return .part;
+    try sink.emit(.{ .exchange = .{ .form = tp.formFor(sh.rows), .site = site, .src = .part, .dst = .sum, .rows = sh.rows } });
+    return .sum;
+}
+
+/// The Gemma norm after the sum: the next norm of the stream, the layer's own post norm or the final one.
+fn normAdd(sink: anytype, x: Buf, norm: Norm, layer: u32, n: u32) !void {
+    try sink.emit(.{ .norm_add = .{ .x = .{ .buf = x }, .x_f32 = true, .norm = norm, .layer = layer, .y = .{ .buf = .a }, .rows = n } });
+}
+
+fn attention(g: *const Geometry, sh: Shape, l: u32, sink: anytype) !void {
+    const n = sh.rows;
+    const a: Ref = .{ .buf = .a };
+    try lin(sink, .q, l, a, .{ .buf = .q }, n, sh.prompt);
+    try lin(sink, .k, l, a, .{ .buf = .k }, n, sh.prompt);
+    try lin(sink, .v, l, a, .{ .buf = .v }, n, sh.prompt);
+    try sink.emit(.{ .index_proj = .{ .layer = l, .rows = n } });
+    try sink.emit(.{ .qk_rope = .{ .layer = l, .rows = n } });
+    try sink.emit(.{ .score = .{ .layer = l, .rows = n, .max_pos = sh.max_pos } });
+    try sink.emit(.{ .select = .{ .layer = l, .rows = n } });
+    try sink.emit(.{ .attend = .{ .layer = l, .rows = n } });
+    try lin(sink, .o, l, .{ .buf = .attn }, .{ .buf = .part }, n, sh.prompt);
+    try normAdd(sink, try exchange(g, sh, .attn_out, sink), .post, l, n);
+}
+
+fn swiglu(sink: anytype, l: u32, n: u32, width: u32, shared: bool) !void {
+    try sink.emit(.{ .swiglu = .{ .layer = l, .shared = shared, .n = width, .rows = n } });
+}
+
+fn mlp(g: *const Geometry, sh: Shape, l: u32, sink: anytype) !void {
+    const n = sh.rows;
+    const a: Ref = .{ .buf = .a };
+    if (!g.isMoe(l)) {
+        try lin(sink, .dense_gate, l, a, .{ .buf = .gate }, n, sh.prompt);
+        try lin(sink, .dense_up, l, a, .{ .buf = .up }, n, sh.prompt);
+        try swiglu(sink, l, n, g.dense_w, false);
+        try lin(sink, .dense_down, l, .{ .buf = .act }, .{ .buf = .part }, n, sh.prompt);
+    } else {
+        try sink.emit(.{ .router = .{ .layer = l, .rows = n } });
+        try sink.emit(.{ .route = .{ .layer = l, .rows = n } });
+        var at: u32 = 0;
+        while (at < n) : (at += expert_rows) {
+            try sink.emit(.{ .experts = .{ .layer = l, .row0 = at, .rows = @min(expert_rows, n - at) } });
+        }
+        try lin(sink, .shared_gate, l, a, .{ .buf = .gate }, n, sh.prompt);
+        try lin(sink, .shared_up, l, a, .{ .buf = .up }, n, sh.prompt);
+        try swiglu(sink, l, n, g.shared_w, true);
+        try lin(sink, .shared_down, l, .{ .buf = .act }, .{ .buf = .shr }, n, sh.prompt);
+        try sink.emit(.{ .add2 = .{ .a = .routed, .b = .shr, .out = .part, .rows = n } });
+    }
+    const next: Norm = if (l + 1 < g.layers) .input else .final;
+    try normAdd(sink, try exchange(g, sh, .ffn_out, sink), next, if (next == .input) l + 1 else l, n);
+    // the layer's output is in `res` now: the draft's tap
+    if (g.tapSlot(l)) |t| try sink.emit(.{ .tap = .{ .slot = t, .rows = n } });
+}
+
+/// The final norm ran at the end of the last layer; the head cuts this rank's rows and gathers or merges them.
+fn head(g: *const Geometry, sh: Shape, sink: anytype) !void {
+    if (sh.head == .none) return;
+    const n: u32 = if (sh.head == .all) sh.rows else 1;
+    const x: Ref = .{ .buf = .a, .row = if (sh.head == .all) 0 else sh.rows - 1 };
+    try lin(sink, .head, 0, x, .{ .buf = .hlog }, n, false);
+    switch (sh.mode) {
+        .gather => if (g.world > 1) try sink.emit(.{ .logits_gather = .{ .rows = n } }),
+        .picks => {
+            try sink.emit(.{ .local_pick = .{ .rows = n } });
+            if (g.world > 1) try sink.emit(.{ .pick_gather = .{ .rows = n } });
+        },
+    }
+}
+
+/// An op list for tests: owns the ops it was given.
+pub const Recorder = struct {
+    gpa: std.mem.Allocator,
+    ops: std.ArrayList(Op) = .empty,
+
+    pub fn emit(r: *Recorder, op: Op) !void {
+        try r.ops.append(r.gpa, op);
+    }
+
+    pub fn deinit(r: *Recorder) void {
+        r.ops.deinit(r.gpa);
+    }
+};
diff --git a/zig/src/families/minimax_m3/forward_test.zig b/zig/src/families/minimax_m3/forward_test.zig
new file mode 100644
index 0000000..b9d2573
--- /dev/null
+++ b/zig/src/families/minimax_m3/forward_test.zig
@@ -0,0 +1,570 @@
+//! Host tests of the forward planner and the prompt driver: op order against the T0 model, widths, dataflow, ranks.
+const std = @import("std");
+const plan = @import("forward_plan.zig");
+const exec = @import("forward_exec.zig");
+const fwd = @import("forward.zig");
+const prefill = @import("prefill.zig");
+const iface = @import("iface.zig");
+const tp = @import("tp.zig");
+const shard = @import("shard.zig");
+const pool = @import("pool.zig");
+const Op = plan.Op;
+const Stage = plan.Stage;
+const Buf = plan.Buf;
+const flash = &@import("config.zig").flash;
+
+fn geometry(rank: usize, world: usize, layers: u32, max_rows: u32) !plan.Geometry {
+    return plan.Geometry.of(flash, try shard.Share.of(flash, rank, world), layers, max_rows);
+}
+
+fn record(g: *const plan.Geometry, sh: plan.Shape, r: *plan.Recorder) !void {
+    try plan.plan(g, sh, r);
+}
+
+// ---------------------------------------------------------------- T0 order
+
+// What ref.zig's layerStep does, event by event (attention, then the feed-forward), with TP2's rank sum added.
+const Ev = enum { norm, q, k, v, rope_q, rope_k, index_q, index_k, rope_iq, rope_ik, cache, scores, pick, attend, o, rank_sum, residual, router, route, experts, w1, w3, act, w2, combine };
+
+const t0_attention = [_]Ev{ .norm, .q, .k, .v, .rope_q, .rope_k, .index_q, .index_k, .rope_iq, .rope_ik, .cache, .scores, .pick, .attend, .o, .rank_sum, .residual };
+const t0_dense = [_]Ev{ .norm, .w1, .w3, .act, .w2, .rank_sum, .residual };
+const t0_moe = [_]Ev{ .norm, .router, .route, .experts, .w1, .w3, .act, .w2, .combine, .rank_sum, .residual };
+
+// The device stages one T0 event list becomes: the fused norm+residual, one qk_rope after the index projections.
+fn deviceStages(a: std.mem.Allocator, events: []const Ev, moe: bool, attn: bool, world: u32, out: *std.ArrayList(Stage)) !void {
+    var rope = false;
+    for (events) |e| switch (e) {
+        .q => try out.append(a, .proj_q),
+        .k => try out.append(a, .proj_k),
+        .v => try out.append(a, .proj_v),
+        .index_q => try out.append(a, .index_proj),
+        .index_k, .rope_q, .rope_k, .rope_iq, .cache => {},
+        .rope_ik => if (!rope) {
+            try out.append(a, .qk_rope);
+            rope = true;
+        },
+        .scores => try out.append(a, .score),
+        .pick => try out.append(a, .select),
+        .attend => try out.append(a, .attend),
+        .o => try out.append(a, .proj_o),
+        .rank_sum => if (world > 1) try out.append(a, if (attn) .exchange_attn else .exchange_ffn),
+        .residual, .norm => {},
+        .router => try out.append(a, .router),
+        .route => try out.append(a, .route),
+        .experts => try out.append(a, .experts),
+        .w1 => try out.append(a, if (moe) .shared_gate else .dense_gate),
+        .w3 => try out.append(a, if (moe) .shared_up else .dense_up),
+        .act => try out.append(a, if (moe) .shared_act else .dense_act),
+        .w2 => try out.append(a, if (moe) .shared_down else .dense_down),
+        .combine => try out.append(a, .combine),
+    };
+}
+
+// The expected stages of a whole model: the layers' events with the fused norms placed where residual + norm meet.
+fn expected(a: std.mem.Allocator, layers: u32, world: u32, out: *std.ArrayList(Stage)) !void {
+    try out.appendSlice(a, &.{ .stage, .embed, .zero, .norm_in });
+    for (0..layers) |l| {
+        const moe = flash.isMoe(@intCast(l));
+        try deviceStages(a, &t0_attention, false, true, world, out);
+        try out.append(a, .norm_post);
+        try deviceStages(a, if (moe) &t0_moe else &t0_dense, moe, false, world, out);
+        // the exchange of the ffn site is the rank_sum event after w2, which deviceStages maps by position
+        try out.append(a, if (l + 1 < layers) .norm_in else .norm_final);
+    }
+    try out.append(a, .head);
+}
+
+fn stages(a: std.mem.Allocator, ops: []const Op) ![]Stage {
+    const out = try a.alloc(Stage, ops.len);
+    for (ops, out) |op, *s| s.* = plan.stageOf(op);
+    return out;
+}
+
+test "the planner's order is the T0 model's order, dense and MoE layers, one rank and two" {
+    const a = std.testing.allocator;
+    for ([_]u32{ 1, 2 }) |world| {
+        const g = try geometry(0, world, 5, 16);
+        var r: plan.Recorder = .{ .gpa = a };
+        defer r.deinit();
+        try record(&g, .{ .rows = 3 }, &r);
+        var want: std.ArrayList(Stage) = .empty;
+        defer want.deinit(a);
+        try expected(a, 5, world, &want);
+        // T0 has no logits gather of its own: take it off the end
+        const got = try stages(a, r.ops.items);
+        defer a.free(got);
+        const n = if (world > 1) got.len - 1 else got.len;
+        try std.testing.expectEqualSlices(Stage, want.items, got[0..n]);
+        if (world > 1) try std.testing.expectEqual(Stage.gather, got[n]);
+    }
+}
+
+// ---------------------------------------------------------------- dataflow
+
+const Set = std.EnumSet(Tag);
+const Tag = enum { ids, pos, row_tab, emb, res, a, q, k, v, iq_raw, ik_raw, qn, iqn, attn, part, routed, shr, sum, gate, up, act, logits_r, pick, wts, hlog, hgather, pairs, pairs_all, pages, bmax, sel };
+
+fn tag(b: Buf) Tag {
+    return std.meta.stringToEnum(Tag, @tagName(b)).?;
+}
+
+const Flow = struct {
+    r: [8]Tag = undefined,
+    nr: usize = 0,
+    w: [4]Tag = undefined,
+    nw: usize = 0,
+
+    fn of(reads: []const Tag, writes: []const Tag) Flow {
+        var f: Flow = .{};
+        @memcpy(f.r[0..reads.len], reads);
+        f.nr = reads.len;
+        @memcpy(f.w[0..writes.len], writes);
+        f.nw = writes.len;
+        return f;
+    }
+};
+
+fn flow(op: Op, shared: bool) Flow {
+    return switch (op) {
+        .stage => Flow.of(&.{}, &.{ .ids, .pos, .row_tab }),
+        .embed => Flow.of(&.{.ids}, &.{.emb}),
+        .zero => |o| Flow.of(&.{}, &.{tag(o.buf)}),
+        .norm_add => |o| Flow.of(&.{ tag(o.x.buf), .res }, &.{ .res, tag(o.y.buf) }),
+        .linear => |o| Flow.of(&.{tag(o.x.buf)}, &.{tag(o.y.buf)}),
+        .index_proj => Flow.of(&.{.a}, &.{ .iq_raw, .ik_raw }),
+        .qk_rope => if (shared) Flow.of(&.{ .q, .k, .v, .iq_raw, .ik_raw, .pos, .row_tab }, &.{ .qn, .iqn, .pages }) else Flow.of(&.{ .q, .k, .v, .iq_raw, .ik_raw }, &.{ .qn, .iqn, .pages }),
+        .score => if (shared) Flow.of(&.{ .iqn, .pages, .pos, .row_tab }, &.{.bmax}) else Flow.of(&.{ .iqn, .pages }, &.{.bmax}),
+        .select => Flow.of(&.{.bmax}, &.{.sel}),
+        .attend => Flow.of(&.{ .qn, .sel, .pages }, &.{.attn}),
+        .router => Flow.of(&.{.a}, &.{.logits_r}),
+        .route => Flow.of(&.{.logits_r}, &.{ .pick, .wts }),
+        .experts => Flow.of(&.{ .a, .pick, .wts }, &.{.routed}),
+        .swiglu => Flow.of(&.{ .gate, .up }, &.{.act}),
+        .add2 => |o| Flow.of(&.{ tag(o.a), tag(o.b) }, &.{tag(o.out)}),
+        .exchange => |o| Flow.of(&.{tag(o.src)}, &.{tag(o.dst)}),
+        .tap => Flow.of(&.{.res}, &.{}),
+        .logits_gather => Flow.of(&.{.hlog}, &.{.hgather}),
+        .local_pick => Flow.of(&.{.hlog}, &.{.pairs}),
+        .pick_gather => Flow.of(&.{.pairs}, &.{.pairs_all}),
+    };
+}
+
+fn dataflowHolds(ops: []const Op, shared: bool) !void {
+    var written: Set = .{};
+    for (ops, 0..) |op, i| {
+        const f = flow(op, shared);
+        for (f.r[0..f.nr]) |t| if (!written.contains(t)) {
+            std.debug.print("op {d} ({t}) reads {t} before anything wrote it\n", .{ i, plan.stageOf(op), t });
+            return error.ReadBeforeWrite;
+        };
+        for (f.w[0..f.nw]) |t| written.insert(t);
+    }
+}
+
+test "every op reads only what an earlier op wrote, at every width, shared or not, one rank or two" {
+    const a = std.testing.allocator;
+    for ([_]u32{ 1, 2 }) |world| for ([_]u32{ 1, 2, 3, 16, 17, 64, 128 }) |n| for ([_]bool{ false, true }) |shared| {
+        if (shared and n > iface.shared_rows) continue;
+        const g = try geometry(@intCast(world - 1), world, 4, 128);
+        var r: plan.Recorder = .{ .gpa = a };
+        defer r.deinit();
+        try record(&g, .{ .rows = n, .shared = shared, .max_pos = 4000 }, &r);
+        try dataflowHolds(r.ops.items, shared);
+    };
+}
+
+// ---------------------------------------------------------------- widths
+
+test "every width the contract names plans the same stages; only the rows differ" {
+    const a = std.testing.allocator;
+    const g = try geometry(0, 2, 5, 128);
+    var base: ?[]Stage = null;
+    defer if (base) |b| a.free(b);
+    for ([_]u32{ 1, 2, 3, 16, 17, 64, 128 }) |n| {
+        var r: plan.Recorder = .{ .gpa = a };
+        defer r.deinit();
+        try record(&g, .{ .rows = n, .max_pos = 300 }, &r);
+        const s = try stages(a, r.ops.items);
+        if (base) |b| {
+            defer a.free(s);
+            try std.testing.expectEqualSlices(Stage, b, s);
+        } else base = s;
+        for (r.ops.items) |op| switch (op) {
+            .linear => |o| try std.testing.expect(o.rows == n and !o.prompt),
+            .exchange => |o| {
+                try std.testing.expectEqual(plan.Form.gather_sum, o.form);
+                try std.testing.expectEqual(n, o.rows);
+            },
+            .experts => |o| try std.testing.expectEqual(n, o.rows),
+            .score => |o| try std.testing.expectEqual(@as(u32, 300), o.max_pos),
+            else => {},
+        };
+    }
+    var r: plan.Recorder = .{ .gpa = a };
+    defer r.deinit();
+    try std.testing.expectError(error.TooManyRows, record(&g, .{ .rows = 129 }, &r));
+    try std.testing.expectError(error.TooManyRows, record(&g, .{ .rows = iface.shared_rows + 1, .shared = true }, &r));
+    try std.testing.expectError(error.BadRows, record(&g, .{ .rows = 0 }, &r));
+    try std.testing.expect(iface.window_rows <= 128 and iface.shared_rows <= 128);
+}
+
+test "a prompt chunk: prompt kernels, one head row, the share-form sum, expert calls covering the rows" {
+    const a = std.testing.allocator;
+    const g = try geometry(1, 2, 4, iface.prefill_rows);
+    var r: plan.Recorder = .{ .gpa = a };
+    defer r.deinit();
+    try record(&g, .{ .rows = iface.prefill_rows, .prompt = true, .max_pos = 4095, .head = .last }, &r);
+    var covered: u32 = 0;
+    var exchanges: usize = 0;
+    var heads: usize = 0;
+    for (r.ops.items) |op| switch (op) {
+        .linear => |o| {
+            if (o.w == .head) {
+                heads += 1;
+                try std.testing.expectEqual(@as(u32, 1), o.rows);
+                try std.testing.expectEqual(iface.prefill_rows - 1, o.x.row);
+                try std.testing.expect(!o.prompt);
+            } else try std.testing.expect(o.prompt and o.rows == iface.prefill_rows);
+        },
+        .experts => |o| {
+            try std.testing.expectEqual(covered, o.row0);
+            try std.testing.expect(o.rows <= plan.expert_rows);
+            covered += o.rows;
+        },
+        .exchange => |o| {
+            exchanges += 1;
+            try std.testing.expectEqual(plan.Form.scatter_gather, o.form);
+        },
+        else => {},
+    };
+    try std.testing.expectEqual(@as(usize, 1), heads);
+    try std.testing.expectEqual(iface.prefill_rows, covered); // one MoE layer of four
+    try std.testing.expectEqual(@as(usize, 8), exchanges);
+    var none: plan.Recorder = .{ .gpa = a };
+    defer none.deinit();
+    try record(&g, .{ .rows = 128, .prompt = true, .head = .none }, &none);
+    try std.testing.expectEqual(Stage.norm_final, plan.stageOf(none.ops.items[none.ops.items.len - 1]));
+    try std.testing.expectError(error.TooManyRows, record(&g, .{ .rows = 256, .head = .all }, &none));
+    try std.testing.expectError(error.TooManyRows, record(&g, .{ .rows = 3, .prompt = true, .shared = true }, &none));
+}
+
+// ---------------------------------------------------------------- ranks and the TP plan
+
+test "both ranks launch the same sequence, and the exchanges are tp.zig's plan" {
+    const a = std.testing.allocator;
+    const g0 = try geometry(0, 2, 6, 16);
+    const g1 = try geometry(1, 2, 6, 16);
+    var r0: plan.Recorder = .{ .gpa = a };
+    defer r0.deinit();
+    var r1: plan.Recorder = .{ .gpa = a };
+    defer r1.deinit();
+    try record(&g0, .{ .rows = 5 }, &r0);
+    try record(&g1, .{ .rows = 5 }, &r1);
+    try std.testing.expectEqual(r0.ops.items.len, r1.ops.items.len);
+    for (r0.ops.items, r1.ops.items) |x, y| try std.testing.expect(std.meta.eql(x, y));
+    var sites: std.ArrayList(tp.Site) = .empty;
+    defer sites.deinit(a);
+    for (r0.ops.items) |op| if (op == .exchange) try sites.append(a, op.exchange.site);
+    try std.testing.expectEqual(tp.tokenExchanges(flash, 6), sites.items.len);
+    for (0..6) |l| {
+        const lp = tp.layerPlan(flash, @intCast(l));
+        for (lp, 0..) |c, i| try std.testing.expectEqual(c.site, sites.items[2 * l + i]);
+    }
+    var one: plan.Recorder = .{ .gpa = a };
+    defer one.deinit();
+    const solo = try geometry(0, 1, 6, 16);
+    try record(&solo, .{ .rows = 5 }, &one);
+    for (one.ops.items) |op| try std.testing.expect(op != .exchange and op != .logits_gather);
+}
+
+test "a MoE layer adds the routed and shared experts into one partial before its single exchange" {
+    const a = std.testing.allocator;
+    const g = try geometry(0, 2, 4, 16);
+    var r: plan.Recorder = .{ .gpa = a };
+    defer r.deinit();
+    try record(&g, .{ .rows = 4 }, &r);
+    var in_layer3 = false;
+    var exch: usize = 0;
+    var adds: usize = 0;
+    for (r.ops.items) |op| {
+        if (op == .router and op.router.layer == 3) in_layer3 = true;
+        if (!in_layer3) continue;
+        if (op == .add2) {
+            adds += 1;
+            try std.testing.expectEqual(Buf.routed, op.add2.a);
+            try std.testing.expectEqual(Buf.shr, op.add2.b);
+            try std.testing.expectEqual(Buf.part, op.add2.out);
+        }
+        if (op == .exchange) exch += 1;
+    }
+    try std.testing.expectEqual(@as(usize, 1), adds);
+    try std.testing.expectEqual(@as(usize, 1), exch); // layer 3's attention exchange came before its router
+}
+
+test "the head: padded gather bytes match tp.LogitsGather, or a pick merge" {
+    const a = std.testing.allocator;
+    const g = try geometry(0, 2, 3, 128);
+    const lg = try tp.LogitsGather.of(flash, 2);
+    try std.testing.expectEqual(@as(usize, lg.slot), g.slot);
+    try std.testing.expectEqual(lg.bytes(16), @as(usize, g.world) * 16 * g.slot * 4);
+    var r: plan.Recorder = .{ .gpa = a };
+    defer r.deinit();
+    try record(&g, .{ .rows = 16 }, &r);
+    const last = r.ops.items[r.ops.items.len - 1];
+    try std.testing.expectEqual(@as(u32, 16), last.logits_gather.rows);
+    var p: plan.Recorder = .{ .gpa = a };
+    defer p.deinit();
+    try record(&g, .{ .rows = 1, .mode = .picks }, &p);
+    try std.testing.expectEqual(Stage.pick, plan.stageOf(p.ops.items[p.ops.items.len - 2]));
+    try std.testing.expectEqual(Stage.gather, plan.stageOf(p.ops.items[p.ops.items.len - 1]));
+    const out = fwd.Forward.out(&g, .{ .rows = 16, .head = .last });
+    try std.testing.expectEqual(@as(u32, 1), out.rows);
+    try std.testing.expectEqual(@as(u32, 0), fwd.Forward.out(&g, .{ .rows = 16, .head = .none }).rows);
+}
+
+test "geometry: this rank's widths for the shipped model" {
+    const g = try geometry(0, 2, 60, 2048);
+    try std.testing.expectEqual(@as(u32, 32), g.nq);
+    try std.testing.expectEqual(@as(u32, 2), g.niq);
+    try std.testing.expectEqual(@as(u32, 2), g.kvh);
+    try std.testing.expectEqual(@as(u32, 4096), g.q_w);
+    try std.testing.expectEqual(@as(u32, 256), g.kv_w);
+    try std.testing.expectEqual(@as(u32, 6144), g.dense_w);
+    try std.testing.expectEqual(@as(u32, 1536), g.shared_w);
+    try std.testing.expectEqual(@as(u32, 1536), g.moe_w);
+    try std.testing.expectEqual(@as(u32, 782 * 128), g.slot);
+    try std.testing.expectError(error.BadThin, geometry(0, 2, 61, 16));
+    var total: usize = 0;
+    for (plan.bufs) |b| total += g.rowBytes(b) * g.capacity(b);
+    try std.testing.expect(total < (2 << 30)); // the row buffers of a 2048-row chunk stay under 2 GiB
+}
+
+test "the fp32 residual is never rounded: partials, the sum and the residual are fp32 in every norm" {
+    const a = std.testing.allocator;
+    const g = try geometry(0, 2, 4, 16);
+    var r: plan.Recorder = .{ .gpa = a };
+    defer r.deinit();
+    try record(&g, .{ .rows = 2 }, &r);
+    var norms: usize = 0;
+    for (r.ops.items) |op| if (op == .norm_add) {
+        if (norms > 0) {
+            try std.testing.expect(op.norm_add.x_f32);
+            try std.testing.expectEqual(Buf.sum, op.norm_add.x.buf);
+        }
+        norms += 1;
+    };
+    try std.testing.expectEqual(@as(usize, 4 * 2 + 1), norms);
+}
+
+// ---------------------------------------------------------------- the call and the commit
+
+test "a call's shape: one stream, a shared window, and what is refused" {
+    const ids = [_]i32{ 1, 2, 3, 4, 5 };
+    const s = try fwd.Forward.shape(.{ .ids = &ids, .pos0 = 300 });
+    try std.testing.expect(!s.shared and s.rows == 5 and s.max_pos == 304);
+    const pos = [_]i32{ 10, 11, 12, 700, 701 };
+    const segs = [_]iface.Seg{ .{ .slot = 0, .row0 = 0, .rows = 3 }, .{ .slot = 1, .row0 = 3, .rows = 2 } };
+    const sh = try fwd.Forward.shape(.{ .ids = &ids, .segs = &segs, .positions = &pos });
+    try std.testing.expect(sh.shared and sh.max_pos == 701);
+    try std.testing.expectError(error.BadCall, fwd.Forward.shape(.{ .ids = &ids, .segs = &segs }));
+    try std.testing.expectError(error.BadCall, fwd.Forward.shape(.{ .ids = &.{} }));
+    try std.testing.expectError(error.BadCall, fwd.Forward.shape(.{ .ids = &ids, .segs = segs[0..1], .positions = &pos }));
+    try std.testing.expectEqual(@as(usize, 316), try fwd.Forward.commit(300, 16, 16, false));
+    try std.testing.expectEqual(@as(usize, 303), try fwd.Forward.commit(300, 16, 3, false));
+    try std.testing.expectError(error.BadCommit, fwd.Forward.commit(300, 16, 0, false));
+    try std.testing.expectError(error.BadCommit, fwd.Forward.commit(300, 16, 17, false));
+    try std.testing.expectError(error.BadCommit, fwd.Forward.commit(0, 128, 100, true));
+}
+
+// ---------------------------------------------------------------- the prompt driver
+
+const Fake = struct {
+    cap: usize,
+    pos: usize = 0,
+    log: std.ArrayList([3]usize) = .empty, // start, rows, head (0 none, 1 last)
+    marks: std.ArrayList(u32) = .empty,
+    gates: usize = 0,
+    drew: ?usize = null,
+    cancel_after: ?usize = null,
+
+    pub fn capacity(f: *Fake) usize {
+        return f.cap;
+    }
+    pub fn gate(f: *Fake, c: ?iface.Cancel) !void {
+        f.gates += 1;
+        if (prefill.cancelled(c)) return error.Cancelled;
+    }
+    pub fn chunk(f: *Fake, ids: []const i32, start: usize, head: plan.Head) !void {
+        try std.testing.expectEqual(f.pos, start);
+        try f.log.append(std.testing.allocator, .{ start, ids.len, @intFromBool(head == .last) });
+    }
+    pub fn first(f: *Fake, len: usize) !u32 {
+        f.drew = len;
+        return 4242;
+    }
+    pub fn advance(f: *Fake, rows: usize) !void {
+        f.pos += rows;
+    }
+    fn deinit(f: *Fake) void {
+        f.log.deinit(std.testing.allocator);
+        f.marks.deinit(std.testing.allocator);
+    }
+};
+
+fn always(_: ?*anyopaque) bool {
+    return true;
+}
+
+fn onMark(ctx: *anyopaque, at: u32) void {
+    const f: *Fake = @ptrCast(@alignCast(ctx));
+    f.marks.append(std.testing.allocator, at) catch unreachable;
+}
+
+test "a prompt pass: whole-page chunks, the head only on the last, marks on chunk starts, one first token" {
+    var ids: [5000]u32 = undefined;
+    for (&ids, 0..) |*x, i| x.* = @intCast(i);
+    var f: Fake = .{ .cap = 70000 };
+    defer f.deinit();
+    const at = [_]u32{ 1024, 3200, 4992 };
+    const marks: iface.Marks = .{ .at = &at, .ctx = &f, .call = onMark };
+    try std.testing.expectEqual(@as(u32, 4242), try prefill.prefill(&f, &ids, null, null, marks));
+    var total: usize = 0;
+    for (f.log.items, 0..) |c, i| {
+        try std.testing.expectEqual(total, c[0]);
+        try std.testing.expectEqual(@as(usize, 0), c[0] % pool.page_tokens);
+        try std.testing.expect(c[1] <= iface.prefill_rows);
+        try std.testing.expectEqual(@as(usize, @intFromBool(i + 1 == f.log.items.len)), c[2]);
+        total += c[1];
+    }
+    try std.testing.expectEqual(@as(usize, 5000), total);
+    try std.testing.expectEqual(@as(usize, 5000), f.pos);
+    try std.testing.expectEqual(@as(?usize, 5000), f.drew);
+    try std.testing.expectEqualSlices(u32, &at, f.marks.items);
+    try std.testing.expectEqual(f.log.items.len, f.gates);
+    // 0-1024, 1024-3072, 3072-3200, 3200-4992, 4992-5000
+    try std.testing.expectEqual(@as(usize, 5), f.log.items.len);
+}
+
+test "a resumed pass starts at the adopted pages and ends where a fresh one does" {
+    var ids: [4100]u32 = undefined;
+    @memset(&ids, 9);
+    var fresh: Fake = .{ .cap = 70000 };
+    defer fresh.deinit();
+    _ = try prefill.prefill(&fresh, &ids, null, null, null);
+    var res: Fake = .{ .cap = 70000, .pos = 2048 };
+    defer res.deinit();
+    _ = try prefill.prefill(&res, &ids, .{ .at = 2048 }, null, null);
+    try std.testing.expectEqual(fresh.pos, res.pos);
+    try std.testing.expectEqual(@as(usize, 2048), res.log.items[0][0]);
+    try std.testing.expectEqual(@as(?usize, 4100), res.drew);
+    var bad: Fake = .{ .cap = 70000 };
+    defer bad.deinit();
+    try std.testing.expectError(error.BadResume, prefill.prefill(&bad, &ids, .{ .at = 100 }, null, null));
+    try std.testing.expectError(error.BadResume, prefill.prefill(&bad, &ids, .{ .at = 4100 }, null, null));
+    try std.testing.expectError(error.BadResume, prefill.prefill(&bad, &ids, .{ .at = 0 }, null, null));
+    var tight: Fake = .{ .cap = 4110 };
+    defer tight.deinit();
+    try std.testing.expectError(error.PromptTooLong, prefill.prefill(&tight, ids[0..4100], null, null, null));
+}
+
+test "a follower's chunk with the next id, a bad chunk, a cancel and an over-long prompt" {
+    var ids: [300]u32 = undefined;
+    @memset(&ids, 1);
+    var f: Fake = .{ .cap = 1000 };
+    defer f.deinit();
+    try std.testing.expectError(error.BadChunk, prefill.prefillChunk(&f, ids[0..129], 0, 300, null, null, null));
+    try std.testing.expectEqual(@as(?u32, null), try prefill.prefillChunk(&f, ids[0..128], 0, 300, null, null, null));
+    try std.testing.expectEqual(@as(usize, 128), f.log.items[0][1]);
+    var long: [3000]u32 = undefined;
+    @memset(&long, 3);
+    var w: Fake = .{ .cap = 5000 };
+    defer w.deinit();
+    try std.testing.expectEqual(@as(?u32, null), try prefill.prefillChunk(&w, long[0..2049], 0, 3000, null, null, null));
+    try std.testing.expectEqual(@as(usize, 2048), w.log.items[0][1]);
+    try std.testing.expectError(error.BadChunk, prefill.prefillChunk(&f, ids[0..10], 100, 300, null, null, null));
+    try std.testing.expectError(error.BadChunk, prefill.prefillChunk(&f, ids[0..0], 128, 300, null, null, null));
+    try std.testing.expectError(error.BadChunk, prefill.prefillChunk(&f, ids[0..20], 256, 270, null, null, null));
+    try std.testing.expectEqual(@as(?u32, 4242), try prefill.prefillChunk(&f, ids[128..300], 128, 300, null, null, null));
+    var g: Fake = .{ .cap = 300 };
+    defer g.deinit();
+    try std.testing.expectError(error.PromptTooLong, prefill.prefill(&g, &ids, null, null, null));
+    const stop: iface.Cancel = .{ .ptr = null, .check = always };
+    var h: Fake = .{ .cap = 1000 };
+    defer h.deinit();
+    try std.testing.expectError(error.Cancelled, prefill.prefill(&h, &ids, null, stop, null));
+    try std.testing.expectEqual(@as(usize, 0), h.log.items.len);
+    var it: prefill.Chunks = .{ .at = 0, .len = 5000 };
+    var n: usize = 0;
+    while (it.next()) |c| n += c.end - c.start;
+    try std.testing.expectEqual(@as(usize, 5000), n);
+}
+
+// ---------------------------------------------------------------- the device half compiles
+
+test "the executor, buffers and call path compile against the CUDA wrappers (no launch here)" {
+    _ = &exec.Device.emit;
+    _ = &exec.Buffers.init;
+    _ = &exec.Modules.load;
+    _ = &fwd.Forward.init;
+    _ = &fwd.Forward.run;
+    _ = &fwd.Forward.address;
+    _ = &exec.Device.status;
+}
+
+// ---------------------------------------------------------------- the dspark draft's taps
+
+test "taps add one op after each tapped layer's closing norm and nothing else: the step is the same with them off" {
+    const a = std.testing.allocator;
+    for ([_]u32{ 1, 2 }) |world| for ([_]bool{ false, true }) |shared| {
+        var off = try geometry(0, world, 6, 64);
+        var on = off;
+        on.tap_ids[0] = 1;
+        on.tap_ids[1] = 3;
+        on.tap_ids[2] = 5; // the last layer: its closing norm is the final one
+        on.n_taps = 3;
+        const sh: plan.Shape = .{ .rows = 7, .shared = shared, .max_pos = 100 };
+        var r0: plan.Recorder = .{ .gpa = a };
+        defer r0.deinit();
+        var r1: plan.Recorder = .{ .gpa = a };
+        defer r1.deinit();
+        try record(&off, sh, &r0);
+        try record(&on, sh, &r1);
+        try std.testing.expectEqual(r0.ops.items.len + 3, r1.ops.items.len);
+        var at: usize = 0;
+        var seen: u32 = 0;
+        for (r1.ops.items) |op| {
+            if (op == .tap) {
+                try std.testing.expectEqual(seen, op.tap.slot);
+                try std.testing.expectEqual(@as(u32, 7), op.tap.rows);
+                seen += 1;
+            } else {
+                try std.testing.expect(plan.stageOf(op) == plan.stageOf(r0.ops.items[at]));
+                at += 1;
+            }
+        }
+        try std.testing.expectEqual(@as(u32, 3), seen);
+        // each tap follows a norm_add that closes a layer (input of the next layer, or the final norm)
+        for (r1.ops.items, 0..) |op, i| if (op == .tap) {
+            const before = r1.ops.items[i - 1];
+            try std.testing.expect(before == .norm_add and (before.norm_add.norm == .input or before.norm_add.norm == .final));
+            try std.testing.expect(before.norm_add.x.buf == .sum or before.norm_add.x.buf == .part);
+        };
+        try std.testing.expectEqual(@as(?u32, 1), on.tapSlot(3));
+        try std.testing.expectEqual(@as(?u32, null), on.tapSlot(2));
+        try std.testing.expectEqual(@as(?u32, null), off.tapSlot(3));
+    };
+}
+
+test "a thin model that does not reach a tapped layer emits no tap for it" {
+    const a = std.testing.allocator;
+    var g = try geometry(0, 1, 2, 16);
+    g.tap_ids[0] = 1;
+    g.tap_ids[1] = 59;
+    g.n_taps = 2;
+    var r: plan.Recorder = .{ .gpa = a };
+    defer r.deinit();
+    try record(&g, .{ .rows = 3 }, &r);
+    var taps: usize = 0;
+    for (r.ops.items) |op| taps += @intFromBool(op == .tap);
+    try std.testing.expectEqual(@as(usize, 1), taps);
+}
