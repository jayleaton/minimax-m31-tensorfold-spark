diff --git a/zig/src/cuda/minimax_m3_act.zig b/zig/src/cuda/minimax_m3_act.zig
new file mode 100644
index 0000000..29a3ac4
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_act.zig
@@ -0,0 +1,134 @@
+//! minimax_m3_act.cu: MiniMax-M3.1-Flash's swigluoai as a pointwise kernel, for the dense layers 0-2 and the shared
+//! expert (plain EXL3 linears with no fused epilogue). Float64 reference: core/minimax_ref.zig `swigluoai`.
+//! alpha, limit, up_bias and the gate clamp are launch arguments: the unverified switches are not compiled in.
+const std = @import("std");
+const kernels = @import("kernels.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+
+const Driver = @import("driver.zig").Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = stream_.Stream;
+
+const threads = 256;
+
+/// act_mode values shared with the fused epilogues (exl3_experts.Layer.act_mode, exl3_block_exl3.Act.mode).
+pub const mode_upper_clamp: i32 = 2;
+pub const mode_symmetric_clamp: i32 = 3;
+
+/// swigluoai(g, u) = clamp(g) * sigmoid(alpha * clamp(g)) * (clamp(u) + up_bias); `limit` <= 0 turns the clamps off.
+pub const Params = struct {
+    alpha: f32 = 1.702,
+    limit: f32 = 7.0,
+    up_bias: f32 = 1.0,
+    symmetric_gate_clamp: bool = false,
+
+    pub fn mode(p: Params) i32 {
+        return if (p.symmetric_gate_clamp) mode_symmetric_clamp else mode_upper_clamp;
+    }
+};
+
+pub const Input = enum { bf16, f32 };
+
+/// The launch's checks, apart from the device: n and every stride positive, rows within the grid.
+pub fn check(rows: usize, n: usize, g_ld: usize, u_ld: usize, o_ld: usize) error{RowShape}!void {
+    if (n == 0 or g_ld < n or u_ld < n or o_ld < n) return error.RowShape;
+    if (rows > std.math.maxInt(i32) or n > std.math.maxInt(i32)) return error.RowShape;
+    if ((n + threads - 1) / threads > 65535) return error.RowShape;
+}
+
+pub const MiniMaxAct = struct {
+    mod: Module,
+    bf16_fn: Function,
+    f32_fn: Function,
+    route_fn: Function,
+
+    pub fn load(d: *const Driver) !MiniMaxAct {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var mod = try Module.load(d, kernels.minimax_m3_act);
+        errdefer mod.unload();
+        return .{ .mod = mod, .bf16_fn = try mod.function("tf_mm3_swigluoai_bf16"), .f32_fn = try mod.function("tf_mm3_swigluoai_f32"), .route_fn = try mod.function("tf_mm3_route_warp") };
+    }
+
+    pub fn unload(g: *MiniMaxAct) void {
+        g.mod.unload();
+    }
+
+    /// out[r, :n] = bf16(swigluoai(gate[r, :n], up[r, :n])); rows at element strides g_ld, u_ld, o_ld; `in` the gate/up type.
+    pub fn swigluoai(g: *const MiniMaxAct, s: Stream, in: Input, gate: u64, g_ld: usize, up: u64, u_ld: usize, out: u64, o_ld: usize, rows: usize, n: usize, p: Params) !void {
+        try check(rows, n, g_ld, u_ld, o_ld);
+        if (rows == 0) return;
+        const eb: usize = if (in == .bf16) 2 else 4;
+        if (gate % eb != 0 or up % eb != 0 or out % 2 != 0) return error.RowShape;
+        var a: launch_.Args = .{};
+        a.add(gate);
+        a.add(@as(i64, @intCast(g_ld)));
+        a.add(up);
+        a.add(@as(i64, @intCast(u_ld)));
+        a.add(out);
+        a.add(@as(i64, @intCast(o_ld)));
+        a.add(@as(i32, @intCast(n)));
+        a.add(p.alpha);
+        a.add(p.limit);
+        a.add(p.up_bias);
+        a.add(p.mode());
+        const f = if (in == .bf16) g.bf16_fn else g.f32_fn;
+        try launch_.launch(f, .{ .grid = .{ .x = @intCast(rows), .y = @intCast((n + threads - 1) / threads), .z = 1 }, .block = .{ .x = threads } }, s, &a);
+    }
+
+    /// fp32 logits [rows, experts] and fp32 bias (or null) into int32 picks and fp32 weights, both [rows, topk]: top `topk` by
+    /// sigmoid(logit) + bias, weights sigmoid(logit) [/ their sum] * scale. Not moe_glue's ranking (logit + bias).
+    pub fn route(g: *const MiniMaxAct, s: Stream, logits: u64, bias: ?u64, r: Route, pick: u64, wts: u64, rows: usize) !void {
+        try routeCheck(r, rows);
+        if (rows == 0) return;
+        var a: launch_.Args = .{};
+        a.add(logits);
+        a.add(bias orelse 0);
+        a.add(pick);
+        a.add(wts);
+        a.add(@as(i32, @intCast(rows)));
+        a.add(@as(i32, @intCast(r.experts)));
+        a.add(@as(i32, @intCast(r.topk)));
+        a.add(@as(i32, @intFromBool(r.normalize)));
+        a.add(r.scale);
+        try launch_.launch(g.route_fn, .{ .grid = .{ .x = @intCast((rows + 7) / 8), .y = 1, .z = 1 }, .block = .{ .x = 256 } }, s, &a);
+    }
+};
+
+/// The router's launch limits (a warp a row, 4 values a lane).
+pub const route_most_experts = 128;
+pub const route_most_topk = 32;
+
+pub const Route = struct {
+    experts: usize = 128,
+    topk: usize = 4,
+    normalize: bool = true,
+    scale: f32 = 2.0,
+};
+
+pub fn routeCheck(r: Route, rows: usize) error{RouteOutOfRange}!void {
+    if (r.experts == 0 or r.experts > route_most_experts or r.topk == 0 or r.topk > route_most_topk or r.topk > r.experts) return error.RouteOutOfRange;
+    if (rows > std.math.maxInt(i32) - 7) return error.RouteOutOfRange;
+}
+
+test "route checks" {
+    try routeCheck(.{}, 8);
+    try std.testing.expectError(error.RouteOutOfRange, routeCheck(.{ .experts = 129 }, 1));
+    try std.testing.expectError(error.RouteOutOfRange, routeCheck(.{ .topk = 0 }, 1));
+    try std.testing.expectError(error.RouteOutOfRange, routeCheck(.{ .experts = 4, .topk = 5 }, 1));
+}
+
+test "launch checks refuse empty widths, short strides and oversized grids" {
+    try check(4, 3072, 3072, 6144, 3072);
+    try std.testing.expectError(error.RowShape, check(4, 0, 1, 1, 1));
+    try std.testing.expectError(error.RowShape, check(4, 3072, 3071, 3072, 3072));
+    try std.testing.expectError(error.RowShape, check(4, 3072, 3072, 3072, 3071));
+    try std.testing.expectError(error.RowShape, check(4, 256 * 65536, 256 * 65536, 256 * 65536, 256 * 65536));
+}
+
+test "params map to the act_mode the epilogues share" {
+    try std.testing.expectEqual(@as(i32, 2), (Params{}).mode());
+    try std.testing.expectEqual(@as(i32, 3), (Params{ .symmetric_gate_clamp = true }).mode());
+}
diff --git a/zig/src/cuda/minimax_m3_dspark.zig b/zig/src/cuda/minimax_m3_dspark.zig
new file mode 100644
index 0000000..2e8b4a1
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_dspark.zig
@@ -0,0 +1,333 @@
+//! MiniMax-M3.1-Flash dspark draft kernels (minimax_m3_dspark.cu): taps, residual add, Gemma norm, per-head norm +
+const std = @import("std");
+const kernels = @import("kernels.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const memory = @import("memory.zig");
+
+const Driver = @import("driver.zig").Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = @import("stream.zig").Stream;
+
+pub const head_dim = 128;
+pub const threads = 256; // every kernel but the merge and the merge's 128
+pub const max_rot = 128;
+pub const keys = 128; // keys one attention CTA scores
+pub const k_row = 130; // padded K tile row, bf16 elements
+pub const part_floats = 132; // m, l, 2 pad, 128 accumulators
+pub const max_rows = 16; // a draft block or a verify window
+pub const max_queries = 256; // heads of a kv group x rows
+pub const topc_max = 128;
+pub const chain_max_cand = 256;
+pub const part_cap = 16 << 20; // bytes of attention partials the module holds
+pub const attn_shared: u32 = keys * k_row * 2 + keys * head_dim * 2 + 2 * 8 * head_dim * 4;
+
+pub const Error = error{ Empty, TooManyRows, BadStride, Align, BadShape, TooMuchContext, Scratch };
+
+pub const Launch = struct { grid: [3]u32, block: u32 };
+
+fn cfg(l: Launch, shared: u32) launch_.Config {
+    return .{ .grid = .{ .x = l.grid[0], .y = l.grid[1], .z = l.grid[2] }, .block = .{ .x = l.block }, .shared = shared };
+}
+
+fn aligned(p: u64, to: u64) bool {
+    return p % to == 0;
+}
+
+// ---- geometry
+
+/// One CTA a row.
+pub fn rowLaunch(rows: usize) Error!Launch {
+    if (rows == 0) return error.Empty;
+    if (rows > 65535) return error.TooManyRows;
+    return .{ .grid = .{ @intCast(rows), 1, 1 }, .block = threads };
+}
+
+pub fn addLaunch(n: usize) Error!Launch {
+    if (n == 0) return error.Empty;
+    const blocks = @min((n + threads - 1) / threads, 1 << 16);
+    return .{ .grid = .{ @intCast(blocks), 1, 1 }, .block = threads };
+}
+
+/// What an attention call splits into: the first context key, context chunks of 128 keys, and chunks in all (the
+pub const Split = struct { c0: u32, ctx_chunks: u32, chunks: u32, queries: u32 };
+
+pub fn attnSplit(a: Attn, rows: u32, p: u32, lo: u32) Error!Split {
+    if (rows == 0) return error.Empty;
+    if (rows > max_rows) return error.TooManyRows;
+    if (a.kvh == 0 or a.nq == 0 or a.nq % a.kvh != 0 or a.ring_rows == 0 or a.window == 0) return error.BadShape;
+    const rep = a.nq / a.kvh;
+    const q = rep * rows;
+    if (q > max_queries) return error.BadShape;
+    const w0: u32 = if (p + 1 > a.window) p + 1 - a.window else 0;
+    const c0 = @max(lo, w0);
+    const nctx: u32 = if (p > c0) p - c0 else 0;
+    if (nctx > a.ring_rows) return error.TooMuchContext;
+    const ctx_chunks = (nctx + keys - 1) / keys;
+    return .{ .c0 = c0, .ctx_chunks = ctx_chunks, .chunks = ctx_chunks + 1, .queries = q };
+}
+
+pub fn attnPartBytes(a: Attn, s: Split) usize {
+    return @as(usize, a.kvh) * s.chunks * s.queries * part_floats * 4;
+}
+
+pub fn topcLaunch(rows: usize, n: usize, ld: usize, c: usize) Error!Launch {
+    if (rows == 0 or n == 0 or c == 0) return error.Empty;
+    if (rows > 65535) return error.TooManyRows;
+    if (c > topc_max) return error.BadShape;
+    if (ld < n or n > std.math.maxInt(i32)) return error.BadStride;
+    return .{ .grid = .{ @intCast(rows), 1, 1 }, .block = threads };
+}
+
+pub const Heads = struct { nq: u32, kvh: u32, rot: u32, theta: f64, eps: f32, gemma: bool };
+
+pub const Attn = struct { nq: u32, kvh: u32, ring_rows: u32, window: u32, scale: f32 };
+
+pub const Chain = struct { hidden: u32, rank: u32, cand: u32, world: u32, rows: u32 };
+
+pub fn checkChain(c: Chain) Error!void {
+    if (c.rows == 0 or c.cand == 0 or c.world == 0) return error.Empty;
+    if (c.rows > max_rows or c.world * c.cand > chain_max_cand) return error.TooManyRows;
+    if (c.hidden == 0 or c.hidden % 128 != 0 or c.rank == 0 or c.rank % 32 != 0 or c.rank > 1024) return error.BadShape;
+}
+
+fn checkHeads(h: Heads, q_heads: u32) Error!void {
+    if (h.kvh == 0 or h.rot == 0 or h.rot % 2 != 0 or h.rot > max_rot) return error.BadShape;
+    if (q_heads == 0 and h.nq != 0) return error.BadShape;
+}
+
+pub const Dspark = struct {
+    mod: Module,
+    tap_fn: Function,
+    add_bf16: Function,
+    add_f32: Function,
+    norm_bf16: Function,
+    norm_f32: Function,
+    block_heads_fn: Function,
+    ring_put_fn: Function,
+    attn_fn: Function,
+    merge_fn: Function,
+    topc_fn: Function,
+    chain_fn: Function,
+    part: memory.DeviceBuffer, // attention partials, part_cap bytes
+
+    pub fn load(d: *const Driver) !Dspark {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var m = try Module.load(d, kernels.minimax_m3_dspark);
+        errdefer m.unload();
+        var part = try memory.DeviceBuffer.alloc(d, part_cap);
+        errdefer part.free();
+        const attn = try m.function("tf_mm3_ds_attn");
+        try attn.allowDynamicShared(attn_shared);
+        return .{
+            .mod = m,
+            .tap_fn = try m.function("tf_mm3_ds_tap"),
+            .add_bf16 = try m.function("tf_mm3_ds_add_bf16"),
+            .add_f32 = try m.function("tf_mm3_ds_add_f32"),
+            .norm_bf16 = try m.function("tf_mm3_ds_norm_bf16"),
+            .norm_f32 = try m.function("tf_mm3_ds_norm_f32"),
+            .block_heads_fn = try m.function("tf_mm3_ds_block_heads"),
+            .ring_put_fn = try m.function("tf_mm3_ds_ring_put"),
+            .attn_fn = attn,
+            .merge_fn = try m.function("tf_mm3_ds_attn_merge"),
+            .topc_fn = try m.function("tf_mm3_ds_topc"),
+            .chain_fn = try m.function("tf_mm3_ds_chain"),
+            .part = part,
+        };
+    }
+
+    pub fn unload(g: *Dspark) void {
+        g.part.free();
+        g.mod.unload();
+    }
+
+    /// dst bf16 [rows][dst_ld], columns [slot * hidden, (slot + 1) * hidden) = bf16(src f32 [rows][hidden]).
+    pub fn tap(g: *const Dspark, st: Stream, src: u64, dst: u64, dst_ld: usize, slot: u32, hidden: u32, rows: u32) !void {
+        const l = try rowLaunch(rows);
+        if (hidden == 0 or dst_ld < (@as(usize, slot) + 1) * hidden) return error.BadStride;
+        if (src == 0 or dst == 0 or !aligned(src, 4) or !aligned(dst, 2)) return error.Align;
+        var args: launch_.Args = .{};
+        args.add(src);
+        args.add(dst);
+        args.add(@as(i64, @intCast(dst_ld)));
+        args.add(@as(i32, @intCast(slot)));
+        args.add(@as(i32, @intCast(hidden)));
+        args.add(@as(i32, @intCast(rows)));
+        try launch_.launch(g.tap_fn, cfg(l, 0), st, &args);
+    }
+
+    /// dst f32 [n] = (a == 0 ? 0 : a[i]) + b[i]; b is bf16 or f32; a may alias dst.
+    pub fn add(g: *const Dspark, st: Stream, a: u64, b: u64, b_f32: bool, dst: u64, n: usize) !void {
+        const l = try addLaunch(n);
+        if (b == 0 or dst == 0 or !aligned(a, 4) or !aligned(dst, 4) or !aligned(b, if (b_f32) 4 else 2)) return error.Align;
+        var args: launch_.Args = .{};
+        args.add(a);
+        args.add(b);
+        args.add(dst);
+        args.add(@as(i64, @intCast(n)));
+        try launch_.launch(if (b_f32) g.add_f32 else g.add_bf16, cfg(l, 0), st, &args);
+    }
+
+    /// y bf16 [rows][hidden] = x * (1 / sqrt(mean(x^2) + eps)) * (gemma ? 1 + w : w); x f32 or bf16, w bf16 [hidden].
+    pub fn norm(g: *const Dspark, st: Stream, x: u64, x_f32: bool, w: u64, gemma: bool, y: u64, rows: u32, hidden: u32, eps: f32) !void {
+        const l = try rowLaunch(rows);
+        if (hidden == 0) return error.BadStride;
+        if (x == 0 or w == 0 or y == 0 or !aligned(x, if (x_f32) 4 else 2) or !aligned(w, 2) or !aligned(y, 2)) return error.Align;
+        var args: launch_.Args = .{};
+        args.add(x);
+        args.add(w);
+        args.add(y);
+        args.add(@as(i32, @intCast(rows)));
+        args.add(@as(i32, @intCast(hidden)));
+        args.add(eps);
+        args.add(@as(i32, @intFromBool(gemma)));
+        try launch_.launch(if (x_f32) g.norm_f32 else g.norm_bf16, cfg(l, 0), st, &args);
+    }
+
+    /// q [rows][nq * 128], k, v [rows][kvh * 128] -> qn, kn (per-head norm, RoPE at pos0 + row) and vn (a copy).
+    pub fn blockHeads(g: *const Dspark, st: Stream, h: Heads, q: u64, k: u64, v: u64, qw: u64, kw: u64, qn: u64, kn: u64, vn: u64, rows: u32, pos0: u32) !void {
+        const l = try rowLaunch(rows);
+        try checkHeads(h, h.nq);
+        if (h.nq == 0) return error.BadShape;
+        for ([_]u64{ q, k, v, qw, kw, qn, kn, vn }) |p| if (p == 0 or !aligned(p, 8)) return error.Align;
+        var args: launch_.Args = .{};
+        for ([_]u64{ q, k, v, qw, kw, qn, kn, vn }) |p| args.add(p);
+        args.add(@as(i32, @intCast(rows)));
+        args.add(@as(i32, @intCast(h.nq)));
+        args.add(@as(i32, @intCast(h.kvh)));
+        args.add(@as(i32, @intCast(h.rot)));
+        args.add(h.eps);
+        args.add(@as(i32, @intFromBool(h.gemma)));
+        args.add(h.theta);
+        args.add(@as(i32, @intCast(pos0)));
+        try launch_.launch(g.block_heads_fn, cfg(l, 0), st, &args);
+    }
+
+    /// Absorbed rows k, v [rows][kvh * 128] -> ring slot (pos0 + row) % ring_rows: norm + RoPE'd k and v as it came.
+    pub fn ringPut(g: *const Dspark, st: Stream, h: Heads, k: u64, v: u64, kw: u64, ring_k: u64, ring_v: u64, ring_rows: u32, rows: u32, pos0: u32) !void {
+        const l = try rowLaunch(rows);
+        try checkHeads(h, 0);
+        if (ring_rows == 0) return error.BadShape;
+        for ([_]u64{ k, v, kw, ring_k, ring_v }) |p| if (p == 0 or !aligned(p, 8)) return error.Align;
+        var args: launch_.Args = .{};
+        for ([_]u64{ k, v, kw, ring_k, ring_v }) |p| args.add(p);
+        args.add(@as(i32, @intCast(rows)));
+        args.add(@as(i32, @intCast(h.kvh)));
+        args.add(@as(i32, @intCast(h.rot)));
+        args.add(h.eps);
+        args.add(@as(i32, @intFromBool(h.gemma)));
+        args.add(h.theta);
+        args.add(@as(i32, @intCast(pos0)));
+        args.add(@as(i32, @intCast(ring_rows)));
+        try launch_.launch(g.ring_put_fn, cfg(l, 0), st, &args);
+    }
+
+    /// Row i (position p + i) attends ring positions max(lo, p + i + 1 - window) <= kp < p and all `rows` block rows.
+    pub fn blockAttn(g: *const Dspark, st: Stream, a: Attn, qn: u64, ring_k: u64, ring_v: u64, kn: u64, vn: u64, out: u64, rows: u32, p: u32, lo: u32) !void {
+        const s = try attnSplit(a, rows, p, lo);
+        if (attnPartBytes(a, s) > part_cap) return error.Scratch;
+        for ([_]u64{ qn, ring_k, ring_v, kn, vn }) |x| if (x == 0 or !aligned(x, 16)) return error.Align;
+        if (out == 0 or !aligned(out, 2)) return error.Align;
+        var args: launch_.Args = .{};
+        for ([_]u64{ qn, ring_k, ring_v, kn, vn, g.part.ptr }) |x| args.add(x);
+        args.add(@as(i32, @intCast(a.nq)));
+        args.add(@as(i32, @intCast(a.kvh)));
+        args.add(@as(i32, @intCast(a.ring_rows)));
+        args.add(@as(i32, @intCast(a.window)));
+        args.add(a.scale);
+        args.add(@as(i32, @intCast(rows)));
+        args.add(@as(i32, @intCast(p)));
+        args.add(@as(i32, @intCast(lo)));
+        args.add(@as(i32, @intCast(s.c0)));
+        args.add(@as(i32, @intCast(s.chunks)));
+        try launch_.launch(g.attn_fn, cfg(.{ .grid = .{ a.kvh, s.chunks, 1 }, .block = threads }, attn_shared), st, &args);
+        var m: launch_.Args = .{};
+        m.add(g.part.ptr);
+        m.add(out);
+        m.add(@as(i32, @intCast(a.nq)));
+        m.add(@as(i32, @intCast(a.kvh)));
+        m.add(@as(i32, @intCast(rows)));
+        m.add(@as(i32, @intCast(s.chunks)));
+        try launch_.launch(g.merge_fn, cfg(.{ .grid = .{ a.kvh * s.queries, 1, 1 }, .block = head_dim }, 0), st, &m);
+    }
+
+    /// The c best of each row's first n logits: out [rows][c] of {f32 logit, i32 id0 + index}; padding {-inf, -1}.
+    pub fn topC(g: *const Dspark, st: Stream, logits: u64, ld: usize, n: u32, id0: u32, rows: u32, c: u32, out: u64) !void {
+        const l = try topcLaunch(rows, n, ld, c);
+        if (logits == 0 or out == 0 or !aligned(logits, 4) or !aligned(out, 8) or @as(u64, id0) + n > std.math.maxInt(i32)) return error.Align;
+        var args: launch_.Args = .{};
+        args.add(logits);
+        args.add(@as(i64, @intCast(ld)));
+        args.add(@as(i32, @intCast(n)));
+        args.add(@as(i32, @intCast(id0)));
+        args.add(@as(i32, @intCast(c)));
+        args.add(out);
+        try launch_.launch(g.topc_fn, cfg(l, 0), st, &args);
+    }
+
+    /// The Markov chain over gathered candidates and the confidence head: out [rows] of {i32 token, f32 conf}.
+    pub fn chain(g: *const Dspark, st: Stream, c: Chain, anchor: u32, cands: u64, post: u64, w1: u64, w2: u64, conf_w: u64, conf_b: u64, out: u64) !void {
+        try checkChain(c);
+        for ([_]u64{ cands, post, conf_w, out }) |x| if (x == 0 or !aligned(x, 8)) return error.Align;
+        for ([_]u64{ w1, w2, conf_b }) |x| if (x == 0 or !aligned(x, 2)) return error.Align;
+        var args: launch_.Args = .{};
+        for ([_]u64{ cands, post, w1, w2, conf_w, conf_b, out }) |x| args.add(x);
+        args.add(@as(i32, @intCast(c.hidden)));
+        args.add(@as(i32, @intCast(c.rank)));
+        args.add(@as(i32, @intCast(c.cand)));
+        args.add(@as(i32, @intCast(c.world)));
+        args.add(@as(i32, @intCast(c.rows)));
+        args.add(anchor);
+        try launch_.launch(g.chain_fn, cfg(.{ .grid = .{ 1, 1, 1 }, .block = threads }, 0), st, &args);
+    }
+};
+
+test "launch geometry: a CTA a row, a flat add, one CTA per row of top-C" {
+    const l = try rowLaunch(7);
+    try std.testing.expectEqual([3]u32{ 7, 1, 1 }, l.grid);
+    try std.testing.expectError(error.Empty, rowLaunch(0));
+    try std.testing.expectError(error.TooManyRows, rowLaunch(70000));
+    try std.testing.expectEqual(@as(u32, 24), (try addLaunch(24 * 256)).grid[0]);
+    try std.testing.expectEqual(@as(u32, 1 << 16), (try addLaunch(1 << 30)).grid[0]);
+    try std.testing.expectError(error.Empty, addLaunch(0));
+    const t = try topcLaunch(7, 100096, 100160, 64);
+    try std.testing.expectEqual([3]u32{ 7, 1, 1 }, t.grid);
+    try std.testing.expectError(error.BadShape, topcLaunch(7, 100, 100, 129));
+    try std.testing.expectError(error.BadStride, topcLaunch(7, 100, 99, 8));
+    try std.testing.expectError(error.Empty, topcLaunch(7, 0, 0, 8));
+}
+
+test "attention splits the context into 128-key chunks after the window's start, and the block is the last chunk" {
+    const a: Attn = .{ .nq = 32, .kvh = 2, .ring_rows = 4112, .window = 4096, .scale = 0.0883883 };
+    // 5000 rows of context, a 4096 window: row 0 starts at 5000 + 1 - 4096
+    const s = try attnSplit(a, 7, 5000, 0);
+    try std.testing.expectEqual(@as(u32, 905), s.c0);
+    try std.testing.expectEqual(@as(u32, 32), s.ctx_chunks); // 4095 keys
+    try std.testing.expectEqual(@as(u32, 33), s.chunks);
+    try std.testing.expectEqual(@as(u32, 16 * 7), s.queries);
+    // a short prompt: everything from lo
+    const t = try attnSplit(a, 7, 300, 100);
+    try std.testing.expectEqual(@as(u32, 100), t.c0);
+    try std.testing.expectEqual(@as(u32, 2), t.ctx_chunks);
+    // nothing in the ring yet: the block alone
+    const u = try attnSplit(a, 7, 40, 40);
+    try std.testing.expectEqual(@as(u32, 0), u.ctx_chunks);
+    try std.testing.expectEqual(@as(u32, 1), u.chunks);
+    // more context than the ring holds is refused
+    try std.testing.expectError(error.TooMuchContext, attnSplit(.{ .nq = 32, .kvh = 2, .ring_rows = 256, .window = 4096, .scale = 1 }, 7, 5000, 0));
+    try std.testing.expectError(error.TooManyRows, attnSplit(a, 17, 10, 0));
+    try std.testing.expectError(error.BadShape, attnSplit(.{ .nq = 33, .kvh = 2, .ring_rows = 8, .window = 8, .scale = 1 }, 1, 1, 0));
+    // the partials of the shipped shape fit the module's scratch with room for 16 rows
+    try std.testing.expect(attnPartBytes(a, s) < part_cap);
+    const wide = try attnSplit(a, 16, 5000, 0);
+    try std.testing.expect(attnPartBytes(a, wide) < part_cap);
+    try std.testing.expectEqual(@as(u32, 74240), attn_shared);
+}
+
+test "chain shapes: hidden and rank whole, candidates of both ranks fit one CTA" {
+    try checkChain(.{ .hidden = 6144, .rank = 256, .cand = 64, .world = 2, .rows = 7 });
+    try std.testing.expectError(error.BadShape, checkChain(.{ .hidden = 6000, .rank = 256, .cand = 64, .world = 2, .rows = 7 }));
+    try std.testing.expectError(error.TooManyRows, checkChain(.{ .hidden = 6144, .rank = 256, .cand = 129, .world = 2, .rows = 7 }));
+    try std.testing.expectError(error.Empty, checkChain(.{ .hidden = 6144, .rank = 256, .cand = 64, .world = 0, .rows = 7 }));
+}
diff --git a/zig/src/cuda/minimax_m3_geom.zig b/zig/src/cuda/minimax_m3_geom.zig
new file mode 100644
index 0000000..4a3e425
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_geom.zig
@@ -0,0 +1,140 @@
+//! MiniMax-M3.1-Flash sparse attention: paged cache addressing, launch geometry and memory sizing (std only, host-testable).
+//! Mirrors zig/kernels/cuda/minimax_m3_sparse.cuh; the engine-port plan (sections 2 and 5) gives the numbers.
+const std = @import("std");
+
+pub const d = 128; // head_dim and index_head_dim
+pub const block = 128; // keys a selection block = tokens a page
+pub const topk = 16; // blocks a row attends
+pub const group = 16; // query heads a kv head
+pub const bf16_bytes = 2;
+
+pub const index_threads = 128;
+pub const select_threads = 256;
+pub const attn_threads = 256;
+/// Static shared bytes the attention kernel declares: sq 8 KiB + sk 8.5 KiB + sv 8 KiB + sp 2 KiB (plus 1 KiB reserved).
+pub const attn_static_shared = (group * d + group * 32) * 4 + (32 * 136 + 32 * d) * bf16_bytes;
+/// Scores a block at 1 key a warp step: the index kernel's reduction tree (32 lanes, offsets 16..1) is fixed.
+pub const max_grid_z = 65535;
+
+/// Bytes of one fp32 scale a K or V row holds in the fp8 layout.
+pub const scale_bytes = 4;
+/// Largest finite e4m3 value: a row's scale is its largest magnitude over this.
+pub const e4m3_max = 448;
+
+/// One rank's cache: `kvh` local kv heads and its layers; `kv8` is the e4m3 layout of docs/fp8-kv.md (scales after IK).
+pub const Pool = struct {
+    kvh: usize,
+    layers: usize,
+    kv8: bool = false,
+
+    /// Bytes one page holds for one layer: K and V for each local head, plus the shared index keys (and fp8's scales).
+    pub fn layerBytes(p: Pool) usize {
+        if (p.kv8) return block * (2 * p.kvh * d + d * bf16_bytes + 2 * p.kvh * scale_bytes);
+        return block * (2 * p.kvh * d + d) * bf16_bytes;
+    }
+    pub fn pageBytes(p: Pool) usize {
+        return p.layers * p.layerBytes();
+    }
+    pub fn tokenBytes(p: Pool) usize {
+        return p.pageBytes() / block;
+    }
+    pub fn layerOff(p: Pool, layer: usize) usize {
+        return layer * p.layerBytes();
+    }
+    /// Bytes a K or V value takes.
+    pub fn valueBytes(p: Pool) usize {
+        return if (p.kv8) 1 else bf16_bytes;
+    }
+    /// Byte offset from the pool base of K (which 0) or V (which 1), local head h, token t of a page, in a layer.
+    pub fn kv(p: Pool, page: usize, layer: usize, which: usize, h: usize, t: usize) usize {
+        return page * p.pageBytes() + p.layerOff(layer) + ((which * p.kvh + h) * block + t) * d * p.valueBytes();
+    }
+    /// Byte offset inside a layer region of the index keys (256 bytes a token in both layouts).
+    pub fn ikInLayer(p: Pool) usize {
+        return 2 * p.kvh * block * d * p.valueBytes();
+    }
+    pub fn ik(p: Pool, page: usize, layer: usize, t: usize) usize {
+        return page * p.pageBytes() + p.layerOff(layer) + p.ikInLayer() + t * d * bf16_bytes;
+    }
+    /// Byte offset of the fp32 scale of K (which 0) or V (which 1), head h, token t (fp8 layout only).
+    pub fn scale(p: Pool, page: usize, layer: usize, which: usize, h: usize, t: usize) usize {
+        std.debug.assert(p.kv8);
+        return page * p.pageBytes() + p.layerOff(layer) + p.ikInLayer() + block * d * bf16_bytes + ((which * p.kvh + h) * block + t) * scale_bytes;
+    }
+    pub fn pagesFor(tokens: usize) usize {
+        return (tokens + block - 1) / block;
+    }
+    /// Cache bytes of a stream holding `tokens` (whole pages).
+    pub fn bytesFor(p: Pool, tokens: usize) usize {
+        return pagesFor(tokens) * p.pageBytes();
+    }
+    /// Most tokens (a whole number of pages) that fit in `bytes`.
+    pub fn tokensFitting(p: Pool, bytes: usize) usize {
+        return bytes / p.pageBytes() * block;
+    }
+};
+
+/// Blocks a row at `pos` can see (the last is its own and may be partial).
+pub fn blocks(pos: usize) usize {
+    return pos / block + 1;
+}
+/// Valid keys of the row's own block (causal): pos % 128 + 1.
+pub fn ownKeys(pos: usize) usize {
+    return pos % block + 1;
+}
+/// Blocks a row attends: all when it has at most 16, else 16.
+pub fn selected(pos: usize) usize {
+    return @min(topk, blocks(pos));
+}
+/// Keys a row attends when its own block is among the selected (always so with the default forcing).
+pub fn keysAttended(pos: usize) usize {
+    return if (blocks(pos) <= topk) pos + 1 else (topk - 1) * block + ownKeys(pos);
+}
+/// 32-key steps the attention kernel runs for that row.
+pub fn attnSteps(pos: usize) usize {
+    const full = (selected(pos) - 1) * (block / 32);
+    return full + (ownKeys(pos) + 31) / 32;
+}
+
+pub const Launch = struct { grid: [3]u32, block: u32, dynamic_shared: u32 = 0 };
+
+/// Scoring: a CTA per (block, kv head, row); `max_pos` is the largest position of the rows.
+pub fn indexLaunch(rows: usize, kvh: usize, max_pos: usize) Launch {
+    return .{ .grid = .{ @intCast(blocks(max_pos)), @intCast(kvh), @intCast(rows) }, .block = index_threads };
+}
+pub fn selectLaunch(rows: usize, kvh: usize) Launch {
+    return .{ .grid = .{ @intCast(kvh), @intCast(rows), 1 }, .block = select_threads };
+}
+pub fn attnLaunch(rows: usize, kvh: usize) Launch {
+    return .{ .grid = .{ @intCast(rows), @intCast(kvh), 1 }, .block = attn_threads };
+}
+
+/// fp32 block maxima [rows, kvh, stride]; the stride is the block-table length (>= blocks(max_pos)).
+pub fn bmaxBytes(rows: usize, kvh: usize, stride: usize) usize {
+    return rows * kvh * stride * 4;
+}
+/// int32 selected-block lists [rows, kvh, 16].
+pub fn selBytes(rows: usize, kvh: usize) usize {
+    return rows * kvh * topk * 4;
+}
+/// IK bytes one scoring pass reads from the cache for a row at `pos` (one shared key head, 256 B a token).
+pub fn indexReadBytes(pos: usize) usize {
+    return (pos + 1) * d * bf16_bytes;
+}
+
+pub const LaunchError = error{ TooManyRows, KvHeads, Empty };
+
+pub fn check(rows: usize, kvh: usize) LaunchError!void {
+    if (rows == 0) return error.Empty;
+    if (rows > max_grid_z) return error.TooManyRows;
+    if (kvh == 0 or kvh > 4) return error.KvHeads;
+}
+
+/// The select kernel's launch arguments; the defaults are core/minimax_ref.zig's Switches defaults (UNVERIFIED upstream).
+pub const Rules = struct {
+    init_n: i32 = 0,
+    init_inclusive: bool = false,
+    local_n: i32 = 1,
+    local_trailing: bool = false,
+    higher_tie: bool = false,
+};
diff --git a/zig/src/cuda/minimax_m3_proj.zig b/zig/src/cuda/minimax_m3_proj.zig
new file mode 100644
index 0000000..70676d7
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_proj.zig
@@ -0,0 +1,127 @@
+//! MiniMax-M3.1-Flash fp16-weight index projection and per-rank greedy pick (minimax_m3_proj.cu).
+const std = @import("std");
+const kernels = @import("kernels.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+
+const Driver = @import("driver.zig").Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = stream_.Stream;
+
+pub const warps = 4; // outputs a block
+pub const row_group = 4; // rows a warp
+pub const chunk = 128; // the reduction length is a multiple: 32 lanes of 4 values
+pub const threads = warps * 32;
+pub const pick_threads = 256;
+pub const max_grid_y = 65535;
+
+/// The dtype of the projection's outputs: fp16 (`index_fp16`, the planner's `iq_raw`/`ik_raw`) or bf16.
+pub const OutType = enum(i32) { f16 = 0, bf16 = 1 };
+
+pub const Launch = struct { grid: [3]u32, block: u32 };
+pub const Error = error{ Empty, TooManyRows, BadStride, Align };
+
+/// One block per 4 outputs (of both matrices), one grid row per 4 rows.
+pub fn projLaunch(rows: usize, outputs: usize) Error!Launch {
+    if (rows == 0 or outputs == 0) return error.Empty;
+    const gy = (rows + row_group - 1) / row_group;
+    if (gy > max_grid_y) return error.TooManyRows;
+    return .{ .grid = .{ @intCast((outputs + warps - 1) / warps), @intCast(gy), 1 }, .block = threads };
+}
+
+pub fn checkProj(k: usize, x_ld: usize) Error!void {
+    if (k == 0 or k % chunk != 0 or x_ld < k or x_ld % 4 != 0) return error.BadStride;
+}
+
+/// One CTA a row; the padded row (`ld` logits) holds the rank's `n` first.
+pub fn pickLaunch(rows: usize, n: usize, ld: usize) Error!Launch {
+    if (rows == 0 or n == 0) return error.Empty;
+    if (rows > std.math.maxInt(i32)) return error.TooManyRows;
+    if (ld < n) return error.BadStride;
+    return .{ .grid = .{ @intCast(rows), 1, 1 }, .block = pick_threads };
+}
+
+/// One matrix of the projection: fp16 weights [n, k] and the [rows, n] output at `out_ld` elements a row.
+pub const Part = struct { w: u64 = 0, n: u32 = 0, out: u64 = 0, out_ld: usize = 0 };
+
+pub const Proj = struct {
+    mod: Module,
+    bf16_fn: Function,
+    f32_fn: Function,
+    pick_fn: Function,
+
+    pub fn load(d: *const Driver) !Proj {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var m = try Module.load(d, kernels.minimax_m3_proj);
+        errdefer m.unload();
+        return .{
+            .mod = m,
+            .bf16_fn = try m.function("tf_mm3_proj_bf16"),
+            .f32_fn = try m.function("tf_mm3_proj_f32"),
+            .pick_fn = try m.function("tf_mm3_pick"),
+        };
+    }
+
+    pub fn unload(g: *Proj) void {
+        g.mod.unload();
+    }
+
+    fn cfg(l: Launch) launch_.Config {
+        return .{ .grid = .{ .x = l.grid[0], .y = l.grid[1], .z = l.grid[2] }, .block = .{ .x = l.block } };
+    }
+
+    /// out_i [rows, n_i] = x [rows, k] times fp16 w_i [n_i, k] for the index query `a` and key `b` (b.n may be 0).
+    pub fn project(g: *const Proj, st: Stream, x: u64, x_ld: usize, x_f32: bool, k: u32, a: Part, b: Part, rows: usize, ot: OutType) !void {
+        const launch = try projLaunch(rows, @as(usize, a.n) + b.n);
+        try checkProj(k, x_ld);
+        for ([_]Part{ a, b }) |p| {
+            if (p.n == 0) continue;
+            if (p.w == 0 or p.out == 0 or p.out_ld < p.n or p.w % 8 != 0 or p.out % 2 != 0) return error.BadStride;
+        }
+        if (x % (if (x_f32) @as(u64, 16) else 8) != 0) return error.Align;
+        var args: launch_.Args = .{};
+        args.add(x);
+        args.add(@as(i64, @intCast(x_ld)));
+        for ([_]Part{ a, b }) |p| {
+            args.add(p.w);
+            args.add(@as(i32, @intCast(p.n)));
+            args.add(p.out);
+            args.add(@as(i64, @intCast(p.out_ld)));
+        }
+        args.add(@as(i32, @intCast(rows)));
+        args.add(@as(i32, @intCast(k)));
+        args.add(@backingInt(ot));
+        try launch_.launch(if (x_f32) g.f32_fn else g.bf16_fn, cfg(launch), st, &args);
+    }
+
+    /// pairs [rows] = (logit bits, id0 + index) of each padded row's best of `n`; ties to the lower id, NaN last.
+    pub fn pick(g: *const Proj, st: Stream, logits: u64, ld: usize, n: u32, id0: u32, rows: usize, pairs: u64) !void {
+        const launch = try pickLaunch(rows, n, ld);
+        if (logits == 0 or pairs == 0 or logits % 4 != 0 or pairs % 4 != 0 or @as(u64, id0) + n > std.math.maxInt(i32)) return error.BadStride;
+        var args: launch_.Args = .{};
+        args.add(logits);
+        args.add(@as(i64, @intCast(ld)));
+        args.add(@as(i32, @intCast(n)));
+        args.add(@as(i32, @intCast(id0)));
+        args.add(pairs);
+        try launch_.launch(g.pick_fn, cfg(launch), st, &args);
+    }
+};
+
+test "launch geometry: 4 outputs a block, 4 rows a grid row, one CTA a pick row" {
+    const l = try projLaunch(5, 384);
+    try std.testing.expectEqual([3]u32{ 96, 2, 1 }, l.grid);
+    try std.testing.expectEqual(@as(u32, 128), l.block);
+    try std.testing.expectError(error.Empty, projLaunch(0, 384));
+    try std.testing.expectError(error.Empty, projLaunch(1, 0));
+    try std.testing.expectError(error.TooManyRows, projLaunch(4 * max_grid_y + 1, 128));
+    try checkProj(6144, 6144);
+    try std.testing.expectError(error.BadStride, checkProj(6000, 6000));
+    try std.testing.expectError(error.BadStride, checkProj(6144, 6142));
+    const p = try pickLaunch(7, 100_000, 100_096);
+    try std.testing.expectEqual([3]u32{ 7, 1, 1 }, p.grid);
+    try std.testing.expectError(error.BadStride, pickLaunch(1, 10, 9));
+    try std.testing.expectError(error.Empty, pickLaunch(1, 0, 9));
+}
diff --git a/zig/src/cuda/minimax_m3_rows.zig b/zig/src/cuda/minimax_m3_rows.zig
new file mode 100644
index 0000000..b7a6670
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_rows.zig
@@ -0,0 +1,216 @@
+//! MiniMax-M3.1-Flash row kernels (minimax_m3_rows.cu): norm and RoPE into paged K/V/IK, fp32 router, table mirror.
+const std = @import("std");
+const kernels = @import("kernels.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+const memory = @import("memory.zig");
+const sp = @import("minimax_m3_sparse.zig");
+pub const geom = @import("minimax_m3_rows_geom.zig");
+
+const Driver = @import("driver.zig").Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = stream_.Stream;
+
+/// Local head counts of a rank: query heads, index query heads, kv heads, and whether the index key is written.
+pub const Heads = struct { nq: u32 = 32, niq: u32 = 2, kvh: u32 = 2, index_key: bool = true };
+
+/// Norm and rotation arguments; `w_add` (q, k) and `w_add_index` are 1 for raw Gemma weights, 0 for the folded `1 + w`.
+pub const Opts = struct {
+    rot: u32 = 64,
+    theta: f64 = 1e7,
+    eps: f32 = 1e-6,
+    w_add: f32 = 0,
+    w_add_index: f32 = 0,
+    flags: geom.Flags = .{},
+};
+
+/// Device inputs: row-major projections at element strides; the index inputs are fp16 (or bf16 per `flags.index_fp16`).
+pub const Inputs = struct {
+    q: u64,
+    q_ld: usize,
+    k: u64,
+    k_ld: usize,
+    v: u64,
+    v_ld: usize,
+    iq: u64 = 0,
+    iq_ld: usize = 0,
+    ik: u64 = 0,
+    ik_ld: usize = 0,
+};
+
+/// fp32 [128] norm weights on the device; 0 when that norm is off.
+pub const Norms = struct { q: u64 = 0, k: u64 = 0, iq: u64 = 0, ik: u64 = 0 };
+
+/// bf16 scratch rows for q [rows, nq * 128] and the index query [rows, niq * 128].
+pub const Outputs = struct { q: u64, q_ld: usize, iq: u64 = 0, iq_ld: usize = 0 };
+
+pub const Router = struct { experts: u32 = 128, k: u32 = 6144 };
+
+pub const Rows = struct {
+    mod: Module,
+    rows_fn: Function,
+    bf16_fn: Function,
+    f32_fn: Function,
+
+    pub fn load(d: *const Driver) !Rows {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var m = try Module.load(d, kernels.minimax_m3_rows);
+        errdefer m.unload();
+        return .{
+            .mod = m,
+            .rows_fn = try m.function("tf_mm3_rows"),
+            .bf16_fn = try m.function("tf_mm3_router_bf16"),
+            .f32_fn = try m.function("tf_mm3_router_f32"),
+        };
+    }
+
+    pub fn unload(g: *Rows) void {
+        g.mod.unload();
+    }
+
+    fn cfg(l: geom.Launch) launch_.Config {
+        return .{ .grid = .{ .x = l.grid[0], .y = l.grid[1], .z = l.grid[2] }, .block = .{ .x = l.block } };
+    }
+
+    /// Norm and rotate the heads of `rows` into scratch and the pages `p` names; `status` (int32 or 0) gets bits.
+    pub fn qkRope(g: *const Rows, st: Stream, h: Heads, o: Opts, in: Inputs, nm: Norms, out: Outputs, rows: sp.Rows, p: sp.Paged, max_pages: u32, status: u64) !void {
+        const launch = try geom.rowsLaunch(rows.n);
+        if (p.kvh != h.kvh or h.nq == 0 or h.nq % h.kvh != 0) return error.Heads;
+        try geom.checkRows(o.rot, h.nq * geom.d, in.q_ld);
+        try geom.checkRows(o.rot, h.nq * geom.d, out.q_ld);
+        try geom.checkRows(o.rot, h.kvh * geom.d, in.k_ld);
+        try geom.checkRows(o.rot, h.kvh * geom.d, in.v_ld);
+        if (h.niq > 0) {
+            try geom.checkRows(o.rot, h.niq * geom.d, in.iq_ld);
+            try geom.checkRows(o.rot, h.niq * geom.d, out.iq_ld);
+            if (in.iq == 0 or out.iq == 0) return error.Heads;
+        }
+        if (h.index_key) try geom.checkRows(o.rot, geom.d, in.ik_ld);
+        if (h.index_key and in.ik == 0) return error.Heads;
+        const f = o.flags;
+        if ((f.norm_qk and (nm.q == 0 or nm.k == 0)) or (f.norm_index and ((h.niq > 0 and nm.iq == 0) or (h.index_key and nm.ik == 0)))) return error.Heads;
+        if (p.tables == 0 or p.pool == 0 or max_pages == 0) return error.Heads;
+        if (f.kv8 != p.kv8) return error.Heads; // the flag and the pool's layout must say the same thing
+        var a: launch_.Args = .{};
+        a.add(in.q);
+        a.add(@as(i64, @intCast(in.q_ld)));
+        a.add(in.k);
+        a.add(@as(i64, @intCast(in.k_ld)));
+        a.add(in.v);
+        a.add(@as(i64, @intCast(in.v_ld)));
+        a.add(in.iq);
+        a.add(@as(i64, @intCast(in.iq_ld)));
+        a.add(in.ik);
+        a.add(@as(i64, @intCast(in.ik_ld)));
+        for ([_]u64{ nm.q, nm.k, nm.iq, nm.ik }) |w| a.add(w);
+        a.add(out.q);
+        a.add(@as(i64, @intCast(out.q_ld)));
+        a.add(out.iq);
+        a.add(@as(i64, @intCast(out.iq_ld)));
+        a.add(rows.pos);
+        a.add(rows.pos0);
+        a.add(p.row_tab);
+        a.add(p.tables);
+        a.add(@as(i32, @intCast(max_pages)));
+        a.add(p.pool);
+        a.add(@as(i64, @intCast(p.page_bytes)));
+        a.add(@as(i64, @intCast(p.layer_off)));
+        a.add(@as(i32, @intCast(rows.n)));
+        a.add(@as(i32, @intCast(h.nq)));
+        a.add(@as(i32, @intCast(h.niq)));
+        a.add(@as(i32, @intCast(h.kvh)));
+        a.add(@as(i32, @intFromBool(h.index_key)));
+        a.add(f.bits());
+        a.add(@as(i32, @intCast(o.rot)));
+        a.add(o.eps);
+        a.add(o.w_add);
+        a.add(o.w_add_index);
+        a.add(o.theta);
+        a.add(status);
+        try launch_.launch(g.rows_fn, cfg(launch), st, &a);
+    }
+
+    /// logits [rows, experts] fp32 = x [rows, k] times w [experts, k] fp32; x bf16, or fp32 when `x_f32`.
+    pub fn routerLogits(g: *const Rows, st: Stream, r: Router, x: u64, x_ld: usize, x_f32: bool, w: u64, out: u64, rows: usize) !void {
+        const launch = try geom.routerLaunch(rows, r.experts);
+        try geom.checkRouter(r.k, x_ld);
+        if (x % 16 != 0 or w % 16 != 0 or x_ld % 4 != 0) return error.Heads;
+        var a: launch_.Args = .{};
+        a.add(x);
+        a.add(@as(i64, @intCast(x_ld)));
+        a.add(w);
+        a.add(out);
+        a.add(@as(i32, @intCast(rows)));
+        a.add(@as(i32, @intCast(r.experts)));
+        a.add(@as(i32, @intCast(r.k)));
+        try launch_.launch(if (x_f32) g.f32_fn else g.bf16_fn, cfg(launch), st, &a);
+    }
+};
+
+/// The pool the paged kernels address: base, page and layer strides, local kv heads.
+pub const Cache = struct { pool: u64, page_bytes: u64, layer_off: u64, kvh: u32, kv8: bool = false };
+
+/// Device copy of the block tables (int32 page ids, -1 padded, `max_pages` a slot) and the per-row offsets T5 reads.
+pub const Mirror = struct {
+    tables: memory.DeviceBuffer,
+    row_tab: memory.DeviceBuffer,
+    slots: usize,
+    max_pages: usize,
+    max_rows: usize,
+
+    pub fn init(d: *const Driver, slots: usize, max_pages: usize, max_rows: usize) !Mirror {
+        _ = try geom.entryOffset(slots, max_pages);
+        var t = try memory.DeviceBuffer.alloc(d, slots * max_pages * @sizeOf(i32));
+        errdefer t.free();
+        try t.fill32(0xffffffff, null);
+        const rt = try memory.DeviceBuffer.alloc(d, max_rows * @sizeOf(i32));
+        return .{ .tables = t, .row_tab = rt, .slots = slots, .max_pages = max_pages, .max_rows = max_rows };
+    }
+
+    pub fn deinit(m: *Mirror) void {
+        m.tables.free();
+        m.row_tab.free();
+    }
+
+    /// Entries [from, from + entries.len) of `slot`'s row, copied to the device once they have landed.
+    pub fn put(m: *Mirror, slot: usize, from: usize, entries: []const i32) !void {
+        const r = try geom.entryBytes(m.slots, m.max_pages, slot, from, entries.len);
+        try m.tables.upload(r.off, std.mem.sliceAsBytes(entries));
+    }
+
+    /// kv pool Tables' `Upload.call`: pass the Mirror as its ctx.
+    pub fn call(ctx: *anyopaque, slot: u32, from: usize, entries: []const i32) anyerror!void {
+        const m: *Mirror = @ptrCast(@alignCast(ctx));
+        try m.put(slot, from, entries);
+    }
+
+    /// The whole host table (`slots * max_pages` entries) in one copy, e.g. after a restore.
+    pub fn putAll(m: *Mirror, rows: []const i32) !void {
+        if (rows.len != m.slots * m.max_pages) return error.TableFull;
+        try m.tables.upload(0, std.mem.sliceAsBytes(rows));
+    }
+
+    /// The window's per-row offsets: `host` (one entry a row) is filled from `segs` and queued on `st`.
+    pub fn setRows(m: *Mirror, st: Stream, host: []i32, segs: []const geom.Seg) !void {
+        if (host.len == 0 or host.len > m.max_rows) return error.TooManyRows;
+        try geom.fillRowTab(host, segs, m.slots, m.max_pages);
+        try m.row_tab.uploadAsync(0, std.mem.sliceAsBytes(host), st.handle);
+    }
+
+    /// Several streams' rows in one call: every row reads the table at its own `row_tab` offset.
+    pub fn shared(m: *const Mirror, c: Cache) sp.Paged {
+        return .{ .pool = c.pool, .page_bytes = c.page_bytes, .layer_off = c.layer_off, .kvh = c.kvh, .tables = m.tables.ptr, .row_tab = m.row_tab.ptr, .kv8 = c.kv8 };
+    }
+
+    /// One stream's rows (a prompt chunk): the table pointer is the slot's row and `row_tab` is 0.
+    pub fn single(m: *const Mirror, c: Cache, slot: usize) !sp.Paged {
+        const r = try geom.entryBytes(m.slots, m.max_pages, slot, 0, 0);
+        return .{ .pool = c.pool, .page_bytes = c.page_bytes, .layer_off = c.layer_off, .kvh = c.kvh, .tables = m.tables.ptr + r.off, .kv8 = c.kv8 };
+    }
+};
+
+test {
+    _ = geom;
+}
diff --git a/zig/src/cuda/minimax_m3_rows_geom.zig b/zig/src/cuda/minimax_m3_rows_geom.zig
new file mode 100644
index 0000000..212ad82
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_rows_geom.zig
@@ -0,0 +1,145 @@
+//! MiniMax-M3.1-Flash row kernels: launch geometry, flag bits and block-table arithmetic (std only, host-testable).
+const std = @import("std");
+
+pub const d = 128; // head_dim and index_head_dim
+pub const block = 128; // tokens a page
+pub const rows_threads = 256; // 8 warps, a warp a head
+pub const rows_warps = 8;
+pub const router_warps = 4; // experts a block
+pub const router_rows = 4; // rows a warp
+pub const router_chunk = 128; // reduction length is a multiple: 32 lanes of 4 values
+pub const router_threads = router_warps * 32;
+pub const max_rot = 128;
+pub const max_rot_pairs = 64;
+pub const max_grid_y = 65535;
+
+/// Bits of the kernel's `flags` argument; the defaults are core/minimax_ref.zig's Switches defaults.
+pub const Flags = struct {
+    norm_qk: bool = true,
+    norm_index: bool = true,
+    index_rope: bool = true,
+    index_fp16: bool = true,
+    round_norm: bool = false,
+    gptj: bool = false,
+    /// The pool is the fp8 layout: k and v are written as e4m3 rows with an fp32 scale each (docs/fp8-kv.md).
+    kv8: bool = false,
+
+    pub fn bits(f: Flags) i32 {
+        var b: i32 = 0;
+        if (f.norm_qk) b |= 1;
+        if (f.norm_index) b |= 2;
+        if (f.index_rope) b |= 4;
+        if (f.index_fp16) b |= 8;
+        if (f.round_norm) b |= 16;
+        if (f.gptj) b |= 32;
+        if (f.kv8) b |= 64;
+        return b;
+    }
+};
+
+/// Bits the kernel ORs into its status word.
+pub const status_no_page: i32 = 1;
+pub const status_past_table: i32 = 2;
+
+pub const Launch = struct { grid: [3]u32, block: u32 };
+
+pub const RowsError = error{ Empty, TooManyRows, BadRot, BadStride, Heads };
+
+/// Head slots a row works through: q, index q, k, v and the index key.
+pub fn slots(nq: usize, niq: usize, kvh: usize, has_ik: bool) usize {
+    return nq + niq + 2 * kvh + @intFromBool(has_ik);
+}
+
+/// One CTA a row; its warps take the slots in order.
+pub fn rowsLaunch(rows: usize) RowsError!Launch {
+    if (rows == 0) return error.Empty;
+    if (rows > std.math.maxInt(i32)) return error.TooManyRows;
+    return .{ .grid = .{ @intCast(rows), 1, 1 }, .block = rows_threads };
+}
+
+/// Rotation width must be even and fit the head; strides keep 8-byte vector loads and stores aligned.
+pub fn checkRows(rot: usize, width: usize, ld: usize) RowsError!void {
+    if (rot == 0 or rot % 2 != 0 or rot > max_rot) return error.BadRot;
+    if (width == 0 or width % d != 0 or ld < width or ld % 4 != 0) return error.BadStride;
+}
+
+pub fn routerLaunch(rows: usize, experts: usize) RowsError!Launch {
+    if (rows == 0 or experts == 0) return error.Empty;
+    const gy = (rows + router_rows - 1) / router_rows;
+    if (gy > max_grid_y) return error.TooManyRows;
+    return .{ .grid = .{ @intCast((experts + router_warps - 1) / router_warps), @intCast(gy), 1 }, .block = router_threads };
+}
+
+pub fn checkRouter(k: usize, x_ld: usize) RowsError!void {
+    if (k == 0 or k % router_chunk != 0 or x_ld < k or x_ld % 4 != 0) return error.BadStride;
+}
+
+pub const TableError = error{ BadSlot, TableFull, Overflow, NoPage, PastTable, Gap };
+
+/// Entry offset of a slot's table row inside the device copy: slot * max_pages, which must fit an int32.
+pub fn entryOffset(slot: usize, max_pages: usize) TableError!i32 {
+    const v = std.math.mul(usize, slot, max_pages) catch return error.Overflow;
+    if (v > std.math.maxInt(i32)) return error.Overflow;
+    return @intCast(v);
+}
+
+/// Byte range of entries [from, from + n) of a slot's row in the device copy.
+pub fn entryBytes(slots_n: usize, max_pages: usize, slot: usize, from: usize, n: usize) TableError!struct { off: usize, len: usize } {
+    if (slot >= slots_n) return error.BadSlot;
+    if (from > max_pages or n > max_pages - from) return error.TableFull;
+    _ = try entryOffset(slots_n, max_pages);
+    return .{ .off = (slot * max_pages + from) * @sizeOf(i32), .len = n * @sizeOf(i32) };
+}
+
+/// A stream's rows in a call: rows [row0, row0 + rows) belong to slot `slot`.
+pub const Seg = struct { slot: u32, rows: usize };
+
+/// row_tab for consecutive segments covering every row: each row's entry is its slot's offset.
+pub fn fillRowTab(out: []i32, segs: []const Seg, slots_n: usize, max_pages: usize) TableError!void {
+    var at: usize = 0;
+    for (segs) |s| {
+        if (s.slot >= slots_n) return error.BadSlot;
+        if (s.rows > out.len - at) return error.Gap;
+        const off = try entryOffset(s.slot, max_pages);
+        @memset(out[at..][0..s.rows], off);
+        at += s.rows;
+    }
+    if (at != out.len) return error.Gap;
+}
+
+/// The page the kernels read for position `pos` of the row whose table starts at entry `off` (the kernel's own lookup).
+pub fn pageOf(tables: []const i32, max_pages: usize, off: usize, pos: usize) TableError!u32 {
+    const b = pos / block;
+    if (b >= max_pages) return error.PastTable;
+    if (off + max_pages > tables.len) return error.TableFull;
+    const id = tables[off + b];
+    return if (id < 0) error.NoPage else @intCast(id);
+}
+
+/// Checks every row of a call before it launches: a page for the row's position. `row_tab` null: one table at entry 0.
+pub fn checkCall(tables: []const i32, max_pages: usize, row_tab: ?[]const i32, pos: ?[]const i32, pos0: i32, rows: usize) TableError!void {
+    for (0..rows) |r| {
+        const p: i32 = if (pos) |a| a[r] else pos0 + @as(i32, @intCast(r));
+        if (p < 0) continue;
+        const off: usize = if (row_tab) |t| @intCast(t[r]) else 0;
+        _ = try pageOf(tables, max_pages, off, @intCast(p));
+    }
+}
+
+/// Blocks (= pages) a stream with positions up to `pos` needs.
+pub fn pagesNeeded(pos: usize) usize {
+    return pos / block + 1;
+}
+
+test "launch geometry and flag bits" {
+    const l = try rowsLaunch(300);
+    try std.testing.expectEqual([3]u32{ 300, 1, 1 }, l.grid);
+    try std.testing.expectEqual(@as(u32, 256), l.block);
+    try std.testing.expectError(error.Empty, rowsLaunch(0));
+    const r = try routerLaunch(5, 128);
+    try std.testing.expectEqual([3]u32{ 32, 2, 1 }, r.grid);
+    try std.testing.expectEqual(@as(u32, 128), r.block);
+    try std.testing.expectEqual(@as(usize, 32 + 2 + 4 + 1), slots(32, 2, 2, true));
+    try std.testing.expectEqual(@as(i32, 1 | 2 | 4 | 8), (Flags{}).bits());
+    try std.testing.expectEqual(@as(i32, 16 | 32), (Flags{ .norm_qk = false, .norm_index = false, .index_rope = false, .index_fp16 = false, .round_norm = true, .gptj = true }).bits());
+}
diff --git a/zig/src/cuda/minimax_m3_sparse.zig b/zig/src/cuda/minimax_m3_sparse.zig
new file mode 100644
index 0000000..241c782
--- /dev/null
+++ b/zig/src/cuda/minimax_m3_sparse.zig
@@ -0,0 +1,146 @@
+//! MiniMax-M3.1-Flash block-sparse attention launches: index scoring + block maxima, forced-block top-16, selected-block
+//! GQA attention (zig/kernels/cuda/minimax_m3_{index,select,attn}.cu). K/V/IK live in 128-token pages addressed by page
+//! ids from block tables (geometry in minimax_m3_geom.zig). Decode rows come with positions; a prompt chunk is `pos == 0`
+//! and `pos0`. Never run on a GPU in this tree's history: see docs for what is checked.
+const std = @import("std");
+const kernels = @import("kernels.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+pub const geom = @import("minimax_m3_geom.zig");
+
+const Driver = @import("driver.zig").Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = stream_.Stream;
+
+/// The paged cache one launch reads: the pool's base, its page and layer strides, local kv heads and the block tables.
+pub const Paged = struct {
+    pool: u64,
+    page_bytes: u64,
+    layer_off: u64,
+    kvh: u32,
+    tables: u64,
+    /// int32 [rows] offsets into `tables`, or 0 when every row uses the table at its start (one stream).
+    row_tab: u64 = 0,
+    /// The pool is the fp8 layout (geom.Pool.kv8): e4m3 K/V rows with fp32 scales; false is the bf16 pool.
+    kv8: bool = false,
+};
+
+/// Rows of a call: device int32 positions [n], or 0 and `pos0` (rows pos0, pos0 + 1, ... of one stream).
+pub const Rows = struct { n: usize, pos: u64 = 0, pos0: i32 = 0 };
+
+pub const Scratch = struct {
+    /// fp32 [rows, kvh, bm_stride] and int32 [rows, kvh, 16] device buffers.
+    bmax: u64,
+    sel: u64,
+    bm_stride: usize,
+};
+
+pub const Sparse = struct {
+    index_mod: Module,
+    select_mod: Module,
+    attn_mod: Module,
+    index_fn: Function,
+    select_fn: Function,
+    attn_fn: Function,
+
+    pub fn load(d: *const Driver) !Sparse {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var im = try Module.load(d, kernels.minimax_m3_index);
+        errdefer im.unload();
+        var sm = try Module.load(d, kernels.minimax_m3_select);
+        errdefer sm.unload();
+        var am = try Module.load(d, kernels.minimax_m3_attn);
+        errdefer am.unload();
+        return .{
+            .index_mod = im,
+            .select_mod = sm,
+            .attn_mod = am,
+            .index_fn = try im.function("tf_mm3_index"),
+            .select_fn = try sm.function("tf_mm3_select"),
+            .attn_fn = try am.function("tf_mm3_attn"),
+        };
+    }
+
+    pub fn unload(s: *Sparse) void {
+        s.index_mod.unload();
+        s.select_mod.unload();
+        s.attn_mod.unload();
+    }
+
+    fn cfg(l: geom.Launch) launch_.Config {
+        return .{ .grid = .{ .x = l.grid[0], .y = l.grid[1], .z = l.grid[2] }, .block = .{ .x = l.block }, .shared = l.dynamic_shared };
+    }
+
+    /// iq [rows, kvh, 128] bf16 -> scratch.bmax; `max_pos` bounds the rows' positions (the grid's block count).
+    pub fn score(s: *const Sparse, st: Stream, iq: u64, rows: Rows, p: Paged, sc: Scratch, max_pos: usize, scale: f32) !void {
+        try geom.check(rows.n, p.kvh);
+        if (geom.blocks(max_pos) > sc.bm_stride) return error.TableTooShort;
+        var a: launch_.Args = .{};
+        a.add(iq);
+        a.add(rows.pos);
+        a.add(rows.pos0);
+        a.add(p.row_tab);
+        a.add(p.tables);
+        a.add(p.pool);
+        a.add(@as(i64, @intCast(p.page_bytes)));
+        a.add(@as(i64, @intCast(p.layer_off)));
+        a.add(@as(i32, @intCast(p.kvh)));
+        a.add(sc.bmax);
+        a.add(@as(i32, @intCast(sc.bm_stride)));
+        a.add(scale);
+        a.add(@as(i32, @intFromBool(p.kv8)));
+        try launch_.launch(s.index_fn, cfg(geom.indexLaunch(rows.n, p.kvh, max_pos)), st, &a);
+    }
+
+    /// scratch.bmax -> scratch.sel: ascending block ids per (row, kv head), -1 padded, by the forcing and tie rules.
+    pub fn select(s: *const Sparse, st: Stream, rows: Rows, kvh: usize, sc: Scratch, rules: geom.Rules) !void {
+        try geom.check(rows.n, kvh);
+        var a: launch_.Args = .{};
+        a.add(sc.bmax);
+        a.add(rows.pos);
+        a.add(rows.pos0);
+        a.add(sc.sel);
+        a.add(@as(i32, @intCast(kvh)));
+        a.add(@as(i32, @intCast(sc.bm_stride)));
+        a.add(rules.init_n);
+        a.add(@as(i32, @intFromBool(rules.init_inclusive)));
+        a.add(rules.local_n);
+        a.add(@as(i32, @intFromBool(rules.local_trailing)));
+        a.add(@as(i32, @intFromBool(rules.higher_tie)));
+        try launch_.launch(s.select_fn, cfg(geom.selectLaunch(rows.n, kvh)), st, &a);
+    }
+
+    /// q [rows, kvh * 16, 128] bf16 and scratch.sel -> out [rows, kvh * 16, 128] bf16.
+    pub fn attend(s: *const Sparse, st: Stream, q: u64, rows: Rows, p: Paged, sc: Scratch, out: u64, scale: f32) !void {
+        try geom.check(rows.n, p.kvh);
+        var a: launch_.Args = .{};
+        a.add(q);
+        a.add(sc.sel);
+        a.add(rows.pos);
+        a.add(rows.pos0);
+        a.add(p.row_tab);
+        a.add(p.tables);
+        a.add(p.pool);
+        a.add(@as(i64, @intCast(p.page_bytes)));
+        a.add(@as(i64, @intCast(p.layer_off)));
+        a.add(@as(i32, @intCast(p.kvh)));
+        a.add(out);
+        a.add(scale);
+        a.add(@as(i32, @intFromBool(p.kv8)));
+        try launch_.launch(s.attn_fn, cfg(geom.attnLaunch(rows.n, p.kvh)), st, &a);
+    }
+
+    /// The three launches of one layer's sparse attention, in order, on one stream.
+    pub fn run(s: *const Sparse, st: Stream, iq: u64, q: u64, rows: Rows, p: Paged, sc: Scratch, rules: geom.Rules, max_pos: usize, out: u64) !void {
+        const scale: f32 = @floatCast(std.math.pow(f64, geom.d, -0.5));
+        try s.score(st, iq, rows, p, sc, max_pos, scale);
+        try s.select(st, rows, p.kvh, sc, rules);
+        try s.attend(st, q, rows, p, sc, out, scale);
+    }
+};
+
+test {
+    _ = geom;
+}
