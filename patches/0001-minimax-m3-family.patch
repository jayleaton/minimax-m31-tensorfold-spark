+    // a single context chunk and the block alone still agree
+    twin.attend(&q, ck[0..50], cv[0..50], &bk, &bv, 6, scale, &got, .none);
+    attnRef(&q, ck[0..50], cv[0..50], &bk, &bv, scale, &want);
