@@ -0,0 +1,250 @@
+//! The stream state and prompt cache on pages: admission, eviction, snapshot save and restore, refusals.
+const std = @import("std");
+const kv = @import("core").kv_pool;
+const pool = @import("pool.zig");
+const state = @import("state.zig");
+const pool_test = @import("pool_test.zig");
+
+const gpa = std.testing.allocator;
+const expectEqual = std.testing.expectEqual;
+const expect = std.testing.expect;
+
+const small: @import("engine_api").prompt_radix.Rules = .{ .page = 128, .min_gap = 128, .min_prompt = 0, .tail = true };
+
+/// A pool of `n` pages, its block tables and the cache on both.
+const Rig = struct {
+    pages: kv.Pool,
+    tables: pool.Tables,
+    cache: state.Cache,
+    max_pages: usize,
+
+    fn start(r: *Rig, n: usize, max_pages: usize) !void {
+        const d = try pool_test.dims(0);
+        r.max_pages = max_pages;
+        r.pages = try kv.Pool.init(gpa, n, d.pageBytes());
+        r.tables = try pool.Tables.init(gpa, 4, max_pages);
+        try r.cache.init(gpa, &r.pages, d.layout(max_pages), small);
+    }
+
+    fn stop(r: *Rig) void {
+        r.cache.deinit();
+        r.tables.deinit();
+        r.pages.deinit();
+    }
+
+    fn admit(r: *Rig, s: *state.Stream, prompt: []const u32, history: u32, max_new: u64) !void {
+        var arena: std.heap.ArenaAllocator = .init(gpa);
+        defer arena.deinit();
+        var sink = r.tables.sink(s.slot);
+        const marks = try r.cache.admit(arena.allocator(), s, prompt, history, max_new, 16, sink.table(), r.max_pages);
+        for (marks) |m| try r.cache.keep(s, prompt, m, sink.table()); // the prefill reaching each mark
+    }
+
+    fn end(r: *Rig, s: *state.Stream) void {
+        r.cache.end(s, &r.tables);
+    }
+};
+
+fn tokens(comptime n: usize, seed: u32) [n]u32 {
+    var out: [n]u32 = undefined;
+    for (&out, 0..) |*t, i| t.* = seed * 100_000 + @as(u32, @intCast(i));
+    return out;
+}
+
+test "pages for prompt, reply and the verify window" {
+    var r: Rig = undefined;
+    try r.start(8, 8);
+    defer r.stop();
+    try expectEqual(@as(usize, 1), r.cache.need(100, 12, 16)); // 128 rows exactly
+    try expectEqual(@as(usize, 2), r.cache.need(100, 13, 16));
+    try expectEqual(@as(usize, 3), r.cache.need(300, 50, 16)); // 366 rows
+    try expectEqual(@as(usize, 1024), r.cache.need(131_000, 0, 72)); // 131,072 rows
+    var s: state.Stream = .{};
+    const p = tokens(300, 1);
+    try r.admit(&s, &p, 0, 50);
+    try expectEqual(@as(usize, 3), s.lease.ids.items.len);
+    for (s.lease.ids.items, 0..) |id, b| try expectEqual(@as(?u32, id), r.tables.page(0, b)); // the block table is the lease
+    try expectEqual(@as(?u32, null), r.tables.page(0, 3));
+    try expectEqual(@as(usize, 5), r.pages.available()); // three taken, none promised
+    r.end(&s);
+    try expect(r.pages.idle());
+}
+
+test "a kept prompt resumes from page references: the pages are the first stream's, nothing is copied" {
+    var r: Rig = undefined;
+    try r.start(16, 16);
+    defer r.stop();
+    r.cache.limit(8, 4);
+    var a: state.Stream = .{ .slot = 0 };
+    const p1 = tokens(600, 1);
+    try r.admit(&a, &p1, 0, 40);
+    const first_pages = try gpa.dupe(u32, a.lease.ids.items);
+    defer gpa.free(first_pages);
+    try expect(r.cache.live > 0); // a snapshot record was kept
+    r.end(&a);
+    // the store alone holds the kept prefix now; the rest is free
+    const c = r.pages.census();
+    try expect(c.kept > 0 and c.leased == 0 and c.promised == 0);
+    try expectEqual(c.total, c.free + c.kept);
+    // a later turn of the same conversation: the first 512 rows are the kept pages
+    var p2: [700]u32 = undefined;
+    @memcpy(p2[0..600], &p1);
+    for (p2[600..], 0..) |*t, i| t.* = 777_000 + @as(u32, @intCast(i));
+    var b: state.Stream = .{ .slot = 1 };
+    try r.admit(&b, &p2, 600, 40);
+    try expect(b.pos > 0 and b.pos % 128 == 0 and b.pos <= 600);
+    const shared = b.pos / 128;
+    try expectEqualSlices(first_pages[0..shared], b.lease.ids.items[0..shared]);
+    try expectEqual(@as(usize, 1), r.pages.leased[b.lease.ids.items[0]]);
+    try expect(r.pages.holders(b.lease.ids.items[0]) == 2); // the stream and the store
+    try expect(r.cache.store.tree.counts.hits == 1);
+    // the stream's block table starts with the shared pages
+    for (b.lease.ids.items, 0..) |id, k| try expectEqual(@as(?u32, id), r.tables.page(1, k));
+    r.end(&b);
+    r.cache.clear();
+    try expect(r.pages.idle());
+    try expectEqual(@as(usize, r.pages.total()), r.pages.nfree);
+    try expectEqual(@as(usize, 0), r.cache.live);
+}
+
+fn expectEqualSlices(a: []const u32, b: []const u32) !void {
+    try std.testing.expectEqualSlices(u32, a, b);
+}
+
+test "a restore that fails prefills from the start and drops the snapshot" {
+    var r: Rig = undefined;
+    try r.start(16, 16);
+    defer r.stop();
+    r.cache.limit(8, 4);
+    var a: state.Stream = .{};
+    const p1 = tokens(600, 2);
+    try r.admit(&a, &p1, 0, 8);
+    r.end(&a);
+    const live = r.cache.live;
+    try expect(live > 0);
+    r.cache.fail_restore = true;
+    var b: state.Stream = .{};
+    try r.admit(&b, &p1, 0, 8);
+    try expectEqual(@as(u32, 0), b.pos);
+    try expect(r.cache.store.tree.counts.failed >= 1);
+    try expect(r.cache.live < live + 1);
+    r.end(&b);
+    r.cache.clear();
+    try expect(r.pages.idle());
+    try expectEqual(@as(usize, 0), r.cache.live);
+}
+
+test "eviction: a stream that needs the pool takes the kept pages back" {
+    var r: Rig = undefined;
+    try r.start(8, 8);
+    defer r.stop();
+    r.cache.limit(8, 4);
+    var a: state.Stream = .{};
+    const p1 = tokens(600, 3);
+    try r.admit(&a, &p1, 0, 8); // 5 pages
+    r.end(&a);
+    const kept = r.pages.census().kept;
+    try expect(kept >= 3);
+    try expect(r.pages.available() < 8);
+    // an unrelated prompt of 7 pages: only possible if the store gives pages back
+    var b: state.Stream = .{};
+    const p2 = tokens(850, 4);
+    try r.admit(&b, &p2, 0, 0);
+    try expectEqual(@as(usize, 7), b.lease.ids.items.len);
+    try expect(r.cache.store.tree.counts.evicted > 0);
+    r.end(&b);
+    r.cache.clear();
+    try expect(r.pages.idle());
+    try expectEqual(@as(usize, 8), r.pages.nfree);
+}
+
+test "refusals: past the table row or the pool is final, a full pool is LaneMemory and leaves nothing leased" {
+    var r: Rig = undefined;
+    try r.start(6, 4);
+    defer r.stop();
+    var s: state.Stream = .{};
+    const long = tokens(700, 5); // 6 pages: past the 4-entry table
+    try std.testing.expectError(error.ContextTooLong, r.admit(&s, &long, 0, 0));
+    try expect(r.pages.idle());
+    var big: state.Stream = .{};
+    const four = tokens(480, 6); // 4 pages
+    try r.admit(&big, &four, 0, 0);
+    var t: state.Stream = .{ .slot = 1 };
+    const three = tokens(300, 7); // 3 pages, 2 free
+    try std.testing.expectError(error.LaneMemory, r.admit(&t, &three, 0, 0));
+    try expectEqual(@as(usize, 2), r.pages.available());
+    try expectEqual(@as(usize, 0), r.pages.promised);
+    try expectEqual(@as(usize, 0), t.lease.ids.items.len);
+    // the first stream ends and the second runs
+    r.end(&big);
+    try r.admit(&t, &three, 0, 0);
+    r.end(&t);
+    try expect(r.pages.idle());
+}
+
+test "a failed table upload gives the pages back" {
+    var r: Rig = undefined;
+    try r.start(8, 2); // a 2-entry row
+    defer r.stop();
+    var s: state.Stream = .{};
+    const p = tokens(200, 8); // 2 pages fit the row
+    try r.admit(&s, &p, 0, 0);
+    r.end(&s);
+    r.tables.upload = .{ .ctx = &r, .call = struct {
+        fn call(_: *anyopaque, _: u32, _: usize, _: []const i32) anyerror!void {
+            return error.UploadFailed;
+        }
+    }.call };
+    const q = tokens(200, 9);
+    try std.testing.expectError(error.UploadFailed, r.admit(&s, &q, 0, 0));
+    try expect(r.pages.idle());
+    try expectEqual(@as(?u32, null), r.tables.page(0, 0));
+}
+
+test "random admits, ends and limits leave every page free or the store's" {
+    var prng = std.Random.DefaultPrng.init(7);
+    const rnd = prng.random();
+    for (0..40) |seed| {
+        var r: Rig = undefined;
+        try r.start(12 + seed % 5, 12);
+        defer r.stop();
+        r.cache.limit(6, 4);
+        var live: [4]?state.Stream = @splat(null);
+        var convs: [3][1000]u32 = undefined;
+        for (&convs, 0..) |*c, k| for (c, 0..) |*t, i| {
+            t.* = if (i < 256) @intCast(i) else @intCast(100_000 * (k + 1) + i);
+        };
+        var lens: [3]u32 = @splat(0);
+        for (0..60) |_| {
+            const k = rnd.uintLessThan(usize, 3);
+            const slot = rnd.uintLessThan(usize, 4);
+            if (live[slot]) |*s| {
+                r.end(s);
+                live[slot] = null;
+            } else if (rnd.uintLessThan(u8, 4) != 0) {
+                const hist = lens[k];
+                lens[k] = @min(900, hist + 130 + rnd.uintLessThan(u32, 200));
+                var s: state.Stream = .{ .slot = @intCast(slot) };
+                r.admit(&s, convs[k][0..lens[k]], hist, rnd.uintLessThan(u64, 60)) catch |e| switch (e) {
+                    error.LaneMemory, error.ContextTooLong => continue,
+                    else => return e,
+                };
+                live[slot] = s;
+            }
+            // every page: holders are the live leases and the store; free pages are the rest
+            var refs: [20]u32 = @splat(0);
+            var promised: usize = 0;
+            for (live) |m| if (m) |s| {
+                promised += s.lease.promised;
+                for (s.lease.ids.items) |id| refs[id] += 1;
+            };
+            for (r.pages.leased, 0..) |l, id| try expect(l == refs[id]);
+            try expectEqual(promised, r.pages.promised);
+        }
+        for (&live) |*m| if (m.*) |*s| r.end(s);
+        r.cache.clear();
+        try expect(r.pages.idle());
+        try expectEqual(r.pages.total(), r.pages.nfree);
+        try expectEqual(@as(usize, 0), r.cache.live);
+    }
+}
diff --git a/zig/src/families/minimax_m3/stream.zig b/zig/src/families/minimax_m3/stream.zig
new file mode 100644
index 0000000..88310d5
--- /dev/null
+++ b/zig/src/families/minimax_m3/stream.zig
@@ -0,0 +1,523 @@
+//! The checkpoint streamer: runs coalesced into large aligned windows, read by several threads, copied in file order.
+const std = @import("std");
+const builtin = @import("builtin");
+const core = @import("core");
+const dio = core.direct_io;
+const load = @import("load.zig");
+const Catalog = load.Catalog;
+const Plan = load.Plan;
+const Sink = load.Sink;
+
+/// Told when the last run of a shard has been read: its pages can leave the page cache.
+pub const ShardEnd = struct { ctx: *anyopaque, call: *const fn (ctx: *anyopaque, shard: u16) void };
+
+pub const Options = struct {
+    /// Bytes of each aligned buffer: the most one read covers (less 8 KiB of alignment slack).
+    chunk: usize = Streamer.default_chunk,
+    /// Reader threads, so reads in flight (0: every read runs on the calling thread, as `runSerial` does).
+    threads: usize = Streamer.default_threads,
+    /// Buffers beyond one per reader: windows read ahead of the copy that waits for them.
+    ahead: usize = 2,
+    /// Runs this close (bytes between them) share a read; the bytes between are read and dropped.
+    gap: usize = Streamer.default_gap,
+    /// Most bytes one sink put carries: a device copy stages its source, so a put is kept to a size that stage reuses.
+    put_max: usize = Streamer.default_put,
+
+    /// The defaults with TF_MM3_LOAD_THREADS, _CHUNK_MIB, _GAP_KIB and _PUT_MIB applied, to tune a slow mount.
+    pub fn fromEnv() Options {
+        var o: Options = .{};
+        o.threads = envInt("TF_MM3_LOAD_THREADS", o.threads, 1);
+        o.chunk = envInt("TF_MM3_LOAD_CHUNK_MIB", o.chunk >> 20, 1) << 20;
+        o.gap = envInt("TF_MM3_LOAD_GAP_KIB", o.gap >> 10, 1) << 10;
+        o.put_max = envInt("TF_MM3_LOAD_PUT_MIB", o.put_max >> 20, 1) << 20;
+        return o;
+    }
+};
+
+/// The integer in environment variable `name` when it holds one of at least `min` and under 4096, else `fallback`.
+fn envInt(name: [:0]const u8, fallback: usize, min: usize) usize {
+    const v = std.c.getenv(name) orelse return fallback;
+    const n = std.fmt.parseInt(usize, std.mem.span(v), 10) catch return fallback;
+    return if (n >= min and n < 4096) n else fallback;
+}
+
+/// What the last `run` read, for the benchmark and the tests.
+pub const Stats = struct {
+    windows: u64 = 0, // reads planned
+    read_bytes: u64 = 0, // bytes those reads cover, gaps included (before 4 KiB widening)
+    wanted_bytes: u64 = 0, // bytes the plan asked for
+    markers: u64 = 0, // codebook markers checked
+    marker_windows: u64 = 0, // reads they took
+};
+
+/// Reads a plan's byte runs as coalesced windows with several reads in flight.
+pub const Streamer = struct {
+    gpa: std.mem.Allocator,
+    cat: *const Catalog,
+    bufs: []dio.Buffer,
+    folded: []f32,
+    ended: ?ShardEnd = null,
+    opts: Options,
+    stats: Stats = .{},
+
+    pub const default_chunk = 16 << 20;
+    pub const default_threads = 6;
+    pub const default_gap = 1 << 20;
+    pub const default_put = 4 << 20;
+
+    pub fn init(gpa: std.mem.Allocator, cat: *const Catalog, chunk: usize) !Streamer {
+        var o = Options.fromEnv();
+        if (chunk != default_chunk) o.chunk = chunk;
+        return initWith(gpa, cat, o);
+    }
+
+    pub fn initWith(gpa: std.mem.Allocator, cat: *const Catalog, opts: Options) !Streamer {
+        if (opts.chunk < 4 * dio.alignment or opts.chunk % dio.alignment != 0 or opts.put_max == 0) return error.BadChunk;
+        const n = opts.threads + opts.ahead + @intFromBool(opts.threads == 0);
+        const bufs = try gpa.alloc(dio.Buffer, n);
+        errdefer gpa.free(bufs);
+        var made: usize = 0;
+        errdefer for (bufs[0..made]) |b| gpa.free(b);
+        while (made < n) : (made += 1) bufs[made] = try gpa.alignedAlloc(u8, .fromByteUnits(dio.alignment), opts.chunk);
+        const folded = try gpa.alloc(f32, dio.fits(opts.chunk) / 2);
+        return .{ .gpa = gpa, .cat = cat, .bufs = bufs, .folded = folded, .opts = opts };
+    }
+
+    pub fn deinit(s: *Streamer) void {
+        for (s.bufs) |b| s.gpa.free(b);
+        s.gpa.free(s.bufs);
+        s.gpa.free(s.folded);
+        s.* = undefined;
+    }
+
+    /// Bytes of buffers held: the loader's whole read-side memory.
+    pub fn bufferBytes(s: *const Streamer) usize {
+        return s.bufs.len * s.opts.chunk;
+    }
+
+    /// Every EXL3 marker holds mul1, else the stream is refused before any copy; each is read once, in file order.
+    pub fn verifyMarkers(s: *Streamer, plan: *const Plan) !void {
+        const marks = try sortedMarks(s.gpa, plan);
+        defer s.gpa.free(marks);
+        var ctx: MarkCtx = .{ .plan = plan };
+        const wins = try schedule(Marks, s.gpa, .{ .marks = marks }, dio.fits(s.opts.chunk), s.opts.gap);
+        defer s.gpa.free(wins);
+        s.stats.markers = marks.len;
+        s.stats.marker_windows = wins.len;
+        try s.pipeline(Marks, wins, &ctx, MarkCtx.consume);
+    }
+
+    /// The reads `run` would make for `plan`, counted without reading anything.
+    pub fn measure(s: *const Streamer, plan: *const Plan) !Stats {
+        const room = dio.fits(s.opts.chunk);
+        var out: Stats = .{ .markers = plan.matrices.len };
+        const marks = try sortedMarks(s.gpa, plan);
+        defer s.gpa.free(marks);
+        const mw = try schedule(Marks, s.gpa, .{ .marks = marks }, room, s.opts.gap);
+        defer s.gpa.free(mw);
+        out.marker_windows = mw.len;
+        const wins = try schedule(Runs, s.gpa, .{ .plan = plan }, room, s.opts.gap);
+        defer s.gpa.free(wins);
+        out.windows = wins.len;
+        for (wins) |w| out.read_bytes += w.end - w.lo;
+        for (plan.items) |it| out.wanted_bytes += it.span.bytes();
+        return out;
+    }
+
+    pub fn run(s: *Streamer, plan: *const Plan, sink: Sink) !void {
+        try s.verifyMarkers(plan);
+        const room = dio.fits(s.opts.chunk);
+        const wins = try schedule(Runs, s.gpa, .{ .plan = plan }, room, s.opts.gap);
+        defer s.gpa.free(wins);
+        s.stats.windows = wins.len;
+        s.stats.read_bytes = 0;
+        s.stats.wanted_bytes = 0;
+        for (wins) |w| s.stats.read_bytes += w.end - w.lo;
+        var ctx: PlanCtx = .{ .s = s, .sink = sink };
+        try s.pipeline(Runs, wins, &ctx, PlanCtx.consume);
+        if (ctx.shard_open) |o| s.shardEnded(o);
+        s.stats.wanted_bytes = ctx.wanted;
+    }
+
+    fn shardEnded(s: *Streamer, shard: u16) void {
+        if (s.ended) |e| e.call(e.ctx, shard);
+    }
+
+    // ---- the pipeline: windows read by threads, consumed in order by the caller ----
+
+    fn Consume(comptime I: type) type {
+        return *const fn (ctx: *anyopaque, index: usize, w: Window(I), data: []u8) anyerror!void;
+    }
+
+    fn pipeline(s: *Streamer, comptime I: type, wins: []const Window(I), ctx: *anyopaque, consume: Consume(I)) !void {
+        if (wins.len == 0) return;
+        const want = @min(s.opts.threads, wins.len);
+        if (want == 0) return s.inline_(I, wins, ctx, consume);
+        const state = try s.gpa.alloc(std.atomic.Value(u32), wins.len);
+        defer s.gpa.free(state);
+        for (state) |*x| x.* = .init(0);
+        const fail = try s.gpa.alloc(u16, wins.len);
+        defer s.gpa.free(fail);
+        const got = try s.gpa.alloc([]u8, wins.len);
+        defer s.gpa.free(got);
+        const reads = try s.gpa.alloc(Read, wins.len);
+        defer s.gpa.free(reads);
+        for (reads, wins) |*r, w| r.* = .{ .shard = w.shard, .lo = w.lo, .len = @intCast(w.end - w.lo) };
+        var sh: Shared = .{ .s = s, .reads = reads, .state = state, .fail = fail, .got = got };
+        const threads = try s.gpa.alloc(std.Thread, want);
+        defer s.gpa.free(threads);
+        var spawned: usize = 0;
+        while (spawned < want) : (spawned += 1) {
+            threads[spawned] = std.Thread.spawn(.{}, Shared.worker, .{&sh}) catch break;
+        }
+        defer {
+            sh.abort.store(true, .release);
+            sh.bell.ring();
+            for (threads[0..spawned]) |t| t.join();
+        }
+        // no thread could start: the calling thread reads every window itself
+        if (spawned == 0) return s.inline_(I, wins, ctx, consume);
+        for (wins, 0..) |w, i| {
+            while (true) {
+                const seen = sh.bell.now();
+                if (state[i].load(.acquire) != 0) break;
+                sh.bell.wait(seen);
+            }
+            if (state[i].load(.acquire) == 2) return @errorFromInt(fail[i]);
+            try consume(ctx, i, w, got[i]);
+            sh.released.store(i + 1, .release);
+            sh.bell.ring();
+        }
+    }
+
+    fn inline_(s: *Streamer, comptime I: type, wins: []const Window(I), ctx: *anyopaque, consume: Consume(I)) !void {
+        for (wins, 0..) |w, i| {
+            const data = try s.cat.files.items[w.shard].read(s.bufs[0], w.lo, @intCast(w.end - w.lo));
+            try consume(ctx, i, w, data);
+        }
+    }
+
+    /// The old strategy, kept as the test reference and the benchmark baseline: one read per run, one at a time.
+    pub fn verifyMarkersSerial(s: *Streamer, plan: *const Plan) !void {
+        for (plan.matrices) |m| {
+            const got = try s.cat.files.items[m.marker_shard].read(s.bufs[0], m.marker_at, 4);
+            if (std.mem.readInt(u32, got[0..4], .little) != load.mul1_multiplier) {
+                std.log.warn("layer {d} {t} expert {d}: codebook marker is not mul1", .{ m.layer, m.proj, m.expert });
+                return error.BadCodebookMarker;
+            }
+        }
+    }
+
+    pub fn runSerial(s: *Streamer, plan: *const Plan, sink: Sink) !void {
+        try s.verifyMarkersSerial(plan);
+        const buf = s.bufs[0];
+        const room = dio.fits(buf.len);
+        var shard_open: ?u16 = null;
+        for (plan.items) |it| {
+            if (shard_open) |o| if (o != it.shard) s.shardEnded(o);
+            shard_open = it.shard;
+            const file = s.cat.files.items[it.shard];
+            const limit = plan.slots[it.slot].bytes;
+            if (it.fold) {
+                // a norm weight: one read, bf16 to fp32 1 + w
+                if (it.span.len > room or it.span.count != 1 or it.dst != 0) return error.BadPlan;
+                const got = try file.read(buf, it.first(), @intCast(it.span.len));
+                const out = load.foldGemma(s.folded, got);
+                try sink.put(sink.ctx, it.slot, 0, std.mem.sliceAsBytes(out));
+                continue;
+            }
+            var run_i: u64 = 0;
+            while (run_i < it.span.count) : (run_i += 1) {
+                var at = it.base + it.span.at(run_i);
+                var dst = it.dst + run_i * it.span.len;
+                var left: u64 = it.span.len;
+                while (left > 0) {
+                    const n: usize = @intCast(@min(left, room));
+                    if (dst + n > limit) return error.BadPlan;
+                    try sink.put(sink.ctx, it.slot, dst, try file.read(buf, at, n));
+                    at += n;
+                    dst += n;
+                    left -= n;
+                }
+            }
+        }
+        if (shard_open) |o| s.shardEnded(o);
+    }
+};
+
+/// A thread's wake-up: any change rings it, a waiter re-checks its condition (a futex where the OS has one).
+const Bell = struct {
+    seq: std.atomic.Value(u32) = .init(0),
+
+    fn now(b: *Bell) u32 {
+        return b.seq.load(.acquire);
+    }
+
+    fn ring(b: *Bell) void {
+        _ = b.seq.fetchAdd(1, .release);
+        if (builtin.os.tag == .linux) _ = std.os.linux.futex_3arg(&b.seq.raw, .{ .cmd = .WAKE, .private = true }, std.math.maxInt(i32));
+    }
+
+    /// Returns once the bell has rung since `seen` (or at once, spuriously).
+    fn wait(b: *Bell, seen: u32) void {
+        if (builtin.os.tag == .linux) {
+            _ = std.os.linux.futex_4arg(&b.seq.raw, .{ .cmd = .WAIT, .private = true }, seen, null);
+        } else if (b.seq.load(.acquire) == seen) std.Thread.yield() catch {};
+    }
+};
+
+/// One read: `len` bytes at absolute offset `lo` of a shard.
+const Read = struct { shard: u16, lo: u64, len: usize };
+
+const Shared = struct {
+    s: *Streamer,
+    reads: []const Read,
+    state: []std.atomic.Value(u32), // per window: 0 pending, 1 read, 2 failed
+    fail: []u16,
+    got: [][]u8,
+    next: std.atomic.Value(usize) = .init(0),
+    released: std.atomic.Value(usize) = .init(0), // windows copied: their buffers are free
+    abort: std.atomic.Value(bool) = .init(false),
+    bell: Bell = .{},
+
+    /// Claims windows in order; window i reads into buffer i % n once the copy of window i - n is done with it.
+    fn worker(sh: *Shared) void {
+        const nbuf = sh.s.bufs.len;
+        while (true) {
+            const i = sh.next.fetchAdd(1, .monotonic);
+            if (i >= sh.reads.len) return;
+            while (true) {
+                const seen = sh.bell.now();
+                if (sh.abort.load(.acquire)) return;
+                if (i < sh.released.load(.acquire) + nbuf) break;
+                sh.bell.wait(seen);
+            }
+            const r = sh.reads[i];
+            if (sh.s.cat.files.items[r.shard].read(sh.s.bufs[i % nbuf], r.lo, r.len)) |data| {
+                sh.got[i] = data;
+                sh.state[i].store(1, .release);
+            } else |e| {
+                sh.fail[i] = @intFromError(e);
+                sh.state[i].store(2, .release);
+            }
+            sh.bell.ring();
+        }
+    }
+};
+
+// ---- the schedule: runs in file order folded into windows ----
+
+/// A piece of one run still to read: `len` bytes at absolute offset `at`, bound for `dst` of `slot`.
+const Piece = struct { shard: u16, at: u64, len: u64, slot: u32, dst: u64, fold: bool };
+
+/// One read: the runs from `start` up to `stop` fall in [lo, end) of a shard, and none crosses `hard`.
+fn Window(comptime I: type) type {
+    return struct { shard: u16, lo: u64, end: u64, hard: u64, start: I, stop: I };
+}
+
+/// A plan's runs in the plan's (shard, offset) order, a run being cut where a window ends.
+const Runs = struct {
+    plan: *const Plan,
+    item: usize = 0,
+    run: u64 = 0,
+    used: u64 = 0, // bytes of the current run already taken
+
+    fn head(r: *Runs) ?Piece {
+        while (r.item < r.plan.items.len) {
+            const it = r.plan.items[r.item];
+            if (r.run < it.span.count and it.span.len > 0) return .{
+                .shard = it.shard,
+                .at = it.base + it.span.at(r.run) + r.used,
+                .len = it.span.len - r.used,
+                .slot = it.slot,
+                .dst = it.dst + r.run * it.span.len + r.used,
+                .fold = it.fold,
+            };
+            r.item += 1;
+            r.run = 0;
+            r.used = 0;
+        }
+        return null;
+    }
+
+    fn skip(r: *Runs, n: u64) void {
+        r.used += n;
+        if (r.used >= r.plan.items[r.item].span.len) {
+            r.run += 1;
+            r.used = 0;
+        }
+    }
+
+    /// Whether `a` and `b` are at the same place; each is first moved past runs with nothing in them.
+    fn same(a: *Runs, b: Runs) bool {
+        var other = b;
+        _ = a.head();
+        _ = other.head();
+        return a.item == other.item and a.run == other.run and a.used == other.used;
+    }
+
+    /// The part of `p` a window takes must stay in its slot; a norm weight is one whole run (folded as a unit).
+    fn admit(r: *const Runs, p: Piece, n: u64, room: u64) !void {
+        if (p.dst + n > r.plan.slots[p.slot].bytes) return error.BadPlan;
+        if (p.fold) {
+            const it = r.plan.items[r.item];
+            if (it.span.len > room or it.span.count != 1 or it.dst != 0) return error.BadPlan;
+        }
+    }
+};
+
+const Mark = struct { shard: u16, at: u64, matrix: u32 };
+
+/// Every matrix' marker by (shard, offset).
+fn sortedMarks(gpa: std.mem.Allocator, plan: *const Plan) ![]Mark {
+    const marks = try gpa.alloc(Mark, plan.matrices.len);
+    errdefer gpa.free(marks);
+    for (marks, plan.matrices, 0..) |*mk, m, i| mk.* = .{ .shard = m.marker_shard, .at = m.marker_at, .matrix = @intCast(i) };
+    std.mem.sort(Mark, marks, {}, struct {
+        fn less(_: void, a: Mark, b: Mark) bool {
+            return if (a.shard != b.shard) a.shard < b.shard else a.at < b.at;
+        }
+    }.less);
+    return marks;
+}
+
+/// The codebook markers, sorted by (shard, offset), four bytes each.
+const Marks = struct {
+    marks: []const Mark,
+    i: usize = 0,
+
+    fn head(r: *Marks) ?Piece {
+        if (r.i >= r.marks.len) return null;
+        const m = r.marks[r.i];
+        return .{ .shard = m.shard, .at = m.at, .len = 4, .slot = 0, .dst = 0, .fold = false };
+    }
+
+    fn skip(r: *Marks, _: u64) void {
+        r.i += 1;
+    }
+
+    fn same(a: *Marks, b: Marks) bool {
+        return a.i == b.i;
+    }
+
+    fn admit(_: *const Marks, _: Piece, _: u64, _: u64) !void {}
+};
+
+/// Folds the runs from `start` into windows of at most `room` bytes, one read each, joining runs under `gap` apart.
+fn schedule(comptime I: type, gpa: std.mem.Allocator, start: I, room: u64, gap: u64) ![]Window(I) {
+    const W = Window(I);
+    var list: std.ArrayList(W) = .empty;
+    errdefer list.deinit(gpa);
+    var it = start;
+    var open = false;
+    var w: W = undefined;
+    while (it.head()) |h| {
+        if (open and (h.shard != w.shard or h.at < w.end or h.at >= w.hard or h.at - w.end > gap)) {
+            w.stop = it;
+            try list.append(gpa, w);
+            open = false;
+        }
+        if (!open) {
+            w = .{ .shard = h.shard, .lo = h.at, .end = h.at, .hard = h.at + room, .start = it, .stop = undefined };
+            open = true;
+        }
+        const n = @min(h.len, w.hard - h.at);
+        if (h.fold and n < h.len) {
+            // a folded run is never split: it opens a window of its own
+            if (w.end == w.lo) return error.BadPlan;
+            w.stop = it;
+            try list.append(gpa, w);
+            open = false;
+            continue;
+        }
+        try it.admit(h, n, room);
+        w.end = h.at + n;
+        it.skip(n);
+    }
+    if (open) {
+        w.stop = it;
+        try list.append(gpa, w);
+    }
+    return list.toOwnedSlice(gpa);
+}
+
+/// The plan's side of the pipeline: copies a window's runs to the sink, packed per destination.
+const PlanCtx = struct {
+    s: *Streamer,
+    sink: Sink,
+    shard_open: ?u16 = null,
+    wanted: u64 = 0,
+    since_drop: u64 = 0,
+
+    /// Bytes of a file read between page-cache drops, for a file system that refused the direct read.
+    const drop_every = 512 << 20;
+
+    fn consume(ctx: *anyopaque, _: usize, w: Window(Runs), data: []u8) anyerror!void {
+        const c: *PlanCtx = @ptrCast(@alignCast(ctx));
+        if (c.shard_open) |o| if (o != w.shard) {
+            c.s.shardEnded(o);
+            c.since_drop = 0;
+        };
+        c.shard_open = w.shard;
+        const file = c.s.cat.files.items[w.shard];
+        var it = w.start;
+        var packed_to: usize = 0; // wanted bytes are packed to the front of `data` as they are met
+        var group: ?Group = null;
+        while (!it.same(w.stop)) {
+            const h = it.head().?;
+            const n: usize = @intCast(@min(h.len, w.hard - h.at));
+            const src: usize = @intCast(h.at - w.lo);
+            if (h.fold) {
+                try c.flush(&group, data, packed_to);
+                const out = load.foldGemma(c.s.folded, data[src..][0..n]);
+                try c.sink.put(c.sink.ctx, h.slot, h.dst, std.mem.sliceAsBytes(out));
+            } else {
+                if (group) |g| if (g.slot != h.slot or g.dst + (packed_to - g.from) != h.dst) try c.flush(&group, data, packed_to);
+                if (group == null) group = .{ .slot = h.slot, .dst = h.dst, .from = packed_to };
+                if (packed_to != src) @memmove(data[packed_to..][0..n], data[src..][0..n]);
+                packed_to += n;
+            }
+            c.wanted += n;
+            it.skip(n);
+        }
+        try c.flush(&group, data, packed_to);
+        c.since_drop += data.len;
+        if (c.since_drop >= drop_every) {
+            file.dropCache();
+            c.since_drop = 0;
+        }
+    }
+
+    const Group = struct { slot: u32, dst: u64, from: usize };
+
+    fn flush(c: *PlanCtx, group: *?Group, data: []u8, packed_to: usize) !void {
+        const g = group.* orelse return;
+        group.* = null;
+        var at: usize = 0;
+        const all = data[g.from..packed_to];
+        while (at < all.len) {
+            const n = @min(all.len - at, c.s.opts.put_max);
+            try c.sink.put(c.sink.ctx, g.slot, g.dst + at, all[at..][0..n]);
+            at += n;
+        }
+    }
+};
+
+/// The marker side: each marker of a window is the mul1 multiplier or the stream stops.
+const MarkCtx = struct {
+    plan: *const Plan,
+
+    fn consume(ctx: *anyopaque, _: usize, w: Window(Marks), data: []u8) anyerror!void {
+        const c: *MarkCtx = @ptrCast(@alignCast(ctx));
+        var it = w.start;
+        while (!it.same(w.stop)) : (it.skip(4)) {
+            const m = it.marks[it.i];
+            const at: usize = @intCast(m.at - w.lo);
+            if (std.mem.readInt(u32, data[at..][0..4], .little) != load.mul1_multiplier) {
+                const x = c.plan.matrices[m.matrix];
+                std.log.warn("layer {d} {t} expert {d}: codebook marker is not mul1", .{ x.layer, x.proj, x.expert });
+                return error.BadCodebookMarker;
+            }
+        }
+    }
+};
diff --git a/zig/src/families/minimax_m3/stream_test.zig b/zig/src/families/minimax_m3/stream_test.zig
new file mode 100644
index 0000000..4176c48
--- /dev/null
+++ b/zig/src/families/minimax_m3/stream_test.zig
@@ -0,0 +1,85 @@
+//! The coalescing streamer against the one-run-at-a-time streamer on the synthetic mini checkpoint, no GPU.
+const std = @import("std");
+const load = @import("load.zig");
+const synth = @import("load_synth_test.zig");
+
+const gpa = std.testing.allocator;
+
+test "the coalescing streamer puts the bytes of the one-run-at-a-time streamer, whatever the readers, buffers and gap" {
+    const io = std.testing.io;
+    const c = synth.mini();
+    var pack = synth.Pack.init();
+    defer pack.deinit();
+    try pack.all(&c);
+    const Case = struct { shards: usize, world: usize, o: load.StreamOptions };
+    const cases = [_]Case{
+        .{ .shards = 2, .world = 1, .o = .{} },
+        .{ .shards = 2, .world = 2, .o = .{} },
+        .{ .shards = 3, .world = 2, .o = .{ .chunk = 16 * 1024, .threads = 3, .gap = 0 } },
+        .{ .shards = 3, .world = 2, .o = .{ .chunk = 16 * 1024, .threads = 1, .ahead = 0, .gap = 4096 } },
+        .{ .shards = 5, .world = 2, .o = .{ .chunk = 32 * 1024, .threads = 0, .gap = 1 << 20 } },
+        .{ .shards = 1, .world = 2, .o = .{ .chunk = 20 * 1024, .threads = 8, .ahead = 1, .gap = 100, .put_max = 5000 } },
+    };
+    for (cases) |case| {
+        var dir = try synth.Dir.init(io);
+        defer dir.deinit();
+        try synth.write(io, dir.tmp.dir, &pack, .{ .shards = case.shards });
+        var cat = try load.Catalog.open(gpa, io, dir.path);
+        defer cat.deinit();
+        for (0..case.world) |rank| {
+            var plan = try synth.rankPlan(&cat, &c, rank, case.world);
+            defer plan.deinit();
+            var old = try synth.Host.init(&plan);
+            defer old.deinit();
+            var reference = try load.Streamer.init(gpa, &cat, 64 * 1024);
+            defer reference.deinit();
+            try reference.runSerial(&plan, old.sink());
+            var new = try synth.Host.init(&plan);
+            defer new.deinit();
+            var streamer = try load.Streamer.initWith(gpa, &cat, case.o);
+            defer streamer.deinit();
+            try streamer.run(&plan, new.sink());
+            for (old.bufs, new.bufs, old.written, new.written) |a, b, wa, wb| {
+                try std.testing.expectEqualSlices(u8, a, b);
+                try std.testing.expectEqual(wa, wb);
+            }
+            try synth.expectStreamed(&c, &pack, &plan, &new);
+            var runs: u64 = 0;
+            var wanted: u64 = 0;
+            for (plan.items) |it| {
+                runs += it.span.count;
+                wanted += it.span.bytes();
+            }
+            try std.testing.expectEqual(wanted, streamer.stats.wanted_bytes);
+            try std.testing.expect(streamer.stats.read_bytes >= wanted);
+            try std.testing.expectEqual(plan.matrices.len, streamer.stats.markers);
+            // coalescing is the point: with a gap the many short runs of a cut share reads
+            if (case.o.gap >= 4096 and case.world == 2) try std.testing.expect(streamer.stats.windows < runs);
+        }
+    }
+}
+
+test "a read that fails stops the coalescing streamer with that error and no put follows it" {
+    const io = std.testing.io;
+    const c = synth.mini();
+    var pack = synth.Pack.init();
+    defer pack.deinit();
+    try pack.all(&c);
+    var dir = try synth.Dir.init(io);
+    defer dir.deinit();
+    try synth.write(io, dir.tmp.dir, &pack, .{});
+    var cat = try load.Catalog.open(gpa, io, dir.path);
+    defer cat.deinit();
+    var plan = try synth.rankPlan(&cat, &c, 1, 2);
+    defer plan.deinit();
+    var host = try synth.Host.init(&plan);
+    defer host.deinit();
+    // the shards are emptied under the open descriptors after their headers were read: every read hits the end of file
+    for (0..2) |i| {
+        var fb: [48]u8 = undefined;
+        try dir.tmp.dir.writeFile(io, .{ .sub_path = synth.shardFile(&fb, i, 2), .data = "" });
+    }
+    var streamer = try load.Streamer.initWith(gpa, &cat, .{ .chunk = 16 * 1024, .threads = 3 });
+    defer streamer.deinit();
+    if (streamer.run(&plan, host.sink())) |_| return error.TestUnexpectedResult else |_| {}
+}
diff --git a/zig/src/families/minimax_m3/text_test.zig b/zig/src/families/minimax_m3/text_test.zig
new file mode 100644
index 0000000..7f081b1
--- /dev/null
+++ b/zig/src/families/minimax_m3/text_test.zig
@@ -0,0 +1,110 @@
+//! MiniMax-M3.1-Flash text side on TensorFold's engines: the checkpoint's tokenizer.json through core/tokenizer and
+//! its chat_template.jinja through core/template. Expected ids come from the Python `tokenizers` library and
+//! expected prompts from Python Jinja2 (fixtures/gen_*.py regenerate both); the comparison is byte for byte.
+const std = @import("std");
+const tokenizer = @import("tokenizer");
+const template = @import("template");
+const options = @import("mm3_options");
+
+const template_source = @embedFile("fixtures/chat_template.jinja");
+const goldens_json = @embedFile("fixtures/template_goldens.json");
+const cases_json = @embedFile("fixtures/tokenizer_cases.json");
+
+fn jsonOf(v: std.json.Value, key: []const u8) std.json.Value {
+    return if (v == .object) (v.object.get(key) orelse .null) else .null;
+}
+
+test "chat template: every golden case renders byte for byte as Python Jinja2 renders it" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const parsed = try std.json.parseFromSliceLeaky(std.json.Value, a, goldens_json, .{});
+    var compiled = try template.compile(gpa, template_source, null);
+    defer compiled.deinit();
+    var errors: usize = 0;
+    for (parsed.array.items) |case| {
+        const name = jsonOf(case, "name").string;
+        const context = jsonOf(case, "context");
+        const gen = jsonOf(case, "add_generation_prompt").bool;
+        var diag = template.Diag{};
+        defer if (diag.msg.len > 0) gpa.free(diag.msg);
+        const got = template.render(gpa, &compiled, jsonOf(case, "messages"), jsonOf(case, "tools"), context, gen, &diag);
+        if (jsonOf(case, "error") == .string) {
+            try std.testing.expectError(error.TemplateFailed, got);
+            try std.testing.expect(diag.raised);
+            try std.testing.expectEqualStrings(jsonOf(case, "error").string, diag.msg);
+            errors += 1;
+            continue;
+        }
+        const text = got catch |err| {
+            std.debug.print("case {s}: {s}: {s}\n", .{ name, @errorName(err), diag.msg });
+            return err;
+        };
+        defer gpa.free(text);
+        std.testing.expectEqualStrings(jsonOf(case, "output").string, text) catch |err| {
+            std.debug.print("case {s} differs\n", .{name});
+            return err;
+        };
+    }
+    try std.testing.expect(parsed.array.items.len >= 50);
+    try std.testing.expectEqual(@as(usize, 2), errors);
+}
+
+test "chat template: the thinking modes only change the instruction line and the generation prefix" {
+    const gpa = std.testing.allocator;
+    const msgs = "[{\"role\":\"user\",\"content\":\"hi\"}]";
+    const want = [_]struct { mode: []const u8, tail: []const u8 }{
+        .{ .mode = "\"enabled\"", .tail = "]~b]ai\n<mm:think>" },
+        .{ .mode = "\"disabled\"", .tail = "]~b]ai\n</mm:think>" },
+        .{ .mode = "\"adaptive\"", .tail = "]~b]ai\n" },
+        .{ .mode = "null", .tail = "]~b]ai\n" },
+    };
+    for (want) |w| {
+        const src = try std.fmt.allocPrint(gpa, "{{\"messages\":{s},\"thinking_mode\":{s}}}", .{ msgs, w.mode });
+        defer gpa.free(src);
+        const parsed = try std.json.parseFromSlice(std.json.Value, gpa, src, .{});
+        defer parsed.deinit();
+        const out = try template.renderChat(gpa, template_source, parsed.value.object.get("messages").?, .null, parsed.value, true, null);
+        defer gpa.free(out);
+        try std.testing.expect(std.mem.endsWith(u8, out, w.tail));
+    }
+}
+
+fn loadReal(a: std.mem.Allocator) !tokenizer.Tokenizer {
+    return tokenizer.loadTokenizer(std.testing.io, a, options.tokenizer_path) catch |err| switch (err) {
+        error.FileNotFound => {
+            std.debug.print("skipped: {s} not found (fetch the checkpoint's tokenizer.json and pass -Dmm3-tokenizer=PATH)\n", .{options.tokenizer_path});
+            return error.SkipZigTest;
+        },
+        else => return err,
+    };
+}
+
+test "tokenizer: the real tokenizer.json encodes and decodes as the Python tokenizers library does" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var tok = try loadReal(gpa);
+    defer tok.deinit();
+    const parsed = try std.json.parseFromSliceLeaky(std.json.Value, a, cases_json, .{});
+    const specials = jsonOf(parsed, "specials").object;
+    var it = specials.iterator();
+    while (it.next()) |e| try std.testing.expectEqual(@as(?u32, @intCast(e.value_ptr.integer)), tok.specialTokenId(e.key_ptr.*));
+    for (jsonOf(parsed, "cases").array.items) |case| {
+        const text = jsonOf(case, "text").string;
+        const want = jsonOf(case, "ids").array.items;
+        const ids = try tok.encode(gpa, text);
+        defer gpa.free(ids);
+        errdefer std.debug.print("text: {s}\n", .{text[0..@min(text.len, 80)]});
+        try std.testing.expectEqual(want.len, ids.len);
+        for (want, ids) |w, g| try std.testing.expectEqual(@as(u32, @intCast(w.integer)), g);
+        const back = try tok.decode(gpa, ids, false);
+        defer gpa.free(back);
+        try std.testing.expectEqualStrings(jsonOf(case, "decoded").string, back);
+        const skipped = try tok.decode(gpa, ids, true);
+        defer gpa.free(skipped);
+        try std.testing.expectEqualStrings(jsonOf(case, "decoded_skip").string, skipped);
+    }
+}
