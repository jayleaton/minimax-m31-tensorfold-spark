+    twin.head(&x, &w, 1e-6, true, 64, 1e7, 5, &good, .none);
+    twin.head(&x, &w, 1e-6, true, 64, 1e7, 5, &bad, .interleaved);
+    try testing.expect(differs(&good, &bad));
+    // dims past the rotary width are untouched by RoPE
