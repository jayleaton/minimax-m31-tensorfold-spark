# Four requests at once, each able to hold its whole CONTEXT at the same time, with MiniMax's own dspark draft on: the
# drafts profile (config/drafts.env.example) at PARALLEL=4. KEY=value lines, read, never run; scripts/config.sh reads this
# file instead of config/prod.env when CONFIG names it:
#
#   cp config/slots4.env.example config/slots4.env      on the head only; fill in the two <placeholders>
#   CONFIG=config/slots4.env scripts/serve.sh restart
#
# The two <placeholders> stop every script until they are filled in. A caller export wins over this file.
# What differs from the drafts profile, and why (tests/test_repo.py holds the list):
#   PARALLEL=4                four streams share the KV pool, each with its own draft ring (21 MB a rank); their decode
#                             windows verify in one forward. Each concurrent reply equals its alone reply (measured).
#   CONTEXT=40960             the longest prompt + reply every one of the four can hold at once. The pool is one shared
#                             room, not CONTEXT x PARALLEL reserved: a request takes prompt + max_tokens pages when it
#                             starts and waits in the queue while they are not free.
#     python3 scripts/quant_budget.py --serve --context 40960 --parallel 4 --kv fp8 --reserve-gib 8 --drafter
#                             -> KV room 8.26 GiB (188,416 tokens, 1,472 pages); 4 x 40,960 + windows needs 1,284 pages
#                             The engine's start line ("4 streams at once, 4 taking P pages") is the real pool, about 7 %
#                             under the calculator's on our pair: 4 x ceil((CONTEXT + 16) / 128) must stay <= P.
#   MEM_GATE_GIB=117          the calculator's for that profile (the draft, its four rings and the KV of 4 x CONTEXT)
#   ENGINE_PATCHES/COMMIT     engine/patches at the production profile's ENGINE_COMMIT (mm3/window-all-3: slots, shared
#                             prompt passes and mm3/slots-draft, so a long prompt fills a chunk at a time beside the other
#                             three streams' decode instead of stalling them)
#   TF_MM3_DRAFT_DEPTH=3      the depth window-all-3 measured at four streams (job 411: 52.0 tok/s aggregate on code T0,
#   TF_MM3_DSPARK_CHANCES=    48/48 replies equal alone); depth by confidence (TF_MM3_DSPARK_CHANCES, TF_MM3_CALIB) is
#   TF_MM3_CALIB=             measured at one stream only. Drafts off decoded 65.5 at four streams (window-all-2):
#                             at four busy streams DRAFTS=0 DRAFTER= is faster
# Longer single requests at the same memory: CONTEXT=131072 keeps PARALLEL=4 but a long request then holds most of the
# pool and the others wait for it; set MAX_TOKENS so short requests reserve little.
# Everything else is the drafts profile, unchanged.

# -- nodes -------------------------------------------------------------------------------------------------------------------
# This Spark (the head, rank 0, the API; the image is built here) and the worker (rank 1) by its CX7 link address.
# WORKER's user needs docker and passwordless sudo -n there (the cache drops); root@<link address> is fine when the
# worker's own account has neither. Its home (/root for root) is where a ~/ on the worker resolves.
WORKER="<user@worker-link-address>"
LINK_NETDEV=
LINK_HCAS=
MASTER_PORT=29620
NCCL_RAILS=2

# -- checkpoint --------------------------------------------------------------------------------------------------------------
MODEL_ID=jayleaton/MiniMax-M3.1-Flash-EXL3-3.55bpw-mm31
MODEL_REVISION=5bff3d732e9dfa236a41b6f3054dd8550bef595f
# Each node's own folder of the pack (26 shards, SHA256SUMS), ~/ being that node's home; mounted read-only at /model.
WEIGHTS=dir
MODEL_DIR=~/work/minimax-m3/pack-mm31
# WORKER_MODEL_DIR=              # default: MODEL_DIR, in the worker's home: give an absolute path when WORKER's user
#                                # is not the account that holds the pack there (root@...: /home/<user>/work/...)

# -- engine ------------------------------------------------------------------------------------------------------------------
# The image is TF_REF (v1.1.2) plus ENGINE_PATCHES/*.patch; ENGINE_COMMIT records the commit that series was cut from (it is
# in the image's hash). The series for a mm3/integrate commit, from a checkout of the engine that has it:
#   mkdir -p ~/work/minimax-m3/engine-patches/mm3-integrate
#   git diff --binary 4ff784410f70b95767684d337e59dfd6d94fec8b <commit> > ~/work/minimax-m3/engine-patches/mm3-integrate/0001-mm3-integrate.patch
ENGINE_PATCHES=engine/patches
ENGINE_COMMIT=<ENGINE_COMMIT of config/prod.env.example>
ENGINE_API_TOOLS=1
IMAGE=tensorfold-minimax-m3:v1.1.2
CONTAINER_NAME=minimax-m3-flash-tf

# -- API ---------------------------------------------------------------------------------------------------------------------
SERVED_NAME=MiniMax-M3.1-Flash-EXL3
HOST=127.0.0.1
PORT=8000
API_KEY=0

# -- serving profile (the smoke profile's all-resident one, the draft on) -----------------------------------------------------
#   python3 scripts/quant_budget.py --serve --context 131072 --parallel 1 --kv fp8 --reserve-gib 8 --drafter
#   -> MEM_GATE_GIB 115 (memory, below)
CONTEXT=40960
PARALLEL=4
# no KV tier: every page resident, as in the smoke profile (config/prod.env.example documents these)
KV_TIER_DIR=
WORKER_KV_TIER_DIR=
KV_TIER_KEEP_GIB=300
TF_MM3_KV_TIER=
TF_MM3_KV_TIER_GIB=
TF_MM3_KV_HORIZON=
TF_MM3_KV_CANDIDATES=
MAX_TOKENS=32768
KV=fp8
DRAFTS=1
DRAFTER=dspark
TF_ROCE_MARK=/cache/roce-failed
ROCE=1
# image input: off, as in the production and smoke profiles (no vision run in the drafts measurement)
VISION=0
VISION_MAX_IMAGES=4
VISION_IMAGE_TOKENS=2304
VISION_URLS=0
# CUDA graphs: 0 for the first load (the exchanges between the ranks run eagerly); both ranks get it (rank_env)
TF_MM3_GRAPHS_TP=0
# the draft's acceptance by position, one line a finished stream on rank 0 (an engine with mm3/dspark)
TF_MM3_DSPARK_STATS=1
# drafts a round verifies at most (1..7; empty: the block of 7): 3, as measured at four streams; depth by confidence off
TF_MM3_DRAFT_DEPTH=3
TF_MM3_DSPARK_CHANCES=
TF_MM3_CALIB=

# -- memory (the production values; the gate with the draft) -----------------------------------------------------------------
TENSORFOLD_MEMORY_RESERVE_GIB=8
TF_MM3_FLOOR_HARD_GIB=4
TF_MM3_FLOOR_GIB=5
TF_MM3_FLOOR_TRANSIENT_GIB=0.5
MEM_GATE_GIB=117
MEM_GATE_TIMEOUT=600
MEM_GATE_DROP_CACHES=1
DROP_CACHES=1
MEMGUARD_GIB=3
MEMGUARD_HOLD_S=4
MEMGUARD_HARD_GIB=2.75

# -- the pair and the start --------------------------------------------------------------------------------------------------
PAIR_WATCH=1
PAIR_WATCH_S=5
CANARY=strict
WAIT_TIMEOUT=2400
PREFLIGHT=strict

# -- watchdog: no heal during the smoke (the production values otherwise) --------------------------------------------------
WATCH_HEAL=0
WATCH_FAILS=3
WATCH_MIN_HEAL=1800
WATCH_FF_MIN_HEAL=120
WATCH_GRACE=2400
