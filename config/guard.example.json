{
 "enabled": true,
 "mode": "production",
 "policy": {
  "memory_floor_gib": 4
 },
 "device_limits": "/etc/spark/thermal.env",
 "device_state": "/run/spark-thermal/state",
 "boot_floor_log_regex": "<the engine's boot memory line, one capture group (free GiB): read it from rank 0's log on the first two-node start>",
 "resume_log_regex": null,
 "upstream": "http://127.0.0.1:8001",
 "listen_host": "127.0.0.1",
 "listen_port": 8000,
 "state_path": "/home/user/.local/state/tf-guard/state.json",
 "samples_path": "/home/user/.local/state/tf-guard/samples.json",
 "events_path": "/home/user/.local/state/tf-guard/events.jsonl",
 "control_socket": "/home/user/.local/state/tf-guard/control.sock",
 "lease_path": "/home/user/.local/state/tf-guard/maintenance.lease",
 "lease_minutes": 20,
 "production_config": "/home/user/minimax-m31-tensorfold-spark/config/prod.env",
 "worker_ssh": "user@rank1.example",
 "containers": {"0": "minimax-m3-flash-tf", "1": "minimax-m3-flash-tf"},
 "watchdog_units": ["tf-watchdog.timer"],
 "limits": {
  "max_inflight": 1,
  "max_pending": 8,
  "max_connections": 32,
  "max_body_bytes": 16777216,
  "body_buffers": 2,
  "queue_seconds": 1200,
  "upstream_seconds": 1800,
  "memory_transient_reserve_gib": 0.5
 },
 "profiles": {}
}
