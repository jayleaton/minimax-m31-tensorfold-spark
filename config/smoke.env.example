# The first TP2 smoke load: the production profile (config/prod.env.example documents every setting) on an engine built
# from the integration branch mm3/integrate, with each Spark's own copy of the pack and CUDA graphs off between the ranks.
# KEY=value lines, read, never run; scripts/config.sh reads this file instead of config/prod.env when CONFIG names it:
#
#   cp config/smoke.env.example config/smoke.env      on the head only; fill in WORKER and ENGINE_COMMIT
#   CONFIG=config/smoke.env scripts/serve.sh preflight
#
# The two <placeholders> stop every script until they are filled in. A caller export wins over this file.
# What differs from the production profile, and why:
#   ENGINE_COMMIT / ENGINE_PATCHES  the series cut from mm3/integrate (robust, speed-graphs, prompt-kernels, api-tools, ...)
#   ENGINE_API_TOOLS=1              that branch includes mm3/api-tools: the canary probes required tools and thinking off
#   TF_MM3_GRAPHS_TP=0              the first load runs the ranks' exchanges eagerly (mm3/speed-graphs: 1 is opt-in)
#   WEIGHTS=dir                     both Sparks already hold the verified pack as a plain folder: nothing is copied
# Everything else is the production profile, unchanged (AGENTS.md section 7: do not change these knobs).
# This file, unchanged, is also the drafts-off control of the drafts measurement (docs/DRAFTS.md): config/drafts.env.example
# is it with the dspark draft on, and the two must name the same WORKER, ENGINE_COMMIT and ENGINE_PATCHES.

# -- nodes -------------------------------------------------------------------------------------------------------------------
# This Spark (the head, rank 0, the API; the image is built here) and the worker (rank 1) by its CX7 link address.
# WORKER's user needs docker and passwordless sudo -n there (the cache drops); root@<link address> is fine when the
# worker's own account has neither. Its home (/root for root) is where a ~/ on the worker resolves.
WORKER="<user@worker-link-address>"
LINK_NETDEV=
LINK_HCAS=
MASTER_PORT=29620
NCCL_RAILS=2

# -- checkpoint --------------------------------------------------------------------------------------------------------------
MODEL_ID=jayleaton/MiniMax-M3.1-Flash-EXL3-3.55bpw-mm31
MODEL_REVISION=5bff3d732e9dfa236a41b6f3054dd8550bef595f
# Each node's own folder of the pack (26 shards, SHA256SUMS), ~/ being that node's home; mounted read-only at /model.
WEIGHTS=dir
MODEL_DIR=~/work/minimax-m3/pack-mm31
# WORKER_MODEL_DIR=              # default: MODEL_DIR, in the worker's home: give an absolute path when WORKER's user
#                                # is not the account that holds the pack there (root@...: /home/<user>/work/...)

# -- engine ------------------------------------------------------------------------------------------------------------------
# The image is TF_REF (v1.1.2) plus ENGINE_PATCHES/*.patch; ENGINE_COMMIT records the commit that series was cut from (it is
# in the image's hash). The series for a mm3/integrate commit, from a checkout of the engine that has it:
#   mkdir -p ~/work/minimax-m3/engine-patches/mm3-integrate
#   git diff --binary 4ff784410f70b95767684d337e59dfd6d94fec8b <commit> > ~/work/minimax-m3/engine-patches/mm3-integrate/0001-mm3-integrate.patch
ENGINE_PATCHES=~/work/minimax-m3/engine-patches/mm3-integrate
ENGINE_COMMIT=<mm3/integrate head>
ENGINE_API_TOOLS=1
IMAGE=tensorfold-minimax-m3:v1.1.2
CONTAINER_NAME=minimax-m3-flash-tf

# -- API ---------------------------------------------------------------------------------------------------------------------
SERVED_NAME=MiniMax-M3.1-Flash-EXL3
HOST=127.0.0.1
PORT=8000
API_KEY=0

# -- serving profile: the all-resident one (production's 4 x 1M needs the KV tier, an engine past mm3/integrate) ----------------
#   python3 scripts/quant_budget.py --serve --context 131072 --parallel 1 --kv fp8 --reserve-gib 8 --vision-image-tokens 2304
#   -> MEM_GATE_GIB 113 (the images come out of the KV pool, not the gate)
CONTEXT=131072
PARALLEL=1
# no KV tier: every page resident (config/prod.env.example documents these)
KV_TIER_DIR=
WORKER_KV_TIER_DIR=
KV_TIER_KEEP_GIB=300
TF_MM3_KV_TIER=
TF_MM3_KV_TIER_GIB=
TF_MM3_KV_HORIZON=
TF_MM3_KV_CANDIDATES=
MAX_TOKENS=32768
KV=fp8
DRAFTS=0                         # the draft window starts this profile with DRAFTS=dflash2 (docs/DFLASH2.md; MEM_GATE_GIB 116)
DRAFTER=
TF_ROCE_MARK=/cache/roce-failed
ROCE=1
# image input: off, as in the production profile (the KV pool would not hold CONTEXT at 110-113 GiB available). The
# vision run of the TP2 window overrides it from the environment, with the CONTEXT the calculator fits at 110 GiB
# available with images (23,808 pool tokens = 186 pages, less the engine's one-page verify window) and the gate with the
# images counted (docs/OPERATIONS.md section 3a):
# VISION_RUN: VISION=1 CONTEXT=23680 MEM_GATE_GIB=110
VISION=0
VISION_MAX_IMAGES=4
VISION_IMAGE_TOKENS=2304
VISION_URLS=0
# CUDA graphs: 0 for the first load (the exchanges between the ranks run eagerly); both ranks get it (rank_env)
TF_MM3_GRAPHS_TP=0

# -- memory (the production values) ------------------------------------------------------------------------------------------
TENSORFOLD_MEMORY_RESERVE_GIB=8
TF_MM3_FLOOR_HARD_GIB=4
TF_MM3_FLOOR_GIB=5
TF_MM3_FLOOR_TRANSIENT_GIB=0.5
MEM_GATE_GIB=113
MEM_GATE_TIMEOUT=600
MEM_GATE_DROP_CACHES=1
DROP_CACHES=1
MEMGUARD_GIB=3
MEMGUARD_HOLD_S=4
MEMGUARD_HARD_GIB=2.75

# -- the pair and the start --------------------------------------------------------------------------------------------------
PAIR_WATCH=1
PAIR_WATCH_S=5
CANARY=strict
WAIT_TIMEOUT=2400
PREFLIGHT=strict

# -- watchdog: no heal during the smoke (the production values otherwise) --------------------------------------------------
WATCH_HEAL=0
WATCH_FAILS=3
WATCH_MIN_HEAL=1800
WATCH_FF_MIN_HEAL=120
WATCH_GRACE=2400
