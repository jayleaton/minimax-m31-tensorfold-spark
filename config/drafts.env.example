# The drafts measurement: the TP2 smoke profile (config/smoke.env.example) with MiniMax's own dspark draft on, for the
# drafts-on half of docs/DRAFTS.md. config/smoke.env, unchanged, is its matched drafts-off control: the two files must
# hold the same WORKER, ENGINE_COMMIT and ENGINE_PATCHES (one image for both runs; another series would rebuild it).
# KEY=value lines, read, never run; scripts/config.sh reads this file instead of config/prod.env when CONFIG names it:
#
#   cp config/drafts.env.example config/drafts.env      on the head only; WORKER and ENGINE_COMMIT as in config/smoke.env
#   CONFIG=config/drafts.env scripts/serve.sh restart
#
# The two <placeholders> stop every script until they are filled in. A caller export wins over this file.
# What differs from the smoke profile, and why (tests/test_repo.py holds the list):
#   DRAFTS=1 DRAFTER=dspark   --drafter /model/dspark on both ranks: copy drafts plus the pack's dspark/ draft (both ranks
#                             load it; the target verifies every draft, so the reply is the one plain decode gives)
#   TF_MM3_DSPARK_STATS=1     rank 0 logs "dspark acceptance stream: ..." for every finished stream (one a request at
#                             PARALLEL=1), which bench/drafts.py --server-log-cmd reads; both ranks get it (rank_env)
#   MEM_GATE_GIB=115          the draft is spent before any KV (2.19 GiB a rank: 2.03 GiB with one stream's 21 MB ring,
#                             plus 8 ring snapshots of 21 MB for prompt-cache resumes, native.draftCost):
#     python3 scripts/quant_budget.py --serve --context 131072 --parallel 1 --kv fp8 --reserve-gib 8 --drafter
#                             -> KV room 8.26 GiB at 117.1 GiB available (188,416 tokens, 1,472 pages), MEM_GATE_GIB 115
# CONTEXT stays 131072, the control's: a start whose MemFree does not reach 115 GiB in MEM_GATE_TIMEOUT stops there (never
# lower the gate). Then run BOTH halves with the narrower window from the environment, the gate the calculator gives
# with the draft at that window (docs/DRAFTS.md):
# NARROW_RUN: CONTEXT=65536 MEM_GATE_GIB=112
# TF_MM3_CALIB (the engine's boot calibration of verify widths) is left unset: the engine's default; its
# "dspark calibration: ..." line is recorded when the engine prints one.
# Everything else is the smoke profile, unchanged.

# -- nodes -------------------------------------------------------------------------------------------------------------------
# This Spark (the head, rank 0, the API; the image is built here) and the worker (rank 1) by its CX7 link address.
# WORKER's user needs docker and passwordless sudo -n there (the cache drops); root@<link address> is fine when the
# worker's own account has neither. Its home (/root for root) is where a ~/ on the worker resolves.
WORKER="<user@worker-link-address>"
LINK_NETDEV=
LINK_HCAS=
MASTER_PORT=29620
NCCL_RAILS=2

# -- checkpoint --------------------------------------------------------------------------------------------------------------
MODEL_ID=jayleaton/MiniMax-M3.1-Flash-EXL3-3.55bpw-mm31
MODEL_REVISION=5bff3d732e9dfa236a41b6f3054dd8550bef595f
# Each node's own folder of the pack (26 shards, SHA256SUMS), ~/ being that node's home; mounted read-only at /model.
WEIGHTS=dir
MODEL_DIR=~/work/minimax-m3/pack-mm31
# WORKER_MODEL_DIR=              # default: MODEL_DIR, in the worker's home: give an absolute path when WORKER's user
#                                # is not the account that holds the pack there (root@...: /home/<user>/work/...)

# -- engine ------------------------------------------------------------------------------------------------------------------
# The image is TF_REF (v1.1.2) plus ENGINE_PATCHES/*.patch; ENGINE_COMMIT records the commit that series was cut from (it is
# in the image's hash). The series for a mm3/integrate commit, from a checkout of the engine that has it:
#   mkdir -p ~/work/minimax-m3/engine-patches/mm3-integrate
#   git diff --binary 4ff784410f70b95767684d337e59dfd6d94fec8b <commit> > ~/work/minimax-m3/engine-patches/mm3-integrate/0001-mm3-integrate.patch
ENGINE_PATCHES=~/work/minimax-m3/engine-patches/mm3-integrate
ENGINE_COMMIT=<mm3/integrate head>
ENGINE_API_TOOLS=1
IMAGE=tensorfold-minimax-m3:v1.1.2
CONTAINER_NAME=minimax-m3-flash-tf

# -- API ---------------------------------------------------------------------------------------------------------------------
SERVED_NAME=MiniMax-M3.1-Flash-EXL3
HOST=127.0.0.1
PORT=8000
API_KEY=0

# -- serving profile (the smoke profile's all-resident one, the draft on) -----------------------------------------------------
#   python3 scripts/quant_budget.py --serve --context 131072 --parallel 1 --kv fp8 --reserve-gib 8 --drafter
#   -> MEM_GATE_GIB 115 (memory, below)
CONTEXT=131072
PARALLEL=1
# no KV tier: every page resident, as in the smoke profile (config/prod.env.example documents these)
KV_TIER_DIR=
WORKER_KV_TIER_DIR=
KV_TIER_KEEP_GIB=300
TF_MM3_KV_TIER=
TF_MM3_KV_TIER_GIB=
TF_MM3_KV_HORIZON=
TF_MM3_KV_CANDIDATES=
MAX_TOKENS=32768
KV=fp8
DRAFTS=1
DRAFTER=dspark
TF_ROCE_MARK=/cache/roce-failed
ROCE=1
# image input: off, as in the production and smoke profiles (no vision run in the drafts measurement)
VISION=0
VISION_MAX_IMAGES=4
VISION_IMAGE_TOKENS=2304
VISION_URLS=0
# CUDA graphs: 0 for the first load (the exchanges between the ranks run eagerly); both ranks get it (rank_env)
TF_MM3_GRAPHS_TP=0
# the draft's acceptance by position, one line a finished stream on rank 0 (an engine with mm3/dspark)
TF_MM3_DSPARK_STATS=1
# drafts a round verifies at most (1..7; empty: the block of 7); the engine's depth rule may still pick fewer or none
TF_MM3_DRAFT_DEPTH=3

# -- memory (the production values; the gate with the draft) -----------------------------------------------------------------
TENSORFOLD_MEMORY_RESERVE_GIB=8
TF_MM3_FLOOR_HARD_GIB=4
TF_MM3_FLOOR_GIB=5
TF_MM3_FLOOR_TRANSIENT_GIB=0.5
MEM_GATE_GIB=115
MEM_GATE_TIMEOUT=600
MEM_GATE_DROP_CACHES=1
DROP_CACHES=1
MEMGUARD_GIB=3
MEMGUARD_HOLD_S=4
MEMGUARD_HARD_GIB=2.75

# -- the pair and the start --------------------------------------------------------------------------------------------------
PAIR_WATCH=1
PAIR_WATCH_S=5
CANARY=strict
WAIT_TIMEOUT=2400
PREFLIGHT=strict

# -- watchdog: no heal during the smoke (the production values otherwise) --------------------------------------------------
WATCH_HEAL=0
WATCH_FAILS=3
WATCH_MIN_HEAL=1800
WATCH_FF_MIN_HEAL=120
WATCH_GRACE=2400
