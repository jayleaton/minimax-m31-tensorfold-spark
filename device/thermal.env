# DGX Spark device thermal and clock limits (JJ, 2026-10-24). The source of truth on this machine.
# Sparks run in the high 80s C under load and start to degrade at 94 C.
# Read by spark-thermal-guard.service (device enforcement), dgx-gpu-clock-cap.service (clock cap)
# and any job guard or recipe (pause/stop decisions). Temperature = hottest of nvidia-smi GPU and ACPI zones.
# No inline comments: systemd EnvironmentFile reads this file too.
#
# At/above GUARD_PAUSE_C the device throttles GPU clocks and job guards pause new work.
GUARD_PAUSE_C=92
# At/below GUARD_RESUME_C the device restores clocks and job guards resume.
GUARD_RESUME_C=86
# Held at/above GUARD_KILL_C for GUARD_KILL_HOLD_S: the device drops to emergency clocks and job guards stop.
GUARD_KILL_C=93
GUARD_KILL_HOLD_S=30
# GPU SM clock limits in MHz. MAX is the normal cap (JJ 2026-10-24; was 2200).
SPARK_CLOCK_MIN_MHZ=300
SPARK_CLOCK_MAX_MHZ=2100
SPARK_CLOCK_THROTTLE_MHZ=1800
SPARK_CLOCK_EMERGENCY_MHZ=1200
SPARK_THERMAL_INTERVAL_S=2
